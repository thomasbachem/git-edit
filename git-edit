PRINT_TEXT () {
	local MSG=$1; shift
	local COLOR=$1; shift
	local ARGS=("$@")

	local BASE=$COLOR
	local BRIGHT=$(( COLOR <= 37 ? COLOR + 60 : COLOR ))

	local TEXT="$MSG"
	local OUTPUT="${_PAD}\e[0;${COLOR}m"
	local ARG
	for ARG in "${ARGS[@]}"; do
		OUTPUT+="${TEXT%%%s*}"
		OUTPUT+="\e[1;${BRIGHT}m${ARG}\e[0;${BASE}m"
		TEXT="${TEXT#*%s}"
	done
	OUTPUT+="$TEXT\e[0m"
	ECHO_E "$OUTPUT"
}

PRINT_ACTION () {
	local MSG=$1; shift
	local COMMITS=("$@")

	local ARGS=()
	local COMMIT
	for COMMIT in "${COMMITS[@]}"; do
		local SUBJECT=$(git log -1 --pretty=format:'%s' "$COMMIT")
		ARGS+=("${COMMIT:0:7}\e[22m (${SUBJECT})")
	done

	# Count placeholders (assumes %s is the only placeholder type used)
	local PLACEHOLDERS="${MSG//[^%]}"
	
	# Use list mode if multiple commits or if it's a merge (contains "->")
	if [[ ${#COMMITS[@]} -gt 1 || "$MSG" == *"->"* ]] && [[ ${#PLACEHOLDERS} -eq 1 ]]; then
		local PREFIX="${MSG%%%s*}" # e.g. "Dropping "
		local SUFFIX="${MSG#*%s}"  # e.g. "..."

		# Transform "Dropping " -> "Dropping:"
		local NEW_MSG="${PREFIX% }:"

		# Append a newline and indented placeholder for every commit
		# We use a C-style loop for robust iteration in Zsh
		for (( i=0; i<${#COMMITS[@]}; i++ )); do
			NEW_MSG+="\n - %s"
		done

		# Put merge arrow on a new line and bold it, otherwise keep suffix attached
		if [[ "$SUFFIX" == *"->"* ]]; then
			NEW_MSG+="\n\e[1;96m${SUFFIX# }"
		else
			NEW_MSG+="$SUFFIX"
		fi
		
		PRINT_TEXT "$NEW_MSG" 36 "${ARGS[@]}"
	else
		# Default behavior for single commits or specific pairs (squash A -> B)
		PRINT_TEXT "$MSG" 36 "${ARGS[@]}"
	fi
}

PRINT_CMD () {
	# First arg is the full command string to be printed.
	# Optional second arg overrides the color (default 90 = gray, matching
	# the trailing color used for the executed command's own output).
	local CMD="$1"
	local COLOR="${2:-90}"

	# Filter `--no-autostash` arg when printing commands
	local CMD_FILTERED=$(echo "$CMD" | sed -E 's/(^| )--no-autostash($| )/ /g; s/  +/ /g')

	ECHO_E "${_PAD}\e[0;${COLOR}m$CMD_FILTERED\e[0;90m"
}

PRINT_ERR () {
	local MSG="$1"
	# Remember the message for the status trailer in _GLOBAL_EXIT_TRAP
	_LAST_ERROR="$MSG"

	if [[ "$MSG" == *:* ]]; then
		local PREFIX="${MSG%%:*}"
		local REST="${MSG#*: }"
		ECHO_E "\n\e[1;91m${PREFIX}:\e[0m\e[0;31m ${REST}\e[0m" >&2
	else
		ECHO_E "\n\e[1;91m${MSG}\e[0m" >&2
	fi
}

# Symlinks gitignored paths named by `edit.worktreeLink` into a fresh worktree – a pause
# verifies the commit in isolation, but the project's own checks need what the checkout
# does not track, and links over copies keep a run from diverging from what is installed
_LINK_WORKTREE_EXTRAS () {
	local WT=$1
	local FROM=$2
	[ -z "$WT" ] || [ ! -d "$WT" ] && return 0
	[ -z "$FROM" ] && FROM=$(git rev-parse --show-toplevel 2>/dev/null)
	[ -z "$FROM" ] || [ ! -d "$FROM" ] && return 0

	local -a EXTRAS
	EXTRAS=("${(@f)$(git config --get-all edit.worktreeLink 2>/dev/null)}")
	[ -n "$GIT_EDIT_WORKTREE_LINK" ] && EXTRAS+=("${(@s.:.)GIT_EDIT_WORKTREE_LINK}")

	local -a LINKED EXPOSED FAILED
	local P
	for P in "${EXTRAS[@]}"; do
		[ -z "$P" ] && continue
		# Only what the origin actually has, and never over a tracked path the
		# commit itself carries – the worktree's own content wins
		[ -e "$FROM/$P" ] || continue
		[ -e "$WT/$P" ] && continue
		# A nested path needs its parent to exist, or `ln` fails and the caller
		# gets silence where they configured something
		[[ "$P" == */* ]] && mkdir -p "$WT/${P:h}" 2>/dev/null
		if ! ln -sfn "$FROM/$P" "$WT/$P" 2>/dev/null; then
			FAILED+=("$P")
			continue
		fi
		LINKED+=("$P")
		# A pattern written for a directory (`node_modules/`) does not match a
		# symlink, so the link can land untracked where the directory it
		# stands in for would have been ignored – and the amend at --continue
		# stages this worktree wholesale
		git -C "$WT" check-ignore -q "$P" 2>/dev/null || EXPOSED+=("$P")
	done
	if [ ${#LINKED[@]} -gt 0 ]; then
		PRINT_TEXT "Linked into the worktree: %s" 90 "${(j:, :)LINKED}"
	fi
	if [ ${#EXPOSED[@]} -gt 0 ]; then
		PRINT_TEXT "%s is not ignored here – drop the trailing slash in .gitignore so the link is covered too." 33 \
			"${(j:, :)EXPOSED}"
	fi
	if [ ${#FAILED[@]} -gt 0 ]; then
		PRINT_TEXT "Could not link %s into the worktree – check the path." 33 "${(j:, :)FAILED}"
	fi
}

# Removes the links `_LINK_WORKTREE_EXTRAS` put in, before anything stages the
# worktree wholesale. They are this script's scaffolding, not the caller's
# content – and where the ignore pattern was written for a directory it does
# not cover the symlink standing in for it, so the amend would otherwise commit
# a link into someone's home directory. Only ever removes a symlink at a
# configured path that points outside the worktree.
_UNLINK_WORKTREE_EXTRAS () {
	local WT=$1
	[ -z "$WT" ] || [ ! -d "$WT" ] && return 0

	local -a EXTRAS
	EXTRAS=("${(@f)$(git config --get-all edit.worktreeLink 2>/dev/null)}")
	[ -n "$GIT_EDIT_WORKTREE_LINK" ] && EXTRAS+=("${(@s.:.)GIT_EDIT_WORKTREE_LINK}")

	local P DEST
	for P in "${EXTRAS[@]}"; do
		[ -z "$P" ] && continue
		[ -L "$WT/$P" ] || continue
		DEST=$(readlink "$WT/$P" 2>/dev/null)
		[[ "$DEST" == "$WT"/* ]] && continue
		rm -f "$WT/$P"
	done
}

MKTEMP_DIR () {
	local BASE="${TMPDIR:-/tmp}"
	mktemp -d "${BASE%/}/$1.XXXXXX"
}

MKTEMP_FILE () {
	local BASE="${TMPDIR:-/tmp}"
	mktemp "${BASE%/}/$1.XXXXXX"
}

# Emit a single trailing line in a stable, ANSI-free, key=value format for
# machine consumption (e.g., agents grep'ing `^git-edit:`). Always the very
# last line of output on success.
# Single-line status trailer in natural-language form (still anchored by
# `git-edit: <outcome>` for programmatic dispatch). Four forms:
#   git-edit: ok — refs/heads/main moved <old-sha> → <new-sha>
#   git-edit: ok — refs/heads/main unchanged
#   git-edit: error — exit code <N>
#   git-edit: conflict — resolve in <worktree> (<files>); then 'git edit --continue' or 'git edit --abort'
#   git-edit: paused — edit|split <sha> in <worktree>; then 'git edit --continue' or 'git edit --abort'
# Agents grep `^git-edit: (ok|error|conflict|paused)` to dispatch, and the rest
# is self-explanatory prose.
EMIT_STATUS () {
	# args: <new_head_sha> <ref> <changed:true|false>
	# The SHAs are the authority, not the flag: some callers pass a hardcoded
	# `true` for paths that normally rewrite, but a no-op rebase (e.g. dropping
	# a commit that isn't in HEAD's history) leaves HEAD where it was. Reporting
	# a move there would be a false success for anything dispatching on `ok`.
	if [ "$3" = "true" ] && [ "$1" != "$SCRIPT_INITIAL_HEAD" ]; then
		echo "git-edit: ok — $2 moved $SCRIPT_INITIAL_HEAD → $1"
	else
		echo "git-edit: ok — $2 unchanged"
	fi
	_STATUS_EMITTED=true
}

EMIT_CONFLICT () {
	# Args: <worktree-path> [<unmerged-files-comma-separated>]
	local FILES_PART=""
	if [ -n "$2" ]; then
		# Replace commas with ", " for readability
		FILES_PART=" ($(echo "$2" | sed 's/,/, /g'))"
	fi
	echo "git-edit: conflict — resolve in $1$FILES_PART; then 'git edit --continue' or 'git edit --abort'"
	_STATUS_EMITTED=true
}

# The pause a mode takes by design (edit, content split) rather than on a
# conflict – nothing is unmerged, there is just authoring left to do
EMIT_PAUSED () {
	# args: <operation> <sha> <worktree-path>
	echo "git-edit: paused — $1 ${2:0:7} in $3; then 'git edit --continue' or 'git edit --abort'"
	_STATUS_EMITTED=true
}

# Prints the conflict context – unmerged files, the step we paused on, and what remains, so
# the resolver can tell a single resolution from a likely cascade
# Echoes the unmerged files comma-separated to stdout for the trailer, the rest to stderr
_PRINT_CONFLICT_DETAIL () {
	local WT=$1
	# Pre-op tip, passed by the reorder paths only – see the final-step hint below
	local PREOP=$2
	local GITDIR=$(git -C "$WT" rev-parse --git-dir 2>/dev/null)

	# Unmerged paths (files with conflict markers)
	local UNMERGED
	UNMERGED=$(git -C "$WT" diff --name-only --diff-filter=U 2>/dev/null)
	if [ -n "$UNMERGED" ]; then
		PRINT_TEXT "Conflicted files:" 33 >&2
		local FILE
		while IFS= read -r FILE; do
			ECHO_E "\e[0;33m  - $FILE\e[0m" >&2
		done <<< "$UNMERGED"
	fi

	# Currently-failing rebase step (last line of the done log)
	if [ -f "$GITDIR/rebase-merge/done" ]; then
		local LAST_STEP
		LAST_STEP=$(tail -1 "$GITDIR/rebase-merge/done" 2>/dev/null)
		if [ -n "$LAST_STEP" ]; then
			PRINT_TEXT "Currently failing on:" 33 >&2
			ECHO_E "\e[0;33m  $LAST_STEP\e[0m" >&2
		fi
	fi

	# Remaining rebase steps (after the conflict resolves)
	if [ -f "$GITDIR/rebase-merge/git-rebase-todo" ]; then
		local REMAINING
		REMAINING=$(grep -vE '^(#|$)' "$GITDIR/rebase-merge/git-rebase-todo" 2>/dev/null)
		if [ -n "$REMAINING" ]; then
			PRINT_TEXT "Remaining steps (after resolution):" 33 >&2
			local STEP
			while IFS= read -r STEP; do
				ECHO_E "\e[0;33m  $STEP\e[0m" >&2
			done <<< "$REMAINING"
		fi
	fi

	# Reordering preserves the tree, so its final step has one determined result – the pre-op
	# content – while earlier steps rebuild an intermediate that never existed, so their
	# content is authored rather than derived
	if [ -n "$PREOP" ] && [ -n "$UNMERGED" ] && [ -s "$GITDIR/rebase-merge/end" ]; then
		local STEP_NOW=$(cat "$GITDIR/rebase-merge/msgnum" 2>/dev/null)
		local STEP_END=$(cat "$GITDIR/rebase-merge/end" 2>/dev/null)
		if [ "$STEP_NOW" = "$STEP_END" ]; then
			PRINT_TEXT "Final step – a reorder preserves the tree, so the resolution is exactly the pre-op content:" 33 >&2
			ECHO_E "\e[0;33m  git -C $WT checkout ${PREOP:0:12} -- $(echo "$UNMERGED" | tr '\n' ' ' | sed 's/ $//')\e[0m" >&2
			ECHO_E "\e[0;33m  git edit --continue\e[0m" >&2
		else
			PRINT_TEXT "Step %s rebuilds a state that never existed – author its content rather than deriving it:" 33 "$STEP_NOW/$STEP_END" >&2
			ECHO_E "\e[0;33m  'git apply --3way' cannot work here at all (mid-rebase the paths sit at conflicted stages, not stage 0),\e[0m" >&2
			ECHO_E "\e[0;33m  and reverse-applying the other commit's diff tends to fail once its context has shifted.\e[0m" >&2
		fi
	fi

	# No conflicted files + a paused rebase = the current step produced an
	# empty commit (its changes are already upstream). Nothing to resolve –
	# the escape is skipping that step
	if [ -z "$UNMERGED" ] && [ -d "$GITDIR/rebase-merge" ]; then
		PRINT_TEXT "No conflicted files – the current step became empty (its changes are already upstream). Skip it, then continue:" 33 >&2
		ECHO_E "\e[0;33m  git -C $WT rebase --skip\e[0m" >&2
		ECHO_E "\e[0;33m  git edit --continue\e[0m" >&2
	fi

	# Emit comma-separated unmerged list on stdout for the trailer
	echo "$UNMERGED" | tr '\n' ',' | sed 's/,$//'
}

# Best-effort detection of the canonical ref name to report. Uses ORIG_BRANCH
# if set (e.g., -C mode captures it before cd-ing into a detached worktree),
# otherwise resolves the current symbolic ref. Falls back to "HEAD" for
# truly-detached state.
_CURRENT_REF () {
	if [ -n "$ORIG_BRANCH" ]; then
		echo "refs/heads/$ORIG_BRANCH"
		return
	fi
	local B=$(git symbolic-ref --short HEAD 2>/dev/null)
	if [ -n "$B" ]; then
		echo "refs/heads/$B"
	else
		echo "HEAD"
	fi
}

# Convenience helper to print the success banner + status trailer together.
PRINT_COMPLETED () {
	# args: <new_head_sha> <ref> <changed:true|false>
	[ -n "$_PAD" ] && ECHO_E "${_PAD}\e[1;92mgit edit completed.\e[0m"
	EMIT_STATUS "$1" "$2" "$3"
}

# Refuses to rewrite a commit that already exists on a remote — rewriting
# pushed history disrupts collaborators and (in public repos) should never
# happen by accident. Guarding the oldest commit an operation touches covers
# the whole rewritten span, since every descendant of an unpushed commit is
# itself unpushed. Override with --allow-pushed.
# Whether a commit already exists on a remote. Unlike _GUARD_UNPUSHED this only
# reports – and deliberately ignores --allow-pushed, so callers can still tell
# shared history apart after the caller has consented to rewriting it.
_IS_PUSHED () {
	[ -n "$(git branch -r --contains "$1" 2>/dev/null | grep -v ' -> ' | head -1)" ]
}

_GUARD_UNPUSHED () {
	[ ${#OPT_ALLOW_PUSHED} -gt 0 ] && return 0
	local C=$1
	local CONTAINING=$(git branch -r --contains "$C" 2>/dev/null | grep -v ' -> ' | sed 's/^[* ]*//' | head -3 | tr '\n' ' ' | sed 's/ $//')
	if [ -n "$CONTAINING" ]; then
		PRINT_ERR "Commit ${C:0:7} is already pushed (on: $CONTAINING)"
		ECHO_E "\e[0;31m  Rewriting pushed history disrupts collaborators – pass --allow-pushed to override.\e[0m" >&2
		exit 1
	fi
}

# Computes the stable patch id of a commit's own diff – the same change keeps it across a rewrite,
# the SHA and tree move, and `--root` gets the initial commit one instead of an empty diff
_PATCH_ID () {
	git diff-tree -p --root "$1" 2>/dev/null | git patch-id --stable 2>/dev/null | awk '{print $1}'
}

# Finds the current identity of a rewritten commit, echoing "<sha> <how>" – an identical patch
# id proves the same change and is acted on, while a fold keeps only the subject and is merely
# suggested, both needing a unique match, with a pushed hit left to the pushed guard
_RESOLVE_STALE () {
	local C=$1
	local -a MATCHES
	local HIT

	# Every rewrite preserves the author date, so it prunes the patch-id scan to a handful and
	# can only narrow the field – a candidate dropped here could only have been a false match
	# One past the ceiling notices a view too large to call unique, so it falls back to suggesting
	local WHEN=$(git log -1 --format='%aI' "$C" 2>/dev/null)
	local WANT=$(_PATCH_ID "$C")
	if [ -n "$WHEN" ] && [ -n "$WANT" ]; then
		local -a POOL
		POOL=($(git log --format='%H %aI' HEAD 2>/dev/null \
			| awk -v w="$WHEN" '$2 == w { print $1 }' | head -$((RESOLVE_SCAN_MAX + 1))))
		if [ ${#POOL[@]} -gt 0 ] && [ ${#POOL[@]} -le $RESOLVE_SCAN_MAX ]; then
			MATCHES=()
			for HIT in "${POOL[@]}"; do
				[ "$(_PATCH_ID "$HIT")" = "$WANT" ] && MATCHES+=("$HIT")
			done
			if [ ${#MATCHES[@]} -eq 1 ]; then
				echo "${MATCHES[1]} patch-id"
				return 0
			fi
		fi
	fi

	# One `git log` pass, so no ceiling is needed here – the SHA is stripped by field rather
	# than by splitting on tabs, so a subject containing one still compares whole
	local SUBJECT=$(git log -1 --format='%s' "$C" 2>/dev/null)
	if [ -n "$SUBJECT" ]; then
		MATCHES=($(git log --format='%H%x09%s' HEAD 2>/dev/null \
			| awk -v s="$SUBJECT" '{ sha = $1; sub(/^[^\t]*\t/, ""); if ($0 == s) print sha }'))
		if [ ${#MATCHES[@]} -eq 1 ]; then
			echo "${MATCHES[1]} subject"
			return 0
		fi
	fi
	return 1
}

# Resolves a commit to its current identity in `_RESOLVED_SHA`, or refuses – a miss is usually
# a stale SHA an earlier rewrite orphaned, so a proven match is substituted outright and a
# merely likely one only named, and the global lets `exit` abort with the trailer intact
_GUARD_REACHABLE () {
	local C=$1
	_RESOLVED_SHA=$C
	if git merge-base --is-ancestor "$C" HEAD 2>/dev/null; then
		# Normalize short SHAs/refs to the full SHA – downstream exact-match
		# steps (topo sort's `grep -Fx`, rebuild maps) silently miss otherwise,
		# falling back to the tie-prone timestamp sort
		_RESOLVED_SHA=$(git rev-parse "$C^{commit}" 2>/dev/null)
		return 0
	fi

	local SUBJECT=$(git log -1 --format='%s' "$C" 2>/dev/null)
	if [ -z "$SUBJECT" ]; then
		PRINT_ERR "Commit ${C:0:7} does not exist in this repository"
		exit 1
	fi

	local -a RESOLVED
	[ ${#GIT_EDIT_NO_RESOLVE} -eq 0 ] && RESOLVED=($(_RESOLVE_STALE "$C"))

	# An inferred target never reaches pushed history, even under `--allow-pushed` – that flag
	# consents to the commit the caller named, not to one resolved on its behalf, so where a
	# guess would compound with a shared-history rewrite, name the match and let them ask
	if [ "${RESOLVED[2]}" = "patch-id" ] && _IS_PUSHED "${RESOLVED[1]}"; then
		PRINT_ERR "Commit ${C:0:7} ($SUBJECT) is not in HEAD's history – it was likely rewritten"
		ECHO_E "\e[0;31m  Its only match ${RESOLVED[1]:0:12} is already pushed – name it explicitly to rewrite it.\e[0m" >&2
		exit 1
	fi

	if [ "${RESOLVED[2]}" = "patch-id" ]; then
		PRINT_TEXT "Commit %s was rewritten – using its current identity %s (identical diff)" 33 \
			"${C:0:7}" "${RESOLVED[1]:0:12}"
		_RESOLVED_SHA=${RESOLVED[1]}
		return 0
	fi

	PRINT_ERR "Commit ${C:0:7} ($SUBJECT) is not in HEAD's history – it was likely rewritten"
	if [ "${RESOLVED[2]}" = "subject" ]; then
		ECHO_E "\e[0;31m  Its counterpart on HEAD is ${RESOLVED[1]:0:12} (same subject, changed content) – retry with that.\e[0m" >&2
	else
		ECHO_E "\e[0;31m  Re-read the current SHAs with 'git log' before retrying.\e[0m" >&2
	fi
	exit 1
}

# Refuses a merge in the span, since rebase-based modes replay every commit up to `HEAD` and
# drops merge commits without a word – so refuse, since the plumbing modes rebuild them whole
_GUARD_NO_MERGE_SPAN () {
	local BASE=$1
	local SPAN="HEAD"
	git rev-parse --verify -q "$BASE^" >/dev/null 2>&1 && SPAN="$BASE^..HEAD"
	local MERGES=$(git rev-list --merges --count "$SPAN" 2>/dev/null)
	if [ "${MERGES:-0}" -gt 0 ]; then
		PRINT_ERR "Span ${BASE:0:7}..HEAD contains a merge commit – this rebase-based mode would silently flatten it"
		ECHO_E "\e[0;31m  Merge-preserving alternatives: -M / -S / --split (plumbing), or --exec with 'git rebase --rebase-merges ...' deliberately.\e[0m" >&2
		exit 1
	fi
}

# Names the journal of completed ref moves, one line each ("<epoch> <ref> <old> <new>"), in the
# common git dir so worktrees share it – powers `--undo` and `--status`'s last-operation report
_JOURNAL_FILE_PATH () {
	local DIR=$(git rev-parse --git-common-dir 2>/dev/null)
	[ -z "$DIR" ] && return 1
	case "$DIR" in
		/*) ;;
		*) DIR="$(pwd)/$DIR" ;;
	esac
	echo "$DIR/git-edit-journal"
}

# Records a completed CAS ref move: appends a journal entry and prints the
# one-line inverse command, so recovery never requires understanding this
# script — the undo is plain git, also reachable via `git edit --undo`.
# Also warns about tags left pointing into the rewritten span — they'd
# silently stay on pre-rewrite history and surface only at release time.
_RECORD_REF_MOVE () {
	# args: <ref> <old> <new> <label>
	local JF=$(_JOURNAL_FILE_PATH)
	[ -n "$JF" ] && echo "$(date +%s) $1 $2 $3 $4" >> "$JF"
	ECHO_E "\e[0;90mUndo: git edit --undo  (or: git update-ref $1 $2 $3)\e[0m"

	# A tag is orphaned if it was reachable from the old tip but isn't from
	# the new one. Suggest the counterpart commit when its subject matches
	# exactly one commit in the rewritten span; tags on shared (pushed) base
	# history are ancestors of both tips and never flagged.
	local TAG TAGSHA TSUBJ CAND
	for TAG in $(git for-each-ref refs/tags --format='%(refname:short)'); do
		TAGSHA=$(git rev-parse "$TAG^{commit}" 2>/dev/null)
		[ -z "$TAGSHA" ] && continue
		if git merge-base --is-ancestor "$TAGSHA" "$2" 2>/dev/null && \
		   ! git merge-base --is-ancestor "$TAGSHA" "$3" 2>/dev/null; then
			TSUBJ=$(git log -1 --format='%s' "$TAGSHA")
			CAND=$(git log --format='%H|%s' "$2..$3" 2>/dev/null | awk -F'|' -v s="$TSUBJ" '$2==s{print $1}')
			PRINT_TEXT "Tag %s points into the rewritten span – re-point it or it stays on pre-rewrite history:" 33 "$TAG"
			if [ -n "$CAND" ] && [ "$(echo "$CAND" | wc -l | tr -d ' ')" = "1" ]; then
				ECHO_E "\e[0;33m  git tag -f $TAG ${CAND:0:12}  # same subject: $TSUBJ\e[0m"
			else
				ECHO_E "\e[0;33m  git tag -f $TAG <its counterpart in the new span>\e[0m"
			fi
		fi
	done
}

# Reverts the last journaled ref move, CAS-guarded: refuses if the branch has
# moved since (a later commit or rewrite would be silently discarded).
GIT_UNDO () {
	local JF=$(_JOURNAL_FILE_PATH)
	if [ -z "$JF" ] || [ ! -s "$JF" ]; then
		PRINT_ERR "Nothing to undo (no completed git-edit operation on record)"
		exit 1
	fi
	local LAST=$(tail -1 "$JF")
	local REF=$(echo "$LAST" | awk '{print $2}')
	local OLD=$(echo "$LAST" | awk '{print $3}')
	local NEW=$(echo "$LAST" | awk '{print $4}')
	local LABEL=$(echo "$LAST" | cut -d' ' -f5-)

	PRINT_ACTION "Undoing last operation (%s)..." "${NEW}"

	local CMD="git update-ref -m 'git edit: undo $LABEL' $REF $OLD $NEW"
	PRINT_CMD "$CMD"
	if ! eval "$CMD" 2>/dev/null; then
		PRINT_ERR "Ref '$REF' has moved since that operation – refusing to rewind over newer work"
		ECHO_E "\e[0;31m  Expected $REF at ${NEW:0:7}, found $(git rev-parse --short "$REF" 2>/dev/null).\e[0m" >&2
		exit 1
	fi
	# Pop the undone entry off the journal
	sed -i '' -e '$d' "$JF" 2>/dev/null

	if ! git diff --quiet "$OLD" "$NEW" 2>/dev/null; then
		PRINT_TEXT "Trees differ between the two tips – re-sync the index with %s if this is your checkout's branch." 33 "git reset"
	fi
	PRINT_TEXT "%s" 32 "Undid: $LABEL"
	echo "git-edit: ok — $REF moved $NEW → $OLD"
	_STATUS_EMITTED=true
}

# Reports the in-flight operation (if any) in the same format as the original
# conflict pause, so an agent landing mid-operation — after a context reset or
# from another session — can re-enter without reading any state files. Falls
# back to the last completed operation from the journal.
GIT_STATUS_REPORT () {
	if _STATE_EXISTS; then
		_LOAD_STATE
		PRINT_TEXT "In-flight operation: %s (target %s, branch %s)" 33 "$STATE_OPERATION" "${STATE_TARGET:0:7}" "$STATE_BRANCH"
		if [ -d "$STATE_WORKTREE" ]; then
			PRINT_TEXT "Worktree: %s" 33 "$STATE_WORKTREE"
			# Hand the pre-op tip over for a reorder so the step-kind guidance
			# matches the original pause – this report exists for the caller who
			# no longer has it. The other operations change the tree by design,
			# so no such resolution is determined for them.
			local STATUS_PREOP=""
			[ "$STATE_OPERATION" = "reorder" ] && STATUS_PREOP=$STATE_ORIG_HEAD
			local UNMERGED_LIST=$(_PRINT_CONFLICT_DETAIL "$STATE_WORKTREE" "$STATUS_PREOP")
			# A paused edit or split with no rebase running is in its authoring
			# phase – there is nothing to resolve yet, just changes to make, so
			# it reports as the pause it is rather than as a conflict
			local STATUS_GITDIR=$(git -C "$STATE_WORKTREE" rev-parse --git-dir 2>/dev/null)
			local STATUS_AUTHORING=false
			if [ "$STATE_OPERATION" = "split" ]; then
				STATUS_AUTHORING=true
				PRINT_TEXT "Authoring phase – edit the worktree back to what the %s commit should leave behind." 33 "first"
			elif [ "$STATE_OPERATION" = "edit" ] && [ ! -d "$STATUS_GITDIR/rebase-merge" ] && [ ! -d "$STATUS_GITDIR/rebase-apply" ]; then
				STATUS_AUTHORING=true
				PRINT_TEXT "Authoring phase – edit files in the worktree (add %s to also reword)." 33 '--text "…"'
			fi
			if [ "$STATUS_AUTHORING" = "true" ]; then
				PRINT_TEXT "Then %s – or cancel via %s." 33 "git edit --continue" "git edit --abort"
				EMIT_PAUSED "$STATE_OPERATION" "$STATE_TARGET" "$STATE_WORKTREE"
			else
				PRINT_TEXT "Resolve there, then %s – or cancel via %s." 33 "git edit --continue" "git edit --abort"
				EMIT_CONFLICT "$STATE_WORKTREE" "$UNMERGED_LIST"
			fi
		else
			PRINT_ERR "State exists but its worktree is gone – run 'git edit --abort' to clear"
			exit 1
		fi
	else
		local JF=$(_JOURNAL_FILE_PATH)
		if [ -n "$JF" ] && [ -s "$JF" ]; then
			local LAST=$(tail -1 "$JF")
			PRINT_TEXT "No operation in flight. Last completed: %s (%s → %s)" 32 "$(echo "$LAST" | cut -d' ' -f5-)" "$(echo "$LAST" | awk '{print substr($3,1,7)}')" "$(echo "$LAST" | awk '{print substr($4,1,7)}')"
		else
			PRINT_TEXT "%s" 32 "No operation in flight."
		fi
		echo "git-edit: ok — no operation in flight"
		_STATUS_EMITTED=true
	fi
}

# Names what a worktree-isolated rewrite left stale in the main checkout, which still holds
# names the paths the rewrite changed and the targeted restore that syncs exactly those
_PRINT_REWRITE_APPLY_HINT () {
	# Args: <branch-name> [<old-head> <new-head>] [<action>]
	local BRANCH="$1"
	local ACTION_NAME="$4"
	# A pure history rewrite leaves the tip tree byte-identical, so the checkout already
	# matches and a stash/reset dance would cycle unrelated WIP for nothing
	if [ -n "$2" ] && [ -n "$3" ] && \
	   [ "$(git rev-parse "$2^{tree}" 2>/dev/null)" = "$(git rev-parse "$3^{tree}" 2>/dev/null)" ]; then
		PRINT_TEXT "Branch %s rewritten – tip tree unchanged, your checkout is already current." 32 "$BRANCH"
		return
	fi
	# Reconcile only what the rewrite touched – a blanket `reset --hard` discards unrelated
	# WIP and a stash dance cycles a checkout parallel sessions share, both risking work the
	# rewrite took care not to touch, while `--source=HEAD` also removes paths it dropped
	local -a CHANGED
	if [ -n "$2" ] && [ -n "$3" ]; then
		CHANGED=("${(@f)$(git diff --name-only "$2" "$3" 2>/dev/null)}")
	fi
	if [ -n "${CHANGED[1]}" ]; then
		# A drop is the one rewrite whose leftover paths are the point rather than staleness –
		# its content lands back as uncommitted work, so the restore is offered as an opt-in
		if [ "$ACTION_NAME" = "drop" ]; then
			PRINT_TEXT "Branch %s rewritten – the dropped content is now uncommitted in your checkout:" 32 "$BRANCH"
		else
			PRINT_TEXT "Branch %s rewritten – your checkout still holds the pre-rewrite content of:" 32 "$BRANCH"
		fi
		printf '%s\n' "${CHANGED[@]}" | head -10 | sed "/./!d;s/^/${_DIM}  /;s/\$/${_OFF}/"
		if [ ${#CHANGED[@]} -gt 10 ]; then
			PRINT_TEXT "  … and %s more" 90 "$(( ${#CHANGED[@]} - 10 ))"
		fi
		local RESTORE="git restore --source=HEAD --staged --worktree -- ${(j: :)${(q-)CHANGED[@]}}"
		if [ "$ACTION_NAME" = "drop" ]; then
			PRINT_TEXT "Keep it, or discard those paths with: %s" 32 "$RESTORE"
		else
			PRINT_TEXT "Reconcile those paths (discards local edits to them): %s" 32 "$RESTORE"
		fi
	else
		PRINT_TEXT "Branch %s rewritten – run %s in your main checkout when ready to apply." 32 "$BRANCH" "git reset --hard"
	fi
}

# Names the untracked files a staging sweep absorbs – an amend takes them as readily as edits, so a
# scratch file left there joins the commit and reads as a tool bug in the summary – name
# them up front so the amend stays deliberate, and ignored paths never reach here anyway
_PRINT_UNTRACKED_ABSORB () {
	# Args: [<worktree>]
	local WT=${1:-.}
	local -a UNTRACKED
	UNTRACKED=("${(@f)$(git -C "$WT" ls-files --others --exclude-standard 2>/dev/null)}")
	if [ -z "${UNTRACKED[1]}" ]; then
		return 0
	fi
	PRINT_TEXT "Absorbing %s untracked file(s) that were not in the commit:" 33 "${#UNTRACKED[@]}"
	printf '%s\n' "${UNTRACKED[@]}" | head -10 | sed "/./!d;s/^/${_DIM}  /;s/\$/${_OFF}/"
	if [ ${#UNTRACKED[@]} -gt 10 ]; then
		PRINT_TEXT "  … and %s more" 90 "$(( ${#UNTRACKED[@]} - 10 ))"
	fi
}

# Sweeps orphaned temp worktrees – ours go with the operation that made them, so debris
# from a killed process or a deleted repo – sweep only the provable case, a `.git` pointer
# whose gitdir is gone, since anything still registered may be a resolution someone wants
_GC_ORPHANED_WORKTREES () {
	setopt local_options null_glob
	local BASE=${TMPDIR:-/tmp}
	local -a REMOVED
	local DIR GITDIR
	for DIR in "${BASE%/}"/git-edit-*; do
		if [ ! -d "$DIR" ] || [ ! -f "$DIR/.git" ]; then
			continue
		fi
		GITDIR=$(sed -n 's/^gitdir: //p' "$DIR/.git" 2>/dev/null)
		if [ -z "$GITDIR" ] || [ -e "$GITDIR" ]; then
			continue
		fi
		# A dangling pointer can also mean the repo's volume is merely
		# unmounted, so only sweep what has sat untouched for a day – `-mtime +1`
		# truncates to whole days and would mean two, so `-mmin` carries the 24h
		if [ -z "$(find "$DIR" -maxdepth 0 -mmin +1440 2>/dev/null)" ]; then
			continue
		fi
		if rm -rf "$DIR" 2>/dev/null; then
			REMOVED+=("${DIR:t}")
		fi
	done
	if [ -n "${REMOVED[1]}" ]; then
		PRINT_TEXT "Swept %s orphaned temp worktree(s) – their repo is gone" 90 "${#REMOVED[@]}"
	fi
}

# Refuses every mutating mode while another operation is paused, the plumbing ones included –
# starting a second rewrite moves the branch under the paused one, whose CAS then refuses at
# apply time, which is safe but strands work that was resolvable a moment earlier
_REQUIRE_NO_INFLIGHT () {
	if _STATE_EXISTS; then
		PRINT_ERR "Another git-edit operation is in flight (paused for resolution)"
		ECHO_E "\e[0;31m  Run 'git edit --continue' or 'git edit --abort' first.\e[0m" >&2
		exit 1
	fi
}

# Refuses a branch that moved under a resolution – a parallel session landed a commit, so the
# rewrite cannot apply, but the resolution is finished and the worktree holds the only copy,
# so keep it and its state rather than letting the exit trap strand both
_REFUSE_MOVED_BRANCH () {
	# Args: <branch> <worktree>
	_CLEANUP_HOOK=""
	PRINT_ERR "Branch '$1' moved during resolution – refusing to overwrite"
	PRINT_TEXT "Your resolution is intact in %s" 33 "$2"
	PRINT_TEXT "It was built on the old tip, so it can't apply – %s, then redo it against the new tip." 33 "git edit --abort"
	exit 1
}

GIT_STASH () {
	# Scan all unmerged paths and auto-stage any that no longer contain conflict markers
	for FILE in $(git diff --name-only --diff-filter=U); do
		if ! grep -qE '^(<<<<<<<|=======|>>>>>>>)( |$)' "$FILE"; then
			git add "$FILE"
			local CMD="git add '$FILE'"
			PRINT_CMD "$CMD"
			eval "$CMD"
		fi
	done

	# Nothing to stash – skip the attempt rather than print a `git stash push` that saved
	# nothing, which in an isolated worktree is always so and reads as the caller's own stash
	if [ -z "$(git status --porcelain)" ]; then
		return 0
	fi

	# Capture current stash SHA (if any) to compare later
	local OLD_STASH=$(git rev-parse -q --verify refs/stash)

	local CMD="git stash push -u"
	PRINT_CMD "$CMD"
	eval "$CMD -m '$COMMANDLINE'"
	local STATUS=$?
	
	# Capture the new stash SHA
	local NEW_STASH=$(git rev-parse -q --verify refs/stash)

	if [[ $STATUS -ne 0 ]]; then
		local UNMERGED_FILES=$(git diff --name-only --diff-filter=U)
		if [[ -n "$UNMERGED_FILES" ]]; then
			PRINT_ERR "Stash failed because of conflict markers in files"
			while IFS= read -r FILE; do
				ECHO_E "\e[0;31m  - $FILE\e[0m" >&2
			done <<< "$UNMERGED_FILES"
		else
			PRINT_ERR "Stash failed"
		fi
		ABORT
	elif [[ "$OLD_STASH" != "$NEW_STASH" ]]; then
		STASH_REF="stash@{0}"
	fi
}

GIT_UNSTASH () {
	if [ -n "$STASH_REF" ]; then
		# Override color config just for this command:
		# • `added` (staged) -> normal, dropping green from successful merges
		# • `changed` (unstaged) -> normal, dropping red from standard mods
		# • `untracked` -> normal, dropping red from new files
		# • `unmerged` -> red, keeping critical conflicts red
		local CMD="git -c color.status.added=normal -c color.status.changed=normal -c color.status.untracked=normal -c color.status.unmerged=red stash pop"
		PRINT_CMD "git stash pop"

		eval "$CMD '$STASH_REF'"
		unset STASH_REF
	fi
}

GIT_RUN_AND_HANDLE_CONFLICTS () {
	local OUTPUT STATUS # Needs to be separate for `$?` to work properly
	OUTPUT=$(eval "$*" 2>&1 | tee /dev/stderr)
	STATUS=$?

	if [[ $STATUS -ne 0 ]]; then
		if [[ "$OUTPUT" == *"CONFLICT ("* ]]; then
			# In non-TTY contexts (Claude Code, CI, piped stdin) there's no one
			# to answer CONTINUE_OR_ABORT, whose empty read would auto-proceed –
			# staging files with conflict markers still in them. When the rebase
			# is isolated, pause into --continue/--abort like the other modes; the
			# branch hasn't moved, so the caller resolves in the worktree at their
			# own pace. Without a worktree the rebase sits in the main checkout,
			# where a pause would strand every other session – abort there.
			if _IS_NON_INTERACTIVE; then
				if [ -n "$WORKTREE_DIR" ] && [ -n "$ORIG_BRANCH" ]; then
					_SAVE_STATE "operation=rebase" "action=$ACTION" "worktree=$WORKTREE_DIR" \
						"branch=refs/heads/$ORIG_BRANCH" "orig_head=$ORIG_HEAD" "target=$COMMIT"
					_CLEANUP_HOOK=""
					PRINT_ERR "Conflict during $ACTION – resolve in worktree, then 'git edit --continue'"
					PRINT_TEXT "Worktree: %s" 33 "$WORKTREE_DIR"
					local UNMERGED_LIST=$(_PRINT_CONFLICT_DETAIL "$WORKTREE_DIR")
					PRINT_TEXT "Or abort the operation: %s" 33 "git edit --abort"
					EMIT_CONFLICT "$WORKTREE_DIR" "$UNMERGED_LIST"
					exit 2
				fi
				PRINT_ERR "Merge conflict during non-interactive run – cannot resolve from non-TTY"
				ECHO_E "\e[0;31m  Re-run interactively to resolve, or use --exec for full control over the rebase.\e[0m" >&2
				ABORT
			fi
			# Identify two commits to name in the prompt:
			#  - the "anchor": the user's mental subject (TARGET for squash,
			#    COMMIT for edit) — what they're modifying;
			#  - the "failing": REBASE_HEAD, the commit currently being applied
			#    that conflicted (the squashed-in commit on fixup, or a later
			#    commit being replayed after the user's edit).
			# Name both when distinct: "in <anchor> while applying <failing>".
			# Fall back to whichever is available (drop mode has no single
			# anchor; an old git might not expose REBASE_HEAD); empty if
			# neither, preserving the original prompt wording.
			local _ANCHOR_FULL="" _FAILING_FULL=""
			case "$ACTION" in
				squash) _ANCHOR_FULL=$(git rev-parse "$TARGET" 2>/dev/null) ;;
				edit)   _ANCHOR_FULL=$(git rev-parse "$COMMIT" 2>/dev/null) ;;
			esac
			_FAILING_FULL=$(git rev-parse REBASE_HEAD 2>/dev/null)

			local _ANCHOR_LABEL="" _FAILING_LABEL=""
			local _SHA _SUB
			if [ -n "$_ANCHOR_FULL" ]; then
				_SHA=$(git rev-parse --short "$_ANCHOR_FULL" 2>/dev/null)
				_SUB=$(git log -1 --pretty=format:'%s' "$_ANCHOR_FULL" 2>/dev/null)
				if [ -n "$_SUB" ]; then _ANCHOR_LABEL="$_SHA ($_SUB)"; else _ANCHOR_LABEL="$_SHA"; fi
			fi
			if [ -n "$_FAILING_FULL" ]; then
				_SHA=$(git rev-parse --short "$_FAILING_FULL" 2>/dev/null)
				_SUB=$(git log -1 --pretty=format:'%s' "$_FAILING_FULL" 2>/dev/null)
				if [ -n "$_SUB" ]; then _FAILING_LABEL="$_SHA ($_SUB)"; else _FAILING_LABEL="$_SHA"; fi
			fi

			# Phrase the description so the failing commit is the active
			# subject and the anchor is the destination/context — saying
			# "in <anchor>" misleads the reader into thinking the target
			# itself raised the conflict, when in fact the target applied
			# cleanly and it's the fold-in / replay that couldn't.
			local CONFLICTING_DESC=""
			if [ -n "$_ANCHOR_FULL" ] && [ -n "$_FAILING_FULL" ] && [ "$_ANCHOR_FULL" != "$_FAILING_FULL" ]; then
				case "$ACTION" in
					squash) CONFLICTING_DESC=" applying $_FAILING_LABEL into $_ANCHOR_LABEL" ;;
					edit)   CONFLICTING_DESC=" applying $_FAILING_LABEL, after editing $_ANCHOR_LABEL" ;;
					*)      CONFLICTING_DESC=" applying $_FAILING_LABEL" ;;
				esac
			elif [ -n "$_FAILING_LABEL" ]; then
				CONFLICTING_DESC=" applying $_FAILING_LABEL"
			elif [ -n "$_ANCHOR_LABEL" ]; then
				CONFLICTING_DESC=" with $_ANCHOR_LABEL"
			fi

			if [ -n "$WORKTREE_DIR" ]; then
				if [ "$AUTO_OPEN_EDITOR" = "true" ]; then
					_OPEN_WORKTREE_IN_EDITOR
					PRINT_TEXT "%s%s – resolve in %s (opened in %s), then press %s to continue, %s to re-open, or %s to cancel." 33 "Merge conflicts" "$CONFLICTING_DESC" "$WORKTREE_DIR" "$OPEN_EDITOR_NAME" "Enter" "Space" "Escape"
				elif [ -n "$OPEN_EDITOR_CMD" ]; then
					PRINT_TEXT "%s%s – press %s to open %s in %s, %s to continue after resolving, or %s to cancel." 33 "Merge conflicts" "$CONFLICTING_DESC" "Space" "$WORKTREE_DIR" "$OPEN_EDITOR_NAME" "Enter" "Escape"
				else
					PRINT_TEXT "%s%s – resolve in %s, then press %s to continue, or %s to cancel editing." 33 "Merge conflicts" "$CONFLICTING_DESC" "$WORKTREE_DIR" "Enter" "Escape"
				fi
			else
				PRINT_TEXT "%s%s – Resolve them and press %s to continue, or %s to cancel editing." 33 "Merge conflicts" "$CONFLICTING_DESC" "Enter" "Escape"
			fi
			CONTINUE_OR_ABORT ${OPEN_EDITOR_CMD:+open}

			GIT_ADD_ALL
			GIT_REBASE_CONTINUE
		elif [[ "$OUTPUT" == *"--allow-empty"* ]] || [[ "$OUTPUT" == *"No changes - did you forget to use"* ]]; then
			PRINT_TEXT "%s – Press %s to skip (drop) it, or %s to cancel editing." 33 "A later commit is now empty" "Enter" "Escape"
			CONTINUE_OR_ABORT "" skip

			GIT_ADD_ALL
			GIT_REBASE_CONTINUE "--skip"
		else
			PRINT_ERR "Unknown error during rebase."
			ABORT
		fi
	fi
}

GIT_REBASE_DROP () {
	# Determine if the oldest commit has a parent or is the first commit
	if git show -s --pretty=%P "$COMMIT" | grep -q .; then
		local CMD=(-c rerere.enabled=true rebase --no-autostash --interactive "$COMMIT~")
	else
		local CMD=(-c rerere.enabled=true rebase --no-autostash --interactive --root)
	fi
	PRINT_CMD "git ${CMD[*]} # -> drop"

	local SED_SCRIPT=""
	local DROP_COMMIT
	for DROP_COMMIT in "${COMMITS[@]}"; do
		SED_SCRIPT+=' -e "s/^pick '"${DROP_COMMIT:0:7}"'/drop '"${DROP_COMMIT:0:7}"'/"'
	done
	GIT_SEQUENCE_EDITOR=$'sed -i ""'"$SED_SCRIPT" \
	GIT_RUN_AND_HANDLE_CONFLICTS "git ${CMD[*]}"
}

GIT_REBASE_SQUASH () {
	# `squash` opens `GIT_EDITOR` on the combined message where `fixup` does not, so it is
	# used when the caller wants to edit the message (`-m`) or supplied one (`--text`)
	local OP; if [[ -n "$TEXT_VALUE" || -n "$OPT_MESSAGE" ]]; then OP=squash; else OP=fixup; fi

	# A `squash` without a pre-supplied `--text` opens an editor partway through, so bail
	# loudly rather than hang waiting for input
	if [[ "$OP" == "squash" && -z "$TEXT_VALUE" ]]; then
		_REQUIRE_TTY_FOR_EDITOR
	fi

	# Determine rebase start point (parent of the oldest commit)
	local OLDEST="${COMMITS[1]}"
	if git show -s --pretty=%P "$OLDEST" | grep -q .; then
		local CMD=(-c rerere.enabled=true rebase --no-autostash --interactive "$OLDEST~")
	else
		local CMD=(-c rerere.enabled=true rebase --no-autostash --interactive --root)
	fi
	PRINT_CMD "git ${CMD[*]} # -> reorder+$OP"

	# Build `sed` script
	local SED_SCRIPT=""
	local APPEND_BLOCK=""
	local C
	for C in "${COMMITS[@]}"; do
		# If this commit is the target, skip it
		if [[ "$C" == "$TARGET" ]]; then
			continue
		fi
		SED_SCRIPT+=' -e "/^pick '"${C:0:7}"'/d" -e "/^squash '"${C:0:7}"'/d"'
		APPEND_BLOCK+=$'\\\\\n'"$OP ${C:0:7}"
	done

	# Where `--text` was supplied, write it to a temp file and override `GIT_EDITOR` with
	# `cp <file>`, so git "edits" the combined-message file by overwriting it
	local TEXT_MSG_FILE=""
	if [[ -n "$TEXT_VALUE" ]]; then
		TEXT_MSG_FILE=$(MKTEMP_FILE git-edit-squash-msg)
		printf '%s\n' "$TEXT_VALUE" > "$TEXT_MSG_FILE"
	fi

	# Execute rebase
	if [[ -n "$TEXT_MSG_FILE" ]]; then
		GIT_SEQUENCE_EDITOR=$'sed -i ""'"$SED_SCRIPT"$' -e "/^pick '"${TARGET:0:7}"'/a'"$APPEND_BLOCK"'"' \
		GIT_EDITOR="cp '$TEXT_MSG_FILE'" \
		GIT_RUN_AND_HANDLE_CONFLICTS "git ${CMD[*]}"
		rm -f "$TEXT_MSG_FILE"
	else
		GIT_SEQUENCE_EDITOR=$'sed -i ""'"$SED_SCRIPT"$' -e "/^pick '"${TARGET:0:7}"'/a'"$APPEND_BLOCK"'"' \
		GIT_RUN_AND_HANDLE_CONFLICTS "git ${CMD[*]}"
	fi
}

GIT_REBASE_BEGIN_EDIT () {
	# Determine if commit has a parent or is the first commit
	if git show -s --pretty=%P "$COMMIT" | grep -q .; then
		local CMD=(-c rerere.enabled=true rebase --no-autostash --interactive "$COMMIT~")
	else
		local CMD=(-c rerere.enabled=true rebase --no-autostash --interactive --root)
	fi
	PRINT_CMD "git ${CMD[*]} # -> edit"

	GIT_SEQUENCE_EDITOR=$'sed -i "" -e "s/^pick '"${COMMIT:0:7}"'/edit '"${COMMIT:0:7}"'/"' \
	git "${CMD[@]}" || ABORT
}

GIT_ADD_ALL () {
	_UNLINK_WORKTREE_EXTRAS "$(git rev-parse --show-toplevel 2>/dev/null)"
	_PRINT_UNTRACKED_ABSORB
	local CMD="git add --all"
	PRINT_CMD "$CMD"

	eval "$CMD" || ABORT
}

# Answers whether the current squash could take the plumbing-only path, so `-s` can auto-route
# to `-S` safely:
# • The selected commits form a contiguous range
# • Target, where given, equals the oldest commit, so nothing reorders
# • No commit in the range is a merge
# Operates implicitly on the global `$COMMITS` array and optional `$TARGET`
_RESQUASH_ELIGIBLE () {
	local OLDEST=${COMMITS[1]}
	local NEWEST=${COMMITS[-1]}

	# Target must equal oldest – any other target requires reordering, which
	# the plumbing path can't do
	[ -n "$TARGET" ] && [ "$TARGET" != "$OLDEST" ] && return 1

	# Contiguity check: the inclusive range `OLDEST..NEWEST` must equal the
	# selected commits exactly, in the same order
	local EXPECTED
	if git rev-parse --verify "$OLDEST^" >/dev/null 2>&1; then
		EXPECTED=($(git rev-list --reverse "$OLDEST^..$NEWEST" 2>/dev/null))
	else
		EXPECTED=($(git rev-list --reverse "$NEWEST" 2>/dev/null))
	fi

	[ ${#EXPECTED[@]} -ne ${#COMMITS[@]} ] && return 1

	local i
	for (( i=1; i<=${#COMMITS[@]}; i++ )); do
		[ "${COMMITS[$i]}" != "${EXPECTED[$i]}" ] && return 1
	done

	# No merge commits in the range
	local C P_LIST
	for C in "${COMMITS[@]}"; do
		P_LIST=$(git log -1 --format='%P' "$C")
		[[ "$P_LIST" == *" "* ]] && return 1
	done

	return 0
}

# Run an arbitrary command (passed via $@) inside a fresh, per-invocation
# temporary worktree (detached HEAD at the current branch tip). If the
# command rewrites HEAD, atomically update the original branch ref via CAS;
# refuse if the branch moved meanwhile (concurrent commit elsewhere).
# The worktree is removed on exit regardless of outcome.
#
# This lets raw git history-rewriting commands (rebase, commit --amend,
# reset --hard, etc.) run without ever touching the main checkout — safe to
# use even when other Claude Code sessions are editing files in parallel.
GIT_EXEC () {
	local ORIG_HEAD=$(git rev-parse HEAD)
	local BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null)
	local REF
	if [ -n "$BRANCH" ]; then
		REF="refs/heads/$BRANCH"
	else
		REF="HEAD"
	fi
	# Defaults for the status trailer, updated below if `HEAD` changes
	EXEC_NEW_HEAD=$ORIG_HEAD
	EXEC_REF=$REF
	EXEC_CHANGED=false

	# Unique per-invocation worktree so concurrent --exec calls never collide
	local WT=$(MKTEMP_DIR git-edit-exec)
	rmdir "$WT"  # `git worktree add` wants to create the dir itself
	local CMD="git worktree add --detach '$WT' $ORIG_HEAD"
	PRINT_CMD "$CMD"
	eval "$CMD" || { rm -rf "$WT"; exit 1; }
	_LINK_WORKTREE_EXTRAS "$WT"

	# Register cleanup via the global hook so the `EXIT` trap removes the worktree on any
	# exit path – success, failure or signal
	_CLEANUP_HOOK="git worktree remove --force '$WT' 2>/dev/null; rm -rf '$WT'"

	cd "$WT" || exit 1

	# Run the caller's command – no `eval`, the array passes straight through so quoting
	# and special characters survive
	PRINT_CMD "$* # (in $WT)"
	"$@"
	local STATUS=$?

	if [ $STATUS -ne 0 ]; then
		PRINT_ERR "Command exited with status $STATUS — leaving original branch unchanged"
		exit $STATUS
	fi

	# Did the command move HEAD? If so, apply the new tip to the original ref.
	local NEW_HEAD=$(git rev-parse HEAD)
	if [ "$NEW_HEAD" = "$ORIG_HEAD" ]; then
		PRINT_TEXT "HEAD unchanged – nothing to apply." 33
		return 0
	fi

	# Pushed guard: refuse if the rewrite would orphan a commit that exists on
	# a remote (any remote ref that was an ancestor of the old tip must still
	# be one of the new tip). --exec can't know its targets up front, so this
	# is checked on the result, before anything is applied.
	if [ ${#OPT_ALLOW_PUSHED} -eq 0 ]; then
		local R
		for R in $(git for-each-ref refs/remotes --format='%(refname)'); do
			if git merge-base --is-ancestor "$R" "$ORIG_HEAD" 2>/dev/null && \
			   ! git merge-base --is-ancestor "$R" "$NEW_HEAD" 2>/dev/null; then
				PRINT_ERR "Command rewrote pushed history ($R would be orphaned) – not applied"
				ECHO_E "\e[0;31m  Rewritten history is at $NEW_HEAD; pass --allow-pushed to override.\e[0m" >&2
				exit 1
			fi
		done
	fi

	# Atomic compare-and-swap. If the branch moved during command execution
	# (e.g., a concurrent commit from another session), refuse.
	local UPDATE="git update-ref -m 'git edit: exec' $REF $NEW_HEAD $ORIG_HEAD"
	PRINT_CMD "$UPDATE"
	if ! eval "$UPDATE" 2>/dev/null; then
		PRINT_ERR "Ref '$REF' moved during exec – refusing to overwrite"
		PRINT_TEXT "Rewritten history is at %s (not applied)." 33 "$NEW_HEAD"
		exit 1
	fi
	_RECORD_REF_MOVE "$REF" "$ORIG_HEAD" "$NEW_HEAD" "exec"

	if [ -n "$BRANCH" ]; then
		_PRINT_REWRITE_APPLY_HINT "$BRANCH" "$ORIG_HEAD" "$NEW_HEAD"
	else
		PRINT_TEXT "Detached HEAD updated to %s." 32 "$NEW_HEAD"
	fi

	# Update status trailer outputs (head moved, CAS succeeded)
	EXEC_NEW_HEAD=$NEW_HEAD
	EXEC_CHANGED=true
}

# Builds the tree a scoped fold carries – the base commit's tree with only the
# pathspec-matched staged entries applied, composed from the index's exact blobs like
# the split path, so binary files and mode changes come along and nothing else leaks in
_STAGED_TREE_FOR () {
	local BASE=$1
	local TMPIDX=$(MKTEMP_FILE git-edit-amend-idx)
	rm -f "$TMPIDX"
	GIT_INDEX_FILE=$TMPIDX git read-tree "$BASE" || { rm -f "$TMPIDX"; return 1; }
	local META PATHNAME DSTMODE DSTSHA
	while IFS=$'\t' read -r META PATHNAME; do
		DSTMODE=$(echo "$META" | awk '{print $2}')
		DSTSHA=$(echo "$META" | awk '{print $4}')
		if [ "$DSTMODE" = "000000" ]; then
			GIT_INDEX_FILE=$TMPIDX git update-index --force-remove -- "$PATHNAME" || { rm -f "$TMPIDX"; return 1; }
		else
			GIT_INDEX_FILE=$TMPIDX git update-index --add --cacheinfo "$DSTMODE,$DSTSHA,$PATHNAME" || { rm -f "$TMPIDX"; return 1; }
		fi
	done < <(git diff-index --cached -r "$BASE" -- "${AMEND_PATHSPECS[@]}")
	GIT_INDEX_FILE=$TMPIDX git write-tree
	rm -f "$TMPIDX"
}

# Folds currently-staged changes from the main index into a target commit, leaving unstaged
# files alone – fixup plus autosquash in one operation, snapshotting the index as a fixup
# object, running the autosquash isolated, and CAS-updating the ref against the pre-op tip
GIT_AMEND_INTO () {
	local TARGET=$AMEND_INTO_TARGET

	# Pre-flight: must not be a stale in-flight operation
	_REQUIRE_NO_INFLIGHT

	# Pre-flight: must have staged changes – within the pathspec if one narrows
	# the fold, since "something is staged" says nothing about the named paths
	if git diff --cached --quiet -- "${AMEND_PATHSPECS[@]}" 2>/dev/null; then
		if [ ${#AMEND_PATHSPECS[@]} -gt 0 ]; then
			PRINT_ERR "No staged changes under ${AMEND_PATHSPECS[*]}"
			ECHO_E "\e[0;31m  Stage them with 'git add <files>', or drop the pathspec to fold everything staged.\e[0m" >&2
		else
			PRINT_ERR "No staged changes to amend"
			ECHO_E "\e[0;31m  Stage files with 'git add <files>' before running --amend-into.\e[0m" >&2
		fi
		exit 1
	fi

	# Pre-flight: target must be reachable from `HEAD` (or resolvable to it)
	_GUARD_REACHABLE "$TARGET"
	TARGET=$_RESOLVED_SHA

	# Pre-flight: must be on a branch
	local ORIG_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null)
	if [ -z "$ORIG_BRANCH" ]; then
		PRINT_ERR "--amend-into requires being on a branch (got detached HEAD)"
		exit 1
	fi

	local TARGET_FULL=$(git rev-parse "$TARGET")
	_GUARD_UNPUSHED "$TARGET_FULL"
	_GUARD_NO_MERGE_SPAN "$TARGET_FULL"

	local REF="refs/heads/$ORIG_BRANCH"
	local ORIG_HEAD=$(git rev-parse HEAD)
	# Repo root, not `pwd` – pathspecs in the success sync below must resolve
	# from the root even when the script was invoked from a subdirectory
	local MAIN_DIR=$(git rev-parse --show-toplevel)
	# Commits above the target pre-op – locates the amended commit in the
	# rebased chain afterwards (`NEW_HEAD~DEPTH`), for the completion summary
	local DEPTH=$(git rev-list --count "$TARGET_FULL..HEAD")
	# The folded paths (root-relative): shown in the completion summary, and
	# scoping the success sync to exactly these entries
	local -a STAGED_PATHS
	STAGED_PATHS=("${(@f)$(git diff --cached --name-only -- "${AMEND_PATHSPECS[@]}")}")
	local STAGED_FILES=$(printf '%s\n' "${STAGED_PATHS[@]}" | tr '\n' ',' | sed 's/,$//')

	# Step 1: snapshot the staged index as a commit object. `write-tree` +
	# `commit-tree` build it without moving any ref or touching the index –
	# the staged changes stay staged until the CAS lands.
	local TARGET_SUBJECT=$(git log -1 --format='%s' "$TARGET_FULL")

	# A message alongside the fold rewords the target in the same run –
	# `git commit --amend -m` semantics. It happens here, before the fixup
	# exists, because rewording afterwards would have to find the amended
	# commit again: a replay can drop a commit that went empty, so any
	# offset from the new tip risks naming the wrong one. Rewording up front
	# is pure plumbing – it cannot conflict – and the autosquash then carries
	# it, leaving one CAS for both changes
	local FIXUP_PARENT=$ORIG_HEAD
	if [ -n "$TEXT_VALUE" ]; then
		AMEND_OLD_SUBJECT=$TARGET_SUBJECT
		_REWORD_AND_REBUILD "$TARGET_FULL" "$TEXT_VALUE"
		# The fixup rides on the rebuilt chain, and `fixup!` matches by subject,
		# so both must follow the reword
		FIXUP_PARENT=$_REWORDED_TIP
		TARGET_FULL=$_REWORDED_TARGET
		TARGET_SUBJECT=$(git log -1 --format='%s' "$TARGET_FULL")
	fi

	local STAGED_TREE
	if [ ${#AMEND_PATHSPECS[@]} -gt 0 ]; then
		# Scoped fold – compose `HEAD`'s tree plus only the named staged entries, so whatever else
		# sits in the shared index cannot ride along into a past commit, a parallel session's
		# staging included, which can land in the turn between `git add` and this call
		STAGED_TREE=$(_STAGED_TREE_FOR "$ORIG_HEAD")
	else
		STAGED_TREE=$(git write-tree 2>/dev/null)
	fi
	if [ -z "$STAGED_TREE" ]; then
		PRINT_ERR "Cannot snapshot index (unmerged entries?) – resolve conflicts first"
		exit 1
	fi
	local FIXUP_COMMIT=$(git commit-tree "$STAGED_TREE" -p "$FIXUP_PARENT" -m "fixup! $TARGET_SUBJECT") || exit 1
	PRINT_CMD "git write-tree + commit-tree -> ${FIXUP_COMMIT:0:7}  # fixup! object, branch untouched"

	# Step 2: isolated worktree at the fixup commit object
	local WT=$(MKTEMP_DIR git-edit-amend-into)
	rmdir "$WT"
	local WT_CMD="git worktree add --detach '$WT' $FIXUP_COMMIT"
	PRINT_CMD "$WT_CMD" 90
	if ! eval "$WT_CMD" >/dev/null 2>&1; then
		PRINT_ERR "Failed to create temp worktree"
		exit 1
	fi
	_CLEANUP_HOOK="git worktree remove --force '$WT' 2>/dev/null; rm -rf '$WT'"
	_LINK_WORKTREE_EXTRAS "$WT"

	cd "$WT" || exit 1

	# Determine rebase base (parent of target, or --root if target is initial commit)
	local REBASE_BASE
	if git rev-parse --verify "$TARGET_FULL^" >/dev/null 2>&1; then
		REBASE_BASE="$TARGET_FULL^"
	else
		REBASE_BASE="--root"
	fi

	# Step 3: autosquash. GIT_SEQUENCE_EDITOR=true accepts the auto-arranged
	# TODO without prompting. GIT_EDITOR=true ensures no message editor opens
	# (we use fixup semantics, so this is just defensive).
	# `rerere` here (and on every conflict-capable rebase): a cascade
	# re-conflict of an already-resolved hunk replays the recorded resolution,
	# and the shared `rr-cache` carries it across retries of the whole operation
	local REBASE_CMD="GIT_SEQUENCE_EDITOR=true GIT_EDITOR=true git -c rerere.enabled=true rebase --autosquash --no-autostash --interactive $REBASE_BASE"
	PRINT_CMD "$REBASE_CMD" 90
	if ! eval "$REBASE_CMD" >/dev/null 2>&1; then
		# Conflict during autosquash. Save state, leave the worktree alive,
		# and let the user/agent resolve via `git edit --continue` (or
		# `git edit --abort` to cancel – the branch was never moved, and the
		# staged changes are still staged in main).
		_SAVE_STATE \
			"operation=amend-into" \
			"worktree=$WT" \
			"branch=$REF" \
			"orig_head=$ORIG_HEAD" \
			"target=$TARGET_FULL" \
			"depth=$DEPTH" \
			"rebasebase=$REBASE_BASE" \
			"maindir=$MAIN_DIR" \
			"files=${(pj:\t:)STAGED_PATHS}"\
			"pathspecs=${(pj:\t:)AMEND_PATHSPECS}"
		# Don't auto-cleanup the worktree – it holds the in-progress rebase
		_CLEANUP_HOOK=""

		PRINT_ERR "Conflict during autosquash – resolve in worktree, then 'git edit --continue'"
		PRINT_TEXT "Worktree: %s" 33 "$WT"
		local UNMERGED_LIST=$(_PRINT_CONFLICT_DETAIL "$WT")
		PRINT_TEXT "Or abort the operation: %s" 33 "git edit --abort"
		EMIT_CONFLICT "$WT" "$UNMERGED_LIST"
		exit 2
	fi

	local NEW_HEAD=$(git rev-parse HEAD)

	# Step 4: atomic CAS-update of branch ref, guarded on the pre-op tip. If
	# the branch moved during autosquash (parallel commit), refuse – nothing
	# was consumed, so the staged changes are still intact for a retry.
	local UPDATE_CMD="git update-ref -m 'git edit: amend-into ${TARGET_FULL:0:7}' $REF $NEW_HEAD $ORIG_HEAD"
	PRINT_CMD "$UPDATE_CMD" 90
	if ! eval "$UPDATE_CMD" 2>/dev/null; then
		PRINT_ERR "Branch '$REF' moved during autosquash – refusing to overwrite"
		PRINT_TEXT "Nothing was applied; your staged changes are untouched – retry when ready." 33
		exit 1
	fi
	_RECORD_REF_MOVE "$REF" "$ORIG_HEAD" "$NEW_HEAD" "amend-into ${TARGET_FULL:0:7}"

	# Re-sync exactly the folded paths' index entries to the new HEAD: those
	# staged changes are now part of history, so they should report clean.
	# Path-scoped so anything a parallel session staged meanwhile keeps its
	# staged state (a whole-index reset would silently wipe it).
	git -C "$MAIN_DIR" reset -q -- "${STAGED_PATHS[@]}" 2>/dev/null

	_PRINT_AMENDED_SUMMARY "$NEW_HEAD" "$DEPTH" "$STAGED_FILES" "$MAIN_DIR" "$REBASE_BASE"

	# Export new HEAD + ref for the success trailer in the dispatch block
	AMEND_NEW_HEAD=$NEW_HEAD
	AMEND_REF=$REF
}

# Resolves `--amend-into=auto`: the newest unpushed commit touching the
# staged paths. Conservative – every staged path with history must agree on
# one target; paths with no history (new files) follow that consensus. Each
# refusal lists the per-path candidates – exactly the lookup an explicit
# invocation would have needed anyway.
# Commits that last touched the exact lines the staged diff rewrites. A fix
# usually belongs to whoever wrote the line being fixed, which is not always the
# newest commit to touch the file – whenever an unrelated later commit edited the
# same file, a file-level guess silently folds into the wrong one. Hunks that only
# add lines have no old lines to attribute and so carry no evidence.
_BLAME_AMEND_TARGETS () {
	local TOPLEVEL=$(git rev-parse --show-toplevel)
	local P HUNK START COUNT
	local -a LARGS
	for P in "$@"; do
		LARGS=()
		while IFS= read -r HUNK; do
			# "@@ -<start>[,<count>]" – an absent count means one line, 0 means
			# a pure insertion
			START=${${HUNK#@@ -}%%[, ]*}
			COUNT=$(echo "$HUNK" | sed -nE 's/^@@ -[0-9]+,([0-9]+).*/\1/p')
			[ -z "$COUNT" ] && COUNT=1
			[ "$COUNT" = "0" ] && continue
			LARGS+=(-L "$START,+$COUNT")
		done < <(git -C "$TOPLEVEL" diff --cached -U0 --no-renames -- "$P" 2>/dev/null | grep -E '^@@')
		[ ${#LARGS[@]} -eq 0 ] && continue
		git -C "$TOPLEVEL" blame "${LARGS[@]}" --porcelain HEAD -- "$P" 2>/dev/null | grep -oE '^[0-9a-f]{40}'
	done | sort -u
}

# Resolves `--amend-into=auto` to the newest unpushed commit touching the staged paths –
# conservative, since every staged path with history must agree on one target and paths
# with none follow that consensus, and each refusal lists the per-path candidates
_RESOLVE_AMEND_TARGET () {
	local -a PATHS
	# Scoped to the same pathspec the fold will use – inferring a target from paths that will
	# not be folded answers a question nobody asked
	PATHS=("${(@f)$(git diff --cached --name-only -- "${AMEND_PATHSPECS[@]}")}")
	if [ -z "${PATHS[1]}" ]; then
		PRINT_ERR "No staged changes to amend"
		ECHO_E "\e[0;31m  Stage files with 'git add <files>' before running --amend-into.\e[0m" >&2
		exit 1
	fi

	# Staged paths are root-relative, so anchor the per-path lookups at the repo root and they
	# resolve from a subdirectory too
	local TOPLEVEL=$(git rev-parse --show-toplevel)
	local P C

	# Line-level evidence wins where it exists – it is the difference between
	# folding into the commit that wrote the code and the commit that merely
	# touched the file last
	local -a BLAMED
	BLAMED=(${${(@f)$(_BLAME_AMEND_TARGETS "${PATHS[@]}")}:#})
	if [ ${#BLAMED[@]} -gt 1 ]; then
		PRINT_ERR "Cannot auto-target: the staged lines were last touched by different commits"
		for C in "${BLAMED[@]}"; do
			ECHO_E "\e[0;31m  ${C:0:7} ($(git log -1 --format=%s "$C" 2>/dev/null))\e[0m" >&2
		done
		ECHO_E "\e[0;31m  Pass an explicit --amend-into=<sha>, or stage and fold per target.\e[0m" >&2
		exit 1
	fi
	if [ ${#BLAMED[@]} -eq 1 ]; then
		C=${BLAMED[1]}
		if [ -n "$(git branch -r --contains "$C" 2>/dev/null | grep -v ' -> ')" ]; then
			PRINT_ERR "Cannot auto-target: the staged lines were last touched by a pushed commit (${C:0:7})"
			ECHO_E "\e[0;31m  Its history lies beyond the rewrite horizon – pass an explicit --amend-into=<sha>, or commit separately.\e[0m" >&2
			exit 1
		fi
		ECHO_E "\e[0;90mauto-target: commit that last touched the staged lines\e[0m"
		AMEND_INTO_TARGET=$C
		return
	fi
	# No old lines anywhere – pure additions or new files, nothing to attribute, so fall back
	# to the file-level guess below
	local -a CAND_LINES
	local CANDIDATE=""
	local MULTIPLE=false
	for P in "${PATHS[@]}"; do
		C=$(git -C "$TOPLEVEL" log -1 --format=%H HEAD -- "$P" 2>/dev/null)
		if [ -z "$C" ]; then
			# New file – follows the consensus of the paths with history
			continue
		fi
		if [ -n "$(git branch -r --contains "$C" 2>/dev/null | grep -v ' -> ')" ]; then
			PRINT_ERR "Cannot auto-target: '$P' was last touched by a pushed commit (${C:0:7})"
			ECHO_E "\e[0;31m  Its history lies beyond the rewrite horizon – pass an explicit --amend-into=<sha>, or commit separately.\e[0m" >&2
			exit 1
		fi
		CAND_LINES+=("  $P -> ${C:0:7} ($(git log -1 --format=%s "$C"))")
		if [ -z "$CANDIDATE" ]; then
			CANDIDATE=$C
		elif [ "$C" != "$CANDIDATE" ]; then
			MULTIPLE=true
		fi
	done

	if [ -z "$CANDIDATE" ]; then
		PRINT_ERR "Cannot auto-target: no staged path has unpushed history"
		ECHO_E "\e[0;31m  All staged paths are new files – pass an explicit --amend-into=<sha>.\e[0m" >&2
		exit 1
	fi
	if [ "$MULTIPLE" = "true" ]; then
		PRINT_ERR "Cannot auto-target: staged paths point at different commits"
		local LINE
		for LINE in "${CAND_LINES[@]}"; do
			ECHO_E "\e[0;31m$LINE\e[0m" >&2
		done
		ECHO_E "\e[0;31m  Pass an explicit --amend-into=<sha>, or stage and fold per target.\e[0m" >&2
		exit 1
	fi

	ECHO_E "\e[0;90mauto-target: newest unpushed commit touching ${#PATHS[@]} staged path(s)\e[0m"
	AMEND_INTO_TARGET=$CANDIDATE
}

# Prints the amended commit's stat after a completed --amend-into, so the
# caller doesn't need a follow-up `git show` to verify where the fold landed.
_PRINT_AMENDED_SUMMARY () {
	# args: <new_head> <depth> <folded-files-comma-separated> [<main-checkout>] [<rebase-base>]
	# The autosquash replays the target first, so the commit directly above the
	# base is the amended one whatever happens above it. An offset from the new
	# tip is not equivalent: a replayed commit whose resolution went empty is
	# dropped, and the count then walks one commit too far – naming a commit
	# the fold never touched, in the block a caller reads to check where it
	# landed. The depth stays as the fallback for states written before this.
	local AMENDED
	if [ -n "$5" ]; then
		if [ "$5" = "--root" ]; then
			AMENDED=$(git rev-list --reverse "$1" 2>/dev/null | head -1)
		else
			AMENDED=$(git rev-list --reverse "$5..$1" 2>/dev/null | head -1)
		fi
	fi
	[ -z "$AMENDED" ] && AMENDED=$(git rev-parse "$1~$2" 2>/dev/null)
	[ -z "$AMENDED" ] && return 0
	if [ -n "$3" ]; then
		PRINT_TEXT "Folded %s into:" 32 "$(echo "$3" | sed 's/,/, /g')"
	else
		PRINT_TEXT "%s" 32 "Amended commit:"
	fi
	git show --stat --format='  %h %s' "$AMENDED" | head -12 | sed "/./!d;s/^/${_DIM}/;s/\$/${_OFF}/"
	# Same reasoning as reword's: a fold that also reworded replaced a subject,
	# and a symbolic target can make that the wrong one
	if [ -n "$AMEND_OLD_SUBJECT" ]; then
		PRINT_TEXT "  replaced: %s" 90 "$AMEND_OLD_SUBJECT"
	fi
	_PRINT_LEFTOVER_STATE "$4"
}

# States what the fold left behind in the main checkout. A fold consumes the
# staged changes and nothing else, but the caller can't see that from here –
# and "did my WIP survive?" was the single most common follow-up probe, so
# answer it rather than making them run `git status` for it. The fold itself
# runs from an isolated worktree, so this must read the caller's checkout by
# path – reporting the worktree's own state would be a confident wrong answer,
# which is worse than printing nothing (hence the silent return).
_PRINT_LEFTOVER_STATE () {
	local D=$1
	[ -z "$D" ] || [ ! -d "$D" ] && return 0
	local STAGED=$(git -C "$D" diff --cached --name-only 2>/dev/null | grep -c .)
	local UNSTAGED=$(git -C "$D" diff --name-only 2>/dev/null | grep -c .)
	local UNTRACKED=$(git -C "$D" ls-files --others --exclude-standard 2>/dev/null | grep -c .)
	local PARTS=""
	[ "$UNSTAGED" -gt 0 ]  && PARTS="$UNSTAGED modified"
	[ "$UNTRACKED" -gt 0 ] && PARTS="${PARTS:+$PARTS, }$UNTRACKED untracked"
	if [ "$STAGED" -gt 0 ] && [ ${#AMEND_PATHSPECS[@]} -gt 0 ]; then
		# A scoped fold is meant to leave the rest staged – state it plainly
		PRINT_TEXT "Left staged (outside the pathspec): %s file(s)." 32 "$STAGED"
	elif [ "$STAGED" -gt 0 ]; then
		# Nothing should survive an unscoped fold – the caller expects an empty
		# index, so anything left is worth flagging
		PRINT_TEXT "Left staged: %s file(s) – not folded." 33 "$STAGED"
	else
		PRINT_TEXT "Index now empty; working tree keeps %s." 32 "${PARTS:-no changes}"
	fi
}

# Shared pre-flight for both split paths: resolves a <sha> an earlier rewrite
# staled, then refuses what neither path can express – the initial commit (no
# parent to rest the extracted half on), a merge, or pushed history. Leaves
# the resolved SHA in `_RESOLVED_SHA` for the caller to adopt.
_SPLIT_GUARDS () {
	local X=$1
	_GUARD_REACHABLE "$X"
	X=$_RESOLVED_SHA
	if ! git rev-parse --verify "$X^" >/dev/null 2>&1; then
		PRINT_ERR "Cannot split the initial commit"
		exit 1
	fi
	if [[ "$(git log -1 --format='%P' "$X")" == *" "* ]]; then
		PRINT_ERR "Cannot split merge commit ${X:0:7}"
		exit 1
	fi
	_GUARD_UNPUSHED "$X"
}

# Turns an extracted tree into the two commits and applies them – the extracted commit rests
# on the target's parent, the remainder carries the target's own tree and message, and
# the target's tree ends the pair either way, so neither split path can conflict
_SPLIT_APPLY () {
	local X=$1
	local TREE1=$2
	local REF=$3
	local ORIG_HEAD=$4
	local MSG=$5

	# Both halves keep the original author + date
	local AN=$(git log -1 --format='%an' "$X")
	local AE=$(git log -1 --format='%ae' "$X")
	local AD=$(git log -1 --format='%aI' "$X")
	local X_MSG=$(git log -1 --format='%B' "$X")

	local C1=$(
		GIT_AUTHOR_NAME="$AN" GIT_AUTHOR_EMAIL="$AE" GIT_AUTHOR_DATE="$AD" \
		git commit-tree "$TREE1" -p "$X^" -m "$MSG"
	) || ABORT
	local C2=$(
		GIT_AUTHOR_NAME="$AN" GIT_AUTHOR_EMAIL="$AE" GIT_AUTHOR_DATE="$AD" \
		git commit-tree "$X^{tree}" -p "$C1" -m "$X_MSG"
	) || ABORT
	PRINT_CMD "git commit-tree ... -> ${C1:0:7} + ${C2:0:7}  # split ${X:0:7}"

	# Rebuild descendants on top of the remainder commit
	PREV_OLD=$X
	PREV_NEW=$C2
	_REBUILD_DESCENDANTS "$X"

	# Atomic CAS ref update
	local CMD="git update-ref -m 'git edit: split ${X:0:7}' $REF $PREV_NEW $ORIG_HEAD"
	PRINT_CMD "$CMD"
	if ! eval "$CMD" 2>/dev/null; then
		PRINT_ERR "Ref '$REF' moved during split – refusing to overwrite"
		PRINT_TEXT "Split history is at %s (not applied)." 33 "$PREV_NEW"
		exit 1
	fi
	_RECORD_REF_MOVE "$REF" "$ORIG_HEAD" "$PREV_NEW" "split ${X:0:7}"

	# The remainder keeps the commit's full tree and descendants keep theirs,
	# so the tip tree is identical by construction – stated so callers don't
	# re-verify with a diff
	PRINT_TEXT "%s – split into:" 32 "Tip tree unchanged by construction ✓"
	git show --stat --format='  %h %s' "$C1" | head -8 | sed "/./!d;s/^/${_DIM}/;s/\$/${_OFF}/"
	git show --stat --format='  %h %s' "$C2" | head -8 | sed "/./!d;s/^/${_DIM}/;s/\$/${_OFF}/"

	SPLIT_NEW_HEAD=$PREV_NEW
	SPLIT_REF=$REF
}

# Splits a commit by pathspec into two, plumbing only – an extracted commit carrying the
# matched changes with its message from `--text`, then one with the original message
# carrying the rest, trees composed directly so no conflict is possible
GIT_SPLIT () {
	local -a PATHSPECS
	PATHSPECS=("$@")
	local X=$SPLIT_TARGET

	# Capture the ref to update
	local ORIG_HEAD=$(git rev-parse HEAD)
	local BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null)
	local REF
	if [ -n "$BRANCH" ]; then
		REF="refs/heads/$BRANCH"
	else
		REF="HEAD"
	fi

	_SPLIT_GUARDS "$X"
	X=$_RESOLVED_SHA

	# The pathspec must match a nonempty, proper subset of the commit's changes
	local -a ALL_FILES MATCHED
	ALL_FILES=("${(@f)$(git diff-tree -r --name-only --no-commit-id "$X^" "$X")}")
	MATCHED=("${(@f)$(git diff-tree -r --name-only --no-commit-id "$X^" "$X" -- "${PATHSPECS[@]}")}")
	if [ -z "${MATCHED[1]}" ]; then
		PRINT_ERR "Pathspec matches no changes in ${X:0:7}"
		exit 1
	fi
	if [ ${#MATCHED[@]} -eq ${#ALL_FILES[@]} ]; then
		PRINT_ERR "Pathspec covers every change in ${X:0:7} – nothing to split off"
		if [ ${#ALL_FILES[@]} -eq 1 ]; then
			# One file means no pathspec can separate the halves – send them to
			# the form that authors the split point instead
			ECHO_E "\e[0;31m  It touches one file, so drop the pathspec and split by content:\e[0m" >&2
			ECHO_E "\e[0;31m    git edit --split=${X:0:7} --text \"First subject\"\e[0m" >&2
		else
			ECHO_E "\e[0;31m  Narrow the pathspec to the subset you want extracted.\e[0m" >&2
		fi
		exit 1
	fi

	# Extracted tree: the parent's tree with the matched paths at the commit's
	# versions, composed in a temp index from `diff-tree`'s exact blobs (no
	# patch application, so binary files and mode changes come along natively)
	local TMPIDX=$(MKTEMP_FILE git-edit-split-idx)
	rm -f "$TMPIDX"
	GIT_INDEX_FILE=$TMPIDX git read-tree "$X^" || { rm -f "$TMPIDX"; exit 1; }
	local META PATHNAME DSTMODE DSTSHA
	while IFS=$'\t' read -r META PATHNAME; do
		DSTMODE=$(echo "$META" | awk '{print $2}')
		DSTSHA=$(echo "$META" | awk '{print $4}')
		if [ "$DSTMODE" = "000000" ]; then
			GIT_INDEX_FILE=$TMPIDX git update-index --force-remove -- "$PATHNAME" || { rm -f "$TMPIDX"; exit 1; }
		else
			GIT_INDEX_FILE=$TMPIDX git update-index --add --cacheinfo "$DSTMODE,$DSTSHA,$PATHNAME" || { rm -f "$TMPIDX"; exit 1; }
		fi
	done < <(git diff-tree -r "$X^" "$X" -- "${PATHSPECS[@]}")
	local TREE1=$(GIT_INDEX_FILE=$TMPIDX git write-tree)
	rm -f "$TMPIDX"
	[ -z "$TREE1" ] && { PRINT_ERR "Failed to compose the extracted tree"; exit 1; }

	_SPLIT_APPLY "$X" "$TREE1" "$REF" "$ORIG_HEAD" "$TEXT_VALUE"
}

# Splits a commit whose halves share a file, where no pathspec can name them apart – hands
# back an isolated worktree holding the commit's content for the caller to edit down to
# the first commit's, the one hunk-level split describable without `git add -p`
GIT_SPLIT_PAUSE () {
	_REQUIRE_NO_INFLIGHT

	local BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null)
	if [ -z "$BRANCH" ]; then
		PRINT_ERR "Splitting by content requires being on a branch (got detached HEAD)"
		exit 1
	fi

	_SPLIT_GUARDS "$SPLIT_TARGET"
	local X=$_RESOLVED_SHA

	local WT=$(MKTEMP_DIR git-edit-split)
	rmdir "$WT"  # `git worktree add` wants to create the dir itself
	if ! git worktree add --detach "$WT" "$X" >/dev/null 2>&1; then
		PRINT_ERR "Cannot create split worktree at ${X:0:7}"
		exit 1
	fi
	_LINK_WORKTREE_EXTRAS "$WT"

	# A message given up front survives the pause in a sidecar – the state
	# file's key=value lines can't carry a multi-line one
	if [ -n "$TEXT_VALUE" ]; then
		print -r -- "$TEXT_VALUE" > "$(_SPLIT_MSG_PATH)"
	fi
	_SAVE_STATE "operation=split" "worktree=$WT" "branch=refs/heads/$BRANCH" \
		"orig_head=$(git rev-parse HEAD)" "target=$X" "maindir=$(git rev-parse --show-toplevel)"

	PRINT_ACTION "Splitting %s..." "$X"
	PRINT_TEXT "Worktree at the commit's own content: %s" 33 "$WT"
	PRINT_TEXT "Edit it back to what the %s commit should leave behind – undo there whatever belongs in the second:" 33 "first"
	git show --stat --format='' "$X" | sed "/./!d;s/^/${_DIM}  /;s/\$/${_OFF}/"
	if [ -n "$TEXT_VALUE" ]; then
		PRINT_TEXT "Then %s – or cancel via %s." 33 "git edit --continue" "git edit --abort"
	else
		PRINT_TEXT "Then %s – or cancel via %s." 33 'git edit --continue --text "First subject"' "git edit --abort"
	fi
	# The remainder inherits a subject written for the whole change, so it
	# usually wants a reword the caller would otherwise only notice later
	PRINT_TEXT "The second commit keeps %s's message – reword it afterwards with %s." 33 "${X:0:7}" "git edit -M"
	EMIT_PAUSED split "$X" "$WT"
	exit 2
}

# Resumes a paused content split – snapshot the authored worktree as the extracted commit's
# tree, then apply the pair, running from the main checkout so the descendant rebuild
# reads the branch as it stands and carries a commit that landed during the pause
_CONTINUE_SPLIT () {
	if [ ! -d "$STATE_WORKTREE" ]; then
		PRINT_ERR "Worktree no longer exists: $STATE_WORKTREE"
		_CLEAR_STATE
		exit 1
	fi
	cd "${STATE_MAINDIR:-.}" || exit 1

	local X=$STATE_TARGET
	PRINT_ACTION "Continuing split of %s..." "$X"

	# The authored tree rests on the target's parent, so a rewrite of the target
	# mid-pause would silently re-seat it on content it was never derived from
	if ! git merge-base --is-ancestor "$X" "$STATE_BRANCH" 2>/dev/null; then
		PRINT_ERR "Commit ${X:0:7} left the branch during the pause – the authored tree no longer rests on its parent"
		ECHO_E "\e[0;31m  Run 'git edit --abort' and redo the split against the current history.\e[0m" >&2
		exit 1
	fi

	local MSG=$TEXT_VALUE
	local MSGFILE=$(_SPLIT_MSG_PATH)
	if [ -z "$MSG" ] && [ -f "$MSGFILE" ]; then
		MSG=$(cat "$MSGFILE")
	fi
	if [ -z "$MSG" ]; then
		PRINT_ERR "Pass --text with 'git edit --continue' – the extracted commit needs a message"
		exit 1
	fi

	# Snapshot the authored working tree through a temp index seeded from the
	# target – the worktree's own index stays as the caller left it, so a
	# refused continue doesn't quietly stage their mistake for the next one
	local TMPIDX=$(MKTEMP_FILE git-edit-split-idx)
	rm -f "$TMPIDX"
	_UNLINK_WORKTREE_EXTRAS "$STATE_WORKTREE"
	_PRINT_UNTRACKED_ABSORB "$STATE_WORKTREE"
	local TREE1=""
	if GIT_INDEX_FILE=$TMPIDX git -C "$STATE_WORKTREE" read-tree "$X" 2>/dev/null; then
		GIT_INDEX_FILE=$TMPIDX git -C "$STATE_WORKTREE" add -A >/dev/null 2>&1
		TREE1=$(GIT_INDEX_FILE=$TMPIDX git -C "$STATE_WORKTREE" write-tree)
	fi
	rm -f "$TMPIDX"
	if [ -z "$TREE1" ]; then
		PRINT_ERR "Failed to read the authored tree from $STATE_WORKTREE"
		exit 1
	fi

	if [ "$TREE1" = "$(git rev-parse "$X^^{tree}")" ]; then
		PRINT_ERR "Worktree matches ${X:0:7}'s parent – the extracted commit would be empty"
		ECHO_E "\e[0;31m  Edit $STATE_WORKTREE to the state the first commit should leave, then retry.\e[0m" >&2
		exit 1
	fi
	if [ "$TREE1" = "$(git rev-parse "$X^{tree}")" ]; then
		PRINT_ERR "Worktree is unchanged from ${X:0:7} – the remainder commit would be empty"
		ECHO_E "\e[0;31m  Undo the parts belonging to the second commit in $STATE_WORKTREE, then retry.\e[0m" >&2
		exit 1
	fi

	# The pair always ends at the target's tree, so a path the target never
	# touched can only be reverted again by the remainder – stray worktree
	# debris rather than anything the caller means to commit
	local STRAY=$(comm -23 \
		<(git diff-tree -r --name-only "$X^^{tree}" "$TREE1" | sort) \
		<(git diff-tree -r --name-only "$X^^{tree}" "$X^{tree}" | sort))
	if [ -n "$STRAY" ]; then
		PRINT_ERR "Worktree changes paths ${X:0:7} never touched – the remainder would just revert them"
		echo "$STRAY" | sed "s/^/${_RED}  /;s/\$/${_OFF}/" >&2
		ECHO_E "\e[0;31m  Undo them in $STATE_WORKTREE (git checkout -- <path>, or rm for ones it added), then retry.\e[0m" >&2
		exit 1
	fi

	_CLEANUP_HOOK="git worktree remove --force '$STATE_WORKTREE' 2>/dev/null; rm -rf '$STATE_WORKTREE'"

	_SPLIT_APPLY "$X" "$TREE1" "$STATE_BRANCH" "$(git rev-parse "$STATE_BRANCH")" "$MSG"
	_CLEAR_STATE
	PRINT_COMPLETED "$SPLIT_NEW_HEAD" "$SPLIT_REF" true
}

_ABORT_SPLIT () {
	PRINT_ACTION "Aborting split of %s..." "${STATE_TARGET:0:7}"

	if [ -d "$STATE_WORKTREE" ]; then
		local CMD="git worktree remove --force '$STATE_WORKTREE' 2>/dev/null; rm -rf '$STATE_WORKTREE'"
		PRINT_CMD "$CMD" 90
		eval "$CMD"
	fi

	_CLEAR_STATE
	PRINT_TEXT "Branch was never touched – nothing to roll back." 32
	PRINT_TEXT "%s" 32 "Split aborted, state cleared."
	EMIT_STATUS "$STATE_ORIG_HEAD" "$STATE_BRANCH" false
}

# Reorders a contiguous span, the positional args giving the new order oldest-first – runs
# the rebase in an isolated temp worktree under a scripted `GIT_SEQUENCE_EDITOR`, reusing
# the conflict pause machinery, and the branch ref only moves at the end
GIT_REORDER () {
	# Pre-flight: must not be a stale in-flight operation
	_REQUIRE_NO_INFLIGHT

	# Pre-flight: must be on a branch
	local ORIG_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null)
	if [ -z "$ORIG_BRANCH" ]; then
		PRINT_ERR "--reorder requires being on a branch (got detached HEAD)"
		exit 1
	fi
	local REF="refs/heads/$ORIG_BRANCH"
	local ORIG_HEAD=$(git rev-parse HEAD)

	if [ ${#COMMITS_DESIRED[@]} -lt 2 ]; then
		PRINT_ERR "--reorder needs at least two commits (in the desired new order)"
		exit 1
	fi

	# All commits must be distinct
	local UNIQUE_COUNT=$(printf '%s\n' "${COMMITS[@]}" | sort -u | wc -l | tr -d ' ')
	if [ "$UNIQUE_COUNT" -ne ${#COMMITS[@]} ]; then
		PRINT_ERR "--reorder arguments must be distinct commits"
		exit 1
	fi

	# No-op if the desired order matches the current order
	local SAME=true
	local i
	for (( i=1; i<=${#COMMITS[@]}; i++ )); do
		[ "${COMMITS[$i]}" != "${COMMITS_DESIRED[$i]}" ] && SAME=false
	done
	if [ "$SAME" = "true" ]; then
		PRINT_TEXT "%s" 33 "Desired order matches the current order – nothing to do."
		EMIT_STATUS "$ORIG_HEAD" "$REF" false
		exit 0
	fi

	# Contiguity: the span oldest..newest must equal the selection exactly
	local OLDEST=${COMMITS[1]}
	local NEWEST=${COMMITS[-1]}
	if ! git merge-base --is-ancestor "$NEWEST" HEAD 2>/dev/null; then
		PRINT_ERR "Commit ${NEWEST:0:7} is not reachable from HEAD"
		exit 1
	fi
	local EXPECTED
	if git rev-parse --verify "$OLDEST^" >/dev/null 2>&1; then
		EXPECTED=($(git rev-list --reverse "$OLDEST^..$NEWEST"))
	else
		EXPECTED=($(git rev-list --reverse "$NEWEST"))
	fi
	if [ ${#EXPECTED[@]} -ne ${#COMMITS[@]} ]; then
		PRINT_ERR "--reorder requires a contiguous span of commits"
		ECHO_E "\e[0;31m  Selected ${#COMMITS[@]}; range ${OLDEST:0:7}..${NEWEST:0:7} contains ${#EXPECTED[@]}.\e[0m" >&2
		exit 1
	fi
	for (( i=1; i<=${#COMMITS[@]}; i++ )); do
		if [ "${COMMITS[$i]}" != "${EXPECTED[$i]}" ]; then
			PRINT_ERR "--reorder requires a contiguous span of commits"
			exit 1
		fi
	done

	# No merge commits in the span
	local C P_LIST
	for C in "${COMMITS[@]}"; do
		P_LIST=$(git log -1 --format='%P' "$C")
		if [[ "$P_LIST" == *" "* ]]; then
			PRINT_ERR "--reorder cannot handle merge commit ${C:0:7}"
			exit 1
		fi
	done

	_GUARD_UNPUSHED "$OLDEST"
	_GUARD_NO_MERGE_SPAN "$OLDEST"

	# Rebase base (parent of the oldest, or --root for the initial commit)
	local REBASE_BASE
	if git rev-parse --verify "$OLDEST^" >/dev/null 2>&1; then
		REBASE_BASE="$OLDEST^"
	else
		REBASE_BASE="--root"
	fi
	# Total todo length, for the completion summary's log span
	local TOTAL
	if [ "$REBASE_BASE" = "--root" ]; then
		TOTAL=$(git rev-list --count HEAD)
	else
		TOTAL=$(git rev-list --count "$REBASE_BASE..HEAD")
	fi

	# Isolated worktree at the current tip
	local WT=$(MKTEMP_DIR git-edit-reorder)
	rmdir "$WT"
	local WT_CMD="git worktree add --detach '$WT' $ORIG_HEAD"
	PRINT_CMD "$WT_CMD" 90
	if ! eval "$WT_CMD" >/dev/null 2>&1; then
		PRINT_ERR "Failed to create temp worktree"
		exit 1
	fi
	_CLEANUP_HOOK="git worktree remove --force '$WT' 2>/dev/null; rm -rf '$WT'"
	_LINK_WORKTREE_EXTRAS "$WT"
	cd "$WT" || exit 1

	# Scripted sequence editor – drop the span's `pick` lines and re-emit them at the first
	# one's position in the desired order, matching the todo's abbreviated SHAs as prefixes
	# of our full ones, with the order traveling by env so the script needs no interpolation
	local SEQ=$(MKTEMP_FILE git-edit-reorder-seq)
	cat > "$SEQ" <<'SEQEOF'
#!/bin/zsh
awk -v order="$GIT_EDIT_REORDER_ORDER" '
	BEGIN { n = split(order, O, " ") }
	/^pick / {
		member = 0
		for (i = 1; i <= n; i++) {
			if (index(O[i], $2) == 1) { member = 1; break }
		}
		if (member) {
			if (!done) {
				for (i = 1; i <= n; i++) print "pick", O[i]
				done = 1
			}
			next
		}
	}
	{ print }
' "$1" > "$1.new" && mv "$1.new" "$1"
SEQEOF
	chmod +x "$SEQ"

	local REBASE_CMD="GIT_EDIT_REORDER_ORDER='${COMMITS_DESIRED[*]}' GIT_SEQUENCE_EDITOR='$SEQ' GIT_EDITOR=true git -c rerere.enabled=true rebase --no-autostash --interactive $REBASE_BASE"
	PRINT_CMD "GIT_SEQUENCE_EDITOR=<reorder script> git rebase --interactive $REBASE_BASE" 90
	if ! eval "$REBASE_CMD" >/dev/null 2>&1 && \
	   ! { _AUTO_RESOLVE_FINAL_REORDER "$WT" "$ORIG_HEAD" && _FINISH_AUTO_RESOLVED_REORDER "$WT" }; then
		rm -f "$SEQ"
		# Conflict while replaying – persist state for --continue/--abort.
		# The branch was never moved, so --abort has nothing to roll back.
		_SAVE_STATE \
			"operation=reorder" \
			"worktree=$WT" \
			"branch=$REF" \
			"orig_head=$ORIG_HEAD" \
			"target=$OLDEST"
		_CLEANUP_HOOK=""

		PRINT_ERR "Conflict while reordering – resolve in worktree, then 'git edit --continue'"
		PRINT_TEXT "Worktree: %s" 33 "$WT"
		local UNMERGED_LIST=$(_PRINT_CONFLICT_DETAIL "$WT" "$ORIG_HEAD")
		PRINT_TEXT "Or abort the operation: %s" 33 "git edit --abort"
		EMIT_CONFLICT "$WT" "$UNMERGED_LIST"
		exit 2
	fi
	rm -f "$SEQ"

	local NEW_HEAD=$(git rev-parse HEAD)

	# Atomic CAS-update, guarded on the pre-op tip
	local UPDATE_CMD="git update-ref -m 'git edit: reorder ${OLDEST:0:7}..${NEWEST:0:7}' $REF $NEW_HEAD $ORIG_HEAD"
	PRINT_CMD "$UPDATE_CMD" 90
	if ! eval "$UPDATE_CMD" 2>/dev/null; then
		PRINT_ERR "Branch '$REF' moved during reorder – refusing to overwrite"
		PRINT_TEXT "Reordered history is at %s (not applied)." 33 "$NEW_HEAD"
		exit 1
	fi
	_RECORD_REF_MOVE "$REF" "$ORIG_HEAD" "$NEW_HEAD" "reorder ${OLDEST:0:7}..${NEWEST:0:7}"

	# Completion summary: tree identity (clean reorders preserve the tip tree;
	# conflict resolutions may not) + the rewritten span in its new order
	_PRINT_REORDER_SUMMARY "$ORIG_HEAD" "$NEW_HEAD"

	REORDER_NEW_HEAD=$NEW_HEAD
	REORDER_REF=$REF
}

# Resume an in-flight --reorder after conflict resolution. Mirrors
# _CONTINUE_AMEND_INTO: continue the rebase in the preserved worktree, then
# CAS the branch from its (untouched) pre-op tip.
# A reorder's FINAL step has exactly one correct resolution – the reorder
# preserves the tree, so the conflicted paths take the pre-op tip's blobs. The
# tool already derives that and used to print it as homework, costing a
# round-trip to run a command it had computed. Applying it here is safe because
# on the last step it is provable before anything is committed: the staged tree
# becomes the final commit's tree, so it must equal the pre-op tree. Any other
# shape – earlier step, missing path, tree mismatch – falls through to the
# manual pause untouched.
_AUTO_RESOLVE_FINAL_REORDER () {
	# args: <worktree> <pre-op head>
	local WT=$1
	local PREOP=$2
	[ -z "$PREOP" ] && return 1
	local GITDIR=$(git -C "$WT" rev-parse --git-dir 2>/dev/null)
	[ -z "$GITDIR" ] && return 1
	local STEP_NOW=$(cat "$GITDIR/rebase-merge/msgnum" 2>/dev/null)
	local STEP_END=$(cat "$GITDIR/rebase-merge/end" 2>/dev/null)
	if [ -z "$STEP_NOW" ] || [ "$STEP_NOW" != "$STEP_END" ]; then
		return 1
	fi
	local -a UNMERGED
	UNMERGED=("${(@f)$(git -C "$WT" diff --name-only --diff-filter=U 2>/dev/null)}")
	[ -z "${UNMERGED[1]}" ] && return 1
	local P
	for P in "${UNMERGED[@]}"; do
		git -C "$WT" checkout "$PREOP" -- "$P" >/dev/null 2>&1 || return 1
		git -C "$WT" add -- "$P" >/dev/null 2>&1 || return 1
	done
	# The proof: on the last step the staged tree is the result
	local STAGED_TREE=$(git -C "$WT" write-tree 2>/dev/null)
	[ -n "$STAGED_TREE" ] && [ "$STAGED_TREE" = "$(git rev-parse "$PREOP^{tree}" 2>/dev/null)" ]
}

# Finishes a rebase whose final step `_AUTO_RESOLVE_FINAL_REORDER()` just staged
_FINISH_AUTO_RESOLVED_REORDER () {
	local WT=$1
	PRINT_TEXT "%s – restored the pre-op blobs and continued." 32 "Final step auto-resolved (staged tree proven identical)"
	GIT_SEQUENCE_EDITOR=true GIT_EDITOR=true git -C "$WT" -c rerere.enabled=true rebase --continue >/dev/null 2>&1
}

# Completion summary for both reorder paths: tree identity, the span in its new
# order (oldest-first, matching how `--reorder` takes its arguments), and a
# count check. That last one matters most after a hand-resolved conflict –
# resolving a step to its predecessor's content leaves that commit empty, and
# the rebase drops it, which "tip tree identical" would otherwise wave through.
_PRINT_REORDER_SUMMARY () {
	# args: <orig-head> <new-head>
	local BASE=$(git merge-base "$1" "$2" 2>/dev/null)
	local BEFORE=$(git rev-list --count "$BASE..$1" 2>/dev/null)
	local AFTER=$(git rev-list --count "$BASE..$2" 2>/dev/null)
	if git diff --quiet "$1" "$2" 2>/dev/null; then
		PRINT_TEXT "%s – new order (oldest-first):" 32 "Tip tree identical ✓"
	else
		PRINT_TEXT "%s" 33 "Note: tip tree differs from before (conflict resolutions changed content) – new order (oldest-first):"
	fi
	git log --reverse --format='  %h %s' -"${AFTER:-12}" "$2" | head -12 | sed "/./!d;s/^/${_DIM}/;s/\$/${_OFF}/"
	if [ -n "$BEFORE" ] && [ -n "$AFTER" ] && [ "$AFTER" -lt "$BEFORE" ]; then
		PRINT_TEXT "%s commit(s) resolved to empty and were dropped – %s before, %s after." 33 \
			"$((BEFORE - AFTER))" "$BEFORE" "$AFTER"
	fi
}

# Resolves where `$1` (a branch tip) left `$2` (the upstream). A rewritten
# upstream orphans the commit the branch actually forked from, and plain
# `merge-base` then answers with a far older ancestor – replaying from there
# would re-apply commits the upstream already carries. `--fork-point` reads
# the upstream's reflog, which still holds the pre-rewrite tip, so it finds
# the real fork. It has nothing to work from on a freshly cloned or expired
# reflog, hence the fallback.
_ONTO_FORK_POINT () {
	local BRANCH_TIP=$1
	local UPSTREAM=$2
	local FORK=$(git merge-base --fork-point "$UPSTREAM" "$BRANCH_TIP" 2>/dev/null)
	if [ -z "$FORK" ]; then
		FORK=$(git merge-base "$UPSTREAM" "$BRANCH_TIP" 2>/dev/null)
	fi
	echo "$FORK"
}

# Replays the current branch onto `$ONTO_UPSTREAM`, deriving the fork point
# rather than taking it as an argument. Automates the "rebase onto a rewritten
# main" sequence: find the fork, report what each side carries, replay in an
# isolated worktree, CAS the branch.
GIT_ONTO () {
	_REQUIRE_NO_INFLIGHT

	local ORIG_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null)
	if [ -z "$ORIG_BRANCH" ]; then
		PRINT_ERR "--onto requires being on a branch (got detached HEAD)"
		exit 1
	fi
	local REF="refs/heads/$ORIG_BRANCH"
	local ORIG_HEAD=$(git rev-parse HEAD)
	# Captured before the cd into the temp worktree – the replant changes what
	# this checkout should hold, so it has to be brought along afterwards
	local MAIN_DIR=$(git rev-parse --show-toplevel)

	if ! git rev-parse --quiet --verify "$ONTO_UPSTREAM^{commit}" >/dev/null 2>&1; then
		PRINT_ERR "Unknown upstream: $ONTO_UPSTREAM"
		exit 1
	fi
	local UPSTREAM_FULL=$(git rev-parse "$ONTO_UPSTREAM^{commit}")
	if [ "$UPSTREAM_FULL" = "$ORIG_HEAD" ]; then
		PRINT_ERR "--onto target is the branch itself – name the branch to replant onto"
		exit 1
	fi

	local FORK=$(_ONTO_FORK_POINT "$ORIG_HEAD" "$ONTO_UPSTREAM")
	if [ -z "$FORK" ]; then
		PRINT_ERR "No common ancestor between '$ORIG_BRANCH' and '$ONTO_UPSTREAM' – nothing to replay from"
		exit 1
	fi

	# Already replanted: the upstream tip is the fork, so there is nothing to move
	if [ "$(git rev-parse "$FORK")" = "$UPSTREAM_FULL" ]; then
		PRINT_TEXT "%s" 33 "Already on top of $ONTO_UPSTREAM – nothing to replay."
		EMIT_STATUS "$ORIG_HEAD" "$REF" false
		exit 0
	fi

	local -a SPAN
	SPAN=("${(@f)$(git rev-list --reverse "$FORK..$ORIG_HEAD" 2>/dev/null)}")
	if [ -z "${SPAN[1]}" ]; then
		PRINT_TEXT "%s" 33 "Branch '$ORIG_BRANCH' carries no commits past the fork – nothing to replay."
		EMIT_STATUS "$ORIG_HEAD" "$REF" false
		exit 0
	fi

	# The replay rewrites every commit in the span, so the same guards the
	# other rewriting modes apply hold here – anchored on the oldest, which
	# covers the rest since no descendant of an unpushed commit is pushed
	_GUARD_UNPUSHED "${SPAN[1]}"
	_GUARD_NO_MERGE_SPAN "${SPAN[1]}"
	_GUARD_ONTO_CHECKOUT_CLEAN "$MAIN_DIR" "$ORIG_HEAD" "$UPSTREAM_FULL"

	PRINT_ACTION "Replanting %s onto %s..." "$ORIG_BRANCH" "$ONTO_UPSTREAM"
	# Whether the old base still sits on the upstream decides how surprising
	# this is – an orphaned one means the upstream was rewritten underneath
	if git merge-base --is-ancestor "$FORK" "$UPSTREAM_FULL" 2>/dev/null; then
		PRINT_TEXT "Fork point %s is still on %s." 32 "$(git log -1 --format='%h %s' "$FORK")" "$ONTO_UPSTREAM"
	else
		PRINT_TEXT "Fork point %s was orphaned by a rewrite – recovered from the reflog." 33 \
			"$(git log -1 --format='%h %s' "$FORK")"
	fi
	local GAINED=$(git rev-list --count "$FORK..$UPSTREAM_FULL" 2>/dev/null)
	PRINT_TEXT "%s gained %s commit(s); replaying %s from '%s' on top:" 32 \
		"$ONTO_UPSTREAM" "${GAINED:-0}" "${#SPAN[@]}" "$ORIG_BRANCH"
	_PRINT_ONTO_TRIAGE "$UPSTREAM_FULL" "$ORIG_HEAD" "$FORK"

	local WT=$(MKTEMP_DIR git-edit-onto)
	rmdir "$WT"
	local WT_CMD="git worktree add --detach '$WT' $ORIG_HEAD"
	PRINT_CMD "$WT_CMD" 90
	if ! eval "$WT_CMD" >/dev/null 2>&1; then
		PRINT_ERR "Failed to create temp worktree"
		exit 1
	fi
	_CLEANUP_HOOK="git worktree remove --force '$WT' 2>/dev/null; rm -rf '$WT'"
	_LINK_WORKTREE_EXTRAS "$WT"
	cd "$WT" || exit 1

	# Detached, so the branch ref stays put until the CAS – and the branch can
	# stay checked out in whatever worktree the caller is using
	local REBASE_CMD="GIT_SEQUENCE_EDITOR=true GIT_EDITOR=true git -c rerere.enabled=true rebase --no-autostash --onto $UPSTREAM_FULL $FORK"
	PRINT_CMD "$REBASE_CMD" 90
	if ! eval "$REBASE_CMD" >/dev/null 2>&1; then
		# The upstream's name and the span size are only known here – without
		# them the resumed run reports the replant against a bare SHA and a
		# count that trivially matches itself
		_SAVE_STATE \
			"operation=onto" \
			"worktree=$WT" \
			"branch=$REF" \
			"orig_head=$ORIG_HEAD" \
			"target=$UPSTREAM_FULL" \
			"upstream=$ONTO_UPSTREAM" \
			"span=${#SPAN[@]}" \
			"fork=$FORK" \
			"maindir=$MAIN_DIR"
		_CLEANUP_HOOK=""

		PRINT_ERR "Conflict while replanting – resolve in worktree, then 'git edit --continue'"
		PRINT_TEXT "Worktree: %s" 33 "$WT"
		local UNMERGED_LIST=$(_PRINT_CONFLICT_DETAIL "$WT")
		_PRINT_ONTO_SKIP_HINT "$WT" "$UPSTREAM_FULL"
		PRINT_TEXT "Or abort the operation: %s" 33 "git edit --abort"
		EMIT_CONFLICT "$WT" "$UNMERGED_LIST"
		exit 2
	fi

	local NEW_HEAD=$(git rev-parse HEAD)
	local UPDATE_CMD="git update-ref -m 'git edit: onto ${UPSTREAM_FULL:0:7}' $REF $NEW_HEAD $ORIG_HEAD"
	PRINT_CMD "$UPDATE_CMD" 90
	if ! eval "$UPDATE_CMD" 2>/dev/null; then
		PRINT_ERR "Branch '$REF' moved during replant – refusing to overwrite"
		PRINT_TEXT "Replanted history is at %s (not applied)." 33 "$NEW_HEAD"
		exit 1
	fi
	_RECORD_REF_MOVE "$REF" "$ORIG_HEAD" "$NEW_HEAD" "onto ${UPSTREAM_FULL:0:7}"
	_SYNC_ONTO_CHECKOUT "$MAIN_DIR" "$ORIG_HEAD" "$NEW_HEAD"

	_PRINT_ONTO_SUMMARY "$UPSTREAM_FULL" "$NEW_HEAD" "${#SPAN[@]}" "$ORIG_HEAD" "$FORK"

	ONTO_NEW_HEAD=$NEW_HEAD
	ONTO_REF=$REF
}

# Splits the span into what the upstream already carries and what is genuinely
# this branch's, using patch ids – the rebase drops the former silently, and a
# caller who doesn't know that reads the shorter result as lost work
_PRINT_ONTO_TRIAGE () {
	local UPSTREAM=$1
	local TIP=$2
	local FORK=$3
	local -a UNIQUE DUPLICATE
	local LINE
	while IFS= read -r LINE; do
		[ -z "$LINE" ] && continue
		if [[ "$LINE" == "+ "* ]]; then
			UNIQUE+=("${LINE#+ }")
		else
			DUPLICATE+=("${LINE#- }")
		fi
	done < <(git cherry "$UPSTREAM" "$TIP" "$FORK" 2>/dev/null)

	local C
	for C in "${UNIQUE[@]}"; do
		git log -1 --format='  %h %s' "$C" 2>/dev/null | sed "/./!d;s/^/${_DIM}/;s/\$/${_OFF}/"
	done
	if [ ${#DUPLICATE[@]} -gt 0 ]; then
		PRINT_TEXT "%s commit(s) are already on %s and will be dropped:" 33 "${#DUPLICATE[@]}" "$ONTO_UPSTREAM"
		for C in "${DUPLICATE[@]}"; do
			git log -1 --format='  %h %s' "$C" 2>/dev/null | sed "/./!d;s/^/${_DIM}/;s/\$/${_OFF}/"
		done
	fi
}

# Names the skip a replant wants – a conflict on a commit the upstream carries another way
# case where skipping is the answer rather than a merge – say so, since the
# generic "resolve it" advice produces a duplicate commit instead
_PRINT_ONTO_SKIP_HINT () {
	local WT=$1
	local UPSTREAM=$2
	local GITDIR=$(git -C "$WT" rev-parse --git-dir 2>/dev/null)
	local STOPPED=$(cat "$GITDIR/rebase-merge/stopped-sha" 2>/dev/null)
	[ -z "$STOPPED" ] && return 0
	# `git cherry` compares patch ids, so an upstream that took the same change
	# via a different commit still matches
	local VERDICT=$(git cherry "$UPSTREAM" "$STOPPED" "$STOPPED^" 2>/dev/null | head -1)
	if [[ "$VERDICT" == "- "* ]]; then
		PRINT_TEXT "%s is already on %s in another form – %s is likely right here." 33 \
			"$(git log -1 --format='%h %s' "$STOPPED" 2>/dev/null)" "$ONTO_UPSTREAM" "git edit --skip"
	fi
}

# Refuses before anything moves where the checkout holds uncommitted work on a path the
# replant would rewrite – the sync afterwards declines to overwrite it, correctly, but
# only once the branch had moved, leaving the ref and the files disagreeing
_GUARD_ONTO_CHECKOUT_CLEAN () {
	local DIR=$1
	local FROM=$2
	local UPSTREAM=$3
	[ -z "$DIR" ] || [ ! -d "$DIR" ] && return 0

	local -a AFFECTED DIRTY BLOCKED
	AFFECTED=("${(@f)$(git -C "$DIR" diff --name-only "$FROM" "$UPSTREAM" 2>/dev/null)}")
	[ -z "${AFFECTED[1]}" ] && return 0
	# Unstaged, staged, and untracked all block a two-way merge onto that path
	DIRTY=("${(@f)$(
		git -C "$DIR" diff --name-only 2>/dev/null
		git -C "$DIR" diff --cached --name-only 2>/dev/null
		git -C "$DIR" ls-files --others --exclude-standard 2>/dev/null
	)}")
	[ -z "${DIRTY[1]}" ] && return 0

	local A D
	for A in "${AFFECTED[@]}"; do
		[ -z "$A" ] && continue
		for D in "${DIRTY[@]}"; do
			[ "$A" = "$D" ] && BLOCKED+=("$A")
		done
	done
	[ ${#BLOCKED[@]} -eq 0 ] && return 0

	PRINT_ERR "Uncommitted work sits on ${#BLOCKED[@]} path(s) the replant rewrites – refusing to strand the checkout"
	printf '%s\n' "${(@u)BLOCKED}" | head -10 | sed "/./!d;s/^/${_RED}  /;s/\$/${_OFF}/" >&2
	ECHO_E "\e[0;31m  Commit, stash, or move them, then retry – nothing was changed.\e[0m" >&2
	exit 1
}

# Brings the caller's checkout along after the branch it is on was replanted – the other
# isolated modes skip this since a reorder preserves the tree, and leaving a replant
# behind makes every commit the upstream gained read as a local deletion
_SYNC_ONTO_CHECKOUT () {
	local DIR=$1
	local FROM=$2
	local TO=$3
	[ -z "$DIR" ] || [ ! -d "$DIR" ] && return 0
	local ERR=$(git -C "$DIR" read-tree -u -m "$FROM" "$TO" 2>&1)
	if [ -z "$ERR" ]; then
		PRINT_TEXT "Checkout updated to the replanted branch." 32
	else
		# The branch has moved, so the checkout now disagrees with `HEAD` – but the paths that
		# blocked the update are the caller's uncommitted work, and naming them matters more than
		# a command, since the obvious `checkout -- .` discards what the refusal just protected
		local -a BLOCKED
		BLOCKED=("${(@f)$(printf '%s\n' "$ERR" | grep -o "'[^']*'" | tr -d "'" | sort -u)}")
		PRINT_TEXT "%s" 33 "Branch replanted, but the checkout could not follow – it still holds the pre-replant content."
		if [ -n "${BLOCKED[1]}" ]; then
			PRINT_TEXT "Blocked by uncommitted work in: %s" 33 "${(j:, :)BLOCKED}"
			PRINT_TEXT "Commit or move those, then: %s" 33 "git -C $DIR checkout -- ."
		else
			PRINT_TEXT "Reconcile once your uncommitted work is safe: %s" 33 "git -C $DIR checkout -- ."
		fi
	fi
}

# Prints what the replant produced, so the caller doesn't reach for `git log` next
_PRINT_ONTO_SUMMARY () {
	local UPSTREAM=$1
	local NEW_HEAD=$2
	local EXPECTED=$3
	local PREOP=$4
	local FORK=$5
	local LANDED=$(git rev-list --count "$UPSTREAM..$NEW_HEAD" 2>/dev/null)
	if [ -n "$EXPECTED" ]; then
		PRINT_TEXT "Replanted %s of %s commit(s) onto %s:" 32 "${LANDED:-0}" "$EXPECTED" "$ONTO_UPSTREAM"
	else
		PRINT_TEXT "Replanted %s commit(s) onto %s:" 32 "${LANDED:-0}" "$ONTO_UPSTREAM"
	fi
	git log --reverse --format='  %h %s' "$UPSTREAM..$NEW_HEAD" 2>/dev/null | head -12 | \
		sed "/./!d;s/^/${_DIM}/;s/\$/${_OFF}/"

	# A shorter result reads as lost work unless the shortfall is accounted for, and its two
	# causes are not interchangeable – the rebase drops what the upstream already carries,
	# while a skip was the caller's call, so count duplicates from patch ids, not the gap
	[ -z "$LANDED" ] || [ -z "$EXPECTED" ] || [ "$LANDED" -ge "$EXPECTED" ] && return 0
	local DUPLICATES=0
	if [ -n "$PREOP" ] && [ -n "$FORK" ]; then
		DUPLICATES=$(git cherry "$UPSTREAM" "$PREOP" "$FORK" 2>/dev/null | grep -c '^-')
	fi
	local SKIPPED=$((EXPECTED - LANDED - DUPLICATES))
	if [ "$DUPLICATES" -gt 0 ]; then
		PRINT_TEXT "%s commit(s) were dropped as already upstream." 33 "$DUPLICATES"
	fi
	if [ "$SKIPPED" -gt 0 ]; then
		PRINT_TEXT "%s commit(s) were skipped." 33 "$SKIPPED"
	fi
}

_CONTINUE_ONTO () {
	if [ ! -d "$STATE_WORKTREE" ]; then
		PRINT_ERR "Worktree no longer exists: $STATE_WORKTREE"
		_CLEAR_STATE
		exit 1
	fi

	cd "$STATE_WORKTREE" || exit 1
	_CLEANUP_HOOK="git worktree remove --force '$STATE_WORKTREE' 2>/dev/null; rm -rf '$STATE_WORKTREE'"

	# Restore what the summary and the skip hint name the upstream by
	ONTO_UPSTREAM=${STATE_UPSTREAM:-${STATE_TARGET:0:7}}
	PRINT_ACTION "Continuing replant onto %s..." "$ONTO_UPSTREAM"

	local GITDIR=$(git rev-parse --git-dir 2>/dev/null)
	if [ ! -d "$GITDIR/rebase-merge" ] && [ ! -d "$GITDIR/rebase-apply" ]; then
		if [ "$(git rev-parse HEAD)" = "$STATE_ORIG_HEAD" ]; then
			_CLEAR_STATE
			PRINT_TEXT "%s – branch unchanged." 33 "Replant finished with nothing to apply"
			EMIT_STATUS "$STATE_ORIG_HEAD" "$STATE_BRANCH" false
			exit 0
		fi
		PRINT_TEXT "%s – applying its result." 33 "Replant already completed in worktree"
	else
		local CMD
		if [ ${#OPT_SKIP} -gt 0 ]; then
			CMD="GIT_SEQUENCE_EDITOR=true GIT_EDITOR=true git -c rerere.enabled=true rebase --skip"
		else
			_GUARD_RESOLUTION_CLEAN "$STATE_WORKTREE"
			CMD="GIT_SEQUENCE_EDITOR=true GIT_EDITOR=true git -c rerere.enabled=true rebase --continue"
		fi
		PRINT_CMD "$CMD"
		if ! eval "$CMD" >/dev/null 2>&1; then
			_CLEANUP_HOOK=""
			PRINT_ERR "Conflict continues – resolve more files, then 'git edit --continue'"
			PRINT_TEXT "Worktree: %s" 33 "$STATE_WORKTREE"
			local UNMERGED_LIST=$(_PRINT_CONFLICT_DETAIL "$STATE_WORKTREE")
			_PRINT_ONTO_SKIP_HINT "$STATE_WORKTREE" "$STATE_TARGET"
			PRINT_TEXT "Or abort the operation: %s" 33 "git edit --abort"
			EMIT_CONFLICT "$STATE_WORKTREE" "$UNMERGED_LIST"
			exit 2
		fi
	fi

	local NEW_HEAD=$(git rev-parse HEAD)
	local UPDATE_CMD="git update-ref -m 'git edit: onto ${STATE_TARGET:0:7}' $STATE_BRANCH $NEW_HEAD $STATE_ORIG_HEAD"
	PRINT_CMD "$UPDATE_CMD" 90
	if ! eval "$UPDATE_CMD" 2>/dev/null; then
		_REFUSE_MOVED_BRANCH "$STATE_BRANCH" "$STATE_WORKTREE"
	fi
	_RECORD_REF_MOVE "$STATE_BRANCH" "$STATE_ORIG_HEAD" "$NEW_HEAD" "onto ${STATE_TARGET:0:7}"
	_SYNC_ONTO_CHECKOUT "$STATE_MAINDIR" "$STATE_ORIG_HEAD" "$NEW_HEAD"

	_PRINT_ONTO_SUMMARY "$STATE_TARGET" "$NEW_HEAD" "$STATE_SPAN" "$STATE_ORIG_HEAD" "$STATE_FORK"

	_CLEAR_STATE
	PRINT_COMPLETED "$NEW_HEAD" "$STATE_BRANCH" true
}

_ABORT_ONTO () {
	PRINT_ACTION "Aborting replant onto %s..." "${STATE_UPSTREAM:-${STATE_TARGET:0:7}}"

	if [ -d "$STATE_WORKTREE" ]; then
		git -C "$STATE_WORKTREE" rebase --abort 2>/dev/null
		local CMD="git worktree remove --force '$STATE_WORKTREE' 2>/dev/null; rm -rf '$STATE_WORKTREE'"
		PRINT_CMD "$CMD" 90
		eval "$CMD"
	fi

	_CLEAR_STATE
	PRINT_TEXT "Branch was never touched – nothing to roll back." 32
	PRINT_TEXT "%s" 32 "Replant aborted, state cleared."
	EMIT_STATUS "$STATE_ORIG_HEAD" "$STATE_BRANCH" false
}

_CONTINUE_REORDER () {
	if [ ! -d "$STATE_WORKTREE" ]; then
		PRINT_ERR "Worktree no longer exists: $STATE_WORKTREE"
		_CLEAR_STATE
		exit 1
	fi

	cd "$STATE_WORKTREE" || exit 1

	_CLEANUP_HOOK="git worktree remove --force '$STATE_WORKTREE' 2>/dev/null; rm -rf '$STATE_WORKTREE'"

	PRINT_ACTION "Continuing reorder around %s..." "${STATE_TARGET:0:7}"

	# If no rebase is in progress but `HEAD` has moved on, the resolution was
	# completed manually in the worktree – apply the result instead of
	# stranding it
	local GITDIR=$(git rev-parse --git-dir 2>/dev/null)
	if [ ! -d "$GITDIR/rebase-merge" ] && [ ! -d "$GITDIR/rebase-apply" ]; then
		if [ "$(git rev-parse HEAD)" = "$STATE_ORIG_HEAD" ]; then
			# Finished with nothing to apply (skipped-empty + fast-forwards)
			_CLEAR_STATE
			PRINT_TEXT "%s – branch unchanged." 33 "Rebase finished with nothing to apply"
			EMIT_STATUS "$STATE_ORIG_HEAD" "$STATE_BRANCH" false
			exit 0
		fi
		PRINT_TEXT "%s – applying its result." 33 "Rebase already completed in worktree"
	else
		_GUARD_RESOLUTION_CLEAN "$STATE_WORKTREE"
		local CMD="GIT_SEQUENCE_EDITOR=true GIT_EDITOR=true git -c rerere.enabled=true rebase --continue"
		PRINT_CMD "$CMD"
		if ! eval "$CMD" >/dev/null 2>&1 && \
		   ! { _AUTO_RESOLVE_FINAL_REORDER "$STATE_WORKTREE" "$STATE_ORIG_HEAD" && _FINISH_AUTO_RESOLVED_REORDER "$STATE_WORKTREE" }; then
			_CLEANUP_HOOK=""
			PRINT_ERR "Conflict continues – resolve more files, then 'git edit --continue'"
			PRINT_TEXT "Worktree: %s" 33 "$STATE_WORKTREE"
			local UNMERGED_LIST=$(_PRINT_CONFLICT_DETAIL "$STATE_WORKTREE" "$STATE_ORIG_HEAD")
			PRINT_TEXT "Or abort the operation: %s" 33 "git edit --abort"
			EMIT_CONFLICT "$STATE_WORKTREE" "$UNMERGED_LIST"
			exit 2
		fi
	fi

	local NEW_HEAD=$(git rev-parse HEAD)

	local UPDATE_CMD="git update-ref -m 'git edit: reorder around ${STATE_TARGET:0:7}' $STATE_BRANCH $NEW_HEAD $STATE_ORIG_HEAD"
	PRINT_CMD "$UPDATE_CMD" 90
	if ! eval "$UPDATE_CMD" 2>/dev/null; then
		_REFUSE_MOVED_BRANCH "$STATE_BRANCH" "$STATE_WORKTREE"
	fi
	_RECORD_REF_MOVE "$STATE_BRANCH" "$STATE_ORIG_HEAD" "$NEW_HEAD" "reorder around ${STATE_TARGET:0:7}"

	_PRINT_REORDER_SUMMARY "$STATE_ORIG_HEAD" "$NEW_HEAD"

	_CLEAR_STATE
	PRINT_COMPLETED "$NEW_HEAD" "$STATE_BRANCH" true
}

# Resumes a paused rebase-based mode, drop, squash or edit – same shape as
# `_CONTINUE_REORDER`, the rebase living in an isolated worktree with the branch moving
# only at the final CAS, so a pause costs nothing and can repeat
_CONTINUE_REBASE () {
	if [ ! -d "$STATE_WORKTREE" ]; then
		PRINT_ERR "Worktree no longer exists: $STATE_WORKTREE"
		_CLEAR_STATE
		exit 1
	fi

	cd "$STATE_WORKTREE" || exit 1

	_CLEANUP_HOOK="git worktree remove --force '$STATE_WORKTREE' 2>/dev/null; rm -rf '$STATE_WORKTREE'"

	PRINT_ACTION "Continuing $STATE_ACTION of %s..." "${STATE_TARGET:0:7}"

	# A resolution finished by hand in the worktree leaves no rebase in
	# progress – apply its result rather than stranding it
	local GITDIR=$(git rev-parse --git-dir 2>/dev/null)
	if [ ! -d "$GITDIR/rebase-merge" ] && [ ! -d "$GITDIR/rebase-apply" ]; then
		if [ "$(git rev-parse HEAD)" = "$STATE_ORIG_HEAD" ]; then
			_CLEAR_STATE
			PRINT_TEXT "%s – branch unchanged." 33 "Rebase finished with nothing to apply"
			EMIT_STATUS "$STATE_ORIG_HEAD" "$STATE_BRANCH" false
			exit 0
		fi
		PRINT_TEXT "%s – applying its result." 33 "Rebase already completed in worktree"
	else
		_GUARD_RESOLUTION_CLEAN "$STATE_WORKTREE"
		local CMD="GIT_SEQUENCE_EDITOR=true GIT_EDITOR=true git -c rerere.enabled=true rebase --continue"
		PRINT_CMD "$CMD"
		if ! eval "$CMD" >/dev/null 2>&1; then
			_CLEANUP_HOOK=""
			PRINT_ERR "Conflict continues – resolve more files, then 'git edit --continue'"
			PRINT_TEXT "Worktree: %s" 33 "$STATE_WORKTREE"
			local UNMERGED_LIST=$(_PRINT_CONFLICT_DETAIL "$STATE_WORKTREE")
			PRINT_TEXT "Or abort the operation: %s" 33 "git edit --abort"
			EMIT_CONFLICT "$STATE_WORKTREE" "$UNMERGED_LIST"
			exit 2
		fi
	fi

	local NEW_HEAD=$(git rev-parse HEAD)

	local UPDATE_CMD="git update-ref -m 'git edit: $STATE_ACTION ${STATE_TARGET:0:7}' $STATE_BRANCH $NEW_HEAD $STATE_ORIG_HEAD"
	PRINT_CMD "$UPDATE_CMD" 90
	if ! eval "$UPDATE_CMD" 2>/dev/null; then
		_REFUSE_MOVED_BRANCH "$STATE_BRANCH" "$STATE_WORKTREE"
	fi
	_RECORD_REF_MOVE "$STATE_BRANCH" "$STATE_ORIG_HEAD" "$NEW_HEAD" "$STATE_ACTION ${STATE_TARGET:0:7}"

	_CLEAR_STATE
	PRINT_COMPLETED "$NEW_HEAD" "$STATE_BRANCH" true
}

_ABORT_REBASE () {
	PRINT_ACTION "Aborting $STATE_ACTION of %s..." "${STATE_TARGET:0:7}"

	if [ -d "$STATE_WORKTREE" ]; then
		git -C "$STATE_WORKTREE" rebase --abort 2>/dev/null
		local CMD="git worktree remove --force '$STATE_WORKTREE' 2>/dev/null; rm -rf '$STATE_WORKTREE'"
		PRINT_CMD "$CMD" 90
		eval "$CMD"
	fi

	_CLEAR_STATE
	PRINT_TEXT "Branch was never touched – nothing to roll back." 32
	PRINT_TEXT "%s" 32 "Operation aborted, state cleared."
	EMIT_STATUS "$STATE_ORIG_HEAD" "$STATE_BRANCH" false
}

# Names what edit mode left stale – it authors in an isolated worktree, so an apply leaves
# checkout on the pre-edit content, its index holding that as a staged revert a later
# commit would carry – name the paths, since a blanket reset takes unrelated WIP
_PRINT_EDIT_RECONCILE_HINT () {
	# Args: <main checkout> <base> <new head>
	local MAIN=$1
	if [ -z "$MAIN" ] || [ ! -d "$MAIN" ]; then
		return 0
	fi
	local -a STALE
	local P
	while IFS= read -r P; do
		[ -z "$P" ] && continue
		if ! git -C "$MAIN" diff --quiet HEAD -- "$P" 2>/dev/null || \
		   ! git -C "$MAIN" diff --cached --quiet HEAD -- "$P" 2>/dev/null; then
			STALE+=("$P")
		fi
	done < <(git diff --name-only "$2" "$3" 2>/dev/null)
	if [ ${#STALE[@]} -eq 0 ]; then
		return 0
	fi
	PRINT_TEXT "Your checkout still holds the pre-edit content of:" 33
	printf '%s\n' "${STALE[@]}" | head -10 | sed "/./!d;s/^/${_DIM}  /;s/\$/${_OFF}/"
	if [ ${#STALE[@]} -gt 10 ]; then
		PRINT_TEXT "  … and %s more" 90 "$(( ${#STALE[@]} - 10 ))"
	fi
	PRINT_TEXT "Reconcile those paths (discards local edits to them): %s" 33 \
		"git restore --source=HEAD --staged --worktree -- ${(j: :)${(q-)STALE[@]}}"
}

# Replays the edited target's descendants onto the amended commit, from the branch's current
# tip – re-read here so commits that landed after the pause are carried, not dropped
# Exits 2 on conflict, returns on success with the worktree `HEAD` at the replayed tip
_EDIT_START_REPLAY () {
	local TIP=$(git rev-parse "$STATE_BRANCH")
	_SAVE_STATE "operation=edit" "worktree=$STATE_WORKTREE" "branch=$STATE_BRANCH" \
		"orig_head=$STATE_ORIG_HEAD" "target=$STATE_TARGET" "amended=$STATE_AMENDED" "replay_tip=$TIP" \
		"maindir=$STATE_MAINDIR"
	STATE_REPLAY_TIP=$TIP
	if [ "$TIP" = "$STATE_TARGET" ]; then
		# Target is the tip itself – the amended commit is the whole result
		git checkout -q "$STATE_AMENDED" 2>/dev/null
		return 0
	fi
	local CMD="GIT_SEQUENCE_EDITOR=true GIT_EDITOR=true git -c rerere.enabled=true rebase --onto $STATE_AMENDED $STATE_TARGET $TIP"
	PRINT_CMD "git rebase --onto ${STATE_AMENDED:0:7} ${STATE_TARGET:0:7} ${TIP:0:7}" 90
	if ! eval "$CMD" >/dev/null 2>&1; then
		_CLEANUP_HOOK=""
		PRINT_ERR "Conflict while replaying descendants – resolve in worktree, then 'git edit --continue'"
		PRINT_TEXT "Worktree: %s" 33 "$STATE_WORKTREE"
		local UNMERGED_LIST=$(_PRINT_CONFLICT_DETAIL "$STATE_WORKTREE")
		PRINT_TEXT "Or abort the operation: %s" 33 "git edit --abort"
		EMIT_CONFLICT "$STATE_WORKTREE" "$UNMERGED_LIST"
		exit 2
	fi
}

# Resumes a paused non-interactive edit – the phase is re-derived from the worktree itself,
# authoring with `HEAD` still at the target, replaying with a rebase in progress, or
# applying with the replay done, so a crash or an extra `--continue` lands right
_CONTINUE_EDIT () {
	if [ ! -d "$STATE_WORKTREE" ]; then
		PRINT_ERR "Worktree no longer exists: $STATE_WORKTREE"
		_CLEAR_STATE
		exit 1
	fi

	cd "$STATE_WORKTREE" || exit 1

	_CLEANUP_HOOK="git worktree remove --force '$STATE_WORKTREE' 2>/dev/null; rm -rf '$STATE_WORKTREE'"

	PRINT_ACTION "Continuing edit of %s..." "${STATE_TARGET:0:7}"

	local GITDIR=$(git rev-parse --git-dir 2>/dev/null)
	local HEAD_NOW=$(git rev-parse HEAD)

	if [ -d "$GITDIR/rebase-merge" ] || [ -d "$GITDIR/rebase-apply" ]; then
		# Mid-replay conflict
		_GUARD_RESOLUTION_CLEAN "$STATE_WORKTREE"
		local CMD="GIT_SEQUENCE_EDITOR=true GIT_EDITOR=true git -c rerere.enabled=true rebase --continue"
		PRINT_CMD "$CMD"
		if ! eval "$CMD" >/dev/null 2>&1; then
			_CLEANUP_HOOK=""
			PRINT_ERR "Conflict continues – resolve more files, then 'git edit --continue'"
			PRINT_TEXT "Worktree: %s" 33 "$STATE_WORKTREE"
			local UNMERGED_LIST=$(_PRINT_CONFLICT_DETAIL "$STATE_WORKTREE")
			PRINT_TEXT "Or abort the operation: %s" 33 "git edit --abort"
			EMIT_CONFLICT "$STATE_WORKTREE" "$UNMERGED_LIST"
			exit 2
		fi
	elif [ "$HEAD_NOW" = "$STATE_TARGET" ]; then
		# Authoring done – amend the target with whatever changed
		if [ -z "$(git status --porcelain)" ] && [ -z "$TEXT_VALUE" ]; then
			_CLEANUP_HOOK=""
			PRINT_ERR "Nothing to amend – no changes in the worktree and no --text"
			ECHO_E "\e[0;31m  Edit files in $STATE_WORKTREE (or pass --text \"…\"), then 'git edit --continue' – or 'git edit --abort'.\e[0m" >&2
			exit 1
		fi
		_UNLINK_WORKTREE_EXTRAS "$STATE_WORKTREE"
		_PRINT_UNTRACKED_ABSORB "$STATE_WORKTREE"
		git add -A >/dev/null 2>&1
		if [ -n "$TEXT_VALUE" ]; then
			git commit --amend -m "$TEXT_VALUE" >/dev/null 2>&1 || { _CLEANUP_HOOK=""; PRINT_ERR "Amend failed"; exit 1; }
		else
			git commit --amend --no-edit >/dev/null 2>&1 || { _CLEANUP_HOOK=""; PRINT_ERR "Amend failed"; exit 1; }
		fi
		STATE_AMENDED=$(git rev-parse HEAD)
		PRINT_CMD "git commit --amend -> ${STATE_AMENDED:0:7}" 90
		_EDIT_START_REPLAY
	elif [ -n "$STATE_AMENDED" ] && [ "$HEAD_NOW" = "$STATE_AMENDED" ]; then
		# Amend landed but the replay never ran (crash between) – run it now
		_EDIT_START_REPLAY
	fi
	# Otherwise `HEAD` is beyond the amended commit with no rebase in progress – the replay
	# finished, possibly by hand, so fall through to apply

	local NEW_HEAD=$(git rev-parse HEAD)
	local BASE=${STATE_REPLAY_TIP:-$STATE_ORIG_HEAD}
	# A commit that landed on the branch during the replay would be dropped by
	# a blind apply – redo the replay onto the fresh tip instead
	if [ "$(git rev-parse "$STATE_BRANCH")" != "$BASE" ]; then
		PRINT_TEXT "Branch moved during the edit – replaying onto its current tip." 33
		_EDIT_START_REPLAY
		NEW_HEAD=$(git rev-parse HEAD)
		BASE=$STATE_REPLAY_TIP
	fi

	local UPDATE_CMD="git update-ref -m 'git edit: edit ${STATE_TARGET:0:7}' $STATE_BRANCH $NEW_HEAD $BASE"
	PRINT_CMD "$UPDATE_CMD" 90
	if ! eval "$UPDATE_CMD" 2>/dev/null; then
		_CLEANUP_HOOK=""
		PRINT_ERR "Branch '$STATE_BRANCH' moved during apply – run 'git edit --continue' to replay onto the new tip"
		exit 1
	fi
	_RECORD_REF_MOVE "$STATE_BRANCH" "$BASE" "$NEW_HEAD" "edit ${STATE_TARGET:0:7}"

	# Net history change – pre-answers the "does the result differ by exactly
	# my edit?" verification the caller would otherwise run
	PRINT_TEXT "Net history change (%s -> %s):" 32 "${BASE:0:7}" "${NEW_HEAD:0:7}"
	git --no-pager diff --stat "$BASE" "$NEW_HEAD" 2>/dev/null | sed 's/^/  /'
	_PRINT_EDIT_RECONCILE_HINT "$STATE_MAINDIR" "$BASE" "$NEW_HEAD"

	_CLEAR_STATE
	PRINT_COMPLETED "$NEW_HEAD" "$STATE_BRANCH" true
}

_ABORT_EDIT () {
	PRINT_ACTION "Aborting edit of %s..." "${STATE_TARGET:0:7}"

	if [ -d "$STATE_WORKTREE" ]; then
		git -C "$STATE_WORKTREE" rebase --abort 2>/dev/null
		local CMD="git worktree remove --force '$STATE_WORKTREE' 2>/dev/null; rm -rf '$STATE_WORKTREE'"
		PRINT_CMD "$CMD" 90
		eval "$CMD"
	fi

	_CLEAR_STATE
	PRINT_TEXT "Branch was never touched – nothing to roll back." 32
	PRINT_TEXT "%s" 32 "Edit aborted, state cleared."
	EMIT_STATUS "$STATE_ORIG_HEAD" "$STATE_BRANCH" false
}

# Aborts an in-flight `--reorder` – abort the paused rebase and remove the worktree, with
# nothing to roll back since the branch was never moved
_ABORT_REORDER () {
	PRINT_ACTION "Aborting reorder around %s..." "${STATE_TARGET:0:7}"

	if [ -d "$STATE_WORKTREE" ]; then
		git -C "$STATE_WORKTREE" rebase --abort 2>/dev/null
		local CMD="git worktree remove --force '$STATE_WORKTREE' 2>/dev/null; rm -rf '$STATE_WORKTREE'"
		PRINT_CMD "$CMD" 90
		eval "$CMD"
	fi

	_CLEAR_STATE
	PRINT_TEXT "Branch was never touched – nothing to roll back." 32
	PRINT_TEXT "%s" 32 "Reorder aborted, state cleared."
	EMIT_STATUS "$STATE_ORIG_HEAD" "$STATE_BRANCH" false
}

# Names the state file for in-flight operations, currently `--amend-into` when an autosquash
# hits a conflict the caller must resolve – the file lives in the common git dir, shared
_STATE_FILE_PATH () {
	local DIR=$(git rev-parse --git-common-dir 2>/dev/null)
	[ -z "$DIR" ] && return 1
	case "$DIR" in
		/*) ;;
		*) DIR="$(pwd)/$DIR" ;;
	esac
	echo "$DIR/git-edit-state"
}

_SAVE_STATE () {
	# args: key=value pairs to persist (one per arg)
	local SF=$(_STATE_FILE_PATH) || { PRINT_ERR "Not in a git repo"; return 1; }
	local KV
	{
		for KV in "$@"; do echo "$KV"; done
	} > "$SF"
}

_LOAD_STATE () {
	local SF=$(_STATE_FILE_PATH)
	if [ -z "$SF" ] || [ ! -f "$SF" ]; then
		PRINT_ERR "No in-flight git-edit operation to continue or abort"
		exit 1
	fi
	STATE_OPERATION=""
	STATE_ACTION=""
	STATE_WORKTREE=""
	STATE_BRANCH=""
	STATE_ORIG_HEAD=""
	STATE_TARGET=""
	STATE_HEAD_WITH_FIXUP=""
	STATE_DEPTH=""
	STATE_REBASEBASE=""
	STATE_MAINDIR=""
	STATE_FILES=""
	STATE_PATHSPECS=""
	STATE_AMENDED=""
	STATE_REPLAY_TIP=""
	STATE_UPSTREAM=""
	STATE_SPAN=""
	STATE_FORK=""
	local KEY VAL
	while IFS='=' read -r KEY VAL; do
		case "$KEY" in
			operation)       STATE_OPERATION=$VAL ;;
			action)          STATE_ACTION=$VAL ;;
			worktree)        STATE_WORKTREE=$VAL ;;
			branch)          STATE_BRANCH=$VAL ;;
			orig_head)       STATE_ORIG_HEAD=$VAL ;;
			target)          STATE_TARGET=$VAL ;;
			head_with_fixup) STATE_HEAD_WITH_FIXUP=$VAL ;;
			depth)           STATE_DEPTH=$VAL ;;
			rebasebase)      STATE_REBASEBASE=$VAL ;;
			maindir)         STATE_MAINDIR=$VAL ;;
			files)           STATE_FILES=$VAL ;;
			pathspecs)       STATE_PATHSPECS=$VAL ;;
			amended)         STATE_AMENDED=$VAL ;;
			replay_tip)      STATE_REPLAY_TIP=$VAL ;;
			upstream)        STATE_UPSTREAM=$VAL ;;
			span)            STATE_SPAN=$VAL ;;
			fork)            STATE_FORK=$VAL ;;
		esac
	done < "$SF"
}

# Sidecar holding a paused split's --text, alongside the state file
_SPLIT_MSG_PATH () {
	local SF
	SF=$(_STATE_FILE_PATH) || return 1
	echo "$SF-msg"
}

_CLEAR_STATE () {
	local SF=$(_STATE_FILE_PATH)
	[ -n "$SF" ] && rm -f "$SF" "$SF-msg"
}

_STATE_EXISTS () {
	local SF=$(_STATE_FILE_PATH)
	[ -n "$SF" ] && [ -f "$SF" ]
}

# Refuses to resume while a staged file still carries conflict markers. The
# failure mode this catches: a resolver script dies silently (a shell variable
# that never reached it, say), a blanket `git add` in the same command stages
# the file markers and all, and `rebase --continue` accepts that as the
# resolution – baking `<<<<<<<` into history and advancing to the next step.
# Reads the staged blob rather than the working file, since that is what would
# be committed.
_GUARD_RESOLUTION_CLEAN () {
	local WT=$1
	local -a BAD
	local FILE
	while IFS= read -r FILE; do
		[ -z "$FILE" ] && continue
		if git -C "$WT" show ":$FILE" 2>/dev/null | grep -qE '^(<<<<<<<|=======|>>>>>>>)( |$)'; then
			BAD+=("$FILE")
		fi
	done < <(git -C "$WT" diff --cached --name-only 2>/dev/null)
	if [ ${#BAD[@]} -gt 0 ]; then
		_CLEANUP_HOOK=""
		PRINT_ERR "Staged resolution still contains conflict markers – refusing to continue"
		printf '%s\n' "${BAD[@]}" | sed "s/^/${_RED}  /;s/\$/${_OFF}/" >&2
		ECHO_E "\e[0;31m  Strip them in $WT, re-stage, then 'git edit --continue' – or 'git edit --abort'.\e[0m" >&2
		EMIT_CONFLICT "$WT" "${(j:,:)BAD}"
		exit 2
	fi
}

# `--continue`/`--abort` are often run from inside the operation's own
# worktree, where HEAD is a detached commit rather than the branch – so the
# trailer's "before" comes from the branch the operation will actually move,
# not from wherever the script happened to start. A no-op from the main
# checkout, where the two already agree.
_REANCHOR_INITIAL_HEAD () {
	local TIP
	TIP=$(git rev-parse "${STATE_BRANCH:-HEAD}" 2>/dev/null)
	[ -n "$TIP" ] && SCRIPT_INITIAL_HEAD=$TIP
}

# Resume an in-flight --amend-into after the user/agent has resolved the
# conflicts. The agent should have edited the files in $STATE_WORKTREE and
# staged them (e.g. `git -C <worktree> add <files>`) before calling this.
_CONTINUE_AMEND_INTO () {
	# The reword happens before the replay starts, so the commits being
	# resolved already carry the message – accepting one here would silently
	# do nothing
	if [ -n "$TEXT_VALUE" ]; then
		PRINT_ERR "--amend-into takes --text up front, not on --continue – the replay already carries the message"
		ECHO_E "\e[0;31m  Finish this fold, then reword: git edit -M --text=\"…\" <sha>\e[0m" >&2
		exit 1
	fi

	if [ ! -d "$STATE_WORKTREE" ]; then
		PRINT_ERR "Worktree no longer exists: $STATE_WORKTREE"
		_CLEAR_STATE
		exit 1
	fi

	cd "$STATE_WORKTREE" || exit 1

	# Once we successfully complete, the worktree should be cleaned up
	_CLEANUP_HOOK="git worktree remove --force '$STATE_WORKTREE' 2>/dev/null; rm -rf '$STATE_WORKTREE'"

	PRINT_ACTION "Continuing amend-into of %s..." "${STATE_TARGET:0:7}"

	# If no rebase is in progress but `HEAD` has moved on, the resolution was
	# completed manually (e.g. `git rebase --continue` run in the worktree
	# directly) – skip straight to applying the result instead of stranding it
	local GITDIR=$(git rev-parse --git-dir 2>/dev/null)
	if [ ! -d "$GITDIR/rebase-merge" ] && [ ! -d "$GITDIR/rebase-apply" ]; then
		if [ "$(git rev-parse HEAD)" = "$STATE_ORIG_HEAD" ]; then
			# Finished with nothing to apply – e.g. the fixup went empty, got
			# skipped, and every remaining pick fast-forwarded
			_CLEAR_STATE
			PRINT_TEXT "%s – branch unchanged." 33 "Rebase finished with nothing to apply"
			EMIT_STATUS "$STATE_ORIG_HEAD" "$STATE_BRANCH" false
			exit 0
		fi
		PRINT_TEXT "%s – applying its result." 33 "Rebase already completed in worktree"
	else
		_GUARD_RESOLUTION_CLEAN "$STATE_WORKTREE"
		local CMD="GIT_SEQUENCE_EDITOR=true GIT_EDITOR=true git -c rerere.enabled=true rebase --continue"
		PRINT_CMD "$CMD"
		if ! eval "$CMD" >/dev/null 2>&1; then
			# Another conflict downstream – keep state, keep worktree, exit
			_CLEANUP_HOOK=""
			PRINT_ERR "Conflict continues – resolve more files, then 'git edit --continue'"
			PRINT_TEXT "Worktree: %s" 33 "$STATE_WORKTREE"
			local UNMERGED_LIST=$(_PRINT_CONFLICT_DETAIL "$STATE_WORKTREE")
			PRINT_TEXT "Or abort the operation: %s" 33 "git edit --abort"
			EMIT_CONFLICT "$STATE_WORKTREE" "$UNMERGED_LIST"
			exit 2
		fi
	fi

	local NEW_HEAD=$(git rev-parse HEAD)

	# Atomic CAS-update of the branch ref. New-format states guard on the
	# pre-op tip (branch never moved); legacy states guard on the fixup tip.
	local GUARD=$STATE_ORIG_HEAD
	[ -n "$STATE_HEAD_WITH_FIXUP" ] && GUARD=$STATE_HEAD_WITH_FIXUP
	local UPDATE_CMD="git update-ref -m 'git edit: amend-into ${STATE_TARGET:0:7}' $STATE_BRANCH $NEW_HEAD $GUARD"
	PRINT_CMD "$UPDATE_CMD" 90
	if ! eval "$UPDATE_CMD" 2>/dev/null; then
		_REFUSE_MOVED_BRANCH "$STATE_BRANCH" "$STATE_WORKTREE"
	fi
	_RECORD_REF_MOVE "$STATE_BRANCH" "$GUARD" "$NEW_HEAD" "amend-into ${STATE_TARGET:0:7}"

	# Re-sync the folded paths' index entries to the new `HEAD`, those staged changes being
	# history now – path-scoped so a parallel session's staged work survives, and legacy
	# states without a file list fall back to a full reset
	if [ -n "$STATE_MAINDIR" ]; then
		if [ -n "$STATE_FILES" ]; then
			local -a SYNC_PATHS
			SYNC_PATHS=("${(@ps:\t:)STATE_FILES}")
			git -C "$STATE_MAINDIR" reset -q -- "${SYNC_PATHS[@]}" 2>/dev/null
		else
			git -C "$STATE_MAINDIR" read-tree --reset "$NEW_HEAD" 2>/dev/null
		fi
	fi

	# The fold's scope decides how the leftover index reads – restore it, or a
	# scoped fold that conflicted would report its intended leftovers as an anomaly
	[ -n "$STATE_PATHSPECS" ] && AMEND_PATHSPECS=("${(@ps:\t:)STATE_PATHSPECS}")
	[ -n "$STATE_DEPTH" ] && _PRINT_AMENDED_SUMMARY "$NEW_HEAD" "$STATE_DEPTH" "" "$STATE_MAINDIR" "$STATE_REBASEBASE"

	_CLEAR_STATE
	PRINT_COMPLETED "$NEW_HEAD" "$STATE_BRANCH" true
}

# Aborts an in-flight `--amend-into` – abort the paused rebase and remove the worktree, with
# nothing to roll back since the branch never moved and the staging was never consumed
# Legacy pre-invisible-fixup states carry a `head_with_fixup` tip and get the old rollback
_ABORT_AMEND_INTO () {
	PRINT_ACTION "Aborting amend-into of %s..." "${STATE_TARGET:0:7}"

	# Cleanup the worktree (which is in a paused rebase state)
	if [ -d "$STATE_WORKTREE" ]; then
		git -C "$STATE_WORKTREE" rebase --abort 2>/dev/null
		local CMD="git worktree remove --force '$STATE_WORKTREE' 2>/dev/null; rm -rf '$STATE_WORKTREE'"
		PRINT_CMD "$CMD" 90
		eval "$CMD"
	fi

	# Legacy-format state only: roll back the fixup commit on the branch, if
	# the ref is still where that old flow left it
	if [ -n "$STATE_HEAD_WITH_FIXUP" ]; then
		local CURRENT=$(git rev-parse "$STATE_BRANCH" 2>/dev/null)
		if [ "$CURRENT" = "$STATE_HEAD_WITH_FIXUP" ]; then
			local UPDATE_CMD="git update-ref -m 'git edit: abort amend-into' $STATE_BRANCH $STATE_ORIG_HEAD $STATE_HEAD_WITH_FIXUP"
			PRINT_CMD "$UPDATE_CMD" 90
			eval "$UPDATE_CMD" 2>/dev/null
			git read-tree "$STATE_HEAD_WITH_FIXUP" 2>/dev/null
		else
			PRINT_TEXT "%s – branch moved since fixup; leaving as-is to avoid clobbering other commits." 33 "Note"
		fi
	else
		PRINT_TEXT "Branch was never touched – your staged changes are still staged, ready to retry." 32
	fi

	_CLEAR_STATE
	PRINT_TEXT "%s" 32 "Amend-into aborted, state cleared."
	EMIT_STATUS "$STATE_ORIG_HEAD" "$STATE_BRANCH" false
}

# Detects non-interactive execution – an agent, CI or a scripted run – to gate the safety
# behaviors: auto-isolation, edit-mode bail, conflict bail and the editor-needs-TTY guard
# The signal is `! -t 0`, with `$CLAUDECODE` and `$CI` as backstops for a PTY-allocating agent
_IS_NON_INTERACTIVE () {
	if [ ! -t 0 ]; then return 0; fi
	if [ -n "$CLAUDECODE" ]; then return 0; fi
	if [ -n "$CI" ]; then return 0; fi
	return 1
}

# Resolves a usable editor command, matching git's own cascade – `GIT_EDITOR`, `core.editor`,
# `VISUAL`, `EDITOR`, then vi – skipping the `true` no-op that automation commonly sets,
# since the plumbing-mode operations that need typing would not work with it
_RESOLVE_EDITOR () {
	local CAND
	for CAND in "$GIT_EDITOR" "$(git config core.editor 2>/dev/null)" "$VISUAL" "$EDITOR"; do
		[ -z "$CAND" ] && continue
		[ "$CAND" = "true" ] && continue
		echo "$CAND"
		return
	done
	echo "vi"
}

# Bails out before opening an editor in a non-TTY context, where it would either no-op
# silently, hang waiting for input as vi or nano do, or open a GUI editor with `-w` and
# never return – call this right before any path that would open `$EDITOR`
_REQUIRE_TTY_FOR_EDITOR () {
	if ! _IS_NON_INTERACTIVE; then
		return 0
	fi
	# If the resolved editor is `true` (GIT_EDITOR=true), opening it is a
	# harmless no-op – let it through
	if [ "$(_RESOLVE_EDITOR)" = "true" ]; then
		return 0
	fi
	PRINT_ERR "Cannot open editor in non-interactive context (no TTY / agent run)"
	ECHO_E "\e[0;31m  Pass --text \"<msg>\" for an inline message, or --text - to read from stdin.\e[0m" >&2
	exit 1
}

# Opens the resolved editor on the given temp file and returns the cleaned-up contents,
# comments stripped and blank lines trimmed – stdout is the result, with user-facing
# output on stderr so it cannot leak into the captured value
_READ_MESSAGE_FROM_EDITOR () {
	local MSG_FILE=$1
	local EDIT_CMD=$(_RESOLVE_EDITOR)

	PRINT_CMD "$EDIT_CMD $MSG_FILE" >&2
	eval "$EDIT_CMD \"\$MSG_FILE\"" >&2 || return 1

	git stripspace --strip-comments < "$MSG_FILE"
}

# Rebuild each commit in `$1..HEAD` with every rewritten parent substituted,
# carrying an old->new map across the walk – a single PREV_OLD/PREV_NEW chain
# silently breaks on merge topologies, where the second leg's parent no longer
# matches by the time the walk reaches it. Commits with no rewritten parent
# (side legs that merge in without descending from the rewrite) are kept as-is
# rather than rebuilt. The final PREV_NEW is the new tip for update-ref;
# `--topo-order` guards the parents-before-children walk against clock skew.
_REBUILD_DESCENDANTS () {
	local FROM=$1
	local DESC P D_TREE D_MSG D_AN D_AE D_AD D_NEW D_TOUCHED
	local D_PARENTS_ARGS
	local -A REWRITTEN
	REWRITTEN[$(git rev-parse "$PREV_OLD")]=$PREV_NEW
	for DESC in $(git rev-list --reverse --topo-order "$FROM..HEAD"); do
		D_PARENTS_ARGS=()
		D_TOUCHED=false
		for P in $(git log -1 --format='%P' "$DESC"); do
			if [ -n "${REWRITTEN[$P]}" ]; then
				D_PARENTS_ARGS+=(-p "${REWRITTEN[$P]}")
				D_TOUCHED=true
			else
				D_PARENTS_ARGS+=(-p "$P")
			fi
		done
		if [ "$D_TOUCHED" = "false" ]; then
			continue
		fi

		D_TREE=$(git rev-parse "$DESC^{tree}")
		D_MSG=$(git log -1 --format='%B' "$DESC")
		D_AN=$(git log -1 --format='%an' "$DESC")
		D_AE=$(git log -1 --format='%ae' "$DESC")
		D_AD=$(git log -1 --format='%aI' "$DESC")

		D_NEW=$(
			GIT_AUTHOR_NAME="$D_AN" GIT_AUTHOR_EMAIL="$D_AE" GIT_AUTHOR_DATE="$D_AD" \
			git commit-tree "$D_TREE" "${D_PARENTS_ARGS[@]}" -m "$D_MSG"
		) || ABORT

		PRINT_CMD "git commit-tree ${D_TREE:0:7} ... -> ${D_NEW:0:7}  # rebuilt ${DESC:0:7}"

		REWRITTEN[$DESC]=$D_NEW
		PREV_OLD=$DESC
		PREV_NEW=$D_NEW
	done
}

# Rewords commit `$1` to message `$2` and rebuilds everything above it, leaving the
# rewritten commit in `$_REWORDED_TARGET` and the new tip in `$_REWORDED_TIP`, moving no
# ref – so `--amend-into` folds and rewords under one ref update rather than two
_REWORD_AND_REBUILD () {
	local AT=$1
	local MSG=$2
	local TREE=$(git rev-parse "$AT^{tree}")
	local PARENTS_ARGS=()
	local P
	for P in $(git log -1 --format='%P' "$AT"); do
		PARENTS_ARGS+=(-p "$P")
	done

	PREV_NEW=$(
		GIT_AUTHOR_NAME="$(git log -1 --format='%an' "$AT")" \
		GIT_AUTHOR_EMAIL="$(git log -1 --format='%ae' "$AT")" \
		GIT_AUTHOR_DATE="$(git log -1 --format='%aI' "$AT")" \
		git commit-tree "$TREE" "${PARENTS_ARGS[@]}" -m "$MSG"
	) || ABORT
	PRINT_CMD "git commit-tree ${TREE:0:7} ... -> ${PREV_NEW:0:7}  # reworded ${AT:0:7}"
	_REWORDED_TARGET=$PREV_NEW

	PREV_OLD=$AT
	_REBUILD_DESCENDANTS "$AT"
	_REWORDED_TIP=$PREV_NEW
}

# Rewrites just `$COMMIT`'s message and rebuilds any descendants on top, plumbing only –
# no checkout, no stash, no rebase, so the working tree is never touched, and atomic
# from the caller's view: a single ref update at the end, only if the branch has not moved
GIT_REWORD () {
	local TARGET=$COMMIT

	# Capture the ref to update (branch if attached, `HEAD` if detached)
	local ORIG_HEAD=$(git rev-parse HEAD)
	local BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null)
	local REF
	if [ -n "$BRANCH" ]; then
		REF="refs/heads/$BRANCH"
	else
		REF="HEAD"
	fi

	# Refuse if the target isn't reachable from `HEAD`
	if ! git merge-base --is-ancestor "$TARGET" HEAD 2>/dev/null; then
		PRINT_ERR "Commit ${TARGET:0:7} is not reachable from HEAD"
		exit 1
	fi

	_GUARD_UNPUSHED "$TARGET"

	local NEW_MSG
	if [ -n "$TEXT_VALUE" ]; then
		# --text supplied: use directly, no editor
		NEW_MSG="$TEXT_VALUE"
	else
		_REQUIRE_TTY_FOR_EDITOR
		# Open the caller's editor on a temp file seeded with the current message – named
		# `COMMIT_EDITMSG`, git's convention, inside a temp dir, so editors apply commit-message
		# syntax highlighting from the recognized filename
		local TMP_DIR=$(MKTEMP_DIR git-edit-reword)
		local MSG_FILE="$TMP_DIR/COMMIT_EDITMSG"
		git log -1 --format='%B' "$TARGET" > "$MSG_FILE"
		{
			echo ""
			echo "# Please enter the new commit message for ${TARGET:0:7}."
			echo "# Lines starting with '#' will be ignored."
			echo "# An empty message aborts the operation."
		} >> "$MSG_FILE"

		NEW_MSG=$(_READ_MESSAGE_FROM_EDITOR "$MSG_FILE")
		rm -rf "$TMP_DIR"

		if [ -z "$NEW_MSG" ]; then
			PRINT_ERR "Empty message – aborting"
			exit 1
		fi
	fi

	local ORIG_MSG=$(git log -1 --format='%B' "$TARGET" | git stripspace)
	if [ "$NEW_MSG" = "$ORIG_MSG" ]; then
		ECHO_E "${_PAD}\e[0;33mMessage unchanged – nothing to do.\e[0m"
		EMIT_STATUS "$ORIG_HEAD" "$REF" false
		exit 0
	fi

	# Build the new target commit: same tree + parents + author, new message
	local TREE=$(git rev-parse "$TARGET^{tree}")
	local PARENTS_ARGS=()
	local P
	for P in $(git log -1 --format='%P' "$TARGET"); do
		PARENTS_ARGS+=(-p "$P")
	done

	local AN=$(git log -1 --format='%an' "$TARGET")
	local AE=$(git log -1 --format='%ae' "$TARGET")
	local AD=$(git log -1 --format='%aI' "$TARGET")

	local NEW_TARGET=$(
		GIT_AUTHOR_NAME="$AN" GIT_AUTHOR_EMAIL="$AE" GIT_AUTHOR_DATE="$AD" \
		git commit-tree "$TREE" "${PARENTS_ARGS[@]}" -m "$NEW_MSG"
	) || ABORT

	PRINT_CMD "git commit-tree ${TREE:0:7} ... -> ${NEW_TARGET:0:7}"

	# Walk every descendant of $TARGET up to HEAD, rebuild with new parent
	PREV_OLD=$TARGET
	PREV_NEW=$NEW_TARGET
	_REBUILD_DESCENDANTS "$TARGET"

	# Atomic compare-and-swap on the ref. If the branch moved (e.g., a
	# concurrent commit from Claude Code or another tool), refuse.
	local CMD="git update-ref -m 'git edit: reword ${TARGET:0:7}' $REF $PREV_NEW $ORIG_HEAD"
	PRINT_CMD "$CMD"
	if ! eval "$CMD" 2>/dev/null; then
		PRINT_ERR "Ref '$REF' moved during reword – refusing to overwrite"
		PRINT_TEXT "Reworded history is at %s (not applied)." 33 "$PREV_NEW"
		exit 1
	fi
	_RECORD_REF_MOVE "$REF" "$ORIG_HEAD" "$PREV_NEW" "reword ${TARGET:0:7}"
	# Plumbing rebuilds reuse every commit's tree object verbatim, so this
	# holds by construction – stated so callers don't re-verify with a diff
	PRINT_TEXT "%s – only messages were rewritten." 32 "Trees unchanged by construction ✓"
	# The message is the entire point of the mode, so show the one that landed –
	# otherwise the caller reads it back with `git log` to be sure it took
	# `$NEW_TARGET` is the rebuilt commit itself, captured when it was created.
	# Deriving it by offset instead walks first parents, so a merge in the span
	# – whose commit count includes the side branch – named the wrong commit.
	if [ -n "$NEW_TARGET" ]; then
		git log -1 --format='  %h %s' "$NEW_TARGET" | sed "/./!d;s/^/${_DIM}/;s/\$/${_OFF}/"
		local BODY_LINES=$(git log -1 --format='%b' "$NEW_TARGET" | grep -c .)
		if [ "$BODY_LINES" -gt 0 ]; then
			git log -1 --format='%b' "$NEW_TARGET" | grep . | sed "s/^/${_DIM}    /;s/\$/${_OFF}/"
		fi
		# Name the subject that was replaced. A symbolic target resolves once,
		# at invocation, so a commit landing between the caller's read and this
		# call is silently reworded instead – and the CAS cannot catch it, since
		# that guard covers the ref moving mid-run, not the wrong commit being
		# named. Showing the old subject puts the mistake in the output a caller
		# actually reads back, rather than only in the line that scrolled past.
		local OLD_SUBJECT=$(git log -1 --format='%s' "$TARGET" 2>/dev/null)
		if [ -n "$OLD_SUBJECT" ]; then
			PRINT_TEXT "  replaced: %s" 90 "$OLD_SUBJECT"
		fi
	fi
}

# Squash a contiguous range of commits into one via plumbing only. Like
# GIT_REWORD: no checkout, no stash, no rebase, single atomic ref update.
# Refuses non-contiguous selections and ranges containing merge commits
# (those need real 3-way merges, which can conflict — use -s with -C).
GIT_RESQUASH () {
	local OLDEST=${COMMITS[1]}
	local NEWEST=${COMMITS[-1]}

	# Capture the ref to update
	local ORIG_HEAD=$(git rev-parse HEAD)
	local BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null)
	local REF
	if [ -n "$BRANCH" ]; then
		REF="refs/heads/$BRANCH"
	else
		REF="HEAD"
	fi

	# Refuse if either endpoint isn't reachable from `HEAD`
	if ! git merge-base --is-ancestor "$NEWEST" HEAD 2>/dev/null; then
		PRINT_ERR "Commit ${NEWEST:0:7} is not reachable from HEAD"
		exit 1
	fi

	_GUARD_UNPUSHED "$OLDEST"

	# Verify contiguity: rev-list of the inclusive `OLDEST..NEWEST` range must
	# match the selected commits exactly (same count, same order)
	local EXPECTED
	if git rev-parse --verify "$OLDEST^" >/dev/null 2>&1; then
		EXPECTED=($(git rev-list --reverse "$OLDEST^..$NEWEST"))
	else
		# `OLDEST` is the root commit – range is just everything up to `NEWEST`
		EXPECTED=($(git rev-list --reverse "$NEWEST"))
	fi

	if [ ${#EXPECTED[@]} -ne ${#COMMITS[@]} ]; then
		PRINT_ERR "-S/--resquash requires contiguous commits"
		ECHO_E "\e[0;31m  Selected ${#COMMITS[@]}; range ${OLDEST:0:7}..${NEWEST:0:7} contains ${#EXPECTED[@]}.\e[0m" >&2
		ECHO_E "\e[0;31m  For non-contiguous squashes, use -s (combine with -C for safety).\e[0m" >&2
		exit 1
	fi
	local i
	for (( i=1; i<=${#COMMITS[@]}; i++ )); do
		if [ "${COMMITS[$i]}" != "${EXPECTED[$i]}" ]; then
			PRINT_ERR "-S/--resquash requires contiguous commits in order"
			exit 1
		fi
	done

	# Refuse merge commits in the range (they'd need a real 3-way merge)
	local C P_LIST
	for C in "${COMMITS[@]}"; do
		P_LIST=$(git log -1 --format='%P' "$C")
		if [[ "$P_LIST" == *" "* ]]; then
			PRINT_ERR "-S/--resquash cannot handle merge commit ${C:0:7}"
			ECHO_E "\e[0;31m  Use -s (combine with -C for safety) instead.\e[0m" >&2
			exit 1
		fi
	done

	# Determine new parent (parent of `OLDEST`, or none for root)
	local NEW_PARENT_ARGS=()
	if git rev-parse --verify "$OLDEST^" >/dev/null 2>&1; then
		NEW_PARENT_ARGS=(-p "$(git rev-parse "$OLDEST^")")
	fi

	# Build the squashed commit's message
	local NEW_MSG
	if [ -n "$TEXT_VALUE" ]; then
		# --text supplied: use directly (auto-implies -m semantics)
		NEW_MSG="$TEXT_VALUE"
	elif [ ${#OPT_MESSAGE} -gt 0 ]; then
		_REQUIRE_TTY_FOR_EDITOR
		# With -m: combine all messages and open editor for review
		# File is named `COMMIT_EDITMSG` so editors apply commit-message syntax
		local TMP_DIR=$(MKTEMP_DIR git-edit-resquash)
		local MSG_FILE="$TMP_DIR/COMMIT_EDITMSG"
		{
			echo "# Combined message from ${#COMMITS[@]} squashed commits."
			echo "# Edit as desired. Lines starting with '#' will be ignored."
			echo "# An empty message aborts the operation."
			echo ""
			local FIRST=1
			for C in "${COMMITS[@]}"; do
				if [ $FIRST -eq 0 ]; then echo ""; fi
				FIRST=0
				git log -1 --format='%B' "$C"
			done
		} > "$MSG_FILE"

		NEW_MSG=$(_READ_MESSAGE_FROM_EDITOR "$MSG_FILE")
		rm -rf "$TMP_DIR"

		if [ -z "$NEW_MSG" ]; then
			PRINT_ERR "Empty message – aborting"
			exit 1
		fi
	else
		# Fixup style: keep `OLDEST`'s message, drop the rest
		NEW_MSG=$(git log -1 --format='%B' "$OLDEST" | git stripspace)
	fi

	# Build the new squashed commit (newest tree + `OLDEST`'s author + new parent + message)
	local NEW_TREE=$(git rev-parse "$NEWEST^{tree}")
	local AN=$(git log -1 --format='%an' "$OLDEST")
	local AE=$(git log -1 --format='%ae' "$OLDEST")
	local AD=$(git log -1 --format='%aI' "$OLDEST")

	local NEW_SQUASHED=$(
		GIT_AUTHOR_NAME="$AN" GIT_AUTHOR_EMAIL="$AE" GIT_AUTHOR_DATE="$AD" \
		git commit-tree "$NEW_TREE" "${NEW_PARENT_ARGS[@]}" -m "$NEW_MSG"
	) || ABORT

	PRINT_CMD "git commit-tree ${NEW_TREE:0:7} ${NEW_PARENT_ARGS[*]} -> ${NEW_SQUASHED:0:7}  # squashed ${#COMMITS[@]} commits"

	# Rebuild any descendants of NEWEST up to HEAD with the new squashed commit as their parent
	PREV_OLD=$NEWEST
	PREV_NEW=$NEW_SQUASHED
	_REBUILD_DESCENDANTS "$NEWEST"

	# Atomic ref update
	local CMD="git update-ref -m 'git edit: squash ${#COMMITS[@]} into ${OLDEST:0:7}' $REF $PREV_NEW $ORIG_HEAD"
	PRINT_CMD "$CMD"
	if ! eval "$CMD" 2>/dev/null; then
		PRINT_ERR "Ref '$REF' moved during resquash – refusing to overwrite"
		PRINT_TEXT "Resquashed history is at %s (not applied)." 33 "$PREV_NEW"
		exit 1
	fi
	_RECORD_REF_MOVE "$REF" "$ORIG_HEAD" "$PREV_NEW" "squash ${#COMMITS[@]} into ${OLDEST:0:7}"
	# The squashed commit takes the newest member's tree and descendants keep
	# theirs, so the tip tree is identical by construction – stated so callers
	# don't re-verify with a diff
	PRINT_TEXT "%s – squashed commit:" 32 "Tip tree unchanged by construction ✓"
	git show --stat --format='  %h %s' "$NEW_SQUASHED" | head -12 | sed "/./!d;s/^/${_DIM}/;s/\$/${_OFF}/"
}

GIT_COMMIT_AMEND () {
	if [ ${#OPT_MESSAGE} -gt 0 ]; then
		local CMD="git commit --all --amend"
	else
		local CMD="git commit --all --amend --no-edit"
	fi
	PRINT_CMD "$CMD"

	eval "$CMD" || ABORT
}

GIT_REBASE_CONTINUE () {
	# First arg is the rebase sub-command, defaulting to "--continue"
	local SUBCMD="${1:---continue}"

	local CMD="git -c rerere.enabled=true rebase $SUBCMD"
	PRINT_CMD "$CMD"

	# Only use the interactive editor if we are in "squash" mode AND `-m` was passed
	if [[ "$ACTION" == "squash" && -n "$OPT_MESSAGE" ]]; then
		GIT_RUN_AND_HANDLE_CONFLICTS "$CMD"
	else
		GIT_EDITOR=true \
		GIT_RUN_AND_HANDLE_CONFLICTS "$CMD"
	fi
}

GIT_REBASE_ABORT () {
	local GITDIR=$(git rev-parse --git-dir 2>/dev/null)
	if [[ -n "$GITDIR" && ( -d "$GITDIR/rebase-merge" || -d "$GITDIR/rebase-apply" ) ]]; then
		local CMD="git rebase --abort"
		PRINT_CMD "$CMD"

		eval "$CMD" 2>/dev/null
	fi
}

# Launches the detected GUI editor on `$WORKTREE_DIR` in the background, so the script keeps
# waiting at the prompt, and no-ops where none was detected – used for auto-open at
# interactive pauses and for the Space re-open key
_OPEN_WORKTREE_IN_EDITOR () {
	[ -z "$OPEN_EDITOR_CMD" ] && return 0
	eval "$OPEN_EDITOR_CMD \"\$WORKTREE_DIR\" >/dev/null 2>&1 &"
	disown 2>/dev/null
}

CONTINUE_OR_ABORT () {
	# Optional first arg "open" lets Space launch the configured GUI editor on `$WORKTREE_DIR`
	# Optional second arg "skip" honors `-y`, safe only at "press Enter to confirm" prompts
	# where Enter means proceed as planned, never at one needing real intervention
	local ALLOW_OPEN=$1
	local SKIPPABLE=$2

	if [[ "$SKIPPABLE" == "skip" && ${#OPT_YES} -gt 0 ]]; then
		ECHO_E "\e[0;90m(-y / --yes: auto-confirmed)\e[0m"
		return 0
	fi

	# Temporarily trap termination signals while awaiting user input
	trap "ABORT" INT TERM QUIT HUP

	while true; do
		IFS= read -rs -k1 KEY
		case $KEY in
			''|$'\r'|$'\n')         break ;;
			$'\e'|$'\003'|$'\004')  ABORT ;; # Escape, Ctrl+C, or Ctrl+D
			' ')
				if [[ -n "$ALLOW_OPEN" && -n "$OPEN_EDITOR_CMD" ]]; then
					_OPEN_WORKTREE_IN_EDITOR
				else
					echo "Unknown key, try again."
				fi
				;;
			*)                      echo "Unknown key, try again." ;;
		esac
	done

	# Disable the trap to prevent interference with Git processes or text editors
	trap - INT TERM QUIT HUP
}

ABORT () {
	# Unregister traps immediately to prevent recursive execution on repeated signals
	trap - INT TERM QUIT HUP

	GIT_REBASE_ABORT

	GIT_UNSTASH

	# Print "Aborted." directly (not via PRINT_ERR) so we don't overwrite
	# _LAST_ERROR — the trailer should show the actual error reason that
	# triggered the abort, not the generic "Aborted." follow-up.
	ECHO_E "\n\e[1;91mAborted.\e[0m" >&2
	exit 1
}


# Built-in end-to-end test suite: builds a scratch repo (with a fake pushed
# remote) in a temp dir and exercises every mode through real sub-invocations
# of this same script – reword, fold, conflict/abort/continue, drop, squash,
# reorder, exec, the pushed guard, undo, and status. Asserts outcomes and
# prints PASS/FAIL per scenario. Run after any change to this script.
GIT_SELFTEST () {
	local SELF=$1
	local TMP=$(MKTEMP_DIR git-edit-selftest)
	_CLEANUP_HOOK="rm -rf '$TMP'"
	local PASS=0
	local FAIL=0
	local OUT RC

	# Sub-invocations run non-TTY (stdin </dev/null) for deterministic agent
	# behavior even when the selftest itself runs from a terminal
	_ST_RUN () {
		OUT=$(GIT_EDIT_NO_AUTO_OPEN=1 "$SELF" "$@" </dev/null 2>&1)
		RC=$?
		# A prose line that lost its `#` is still a valid command invocation, so
		# `zsh -n` accepts it and only the runtime complains. Checking here makes
		# every scenario a detector for that whole class of slip, rather than
		# relying on one test to happen to walk the affected line.
		if [[ "$OUT" == *"command not found"* || "$OUT" == *"no matches found"* || \
		      "$OUT" == *"bad substitution"* || "$OUT" == *"parse error"* ]]; then
			FAIL=$((FAIL+1))
			ECHO_E "  \e[1;31mFAIL\e[0m shell noise from 'git edit $*'"
			echo "$OUT" | grep -E 'command not found|no matches found|bad substitution|parse error' \
				| head -3 | sed 's/^/       | /'
		fi
	}
	_ST_CHECK () {
		local DESC=$1; shift
		if "$@" >/dev/null 2>&1; then
			PASS=$((PASS+1)); ECHO_E "  \e[0;32mPASS\e[0m $DESC"
		else
			FAIL=$((FAIL+1)); ECHO_E "  \e[1;31mFAIL\e[0m $DESC"
			echo "$OUT" | tail -5 | sed 's/^/       | /'
		fi
	}
	_ST_OUT_HAS () {
		local DESC=$1
		local PATTERN=$2
		if echo "$OUT" | grep -q "$PATTERN"; then
			PASS=$((PASS+1)); ECHO_E "  \e[0;32mPASS\e[0m $DESC"
		else
			FAIL=$((FAIL+1)); ECHO_E "  \e[1;31mFAIL\e[0m $DESC"
			echo "$OUT" | tail -5 | sed 's/^/       | /'
		fi
	}
	_ST_OUT_LACKS () {
		local DESC=$1
		local PATTERN=$2
		if echo "$OUT" | grep -q "$PATTERN"; then
			FAIL=$((FAIL+1)); ECHO_E "  \e[1;31mFAIL\e[0m $DESC"
			echo "$OUT" | grep "$PATTERN" | head -3 | sed 's/^/       | /'
		else
			PASS=$((PASS+1)); ECHO_E "  \e[0;32mPASS\e[0m $DESC"
		fi
	}
	_ST_EQ () {
		local DESC=$1
		if [ "$2" = "$3" ]; then
			PASS=$((PASS+1)); ECHO_E "  \e[0;32mPASS\e[0m $DESC"
		else
			FAIL=$((FAIL+1)); ECHO_E "  \e[1;31mFAIL\e[0m $DESC ('$2' != '$3')"
		fi
	}

	PRINT_TEXT "Selftest scratch repo: %s" 36 "$TMP"
	unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

	# --- Scratch repo: A, B pushed to a bare origin; C, D, E unpushed ---
	git init -q -b main "$TMP/repo" || { PRINT_ERR "Cannot init scratch repo"; exit 1; }
	cd "$TMP/repo" || exit 1
	git config user.email "selftest@git-edit"
	git config user.name "git-edit selftest"
	git config commit.gpgsign false
	echo "alpha" > a.txt && git add a.txt && git commit -qm "A commit"
	echo "beta"  > b.txt && git add b.txt && git commit -qm "B commit"
	git init -q --bare "$TMP/origin.git"
	git remote add origin "$TMP/origin.git"
	git push -q -u origin main 2>/dev/null
	echo "line1" > c.txt && git add c.txt && git commit -qm "C commit"
	echo "line2" > c.txt && git add c.txt && git commit -qm "D commit"
	echo "epsilon" > e.txt && git add e.txt && git commit -qm "E commit"
	local SHA_A=$(git rev-parse HEAD~4)
	local SHA_B=$(git rev-parse HEAD~3)
	local SHA_C=$(git rev-parse HEAD~2)

	# --- 1. Reword (-M --text): plumbing, tree-identical, trailer ---
	ECHO_E "\e[1;96m[1] reword (-M --text)\e[0m"
	local PRE_HEAD=$(git rev-parse HEAD)
	local PRE_TREE=$(git rev-parse 'HEAD^{tree}')
	_ST_RUN -M --text="C reworded" "$SHA_C"
	_ST_EQ "exits 0" "$RC" "0"
	_ST_OUT_HAS "emits ok trailer" '^git-edit: ok — refs/heads/main moved'
	_ST_OUT_HAS "states tree identity" 'Trees unchanged by construction'
	_ST_OUT_HAS "echoes the resulting subject" '[0-9a-f]\{7\} C reworded'
	# A symbolic target resolves once, so the summary has to name what it
	# replaced – otherwise rewording the wrong commit reads as success
	_ST_OUT_HAS "names the subject it replaced" 'replaced:.*C commit'
	_ST_CHECK "HEAD moved" test "$(git rev-parse HEAD)" != "$PRE_HEAD"
	_ST_EQ "tip tree identical" "$(git rev-parse 'HEAD^{tree}')" "$PRE_TREE"
	_ST_EQ "message applied" "$(git log --format=%s -3 | tail -1)" "C reworded"

	# --- 2. Undo: reverts the reword, CAS-guarded ---
	ECHO_E "\e[1;96m[2] undo\e[0m"
	_ST_RUN --undo
	_ST_EQ "exits 0" "$RC" "0"
	_ST_EQ "HEAD restored" "$(git rev-parse HEAD)" "$PRE_HEAD"

	# --- 3. Pushed guard: refuse B, allow with --allow-pushed ---
	ECHO_E "\e[1;96m[3] pushed guard\e[0m"
	_ST_RUN -M --text="B reworded" "$SHA_B"
	_ST_CHECK "refuses pushed commit" test "$RC" != "0"
	_ST_OUT_HAS "names the reason" 'already pushed'
	_ST_RUN --allow-pushed -M --text="B reworded" "$SHA_B"
	_ST_EQ "--allow-pushed overrides" "$RC" "0"
	_ST_RUN --undo
	_ST_EQ "undo restores" "$(git rev-parse HEAD)" "$PRE_HEAD"

	# --- 4. Fold (--amend-into) clean: a.txt change into C ---
	ECHO_E "\e[1;96m[4] amend-into (clean)\e[0m"
	echo "alpha folded" > a.txt
	git add a.txt
	_ST_RUN --amend-into="$SHA_C"
	_ST_EQ "exits 0" "$RC" "0"
	_ST_OUT_HAS "emits ok trailer" '^git-edit: ok — refs/heads/main moved'
	_ST_OUT_HAS "prints folded summary" 'Folded'
	_ST_OUT_HAS "reports the leftover checkout state" 'Index now empty'
	_ST_EQ "change landed in C" "$(git show 'HEAD~2:a.txt')" "alpha folded"
	_ST_CHECK "index clean afterwards" git diff --cached --quiet
	_ST_CHECK "no fixup commit on branch" test -z "$(git log --format=%s | grep '^fixup!')"

	# --- 5. Fold conflict -> status -> abort: branch + staged intact ---
	ECHO_E "\e[1;96m[5] amend-into conflict + abort\e[0m"
	PRE_HEAD=$(git rev-parse HEAD)
	local SHA_C2=$(git rev-parse HEAD~2)
	echo "line1-conflict" > c.txt
	git add c.txt
	_ST_RUN --amend-into="$SHA_C2"
	_ST_EQ "pauses with exit 2" "$RC" "2"
	_ST_OUT_HAS "emits conflict trailer" '^git-edit: conflict — resolve in'
	_ST_EQ "branch untouched during pause" "$(git rev-parse HEAD)" "$PRE_HEAD"
	_ST_RUN --status
	_ST_OUT_HAS "status reports the conflict" '^git-edit: conflict — resolve in'
	_ST_RUN --abort
	_ST_EQ "abort exits 0" "$RC" "0"
	_ST_EQ "branch still untouched" "$(git rev-parse HEAD)" "$PRE_HEAD"
	_ST_CHECK "staged change preserved" sh -c "git diff --cached --name-only | grep -q c.txt"

	# --- 6. Fold conflict -> resolve -> continue (with cascade) ---
	ECHO_E "\e[1;96m[6] amend-into conflict + continue\e[0m"
	_ST_RUN --amend-into="$SHA_C2"
	_ST_EQ "pauses with exit 2" "$RC" "2"
	local ROUNDS=0
	while [ "$RC" = "2" ] && [ $ROUNDS -lt 4 ]; do
		ROUNDS=$((ROUNDS+1))
		local CONFLICT_WT=$(echo "$OUT" | sed -n 's/^git-edit: conflict — resolve in \([^ ]*\).*/\1/p' | head -1)
		if [ -z "$CONFLICT_WT" ] || [ ! -d "$CONFLICT_WT" ]; then
			break
		fi
		if [ $ROUNDS -eq 1 ]; then
			echo "line1-resolved" > "$CONFLICT_WT/c.txt"
		else
			echo "line2" > "$CONFLICT_WT/c.txt"
		fi
		git -C "$CONFLICT_WT" add c.txt
		_ST_RUN --continue
	done
	_ST_EQ "continue completes" "$RC" "0"
	_ST_OUT_HAS "emits ok trailer" '^git-edit: ok — refs/heads/main moved'
	_ST_EQ "resolution in C" "$(git show 'HEAD~2:c.txt')" "line1-resolved"
	_ST_EQ "tip keeps D's content" "$(git show 'HEAD:c.txt')" "line2"
	_ST_CHECK "index clean afterwards" git diff --cached --quiet
	_ST_CHECK "state cleared" test ! -f "$(git rev-parse --git-common-dir)/git-edit-state"

	# --- 6b. Conflict resolved manually in the worktree, staged WIP survives ---
	ECHO_E "\e[1;96m[6b] manual worktree completion + parallel staged WIP\e[0m"
	PRE_HEAD=$(git rev-parse HEAD)
	local SHA_C3=$(git rev-parse HEAD~2)
	echo "line1-again" > c.txt
	git add c.txt
	_ST_RUN --amend-into="$SHA_C3"
	_ST_EQ "pauses with exit 2" "$RC" "2"
	# A parallel session stages an unrelated file mid-pause
	echo "parallel" > w.txt
	git add w.txt
	# The agent resolves and drives the rebase manually inside the worktree
	local MANUAL_WT=$(echo "$OUT" | sed -n 's/^git-edit: conflict — resolve in \([^ ]*\).*/\1/p' | head -1)
	echo "line1-again" > "$MANUAL_WT/c.txt"
	git -C "$MANUAL_WT" add c.txt
	local MROUNDS=0
	while [ $MROUNDS -lt 4 ]; do
		MROUNDS=$((MROUNDS+1))
		GIT_EDIT_NO_AUTO_OPEN=1 git -C "$MANUAL_WT" -c core.editor=true rebase --continue >/dev/null 2>&1 && break
		echo "line2" > "$MANUAL_WT/c.txt"
		git -C "$MANUAL_WT" add c.txt
	done
	_ST_RUN --continue
	_ST_EQ "continue applies the manual result" "$RC" "0"
	_ST_OUT_HAS "notes manual completion" 'already completed'
	_ST_CHECK "HEAD moved" test "$(git rev-parse HEAD)" != "$PRE_HEAD"
	_ST_CHECK "parallel staged WIP survived" sh -c "git diff --cached --name-only | grep -q w.txt"
	_ST_CHECK "folded path reports clean" sh -c "! git diff --cached --name-only | grep -q c.txt"
	git reset -q -- w.txt && rm -f w.txt

	# --- 6c. Standalone commands refuse stray arguments ---
	ECHO_E "\e[1;96m[6c] stray-argument refusal\e[0m"
	_ST_RUN --undo "$(git rev-parse HEAD)"
	_ST_CHECK "refuses" test "$RC" != "0"
	_ST_OUT_HAS "names the reason" 'take no arguments'

	# --- 7. Drop (auto-isolated, non-TTY) ---
	ECHO_E "\e[1;96m[7] drop\e[0m"
	_ST_RUN -d "$(git rev-parse HEAD)"
	_ST_EQ "exits 0" "$RC" "0"
	_ST_CHECK "dropped commit's file gone" sh -c "! git cat-file -e 'HEAD:e.txt'"

	# --- 8. Squash (implicit, plumbing route) ---
	ECHO_E "\e[1;96m[8] squash (plumbing)\e[0m"
	PRE_TREE=$(git rev-parse 'HEAD^{tree}')
	local PRE_COUNT=$(git rev-list --count HEAD)
	_ST_RUN --text="C and D combined" "$(git rev-parse HEAD~1)" "$(git rev-parse HEAD)"
	_ST_EQ "exits 0" "$RC" "0"
	_ST_OUT_HAS "states tree identity" 'Tip tree unchanged by construction'
	_ST_EQ "one commit fewer" "$(git rev-list --count HEAD)" "$((PRE_COUNT-1))"
	_ST_EQ "tip tree identical" "$(git rev-parse 'HEAD^{tree}')" "$PRE_TREE"
	_ST_EQ "combined message" "$(git log --format=%s -1)" "C and D combined"

	# --- 9. Reorder: swap two independent tip commits ---
	ECHO_E "\e[1;96m[9] reorder\e[0m"
	echo "ex" > x.txt && git add x.txt && git commit -qm "X commit"
	echo "why" > y.txt && git add y.txt && git commit -qm "Y commit"
	PRE_TREE=$(git rev-parse 'HEAD^{tree}')
	_ST_RUN --reorder "$(git rev-parse HEAD)" "$(git rev-parse HEAD~1)"
	_ST_EQ "exits 0" "$RC" "0"
	_ST_OUT_HAS "states tree identity" 'Tip tree identical'
	_ST_OUT_HAS "lists the new order oldest-first" 'new order (oldest-first)'
	_ST_EQ "order swapped" "$(git log --format=%s -2 | tr '\n' ' ')" "X commit Y commit "
	_ST_EQ "tip tree identical" "$(git rev-parse 'HEAD^{tree}')" "$PRE_TREE"

	# --- 10. Edit mode pauses in non-TTY instead of prompting ---
	ECHO_E "\e[1;96m[10] edit-mode non-TTY pause\e[0m"
	_ST_RUN "$(git rev-parse HEAD)"
	_ST_EQ "pauses (exit 2)" "$RC" "2"
	_ST_OUT_HAS "paused trailer names the worktree" 'git-edit: paused'
	_ST_RUN --abort
	_ST_EQ "abort clears it" "$RC" "0"

	# --- 11. Exec: amend via isolated worktree ---
	ECHO_E "\e[1;96m[11] exec\e[0m"
	_ST_RUN --exec -- git commit --amend -m "amended via exec"
	_ST_EQ "exits 0" "$RC" "0"
	_ST_EQ "amend applied" "$(git log --format=%s -1)" "amended via exec"

	# --- 12. Exec pushed-orphan guard ---
	ECHO_E "\e[1;96m[12] exec pushed-orphan guard\e[0m"
	PRE_HEAD=$(git rev-parse HEAD)
	_ST_RUN --exec -- git reset --hard "$SHA_A"
	_ST_CHECK "refuses" test "$RC" != "0"
	_ST_OUT_HAS "names the reason" 'pushed history'
	_ST_EQ "branch unchanged" "$(git rev-parse HEAD)" "$PRE_HEAD"

	# --- 13. Undo refuses after the branch moved on ---
	ECHO_E "\e[1;96m[13] undo CAS guard\e[0m"
	echo "zeta" > z.txt && git add z.txt && git commit -qm "Z commit"
	_ST_RUN --undo
	_ST_CHECK "refuses" test "$RC" != "0"
	_ST_OUT_HAS "names the reason" 'has moved since'

	# --- 14. Status: idle report ---
	ECHO_E "\e[1;96m[14] status (idle)\e[0m"
	_ST_RUN --status
	_ST_EQ "exits 0" "$RC" "0"
	_ST_OUT_HAS "reports idle" '^git-edit: ok — no operation in flight'

	# --- 15. amend-into=auto: consensus target, new file follows ---
	ECHO_E "\e[1;96m[15] amend-into=auto\e[0m"
	echo "em" > m.txt && git add m.txt && git commit -qm "M commit"
	echo "en" > n.txt && git add n.txt && git commit -qm "N commit"
	echo "em2" > m.txt && git add m.txt
	echo "new" > p.txt && git add p.txt
	_ST_RUN --amend-into=auto
	_ST_EQ "exits 0" "$RC" "0"
	_ST_OUT_HAS "names auto-target" 'auto-target'
	_ST_EQ "fold landed in M" "$(git show 'HEAD~1:m.txt')" "em2"
	_ST_CHECK "new file followed consensus" git cat-file -e 'HEAD~1:p.txt'

	# --- 16. auto refuses ambiguous targets ---
	ECHO_E "\e[1;96m[16] auto ambiguity refusal\e[0m"
	echo "em3" > m.txt && echo "en3" > n.txt
	git add m.txt n.txt
	_ST_RUN --amend-into=auto
	_ST_CHECK "refuses" test "$RC" != "0"
	_ST_OUT_HAS "lists candidates" 'different commits'
	git reset -q && git checkout -q -- m.txt n.txt

	# --- 17. auto refuses pushed-only history ---
	ECHO_E "\e[1;96m[17] auto pushed-history refusal\e[0m"
	echo "beta2" > b.txt && git add b.txt
	_ST_RUN --amend-into=auto
	_ST_CHECK "refuses" test "$RC" != "0"
	_ST_OUT_HAS "names the reason" 'pushed commit'
	git reset -q && git checkout -q -- b.txt

	# --- 18. split by pathspec ---
	ECHO_E "\e[1;96m[18] split\e[0m"
	echo "s1" > s1.txt && echo "s2" > s2.txt
	git add s1.txt s2.txt && git commit -qm "S mixed commit"
	PRE_TREE=$(git rev-parse 'HEAD^{tree}')
	_ST_RUN --split="$(git rev-parse HEAD)" --text="S extracted" -- s1.txt
	_ST_EQ "exits 0" "$RC" "0"
	_ST_OUT_HAS "states tree identity" 'Tip tree unchanged by construction'
	_ST_EQ "tip tree identical" "$(git rev-parse 'HEAD^{tree}')" "$PRE_TREE"
	_ST_EQ "tip keeps original message" "$(git log --format=%s -1)" "S mixed commit"
	_ST_EQ "extracted commit below it" "$(git log --format=%s -2 | tail -1)" "S extracted"
	_ST_CHECK "extracted has s1" git cat-file -e 'HEAD~1:s1.txt'
	_ST_CHECK "extracted lacks s2" sh -c "! git cat-file -e 'HEAD~1:s2.txt'"
	_ST_RUN --split="$(git rev-parse HEAD)" --text="x" -- nomatch.txt
	_ST_CHECK "refuses non-matching pathspec" test "$RC" != "0"
	_ST_RUN --split="$(git rev-parse HEAD~1)" --text="x" -- s1.txt
	_ST_CHECK "refuses whole-commit pathspec" test "$RC" != "0"
	_ST_OUT_HAS "names the reason" 'covers every change'
	_ST_OUT_HAS "single-file split points at the content form" 'drop the pathspec and split by content'

	# --- 19. empty-step pause: guidance + skip, plus graceful no-op continue ---
	ECHO_E "\e[1;96m[19] empty-step guidance\e[0m"
	echo "f1" > f1.txt && echo "v1" > f2.txt && git add f1.txt f2.txt && git commit -qm "R0 base"
	echo "f1x" > f1.txt && echo "v2" > f2.txt && git add f1.txt f2.txt && git commit -qm "R1 commit"
	echo "v1" > f2.txt && git add f2.txt && git commit -qm "R2 revert"
	PRE_HEAD=$(git rev-parse HEAD)
	# Moving the revert before the commit it reverts makes it empty
	_ST_RUN --reorder "$(git rev-parse HEAD)" "$(git rev-parse HEAD~1)"
	_ST_EQ "pauses with exit 2" "$RC" "2"
	_ST_OUT_HAS "explains the empty step" 'became empty'
	_ST_OUT_HAS "names the skip escape" 'rebase --skip'
	local EMPTY_WT=$(echo "$OUT" | sed -n 's/^git-edit: conflict — resolve in \([^ ]*\).*/\1/p' | head -1)
	git -C "$EMPTY_WT" rebase --skip >/dev/null 2>&1
	_ST_RUN --continue
	_ST_EQ "continue applies the result" "$RC" "0"
	_ST_CHECK "HEAD moved" test "$(git rev-parse HEAD)" != "$PRE_HEAD"
	_ST_EQ "revert dropped, R1 content kept" "$(git show 'HEAD:f2.txt')" "v2"
	_ST_CHECK "state cleared" test ! -f "$(git rev-parse --git-common-dir)/git-edit-state"
	# Graceful no-op: a manually-aborted worktree rebase reports unchanged
	echo "v2b" > f2.txt && git add f2.txt && git commit -qm "R3 commit"
	echo "v1" > f2.txt && git add f2.txt && git commit -qm "R4 revert"
	PRE_HEAD=$(git rev-parse HEAD)
	_ST_RUN --reorder "$(git rev-parse HEAD)" "$(git rev-parse HEAD~1)"
	_ST_EQ "pauses with exit 2" "$RC" "2"
	EMPTY_WT=$(echo "$OUT" | sed -n 's/^git-edit: conflict — resolve in \([^ ]*\).*/\1/p' | head -1)
	git -C "$EMPTY_WT" rebase --abort >/dev/null 2>&1
	_ST_RUN --continue
	_ST_EQ "no-op continue exits 0" "$RC" "0"
	_ST_OUT_HAS "reports unchanged" '^git-edit: ok — .* unchanged'
	_ST_EQ "branch untouched" "$(git rev-parse HEAD)" "$PRE_HEAD"
	_ST_CHECK "state cleared" test ! -f "$(git rev-parse --git-common-dir)/git-edit-state"

	# --- 20. tag-orphan warning on rewrites beneath a tag ---
	ECHO_E "\e[1;96m[20] tag-orphan warning\e[0m"
	echo "t1" > t1.txt && git add t1.txt && git commit -qm "T1 commit"
	echo "t2" > t2.txt && git add t2.txt && git commit -qm "T2 commit"
	git tag marker
	# Rewriting BELOW the tag orphans it – expect the warning + exact re-point
	_ST_RUN -M --text="T1 reworded" "$(git rev-parse HEAD~1)"
	_ST_EQ "exits 0" "$RC" "0"
	_ST_OUT_HAS "warns about the tag" 'points into the rewritten span'
	_ST_OUT_HAS "suggests exact counterpart" 'git tag -f marker .*same subject'
	git tag -f marker >/dev/null 2>&1   # re-point to current HEAD for the next check
	# Rewriting ABOVE the tag leaves it reachable – expect no warning
	git tag -f marker "$(git rev-parse HEAD~1)" >/dev/null 2>&1
	_ST_RUN -M --text="T2 reworded" "$(git rev-parse HEAD)"
	_ST_EQ "exits 0" "$RC" "0"
	_ST_OUT_LACKS "no warning for safe tag" 'points into the rewritten span'
	git tag -d marker >/dev/null 2>&1

	# --- 21. auto-target resolves from a subdirectory ---
	ECHO_E "\e[1;96m[21] auto-target from subdirectory\e[0m"
	mkdir -p subd
	echo "sd" > subd/sd.txt && git add subd/sd.txt && git commit -qm "SD commit"
	cd subd
	echo "sd2" > sd.txt && git add sd.txt
	_ST_RUN --amend-into=auto
	_ST_EQ "exits 0" "$RC" "0"
	_ST_OUT_HAS "names auto-target" 'auto-target'
	cd "$TMP/repo"
	_ST_EQ "fold landed in SD" "$(git show 'HEAD:subd/sd.txt')" "sd2"

	# --- 22. man page exists and documents every mode (drift guard vs. USAGE) ---
	ECHO_E "\e[1;96m[22] man page coverage\e[0m"
	local MANPAGE="$(dirname "$SELF")/man/man1/git-edit.1"
	local READMEFILE="$(dirname "$SELF")/README.md"
	_ST_CHECK "man page present" test -f "$MANPAGE"
	if [ -f "$MANPAGE" ]; then
		# Derive the flags from the parser itself. A hardcoded list drifts the
		# moment a mode is added – which is the very drift this check exists to
		# catch, so it must not be the thing needing maintenance. Anchored on
		# `^if ! zparseopts`, since this block's own source mentions it too.
		local -a DOCFLAGS
		local ZLINE=$(command grep -m1 '^if ! zparseopts' "$SELF")
		local ztok zname
		for ztok in ${(z)ZLINE}; do
			[[ "$ztok" != *"=OPT_"* ]] && continue
			ztok=${ztok%%=OPT_*}
			ztok=${ztok%%:*}
			ztok=${ztok//[\{\}]/}
			for zname in ${(s:,:)ztok}; do
				[[ "$zname" == -* ]] && DOCFLAGS+=("-$zname")
			done
		done
		_ST_CHECK "flag list derived from the parser" test ${#DOCFLAGS[@]} -ge 20
		# Strip roff backslash escapes so flag spellings match; no man/mandoc dep
		local mflag missing="" rmissing=""
		local MANTEXT=$(sed 's/\\//g' "$MANPAGE")
		for mflag in "${DOCFLAGS[@]}"; do
			[ -z "$mflag" ] && continue
			echo "$MANTEXT" | grep -q -- "$mflag" || missing="$missing $mflag"
			[ -f "$READMEFILE" ] && { grep -q -- "$mflag" "$READMEFILE" || rmissing="$rmissing $mflag" }
		done
		if [ -z "$missing" ]; then
			PASS=$((PASS+1)); ECHO_E "  \e[0;32mPASS\e[0m man page documents every mode"
		else
			FAIL=$((FAIL+1)); ECHO_E "  \e[1;31mFAIL\e[0m man page missing:$missing"
		fi
		if [ -z "$rmissing" ]; then
			PASS=$((PASS+1)); ECHO_E "  \e[0;32mPASS\e[0m README documents every mode"
		else
			FAIL=$((FAIL+1)); ECHO_E "  \e[1;31mFAIL\e[0m README missing:$rmissing"
		fi
	fi

	# --- 23. stale (rewritten) SHAs are refused, never silently no-op'd ---
	ECHO_E "\e[1;96m[23] stale SHA handling\e[0m"
	echo "stale" > stale.txt && git add stale.txt && git commit -qm "Stale target"
	local STALE_SHA=$(git rev-parse HEAD)
	# Fold into it: the SHA changes, the subject survives for the counterpart hint
	echo "stale2" > stale.txt && git add stale.txt
	_ST_RUN --amend-into="$STALE_SHA"
	local STALE_HEAD=$(git rev-parse HEAD)
	local STALE_COUNT=$(git rev-list --count HEAD)
	_ST_RUN -d -y "$STALE_SHA"
	_ST_EQ "drop refuses a stale SHA" "$RC" "1"
	_ST_OUT_HAS "explains it was rewritten" 'likely rewritten'
	_ST_OUT_HAS "names the counterpart" 'counterpart on HEAD'
	_ST_EQ "HEAD untouched" "$(git rev-parse HEAD)" "$STALE_HEAD"
	_ST_EQ "nothing dropped" "$(git rev-list --count HEAD)" "$STALE_COUNT"
	_ST_RUN -d -y deadbeefdeadbeefdeadbeefdeadbeefdeadbeef
	_ST_EQ "nonexistent SHA refused" "$RC" "1"
	_ST_OUT_HAS "reports it does not exist" 'does not exist'
	# A commit only rebuilt as a descendant keeps its diff, so it resolves outright
	echo "tip" > tip.txt && git add tip.txt && git commit -qm "Tip commit"
	local SHIFTED=$(git rev-parse HEAD)
	echo "stale3" > stale.txt && git add stale.txt
	_ST_RUN --amend-into="$(git rev-parse HEAD~1)"
	_ST_RUN -M --text="Tip reworded" "$SHIFTED"
	_ST_EQ "stale descendant auto-resolves" "$RC" "0"
	_ST_OUT_HAS "reports the substitution" 'current identity'
	_ST_EQ "reword hit the right commit" "$(git log -1 --format=%s)" "Tip reworded"
	export GIT_EDIT_NO_RESOLVE=1
	_ST_RUN -M --text="Opted out" "$SHIFTED"
	unset GIT_EDIT_NO_RESOLVE
	_ST_EQ "GIT_EDIT_NO_RESOLVE opts out" "$RC" "1"
	# --amend-into and --split take their target as an option value, not a
	# positional, so they need the guard wired in separately
	echo "anchor" > anchor.txt && git add anchor.txt && git commit -qm "Anchor commit"
	local ANCHOR=$(git rev-parse HEAD)
	echo "opt" > opt.txt && git add opt.txt && git commit -qm "Option-value target"
	local OPTVAL=$(git rev-parse HEAD)
	echo "shift" > shift.txt && git add shift.txt && git commit -qm "Shifter"
	# Fold below the target so it is only rebuilt – its own diff, and so its
	# patch id, must survive for the resolution to be provable
	echo "anchor2" > anchor.txt && git add anchor.txt
	_ST_RUN --amend-into="$ANCHOR"
	echo "folded" > folded.txt && git add folded.txt
	_ST_RUN --amend-into="$OPTVAL"
	_ST_EQ "--amend-into resolves a stale target" "$RC" "0"
	_ST_OUT_HAS "--amend-into reports the substitution" 'current identity'
	_ST_EQ "fold landed on the resolved commit" "$(git show 'HEAD~1:folded.txt' 2>/dev/null)" "folded"
	# A resolved match on pushed history is named, never acted on – not even
	# under --allow-pushed, which consents to the named commit and not this one.
	# A cherry-pick keeps both author date and diff, so it is the twin to beat.
	git rm -q b.txt && git commit -qm "Remove beta"
	git cherry-pick "$(git rev-parse origin/main)" >/dev/null 2>&1
	local TWIN=$(git rev-parse HEAD)
	# Dropping the twin leaves the pushed original as the sole commit with that
	# diff, so the stale SHA resolves uniquely onto shared history
	_ST_RUN -d -y "$TWIN"
	local TWIN_HEAD=$(git rev-parse HEAD)
	_ST_RUN -M --text="Should not land" --allow-pushed "$TWIN"
	_ST_EQ "pushed match refused under --allow-pushed" "$RC" "1"
	_ST_OUT_HAS "names the pushed match" 'already pushed'
	_ST_EQ "branch untouched" "$(git rev-parse HEAD)" "$TWIN_HEAD"

	# --- 24. merge topology: plumbing rebuilds preserve it, rebase modes refuse ---
	ECHO_E "\e[1;96m[24] merge topology\e[0m"
	echo "l1" > l1.txt && git add l1.txt && git commit -qm "Low one"
	local LOW1=$(git rev-parse HEAD)
	echo "l2" > l2.txt && git add l2.txt && git commit -qm "Low two"
	local LOW2=$(git rev-parse HEAD)
	echo "db" > db.txt && git add db.txt && git commit -qm "Diamond base"
	local DBASE=$(git rev-parse HEAD)
	git checkout -q -b d-side
	echo "ds" > ds.txt && git add ds.txt && git commit -qm "Diamond side"
	local DSIDE=$(git rev-parse HEAD)
	git checkout -q main
	echo "dm" > dm.txt && git add dm.txt && git commit -qm "Diamond main"
	local DMAIN=$(git rev-parse HEAD)
	git merge -q --no-ff -m "Diamond merge" d-side >/dev/null 2>&1
	echo "dt" > dt.txt && git add dt.txt && git commit -qm "Diamond tip"
	# Mid-leg reword: the side leg does not descend from it, so it must
	# survive byte-identical while the merge is rebuilt with the new parent
	_ST_RUN -M --text="Diamond main reworded" "$DMAIN"
	_ST_EQ "reword below a merge exits 0" "$RC" "0"
	_ST_EQ "merge topology preserved" "$(git rev-list --merges --count HEAD)" "1"
	_ST_CHECK "untouched side leg kept as-is" git merge-base --is-ancestor "$DSIDE" HEAD
	echo "dbx" >> db.txt && git add db.txt
	_ST_RUN --amend-into="$DBASE"
	_ST_EQ "--amend-into refuses across a merge" "$RC" "1"
	_ST_OUT_HAS "names the flatten hazard" 'flatten'
	git reset -q && git checkout -q -- db.txt
	_ST_RUN -d -y "$DBASE"
	_ST_EQ "drop refuses across a merge" "$RC" "1"
	# A merge-free range below the merge routes to plumbing and stays legal
	_ST_RUN -s -y --text="Lows combined" "$LOW1" "$LOW2"
	_ST_EQ "squash below the merge auto-routes to plumbing" "$RC" "0"
	_ST_EQ "merge survived the squash" "$(git rev-list --merges --count HEAD)" "1"
	git branch -q -D d-side

	# --- 25. move mode: reposition one commit via derived span reorder ---
	ECHO_E "\e[1;96m[25] move mode\e[0m"
	for MC in m1 m2 m3 m4; do
		echo "$MC" > "$MC.txt" && git add "$MC.txt" && git commit -qm "Move $MC"
	done
	local MV_FIRST=$(git rev-parse HEAD~3)
	local MV_TIP=$(git rev-parse HEAD)
	_ST_RUN --move="$MV_TIP" --after="$MV_FIRST"
	_ST_EQ "backward move exits 0" "$RC" "0"
	_ST_EQ "span reordered as asked" "$(git log --format=%s -4 | tr '\n' ' ')" "Move m3 Move m2 Move m4 Move m1 "
	local MV_M4=$(git log --format='%H %s' -4 | awk '$3=="m4"{print $1}')
	_ST_RUN --move="$MV_M4" --after="$(git rev-parse HEAD)"
	_ST_EQ "forward move exits 0" "$RC" "0"
	_ST_EQ "restored original order" "$(git log --format=%s -4 | tr '\n' ' ')" "Move m4 Move m3 Move m2 Move m1 "
	_ST_RUN --move="$(git rev-parse HEAD)" --after="$(git rev-parse HEAD~1)"
	_ST_EQ "in-position move is a no-op" "$RC" "0"
	_ST_OUT_HAS "no-op reports unchanged" 'unchanged'
	_ST_RUN --move="$(git rev-parse HEAD)" --after="$(git rev-parse HEAD~2)" --before="$(git rev-parse HEAD~3)"
	_ST_EQ "both anchors refused" "$RC" "1"
	# Swapping two commits whose hunks abut conflicts on both steps. The first
	# rebuilds an intermediate that never existed (authored), but the last is
	# fully determined – the hint must name it there and only there
	printf 'mv-base\n' > mv.txt && git add mv.txt && git commit -qm "MV base"
	printf 'mv-base\nmv-A\n' > mv.txt && git add mv.txt && git commit -qm "MV A"
	local MV_A=$(git rev-parse HEAD)
	printf 'mv-base\nmv-B\nmv-A\n' > mv.txt && git add mv.txt && git commit -qm "MV B"
	local MV_B=$(git rev-parse HEAD)
	local MV_TREE=$(git rev-parse 'HEAD^{tree}')
	_ST_RUN --move="$MV_A" --after="$MV_B"
	_ST_EQ "abutting swap conflicts" "$RC" "2"
	_ST_OUT_LACKS "no final-step hint on an intermediate step" 'Final step'
	_ST_OUT_HAS "intermediate step says author it" 'rebuilds a state that never existed'
	_ST_OUT_HAS "intermediate step rules out --3way" 'cannot work here'
	local MV_WT=$(echo "$OUT" | sed -n 's/.*resolve in \([^ ]*\) .*/\1/p' | tail -1)
	printf 'mv-base\nmv-B\n' > "$MV_WT/mv.txt" && git -C "$MV_WT" add mv.txt
	# The final step is fully determined, so it resolves itself rather than
	# handing back a command the tool already derived
	_ST_RUN --continue
	_ST_EQ "final step needs no second continue" "$RC" "0"
	_ST_OUT_HAS "says it auto-resolved the final step" 'Final step auto-resolved'
	_ST_OUT_LACKS "no homework left for the caller" 'Final step – a reorder preserves'

	_ST_EQ "tree preserved by the reorder" "$(git rev-parse 'HEAD^{tree}')" "$MV_TREE"
	_ST_EQ "commits swapped" "$(git log --format=%s -2 | tr '\n' ' ')" "MV A MV B "

	# --- 26. explicit-target squash: same-second span, short SHAs ---
	# The rebuilt-commit case: descendants of one rewrite all share a committer
	# second, so timestamp sorts tie – the span must sort from HEAD's history,
	# and short SHAs must normalize for that sort's exact match to hit
	ECHO_E "\e[1;96m[26] explicit-target squash ordering\e[0m"
	local QN
	for QN in q1 q2 q3 q4; do
		echo "$QN" > q.txt && git add q.txt
		GIT_COMMITTER_DATE="2026-01-02T03:04:05+00:00" git commit -qm "Q $QN"
	done
	local QT=$(git rev-parse --short HEAD~3)
	_ST_RUN -s="$QT" -y --text="Q combined" "$(git rev-parse --short HEAD)" "$(git rev-parse --short HEAD~1)" "$(git rev-parse --short HEAD~2)"
	_ST_EQ "same-second short-SHA squash exits 0" "$RC" "0"
	_ST_OUT_HAS "routed to plumbing" 'commit-tree'
	_ST_EQ "one combined commit" "$(git log -1 --format=%s)" "Q combined"
	_ST_EQ "content is the newest version" "$(git show HEAD:q.txt)" "q4"
	# A tree-identical rewrite (non-adjacent squash of separate-file commits,
	# forced onto the rebase path) needs no checkout reconcile – the hint must
	# say so instead of prescribing the stash/reset dance
	echo "r1" > r1.txt && git add r1.txt && git commit -qm "R gap1"
	echo "r2" > r2.txt && git add r2.txt && git commit -qm "R gap2"
	echo "r3" > r3.txt && git add r3.txt && git commit -qm "R gap3"
	_ST_RUN -s="$(git rev-parse HEAD~2)" -y --text="R gap1+3" "$(git rev-parse HEAD)"
	_ST_EQ "non-adjacent pure squash exits 0" "$RC" "0"
	_ST_OUT_HAS "reconcile hint suppressed" 'checkout is already current'
	_ST_OUT_LACKS "no stash dance prescribed" "stash push -u -m 'wip before git-edit'"

	# --- 27. rebase-path conflicts pause into --continue/--abort ---
	# Dropping a commit whose successor edits the same line conflicts, and the
	# isolated rebase must pause like the plumbing modes rather than bail
	ECHO_E "\e[1;96m[27] rebase-path conflict pause\e[0m"
	printf 'x\nb\nz\n' > pz.txt && git add pz.txt && git commit -qm "PZ base"
	printf 'x\nMID\nz\n' > pz.txt && git add pz.txt && git commit -qm "PZ mid"
	printf 'x\nTIP\nz\n' > pz.txt && git add pz.txt && git commit -qm "PZ tip"
	local PZ_TIP=$(git rev-parse HEAD)
	_ST_RUN -d -y HEAD~1
	_ST_EQ "conflicting drop pauses (exit 2)" "$RC" "2"
	_ST_OUT_HAS "names the action" 'Conflict during drop'
	_ST_EQ "branch untouched while paused" "$(git rev-parse HEAD)" "$PZ_TIP"
	local PZ_WT=$(echo "$OUT" | sed -n 's/.*resolve in \([^ ]*\) .*/\1/p' | tail -1)
	printf 'x\nTIP\nz\n' > "$PZ_WT/pz.txt" && git -C "$PZ_WT" add pz.txt
	_ST_RUN --continue
	_ST_EQ "continue completes the drop" "$RC" "0"
	_ST_EQ "dropped commit is gone" "$(git log --format=%s -2 | tr '\n' ' ')" "PZ tip PZ base "
	_ST_CHECK "state cleared after continue" sh -c "! git edit --status 2>&1 | grep -q 'In-flight'"
	printf 'x\nMID2\nz\n' > pz.txt && git add pz.txt && git commit -qm "PZ mid2"
	printf 'x\nTIP2\nz\n' > pz.txt && git add pz.txt && git commit -qm "PZ tip2"
	local PZ_TIP2=$(git rev-parse HEAD)
	_ST_RUN -d -y HEAD~1
	_ST_EQ "second conflicting drop pauses" "$RC" "2"
	_ST_RUN --abort
	_ST_EQ "abort exits 0" "$RC" "0"
	_ST_OUT_HAS "abort reports nothing to roll back" 'never touched'
	_ST_EQ "abort leaves the branch untouched" "$(git rev-parse HEAD)" "$PZ_TIP2"

	# --- 28. auto-target follows the edited lines, not the file ---
	ECHO_E "\e[1;96m[28] blame-aware auto-target\e[0m"
	printf 'bl1\nbl2\nbl3\nbl4\nbl5\nbl6\nbl7\nbl8\n' > bl.txt
	git add bl.txt && git commit -qm "BL base"
	printf 'bl1\nBL-A original\nbl2\nbl3\nbl4\nbl5\nbl6\nbl7\nbl8\n' > bl.txt
	git add bl.txt && git commit -qm "BL add A"
	printf 'bl1\nBL-A original\nbl2\nbl3\nbl4\nbl5\nbl6\nbl7\nbl8\nBL-B original\n' > bl.txt
	git add bl.txt && git commit -qm "BL add B"
	printf 'bl1\nBL-A original\nbl2\nbl3\nbl4\nbl5\nbl6\nbl7\nbl8\nBL-B refined\n' > bl.txt
	git add bl.txt && git commit -qm "BL refine B"
	# The newest commit touching bl.txt is "BL refine B", but the edited line
	# belongs to "BL add A" – the file-level guess would fold into the wrong one
	printf 'bl1\nBL-A EDITED\nbl2\nbl3\nbl4\nbl5\nbl6\nbl7\nbl8\nBL-B refined\n' > bl.txt
	git add bl.txt
	_ST_RUN --amend-into=auto
	_ST_EQ "line-level auto exits 0" "$RC" "0"
	_ST_OUT_HAS "reports the line-level basis" 'last touched the staged lines'
	_ST_EQ "folded into the line's owner" "$(git log --format=%s -S 'BL-A EDITED' | head -1)" "BL add A"
	_ST_EQ "later commit left alone" "$(git log --format=%s -1)" "BL refine B"
	# Lines owned by two different commits – refuse rather than pick one
	printf 'bl1\nBL-A TWICE\nbl2\nbl3\nbl4\nbl5\nbl6\nbl7\nbl8\nBL-B TWICE\n' > bl.txt
	git add bl.txt
	_ST_RUN --amend-into=auto
	_ST_EQ "split line ownership refused" "$RC" "1"
	_ST_OUT_HAS "names the competing commits" 'different commits'
	git reset -q --hard HEAD

	# --- 29. non-interactive edit mode: pause, author, continue ---
	ECHO_E "\e[1;96m[29] edit mode (agent flow)\e[0m"
	git reset -q --hard   # reconcile the scratch checkout so later commits carry no phantom reverts
	printf 'e1\nEDIT-ME\ne2\n' > ed.txt && git add ed.txt && git commit -qm "ED target"
	local ED_TARGET=$(git rev-parse HEAD)
	echo "ed-later" > ed2.txt && git add ed2.txt && git commit -qm "ED later"
	local ED_TIP=$(git rev-parse HEAD)
	_ST_RUN "$ED_TARGET"
	_ST_EQ "edit pauses (exit 2)" "$RC" "2"
	_ST_OUT_HAS "emits a paused trailer" 'git-edit: paused'
	_ST_EQ "branch untouched while authoring" "$(git rev-parse HEAD)" "$ED_TIP"
	local ED_WT=$(echo "$OUT" | sed -n 's/^git-edit: paused — edit [0-9a-f]* in \(.*\); then.*/\1/p')
	_ST_CHECK "worktree sits at the target" test "$(git -C "$ED_WT" rev-parse HEAD)" = "$ED_TARGET"
	_ST_RUN --status
	_ST_OUT_HAS "status names the authoring phase" 'Authoring phase'
	_ST_RUN --continue
	_ST_EQ "empty continue refused" "$RC" "1"
	_ST_OUT_HAS "explains nothing to amend" 'Nothing to amend'
	printf 'e1\nEDITED\ne2\n' > "$ED_WT/ed.txt"
	# A commit landing on the branch during authoring must be absorbed
	echo "mid" > ed-mid.txt && git add ed-mid.txt && git commit -qm "ED mid-pause"
	_ST_RUN --continue --text "ED target, edited"
	_ST_EQ "continue completes the edit" "$RC" "0"
	_ST_OUT_HAS "prints the net history change" 'Net history change'
	local ED_NEW=$(git log --format='%H %s' | grep 'ED target, edited' | cut -d' ' -f1)
	_ST_CHECK "reword applied" test -n "$ED_NEW"
	_ST_EQ "content edited at the target" "$(git show "${ED_NEW}:ed.txt" 2>/dev/null | sed -n 2p)" "EDITED"
	_ST_CHECK "mid-pause commit absorbed" sh -c "git log --format=%s | grep -q 'ED mid-pause'"
	_ST_CHECK "state cleared" sh -c "! git edit --status 2>&1 | grep -q 'In-flight'"
	# Abort leaves everything untouched
	git reset -q --hard
	local ED_TIP2=$(git rev-parse HEAD)
	_ST_RUN "$(git rev-parse HEAD~1)"
	_ST_RUN --abort
	_ST_EQ "abort exits 0" "$RC" "0"
	_ST_EQ "abort leaves the branch untouched" "$(git rev-parse HEAD)" "$ED_TIP2"

	# --- 30. content split: pause, author the split point, continue ---
	ECHO_E "\e[1;96m[30] content split (same-file halves)\e[0m"
	git reset -q --hard
	printf 'first\nsecond\n' > cs.txt && git add cs.txt && git commit -qm "CS base"
	printf 'FIRST\nsecond\nthird\n' > cs.txt && git add cs.txt && git commit -qm "CS mixed commit"
	local CS_TARGET=$(git rev-parse HEAD)
	echo "cs-later" > cs2.txt && git add cs2.txt && git commit -qm "CS later"
	local CS_TIP=$(git rev-parse HEAD)
	local CS_TIP_TREE=$(git rev-parse 'HEAD^{tree}')
	_ST_RUN --split="$CS_TARGET"
	_ST_EQ "pathspec-less split pauses (exit 2)" "$RC" "2"
	_ST_OUT_HAS "emits a paused trailer" 'git-edit: paused — split'
	_ST_EQ "branch untouched while authoring" "$(git rev-parse HEAD)" "$CS_TIP"
	local CS_WT=$(echo "$OUT" | sed -n 's/^git-edit: paused — split [0-9a-f]* in \(.*\); then.*/\1/p')
	_ST_CHECK "worktree sits at the target" test "$(git -C "$CS_WT" rev-parse HEAD)" = "$CS_TARGET"
	_ST_RUN --status
	_ST_OUT_HAS "status names the authoring phase" 'Authoring phase'
	_ST_OUT_HAS "status reports it as paused, not conflicted" 'git-edit: paused — split'
	_ST_RUN --continue
	_ST_EQ "continue without a message refused" "$RC" "1"
	_ST_OUT_HAS "asks for --text" 'needs a message'
	_ST_RUN --continue --text "CS extracted"
	_ST_EQ "unedited worktree refused" "$RC" "1"
	_ST_OUT_HAS "names the empty remainder" 'remainder commit would be empty'
	echo "debris" > "$CS_WT/cs-stray.txt"
	_ST_RUN --continue --text "CS extracted"
	_ST_EQ "stray path refused" "$RC" "1"
	_ST_OUT_HAS "names the stray path" 'cs-stray.txt'
	rm -f "$CS_WT/cs-stray.txt"
	printf 'first\nsecond\n' > "$CS_WT/cs.txt"
	_ST_RUN --continue --text "CS extracted"
	_ST_EQ "worktree back at the parent refused" "$RC" "1"
	_ST_OUT_HAS "names the empty extraction" 'extracted commit would be empty'
	# The real split point: the uppercase half only, third line left for the remainder
	printf 'FIRST\nsecond\n' > "$CS_WT/cs.txt"
	# A commit landing on the branch during authoring must be absorbed
	echo "cs-mid" > cs-mid.txt && git add cs-mid.txt && git commit -qm "CS mid-pause"
	# Run the final continue from inside the worktree – its detached HEAD must
	# not stand in for the branch as the trailer's "before"
	local CS_PRE=$(git rev-parse HEAD)
	OUT=$(cd "$CS_WT" && GIT_EDIT_NO_AUTO_OPEN=1 "$SELF" --continue --text "CS extracted" </dev/null 2>&1)
	RC=$?
	_ST_EQ "continue completes the split" "$RC" "0"
	_ST_OUT_HAS "states tree identity" 'Tip tree unchanged by construction'
	_ST_OUT_HAS "trailer anchors on the branch, not the worktree HEAD" "moved $CS_PRE"
	_ST_CHECK "mid-pause commit absorbed" sh -c "git log --format=%s | grep -q 'CS mid-pause'"
	local CS_KEPT=$(git log --format='%H %s' | grep 'CS mixed commit' | cut -d' ' -f1)
	_ST_EQ "extracted commit sits below the remainder" "$(git log --format=%s -1 "$CS_KEPT^")" "CS extracted"
	_ST_EQ "extracted carries only the first half" "$(git show "$CS_KEPT^:cs.txt")" "$(printf 'FIRST\nsecond')"
	_ST_EQ "remainder carries the rest" "$(git show "${CS_KEPT}:cs.txt")" "$(printf 'FIRST\nsecond\nthird')"
	_ST_CHECK "descendants rebuilt" git cat-file -e 'HEAD:cs2.txt'
	_ST_CHECK "worktree cleaned up" test ! -d "$CS_WT"
	_ST_CHECK "state cleared" sh -c "! git edit --status 2>&1 | grep -q 'In-flight'"
	# The tip tree is only unchanged relative to the pre-split tip, so compare
	# against the commit that was HEAD before the mid-pause commit landed
	_ST_EQ "pre-split tip tree preserved" "$(git rev-parse 'HEAD~1^{tree}')" "$CS_TIP_TREE"

	# --- 31. argument mistakes name the right form instead of dead-ending ---
	ECHO_E "\e[1;96m[31] argument-error guidance\e[0m"
	_ST_RUN -M "Some prose that is a message, not a commit"
	_ST_EQ "prose in the <commit> slot refused" "$RC" "1"
	_ST_OUT_HAS "points at --text" 'pass it as --text'
	_ST_RUN -M --text="Some subject"
	_ST_EQ "missing commit refused" "$RC" "1"
	_ST_OUT_HAS "names the missing argument" 'Missing <commit>'
	# The retry is always a bare HEAD, so the error has to show what that is
	_ST_OUT_HAS "and says what HEAD currently is" 'HEAD is currently'
	_ST_OUT_HAS "with its subject, not just a sha" \
		"HEAD is currently [0-9a-f]\{7\} ."
	_ST_RUN --amend-into=HEAD -M
	_ST_EQ "--amend-into + -M refused" "$RC" "1"
	_ST_OUT_HAS "points at the reword form" 'To reword only'
	_ST_RUN
	_ST_EQ "bare invocation still exits 1" "$RC" "1"
	_ST_OUT_HAS "bare invocation still shows usage" 'usage: git edit'

	# --- 32. scoped fold: a pathspec keeps the rest of the index out ---
	ECHO_E "\e[1;96m[32] scoped --amend-into\e[0m"
	git reset -q --hard
	echo "sc1" > sc.txt && echo "other" > sc-other.txt && git add sc.txt sc-other.txt && git commit -qm "SC base"
	local SC_TARGET=$(git rev-parse HEAD)
	echo "sc-later" > sc-later.txt && git add sc-later.txt && git commit -qm "SC later"
	echo "sc1-folded" > sc.txt && git add sc.txt
	echo "sc-other-parallel" > sc-other.txt && git add sc-other.txt   # a parallel session's staging
	_ST_RUN --amend-into="$SC_TARGET" -- sc.txt
	_ST_EQ "scoped fold exits 0" "$RC" "0"
	_ST_OUT_HAS "reports what stayed staged" 'outside the pathspec'
	# Agents overwhelmingly read this through `| tail -N`, so the summary has
	# to survive the truncation rather than be padded out of reach
	_ST_EQ "non-TTY output carries no blank lines" "$(echo "$OUT" | grep -c '^$')" "0"
	_ST_EQ "summary survives a tail -5" "$(echo "$OUT" | tail -5 | grep -c 'outside the pathspec')" "1"
	local SC_NEW=$(git log --format='%H %s' | grep 'SC base' | cut -d' ' -f1)
	_ST_EQ "pathspec change folded" "$(git show "${SC_NEW}:sc.txt")" "sc1-folded"
	_ST_EQ "out-of-pathspec change NOT folded" "$(git show "${SC_NEW}:sc-other.txt")" "other"
	_ST_CHECK "out-of-pathspec change still staged" sh -c "git diff --cached --name-only | grep -q sc-other.txt"
	_ST_CHECK "history never saw it" sh -c "! git log -p --all | grep -q sc-other-parallel"
	_ST_RUN --amend-into="$SC_NEW" -- nosuch.txt
	_ST_EQ "empty pathspec match refused" "$RC" "1"
	_ST_OUT_HAS "names the empty match" 'No staged changes under'
	git reset -q --hard
	# --- 33. a reorder step resolved to empty must not vanish under an `ok` ---
	ECHO_E "\e[1;96m[33] dropped-commit reporting\e[0m"
	git reset -q --hard
	printf 'd1\nd2\nd3\n' > dr.txt && git add dr.txt && git commit -qm "DR base"
	printf 'd1\nDX\nd3\n' > dr.txt && git add dr.txt && git commit -qm "DR one"
	printf 'd1\nDY\nd3\n' > dr.txt && git add dr.txt && git commit -qm "DR two"
	local DR_TIP=$(git rev-parse HEAD)
	_ST_RUN --reorder "$DR_TIP" "$(git rev-parse HEAD~1)"
	_ST_EQ "reordering abutting edits conflicts" "$RC" "2"
	local DR_WT=$(echo "$OUT" | sed -n 's/^git-edit: conflict — resolve in \([^ ]*\).*/\1/p' | head -1)
	printf 'd1\nDY\nd3\n' > "$DR_WT/dr.txt" && git -C "$DR_WT" add dr.txt
	# The final step restores the pre-op blobs by itself, which leaves the
	# replayed commit empty and the rebase drops it
	_ST_RUN --continue
	_ST_EQ "resolution completes in one continue" "$RC" "0"
	_ST_OUT_HAS "continue path prints the new order too" 'new order (oldest-first)'
	_ST_OUT_HAS "reports the dropped commit" 'resolved to empty and were dropped'
	_ST_CHECK "state cleared" sh -c "! git edit --status 2>&1 | grep -q 'In-flight'"
	git reset -q --hard

	# --- 34. a staged resolution with conflict markers must not continue ---
	ECHO_E "\e[1;96m[34] conflict-marker guard\e[0m"
	git reset -q --hard
	printf 'm1\nm2\nm3\n' > mk.txt && git add mk.txt && git commit -qm "MK base"
	printf 'm1\nMT\nm3\n' > mk.txt && git add mk.txt && git commit -qm "MK target"
	local MK_TARGET=$(git rev-parse HEAD)
	printf 'm1\nML\nm3\n' > mk.txt && git add mk.txt && git commit -qm "MK later"
	printf 'm1\nMS\nm3\n' > mk.txt && git add mk.txt
	_ST_RUN --amend-into="$MK_TARGET"
	_ST_EQ "fold conflicts as set up" "$RC" "2"
	local MK_WT=$(echo "$OUT" | sed -n 's/^git-edit: conflict — resolve in \([^ ]*\).*/\1/p' | head -1)
	_ST_CHECK "worktree file carries markers" sh -c "grep -q '^<<<<<<<' '$MK_WT/mk.txt'"
	# The mistake this guards: a failed resolver, then a blanket `git add`
	git -C "$MK_WT" add mk.txt
	_ST_RUN --continue
	_ST_EQ "continue refused (exit 2)" "$RC" "2"
	_ST_OUT_HAS "names the marker problem" 'still contains conflict markers'
	_ST_CHECK "markers never reached history" sh -c "! git log -p --all | grep -q '^+<<<<<<< '"
	# A marker-free resolution is not blocked
	printf 'm1\nMS\nm3\n' > "$MK_WT/mk.txt" && git -C "$MK_WT" add mk.txt
	_ST_RUN --continue
	_ST_OUT_LACKS "clean resolution passes the guard" 'still contains conflict markers'
	_ST_RUN --abort
	_ST_CHECK "state cleared afterwards" sh -c "! git edit --status 2>&1 | grep -q 'In-flight'"
	git reset -q --hard

	# --- 35. the final-step auto-resolve must refuse when it can't prove itself ---
	ECHO_E "\e[1;96m[35] auto-resolve proof\e[0m"
	git reset -q --hard
	printf 'p1\n' > pa.txt && printf 'q1\n' > pb.txt && git add pa.txt pb.txt && git commit -qm "PR base"
	printf 'p1\npA\n' > pa.txt && git add pa.txt && git commit -qm "PR A"
	local PR_A=$(git rev-parse HEAD)
	printf 'p1\npB\npA\n' > pa.txt && git add pa.txt && git commit -qm "PR B"
	local PR_B=$(git rev-parse HEAD)
	_ST_RUN --move="$PR_A" --after="$PR_B"
	_ST_EQ "abutting swap conflicts" "$RC" "2"
	local PR_WT=$(echo "$OUT" | sed -n 's/.*resolve in \([^ ]*\) .*/\1/p' | tail -1)
	# Resolve step 1, but also touch a file neither commit changes – the final
	# step's pre-op blobs then cannot reproduce the pre-op tree, so the proof
	# fails and it must hand back rather than apply a resolution it can't verify
	printf 'p1\npB\n' > "$PR_WT/pa.txt"
	printf 'STRAY\n' > "$PR_WT/pb.txt"
	git -C "$PR_WT" add pa.txt pb.txt
	_ST_RUN --continue
	_ST_EQ "unprovable final step still pauses" "$RC" "2"
	_ST_OUT_LACKS "never claims an unproven auto-resolve" 'auto-resolved'
	_ST_RUN --abort
	_ST_CHECK "abort leaves no state" sh -c "! git edit --status 2>&1 | grep -q 'In-flight'"
	git reset -q --hard

	# --- 36. reporting must survive the shapes that break naive derivation ---
	ECHO_E "\e[1;96m[36] reporting under merges + scoped conflicts\e[0m"
	git reset -q --hard
	# (a) a merge in the reword span: commit count includes the side branch,
	# but `~N` walks first parents – deriving the commit by offset misses
	echo "rw1" > rw.txt && git add rw.txt && git commit -qm "RW target"
	local RW_TARGET=$(git rev-parse HEAD)
	git checkout -q -b rw-side "$RW_TARGET~1"
	echo "rwside" > rw-side.txt && git add rw-side.txt && git commit -qm "RW side"
	git checkout -q main
	git merge -q --no-ff rw-side -m "RW merge" >/dev/null 2>&1
	_ST_RUN -M --text="RW reworded" "$RW_TARGET"
	_ST_EQ "reword across a merge succeeds" "$RC" "0"
	_ST_OUT_HAS "echo names the reworded commit, not its parent" '[0-9a-f]\{7\} RW reworded'
	_ST_OUT_LACKS "result line does not name the wrong commit" '[0-9a-f]\{7\} RW target'
	_ST_CHECK "merge topology preserved" sh -c "test \$(git log --format=%P -1 HEAD | wc -w) -eq 2"
	git branch -q -D rw-side 2>/dev/null
	# (b) a scoped fold that conflicts: the scope must survive --continue, or
	# its intended leftovers get reported as an anomaly
	git reset -q --hard
	printf 'sc1\nsc2\nsc3\n' > sf.txt && printf 'keep\n' > sf-other.txt
	git add sf.txt sf-other.txt && git commit -qm "SF base"
	printf 'sc1\nSFT\nsc3\n' > sf.txt && git add sf.txt && git commit -qm "SF target"
	local SF_TARGET=$(git rev-parse HEAD)
	printf 'sc1\nSFL\nsc3\n' > sf.txt && git add sf.txt && git commit -qm "SF later"
	printf 'sc1\nSFS\nsc3\n' > sf.txt && git add sf.txt
	printf 'parallel\n' > sf-other.txt && git add sf-other.txt
	_ST_RUN --amend-into="$SF_TARGET" -- sf.txt
	_ST_EQ "scoped fold conflicts as set up" "$RC" "2"
	local SF_WT=$(echo "$OUT" | sed -n 's/^git-edit: conflict — resolve in \([^ ]*\).*/\1/p' | head -1)
	printf 'sc1\nSFS\nsc3\n' > "$SF_WT/sf.txt" && git -C "$SF_WT" add sf.txt
	_ST_RUN --continue
	printf 'sc1\nSFL\nsc3\n' > "$SF_WT/sf.txt" 2>/dev/null && git -C "$SF_WT" add sf.txt 2>/dev/null
	_ST_RUN --continue
	_ST_OUT_HAS "scope survives the conflict pause" 'outside the pathspec'
	_ST_OUT_LACKS "no bogus not-folded warning" 'not folded'
	_ST_CHECK "out-of-scope file never folded" sh -c "test \"\$(git show \$(git log --format='%H %s' | grep 'SF target' | cut -d' ' -f1):sf-other.txt)\" = keep"
	git reset -q --hard

	# --- 37. edit mode must report the stale checkout it leaves behind ---
	ECHO_E "\e[1;96m[37] edit-mode checkout staleness\e[0m"
	git reset -q --hard
	printf 'ed1\nSTALE-ME\ned3\n' > stale.js && git add stale.js && git commit -qm "STALE target"
	local STALE_T=$(git rev-parse HEAD)
	echo "stale-later" > stale-later.txt && git add stale-later.txt && git commit -qm "STALE later" >/dev/null 2>&1
	_ST_EQ "target has a descendant to replay" "$(git rev-list --count ${STALE_T}..HEAD)" "1"
	_ST_RUN "$STALE_T"
	local STALE_WT=$(echo "$OUT" | sed -n 's/^git-edit: paused — edit [0-9a-f]* in \(.*\); then.*/\1/p')
	printf 'ed1\nEDITED\ned3\n' > "$STALE_WT/stale.js"
	_ST_RUN --continue
	_ST_EQ "edit applies" "$RC" "0"
	# The trap: content was authored in the isolated worktree, so the main
	# checkout still has the old file – and staged as a revert of the edit
	_ST_CHECK "checkout really is stale" sh -c "test \"\$(sed -n 2p stale.js)\" = STALE-ME"
	_ST_OUT_HAS "warns the checkout is stale" 'still holds the pre-edit content'
	_ST_OUT_HAS "names the stale path" 'stale\.js'
	git restore --source=HEAD --staged --worktree -- stale.js
	_ST_CHECK "the printed reconcile fixes it" sh -c "test \"\$(sed -n 2p stale.js)\" = EDITED"
	_ST_CHECK "and clears the staged revert" sh -c "git diff --cached --quiet -- stale.js"
	# A message-only edit changes no content, so it must not cry wolf
	_ST_RUN "$(git rev-parse HEAD)"
	_ST_RUN --continue --text "STALE later, reworded"
	_ST_OUT_LACKS "no stale hint when content is unchanged" 'still holds the pre-edit content'
	git reset -q --hard

	# --- 38. a tree-changing rewrite reconciles per path, never by stashing ---
	ECHO_E "\e[1;96m[38] targeted checkout reconcile\e[0m"
	git reset -q --hard
	echo "tc-keep" > tc-keep.txt && git add tc-keep.txt && git commit -qm "TC base"
	echo "tc-drop" > tc-drop.txt && git add tc-drop.txt && git commit -qm "TC to drop"
	local TC_DROP=$(git rev-parse HEAD)
	echo "tc-later" > tc-later.txt && git add tc-later.txt && git commit -qm "TC later"
	echo "local wip" > tc-keep.txt   # unrelated WIP the advice must not disturb
	_ST_RUN -d -y "$TC_DROP"
	_ST_EQ "drop exits 0" "$RC" "0"
	_ST_OUT_HAS "names the dropped path" 'tc-drop\.txt'
	_ST_OUT_HAS "prescribes a targeted restore" 'restore --source=HEAD --staged --worktree'
	_ST_OUT_LACKS "never prescribes stashing a shared checkout" 'git stash push'
	_ST_OUT_LACKS "never prescribes a blanket reset" 'run git reset --hard'
	# A drop's leftover paths ARE the dropped work, so the restore has to read as
	# an opt-in discard – calling it a reconcile invites destroying what was kept
	_ST_OUT_HAS "frames the leftovers as uncommitted work" 'dropped content is now uncommitted'
	_ST_OUT_HAS "offers the discard as a choice" 'Keep it, or discard those paths'
	_ST_OUT_LACKS "never calls a drop a reconcile" 'Reconcile those paths'
	git restore --source=HEAD --staged --worktree -- tc-drop.txt
	_ST_CHECK "and that discard does remove the file" sh -c "! test -f tc-drop.txt"
	_ST_EQ "unrelated WIP untouched" "$(cat tc-keep.txt)" "local wip"
	git reset -q --hard
	# A path with a space must come out shell-quoted, or the printed command
	# parses as several pathspecs and matches none of them
	echo "tc-b2" > tc-b2.txt && git add tc-b2.txt && git commit -qm "TC base2"
	mkdir -p "tc dir" && echo "spaced" > "tc dir/tc file.txt"
	git add "tc dir/tc file.txt" && git commit -qm "TC spaced drop"
	local TC_SP=$(git rev-parse HEAD)
	echo "tc-after" > tc-after.txt && git add tc-after.txt && git commit -qm "TC after"
	_ST_RUN -d -y "$TC_SP"
	_ST_EQ "drop with a spaced path exits 0" "$RC" "0"
	_ST_OUT_HAS "shell-quotes the spaced path" "restore.*'tc dir/tc file.txt'"
	git reset -q --hard

	# --- 39. --exec names the branch it moved, and reaches the reconcile hint ---
	ECHO_E "\e[1;96m[39] exec reports the branch it rewrote\e[0m"
	git reset -q --hard
	echo "xa" > xa.txt && git add xa.txt && git commit -qm "XA base"
	echo "xb" > xb.txt && git add xb.txt && git commit -qm "XB to reword"
	_ST_RUN --exec -- git commit --amend -m "XB reworded by exec"
	_ST_EQ "exec exits 0" "$RC" "0"
	_ST_EQ "the reword landed" "$(git log -1 --format=%s)" "XB reworded by exec"
	# A multi-arg `[ -n ... ]` here made every branch exec claim a detached HEAD,
	# and leaked the shell's own usage error into the output
	_ST_OUT_LACKS "no raw shell error leaks" 'too many arguments'
	_ST_OUT_LACKS "does not claim a detached HEAD" 'Detached HEAD updated'
	_ST_OUT_HAS "names the branch it rewrote" 'Branch.*rewritten'
	# Only a content-changing exec reaches the per-path hint
	echo "xc" > xc.txt && git add xc.txt && git commit -qm "XC to change"
	_ST_RUN --exec -- sh -c 'echo changed > xc.txt && git add xc.txt && git commit -q --amend --no-edit'
	_ST_EQ "content-changing exec exits 0" "$RC" "0"
	_ST_OUT_HAS "names the path to reconcile" 'xc\.txt'
	_ST_OUT_HAS "prescribes a targeted restore" 'restore --source=HEAD --staged --worktree'
	git reset -q --hard

	# --- 40. a continue names the untracked files it absorbs ---
	ECHO_E "\e[1;96m[40] untracked absorption is named\e[0m"
	git reset -q --hard
	echo "ua" > ua.txt && git add ua.txt && git commit -qm "UA base"
	echo "ub" > ub.txt && git add ub.txt && git commit -qm "UB target"
	local UA_TGT=$(git rev-parse HEAD)
	echo "uc" > uc.txt && git add uc.txt && git commit -qm "UC later"
	_ST_RUN "$UA_TGT"
	local UA_WT=$(echo "$OUT" | sed $'s/\e\\[[0-9;]*m//g' | grep -oE '/[^ ]*git-edit-edit\.[A-Za-z0-9]+' | head -1)
	echo "edited" >> "$UA_WT/ub.txt"
	echo "scratch" > "$UA_WT/ua-stray.txt"
	_ST_RUN --continue
	_ST_EQ "continue exits 0" "$RC" "0"
	_ST_OUT_HAS "names untracked files it absorbs" 'Absorbing.*untracked file'
	_ST_OUT_HAS "names the stray itself" 'ua-stray\.txt'
	_ST_CHECK "the stray really did land in the commit" \
		sh -c "git show --stat --format= HEAD~1 | grep -q ua-stray"
	git reset -q --hard
	# An edit touching only tracked files must not cry wolf
	echo "ud" > ud.txt && git add ud.txt && git commit -qm "UD target"
	_ST_RUN "$(git rev-parse HEAD)"
	local UA_WT2=$(echo "$OUT" | sed $'s/\e\\[[0-9;]*m//g' | grep -oE '/[^ ]*git-edit-edit\.[A-Za-z0-9]+' | head -1)
	echo "edited" >> "$UA_WT2/ud.txt"
	_ST_RUN --continue
	_ST_EQ "clean continue exits 0" "$RC" "0"
	_ST_OUT_LACKS "silent when nothing untracked is absorbed" 'Absorbing'
	git reset -q --hard

	# --- 41. a conflict resolution is recorded for rerere to replay ---
	ECHO_E "\e[1;96m[41] conflict resolutions reach rr-cache\e[0m"
	git reset -q --hard
	local RR_DIR="$(git rev-parse --git-common-dir)/rr-cache"
	local RR_BEFORE=$(ls "$RR_DIR" 2>/dev/null | wc -l | tr -d ' ')
	printf 'rr line A\n' > rr.txt && git add rr.txt && git commit -qm "RR base"
	printf 'rr line B\n' > rr.txt && git add rr.txt && git commit -qm "RR middle"
	local RR_MID=$(git rev-parse HEAD)
	printf 'rr line C\n' > rr.txt && git add rr.txt && git commit -qm "RR top"
	_ST_RUN -d -y "$RR_MID"
	_ST_EQ "the drop conflicts as set up" "$RC" "2"
	local RR_WT=$(echo "$OUT" | sed -n 's/^git-edit: conflict — resolve in \([^ ]*\).*/\1/p' | head -1)
	if [ -n "$RR_WT" ] && [ -d "$RR_WT" ]; then
		printf 'rr line C\n' > "$RR_WT/rr.txt"
		git -C "$RR_WT" add rr.txt
		_ST_RUN --continue
		_ST_EQ "resolved drop completes" "$RC" "0"
	fi
	# The rebase START must carry `-c rerere.enabled=true`, not just `--continue`:
	# rerere stores the preimage when the conflict occurs, so enabling it only at
	# resolution time records nothing and a re-conflict can't replay the answer
	local RR_AFTER=$(ls "$RR_DIR" 2>/dev/null | wc -l | tr -d ' ')
	_ST_CHECK "the resolution was recorded for replay" sh -c "[ $RR_AFTER -gt $RR_BEFORE ]"
	git reset -q --hard
	# Edit mode records too – its conflict comes from replaying the descendants
	local RR_BEFORE_E=$(ls "$RR_DIR" 2>/dev/null | wc -l | tr -d ' ')
	printf 'ed line A\n' > ed.txt && git add ed.txt && git commit -qm "ED base"
	local ED_TARGET=$(git rev-parse HEAD)
	printf 'ed line B\n' > ed.txt && git add ed.txt && git commit -qm "ED later"
	_ST_RUN "$ED_TARGET"
	local ED_WT=$(echo "$OUT" | sed -n 's/^git-edit: paused — edit [^ ]* in \([^;]*\);.*/\1/p' | head -1)
	if [ -n "$ED_WT" ] && [ -d "$ED_WT" ]; then
		printf 'ed line EDITED\n' > "$ED_WT/ed.txt"
		_ST_RUN --continue
		local ED_CWT=$(echo "$OUT" | sed -n 's/^git-edit: conflict — resolve in \([^ ]*\).*/\1/p' | head -1)
		if [ -n "$ED_CWT" ] && [ -d "$ED_CWT" ]; then
			printf 'ed line B\n' > "$ED_CWT/ed.txt"
			git -C "$ED_CWT" add ed.txt
			_ST_RUN --continue
		fi
	fi
	_ST_CHECK "edit mode records its resolution too" \
		sh -c "[ $(ls "$RR_DIR" 2>/dev/null | wc -l | tr -d ' ') -gt $RR_BEFORE_E ]"
	git reset -q --hard
	# Structural, so a start that loses the flag is caught even when no scenario
	# happens to drive that mode into a conflict
	# Anchored to the start of a line, or these patterns would count the very
	# assertion lines that carry them
	_ST_CHECK "every conflict-capable rebase start carries rerere" \
		sh -c "[ \$(grep -cE '^[[:space:]]*local CMD=\\(-c rerere.enabled=true rebase' '$SELF') -eq 6 ]"
	_ST_CHECK "and none was left without it" \
		sh -c "! grep -qE '^[[:space:]]*local CMD=\\(rebase' '$SELF'"

	# --- 42. a CAS refusal keeps the resolution instead of deleting it ---
	ECHO_E "\e[1;96m[42] CAS refusal preserves the worktree\e[0m"
	git reset -q --hard
	printf 'cas one\ncas two\n' > cas.txt && git add cas.txt && git commit -qm "CAS base"
	local CAS_TARGET=$(git rev-parse HEAD)
	printf 'cas one\ncas CHANGED\n' > cas.txt && git add cas.txt && git commit -qm "CAS later"
	printf 'cas one\ncas FOLDED\n' > cas.txt && git add cas.txt
	_ST_RUN --amend-into="$CAS_TARGET" -- cas.txt
	_ST_EQ "the fold conflicts" "$RC" "2"
	local CAS_WT=$(echo "$OUT" | sed -n 's/^git-edit: conflict — resolve in \([^ ]*\).*/\1/p' | head -1)
	# A parallel session lands a commit while the resolution is being worked out
	printf 'other work\n' > other.txt && git add other.txt && git commit -qm "CAS parallel commit"
	# The fold cascades onto the later commit, so resolve until it stops asking
	local CAS_ROUNDS=0
	while [ "$RC" = "2" ] && [ $CAS_ROUNDS -lt 4 ]; do
		CAS_ROUNDS=$((CAS_ROUNDS+1))
		local CAS_WT_NOW=$(echo "$OUT" | sed -n 's/^git-edit: conflict — resolve in \([^ ]*\).*/\1/p' | head -1)
		if [ -z "$CAS_WT_NOW" ] || [ ! -d "$CAS_WT_NOW" ]; then
			break
		fi
		CAS_WT=$CAS_WT_NOW
		printf 'cas one\ncas RESOLVED\n' > "$CAS_WT/cas.txt"
		git -C "$CAS_WT" add cas.txt
		_ST_RUN --continue
	done
	_ST_EQ "the CAS refuses the write" "$RC" "1"
	_ST_OUT_HAS "says the branch moved" 'moved during resolution'
	# The refusal used to fire the exit trap, deleting the one copy of the work
	# and leaving a state whose worktree was gone
	_ST_CHECK "the worktree survives the refusal" sh -c "[ -d '$CAS_WT' ]"
	_ST_CHECK "and still holds the resolution" sh -c "grep -q 'cas RESOLVED' '$CAS_WT/cas.txt'"
	_ST_OUT_HAS "points at the surviving worktree" 'resolution is intact'
	_ST_RUN --status
	_ST_OUT_LACKS "status is not orphaned" 'worktree is gone'
	_ST_CHECK "the parallel commit was not clobbered" \
		sh -c "git log --format=%s | grep -qx 'CAS parallel commit'"
	# Plumbing modes touch no worktree, so they once slipped the in-flight guard
	# and moved the branch under the paused operation
	_ST_RUN -M --text="sneaks past" HEAD
	_ST_EQ "a reword is refused while paused" "$RC" "1"
	_ST_OUT_HAS "and says why" 'operation is in flight'
	_ST_CHECK "the branch did not move" sh -c "git log -1 --format=%s | grep -qx 'CAS parallel commit'"
	_ST_RUN --amend-into=auto
	_ST_EQ "a fold is refused too" "$RC" "1"
	_ST_RUN --abort
	_ST_EQ "abort clears the operation" "$RC" "0"
	_ST_CHECK "and removes the worktree" sh -c "[ ! -d '$CAS_WT' ]"
	# ...and the guard lifts once nothing is in flight
	_ST_RUN -M --text="Reworded after abort" HEAD
	_ST_EQ "reword works again afterwards" "$RC" "0"
	git reset -q --hard

	# --- 43. the orphan sweep takes debris and nothing else ---
	ECHO_E "\e[1;96m[43] orphan worktree sweep\e[0m"
	git reset -q --hard
	local GCBASE=${TMPDIR:-/tmp}
	GCBASE=${GCBASE%/}
	# Provable debris: pointer dangles, and it has sat around for a day
	local GC_DEAD="$GCBASE/git-edit-gctest-dead.$$"
	mkdir -p "$GC_DEAD" && echo "gitdir: /nonexistent/repo/.git/worktrees/x" > "$GC_DEAD/.git"
	touch -t 202601010000 "$GC_DEAD"
	# Same dangling pointer but fresh – could be an operation starting right now
	local GC_FRESH="$GCBASE/git-edit-gctest-fresh.$$"
	mkdir -p "$GC_FRESH" && echo "gitdir: /nonexistent/repo/.git/worktrees/y" > "$GC_FRESH/.git"
	# Old, but its repo is still there – a paused resolution must never be swept
	local GC_LIVE="$GCBASE/git-edit-gctest-live.$$"
	mkdir -p "$GC_LIVE" && echo "gitdir: $(git rev-parse --absolute-git-dir)" > "$GC_LIVE/.git"
	touch -t 202601010000 "$GC_LIVE"
	# Any mutating invocation runs the sweep
	_ST_RUN -M --text="Sweep trigger" HEAD
	_ST_EQ "the run itself succeeds" "$RC" "0"
	_ST_CHECK "orphaned debris is swept" sh -c "[ ! -d '$GC_DEAD' ]"
	_ST_OUT_HAS "and the sweep is reported, never silent" 'Swept.*orphaned temp worktree'
	_ST_CHECK "a fresh one is left alone" sh -c "[ -d '$GC_FRESH' ]"
	_ST_CHECK "a registered worktree is never swept" sh -c "[ -d '$GC_LIVE' ]"
	rm -rf "$GC_FRESH" "$GC_LIVE"
	git reset -q --hard

	# --- 44. marker-free conflicts must still pause, with history intact ---
	ECHO_E "\e[1;96m[44] marker-free conflicts still pause\e[0m"
	git reset -q --hard
	# Neither of these carries conflict markers, so any attempt to decide a
	# conflict by inspecting the file auto-resolves them the wrong way – which
	# silently reverted a deletion and dropped the commit that made it
	printf 'md one\n' > md2.txt && git add md2.txt && git commit -qm "MD2 base"
	printf 'md two\n' > md2.txt && git add md2.txt && git commit -qm "MD2 middle"
	local MD2_MID=$(git rev-parse HEAD)
	git rm -q md2.txt && git commit -qm "MD2 deletes it"
	_ST_RUN -d -y "$MD2_MID"
	_ST_EQ "modify/delete pauses" "$RC" "2"
	_ST_RUN --abort
	_ST_CHECK "its deleting commit survives" sh -c "git log --format=%s | grep -qx 'MD2 deletes it'"
	_ST_CHECK "and the file is still deleted at the tip" \
		sh -c "! git cat-file -e HEAD:md2.txt 2>/dev/null"
	git reset -q --hard
	# Binary: three stages, no markers, and rerere cannot resolve it either
	printf 'bin\000\001 v1\n' > bin.dat && git add bin.dat && git commit -qm "BIN base"
	printf 'bin\000\002 v2\n' > bin.dat && git add bin.dat && git commit -qm "BIN middle"
	local BIN_MID=$(git rev-parse HEAD)
	printf 'bin\000\003 v3\n' > bin.dat && git add bin.dat && git commit -qm "BIN top"
	_ST_CHECK "the fixture really is binary to git" \
		sh -c "git diff --numstat HEAD~1 HEAD -- bin.dat | grep -q '^-'"
	_ST_RUN -d -y "$BIN_MID"
	_ST_EQ "binary conflict pauses" "$RC" "2"
	_ST_RUN --abort
	_ST_CHECK "no commit was dropped" sh -c "git log --format=%s | grep -qx 'BIN top'"
	git reset -q --hard

	ECHO_E "\e[1;96m[45] fold and reword in one run\e[0m"
	git reset -q --hard
	printf 'at one\n' > at.txt && git add at.txt && git commit -qm "AT base"
	printf 'at two\n' > at.txt && git add at.txt && git commit -qm "AT target"
	local AT_TARGET=$(git rev-parse HEAD)
	printf 'at three\n' > at-other.txt && git add at-other.txt && git commit -qm "AT descendant"
	printf 'at folded\n' > at.txt && git add at.txt
	_ST_RUN --amend-into="$AT_TARGET" --text='AT reworded by the fold'
	_ST_EQ "the run succeeds" "$RC" "0"
	_ST_OUT_HAS "names the subject it replaced" 'replaced:.*AT target'
	# The capture is a pipe, so this doubles as the check that color is gated
	_ST_OUT_LACKS "captured output carries no color" $'\e\\['
	_ST_CHECK "the message landed" sh -c "git log --format=%s | grep -qx 'AT reworded by the fold'"
	_ST_CHECK "and replaced the old one" sh -c "! git log --format=%s | grep -qx 'AT target'"
	_ST_CHECK "the fold landed in that same commit" \
		sh -c "git show HEAD~1:at.txt | grep -qx 'at folded'"
	_ST_CHECK "the descendant survives" sh -c "git log --format=%s | grep -qx 'AT descendant'"
	_ST_CHECK "nothing is left staged" sh -c "git diff --cached --quiet"
	# Without a message the fold must leave the subject exactly as it was
	git reset -q --hard
	printf 'at plain\n' > at.txt && git add at.txt
	_ST_RUN --amend-into=HEAD~1
	_ST_CHECK "a fold without --text keeps the subject" \
		sh -c "git log --format=%s | grep -qx 'AT reworded by the fold'"
	_ST_OUT_LACKS "and claims no replacement" 'replaced:'
	git reset -q --hard

	# A message is part of the fold's definition – the replay already carries
	# it, so one arriving at --continue has to be refused rather than dropped
	printf 'atc base\n' > atc.txt && git add atc.txt && git commit -qm "ATC base"
	printf 'atc mid\n' > atc.txt && git add atc.txt && git commit -qm "ATC target"
	local ATC_TARGET=$(git rev-parse HEAD)
	printf 'atc top\n' > atc.txt && git add atc.txt && git commit -qm "ATC top"
	printf 'atc folded\n' > atc.txt && git add atc.txt
	_ST_RUN --amend-into="$ATC_TARGET"
	_ST_EQ "a conflicting fold pauses" "$RC" "2"
	_ST_RUN --continue --text='too late'
	_ST_OUT_HAS "--text on --continue is refused, not ignored" 'takes --text up front'
	_ST_RUN --abort
	_ST_CHECK "abort leaves the branch intact" sh -c "git log --format=%s | grep -qx 'ATC top'"
	git reset -q --hard

	# A resolution that empties the replayed commit shortens the chain, so an
	# offset from the new tip names a commit the fold never touched
	printf 'ae base\n' > ae.txt && git add ae.txt && git commit -qm "AE base"
	printf 'ae mid\n' > ae.txt && git add ae.txt && git commit -qm "AE target"
	local AE_TARGET=$(git rev-parse HEAD)
	printf 'ae top\n' > ae.txt && git add ae.txt && git commit -qm "AE top"
	printf 'ae folded\n' > ae.txt && git add ae.txt
	_ST_RUN --amend-into="$AE_TARGET"
	local AE_WT=$(echo "$OUT" | sed -n 's/^git-edit: conflict — resolve in \([^ ]*\).*/\1/p' | head -1)
	local AE_ROUNDS=0
	while [ -n "$AE_WT" ] && [ -d "$AE_WT" ] && [ $AE_ROUNDS -lt 5 ]; do
		AE_ROUNDS=$((AE_ROUNDS+1))
		printf 'ae folded\n' > "$AE_WT/ae.txt"
		git -C "$AE_WT" add ae.txt
		_ST_RUN --continue
		AE_WT=$(echo "$OUT" | sed -n 's/^git-edit: conflict — resolve in \([^ ]*\).*/\1/p' | head -1)
	done
	_ST_EQ "the fold settles" "$RC" "0"
	_ST_CHECK "a commit really was dropped as empty" \
		sh -c "! git log --format=%s | grep -qx 'AE top'"
	_ST_OUT_HAS "the summary names the commit folded into" 'AE target'
	_ST_OUT_LACKS "not the one below it" 'Amended commit:.*AE base'
	git reset -q --hard

	ECHO_E "\e[1;96m[46] replanting a branch onto a moved upstream\e[0m"
	git reset -q --hard
	git checkout -q -B onto-main
	printf 'om base\n' > om.txt && git add om.txt && git commit -qm "OM base"
	git checkout -q -b onto-feature
	printf 'of one\n' > of1.txt && git add of1.txt && git commit -qm "OF one"
	printf 'of two\n' > of2.txt && git add of2.txt && git commit -qm "OF two"
	git checkout -q onto-main
	printf 'om next\n' > om2.txt && git add om2.txt && git commit -qm "OM next"
	git checkout -q onto-feature
	_ST_RUN --onto=onto-main
	_ST_EQ "the replant succeeds" "$RC" "0"
	_ST_CHECK "the branch now sits on the upstream tip" \
		sh -c "git merge-base --is-ancestor onto-main onto-feature"
	_ST_CHECK "and still carries its own commits" \
		sh -c "test \$(git rev-list --count onto-main..onto-feature) -eq 2"
	_ST_OUT_HAS "reports what landed" 'Replanted 2 of 2'
	# The branch moved under this checkout and a replant changes its content –
	# left stale, every commit the upstream gained reads as a local deletion
	_ST_CHECK "the checkout came along" sh -c "test -f om2.txt"
	_ST_CHECK "and reports nothing pending" sh -c "git diff --quiet && git diff --cached --quiet"
	_ST_OUT_HAS "which is stated, not left to be discovered" 'Checkout updated'
	_ST_RUN --onto=onto-main
	_ST_OUT_HAS "a second run is a no-op" 'Already on top of'

	# The case the manual flow exists for: a rewrite orphans the fork point,
	# so plain merge-base answers with a far older ancestor and would replay
	# commits the upstream already carries
	git checkout -q onto-main
	_ST_RUN -M --text='OM base, reworded' onto-main~1
	git checkout -q -B onto-orphan onto-feature
	_ST_CHECK "the fork point really is orphaned" \
		sh -c "! git merge-base --is-ancestor \$(git rev-parse onto-orphan~2) onto-main"
	_ST_RUN --onto=onto-main
	_ST_EQ "the orphaned replant succeeds" "$RC" "0"
	_ST_OUT_HAS "and says the fork was recovered" 'orphaned by a rewrite'
	_ST_CHECK "no upstream commit was replayed onto the branch" \
		sh -c "test \$(git log --format=%s onto-main..onto-orphan | grep -c '^OM ') -eq 0"

	# A commit the upstream already carries by patch id is dropped, not lost –
	# and the summary has to say so, or the shorter branch reads as lost work
	git checkout -q -B onto-dup onto-main
	printf 'dup work\n' > dup.txt && git add dup.txt && git commit -qm "Dup on branch"
	printf 'own\n' > own.txt && git add own.txt && git commit -qm "Own work"
	git checkout -q onto-main
	printf 'dup work\n' > dup.txt && git add dup.txt && git commit -qm "Dup landed upstream"
	git checkout -q onto-dup
	_ST_RUN --onto=onto-main
	_ST_OUT_HAS "duplicates are named before the replay" 'already on onto-main'
	_ST_OUT_HAS "and counted afterwards" 'dropped as already upstream'
	_ST_CHECK "the branch keeps only its own commit" \
		sh -c "test \$(git rev-list --count onto-main..onto-dup) -eq 1"

	# A replant rewrites its whole span, so it owes the same guards every other
	# rewriting mode applies – it reached the branch without them at first
	git checkout -q -B onto-pushed onto-main
	printf 'op work\n' > op.txt && git add op.txt && git commit -qm "OP pushed"
	git push -q origin onto-pushed 2>/dev/null
	git checkout -q onto-main
	printf 'om third\n' > om3.txt && git add om3.txt && git commit -qm "OM third"
	git checkout -q onto-pushed
	_ST_RUN --onto=onto-main
	_ST_EQ "a pushed span is refused" "$RC" "1"
	_ST_OUT_HAS "naming the reason" 'already pushed'
	_ST_RUN --onto=onto-main --allow-pushed
	_ST_EQ "--allow-pushed overrides it" "$RC" "0"

	# A merge in the span would be flattened by the replay, silently
	git checkout -q -B onto-merge onto-main
	printf 'oms\n' > oms.txt && git add oms.txt && git commit -qm "OMS side"
	git checkout -q -B onto-mergebase onto-main~1
	printf 'omb\n' > omb.txt && git add omb.txt && git commit -qm "OMB base"
	git merge -q --no-ff -m "OMB merge" onto-merge 2>/dev/null
	git checkout -q onto-main
	printf 'om fourth\n' > om4.txt && git add om4.txt && git commit -qm "OM fourth"
	git checkout -q onto-mergebase
	_ST_RUN --onto=onto-main
	_ST_EQ "a merge in the span is refused" "$RC" "1"
	_ST_OUT_HAS "rather than flattened silently" 'contains a merge commit'

	# A replant that would strand the checkout must refuse before the CAS, not
	# move the branch and then decline to follow
	git checkout -q -B onto-dirty onto-main
	printf 'od branch\n' > od.txt && git add od.txt && git commit -qm "OD on branch"
	git checkout -q onto-main
	printf 'od upstream\n' > od.txt && git add od.txt && git commit -qm "OD upstream"
	git checkout -q onto-dirty
	local OD_BEFORE=$(git rev-parse onto-dirty)
	printf 'od uncommitted\n' > od.txt
	_ST_RUN --onto=onto-main
	_ST_EQ "a replant onto dirty paths is refused" "$RC" "1"
	_ST_OUT_HAS "naming the blocked path" 'od.txt'
	_ST_EQ "and the branch never moved" "$(git rev-parse onto-dirty)" "$OD_BEFORE"
	_ST_CHECK "with the uncommitted work intact" sh -c "grep -qx 'od uncommitted' od.txt"
	git checkout -q -- od.txt 2>/dev/null
	git reset -q --hard

	# Dirt on a path the replant does not touch is no reason to refuse. A fresh
	# branch, since od.txt differs on both sides and would conflict on its own
	# merits – which would prove nothing about the guard.
	git checkout -q -B onto-clean onto-main
	printf 'oc branch\n' > oc.txt && git add oc.txt && git commit -qm "OC on branch"
	git checkout -q onto-main
	printf 'om fifth\n' > om5.txt && git add om5.txt && git commit -qm "OM fifth"
	git checkout -q onto-clean
	printf 'oc unrelated\n' > oc-unrelated.txt
	_ST_RUN --onto=onto-main
	_ST_EQ "unrelated dirt does not block it" "$RC" "0"
	_ST_CHECK "and that file survives" sh -c "grep -qx 'oc unrelated' oc-unrelated.txt"
	rm -f oc-unrelated.txt
	git reset -q --hard

	# --skip belongs to this mode alone; elsewhere the paused commit is the point
	git checkout -q -B onto-skip onto-main
	_ST_RUN --skip
	_ST_EQ "a skip with nothing in flight is refused" "$RC" "1"
	git checkout -q onto-main
	git push -q origin --delete onto-pushed 2>/dev/null
	git branch -q -D onto-feature onto-orphan onto-dup onto-skip onto-pushed onto-merge onto-mergebase onto-dirty onto-clean 2>/dev/null
	git checkout -q main
	git reset -q --hard

	ECHO_E "\e[1;96m[47] linking gitignored paths into a pause worktree\e[0m"
	git reset -q --hard
	printf 'wl one\n' > wl.txt && git add wl.txt && git commit -qm "WL one"
	printf 'wl two\n' > wl.txt && git add wl.txt && git commit -qm "WL two"
	mkdir -p node_modules/dep && printf 'installed\n' > node_modules/dep/index.js
	_ST_RUN HEAD~1
	local WL_WT=$(echo "$OUT" | sed -n 's/.*paused — edit [^ ]* in \([^;]*\);.*/\1/p')
	_ST_CHECK "nothing is linked without the config" sh -c "test ! -e '$WL_WT/node_modules'"
	_ST_RUN --abort

	printf 'node_modules\n' > .gitignore && git add .gitignore && git commit -qm "WL ignore"
	git config --add edit.worktreeLink node_modules
	# Target HEAD, not HEAD~1: the worktree checks out the commit being edited,
	# so its `.gitignore` is the one that decides whether the link is covered
	_ST_RUN HEAD
	WL_WT=$(echo "$OUT" | sed -n 's/.*paused — edit [^ ]* in \([^;]*\);.*/\1/p')
	_ST_OUT_HAS "the link is reported" 'Linked into the worktree'
	_ST_CHECK "and resolves to the origin's copy" \
		sh -c "test -f '$WL_WT/node_modules/dep/index.js'"
	_ST_CHECK "as a symlink, not a copy" sh -c "test -L '$WL_WT/node_modules'"
	_ST_OUT_LACKS "an ignored path draws no warning" 'is not ignored here'
	_ST_RUN --abort

	# A directory pattern doesn't match a symlink, so the link lands untracked
	# where the directory would have been ignored – and the amend sweeps it in
	printf 'node_modules/\n' > .gitignore && git add .gitignore && git commit -qm "WL slash"
	_ST_RUN HEAD
	_ST_OUT_HAS "a trailing-slash pattern is called out" 'is not ignored here'
	# …and the amend must not commit the link anyway – it is this script's
	# scaffolding, and the warning alone still left it in history
	local WL_WT2=$(echo "$OUT" | sed -n 's/.*paused — edit [^ ]* in \([^;]*\);.*/\1/p')
	printf 'wl edited\n' > "$WL_WT2/wl.txt"
	_ST_RUN --continue
	_ST_CHECK "the link is not swept into the commit" \
		sh -c "! git show HEAD --stat --format= | grep -q node_modules"
	_ST_CHECK "while the real edit landed" \
		sh -c "git show HEAD:wl.txt | grep -qx 'wl edited'"
	_ST_RUN --undo

	# A nested path needs its parent created, or the link silently never happens
	git config --unset-all edit.worktreeLink
	mkdir -p vendor/deps && printf 'dep\n' > vendor/deps/lib.js
	printf 'node_modules\nvendor/deps\n' > .gitignore && git add .gitignore && git commit -qm "WL nested ignore"
	git config --add edit.worktreeLink vendor/deps
	_ST_RUN HEAD
	local WL_WT3=$(echo "$OUT" | sed -n 's/.*paused — edit [^ ]* in \([^;]*\);.*/\1/p')
	_ST_CHECK "a nested path is linked, not silently skipped" \
		sh -c "test -f '$WL_WT3/vendor/deps/lib.js'"
	_ST_OUT_LACKS "and reports no failure" 'Could not link'
	_ST_RUN --abort
	rm -rf vendor
	git config --unset-all edit.worktreeLink
	rm -rf node_modules
	git reset -q --hard

	ECHO_E "\e[1;96m[48] documented guarantees that had no assertion\e[0m"
	git reset -q --hard
	printf 'dg one\n' > dg.txt && git add dg.txt && git commit -qm "DG one"
	printf 'dg two\n' > dg.txt && git add dg.txt && git commit -qm "DG two"
	printf 'dg three\n' > dg.txt && git add dg.txt && git commit -qm "DG three"

	# "no checkout, no stash, no rebase – the working tree is physically
	# untouched (file inodes and mtimes preserved)"
	local -a STATFMT
	if stat -f '%i' . >/dev/null 2>&1; then
		STATFMT=(-f '%i %m')
	else
		STATFMT=(-c '%i %Y')
	fi
	local DG_BEFORE=$(stat "${STATFMT[@]}" dg.txt 2>/dev/null)
	_ST_RUN -M --text='DG two reworded' HEAD~1
	_ST_EQ "reword leaves the file's inode and mtime alone" \
		"$(stat "${STATFMT[@]}" dg.txt 2>/dev/null)" "$DG_BEFORE"

	# "Every completed operation is attributed in the ref's own reflog"
	_ST_CHECK "the ref's reflog attributes the operation" \
		sh -c "git reflog -1 --format=%gs | grep -q '^git edit: reword '"

	# "Set GIT_EDIT_NO_RESOLVE=1 to disable resolution entirely and have every
	# unreachable commit refused". The sha has to be captured before the
	# rewrite that orphans it – taken after, it is simply current.
	printf 'st one\n' > st.txt && git add st.txt && git commit -qm "ST one"
	printf 'st two\n' > st.txt && git add st.txt && git commit -qm "ST two"
	local ST_TARGET=$(git rev-parse HEAD)
	printf 'st three\n' > st.txt && git add st.txt && git commit -qm "ST three"
	_ST_RUN -M --text='ST two reworded' "$ST_TARGET"
	_ST_CHECK "the sha really is orphaned now" \
		sh -c "! git merge-base --is-ancestor $ST_TARGET HEAD 2>/dev/null"
	_ST_RUN -M --text='ST two v3' "$ST_TARGET"
	_ST_OUT_HAS "a stale sha resolves by default" 'was rewritten'
	_ST_RUN --undo
	OUT=$(GIT_EDIT_NO_RESOLVE=1 GIT_EDIT_NO_AUTO_OPEN=1 "$SELF" -M --text='ST two v3' "$ST_TARGET" </dev/null 2>&1)
	RC=$?
	_ST_EQ "GIT_EDIT_NO_RESOLVE refuses it instead" "$RC" "1"
	_ST_OUT_LACKS "and resolves nothing" 'using its current identity'

	# "-C is enabled automatically for the modes that would otherwise touch the
	# main working tree" – and the plumbing modes are left alone. One file per
	# commit, so a drop has nothing to conflict over and can't pause.
	printf 'ai1\n' > ai1.txt && git add ai1.txt && git commit -qm "AI one"
	printf 'ai2\n' > ai2.txt && git add ai2.txt && git commit -qm "AI two"
	printf 'ai3\n' > ai3.txt && git add ai3.txt && git commit -qm "AI three"
	_ST_RUN -d -y HEAD~1
	_ST_EQ "the drop succeeds" "$RC" "0"
	_ST_OUT_HAS "a drop auto-isolates" 'auto-isolating'
	_ST_RUN --undo
	_ST_RUN -M --text='AI three reworded' HEAD
	_ST_OUT_LACKS "a reword does not" 'auto-isolating'
	_ST_RUN --undo
	OUT=$(GIT_EDIT_NO_AUTO_ISOLATE=1 GIT_EDIT_NO_AUTO_OPEN=1 "$SELF" -d -y HEAD~1 </dev/null 2>&1)
	_ST_OUT_LACKS "GIT_EDIT_NO_AUTO_ISOLATE opts out" 'auto-isolating'
	_ST_RUN --undo
	_ST_CHECK "and left nothing in flight" \
		sh -c "! test -f \"\$(git rev-parse --git-common-dir)/git-edit-state\""

	# "The guard is span-scoped, not repo-scoped: operating above the merge
	# stays legal"
	local MG_BASE=$(git rev-parse HEAD)
	git checkout -q -b dg-side HEAD~1
	printf 'dg side\n' > dg-side.txt && git add dg-side.txt && git commit -qm "DG side"
	git checkout -q main
	git merge -q --no-ff -m "DG merge" dg-side 2>/dev/null
	printf 'dg a\n' > dg-a.txt && git add dg-a.txt && git commit -qm "DG above one"
	printf 'dg b\n' > dg-b.txt && git add dg-b.txt && git commit -qm "DG above two"
	_ST_RUN -d -y HEAD~1
	_ST_EQ "a span above a merge stays legal" "$RC" "0"
	_ST_RUN --undo
	_ST_RUN -d -y "$MG_BASE"
	_ST_OUT_HAS "a span containing one is refused" 'contains a merge commit'
	git branch -q -D dg-side 2>/dev/null
	git reset -q --hard

	# "Color follows the same rule and also honours NO_COLOR and TERM=dumb" –
	# a captured run proves the pipe case, the other two only structurally,
	# since the selftest can never present a TTY to its own sub-invocations
	_ST_CHECK "the color gate covers NO_COLOR and TERM=dumb" \
		sh -c "command grep -q '^if \\[ ! -t 1 \\] || \\[ -n \"\\\$NO_COLOR\" \\] || \\[ \"\\\$TERM\" = \"dumb\" \\]; then' '$SELF'"

	# --- Summary ---
	local TOTAL=$((PASS+FAIL))
	echo ""
	if [ $FAIL -eq 0 ]; then
		PRINT_TEXT "%s" 32 "Selftest: all $TOTAL checks passed."
		# A passing run leaves nothing to inspect, so it takes the scratch repo
		# and every temp worktree anchored to it along – otherwise each run
		# seeds exactly the debris the sweep above exists to clean up
		local WT
		git -C "$TMP" worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p' | \
		while IFS= read -r WT; do
			if [ "$WT" != "$TMP" ]; then
				rm -rf "$WT" 2>/dev/null
			fi
		done
		cd /
		rm -rf "$TMP" 2>/dev/null
		echo "git-edit: ok — selftest $PASS/$TOTAL passed"
		_STATUS_EMITTED=true
		return 0
	else
		PRINT_TEXT "%s" 31 "Selftest: $FAIL of $TOTAL checks FAILED."
		# A failing run keeps both – that tree is the evidence
		PRINT_TEXT "Scratch repo kept for inspection: %s" 33 "$TMP"
		echo "git-edit: error — selftest $FAIL/$TOTAL failed"
		_STATUS_EMITTED=true
		return 1
	fi
}


# ---------------------------------------- ARGUMENT PARSING ----------------------------------------

# Remember full original command line
COMMANDLINE="git edit"
for ARG in "$@"; do
	COMMANDLINE+=" $(printf '%q' "$ARG")"
done

# -D pulls parsed flags out of $@
# -E allows flags/args and positionals to be mixed
# -F says fail if we find a flag that wasn't defined
# (the first dash is automatically handled, so long options are -opt, not --opt)
zmodload zsh/zutil
if ! zparseopts -D -E -F -- {m,-message}=OPT_MESSAGE {M,-reword}=OPT_REWORD {d,-drop}=OPT_DROP {s,-squash}::=OPT_SQUASH {S,-resquash}=OPT_RESQUASH {C,-dir}::=OPT_DIR -exec=OPT_EXEC -amend-into:=OPT_AMEND_INTO -split:=OPT_SPLIT -reorder=OPT_REORDER -onto:=OPT_ONTO -skip=OPT_SKIP -move:=OPT_MOVE -after:=OPT_AFTER -before:=OPT_BEFORE -continue=OPT_CONTINUE -abort=OPT_ABORT -undo=OPT_UNDO -status=OPT_STATUS -selftest=OPT_SELFTEST -allow-pushed=OPT_ALLOW_PUSHED -text:=OPT_TEXT {y,-yes}=OPT_YES {h,-help}=OPT_HELP; then
	USAGE
	PRINT_ERR "Unknown option: $1"
	exit 1
fi

# -h/--help/help
if [[ ${#OPT_HELP} -gt 0 || $1 == "help" ]]; then
	USAGE
	exit 0
fi

# Capture `HEAD` before any modification, for the status trailer's `old_head` field – stays
# empty outside a git repo or in an empty one, where the script fails later on commit
# resolution, so the trailer is never reached
SCRIPT_INITIAL_HEAD=$(git rev-parse HEAD 2>/dev/null)

# Resolves the `--text` value into `TEXT_VALUE` – `--text "msg"` as a separate arg or after
# an `=`, and `--text -` to read stdin, multi-line included
# `zparseopts` splits both into [--text, value], the `=value` form keeping its leading `=`
if [ ${#OPT_TEXT} -gt 0 ]; then
	if [[ ${#OPT_TEXT} -gt 1 ]]; then
		TEXT_VALUE=${OPT_TEXT[2]#=}
	fi
	if [ "$TEXT_VALUE" = "-" ]; then
		TEXT_VALUE=$(cat)
	fi
	# Pass through `git stripspace` so it matches what the editor flow produces
	TEXT_VALUE=$(echo "$TEXT_VALUE" | git stripspace --strip-comments)
	if [ -z "$TEXT_VALUE" ]; then
		PRINT_ERR "--text produced an empty message after stripping"
		exit 1
	fi
fi

# --continue / --abort dispatch – resume or cancel an in-flight operation.
# These mirror `git rebase --continue` / `--abort`. They short-circuit before
# any of the normal argument validation runs.
if [ ${#OPT_CONTINUE} -gt 0 ] && [ ${#OPT_ABORT} -gt 0 ]; then
	PRINT_ERR "--continue and --abort cannot be combined"
	exit 1
fi
# --skip resumes too, just past the current commit rather than through it
if [ ${#OPT_SKIP} -gt 0 ]; then
	if [ ${#OPT_ABORT} -gt 0 ]; then
		PRINT_ERR "--skip and --abort cannot be combined"
		exit 1
	fi
	OPT_CONTINUE=(--continue)
fi
if [ ${#OPT_CONTINUE} -gt 0 ]; then
	_LOAD_STATE
	_REANCHOR_INITIAL_HEAD
	# Only a replant has commits worth stepping over – elsewhere the paused
	# commit is the whole point, so skipping it would quietly discard the work
	if [ ${#OPT_SKIP} -gt 0 ] && [ "$STATE_OPERATION" != "onto" ]; then
		PRINT_ERR "--skip applies to --onto only; '$STATE_OPERATION' has no commit to step over"
		exit 1
	fi
	case "$STATE_OPERATION" in
		amend-into) _CONTINUE_AMEND_INTO ;;
		reorder)    _CONTINUE_REORDER ;;
		onto)       _CONTINUE_ONTO ;;
		rebase)     _CONTINUE_REBASE ;;
		edit)       _CONTINUE_EDIT ;;
		split)      _CONTINUE_SPLIT ;;
		*) PRINT_ERR "Unknown saved operation: '$STATE_OPERATION'"; exit 1 ;;
	esac
	exit 0
fi
if [ ${#OPT_ABORT} -gt 0 ]; then
	_LOAD_STATE
	_REANCHOR_INITIAL_HEAD
	case "$STATE_OPERATION" in
		amend-into) _ABORT_AMEND_INTO ;;
		reorder)    _ABORT_REORDER ;;
		onto)       _ABORT_ONTO ;;
		rebase)     _ABORT_REBASE ;;
		edit)       _ABORT_EDIT ;;
		split)      _ABORT_SPLIT ;;
		*) PRINT_ERR "Unknown saved operation: '$STATE_OPERATION'"; exit 1 ;;
	esac
	exit 0
fi

# `--undo`, `--status` and `--selftest` are standalone commands – no positionals, no mode
# flags, dispatched before any commit parsing, and stray arguments are refused rather than
# ignored, since `--undo <sha>` would otherwise undo whatever happens to be last
if [ ${#OPT_UNDO} -gt 0 ] || [ ${#OPT_STATUS} -gt 0 ] || [ ${#OPT_SELFTEST} -gt 0 ]; then
	if [ $# -gt 0 ]; then
		USAGE
		PRINT_ERR "--undo/--status/--selftest take no arguments (got: $*)"
		exit 1
	fi
fi
if [ ${#OPT_UNDO} -gt 0 ]; then
	if _STATE_EXISTS; then
		PRINT_ERR "An operation is in flight – finish it with --continue or --abort before undoing"
		exit 1
	fi
	GIT_UNDO
	exit 0
fi
if [ ${#OPT_STATUS} -gt 0 ]; then
	GIT_STATUS_REPORT
	exit 0
fi
if [ ${#OPT_SELFTEST} -gt 0 ]; then
	# ${0:A} resolves the running script's absolute path at top level (inside
	# functions zsh rebinds $0 to the function name)
	GIT_SELFTEST "${0:A}"
	exit $?
fi

# Past this point every path mutates history, and the standalone commands that
# resolve a pause (--continue/--abort/--undo/--status) have already exited –
# which also keeps the sweep off the read-only reporting paths
_GC_ORPHANED_WORKTREES
_REQUIRE_NO_INFLIGHT

# Extract the `-C`/`--dir` value – `zparseopts` with `::` greedily consumes the next word
# unless it starts with `-`, so `git edit -C HEAD~1` would take `HEAD~1` as the path, and
# without an `=` a value parsing as a git ref is re-injected as a positional instead
if [ ${#OPT_DIR} -gt 0 ]; then
	DIR_HAS_EQUALS=false
	if [[ "${OPT_DIR[1]}" == *"="* ]]; then
		DIR_HAS_EQUALS=true
		WORKTREE_DIR=${OPT_DIR[1]#*=}
	elif [[ "${OPT_DIR[1]}" == "-C"?* ]]; then
		WORKTREE_DIR=${OPT_DIR[1]#-C}
	elif [[ "${OPT_DIR[1]}" == "--dir"?* ]]; then
		WORKTREE_DIR=${OPT_DIR[1]#--dir}
	fi

	if [ "$DIR_HAS_EQUALS" = false ] && [ -n "$WORKTREE_DIR" ]; then
		IS_REF=false
		if [[ "$WORKTREE_DIR" == *".."* && "$WORKTREE_DIR" != *"..."* ]]; then
			git rev-list "$WORKTREE_DIR" >/dev/null 2>&1 && IS_REF=true
		elif git rev-parse --quiet --verify "$WORKTREE_DIR" >/dev/null 2>&1; then
			IS_REF=true
		fi
		if [ "$IS_REF" = true ]; then
			set -- "$WORKTREE_DIR" "$@"
			WORKTREE_DIR=""
		fi
	fi
fi

# Extract the `-s`/`--squash` value, applying the same re-injection heuristic as `-C` – its
# argument was once required and greedily consumed the next word, so `-s HEAD~2..HEAD`
# read as a target and errored, where now `-s=<target>` is the only explicit form
if [ ${#OPT_SQUASH} -gt 0 ]; then
	SQUASH_HAS_EQUALS=false
	if [[ "${OPT_SQUASH[1]}" == *"="* ]]; then
		SQUASH_HAS_EQUALS=true
		TARGET=${OPT_SQUASH[1]#*=}
	elif [[ "${OPT_SQUASH[1]}" == "-s"?* ]]; then
		TARGET=${OPT_SQUASH[1]#-s}
	elif [[ "${OPT_SQUASH[1]}" == "--squash"?* ]]; then
		TARGET=${OPT_SQUASH[1]#--squash}
	fi

	if [ "$SQUASH_HAS_EQUALS" = false ] && [ -n "$TARGET" ]; then
		IS_REF=false
		if [[ "$TARGET" == *".."* && "$TARGET" != *"..."* ]]; then
			git rev-list "$TARGET" >/dev/null 2>&1 && IS_REF=true
		elif git rev-parse --quiet --verify "$TARGET" >/dev/null 2>&1; then
			IS_REF=true
		fi
		if [ "$IS_REF" = true ]; then
			set -- "$TARGET" "$@"
			TARGET=""
		fi
	fi
fi

# Conflict checks
if [ ${#OPT_MESSAGE} -gt 0 -a ${#OPT_DROP} -gt 0 ]; then
	USAGE
	PRINT_ERR "Options -m/--message and -d/--drop cannot be combined"
	exit 1
fi
if [ ${#OPT_DROP} -gt 0 -a ${#OPT_SQUASH} -gt 0 ]; then
	USAGE
	PRINT_ERR "Options -d/--drop and -s/--squash cannot be combined"
	exit 1
fi
if [ ${#OPT_REWORD} -gt 0 ] && [ ${#OPT_MESSAGE} -gt 0 -o ${#OPT_DROP} -gt 0 -o ${#OPT_SQUASH} -gt 0 -o ${#OPT_DIR} -gt 0 -o ${#OPT_RESQUASH} -gt 0 ]; then
	USAGE
	PRINT_ERR "Option -M/--reword cannot be combined with -m/-d/-s/-S/-C (reword is message-only and works without touching the working tree)"
	exit 1
fi
if [ ${#OPT_RESQUASH} -gt 0 ] && [ ${#OPT_DROP} -gt 0 -o ${#OPT_SQUASH} -gt 0 -o ${#OPT_DIR} -gt 0 ]; then
	USAGE
	PRINT_ERR "Option -S/--resquash cannot be combined with -d/-s/-C (resquash uses plumbing only; for non-contiguous squashes use -s with -C)"
	exit 1
fi
if [ ${#OPT_EXEC} -gt 0 ] && [ ${#OPT_MESSAGE} -gt 0 -o ${#OPT_REWORD} -gt 0 -o ${#OPT_DROP} -gt 0 -o ${#OPT_SQUASH} -gt 0 -o ${#OPT_RESQUASH} -gt 0 -o ${#OPT_DIR} -gt 0 -o ${#OPT_AMEND_INTO} -gt 0 -o ${#OPT_SPLIT} -gt 0 -o ${#OPT_REORDER} -gt 0 -o ${#OPT_MOVE} -gt 0 ]; then
	USAGE
	PRINT_ERR "Option --exec cannot be combined with other modes (--exec is its own mode and manages its own isolated worktree)"
	exit 1
fi
if [ ${#OPT_AMEND_INTO} -gt 0 ] && [ ${#OPT_MESSAGE} -gt 0 -o ${#OPT_REWORD} -gt 0 -o ${#OPT_DROP} -gt 0 -o ${#OPT_SQUASH} -gt 0 -o ${#OPT_RESQUASH} -gt 0 -o ${#OPT_DIR} -gt 0 -o ${#OPT_EXEC} -gt 0 -o ${#OPT_SPLIT} -gt 0 -o ${#OPT_MOVE} -gt 0 ]; then
	USAGE
	PRINT_ERR "Option --amend-into cannot be combined with other modes (it folds staged changes into <sha> via fixup+autosquash)"
	if [ ${#OPT_REWORD} -gt 0 ]; then
		ECHO_E "\e[0;31m  To fold and reword at once: git edit --amend-into=<sha> --text=\"…\"\e[0m" >&2
		ECHO_E "\e[0;31m  To reword only: git edit -M --text=\"…\" <sha>\e[0m" >&2
	fi
	exit 1
fi
if [ ${#OPT_REORDER} -gt 0 ] && [ ${#OPT_MESSAGE} -gt 0 -o ${#OPT_REWORD} -gt 0 -o ${#OPT_DROP} -gt 0 -o ${#OPT_SQUASH} -gt 0 -o ${#OPT_RESQUASH} -gt 0 -o ${#OPT_DIR} -gt 0 -o ${#OPT_EXEC} -gt 0 -o ${#OPT_AMEND_INTO} -gt 0 -o ${#OPT_SPLIT} -gt 0 -o ${#OPT_MOVE} -gt 0 ]; then
	USAGE
	PRINT_ERR "Option --reorder cannot be combined with other modes (it manages its own isolated worktree)"
	exit 1
fi
if [ ${#OPT_ONTO} -gt 0 ] && [ ${#OPT_MESSAGE} -gt 0 -o ${#OPT_REWORD} -gt 0 -o ${#OPT_DROP} -gt 0 -o ${#OPT_SQUASH} -gt 0 -o ${#OPT_RESQUASH} -gt 0 -o ${#OPT_DIR} -gt 0 -o ${#OPT_EXEC} -gt 0 -o ${#OPT_AMEND_INTO} -gt 0 -o ${#OPT_SPLIT} -gt 0 -o ${#OPT_REORDER} -gt 0 -o ${#OPT_MOVE} -gt 0 -o -n "$TEXT_VALUE" ]; then
	USAGE
	PRINT_ERR "Option --onto cannot be combined with other modes (it replays the whole branch, not a named commit)"
	exit 1
fi
if [ ${#OPT_MOVE} -eq 0 ] && [ ${#OPT_AFTER} -gt 0 -o ${#OPT_BEFORE} -gt 0 ]; then
	USAGE
	PRINT_ERR "--after/--before only apply to --move"
	exit 1
fi
# `--text` is incompatible with `-d` and `--exec` – the full check against the resolved
# action, implicit squash included, happens after action determination, so it also
# catches `--text` with edit mode
if [ ${#OPT_TEXT} -gt 0 ] && [ ${#OPT_DROP} -gt 0 ]; then
	USAGE
	PRINT_ERR "Option --text doesn't apply to -d/--drop"
	exit 1
fi
if [ ${#OPT_TEXT} -gt 0 ] && [ ${#OPT_EXEC} -gt 0 ]; then
	USAGE
	PRINT_ERR "Option --text doesn't apply to --exec"
	exit 1
fi


# --exec short-circuits everything below: positional args are the wrapped
# command (not commits to parse). Set up an isolated temp worktree, run the
# command there, and update the original branch ref atomically if HEAD changed.
# This is the "raw-git escape hatch" — any command (rebase, amend, etc.) can
# run safely without touching the main checkout that other sessions are using.
if [ ${#OPT_EXEC} -gt 0 ]; then
	# zparseopts doesn't consume the `--` separator, just stops parsing at it.
	# Strip it so $@ contains only the wrapped command.
	if [ "$1" = "--" ]; then
		shift
	fi
	if [ $# -eq 0 ]; then
		USAGE
		PRINT_ERR "--exec requires a command (use -- to separate it from flags)"
		exit 1
	fi
	GIT_EXEC "$@"
	PRINT_COMPLETED "$EXEC_NEW_HEAD" "$EXEC_REF" "$EXEC_CHANGED"
	exit 0
fi

# `--move` dispatches early – repositions one commit directly after or before an anchor by
# computing the minimal span and desired order, then delegating to the reorder machinery,
# so span derivation, the error-prone part of hand-rolled calls, is owned here
if [ ${#OPT_MOVE} -gt 0 ]; then
	MOVE_SHA=""
	if [[ ${#OPT_MOVE} -gt 1 && -n "${OPT_MOVE[2]}" ]]; then
		MOVE_SHA="${OPT_MOVE[2]#=}"
	fi
	if [ -z "$MOVE_SHA" ]; then
		USAGE
		PRINT_ERR "--move requires a <sha> value (e.g., --move=abc123)"
		exit 1
	fi
	if [ ${#OPT_MESSAGE} -gt 0 -o ${#OPT_REWORD} -gt 0 -o ${#OPT_DROP} -gt 0 -o ${#OPT_SQUASH} -gt 0 -o ${#OPT_RESQUASH} -gt 0 -o ${#OPT_DIR} -gt 0 -o ${#OPT_EXEC} -gt 0 -o ${#OPT_AMEND_INTO} -gt 0 -o ${#OPT_SPLIT} -gt 0 -o ${#OPT_REORDER} -gt 0 -o -n "$TEXT_VALUE" ]; then
		USAGE
		PRINT_ERR "Option --move cannot be combined with other modes"
		exit 1
	fi
	if [ ${#OPT_AFTER} -gt 0 ] && [ ${#OPT_BEFORE} -gt 0 ]; then
		PRINT_ERR "--move takes exactly one of --after=<sha> or --before=<sha>, not both"
		exit 1
	fi
	MOVE_ANCHOR=""
	MOVE_KIND=""
	if [ ${#OPT_AFTER} -gt 0 ]; then
		MOVE_ANCHOR="${OPT_AFTER[2]#=}"
		MOVE_KIND="after"
	elif [ ${#OPT_BEFORE} -gt 0 ]; then
		MOVE_ANCHOR="${OPT_BEFORE[2]#=}"
		MOVE_KIND="before"
	fi
	if [ -z "$MOVE_ANCHOR" ]; then
		USAGE
		PRINT_ERR "--move requires a destination: --after=<sha> or --before=<sha>"
		exit 1
	fi
	if [ $# -gt 0 ]; then
		USAGE
		PRINT_ERR "--move takes no positional arguments (commit and destination are flag values)"
		exit 1
	fi
	if ! git rev-parse --quiet --verify "$MOVE_SHA^{commit}" >/dev/null 2>&1; then
		PRINT_ERR "Unknown <sha>: $MOVE_SHA"
		exit 1
	fi
	if ! git rev-parse --quiet --verify "$MOVE_ANCHOR^{commit}" >/dev/null 2>&1; then
		PRINT_ERR "Unknown <sha>: $MOVE_ANCHOR"
		exit 1
	fi
	# Both routes resolve stale SHAs like any other target
	_GUARD_REACHABLE "$MOVE_SHA"
	MOVE_SHA=$(git rev-parse "$_RESOLVED_SHA^{commit}")
	_GUARD_REACHABLE "$MOVE_ANCHOR"
	MOVE_ANCHOR=$(git rev-parse "$_RESOLVED_SHA^{commit}")
	if [ "$MOVE_SHA" = "$MOVE_ANCHOR" ]; then
		PRINT_ERR "--move commit and its --$MOVE_KIND anchor are the same commit"
		exit 1
	fi
	# Already in position – an honest no-op instead of an empty rebase
	if { [ "$MOVE_KIND" = "after" ] && [ "$(git rev-parse "$MOVE_SHA^" 2>/dev/null)" = "$MOVE_ANCHOR" ]; } || \
	   { [ "$MOVE_KIND" = "before" ] && [ "$(git rev-parse "$MOVE_ANCHOR^" 2>/dev/null)" = "$MOVE_SHA" ]; } then
		PRINT_TEXT "Commit %s already sits directly $MOVE_KIND %s – nothing to move" 36 "${MOVE_SHA:0:7}" "${MOVE_ANCHOR:0:7}"
		PRINT_COMPLETED "$(git rev-parse HEAD)" "$(_CURRENT_REF)" false
		exit 0
	fi
	# Minimal span: both endpoints inclusive, oldest-first – contiguous by
	# construction, so the reorder pre-flight checks pass or refuse cleanly
	# (merge in span, pushed base)
	if git merge-base --is-ancestor "$MOVE_SHA" "$MOVE_ANCHOR" 2>/dev/null; then
		MOVE_SPAN_OLD=$MOVE_SHA
		MOVE_SPAN_NEW=$MOVE_ANCHOR
	elif git merge-base --is-ancestor "$MOVE_ANCHOR" "$MOVE_SHA" 2>/dev/null; then
		MOVE_SPAN_OLD=$MOVE_ANCHOR
		MOVE_SPAN_NEW=$MOVE_SHA
	else
		PRINT_ERR "Commits ${MOVE_SHA:0:7} and ${MOVE_ANCHOR:0:7} are not on one line of history"
		exit 1
	fi
	if git rev-parse --verify -q "$MOVE_SPAN_OLD^" >/dev/null 2>&1; then
		MOVE_SPAN=($(git rev-list --reverse "$MOVE_SPAN_OLD^..$MOVE_SPAN_NEW"))
	else
		MOVE_SPAN=($(git rev-list --reverse "$MOVE_SPAN_NEW"))
	fi
	# Desired order: span minus the moved commit, re-inserted at the anchor
	COMMITS_DESIRED=()
	for MOVE_STEP in "${MOVE_SPAN[@]}"; do
		if [ "$MOVE_STEP" = "$MOVE_SHA" ]; then
			continue
		fi
		if [ "$MOVE_STEP" = "$MOVE_ANCHOR" ] && [ "$MOVE_KIND" = "before" ]; then
			COMMITS_DESIRED+=("$MOVE_SHA")
		fi
		COMMITS_DESIRED+=("$MOVE_STEP")
		if [ "$MOVE_STEP" = "$MOVE_ANCHOR" ] && [ "$MOVE_KIND" = "after" ]; then
			COMMITS_DESIRED+=("$MOVE_SHA")
		fi
	done
	COMMITS=("${MOVE_SPAN[@]}")
	PRINT_ACTION "Moving %s $MOVE_KIND %s..." "$MOVE_SHA" "$MOVE_ANCHOR"
	GIT_REORDER
	PRINT_COMPLETED "$REORDER_NEW_HEAD" "$REORDER_REF" true
	exit 0
fi

# --onto dispatches immediately: it acts on the current branch as a whole, so
# positional commits would have nothing to name
if [ ${#OPT_ONTO} -gt 0 ]; then
	if [[ ${#OPT_ONTO} -gt 1 && -n "${OPT_ONTO[2]}" ]]; then
		ONTO_UPSTREAM="${OPT_ONTO[2]#=}"
	fi
	if [ -z "$ONTO_UPSTREAM" ]; then
		USAGE
		PRINT_ERR "--onto requires an upstream (e.g., --onto=main)"
		exit 1
	fi
	if [ $# -gt 0 ]; then
		USAGE
		PRINT_ERR "--onto takes no <commit> arguments – it replants the current branch"
		exit 1
	fi
	GIT_ONTO
	PRINT_COMPLETED "$ONTO_NEW_HEAD" "$ONTO_REF" true
	exit 0
fi

# `--amend-into` dispatches immediately too – the target SHA came from the flag's value
# rather than positional args, which this mode leaves unused since the content comes
# from the staged index in main
if [ ${#OPT_AMEND_INTO} -gt 0 ]; then
	if [[ ${#OPT_AMEND_INTO} -gt 1 && -n "${OPT_AMEND_INTO[2]}" ]]; then
		AMEND_INTO_TARGET="${OPT_AMEND_INTO[2]#=}"
	fi
	if [ -z "$AMEND_INTO_TARGET" ]; then
		USAGE
		PRINT_ERR "--amend-into requires a <sha> value (e.g., --amend-into=abc123)"
		exit 1
	fi
	# Positional args narrow which staged paths get folded, the rest staying staged – without
	# them the whole index folds, as before
	if [ "$1" = "--" ]; then
		shift
	fi
	AMEND_PATHSPECS=("$@")
	# `auto` resolves to the newest unpushed commit touching the staged paths
	if [ "$AMEND_INTO_TARGET" = "auto" ]; then
		_RESOLVE_AMEND_TARGET
	fi
	# Verify target is a valid commit ref
	if ! git rev-parse --quiet --verify "$AMEND_INTO_TARGET^{commit}" >/dev/null 2>&1; then
		PRINT_ERR "Unknown <sha>: $AMEND_INTO_TARGET"
		exit 1
	fi
	PRINT_ACTION "Amending staged changes into %s..." "$AMEND_INTO_TARGET"
	GIT_AMEND_INTO
	PRINT_COMPLETED "$AMEND_NEW_HEAD" "$AMEND_REF" true
	exit 0
fi

# --split dispatches early as well: positional args are pathspecs, not commits
if [ ${#OPT_SPLIT} -gt 0 ]; then
	if [[ ${#OPT_SPLIT} -gt 1 && -n "${OPT_SPLIT[2]}" ]]; then
		SPLIT_TARGET="${OPT_SPLIT[2]#=}"
	fi
	if [ -z "$SPLIT_TARGET" ]; then
		USAGE
		PRINT_ERR "--split requires a <sha> value (e.g., --split=abc123)"
		exit 1
	fi
	if [ ${#OPT_MESSAGE} -gt 0 -o ${#OPT_REWORD} -gt 0 -o ${#OPT_DROP} -gt 0 -o ${#OPT_SQUASH} -gt 0 -o ${#OPT_RESQUASH} -gt 0 -o ${#OPT_DIR} -gt 0 -o ${#OPT_EXEC} -gt 0 -o ${#OPT_AMEND_INTO} -gt 0 -o ${#OPT_REORDER} -gt 0 ]; then
		USAGE
		PRINT_ERR "Option --split cannot be combined with other modes"
		exit 1
	fi
	if [ "$1" = "--" ]; then
		shift
	fi
	if ! git rev-parse --quiet --verify "$SPLIT_TARGET^{commit}" >/dev/null 2>&1; then
		PRINT_ERR "Unknown <sha>: $SPLIT_TARGET"
		exit 1
	fi
	SPLIT_TARGET=$(git rev-parse "$SPLIT_TARGET^{commit}")
	# No pathspec means the halves aren't separable by path – pause and let the
	# caller author the split point instead of demanding one that can't exist
	if [ $# -eq 0 ]; then
		GIT_SPLIT_PAUSE
	fi
	if [ -z "$TEXT_VALUE" ]; then
		PRINT_ERR "--split requires --text for the extracted commit's message"
		exit 1
	fi
	PRINT_ACTION "Splitting %s..." "$SPLIT_TARGET"
	GIT_SPLIT "$@"
	PRINT_COMPLETED "$SPLIT_NEW_HEAD" "$SPLIT_REF" true
	exit 0
fi

COMMITS=()

if [ $# -eq 0 ]; then
	# A bare `git edit` is a request for help, and the usage block already makes
	# the required `<commit>` obvious. But with a mode flag given, the caller
	# meant to do something and only left the target off – name that, rather
	# than making them find it in a screen of usage
	if [ ${#OPT_REWORD} -gt 0 -o ${#OPT_DROP} -gt 0 -o ${#OPT_SQUASH} -gt 0 -o ${#OPT_RESQUASH} -gt 0 -o -n "$TEXT_VALUE" ]; then
		PRINT_ERR "Missing <commit> – name the commit to act on (e.g. 'git edit -M --text=\"…\" HEAD')"
		# The retry for this is always a bare `HEAD`, so say what that is right
		# now: a parallel session's commit landing in the gap is exactly how a
		# reword reaches the wrong one, and the CAS cannot catch it – that guard
		# covers the ref moving mid-run, not the wrong commit being named
		local HEAD_LINE=$(git log -1 --format='%h %s' 2>/dev/null)
		if [ -n "$HEAD_LINE" ]; then
			ECHO_E "\e[0;31m  HEAD is currently $HEAD_LINE\e[0m" >&2
		fi
		exit 1
	fi
	USAGE
	exit 1
fi

# Parse/expand arguments (commits or ranges)
for ARG in "$@"; do
	# Check if the argument is a standard ".." range (excluding "..." symmetric diff)
	if [[ "$ARG" == *".."* && "$ARG" != *"..."* ]]; then
		local S="${${ARG%%..*}:-HEAD}"
		local E="${${ARG#*..}:-HEAD}"

		# Swap if reversed (newer..older)
		git merge-base --is-ancestor "$E" "$S" 2>/dev/null && { local T="$S"; S="$E"; E="$T"; }

		# Determine range string (inclusive)
		local RANGE="$E"
		git rev-parse -q --verify "$S^" >/dev/null && RANGE="$S^..$E"

		# Validate and append
		if ! git rev-list "$RANGE" >/dev/null 2>&1; then
			PRINT_ERR "Invalid commit range: $ARG"
			exit 1
		fi
		COMMITS+=($(git rev-list "$RANGE"))
	else
		# Handle single commits
		if ! git rev-parse --quiet --verify "$ARG" >/dev/null 2>&1; then
			PRINT_ERR "Unknown <commit>: $ARG"
			# A message passed where the commit goes – the mistake every mode
			# that takes both invites, and nothing about "unknown commit" hints
			# at the real fix
			if [[ "$ARG" == *" "* ]]; then
				ECHO_E "\e[0;31m  That looks like a message – pass it as --text \"…\" and give the commit separately.\e[0m" >&2
			fi
			exit 1
		fi
		COMMITS+=($(git rev-parse "$ARG"))
	fi
done

# Abort if no commits were found
if [ ${#COMMITS[@]} -eq 0 ]; then
	PRINT_ERR "No valid commits found."
	exit 1
fi

# --reorder: the positional order IS the payload – capture it before the
# topological sort below normalizes it away
if [ ${#OPT_REORDER} -gt 0 ]; then
	COMMITS_DESIRED=("${COMMITS[@]}")
fi

# Validate before sorting, while the SHAs are still as the caller gave them – the sort's
# fallback below drops anything git cannot resolve, and each commit comes back as its
# current identity, so a SHA staled by an earlier rewrite is carried forward
COMMITS_RESOLVED=()
for COMMIT in "${COMMITS[@]}"; do
	_GUARD_REACHABLE "$COMMIT"
	COMMITS_RESOLVED+=("$_RESOLVED_SHA")
done
COMMITS=("${COMMITS_RESOLVED[@]}")

# Sort selected commits topologically, oldest first – `rev-list --no-walk` only sorts by
# timestamp, which ties and comes back input-reversed on rapid-fire same-second commits,
# silently inverting the selection, so derive the order from `HEAD`'s own history
COMMITS_TOPO=($(git rev-list --reverse HEAD 2>/dev/null | grep -Fx -f <(printf '%s\n' "${COMMITS[@]}") 2>/dev/null))
if [ ${#COMMITS_TOPO[@]} -eq ${#COMMITS[@]} ]; then
	COMMITS=("${COMMITS_TOPO[@]}")
else
	COMMITS=($(git rev-list --no-walk --reverse "${COMMITS[@]}"))
fi

# Determine Action
if [ ${#OPT_REORDER} -gt 0 ]; then
	# Reorder (`--reorder`) — contiguous span, args give the new order
	ACTION="reorder"
	if [[ "$COMMANDLINE" == *".."* ]]; then
		PRINT_ERR "--reorder takes single commits in the desired order (no ranges)"
		exit 1
	fi
	COMMIT=${COMMITS[-1]}

elif [ ${#OPT_REWORD} -gt 0 ]; then
	# Reword (`-M` / `--reword`) — message-only edit via plumbing, no working-tree touch
	ACTION="reword"
	if [ ${#COMMITS[@]} -gt 1 ]; then
		PRINT_ERR "-M/--reword takes exactly one <commit>"
		exit 1
	fi
	COMMIT=${COMMITS[1]}

elif [ ${#OPT_RESQUASH} -gt 0 ]; then
	# Resquash (`-S` / `--resquash`) — plumbing-only contiguous squash, no working-tree touch
	ACTION="resquash"
	# Single commit: squash into its parent (mirrors -s semantics)
	if [ ${#COMMITS[@]} -eq 1 ]; then
		if git cat-file -e "${COMMITS[1]}^" 2>/dev/null; then
			local PARENT=$(git rev-parse "${COMMITS[1]}^")
			COMMITS=($PARENT ${COMMITS[1]})
		else
			PRINT_ERR "Cannot squash <commit> as it has no parent"
			exit 1
		fi
	fi
	COMMIT=${COMMITS[-1]}

elif [ ${#OPT_DROP} -gt 0 ]; then
	# Drop/Delete (`-d` / `--drop`)
	ACTION="drop"
	COMMIT=${COMMITS[1]}

elif [ ${#OPT_SQUASH} -gt 0 ]; then
	# Explicit Squash (-s)
	ACTION="squash"

	# `TARGET` was extracted in the pre-processing block – set if the user
	# used `-s=<target>`, or if `-sX`/`-s X` was used and the value wasn't
	# re-injected by the heuristic (i.e., it's not a recognizable ref/range)

	# If an explicit target was found, verify it and add to `COMMITS` array
	if [ -n "$TARGET" ]; then
		if ! git rev-parse --quiet --verify "$TARGET^{commit}" >/dev/null 2>&1; then
			PRINT_ERR "Unknown <target>: $TARGET"
			exit 1
		fi
		TARGET=$(git rev-parse "$TARGET")
		# Add explicit target to list, re-sorted from `HEAD`'s own history –
		# `--no-walk --reverse` timestamp-sorts, which ties (and inverts the
		# input) on same-second commits, scrambling the span
		COMMITS+=("$TARGET")
		COMMITS_TOPO=($(git rev-list --reverse HEAD 2>/dev/null | grep -Fx -f <(printf '%s\n' "${COMMITS[@]}") 2>/dev/null))
		if [ ${#COMMITS_TOPO[@]} -eq ${#COMMITS[@]} ]; then
			COMMITS=("${COMMITS_TOPO[@]}")
		else
			COMMITS=($(git rev-list --no-walk --reverse "${COMMITS[@]}"))
		fi
	fi

	# Default target to oldest if not set
	if [ -z "$TARGET" ]; then
		TARGET=${COMMITS[1]}

		# If squashing just 1 commit (e.g. `git edit -s HEAD`), target is parent
		if [ ${#COMMITS[@]} -eq 1 ]; then
			if git cat-file -e "${TARGET}^" 2>/dev/null; then
				local PARENT=$(git rev-parse "${TARGET}^")
				TARGET=$PARENT
				COMMITS=($TARGET ${COMMITS[1]})
			else
				PRINT_ERR "Cannot squash <commit> as it has no parent"
				exit 1
			fi
		fi
	fi
	# Use newest commit for logs if needed, but logic uses `COMMITS` array
	COMMIT=${COMMITS[-1]}

elif [ ${#COMMITS[@]} -gt 1 ]; then
	# Implicit Squash (no flags, but multiple commits provided)
	ACTION="squash"
	TARGET=${COMMITS[1]}
	COMMIT=${COMMITS[-1]}

else
	# Edit (single commit, no flags)
	ACTION="edit"
	COMMIT=${COMMITS[1]}
fi

# Pushed guard for the rebase-based modes (drop / squash / edit) – the
# plumbing and isolated modes (-M, -S, --amend-into, --reorder, --exec)
# guard inside their own functions. The oldest selected commit covers the
# whole rewritten span.
if [[ "$ACTION" == "drop" || "$ACTION" == "squash" || "$ACTION" == "edit" ]]; then
	_GUARD_UNPUSHED "${COMMITS[1]}"
fi

# Auto-route plain squash (`-s` or implicit) to the plumbing path (`-S` /
# resquash) when eligible — contiguous range, target = oldest, no merge
# commits. Same observable outcome, but no working-tree touch and no stash
# dance. `-S` (explicit) and `-C` are unaffected; this only optimizes the
# default `-s` path. Non-contiguous or merge-containing selections fall
# through to the existing rebase-based squash unchanged.
if [[ "$ACTION" == "squash" ]] && [ ${#OPT_DIR} -eq 0 ] && _RESQUASH_ELIGIBLE; then
	ACTION="resquash"
fi

# Merge-span guard for the modes still rebase-based after auto-routing – a
# squash re-routed to plumbing rebuilds merges above it faithfully and needs
# no refusal, so this must come after the route decision
if [[ "$ACTION" == "drop" || "$ACTION" == "squash" || "$ACTION" == "edit" ]]; then
	_GUARD_NO_MERGE_SPAN "${COMMITS[1]}"
fi

# Non-interactive edit – instead of a prompt nobody can answer, prepare an isolated worktree
# at the target and hand control back, so the caller edits the commit's own content there
# `git edit --continue` then amends, replays and CAS-applies, the branch staying untouched
if [[ "$ACTION" == "edit" ]] && _IS_NON_INTERACTIVE; then
	_REQUIRE_NO_INFLIGHT
	if [ -n "$TEXT_VALUE" ]; then
		PRINT_ERR "Pass --text with 'git edit --continue' – the message is applied at the amend"
		exit 1
	fi
	EDIT_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null)
	if [ -z "$EDIT_BRANCH" ]; then
		PRINT_ERR "Edit mode requires being on a branch (got detached HEAD)"
		exit 1
	fi
	EDIT_TARGET=$(git rev-parse "$COMMIT^{commit}")
	EDIT_WT=$(MKTEMP_DIR git-edit-edit)
	rmdir "$EDIT_WT"  # `git worktree add` wants to create the dir itself
	if ! git worktree add --detach "$EDIT_WT" "$EDIT_TARGET" >/dev/null 2>&1; then
		PRINT_ERR "Cannot create edit worktree at ${EDIT_TARGET:0:7}"
		exit 1
	fi
	_LINK_WORKTREE_EXTRAS "$EDIT_WT"
	_SAVE_STATE "operation=edit" "worktree=$EDIT_WT" "branch=refs/heads/$EDIT_BRANCH" \
		"orig_head=$(git rev-parse HEAD)" "target=$EDIT_TARGET" "maindir=$(git rev-parse --show-toplevel)"
	PRINT_ACTION "Editing %s..." "$EDIT_TARGET"
	PRINT_TEXT "Worktree at the commit: %s" 33 "$EDIT_WT"
	PRINT_TEXT "Make your changes there, then %s (add %s to also reword) – or cancel via %s." 33 "git edit --continue" '--text "…"' "git edit --abort"
	EMIT_PAUSED edit "$EDIT_TARGET" "$EDIT_WT"
	exit 2
fi

# Final `--text` validation, only valid for message-producing modes – deferred until after
# action determination so implicit squash and auto-routing are both accounted for
if [ -n "$TEXT_VALUE" ] && [[ "$ACTION" != "reword" && "$ACTION" != "resquash" && "$ACTION" != "squash" ]]; then
	PRINT_ERR "Option --text only applies to message-producing modes (-M, -s, -S, or implicit squash); got action: $ACTION"
	exit 1
fi

# Auto-isolate in non-interactive contexts – run by an agent, CI or any script, default to
# `-C` for the modes that would otherwise touch the main working tree, so parallel
# sessions cannot clobber each other, with `GIT_EDIT_NO_AUTO_ISOLATE=1` to override
if [ -z "$GIT_EDIT_NO_AUTO_ISOLATE" ] && _IS_NON_INTERACTIVE && [ ${#OPT_DIR} -eq 0 ] && \
   [[ "$ACTION" == "drop" || "$ACTION" == "edit" || "$ACTION" == "squash" ]]; then
	ECHO_E "${_PAD}\e[0;90m(non-interactive context: auto-isolating in a temp worktree)\e[0m"
	OPT_DIR=(--dir)
	WORKTREE_DIR=$(MKTEMP_DIR git-edit-auto-iso)
	rmdir "$WORKTREE_DIR"  # `git worktree add` wants to create the dir itself
	_CLEANUP_HOOK="git worktree remove --force '$WORKTREE_DIR' 2>/dev/null; rm -rf '$WORKTREE_DIR'"
fi


# ------------------------------------------- CORE LOGIC -------------------------------------------

# Reword and resquash take a plumbing-only path that never touches the working tree, the
# index or any other worktree state – the affected commits and their descendants are
# rebuilt via `git commit-tree` and applied with a single atomic `git update-ref`
if [[ "$ACTION" == "reword" ]]; then
	PRINT_ACTION "Rewording %s..." "$COMMIT"
	GIT_REWORD
	PRINT_COMPLETED "$(git rev-parse HEAD)" "$(_CURRENT_REF)" true
	exit 0
fi
if [[ "$ACTION" == "resquash" ]]; then
	local TARGET_SUBJECT=$(git log -1 --pretty=format:'%s' "${COMMITS[1]}")
	PRINT_ACTION "Resquashing %s into ${COMMITS[1]:0:7}\e[22m (${TARGET_SUBJECT})" "${COMMITS[@]:#${COMMITS[1]}}"
	GIT_RESQUASH
	PRINT_COMPLETED "$(git rev-parse HEAD)" "$(_CURRENT_REF)" true
	exit 0
fi
if [[ "$ACTION" == "reorder" ]]; then
	PRINT_ACTION "Reordering to %s" "${COMMITS_DESIRED[@]}"
	GIT_REORDER
	PRINT_COMPLETED "$REORDER_NEW_HEAD" "$REORDER_REF" true
	exit 0
fi

# Optionally rebase in a separate worktree (-C/--dir), so the rebase doesn't touch
# the main working tree (useful when an editor or AI agent is editing it concurrently)
if [ ${#OPT_DIR} -gt 0 ]; then
	# Default path: <repo-root>.git-edit (a sibling directory of the repo)
	if [ -z "$WORKTREE_DIR" ]; then
		TOPLEVEL=$(git rev-parse --show-toplevel 2>/dev/null)
		if [ -z "$TOPLEVEL" ]; then
			PRINT_ERR "Not in a git repository"
			exit 1
		fi
		WORKTREE_DIR="${TOPLEVEL}.git-edit"
	fi

	# Detect a known GUI editor so we can auto-open the worktree at interactive
	# pauses. Runs for both the auto-managed default path and an explicit
	# -C=<path>. Terminal editors like vim/nano simply don't match the list
	# below (opening a directory in them makes no sense), so they're ignored.
	# We iterate over all of git's editor sources (GIT_EDITOR / core.editor /
	# VISUAL / EDITOR — the same cascade as `_RESOLVE_EDITOR`) rather than stop
	# at the first, because git tooling (including Claude Code) often sets
	# GIT_EDITOR=true as a no-op which would otherwise mask a usable editor
	# lower in the chain. Notably this includes `git config core.editor`, which
	# is where many users (e.g. `subl -n -w`) actually configure their editor.
	for EDITOR_CMD in "$GIT_EDITOR" "$(git config core.editor 2>/dev/null)" "$VISUAL" "$EDITOR"; do
		[ -z "$EDITOR_CMD" ] && continue
		EDITOR_FIRST="${EDITOR_CMD%% *}"
		EDITOR_BASE="${EDITOR_FIRST##*/}"
		case "$EDITOR_BASE" in
			subl|sublime_text|sublime) OPEN_EDITOR_NAME="Sublime Text" ;;
			code)                      OPEN_EDITOR_NAME="VS Code" ;;
			code-insiders)             OPEN_EDITOR_NAME="VS Code Insiders" ;;
			cursor)                    OPEN_EDITOR_NAME="Cursor" ;;
			zed)                       OPEN_EDITOR_NAME="Zed" ;;
			mate)                      OPEN_EDITOR_NAME="TextMate" ;;
			atom)                      OPEN_EDITOR_NAME="Atom" ;;
			nova)                      OPEN_EDITOR_NAME="Nova" ;;
			bbedit)                    OPEN_EDITOR_NAME="BBEdit" ;;
			idea*)                     OPEN_EDITOR_NAME="IntelliJ IDEA" ;;
			pycharm*)                  OPEN_EDITOR_NAME="PyCharm" ;;
			webstorm*)                 OPEN_EDITOR_NAME="WebStorm" ;;
			phpstorm*)                 OPEN_EDITOR_NAME="PhpStorm" ;;
			rubymine*)                 OPEN_EDITOR_NAME="RubyMine" ;;
			goland*)                   OPEN_EDITOR_NAME="GoLand" ;;
			clion*)                    OPEN_EDITOR_NAME="CLion" ;;
			rider*)                    OPEN_EDITOR_NAME="Rider" ;;
			datagrip*)                 OPEN_EDITOR_NAME="DataGrip" ;;
			fleet)                     OPEN_EDITOR_NAME="Fleet" ;;
			xed)                       OPEN_EDITOR_NAME="Xed" ;;
		esac
		if [ -n "$OPEN_EDITOR_NAME" ]; then
			OPEN_EDITOR_CMD="$EDITOR_CMD"
			break
		fi
	done

	# Auto-open the worktree in the detected GUI editor at interactive pauses, so the caller
	# does not have to press a key first – opt out with `GIT_EDIT_NO_AUTO_OPEN=1`, mirroring
	# the `GIT_EDIT_NO_AUTO_ISOLATE` convention, to keep the press-Space-to-open flow
	if [ -n "$OPEN_EDITOR_CMD" ] && [ -z "$GIT_EDIT_NO_AUTO_OPEN" ]; then
		AUTO_OPEN_EDITOR=true
	fi

	# Capture original branch and `HEAD` for ref-update at the end
	ORIG_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null)
	ORIG_HEAD=$(git rev-parse HEAD)

	# Canonicalize paths (resolve symlinks) so comparisons are consistent
	OUR_TOPLEVEL=$(cd "$(git rev-parse --show-toplevel)" && pwd -P)

	if [ -d "$WORKTREE_DIR" ]; then
		# Verify the existing path is a git working tree
		THEIR_TOPLEVEL=$(git -C "$WORKTREE_DIR" rev-parse --show-toplevel 2>/dev/null)
		if [ -z "$THEIR_TOPLEVEL" ]; then
			PRINT_ERR "Path '$WORKTREE_DIR' exists but is not a git working tree"
			exit 1
		fi
		THEIR_TOPLEVEL=$(cd "$THEIR_TOPLEVEL" && pwd -P)
		WORKTREE_ABS=$(cd "$WORKTREE_DIR" && pwd -P)

		# Must be the root of its own worktree, not a subdirectory of one
		if [ "$THEIR_TOPLEVEL" != "$WORKTREE_ABS" ]; then
			PRINT_ERR "Path '$WORKTREE_DIR' is inside a working tree but is not its root"
			exit 1
		fi
		# Must not be the worktree we're currently running from
		if [ "$THEIR_TOPLEVEL" = "$OUR_TOPLEVEL" ]; then
			PRINT_ERR "-C/--dir cannot point to the current working tree"
			exit 1
		fi

		# Clean up any leftover rebase state from a previous killed run
		# (rm -rf as fallback in case `git rebase --abort` chokes on malformed state)
		git -C "$WORKTREE_DIR" rebase --abort 2>/dev/null
		WT_GITDIR=$(git -C "$WORKTREE_DIR" rev-parse --absolute-git-dir 2>/dev/null)
		if [ -n "$WT_GITDIR" ]; then
			rm -rf "$WT_GITDIR/rebase-merge" "$WT_GITDIR/rebase-apply"
		fi

		# Sync existing worktree to current HEAD
		CMD="git -C '$WORKTREE_DIR' reset --hard $ORIG_HEAD"
		PRINT_CMD "$CMD"
		eval "$CMD" >/dev/null || ABORT
	else
		# Create new detached worktree. Auto-recover from a stale
		# registration — git refuses if the path is listed by
		# `git worktree list` but missing on disk, which happens when
		# a previous worktree was removed with `rm -rf` instead of
		# `git worktree remove`.
		CMD="git worktree add --detach '$WORKTREE_DIR' $ORIG_HEAD"
		PRINT_CMD "$CMD"
		WT_OUT=$(eval "$CMD" 2>&1)
		WT_STATUS=$?
		if [ $WT_STATUS -ne 0 ]; then
			if [[ "$WT_OUT" == *"missing but already registered"* ]]; then
				ECHO_E "\e[0;90m(stale worktree registration — pruning and retrying)\e[0m"
				git worktree prune 2>/dev/null
				eval "$CMD" || ABORT
			else
				echo "$WT_OUT" >&2
				ABORT
			fi
		else
			[ -n "$WT_OUT" ] && echo "$WT_OUT"
		fi
	fi

	cd "$WORKTREE_DIR" || ABORT
fi


GIT_STASH

if [[ "$ACTION" == "drop" ]]; then
	PRINT_ACTION "Dropping %s" "${COMMITS[@]}"

	PRINT_TEXT "Press %s to confirm, or cancel with %s." 35 "Enter" "Escape"
	CONTINUE_OR_ABORT "" skip

	GIT_REBASE_DROP
elif [[ "$ACTION" == "squash" ]]; then
	local TARGET_SUBJECT=$(git log -1 --pretty=format:'%s' "$TARGET")
	PRINT_ACTION "Merging %s -> ${TARGET:0:7}\e[22m (${TARGET_SUBJECT})" "${COMMITS[@]:#$TARGET}"

	PRINT_TEXT "Press %s to confirm, or cancel with %s." 35 "Enter" "Escape"
	CONTINUE_OR_ABORT "" skip

	GIT_REBASE_SQUASH
else
	PRINT_ACTION "Editing %s..." "$COMMIT"

	GIT_REBASE_BEGIN_EDIT

	if [ -n "$WORKTREE_DIR" ]; then
		if [ "$AUTO_OPEN_EDITOR" = "true" ]; then
			_OPEN_WORKTREE_IN_EDITOR
			PRINT_TEXT "%s in %s (opened in %s) – then press %s to continue, %s to re-open, or %s to cancel." 35 "Now make your changes" "$WORKTREE_DIR" "$OPEN_EDITOR_NAME" "Enter" "Space" "Escape"
		elif [ -n "$OPEN_EDITOR_CMD" ]; then
			PRINT_TEXT "%s in %s – press %s to open in %s, %s to continue, or %s to cancel." 35 "Now make your changes" "$WORKTREE_DIR" "Space" "$OPEN_EDITOR_NAME" "Enter" "Escape"
		else
			PRINT_TEXT "%s in %s – then press %s to continue, or cancel with %s." 35 "Now make your changes" "$WORKTREE_DIR" "Enter" "Escape"
		fi
	else
		PRINT_TEXT "%s – then press %s to continue, or cancel with %s." 35 "Now make your changes" "Enter" "Escape"
	fi
	CONTINUE_OR_ABORT ${OPEN_EDITOR_CMD:+open}

	GIT_ADD_ALL
	GIT_COMMIT_AMEND

	GIT_REBASE_CONTINUE
fi

GIT_UNSTASH

# Apply the rewritten history back to the original branch (if -C was used)
if [ -n "$WORKTREE_DIR" ]; then
	NEW_HEAD=$(git rev-parse HEAD)
	if [ -n "$ORIG_BRANCH" ]; then
		# Atomic compare-and-swap: only update if the ref still matches ORIG_HEAD,
		# so any concurrent commit (e.g., from an editor working in the main checkout)
		# is not silently overwritten.
		CMD="git update-ref -m 'git edit: $ACTION ${COMMIT:0:7}' refs/heads/$ORIG_BRANCH $NEW_HEAD $ORIG_HEAD"
		PRINT_CMD "$CMD"
		if ! eval "$CMD" 2>/dev/null; then
			PRINT_ERR "Branch '$ORIG_BRANCH' moved during rebase – refusing to overwrite"
			PRINT_TEXT "Rebased history is at %s in %s." 33 "$NEW_HEAD" "$WORKTREE_DIR"
			exit 1
		fi
		_RECORD_REF_MOVE "refs/heads/$ORIG_BRANCH" "$ORIG_HEAD" "$NEW_HEAD" "$ACTION ${COMMIT:0:7}"
		_PRINT_REWRITE_APPLY_HINT "$ORIG_BRANCH" "$ORIG_HEAD" "$NEW_HEAD" "$ACTION"
	else
		PRINT_TEXT "Detached HEAD – rebased commits are at %s in %s." 33 "$NEW_HEAD" "$WORKTREE_DIR"
	fi
fi

PRINT_COMPLETED "$(git rev-parse HEAD)" "$(_CURRENT_REF)" true
