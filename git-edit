# Prints the man page's entry for each <topic> – a flag, with or without its dashes or a value, or a
# section's title – as plain text, one paragraph a line, whatever viewer `git help` would use
# • The page is the one source: `git edit -h` lists the flags, `git help edit` is the whole manual
# • Read by awk, not `man`, so it reads the same wherever no man, groff or mandoc is installed
_HELP_TOPICS () {
	# Args: <topic>...
	local PAGE=${_SELF:h}/man/man1/git-edit.1 T OUT
	local -a GONE
	local -i SHOWN=0
	[ -f "$PAGE" ] || PAGE=${_SELF:h}/../share/man/man1/git-edit.1
	if [ ! -f "$PAGE" ]; then
		PRINT_ERR "No man page beside this git-edit to read '${(j:', ':)@}' from – 'git edit -h' lists every flag"
		exit 1
	fi
	for T in "$@"; do
		# An empty one names nothing – none at all is the usage
		[ -n "$T" ] || continue
		# A mode by its everyday name
		case $T in
			fold)   T=--amend-into ;;
			place)  T=--after ;;
			*help)  T=-h ;;
		esac
		# Through the environment, as `-v` would read a backslash in it as an escape
		OUT=$(GIT_EDIT_HELP_TOPIC=$T LC_ALL=C awk '
		# Turns roff into plain text – an italic placeholder bracketed, as `-h` spells one
		function unesc(s,   pre) {
			gsub(/\\\\/, "\001", s)
			gsub(/\\-/, "-", s)
			while (match(s, /\\fI[^\\]*\\f[RPB]/)) {
				pre = substr(s, 1, RSTART - 1)
				s = pre "<" substr(s, RSTART + 3, RLENGTH - 6) ">" substr(s, RSTART + RLENGTH)
			}
			gsub(/\\f[BIRP]/, "", s)
			gsub(/\\\(em|\\\(en/, "–", s)
			gsub(/\\\(bu/, "•", s)
			gsub(/\\\(->/, "→", s)
			gsub(/\\\(aq/, "\047", s)
			gsub(/\\\((dq|lq|rq)/, "\"", s)
			gsub(/\\&/, "", s)
			gsub(/\\ /, " ", s)
			gsub(/\\e/, "\001", s)
			gsub(/\001/, "\\", s)
			return s
		}
		# Splits a macro line into `ARG`, double quotes grouping, an escaped space kept in its word
		function margs(line,   rest, n, i, c, cur, inq) {
			rest = line
			sub(/^\.[A-Za-z]+[ \t]*/, "", rest)
			n = 0; cur = ""; inq = 0
			for (i = 1; i <= length(rest); i++) {
				c = substr(rest, i, 1)
				if (c == "\\" && substr(rest, i + 1, 1) == " ") { cur = cur "\\ "; i++; continue }
				if (c == "\"") { inq = !inq; continue }
				if ((c == " " || c == "\t") && !inq) { if (cur != "") ARG[++n] = cur; cur = ""; continue }
				cur = cur c
			}
			if (cur != "") ARG[++n] = cur
			return n
		}
		# Joins the macro arguments with <sep>, bracketing the italic ones – <it> 1 odd, 2 even, 3 all
		function joined(n, sep, it,   i, t, a) {
			t = ""
			for (i = 1; i <= n; i++) {
				a = ARG[i]
				if (it == 3 || (it == 1 && i % 2) || (it == 2 && !(i % 2))) a = "<" a ">"
				t = t (i > 1 ? sep : "") a
			}
			return t
		}
		function emit(k, v) { K[++R] = k; V[R] = v }
		function flush() { if (para != "") emit("P", para); para = "" }
		function add(t) {
			if (t == "") return
			if (wanttag) { emit("T", t); wanttag = 0; return }
			para = para (para == "" ? "" : " ") t
		}
		/^\.\\"/ { next }
		/^\.(SH|SS)( |$)/ { flush(); wanttag = 0; emit(substr($0, 2, 2) == "SH" ? "S" : "s", unesc(joined(margs($0), " ", 0))); next }
		/^\.TP( |$)/ { flush(); wanttag = 1; next }
		/^\.(PP|LP|P|sp|br)( |$)/ { flush(); next }
		/^\.IP( |$)/ { flush(); if (margs($0) >= 1) para = unesc(ARG[1]); next }
		/^\.(nf|EX)( |$)/ { flush(); pre = 1; next }
		/^\.(fi|EE)( |$)/ { pre = 0; next }
		/^\.(B|SM|SB)( |$)/ { add(unesc(joined(margs($0), " ", 0))); next }
		/^\.I( |$)/ { add(unesc(joined(margs($0), " ", 3))); next }
		/^\.(BR|RB)( |$)/ { add(unesc(joined(margs($0), "", 0))); next }
		/^\.(IR|IB)( |$)/ { add(unesc(joined(margs($0), "", 1))); next }
		/^\.(RI|BI)( |$)/ { add(unesc(joined(margs($0), "", 2))); next }
		/^\./ { next }
		{ if (pre) { flush(); emit("X", unesc($0)) } else add(unesc($0)) }
		# Tells whether tag <t> names flag <w> – first in a comma-led part, or with <any> anywhere
		function names(t, w, any,   n, i, p, f) {
			n = any ? split(t, p, /[ ,{}|\[\]()]+/) : split(t, p, /, /)
			for (i = 1; i <= n; i++) {
				f = p[i]
				sub(/[ =].*/, "", f)
				if (f !~ /^-/) continue
				if (length(w) == 1 ? f == "-" w : tolower(f) == "--" tolower(w)) return 1
			}
			return 0
		}
		# Prints one record – a title or an entry tag flush left, its paragraphs under it
		function show(i) {
			if (K[i] == "S" || K[i] == "s" || K[i] == "T") {
				print (shown++ ? "\n" : "") V[i]
				under = K[i] == "T"
			} else print (under ? "  " : "") (K[i] == "X" ? "  " : "") V[i]
		}
		# Prints every entry naming <w>, each through its paragraphs
		function entries(w, any,   i, j) {
			for (i = 1; i <= R; i++) {
				if (K[i] != "T" || !names(V[i], w, any)) continue
				show(i)
				for (j = i + 1; j <= R && K[j] != "T" && K[j] != "S" && K[j] != "s"; j++) show(j)
			}
		}
		END {
			flush()
			w = ENVIRON["GIT_EDIT_HELP_TOPIC"]
			sub(/^-+/, "", w)
			sub(/=.*/, "", w)
			if (w == "") exit
			entries(w, 0)
			if (shown) exit
			entries(w, 1)
			if (shown) exit
			# Else the first section or subsection whose title holds it, to the next of its rank – a
			# word of three letters or more, as one letter would name any
			if (length(w) < 3) exit
			for (i = 1; i <= R; i++) {
				if ((K[i] != "S" && K[i] != "s") || index(tolower(V[i]), tolower(w)) == 0) continue
				show(i)
				for (j = i + 1; j <= R && K[j] != "S" && !(K[i] == "s" && K[j] == "s"); j++) show(j)
				exit
			}
		}' "$PAGE")
		if [ -z "$OUT" ]; then
			GONE+=("$T")
			continue
		fi
		(( SHOWN++ )) && print
		print -r -- "$OUT"
	done
	(( SHOWN + ${#GONE} )) || USAGE
	if (( ${#GONE} )); then
		PRINT_ERR "No help topic '${(j:', ':)GONE}' – name a flag 'git edit -h' lists, or a section of 'git help edit': $(LC_ALL=C sed -n 's/^\.S[HS] //p' "$PAGE" | tr -d '"' | tr '\n' ',' | LC_ALL=C sed 's/,$//; s/,/, /g')"
		exit 1
	fi
}

# Prints a printf-style <message> in <color>, each `%s` argument in the color's bright form
PRINT_TEXT () {
	local MSG=$1; shift
	local COLOR=$1; shift
	# Arguments are data, a `\e[0m` in a name held literal – bar `PRINT_ACTION`'s, which carry its
	# own `\e[22m` and mark their subjects themselves
	local ARGS=("$@")
	[ -n "$_PT_RAW" ] || ARGS=("${(@)ARGS//\\/$_LITB}")

	local BASE=$COLOR
	local BRIGHT=$(( COLOR <= 37 ? COLOR + 60 : COLOR ))

	local TEXT="$MSG"
	local OUTPUT="${_PAD}\e[0;${COLOR}m"
	local ARG
	for ARG in "${ARGS[@]}"; do
		OUTPUT+="${TEXT%%%s*}"
		OUTPUT+="\e[1;${BRIGHT}m${ARG}\e[0;${BASE}m"
		TEXT="${TEXT#*%s}"
	done
	OUTPUT+="$TEXT\e[0m"
	ECHO_E "$OUTPUT"
}

PRINT_ACTION () {
	local MSG=$1; shift

	# A trailing `%t` names a squash or merge target – render it from its own commit, so its
	# subject stays out of the format string, where a `%` would miscount `%s` or an `->` misroute
	# – the target is the first positional then, the `%s` commits the rest
	local TARGET_RENDER=""
	if [[ "$MSG" == *%t ]]; then
		local TGT=$1; shift
		local TSUB=$(git log -1 --pretty=format:'%s' "$TGT")
		TSUB=${TSUB//\\/$_LITB}
		TARGET_RENDER="${TGT:0:7}\e[22m (${TSUB})"
		MSG="${MSG%\%t}"
	fi

	local COMMITS=("$@")
	local ARGS=()
	local COMMIT
	for COMMIT in "${COMMITS[@]}"; do
		local SUBJECT=$(git log -1 --pretty=format:'%s' "$COMMIT")
		# `ECHO_E` renders the `\e[22m` here, the subject's backslashes marked as data
		ARGS+=("${COMMIT:0:7}\e[22m (${SUBJECT//\\/$_LITB})")
	done

	local _PT_RAW=1
	# Count placeholders (assumes %s is the only placeholder type used) – the target is gone, so
	# only git-edit's own `%s` remain, whatever a subject carried
	local PLACEHOLDERS="${MSG//[^%]}"

	# Use list mode if multiple commits or if it's a merge (contains "->")
	if [[ ${#COMMITS[@]} -gt 1 || "$MSG" == *"->"* ]] && [[ ${#PLACEHOLDERS} -eq 1 ]]; then
		local PREFIX="${MSG%%%s*}" # e.g. "Dropping "
		local SUFFIX="${MSG#*%s}"  # e.g. "..." or " -> " or " into "

		# Transform "Dropping " -> "Dropping:"
		local NEW_MSG="${PREFIX% }:"

		# Append a newline and indented placeholder for every commit
		# We use a C-style loop for robust iteration in Zsh
		for (( i=0; i<${#COMMITS[@]}; i++ )); do
			NEW_MSG+=$'\n'" - %s"
		done

		# Put merge arrow on a new line and bold it, otherwise keep suffix attached – the rendered
		# target, when there is one, trails whichever
		if [[ "$SUFFIX" == *"->"* ]]; then
			NEW_MSG+=$'\n'"\e[1;96m${SUFFIX# }${TARGET_RENDER}"
		else
			NEW_MSG+="${SUFFIX}${TARGET_RENDER}"
		fi

		PRINT_TEXT "$NEW_MSG" 36 "${ARGS[@]}"
	else
		# Default behavior for single commits or specific pairs (squash A -> B)
		PRINT_TEXT "${MSG}${TARGET_RENDER}" 36 "${ARGS[@]}"
	fi
}

# Prints one dim line naming <commit> via <format> – formatted by git and piped rather than
# routed through `PRINT_TEXT`, which would read a `%s` in the subject as a placeholder
# Silent on a missing object, where a `fatal:` would read as the operation having failed
_PRINT_COMMIT_LINE () {
	_CARET "$(git log -1 --format="$2" "$1" 2>/dev/null)"
	print -r -- "$REPLY" | LC_ALL=C sed "/./!d;s/^/${_DIM}/;s/\$/${_OFF}/"
}

# Prints a command the run is about to run, dimmed like its output
PRINT_CMD () {
	# Args: <command string> [<color – default 90 gray, matching the command's own output>]
	local CMD="$1"
	local COLOR="${2:-90}"

	# Filter `--no-autostash` arg when printing commands
	local CMD_FILTERED=$(print -r -- "$CMD" | LC_ALL=C sed -E 's/ --no-autostash( |$)/\1/g')

	ECHO_E "${_PAD}\e[0;${COLOR}m${CMD_FILTERED//\\/$_LITB}\e[0;90m"
}

# Prints an error to stderr, its lead-in before `: ` in bold, and keeps it for the trailer
PRINT_ERR () {
	local MSG="$1"
	# Remember the message for the status trailer in _GLOBAL_EXIT_TRAP
	_LAST_ERROR="$MSG"

	# Split at the first `: ` alone – a bare colon is a name's, as in `:x.txt`, or ends a lead-in
	MSG=${MSG//\\/$_LITB}
	if [[ "$MSG" == *": "* ]]; then
		local PREFIX="${MSG%%: *}"
		local REST="${MSG#*: }"
		ECHO_E $'\n'"\e[1;91m${PREFIX}:\e[0m\e[0;31m ${REST}\e[0m" >&2
	else
		ECHO_E $'\n'"\e[1;91m${MSG}\e[0m" >&2
	fi
}

# Gives every git this run spawns, once a run, the config the branch's checkout reads and a detached
# worktree misses – an `onbranch` include's identity or signing key, a relative `core.hooksPath`
# whose untracked hooks (husky's) only the checkout has – through an `includeIf` last in what
# `git -c` passes, so no other repository a command touches reads it, and no caller's `-c` wins
_ADOPT_CHECKOUT_CONFIG () {
	# Args: <worktree> <checkout>
	[ -n "$_CONFIG_ADOPTED" ] && return 0
	_CONFIG_ADOPTED=true
	local WT=$1 CO=$2 K HP GCD INC GPAT Q="'\\''"
	local -i I N=0
	local -a CL WL
	local -A CO_LAST WT_LAST
	# Scope and entry in turn, an entry a key and its value a newline apart – the worktree's own
	# scope differs by design, sparse settings say, and an entry with no value has no form to pin
	CL=("${(@0)$(git -C "$CO" config -l -z --show-scope 2>/dev/null)}")
	WL=("${(@0)$(git -C "$WT" config -l -z --show-scope 2>/dev/null)}")
	for (( I = 1; I + 1 <= ${#CL}; I += 2 )); do
		[ "${CL[I]}" != worktree ] && [[ "${CL[I + 1]}" == *$'\n'* ]] && CO_LAST[${CL[I + 1]%%$'\n'*}]=${CL[I + 1]#*$'\n'}
	done
	for (( I = 1; I + 1 <= ${#WL}; I += 2 )); do
		[[ "${WL[I + 1]}" == *$'\n'* ]] && WT_LAST[${WL[I + 1]%%$'\n'*}]=${WL[I + 1]#*$'\n'}
	done
	INC=$(MKTEMP_FILE git-edit-config)
	_TEMP_FILES+=("$INC")
	for K in "${(@k)CO_LAST}"; do
		[[ "$K" == (include|includeif).* ]] && continue
		(( ${+WT_LAST[$K]} )) && [ "${WT_LAST[$K]}" = "${CO_LAST[$K]}" ] && continue
		git config -f "$INC" "$K" "${CO_LAST[$K]}" 2>/dev/null && N+=1
	done
	HP=${CO_LAST[core.hookspath]}
	if [ -n "$HP" ] && [[ "$HP" != (/*|"~"*) ]] && [ -d "$CO/$HP" ]; then
		git config -f "$INC" core.hooksPath "${${:-$CO/$HP}:A}" && N+=1
	fi
	(( N )) || return 0
	GCD=$(git -C "$CO" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
	[ -n "$GCD" ] || return 0
	# A glob, so the path's own `[`, `*`, `?` or `\` escaped – and the worktrees one level deep, as
	# a submodule's git dir sits below a linked worktree's – single-quoted as git reads that list,
	# a quote inside closed and reopened, key and value apart as a path may hold `=`
	GPAT=${${GCD:A}//\\/\\\\}
	GPAT=${${${${GPAT//\[/\\[}//\]/\\]}//\*/\\*}//\?/\\?}
	export GIT_CONFIG_PARAMETERS="$GIT_CONFIG_PARAMETERS '${${:-includeif.gitdir:${GPAT}.path}//\'/$Q}'='${INC//\'/$Q}' '${${:-includeif.gitdir:${GPAT}/worktrees/*.path}//\'/$Q}'='${INC//\'/$Q}'"
}

# Symlinks gitignored paths named by `edit.worktreeLink` into a fresh worktree – a pause
# verifies the commit in isolation, but the project's own checks need what the checkout
# does not track, and links over copies keep a run from diverging from what is installed
# Settles first what the worktree reads as modified only through its
# attributes – each setup and resume passes here
_LINK_WORKTREE_EXTRAS () {
	local WT=$1
	local FROM=$2
	[ -z "$WT" ] || [ ! -d "$WT" ] && return 0
	_RENORM_SETTLE "$WT"
	[ -z "$FROM" ] && FROM=$(git rev-parse --show-toplevel 2>/dev/null)
	[ -z "$FROM" ] || [ ! -d "$FROM" ] && return 0
	_ADOPT_CHECKOUT_CONFIG "$WT" "$FROM"

	local -a EXTRAS
	EXTRAS=("${(@f)$(git config --get-all edit.worktreeLink 2>/dev/null)}")
	[ -n "$GIT_EDIT_WORKTREE_LINK" ] && EXTRAS+=("${(@s.:.)GIT_EDIT_WORKTREE_LINK}")

	local -a LINKED SKIPPED FAILED MISSING UNDER_LINK
	local P
	for P in "${EXTRAS[@]}"; do
		[ -z "$P" ] && continue
		# Only what the origin actually has, and never over a tracked path the
		# commit itself carries – the worktree's own content wins
		[ -e "$FROM/$P" ] || { MISSING+=("$P"); continue; }
		[ -e "$WT/$P" ] && continue
		# Under a symlink or a file the commit tracks, a link would land wherever that points –
		# the commit's own entry wins there too, whatever the ignore pattern says
		if _LEADING_NON_DIR "$WT" "$P"; then
			UNDER_LINK+=("$P"$'\n'"$REPLY")
			continue
		fi
		# An ignore pattern written for a directory (`node_modules/`) misses the symlink standing
		# in for it, so the link lands untracked where the directory was ignored – and
		# `--continue` stages the worktree wholesale, so skipping the link is the whole remedy
		if ! git -C "$WT" check-ignore -q "$P" 2>/dev/null; then
			SKIPPED+=("$P")
			continue
		fi
		# A nested path needs its parent to exist, or `ln` fails and the caller
		# gets silence where they configured something
		[[ "$P" == */* ]] && mkdir -p "$WT/${P:h}" 2>/dev/null
		if ! ln -sfn "$FROM/$P" "$WT/$P" 2>/dev/null; then
			FAILED+=("$P")
			continue
		fi
		LINKED+=("$P")
	done
	if [ ${#LINKED[@]} -gt 0 ]; then
		PRINT_TEXT "Linked into the worktree: %s" 90 "${(j:, :)LINKED}"
	fi
	if [ ${#SKIPPED[@]} -gt 0 ]; then
		PRINT_TEXT "Not linking %s – its ignore pattern doesn't cover a symlink, so the amend would commit it." 33 \
			"${(j:, :)SKIPPED}"
		PRINT_TEXT "Drop the trailing slash in %s to have it linked." 33 ".gitignore"
	fi
	for P in "${UNDER_LINK[@]}"; do
		PRINT_TEXT "Not linking %s – this commit tracks %s as a symlink or a file, which the worktree keeps, so a link through it would land outside." 33 \
			"${P%%$'\n'*}" "${P#*$'\n'}"
	done
	(( ${#UNDER_LINK} )) && PRINT_TEXT "No .gitignore change helps there – where a check needs it, run that check in your checkout instead." 33
	if [ ${#FAILED[@]} -gt 0 ]; then
		PRINT_TEXT "Could not link %s into the worktree – check the path." 33 "${(j:, :)FAILED}"
	fi
	# Said, since a check needing one fails on that alone, which reads as the rewrite's doing
	if [ ${#MISSING[@]} -gt 0 ]; then
		PRINT_TEXT "Not linking %s – %s has none to link." 33 "${(j:, :)MISSING}" "$FROM"
	fi
}

# Creates a temp dir or file from a full `$TMPDIR` path template – BSD/macOS `mktemp -t`
# takes its arg as a literal prefix and appends its own suffix, leaving the inner `XXXXXX`
# verbatim, while a full template has its trailing `X`s replaced on both GNU and BSD
MKTEMP_DIR () {
	local BASE="${TMPDIR:-/tmp}"
	mktemp -d "${BASE%/}/$1.XXXXXX"
}

# Makes a temp file named after <prefix> under `TMPDIR`, printing its path
MKTEMP_FILE () {
	local BASE="${TMPDIR:-/tmp}"
	mktemp "${BASE%/}/$1.XXXXXX"
}

# Prints <path> as `sh` reads one word, for a `GIT_EDITOR` or `GIT_SEQUENCE_EDITOR` stand-in – git
# runs a value holding a space or another shell character through `sh -c`, so a `TMPDIR` with one
# would split it or run what it holds – bare where nothing needs quoting
_SH_WORD () {
	# Args: <path>
	if [[ -n "$1" && "$1" != *[^A-Za-z0-9_./-]* ]]; then print -r -- "$1"; else print -r -- "${(qq)1}"; fi
}

# Emits the single-line status trailer in natural-language form, anchored by `git-edit:` for
# dispatch – agents `grep -E '^git-edit: (ok|error|conflict|paused)'`, and the forms are:
#   "git-edit: ok – <ref> moved <old-sha> → <new-sha>"
#   "git-edit: ok – <ref> unchanged[, <why>]"
#   "git-edit: error – exit code <N>"
#   "git-edit: conflict – resolve in <worktree> (<files>); then 'git edit --continue' or '… --abort'"
#   "git-edit: paused – <operation> <sha> in <worktree>; then 'git edit --continue' or '… --abort'"
EMIT_STATUS () {
	# Args: <new_head_sha> <ref> <changed:true|false> [<note on "unchanged">]
	# Directly above the trailer, where a reader after what checked the result already looks, and
	# named so one `^Verif` reaches it alongside the gate's own lines – only a run that declined a
	# gate says anything, an unconfigured repo staying as quiet as it always was
	if [ -n "$_VERIFY_BYPASSED" ]; then
		PRINT_TEXT "Verify skipped – %s was passed, so \`%s\` never ran" 90 "--no-verify" "$_VERIFY_BYPASSED"
		_VERIFY_BYPASSED=""
	fi
	_PRINT_DEFERRED_SIGNAL
	# A tip or ref read empty once the branch moved – its git call ended by the signal the landing
	# deferred – is the move the journal holds
	local NEW=$1 REF=$2
	local -a JM=(${=_JOURNALED_MOVE})
	if (( ${#JM} == 3 )) && [ -n "$_DEFERRED_SIGNAL" ]; then
		[ -n "$REF" ] || REF=${JM[1]}
		[ -n "$NEW" ] || [ "$REF" != "${JM[1]}" ] || NEW=${JM[3]}
	fi
	# What the run leaves to do, ahead of nothing but the trailer
	_PRINT_TODO
	# The SHAs are the authority, not the flag – some callers pass a hardcoded `true` where a
	# no-op rebase leaves `HEAD` put, and reporting a move there is a false success on `ok`
	if [ "$3" = "true" ] && [ "$NEW" != "$SCRIPT_INITIAL_HEAD" ]; then
		_EMIT_TRAILER "git-edit: ok – $REF moved $SCRIPT_INITIAL_HEAD → $NEW"
	else
		_EMIT_TRAILER "git-edit: ok – $REF unchanged${4:+, $4}"
	fi
	_STATUS_EMITTED=true
}

# Names the signal a landing run finished through, directly above the trailer – a caller that
# sent it would otherwise read the run as one that finished before it came
_PRINT_DEFERRED_SIGNAL () {
	[ -n "$_DEFERRED_SIGNAL" ] || return 0
	if [ -n "$_CANCELLED_PAUSE" ]; then
		PRINT_TEXT "SIG%s arrived once the pause was cleared – finished cancelling it rather than stop halfway" 90 "$_DEFERRED_SIGNAL"
	else
		PRINT_TEXT "SIG%s arrived once the branch had moved – finished the run rather than stop it halfway" 90 "$_DEFERRED_SIGNAL"
	fi
}

# Emits an `--exec --dry-run`'s outcome – nothing moved, and the SHA it built is what the caller
# came for, so it rides in the one line a `tail -1` or a `^git-edit:` grep is sure to reach
EMIT_DRY_RUN () {
	# Args: <built_sha> <base_sha> <ref>
	_EMIT_TRAILER "git-edit: ok – dry run built $1 on $2, $3 unchanged"
	_STATUS_EMITTED=true
}

# Emits the conflict trailer, naming the worktree to resolve in and its unmerged files
EMIT_CONFLICT () {
	# Args: <worktree-path> [<unmerged files, one per line>]
	local FILES_PART=""
	if [ -n "$2" ]; then
		FILES_PART=" (${(j:, :)${(f)2}})"
	fi
	_EMIT_TRAILER "git-edit: conflict – resolve in $1$FILES_PART; then 'git edit --continue' or 'git edit --abort'"
	_STATUS_EMITTED=true
}

# Emits the pause a mode takes by design, an edit or content split, rather than on a
# conflict – nothing is unmerged, there is just authoring left to do
EMIT_PAUSED () {
	# Args: <operation> <sha> <worktree-path>
	_EMIT_TRAILER "git-edit: paused – $1 ${2:0:7} in $3; then 'git edit --continue' or 'git edit --abort'"
	_STATUS_EMITTED=true
}

# Emits the pause a completed rewrite takes when its verification fails – the result
# is built but not applied, and the state stays, so the resolution work
# survives the verdict whichever way the caller decides
EMIT_VERIFY_PAUSED () {
	# Args: <failing-sha> <worktree-path> [<result-tip>]
	# Also marks the state file – `verify_failed` tells a later `--status` this pause from a
	# conflict, and `verify_result` records what a resume applies, the worktree's `HEAD` being
	[ "$STATE_VERIFY_FAILED" != "$1" ] && _STATE_NOTE "verify_failed=$1"
	[ -n "$3" ] && [ "$STATE_VERIFY_RESULT" != "$3" ] && _STATE_NOTE "verify_result=$3"
	# A driver greps the trailer, commonly through a `| tail -N` that cuts off
	# the run's own output printed above it – so the trailer carries the path
	local VLOG=$(_VERIFY_LOG_PATH)
	local LOGNOTE=""
	[ -n "$VLOG" ] && [ -f "$VLOG" ] && LOGNOTE="; output in $VLOG"
	_EMIT_TRAILER "git-edit: paused – verify failed at ${1:0:7} in $2$LOGNOTE; then 'git edit --continue' (re-verify), '--no-verify --continue' (apply anyway), or 'git edit --abort'"
	_STATUS_EMITTED=true
}

# Emits the pause a completed rewrite takes when its tip carries a file mode nothing asked for –
# built, not applied, the state kept, as a verify pause is, `mode_stray` marking it for `--status`
EMIT_MODE_PAUSED () {
	# Args: <commit-sha> <worktree-path> [<result-tip>]
	[ "$STATE_MODE_STRAY" != "$1" ] && _STATE_NOTE "mode_stray=$1"
	[ -n "$3" ] && [ "$STATE_VERIFY_RESULT" != "$3" ] && _STATE_NOTE "verify_result=$3"
	_EMIT_TRAILER "git-edit: paused – mode change at ${1:0:7} in $2; then 'git edit --continue' (re-check), '--allow-mode-change --continue' (apply anyway), or 'git edit --abort'"
	_STATUS_EMITTED=true
}

# Emits whichever gate refused a built result – the mode guard's pause, else the verify's
EMIT_GATE_PAUSED () {
	# Args: <worktree-path> [<result-tip>]
	if [ -n "$_MODE_STRAY_AT" ]; then
		EMIT_MODE_PAUSED "$_MODE_STRAY_AT" "$1" "$2"
	else
		EMIT_VERIFY_PAUSED "$_VERIFY_FAILED" "$1" "$2"
	fi
}

# Puts a rebase todo line into `REPLY`, its commit's subject added where the line names none – the
# reorder and drop todos carry full SHAs alone
_TODO_LINE_NAMED () {
	# Args: <worktree> <todo line>
	local -a W=(${=2})
	REPLY=$2
	[[ "$2" != *' # '* && "${W[2]}" =~ '^[0-9a-f]{40,64}$' ]] || return 0
	REPLY+=" # $(git -C "$1" log -1 --format=%s "${W[2]}" 2>/dev/null)"
}

# Prints the conflict context – unmerged files, the step we paused on, and what remains, so
# the resolver can tell a single resolution from a likely cascade
# Echoes the unmerged files comma-separated to stdout for the trailer, the rest to stderr
_PRINT_CONFLICT_DETAIL () {
	local WT=$1
	# Pre-op tip, passed by the reorder paths only – see the final-step hint below
	local PREOP=$2
	# The failed continue's captured output, passed by the resume paths – shown
	# where no unmerged file explains the failure
	local CONTINUE_OUTPUT=$3
	local GITDIR=$(git -C "$WT" rev-parse --git-dir 2>/dev/null)

	# Unmerged paths (files with conflict markers)
	local -a UNMERGED
	UNMERGED=(${(0)"$(_UNMERGED_IN "$WT")"})
	if (( ${#UNMERGED} )); then
		PRINT_TEXT "Conflicted files:" 33 >&2
		local FILE
		local -a MARKERLESS
		for FILE in "${UNMERGED[@]}"; do
			ECHO_E "\e[0;33m  - ${FILE//\\/$_LITB}\e[0m" >&2
			# A marker grep is how drivers decide "resolved" – but four states
			# arrive marker-free, and only one of them is a finished resolution
			_HAS_NEW_MARKERS "$WT" "$FILE" || MARKERLESS+=("$FILE")
		done
		if [ ${#MARKERLESS[@]} -gt 0 ]; then
			PRINT_TEXT "No conflict markers in %s – an add/add, a modify/delete, a rerere prefill, or a resolution left unstaged all read as finished. Validate the content, then stage it to resolve." 33 "${(j:, :)MARKERLESS}" >&2
		fi
	fi

	# Currently-failing rebase step (last line of the done log)
	if [ -f "$GITDIR/rebase-merge/done" ]; then
		local LAST_STEP
		LAST_STEP=$(tail -1 "$GITDIR/rebase-merge/done" 2>/dev/null)
		if [ -n "$LAST_STEP" ]; then
			PRINT_TEXT "Currently failing on:" 33 >&2
			_TODO_LINE_NAMED "$WT" "$LAST_STEP"
			ECHO_E "\e[0;33m  ${REPLY//\\/$_LITB}\e[0m" >&2
			# Which commit the stop builds, so its resolution is that commit's content – a fold's or a
			# squash's step amends the one before it, every other the commit it names
			local -a STEP_WORDS=(${=LAST_STEP})
			local BUILDS
			if [[ "${STEP_WORDS[1]}" == (f|fixup|s|squash) ]]; then
				# Named by its pick – past a chain's first step, `HEAD` is git's interim commit, its
				# message the squash template's comment lines
				BUILDS=$(_STOP_BUILDS "$WT")
				BUILDS=$(git -C "$WT" log -1 --format='%h %s' "${BUILDS:-HEAD}" 2>/dev/null)
				[ -n "$BUILDS" ] && PRINT_TEXT "This stop folds into %s itself – resolve to what that commit holds with the fold applied, not to what later commits make of it." 33 "$BUILDS" >&2
			elif [[ "${STEP_WORDS[1]}" == (p|pick|r|reword|e|edit) ]]; then
				BUILDS=$(git -C "$WT" log -1 --format='%h %s' "${STEP_WORDS[2]}" 2>/dev/null)
				[ -n "$BUILDS" ] && PRINT_TEXT "This stop builds %s – resolve to what that commit holds, not to what later commits make of it." 33 "$BUILDS" >&2
			fi
		fi
	fi

	# Remaining rebase steps (after the conflict resolves)
	local REMAINING=""
	if [ -f "$GITDIR/rebase-merge/git-rebase-todo" ]; then
		REMAINING=$(_REBASE_TODO_LEFT "$GITDIR")
		if [ -n "$REMAINING" ]; then
			PRINT_TEXT "Remaining steps (after resolution):" 33 >&2
			local STEP
			while IFS= read -r STEP; do
				_TODO_LINE_NAMED "$WT" "$STEP"
				ECHO_E "\e[0;33m  ${REPLY//\\/$_LITB}\e[0m" >&2
			done <<< "$REMAINING"
		fi
	fi

	# Which remaining steps touch a conflicted file – each reapplies its own change on top, so
	# the resolution is the content before they replay, never their result folded in early
	# Todo commands are read textually and walked in one `git log`, so replay length is free
	local -A TOUCHED_BY
	local WALK_OK=""
	if (( ${#UNMERGED} )) && [ -n "$REMAINING" ]; then
		local -a TODO_SHAS TODO_WORDS
		local TODO WORD
		for TODO in ${(f)REMAINING}; do
			TODO_WORDS=(${(z)TODO})
			case ${TODO_WORDS[1]} in
				pick|p|reword|r|edit|e|fixup|f|squash|s) ;;
				*) continue ;;
			esac
			# The object is not always the second word – `amend!` autosquashes
			# into `fixup -C <sha>`, and one bad rev would take the whole walk
			# down with it
			for WORD in "${TODO_WORDS[@]:1}"; do
				if [[ "$WORD" =~ '^[0-9a-f]{7,}$' ]]; then
					TODO_SHAS+=("$WORD")
					break
				fi
			done
		done
		if [ ${#TODO_SHAS[@]} -gt 0 ]; then
			# `%h %s` records are marked with a byte no path can start with, so the walk's own output
			# separates the headers from the names – read NUL-separated, as the line form C-quotes a
			# name with a quote or backslash, and the first after a header leads with a newline
			local -a WALKED
			# Both sides of a rename, as a step moving a conflicted file away touches it too
			WALKED=("${(@0)$(git -C "$WT" log -z --no-walk=unsorted --root --ignore-missing --no-renames --format=$'\1%h %s' --name-only "${TODO_SHAS[@]}" 2>/dev/null)}")
			local SUBJECT="" LINE
			local -i WALKED_N=0
			for LINE in "${WALKED[@]}"; do
				LINE=${LINE#$'\n'}
				if [[ "$LINE" == $'\1'* ]]; then
					SUBJECT=${LINE#$'\1'}
					WALKED_N+=1
				elif [ -n "$LINE" ] && (( ${UNMERGED[(Ie)$LINE]} )); then
					TOUCHED_BY[$LINE]+="$SUBJECT"$'\n'
				fi
			done
			# Every remaining step walked, so a file none of them touches is known untouched
			(( WALKED_N == ${#TODO_SHAS} )) && WALK_OK=1
			if [ ${#TOUCHED_BY[@]} -gt 0 ]; then
				PRINT_TEXT "Remaining steps also touch a conflicted file – each replays its own change on top, so resolve to what this stop's commit holds, before them:" 33 >&2
				local FILE_KEY TOUCHER
				for FILE_KEY in "${UNMERGED[@]}"; do
					[ -z "${TOUCHED_BY[$FILE_KEY]}" ] && continue
					ECHO_E "\e[0;33m  ${FILE_KEY//\\/$_LITB}\e[0m" >&2
					for TOUCHER in ${(f)TOUCHED_BY[$FILE_KEY]}; do
						ECHO_E "\e[0;33m    ${TOUCHER//\\/$_LITB}\e[0m" >&2
					done
				done
			fi
		fi
	fi

	# Reordering preserves the tree, so its final step has one determined result – the pre-op
	# content – while earlier steps rebuild an intermediate that never existed, so their
	# content is authored rather than derived
	if [ -n "$PREOP" ] && (( ${#UNMERGED} )) && [ -s "$GITDIR/rebase-merge/end" ]; then
		local -a STEPS=(${=$(_REBASE_STEP "$GITDIR")})
		local STEP_NOW=${STEPS[1]}
		local STEP_END=${STEPS[2]}
		# A file no later step touches ends as this step leaves it, which the tree being preserved
		# pins to the pre-op content – only the rest rebuild a state that never existed – and where
		# the step's `HEAD` holds that content already, its commit is left no change there
		local -a EXACT AUTHORED EMPTIED
		local FK
		for FK in "${UNMERGED[@]}"; do
			if [ "$STEP_NOW" != "$STEP_END" ] && { [ -z "$WALK_OK" ] || (( ${+TOUCHED_BY[$FK]} )); }; then
				AUTHORED+=("$FK")
			elif [ "$(git -C "$WT" rev-parse -q --verify "HEAD:$FK" 2>/dev/null)" = \
				"$(git -C "$WT" rev-parse -q --verify "$PREOP:$FK" 2>/dev/null)" ]; then
				EMPTIED+=("$FK")
			else
				EXACT+=("$FK")
			fi
		done
		if [ "$STEP_NOW" = "$STEP_END" ]; then
			if (( ${#EXACT} )); then
				PRINT_TEXT "Final step – a reorder preserves the tree, so the resolution is exactly the pre-op content:" 33 >&2
				ECHO_E "\e[0;33m  $(_LIT "$(_PATHS_CMD "git -C $(_SHQ "$WT") checkout ${PREOP:0:12}" "${EXACT[@]}")")\e[0m" >&2
				(( ${#EMPTIED} )) || ECHO_E "\e[0;33m  git edit --continue\e[0m" >&2
			fi
		else
			if (( ${#EXACT} )); then
				PRINT_TEXT "No later step touches %s – a reorder preserves the tree, so the resolution there is exactly the pre-op content:" 33 "$(_SOME_PATHS "${EXACT[@]}")" >&2
				ECHO_E "\e[0;33m  $(_LIT "$(_PATHS_CMD "git -C $(_SHQ "$WT") checkout ${PREOP:0:12}" "${EXACT[@]}")")\e[0m" >&2
			fi
			if (( ${#AUTHORED} )); then
				PRINT_TEXT "Step %s rebuilds a state that never existed for %s – author its content rather than deriving it:" 33 "$STEP_NOW/$STEP_END" "$(_ALL_PATHS "${AUTHORED[@]}")" >&2
				ECHO_E "\e[0;33m  'git apply --3way' cannot work here at all (mid-rebase the paths sit at conflicted stages, not stage 0),\e[0m" >&2
				ECHO_E "\e[0;33m  and reverse-applying the other commit's diff tends to fail once its context has shifted.\e[0m" >&2
			fi
		fi
		(( ${#EMPTIED} )) && _PRINT_EMPTIED_STOP "$WT" "$GITDIR" "${EMPTIED[@]}"
	fi

	# No conflicted files under a paused rebase means nothing left to resolve – a staged tree
	# matching `HEAD` proves the step went empty, where staged content instead means the
	# continue failed some other way and the skip hint would throw it away
	if (( ! ${#UNMERGED} )) && [ -d "$GITDIR/rebase-merge" ]; then
		# A change left unstaged refuses the continue whatever is staged – read once files that read as
		# modified only through their attributes are settled, as no resume stops over those
		_RENORM_SETTLE "$WT"
		local -a UNSTAGED
		UNSTAGED=(${(0)"$(git -C "$WT" diff-files -z --name-only --ignore-submodules 2>/dev/null)"})
		if (( ${#UNSTAGED} )); then
			PRINT_TEXT "No conflicted files, yet changes left unstaged in %s refuse the continue – git resumes from staged content only. Stage what the resolution needs, restore the rest, then: git edit --continue" 33 "$(_SOME_PATHS "${UNSTAGED[@]}")" >&2
			ECHO_E "\e[0;33m  $(_LIT "$(_PATHS_CMD "git -C $(_SHQ "$WT") add" "${UNSTAGED[@]}")")\e[0m" >&2
			ECHO_E "\e[0;33m  $(_LIT "$(_PATHS_CMD "git -C $(_SHQ "$WT") restore" "${UNSTAGED[@]}")")\e[0m" >&2
		# A placement's own commit gone empty has nothing to place – a skip would land another tree
		elif git -C "$WT" diff-index --cached --quiet --ignore-submodules=none HEAD -- 2>/dev/null && LC_ALL=C grep -q '^placed=' "$(_STATE_FILE_PATH)" 2>/dev/null; then
			PRINT_TEXT "No conflicted files – the current step became empty: its change is already there beside the anchor, so the placement cannot land. Cancel it with %s, then commit at the tip or beside another anchor." 33 "git edit --abort" >&2
		# Left out by git-edit's own continue, which the guard on lost commits reads as the caller's call
		# – a hand `git rebase --skip` loses it, and under a caller's `commit.cleanup` rewrites the
		# messages of the commits after it
		elif git -C "$WT" diff-index --cached --quiet --ignore-submodules=none HEAD -- 2>/dev/null; then
			PRINT_TEXT "No conflicted files – the current step became empty: its changes are already upstream, or a resolution replayed within this run produced them. Continuing drops that commit:" 33 >&2
			ECHO_E "\e[0;33m  git edit --continue\e[0m" >&2
			# A reorder keeps its tree, so dropping one lands only where an earlier commit repeats the change
			LC_ALL=C grep -qx 'operation=reorder' "$(_STATE_FILE_PATH)" 2>/dev/null && \
				PRINT_TEXT "A reorder only moves commits – where no earlier commit makes the same change, dropping it changes the tree and the continue refuses; then %s." 33 "git edit --abort" >&2
		else
			PRINT_TEXT "No conflicted files, yet staged changes remain – the continue failed without leaving a conflict. Retry: git edit --continue" 33 >&2
			# Which bookkeeping files the paused rebase holds – a continue that
			# refuses over staged changes means `message` went missing at the
			# stop, and the present-vs-absent pattern names where that failed
			PRINT_TEXT "Rebase bookkeeping present: %s" 33 "$(ls "$GITDIR/rebase-merge" 2>/dev/null | tr '\n' ' ')" >&2
		fi
		if [ -n "$CONTINUE_OUTPUT" ]; then
			# -15: git's refusals put the error above a multi-paragraph advice
			# block, which a short tail would show instead of the cause
			PRINT_TEXT "The continue itself said:" 33 >&2
			print -r -- "$CONTINUE_OUTPUT" | _DROP_OWN_STEPS | tail -15 | _CARET_LINES --crlf | LC_ALL=C sed 's/^/  /' >&2
		fi
	fi

	# The unmerged list on stdout for the trailer
	print -r -- "${(F)UNMERGED}"
}

# Names the files a reorder's or placement's stop starts from at their pre-op content – resolved
# so, the stop's commit keeps no change of its own there, which the continue refuses as absorbed –
# and the way on that refusal names: a placement past that commit, a reorder keeping the order of
# the two, or a squash
_PRINT_EMPTIED_STOP () {
	# Args: <worktree> <its git dir> <file>...
	local WT=$1 GITDIR=$2 S="" M="" O LABEL K="" SF=$(_STATE_FILE_PATH)
	shift 2
	local -a W
	W=(${=$(tail -1 "$GITDIR/rebase-merge/done" 2>/dev/null)})
	[[ "${W[1]}" == (p|pick|r|reword|e|edit) ]] && S=$(git -C "$WT" rev-parse -q --verify "${W[2]}^{commit}" 2>/dev/null)
	[ -n "$S" ] || return 0
	PRINT_TEXT "This step starts from the pre-op content of %s already – resolved to it, %s keeps no change of its own there, which the continue refuses as emptied:" 33 \
		"$(_SOME_PATHS "$@")" "$(git -C "$WT" log -1 --format='%h %s' "$S" 2>/dev/null)" >&2
	LABEL=$(LC_ALL=C sed -n 's/^place_label=//p' "$SF" 2>/dev/null | tail -1)
	if [ -n "$LABEL" ] && LC_ALL=C grep -q '^placed=' "$SF" 2>/dev/null; then
		ECHO_E "\e[0;33m  Its change there is what the placed one builds on – cancel with 'git edit --abort', then run it again placed past that change: --after=${S:0:12} in place of --${${LABEL#* }%% *}=${LABEL##* }\e[0m" >&2
		return 0
	fi
	# The latest commit replayed before it that changes one of those files, which holds that change
	for O in ${(Oa)${(f)"$(LC_ALL=C sed '$d' "$GITDIR/rebase-merge/done" 2>/dev/null | LC_ALL=C awk '$1 ~ /^(p|pick|r|reword|e|edit)$/ { print $2 }')"}}; do
		O=$(git -C "$WT" rev-parse -q --verify "$O^{commit}" 2>/dev/null) || continue
		[ "$O" != "$S" ] && [ -n "$(git -C "$WT" --literal-pathspecs diff-tree -r --root --no-commit-id --name-only --no-renames "$O" -- "$@" 2>/dev/null)" ] || continue
		M=$O
		break
	done
	# Older first, as the absorption guard's squash names them – a move only where one came between
	if [ -n "$M" ] && git -C "$WT" merge-base --is-ancestor "$S" "$M" 2>/dev/null; then
		K=" – where ${M:0:12}'s change builds on ${S:0:12}'s, keep their order"
		[ "$(git -C "$WT" rev-parse -q --verify "$M^" 2>/dev/null)" != "$S" ] && \
			K+=" by moving it right after that commit instead: $(_LIT "git edit --move=${M:0:12} --after=${S:0:12}")"
		K+=", or squash the two into one: $(_LIT "git edit -s=${S:0:12} ${M:0:12}")"
	elif [ -n "$M" ]; then
		K=", or squash the two into one: $(_LIT "git edit -s=${M:0:12} ${S:0:12}")"
	fi
	ECHO_E "\e[0;33m  Cancel with 'git edit --abort', then run it again, resolving each stop to its own commit's change alone on what the new order puts before it${K:-.}\e[0m" >&2
}

# Names the file-mode changes a rewrite landed, tip vs pre-op tip – a diffstat shows line
# counts only, so a changed executable bit rides invisibly and resurfaces as a phantom
# mode-only diff, and `--onto` is exempt since its tip diff carries the upstream's changes
_PRINT_MODE_CHANGES () {
	# Args: <old-tip> <new-tip>
	[ -n "$_IN_LANDED_STEP" ] || { _LANDED_STEP "$0" "$@"; return; }
	# Not `LINES` – that name is zsh's tied terminal-height integer, which
	# rejects the assignment as a math error
	local MODE_LINES
	MODE_LINES=$(git diff --summary "$1" "$2" 2>/dev/null | LC_ALL=C grep -a '^ mode change')
	[ -z "$MODE_LINES" ] && return 0
	PRINT_TEXT "Mode changes landed:" 33
	print -r -- "$MODE_LINES" | _CARET_LINES | LC_ALL=C sed "s/^ /  /;s/^/${_DIM}/;s/\$/${_OFF}/"
}

# Resolves the canonical ref name to report – `$ORIG_BRANCH` when set, since `-C` mode
# captures it before entering a detached worktree, else the symbolic ref, else "HEAD"
_CURRENT_REF () {
	if [ -n "$ORIG_BRANCH" ]; then
		echo "refs/heads/$ORIG_BRANCH"
		return
	fi
	local B=${$(git symbolic-ref -q HEAD 2>/dev/null)#refs/heads/}
	if [ -n "$B" ]; then
		echo "refs/heads/$B"
	else
		echo "HEAD"
	fi
}

# Prints the success banner and status trailer together
PRINT_COMPLETED () {
	# Args: <new_head_sha> <ref> <changed:true|false> [<note on "unchanged">]
	[ -n "$_PAD" ] && ECHO_E "${_PAD}\e[1;92mgit edit completed.\e[0m"
	EMIT_STATUS "$1" "$2" "$3" "$4"
}

# Reports whether a commit already exists on a remote – unlike `_GUARD_UNPUSHED` it only says so,
# and ignores `--allow-pushed` so callers can still tell shared history apart after consent
_IS_PUSHED () {
	[ -n "$(_REMOTES_CONTAINING "$1")" ]
}

# Lists the remote-tracking branches holding <commit>, one a line, their `origin/HEAD` aliases left
# out – through `for-each-ref`, as `git branch` lays its list out in a caller's columns and colors
_REMOTES_CONTAINING () {
	git for-each-ref --contains "$1" --format='%(if)%(symref)%(then)%(else)%(refname:short)%(end)' refs/remotes 2>/dev/null | LC_ALL=C grep -a .
}

# Refuses a commit that already exists on a remote – guarding the oldest commit an operation
# touches covers the whole span, since every descendant of an unpushed commit is unpushed too
# Override with `--allow-pushed`
_GUARD_UNPUSHED () {
	[ ${#OPT_ALLOW_PUSHED} -gt 0 ] && return 0
	local C=$1
	local CONTAINING=$(_REMOTES_CONTAINING "$C" | head -3 | tr '\n' ' ' | LC_ALL=C sed 's/ $//')
	if [ -n "$CONTAINING" ]; then
		PRINT_ERR "Commit ${C:0:7} is already pushed (on: $CONTAINING)"
		ECHO_E "\e[0;31m  Rewriting pushed history disrupts collaborators – pass --allow-pushed to override.\e[0m" >&2
		exit 1
	fi
}

# Computes the stable patch id of a commit's own diff – the same change keeps it across a rewrite,
# the SHA and tree move, and `--root` gets the initial commit one instead of an empty diff
_PATCH_ID () {
	git diff-tree -p --root "$1" 2>/dev/null | git patch-id --stable 2>/dev/null | awk '{print $1}'
}

# Prints a commit's message as git's comment and whitespace cleanup leaves it – a resolution
# committed by hand at a stop with `--no-edit` keeps its `# Conflicts:` lines, which this drops
_CLEAN_MESSAGE () {
	# Args: <commit> [<worktree>]
	git -C "${2:-.}" log -1 --format=%B "$1" -- 2>/dev/null | git -C "${2:-.}" stripspace --strip-comments 2>/dev/null
}

# Finds the current identity of a rewritten commit, echoing "<sha> <how>" – an identical patch
# id proves the same change and is acted on, while a fold keeps only the subject and is merely
# suggested, both needing a unique match, with a pushed hit left to the pushed guard
_RESOLVE_STALE () {
	# Args: <commit> [<tip>] – the history searched is `HEAD`'s unless a tip is named
	local C=$1
	local TIP=${2:-HEAD}
	local -a MATCHES
	local HIT

	# Every rewrite preserves the author date, so it prunes the patch-id scan to a handful and
	# can only narrow the field – a candidate dropped here could only have been a false match
	# One past the ceiling notices a view too large to call unique, so it falls back to suggesting
	local WHEN=$(git log -1 --format='%aI' "$C" 2>/dev/null)
	local WANT=$(_PATCH_ID "$C")
	if [ -n "$WHEN" ] && [ -n "$WANT" ]; then
		local -a POOL
		POOL=($(git log --format='%H %aI' "$TIP" 2>/dev/null \
			| awk -v w="$WHEN" '$2 == w { print $1 }' | head -$((RESOLVE_SCAN_MAX + 1))))
		if [ ${#POOL[@]} -gt 0 ] && [ ${#POOL[@]} -le $RESOLVE_SCAN_MAX ]; then
			MATCHES=()
			for HIT in "${POOL[@]}"; do
				[ "$(_PATCH_ID "$HIT")" = "$WANT" ] && MATCHES+=("$HIT")
			done
			if [ ${#MATCHES[@]} -eq 1 ]; then
				echo "${MATCHES[1]} patch-id"
				return 0
			fi
		fi
	fi

	# One `git log` pass, so no ceiling is needed here – the SHA is stripped by field rather
	# than by splitting on tabs, so a subject containing one still compares whole, and it
	# arrives through the environment, as `-v` would read its backslashes as escapes
	local SUBJECT=$(git log -1 --format='%s' "$C" 2>/dev/null)
	if [ -n "$SUBJECT" ]; then
		MATCHES=($(git log --format='%H%x09%s' "$TIP" 2>/dev/null \
			| S=$SUBJECT awk '{ sha = $1; sub(/^[^\t]*\t/, ""); if ($0 == ENVIRON["S"]) print sha }'))
		if [ ${#MATCHES[@]} -eq 1 ]; then
			echo "${MATCHES[1]} subject"
			return 0
		fi
	fi
	return 1
}

# Prints the commit or tree <rev> names as a full SHA, failing where it names none – resolved
# before the peel, as a `^{commit}` after a `:/<text>` search would join its text
_PEEL_SHA () {
	# Args: <rev> <commit|tree>
	local SHA
	SHA=$(git rev-parse -q --verify "$1" 2>/dev/null) && git rev-parse -q --verify "$SHA^{$2}" 2>/dev/null
}

# Resolves a commit to its current identity in `_RESOLVED_SHA`, or refuses – a miss is usually
# a stale SHA an earlier rewrite orphaned, so a proven match is substituted outright and a
# merely likely one only named, and the global lets `exit` abort with the trailer intact
_GUARD_REACHABLE () {
	# Args: <commit> [<what it is, in place of "Commit" in a refusal>]
	local C=$1 WHAT=${2:-Commit} KIND
	_RESOLVED_SHA=$C
	if git merge-base --is-ancestor "$C" HEAD 2>/dev/null; then
		# Normalize short SHAs/refs to the full SHA – downstream exact-match
		# steps (topo sort's `grep -Fx`, rebuild maps) silently miss otherwise,
		# falling back to the tie-prone timestamp sort
		_RESOLVED_SHA=$(_PEEL_SHA "$C" commit)
		return 0
	fi

	# A tree or blob exists all the same, just as nothing a commit can be rewritten into
	local SHA_C
	if ! SHA_C=$(_PEEL_SHA "$C" commit); then
		if KIND=$(git cat-file -t "$(git rev-parse -q --verify "$C" 2>/dev/null)" 2>/dev/null); then
			PRINT_ERR "${2:+$2 }${C:0:7} names a $KIND, not a commit"
		else
			PRINT_ERR "$WHAT ${C:0:7} does not exist in this repository"
		fi
		exit 1
	fi
	local SUBJECT=$(git log -1 --format='%s' "$SHA_C" 2>/dev/null)

	local -a RESOLVED
	[ ${#GIT_EDIT_NO_RESOLVE} -eq 0 ] && RESOLVED=($(_RESOLVE_STALE "$SHA_C"))

	# An inferred target never reaches pushed history, even under `--allow-pushed` – that flag
	# consents to the commit the caller named, not to one resolved on its behalf, so where a
	# guess would compound with a shared-history rewrite, name the match and let them ask
	if [ "${RESOLVED[2]}" = "patch-id" ] && _IS_PUSHED "${RESOLVED[1]}"; then
		PRINT_ERR "$WHAT ${C:0:7} ($SUBJECT) is not in HEAD's history – it was likely rewritten"
		ECHO_E "\e[0;31m  Its only match ${RESOLVED[1]:0:12} is already pushed – name it explicitly to rewrite it.\e[0m" >&2
		exit 1
	fi

	if [ "${RESOLVED[2]}" = "patch-id" ]; then
		PRINT_TEXT "Commit %s was rewritten – using its current identity %s (identical diff)" 33 \
			"${C:0:7}" "${RESOLVED[1]:0:12}"
		_RESOLVED_SHA=${RESOLVED[1]}
		return 0
	fi

	PRINT_ERR "$WHAT ${C:0:7} ($SUBJECT) is not in HEAD's history – it was likely rewritten"
	if [ "${RESOLVED[2]}" = "subject" ]; then
		ECHO_E "\e[0;31m  Its counterpart on HEAD is ${RESOLVED[1]:0:12} (same subject, changed content) – retry with that.\e[0m" >&2
	else
		ECHO_E "\e[0;31m  Re-read the current SHAs with 'git log' before retrying.\e[0m" >&2
	fi
	exit 1
}

# Peels one end of a positional range to its commit's SHA in `_RESOLVED_SHA` – a refusal names
# the range and which end failed
_GUARD_RANGE_END () {
	# Args: <range as given> <start|end> <rev>
	local KIND
	_RESOLVED_SHA=$(_PEEL_SHA "$3" commit) && return 0
	if KIND=$(git cat-file -t "$(git rev-parse -q --verify "$3" 2>/dev/null)" 2>/dev/null); then
		PRINT_ERR "Invalid commit range: $1 – its $2 $3 names a $KIND, not a commit"
	else
		PRINT_ERR "Invalid commit range: $1 – its $2 $3 names nothing in this repository"
	fi
	exit 1
}

# Refuses a merge in the span, since rebase-based modes replay every commit up to `HEAD` and
# drops merge commits without a word – so refuse, since the plumbing modes rebuild them whole
_GUARD_NO_MERGE_SPAN () {
	local BASE=$1
	local SPAN="HEAD"
	git rev-parse --verify -q "$BASE^" >/dev/null 2>&1 && SPAN="$BASE^..HEAD"
	local MERGES=$(git rev-list --merges --count "$SPAN" 2>/dev/null)
	if [ "${MERGES:-0}" -gt 0 ]; then
		PRINT_ERR "Span ${BASE:0:7}..HEAD contains a merge commit – this rebase-based mode would silently flatten it"
		ECHO_E "\e[0;31m  Merge-preserving alternatives: -M / -S / --split (plumbing), or --exec with 'git rebase --rebase-merges ...' deliberately.\e[0m" >&2
		exit 1
	fi
}

# Names the journal of completed ref moves, one line each ("<epoch> <ref> <old> <new> <label>", a
# tab and the caller's label closing a labeled run's), in the common git dir so worktrees share
# it – powers `--undo` and `--status`'s last-operation report
_JOURNAL_FILE_PATH () {
	local DIR=$(git rev-parse --git-common-dir 2>/dev/null)
	[ -z "$DIR" ] && return 1
	case "$DIR" in
		/*) ;;
		*) DIR="$(pwd)/$DIR" ;;
	esac
	print -r -- "$DIR/git-edit-journal"
}

# Rewrites the journal with <line>'s newest copy taken out and <entry> appended, as an undo does
_JOURNAL_REPLACE () {
	# Args: <journal> <line> <entry>
	local -a JLINES
	local -i I
	local READ WAS LN=ln MV=mv
	# Builtins where zsh has them – an undo rewrites it once its branch moved, where a signal to the
	# whole process group would end a forked `mv` before the entry is in
	(( ${+builtins[zf_ln]} && ${+builtins[zf_mv]} )) && LN=zf_ln MV=zf_mv
	READ=$(<"$1")
	JLINES=("${(@f)READ}")
	for (( I = ${#JLINES}; I >= 1; I-- )); do
		[ "${JLINES[I]}" = "$2" ] || continue
		JLINES[I]=()
		break
	done
	JLINES+=("$3")
	print -rl -- "${JLINES[@]}" > "$1.$$" 2>/dev/null || return 0
	# A line appended without the lock since the read goes to the file being replaced, kept by a
	# link and carried over from it
	$LN -f "$1" "$1.was.$$" 2>/dev/null
	$MV "$1.$$" "$1" 2>/dev/null
	[ -f "$1.was.$$" ] || return 0
	WAS=$(<"$1.was.$$")
	[ "$WAS" = "$READ" ] || print -r -- "${WAS#"$READ"$'\n'}" >> "$1"
	_LANDED_RUN rm -f "$1.was.$$"
}

# Sets `_LOCK_MARK`, what a lock this run takes holds – its pid and that process's start time, which
# a pid the system hands to another process later never matches
# • A start time it can't read – `ps` failing to fork or denied – goes as `-`, never left out, as a
#   pid alone is an older build's, broken once 60 s old while its pid lives
_LOCK_MARK_SET () {
	[ -n "$_LOCK_MARK" ] && return 0
	_PID_START $$
	_LOCK_MARK="$$ ${REPLY:--}"
}

# Puts <pid>'s start time into `REPLY` – empty where no such process runs, or nothing can tell
# Linux's `/proc` counts it in ticks since boot, which a clock set later leaves alone, while `ps`
# derives it from the boot time that moves with it there – elsewhere `ps`, under one zone and
# locale whoever asks, its spacing evened
_PID_START () {
	# Args: <pid>
	local S
	if [ -r "/proc/$1/stat" ]; then
		S=""
		{ S=$(<"/proc/$1/stat") } 2>/dev/null
		# Its 22nd field, counted past the command name, which may hold spaces or parentheses
		S=${S##*\) }
		REPLY=${${(s: :)S}[20]}
		return 0
	fi
	local -x TZ=UTC0 LC_ALL=C
	S=$(ps -o lstart= -p "$1" 2>/dev/null)
	REPLY=${(j: :)${=S}}
}

# Puts <pid>'s parent into `REPLY` – empty where no such process runs, or nothing can tell
# Linux's `/proc` read first, as a minimal image has no `ps` and BusyBox's takes no `-p`
_PID_PARENT () {
	# Args: <pid>
	local S=""
	if [ -r "/proc/$1/stat" ]; then
		{ S=$(<"/proc/$1/stat") } 2>/dev/null
		# Its 4th field, counted past the command name, as `_PID_START` counts
		S=${S##*\) }
		REPLY=${${(s: :)S}[2]}
		return 0
	fi
	REPLY=${$(ps -o ppid= -p "$1" 2>/dev/null)//[[:space:]]/}
}

# Tells whether lock <file> is stale – gone, its process gone or another started since under its
# pid, or naming no pid yet 10 s old, as its holder may still be writing it
_LOCK_STALE () {
	# Args: <file>
	[ -e "$1" ] || return 0
	# Read with the shell's own errors silenced – one let go of since the check says so otherwise
	local HOLDER=""
	{ HOLDER=$(<"$1") } 2>/dev/null
	local PID=${HOLDER%% *}
	local -a OLD
	if [[ "$PID" != <-> ]]; then
		[ -e "$1" ] || return 0
		OLD=("$1"(Nms+10))
		(( ${#OLD} ))
		return
	fi
	[[ "$HOLDER" != *' '* ]] || { _HOLDER_GONE "$HOLDER"; return; }
	# Another user's process lives though signaling it fails – `/proc` or `ps` lists it all the same
	kill -0 "$PID" 2>/dev/null || [ -e "/proc/$PID" ] || LC_ALL=C ps -p "$PID" >/dev/null 2>&1 || return 0
	_PID_START "$PID"
	# One naming its pid alone where start times can be told is an older version's, held past the
	# journal's 60 s wait by no live run of it – its pid reused, say
	[ -n "$REPLY" ] || return 1
	OLD=("$1"(Nms+60))
	(( ${#OLD} ))
}

# Tells whether the holder <pid start> a lock or mark names is gone – no such process, or another
# started since under its pid – never where it names no pid, nor while its pid lives where it names
# no start time to tell by – a pid alone, or `-` where its run could not read its own
_HOLDER_GONE () {
	# Args: <holder>
	local PID=${1%% *}
	[[ "$PID" == <-> ]] || return 1
	# Another user's process lives though signaling it fails – `/proc` or `ps` lists it all the same
	kill -0 "$PID" 2>/dev/null || [ -e "/proc/$PID" ] || LC_ALL=C ps -p "$PID" >/dev/null 2>&1 || return 0
	[[ "$1" == *' '* && "${1#* }" != - ]] || return 1
	_PID_START "$PID"
	[ -n "$REPLY" ] && [ "$REPLY" != "${1#* }" ]
}

# Breaks lock <file> where it is stale, through a second name for the same file, which one run at a
# time can make – the lock goes only once that run sees it still stale there, so a fresh one another
# run took meanwhile stays in place, never missing for a third to take as well
# Returns 1 where its holder lives, 2 where no second name can be made for want of a link
_LOCK_BREAK () {
	# Args: <lock file>
	local ERR
	local -a OLD
	_LOCK_STALE "$1" || return 1
	# A lock left as a directory, which no run takes, goes as it is – no link can name one
	if [ -d "$1" ]; then
		rm -rf "${1:?}"
		return 0
	fi
	# A second name left by a run that died breaking goes once 10 s old – its link set the ctime
	OLD=("$1.break"(Ncs+10))
	(( ${#OLD} )) && rm -f "$1.break"
	if ERR=$(LC_ALL=C ln "$1" "$1.break" 2>&1); then
		# Moved aside before it goes, and put back where what moved is not the stale one – a fresh lock
		# another run took once a stall here outlasted the second name's 10 s
		if _LOCK_STALE "$1.break" && [ "$1" -ef "$1.break" ] && mv -f "$1" "$1.gone.$$" 2>/dev/null; then
			[ "$1.gone.$$" -ef "$1.break" ] || ln "$1.gone.$$" "$1" 2>/dev/null
			rm -f "$1.gone.$$"
		fi
		rm -f "$1.break"
	# A link failing for want of one, not because another run is breaking it or the lock went – a
	# fresh one taken since in its place – would read as in use for good
	elif [ -e "$1" ] && [ ! -e "$1.break" ] && [[ "$ERR" != *([Ee]xists|[Nn]o such file)* ]]; then
		return 2
	fi
	return 0
}

# Takes the journal's lock, as git takes the index's – every append, an undo's rewrite and each
# write to the pause slot hold it, so none lands between another's read and its write – waiting
# while its holder lives, up to 60 s for a landing behind a slow `reference-transaction` hook, and
# breaking one whose holder is gone
# Fails where the wait runs out (1), no second name can be made to break a stale one (2), or its
# holder is a run this one runs under (3), the holder's pid in `REPLY` – the caller refuses, as
# going on without it is what the lock stops
_JOURNAL_LOCK () {
	# Args: <journal>
	local -i W=0 RC N END
	local HOLDER UP
	_LOCK_MARK_SET
	# By the clock too – each try's `ps` and forks stretched 600 of them past 70 s
	zmodload zsh/datetime 2>/dev/null
	END=$(( EPOCHSECONDS + 60 ))
	# Let go of however the run ends – named before the create, so a signal right after it finds it,
	# as the release takes only a lock naming this run
	_JOURNAL_HELD=$1
	until ( setopt noclobber; print -r -- "$_LOCK_MARK" > "$1.lock" ) 2>/dev/null; do
		HOLDER=""
		{ HOLDER=$(<"$1.lock") } 2>/dev/null
		# One naming this very process is its own, from before the exec a terminal's resume runs in
		[ "$HOLDER" = "$_LOCK_MARK" ] && return 0
		# Its holder asked after at the first try and each second on, the lock tried every tenth
		RC=1
		if (( W % 10 == 0 )); then
			_LOCK_BREAK "$1.lock"
			RC=$?
		fi
		# A live holder this run runs under – a landing whose `reference-transaction` hook runs it –
		# lets go only once this one ends, so no wait gets past it
		if (( RC == 1 && W == 0 )); then
			UP=$PPID N=0
			while [[ "$UP" == <2-> ]] && (( ++N < 64 )); do
				if [ "$UP" = "${HOLDER%% *}" ]; then
					_JOURNAL_HELD=""
					REPLY=$UP
					return 3
				fi
				_PID_PARENT "$UP"
				UP=$REPLY
			done
		fi
		if (( RC == 2 || ++W > 600 || EPOCHSECONDS > END )); then
			_JOURNAL_HELD=""
			REPLY=${HOLDER%% *}
			(( RC == 2 )) && return 2
			return 1
		fi
		(( RC == 0 )) || sleep 0.1
	done
	return 0
}

# Lets go of the journal's lock where it is still this run's – a waiter that broke it as stale holds
# it now, which this run removing it would hand to a third
_JOURNAL_UNLOCK () {
	# Args: <journal>
	[ -n "$_LOCK_MARK" ] && { [ "$(<"$1.lock")" = "$_LOCK_MARK" ]; } 2>/dev/null && rm -f "$1.lock"
	_JOURNAL_HELD=""
}

# Takes the hold on a checkout's sync from before its branch moves until that sync is done, so the
# next run's sync reads no file this one is still writing – read old, the next would merge this
# one's change back out as an uncommitted edit – waiting up to 30 s while its holder lives and
# breaking one whose holder is gone, as the journal's lock does
# Fails where the wait runs out, `_SYNC_HELD` then `-`, so the run lands and leaves that checkout
_SYNC_HOLD_TAKE () {
	# Args: <hold file in the checkout's git dir>
	local -i W=0 RC END
	_LOCK_MARK_SET
	END=$(( EPOCHSECONDS + 30 ))
	# Named before the create, so a signal right after it finds it
	_SYNC_HELD=$1
	until ( setopt noclobber; print -r -- "$_LOCK_MARK" > "$1" ) 2>/dev/null; do
		{ [ "$(<"$1")" = "$_LOCK_MARK" ]; } 2>/dev/null && return 0
		RC=1
		if (( W % 10 == 0 )); then
			_LOCK_BREAK "$1"
			RC=$?
		fi
		if (( RC == 2 || ++W > 300 || EPOCHSECONDS > END )); then
			_SYNC_HELD=-
			return 1
		fi
		(( RC == 0 )) || sleep 0.1
	done
}

# Lets go of the hold on a checkout's sync where it is still this run's
_SYNC_HOLD_RELEASE () {
	[ -n "$_LOCK_MARK" ] && [ "$_SYNC_HELD" != - ] && { [ "$(<"$_SYNC_HELD")" = "$_LOCK_MARK" ]; } 2>/dev/null && rm -f "$_SYNC_HELD"
	[ "$_SYNC_HELD" = - ] || _SYNC_HELD=""
}

# Refuses what could not take the journal's lock, naming its holder – a live run holding it past
# the wait or one this run runs under, or a dead one's lock no second name could be made to break
_REFUSE_JOURNAL_LOCK () {
	# Args: <journal> <what was not done, as "nothing was applied"> <`_JOURNAL_LOCK`'s status>
	# Reads the holder's pid from `REPLY`
	if [ "$3" = 2 ]; then
		PRINT_ERR "The journal's lock $1.lock names a holder${REPLY:+ (pid $REPLY)} that is gone, but it could not be linked to break it – $2"
		ECHO_E "\e[0;31m  Deleting that file is safe once no run is live in this repository: $(_LIT "rm -f -- $(_SHQ "$1.lock")"), then run this again.\e[0m" >&2
	elif [ "$3" = 3 ]; then
		PRINT_ERR "The journal is locked by the run this one runs under${REPLY:+ (pid $REPLY)} – a hook its landing ran, say – which holds it until this one ends – $2"
		ECHO_E "\e[0;31m  Run it once that run has finished, never from inside its hooks.\e[0m" >&2
	else
		PRINT_ERR "The journal is locked by another run${REPLY:+ (pid $REPLY)}, in flight past 60 s – $2"
		ECHO_E "\e[0;31m  Wait for that run to finish, then run this again.\e[0m" >&2
	fi
}

# Takes the journal's lock every write to the pause slot holds, unless this run holds it already,
# `REPLY` naming the journal where it took it, for the caller to let go of – refused where it can't
_SLOT_LOCK () {
	# Args: <state file> <what was not done, as "nothing was applied">
	local JF="${1:h}/git-edit-journal" RC
	REPLY=""
	[ -z "$_JOURNAL_HELD" ] || return 0
	_JOURNAL_LOCK "$JF"
	RC=$?
	if (( RC )); then
		_REFUSE_JOURNAL_LOCK "$JF" "$2" $RC
		exit 1
	fi
	REPLY=$JF
}

# Runs a branch's CAS `update-ref`, the run landing from here on unless it is refused
_MOVE_REF () {
	# Args: <update-ref command, its last three words the ref, the new tip and the old>
	local ERR
	local -a W
	W=("${(@Q)${(z)1}}")
	# What a second signal stopping the run mid-move journals, where the ref moved meanwhile
	_MOVING_REF=("${W[-3]}" "${W[-1]}" "${W[-2]}" "${${${W[${W[(i)-m]}+1]}#git edit: }%$_REFLOG_TAG}")
	# A resume or an undo checks pushed history at its landing, as a first run did at its start –
	# pushed while the pause waited, or since the run it takes back – the oldest commit leaving the
	# branch reached by a remote branch means all after it are
	if { [ ${#OPT_CONTINUE} -gt 0 ] || [ ${#OPT_UNDO} -gt 0 ]; } && [ ${#OPT_ALLOW_PUSHED} -eq 0 ] && [ "$STATE_ALLOW_PUSHED" != 1 ]; then
		local LEAVING=$(git rev-list --reverse "${W[-2]}..${W[-1]}" 2>/dev/null | head -1) ON
		[ -n "$LEAVING" ] && ON=$(_REMOTES_CONTAINING "$LEAVING" | head -3 | tr '\n' ' ' | LC_ALL=C sed 's/ $//')
		if [ -n "$ON" ]; then
			if [ ${#OPT_UNDO} -gt 0 ]; then
				PRINT_ERR "Undoing it takes ${LEAVING:0:7} off ${W[-3]#refs/heads/}, and it is pushed (on: $ON) – nothing was undone"
				ECHO_E "\e[0;31m  Rewriting pushed history disrupts collaborators – pass --allow-pushed to undo anyway.\e[0m" >&2
				exit 1
			fi
			_CLEANUP_HOOK=""
			PRINT_ERR "Landing it takes ${LEAVING:0:7} off ${W[-3]#refs/heads/}, pushed while this paused (on: $ON) – nothing was applied"
			ECHO_E "\e[0;31m  Rewriting pushed history disrupts collaborators – continue with --allow-pushed to land it anyway, or cancel with 'git edit --abort'.\e[0m" >&2
			_PAUSE_EXIT 1 retry
		fi
	fi
	# Under the journal's lock from before the move until its entry is in, which an abort takes to end
	# a pause and the entry's record of the move lets go of – a resume lands only the pause it took
	# up, never one another run ended meanwhile, no abort ends it between the check and the move nor
	# reads the move as never made, and no undo finds the branch moved but unjournaled
	local JF="" ERRF RC
	if [ -z "$_JOURNAL_HELD" ] && JF=$(_JOURNAL_FILE_PATH); then
		_JOURNAL_LOCK "$JF"
		RC=$?
		if (( RC )); then
			[ -n "$_STATE_OWNED" ] && _CLEANUP_HOOK=""
			_REFUSE_JOURNAL_LOCK "$JF" "nothing was applied" $RC
			_PAUSE_EXIT 1 retry
		fi
	fi
	_REQUIRE_OWN_PAUSE
	# A pause another run took on this branch while this one worked wins over it, checked
	# under the lock every pause is written under – the CAS covers the branch, naming a move
	[ "$(git rev-parse -q --verify "${W[-3]}" 2>/dev/null)" = "${W[-1]}" ] && _REQUIRE_CURRENT "${W[-3]}" ""
	ERRF=$(MKTEMP_FILE git-edit-move 2>/dev/null) && _TEMP_FILES+=("$ERRF")
	# The journal the landing writes to, read now – once the ref moved, a signal to the whole process
	# group would end the git call that names it
	_MOVE_JOURNAL=${_JOURNAL_HELD:-$JF}
	[ -n "$_MOVE_JOURNAL" ] || _MOVE_JOURNAL=$(_JOURNAL_FILE_PATH)
	_RESYNC_MARK_PATH "${W[-3]}"
	_MOVE_MARK=$REPLY
	# Held from before the move to the end of the checkout's sync, under the journal's lock – the order
	# every run takes the two in – so a run landing right after waits for this one's sync
	# In the git dir of the checkout the sync writes – the mark's, a per-worktree path git keeps in a
	# linked worktree's own git dir, of the checkout `_BRANCH_CHECKOUT` names as the sync's
	[ -n "$_MOVE_MARK" ] && [ -z "$_SYNC_HELD" ] && _SYNC_HOLD_TAKE "${_MOVE_MARK%/*}/git-edit-sync.lock"
	# Its "brought" mark at or below the tip the branch moves from, so a run cut off before the sync
	# leaves the next one's sync all it missed to bring
	[ -n "$_MOVE_MARK" ] && _BROUGHT_HOLD "" "${W[-1]}" "${W[-3]}" "${_MOVE_MARK%/*}/git-edit-brought"
	local SIG=$_DEFERRED_SIGNAL
	_LANDING=true
	# A plain foreground command, as a signal waits for one – inside `$( … )` the trap runs at once,
	# reading the ref unmoved while the orphaned `update-ref` still moves it
	{ eval "$1" } 2>"${ERRF:-/dev/null}" >/dev/null
	RC=$?
	[ -n "$ERRF" ] && ERR=$(<"$ERRF") && rm -f "$ERRF"
	(( RC )) || return 0
	# Stopped after the ref moved – a signal to the terminal's process group while a hook still
	# runs on the committed transaction – the move happened, so it lands, journaled and reported
	# A ref found there with no signal was put there by someone else – a refused CAS, never a move
	{ [ -n "$_DEFERRED_SIGNAL" ] || (( RC > 128 )); } && \
		[ "$(git rev-parse -q --verify "${W[-3]}" 2>/dev/null)" = "${W[-2]}" ] && return 0
	_LANDING=false
	[ -n "$JF" ] && _JOURNAL_UNLOCK "$JF"
	# Not moved, with a signal in meanwhile – one sent to the
	# whole process group ended the `update-ref` itself
	[ -z "$SIG" ] && _STOP_DEFERRED
	# A hook vetoing the transaction leaves the ref where the run read it – refused, not moved, as
	# the caller's message would have it
	if [ "$(git rev-parse -q --verify "${W[-3]}" 2>/dev/null)" = "${W[-1]}" ]; then
		PRINT_ERR "git refused to move ${W[-3]#refs/heads/}, still at the tip this run read – nothing was ${${OPT_UNDO:+undone}:-applied}${ERR:+: ${ERR%%$'\n'*}}"
		_PAUSE_EXIT 1 retry
	fi
	# A race lost, which the caller's refusal names
	_RACE_LOST=("${W[-3]}" "$_MOVE_JOURNAL")
	return $RC
}

# Names the push that publishes a rewrite of pushed history – its lease pinned to the upstream as
# the rewrite found it, since a background fetch moving the remote-tracking ref turns a bare
# `--force-with-lease` into a plain force
_PRINT_FORCE_PUSH () {
	# Args: <ref> <old> <new>
	[[ "$1" == refs/heads/* ]] || return 0
	local B=${1#refs/heads/} UP REMOTE MERGE
	UP=$(git rev-parse -q --verify "$B@{upstream}" 2>/dev/null) || return 0
	# Only where this run took the upstream's commits off the branch – behind it, a push needed a
	# force before, and ahead of it, none
	git merge-base --is-ancestor "$UP" "$2" 2>/dev/null || return 0
	git merge-base --is-ancestor "$UP" "$3" 2>/dev/null && return 0
	REMOTE=$(git config --get "branch.$B.remote")
	MERGE=$(git config --get "branch.$B.merge")
	[ -n "$REMOTE" ] && [ "$REMOTE" != . ] && [[ "$MERGE" == refs/heads/* ]] || return 0
	local DST=${MERGE#refs/heads/} SPEC=$B
	[ "$DST" = "$B" ] || SPEC="$B:$DST"
	PRINT_TEXT "Pushed history rewritten – publish it with: %s" 33 "git push --force-with-lease=$(_SHQ "$DST"):$UP $(_SHQ "$REMOTE") $(_SHQ "$SPEC")"
}

# Appends <line> to <journal>, noting the move <ref old new> journaled, with a signal arriving inside
# the write held to its end – then stopping the run as it would have
_JOURNAL_WRITE () {
	# Args: <journal> <line> <ref old new>
	local -i FD
	_IN_WRITE=1
	# A plain write(2) – `print`'s stdio buffer, a trap returning inside its flush, went out twice
	if zmodload zsh/system 2>/dev/null && sysopen -a -o creat -u FD "$1" 2>/dev/null; then
		syswrite -o $FD "$2"$'\n'
		exec {FD}>&-
	else
		print -r -- "$2" >> "$1"
	fi
	# The re-sync the move owes marked as this run's in that same hold – a later run leaves it to
	# this one while it lives, and takes it on once it is gone
	[ -n "$3" ] && [ -n "$_MOVE_MARK" ] && [ -n "$_LOCK_MARK" ] && _RESYNC_MARK_PUT "$_MOVE_MARK" "$3 $_LOCK_MARK"
	_JOURNALED_MOVE=$3
	_RELEASE_HELD_SIGNAL
}

# Ends an `_IN_WRITE` hold, stopping the run by a signal that arrived inside it, as it would have
_RELEASE_HELD_SIGNAL () {
	_IN_WRITE=""
	[ -n "$_HELD_SIGNAL" ] || return 0
	local -a SIG
	SIG=(${=_HELD_SIGNAL})
	_HELD_SIGNAL=""
	_ON_TERMINATION "${SIG[@]}"
}

# Records a completed CAS ref move – appends a journal entry and prints the inverse command,
# so recovery is plain git rather than knowledge of this script, also via `git edit --undo`
# Warns about tags left pointing into the rewritten span, which surface only at release time,
# and names the branches left there, which it never moves – then delivers the rewrite
_RECORD_REF_MOVE () {
	# Args: <ref> <old> <new> <label>
	_LANDED_MOVE="$1 moved $2 → $3"
	# The trailer names the move made, from the tip it swapped – a resume's differs from the one paused
	SCRIPT_INITIAL_HEAD=$2
	# The entry made of nothing a signal ending a child could cut short –
	# the journal named before the move, the clock a builtin
	local JF=${_MOVE_JOURNAL:-$(_JOURNAL_FILE_PATH)}
	local TAB=$'\t'
	local JLINE="$EPOCHSECONDS $1 $2 $3 $4${_ACTOR_ID:+$TAB$_ACTOR_ID}"
	# Under the lock the move took, and the pause a resume landed ends with its entry in that one hold
	# of it, so no abort finds it landed but still paused – its capture dir kept for the delivery
	# below – while an append is whole without the lock too, so one that could not wait it out goes
	# in all the same, as only an undo rewriting the journal that moment could lose it
	if [ -n "$JF" ] && { [ -n "$_JOURNAL_HELD" ] || _JOURNAL_LOCK "$JF"; }; then
		_JOURNAL_WRITE "$JF" "$JLINE" "$1 $2 $3"
		[ -n "$_STATE_OWNED" ] && _DROP_OWN_PAUSE keep-capture
		_JOURNAL_UNLOCK "$_JOURNAL_HELD"
	elif [ -n "$JF" ]; then
		_JOURNAL_WRITE "$JF" "$JLINE" "$1 $2 $3"
		PRINT_TEXT "Journaled without its lock, held past 60 s: %s" 33 "$JF.lock"
	fi
	_JOURNALED_MOVE="$1 $2 $3"
	# Ahead of what is named below – a branch left in the span is named by the pairs it collects
	_CAPTURE_COLLECT "$2" "$3"
	_PRINT_REF_MOVE "$1" "$2" "$3" "$4"
	_EMIT_REWRITES
	# Both run after the copy above, so they report only what the rewrite
	# actually failed to carry rather than everything it touched – and here
	# rather than per-mode, since every landing passes through this call
	_PRINT_LEFT_NOTES "$2" "$3"
	_PRINT_LOST_SIGNATURES "$2" "$3"
}

# Re-syncs the index entries a move from <old> to <new> stranded in <ref>'s checkout, the index
# alone, putting into `REPLY` what a stop's one line says of it – the entries re-synced, and the
# guarded step for those a locked index kept
_RESYNC_STRANDED_NOTE () {
	# Args: <ref> <old> <new> – reads the caller's `WHOLE_IDX`
	local CO NOTE
	local -a RESYNCED LEFT_ALONE LOCKED
	REPLY=""
	CO=$(_BRANCH_CHECKOUT "$1") && [ -d "$CO" ] || return 0
	_RESYNC_STRANDED_ENTRIES "$CO" "$2" "$3"
	(( ${#RESYNCED} )) && NOTE=" – index entries re-synced to it: $(_SOME_PATHS -q "${RESYNCED[@]}")"
	if (( ${#LOCKED} )); then
		_AT_TOP "$CO"
		NOTE+=" – index locked, so still staged as before it: $(_SOME_PATHS -q "${LOCKED[@]}") – once it is free, re-sync each still so: $REPLY$(_PATHS_CMD "git diff-index --cached --exit-code --name-only ${2:0:12}" "${LOCKED[@]}") && $(_PATHS_CMD "git restore --staged" "${LOCKED[@]}")"
	fi
	REPLY=$NOTE
}

# Puts into `REPLY` the file in the git dir of <ref>'s checkout naming the last move there whose
# index re-sync finished, as "<ref> <old> <new>" – a lock mark closing one a run still owes –
# nothing where the branch is checked out nowhere
_RESYNC_MARK_PATH () {
	# Args: <ref>
	local CO
	REPLY=""
	CO=$(_BRANCH_CHECKOUT "$1") && [ -d "$CO" ] || return 0
	REPLY=$(git -C "$CO" rev-parse --path-format=absolute --git-path git-edit-resynced 2>/dev/null)
}

# Writes <line> as all of mark <file> – a plain write(2), as a landing writes its journal line
_RESYNC_MARK_PUT () {
	# Args: <file> <line>
	local -i FD
	if zmodload zsh/system 2>/dev/null && sysopen -w -o creat,trunc -u FD "$1" 2>/dev/null; then
		syswrite -o $FD "$2"$'\n'
		exec {FD}>&-
	fi
}

# Marks the move <ref old new> re-synced in its checkout, where the mark names no move landed on
# top of it since – that one's run marks its own – `REPLY` left as it was
_RESYNC_MARK_DONE () {
	# Args: <ref> <old> <new> [<mark file>, the move's own by default]
	local F=${4:-$_MOVE_MARK} CUR WAS=$REPLY
	local -a C
	if [ -z "$F" ]; then
		_RESYNC_MARK_PATH "$1"
		F=$REPLY
		REPLY=$WAS
	fi
	[ -n "$F" ] || return 0
	[ -f "$F" ] && CUR=$(<"$F")
	C=(${=${CUR%%$'\n'*}})
	[ "${C[1]}" = "$1" ] && [ "${C[2]}" = "$3" ] && [ "${C[3]}" != "$3" ] && return 0
	_RESYNC_MARK_PUT "$F.$$" "$1 $2 $3"
	if (( ${+builtins[zf_mv]} )); then
		zf_mv -f "$F.$$" "$F" 2>/dev/null
	else
		mv -f "$F.$$" "$F" 2>/dev/null
	fi
}

# Tells whether the journaled move <ref old new> owes its checkout a re-sync by mark <file> – one
# naming it as still owed by a run that is gone (0), or naming the move before it on that ref (2),
# owed only where a run died holding the journal's lock, as a run marks its move in that hold
# • A mark missing or naming another ref – a branch switched in this checkout – proves nothing (1),
#   an older build marking no move it lands, re-synced by its own run
_RESYNC_OWED () {
	# Args: <file> <ref> <old> <new>
	local CUR="" HOLDER
	local -a C
	[ -f "$1" ] && CUR=$(<"$1")
	CUR=${CUR%%$'\n'*}
	if [[ "$CUR" != "$2 $3 $4"(| *) ]]; then
		C=(${=CUR})
		[ "${C[1]}" = "$2" ] && [ "${C[3]}" = "$3" ] && return 2
		return 1
	fi
	[ "$CUR" != "$2 $3 $4" ] || return 1
	HOLDER=${CUR#"$2 $3 $4 "}
	[[ "${HOLDER%% *}" == <-> ]] || return 0
	_HOLDER_GONE "$HOLDER"
}

# Journals a move whose run was killed before recording it – the branch's newest reflog entry, a
# `git edit:` one at its tip that no journal line holds – and re-syncs what it stranded, in one line
# • Re-syncs too, once, where a journaled one's run was killed before its re-sync, as the mark
#   proves by `_RESYNC_OWED` – as left so, its entries read as a staged revert of the move a peer's
#   plain commit takes in
# • Under the journal's lock, never waited for, as its holder may be about to record that very
#   move – never an undo's, which `--undo` finds already back, nor a legacy abort's
# • An unjournaled one only where a run died holding that lock, as one killed mid-landing leaves
#   it, or once 15 s old – an older build moves the ref without the lock and journals it after,
#   at once or past a wait of up to 5 s for the lock, and a live run's move is never adopted
_ADOPT_KILLED_MOVE () {
	local REF JF LINE NEW SUBJ WHEN OLD LABEL ACTOR MARK JOURNALED="" HOLDER DEAD="" YOUNG="" TAB=$'\t'
	local -i OWED=0
	local -a T
	local -A WHOLE_IDX
	[ -z "$_JOURNAL_HELD" ] || return 0
	REF=$(git symbolic-ref -q HEAD 2>/dev/null) && JF=$(_JOURNAL_FILE_PATH) || return 0
	LINE=$(git log -g -1 --date=unix --format='%H %gd %gs' "$REF" -- 2>/dev/null)
	NEW=${LINE%% *} SUBJ=${LINE#* * }
	WHEN=${${${LINE#* }%% *}##*@\{}
	WHEN=${WHEN%\}}
	[[ "$SUBJ" == "git edit: "* && "$SUBJ" != "git edit: "(undo|abort)" "* && -n "$NEW" && "$NEW" != *[^0-9a-f]* ]] || return 0
	[[ "$WHEN" == <-> ]] && (( EPOCHSECONDS - WHEN >= 15 )) || YOUNG=1
	MARK=$(git rev-parse --path-format=absolute --git-path git-edit-resynced 2>/dev/null)
	# One journaled already, as nearly always, read without the lock – its re-sync owed only where
	# its run was stopped before it, and never where no mark can say it is done
	if [ -s "$JF" ] && OLD=$(awk -v r="$REF" -v n="$NEW" '$2 == r && $4 == n { o = $3 } END { if (o == "") exit 1; print o }' "$JF" 2>/dev/null); then
		[ -n "$MARK" ] || return 0
		_RESYNC_OWED "$MARK" "$REF" "$OLD" "$NEW"
		OWED=$?
		(( OWED != 1 )) || return 0
		JOURNALED=1
	fi
	# Where no lock is there to break, no run died holding it
	if [ ! -e "$JF.lock" ]; then
		[ -n "$JOURNALED" ] && (( OWED == 2 )) && return 0
		[ -z "$JOURNALED" ] && [ -n "$YOUNG" ] && return 0
	fi
	_LOCK_MARK_SET
	_JOURNAL_HELD=$JF
	if ! ( setopt noclobber; print -r -- "$_LOCK_MARK" > "$JF.lock" ) 2>/dev/null; then
		{ HOLDER=$(<"$JF.lock") } 2>/dev/null
		if ! _LOCK_BREAK "$JF.lock" || ! ( setopt noclobber; print -r -- "$_LOCK_MARK" > "$JF.lock" ) 2>/dev/null; then
			_JOURNAL_HELD=""
			return 0
		fi
		_HOLDER_GONE "$HOLDER" && DEAD=1
	fi
	# The tip and the value before the entry, asked again under the lock
	T=(${(f)"$(git rev-parse "$REF" "$REF@{1}" 2>/dev/null)"})
	if [ -n "$JOURNALED" ]; then
		_RESYNC_OWED "$MARK" "$REF" "$OLD" "$NEW"
		OWED=$?
		if [ "${T[1]}" != "$NEW" ] || (( OWED == 1 )) || { (( OWED == 2 )) && [ -z "$DEAD" ]; }; then
			_JOURNAL_UNLOCK "$JF"
			return 0
		fi
	else
		OLD=${T[2]}
		if (( ${#T} != 2 )) || [ "${T[1]}" != "$NEW" ] || { [ -n "$YOUNG" ] && [ -z "$DEAD" ]; } || \
		   awk -v r="$REF" -v o="$OLD" -v n="$NEW" '$2 == r && $3 == o && $4 == n { f = 1; exit } END { exit !f }' "$JF" 2>/dev/null; then
			_JOURNAL_UNLOCK "$JF"
			return 0
		fi
	fi
	# Its label and caller as the message names them – the caller's own label as given
	LABEL=${SUBJ#git edit: } ACTOR=""
	if [[ "$LABEL" == *" ["*"]" ]]; then
		ACTOR=${${LABEL##* \[}%\]}
		LABEL=${LABEL% \[*\]}
		[ "$ACTOR" = "$_ACTOR" ] && ACTOR=$_ACTOR_ID
	fi
	[[ "$WHEN" == <-> ]] || WHEN=$EPOCHSECONDS
	[ -n "$JOURNALED" ] || _JOURNAL_WRITE "$JF" "$WHEN $REF $OLD $NEW $LABEL${ACTOR:+$TAB$ACTOR}" ""
	# The re-sync this run owes now, marked as its own before the lock goes, so no other run takes
	# it on meanwhile
	[ -n "$MARK" ] && _RESYNC_MARK_PUT "$MARK" "$REF $OLD $NEW $_LOCK_MARK"
	_JOURNAL_UNLOCK "$JF"
	_RESYNC_STRANDED_NOTE "$REF" "$OLD" "$NEW"
	[ -n "$MARK" ] && _RESYNC_MARK_DONE "$REF" "$OLD" "$NEW" "$MARK"
	if [ -z "$JOURNALED" ]; then
		PRINT_TEXT "A run moved %s but was stopped before recording it – journaled from the reflog: %s (%s → %s)%s" 33 \
			"${REF#refs/heads/}" "$LABEL${ACTOR:+ by $ACTOR}" "${OLD:0:7}" "${NEW:0:7}" "$REPLY"
	elif [ -n "$REPLY" ]; then
		PRINT_TEXT "A run moved %s but was stopped before re-syncing the index: %s (%s → %s)%s" 33 \
			"${REF#refs/heads/}" "$LABEL${ACTOR:+ by $ACTOR}" "${OLD:0:7}" "${NEW:0:7}" "$REPLY"
	else
		return 0
	fi
	# Stopped before its re-sync, it never reached its checkout's sync either
	_STOPPED_CARRY "$REF" "$OLD" "$NEW" "$LABEL"
	[ -n "$REPLY" ] && PRINT_TEXT "Its checkout was not brought along – bring it along with: %s" 33 "$REPLY"
	return 0
}

# Puts into `REPLY` the carry that brings <ref>'s checkout along after its move from <old> to <new>
# stopped short of its sync – nothing where the move changed no file, the branch is checked out
# nowhere, a commit's paths stand in the checkout as they landed, files and entries, or an undo
# keeps what a commit, fold or `--exec` only adding commits landed
_STOPPED_CARRY () {
	# Args: <ref> <old> <new> <label>
	local CO KIND=${4%% *} D
	REPLY=""
	if [ "$KIND" = undo ]; then
		KIND=${${4#undo }%% *}
		[[ "$KIND" == (commit|amend-into) ]] && return 0
		[ "$KIND" = exec ] && _IS_ANCESTOR "$3" "$2" && return 0
	fi
	_SAME_TREE "$2" "$3" && return 0
	CO=$(_BRANCH_CHECKOUT "$1") && [ -d "$CO" ] || return 0
	# A commit of the checkout's own files whole holds them as they landed – one composed from inputs
	# left them as they were, told by the files themselves, as an adopted move's label says neither
	if [ "$KIND" = commit ]; then
		D=$(git diff-tree -r -z --no-renames --name-only "$2" "$3" 2>/dev/null) || return 0
		_GIT_PATH_CHUNKS -C "$CO" diff --quiet --ignore-submodules=dirty "$3" -- ${(0)D} >/dev/null 2>&1 && \
			_GIT_PATH_CHUNKS -C "$CO" diff --cached --quiet --ignore-submodules=dirty "$3" -- ${(0)D} >/dev/null 2>&1 && return 0
	fi
	# A bare one, from the checkout's mark, kept at or below <old> – it brings every landing missed
	_BROUGHT_HOLD "$CO" "$2"
	_BROUGHT_UPTO "$CO" "$1" "$2"
	if [ -n "$REPLY" ]; then _CARRY_CMD "$CO"; else _CARRY_CMD "$CO" "$2"; fi
}

# Prints the raw `update-ref` taking a run's ref move back – <ref> from <new> to <old>, its reflog
# message the one `--undo` writes for <label>, so the land rule reads a land taken back so as undone
# – the index entries the run re-synced left to the steps `_RAW_UNDO_STEPS` names
_UNDO_REF_CMD () {
	# Args: <ref> <old> <new> <label>
	print -r -- "git update-ref -m $(_SHQ "git edit: undo $4$_REFLOG_TAG") $(_SHQ "$1") $2 $3"
}

# Prints the steps a raw undo of the move of <ref> from <old> to <new> leaves – it moves the ref
# alone, so each index entry the run took to what landed reads as staged: the step putting those
# back from `HEAD`, and where the run brought the files along too, the carry taking them back
# • Read off the checkout as it stands – an entry holding what landed at a path the move changed –
#   as no record keeps what the run moved, so one staged so by hand before the run counts too
_RAW_UNDO_STEPS () {
	# Args: <ref> <old> <new> <label>
	local CO KIND=${4%% *} P
	local -a DIFF_PATHS MOVED FLAG_AU FLAG_SW
	local -A DIFF_O DIFF_N IDX_ENT
	[ "$KIND" != undo ] && CO=$(_BRANCH_CHECKOUT "$1") && [ -d "$CO" ] || return 0
	_DIFF_ENTRIES "$2" "$3"
	(( ${#DIFF_PATHS} )) || return 0
	_INDEX_ENTRIES "$CO" "" "${DIFF_PATHS[@]}"
	for P in "${DIFF_PATHS[@]}"; do
		[ "${IDX_ENT[$P]}" = "${DIFF_N[$P]}" ] && MOVED+=("$P")
	done
	if (( ${#MOVED} )); then
		# A restore misses a path outside a sparse checkout, or clears its skip-worktree flag so the
		# file reads as deleted – there `--undo` alone re-syncs them, flags kept – every path counting
		# as outside where this git can't ask the patterns
		_INDEX_FLAGS "$CO" "" "${MOVED[@]}"
		if (( ${#FLAG_SW} )) || ! _SPARSE_OUT "$CO" "${MOVED[@]}" || (( ${#reply} )); then
			PRINT_TEXT "The raw undo moves the ref alone, leaving what this run staged as its content – here a restore would miss or unflag the sparse or skip-worktree ones, so undo with %s, which re-syncs them all" 90 "git edit --undo"
			return 0
		fi
		# Only where each entry still holds what landed, so a peer's staging there since stops it whole
		_AT_TOP "$CO"
		PRINT_TEXT "After the raw undo, re-sync the entries it leaves staged as this run's content – it resets none where one holds other staging since, listing those: %s" 90 \
			"$REPLY$(_PATHS_CMD "git diff-index --cached --exit-code --name-only ${3:0:12}" "${MOVED[@]}") && $(_PATHS_CMD "git restore --staged" "${MOVED[@]}")"
	fi
	# Not after what a commit, a fold or an `--exec` only adding commits landed, which `--undo` keeps,
	# nor where the run left the files as they were, its mark not on <new> – one a sync left held there
	# brought them all the same, only the walk for a file's base going on past it
	[[ "$KIND" == (commit|amend-into) ]] && return 0
	[ "$KIND" = exec ] && _IS_ANCESTOR "$2" "$3" && return 0
	_BROUGHT_READ "$CO" "$1"
	[ "$REPLY" = "$3" ] || return 0
	_AT_TOP "$CO"
	PRINT_TEXT "Then bring the checkout back with it, as %s would: %s" 90 "git edit --undo" "${REPLY}git edit --carry=${3:0:12}"
}

# Tells whether <old> is an ancestor of <new>, as `git merge-base --is-ancestor` does – a verdict on
# two full object names kept for the run, as the landing steps each ask it of the same move
# Only a plain yes or no is kept – a git cut short by a signal is asked again next time
typeset -gA _ANCESTRY
_ANCESTRY=()
_IS_ANCESTOR () {
	# Args: <old> <new>
	local KEY="$1 $2" RC
	(( ${+_ANCESTRY[$KEY]} )) && return ${_ANCESTRY[$KEY]}
	git merge-base --is-ancestor "$1" "$2" 2>/dev/null
	RC=$?
	[[ ${#1} == (40|64) && ${#2} == (40|64) && "$1$2" != *[^0-9a-f]* ]] && (( RC <= 1 )) && _ANCESTRY[$KEY]=$RC
	return $RC
}

# What a drop or squash did away with, by commit – `dropped`, or `squashed <commit it went into>` –
# so a ref left on one is named so, never offered a commit sharing its subject
typeset -gA _RUN_FATES
_RUN_FATES=()

# Puts into `REPLY` what the run made of <commit> left in its span, as "<sha> <how>" – `dropped`
# (sha `-`) or `squashed` by the run's word, `rewrite` or `patch-id` by its pairs, else `patch-id`
# or `subject`, a guess, as the stale-SHA rule finds one – empty where none
_SPAN_COUNTERPART () {
	# Args: <commit> <new tip>
	local PAIR
	REPLY=""
	case ${_RUN_FATES[$1]} in
		(dropped) REPLY="- dropped"; return 0 ;;
		(squashed\ ?*) REPLY="${_RUN_FATES[$1]#squashed } squashed"; return 0 ;;
	esac
	# The rebuild's own record is exact – where a rebase kept none, the stale-SHA rule decides – yet
	# names the same change only where the patch ids agree, as a split's remainder holds part of it
	for PAIR in "${_REWRITE_PAIRS[@]}"; do
		[ "${PAIR%% *}" = "$1" ] || continue
		REPLY="${PAIR#* } rewrite"
		[ "$(_PATCH_ID "$1")" = "$(_PATCH_ID "${PAIR#* }")" ] && REPLY="${PAIR#* } patch-id"
		return 0
	done
	REPLY=$(_RESOLVE_STALE "$1" "$2")
	return 0
}

# Prints what a recorded ref move leaves for the caller – the inverse command, other checkouts of
# the branch re-synced, the push that publishes it, and tags and branches left in the span
_PRINT_REF_MOVE () {
	# Args: <ref> <old> <new> <label>
	[ -n "$_IN_LANDED_STEP" ] || { _LANDED_STEP "$0" "$@"; return; }
	[ -n "$_ACTOR_MAPPED" ] && PRINT_TEXT "Labeled %s – GIT_EDIT_ACTOR keeps letters, digits, _ and - alone, the rest mapped to _" 33 "$_ACTOR"
	# Its reflog message the one `--undo` writes, so a land taken back this way reads as undone
	# too – said to move the ref alone, as the index entries the run re-synced stay as it left them
	ECHO_E "\e[0;90mUndo: git edit --undo  (or, the ref alone: $(_LIT "$(_UNDO_REF_CMD "$1" "$2" "$3" "$4")"))\e[0m"
	_RESYNC_OTHER_CHECKOUTS "$1" "$2" "$3"
	_PRINT_FORCE_PUSH "$1" "$2" "$3"

	# A tag is orphaned where the old tip reached it and the new one doesn't, its counterpart named
	# as a branch's is – two `--merged` walks, as tags on pushed history reach both tips, through
	# `for-each-ref`, as `git tag` lists in a caller's columns
	# Neither walk where the move only advanced, as the new tip then reaches all the old one did
	local ADVANCED=""
	_IS_ANCESTOR "$2" "$3" && ADVANCED=1
	local ORPHANED_TAGS=""
	[ -n "$ADVANCED" ] || ORPHANED_TAGS=$(comm -23 <(git for-each-ref refs/tags --merged "$2" --format='%(refname)' 2>/dev/null | sort) <(git for-each-ref refs/tags --merged "$3" --format='%(refname)' 2>/dev/null | sort))
	local TAGREF TAG TAGSHA TSUBJ HIT TO RETAG TNOTE
	for TAGREF in ${(f)ORPHANED_TAGS}; do
		TAG=${TAGREF#refs/tags/}
		TAGSHA=$(git rev-parse "$TAGREF^{commit}" 2>/dev/null)
		[ -z "$TAGSHA" ] && continue
		TSUBJ=$(git log -1 --format='%s' "$TAGSHA")
		_SPAN_COUNTERPART "$TAGSHA" "$3"
		HIT=$REPLY
		# The subject goes above the command, never after it – pasted into a shell that reads no `#`
		# comments, an interactive zsh's default, it would run
		# An annotated tag re-made keeps its message, which a plain `git tag -f` would drop with the
		# tag object – a signature it can only make anew
		RETAG="git tag -f $(_SHQ "$TAG")" TNOTE=""
		if [ "$(git cat-file -t "$TAGREF" 2>/dev/null)" = tag ]; then
			RETAG="git for-each-ref --format='%(contents:subject)%0a%0a%(contents:body)' $(_SHQ "$TAGREF") | git tag -f -a -F - $(_SHQ "$TAG")"
			TNOTE="An annotated tag – the command keeps its message"
			[ -n "$(git for-each-ref --format='%(contents:signature)' "$TAGREF" 2>/dev/null)" ] && TNOTE+=", though not its signature: add -s to sign it anew"
		fi
		TO=${${HIT%% *}:0:12}
		case ${HIT#* } in
			(dropped)
				PRINT_TEXT "Tag %s points at a commit this run dropped, with no counterpart in the new span – it keeps that commit as it was, to re-point or delete by hand if it shouldn't: %s" 33 "$TAG" "$TSUBJ"
				continue ;;
			(squashed) PRINT_TEXT "Tag %s points at a commit this run squashed into %s – re-point it there if it should follow the rewrite: %s" 33 "$TAG" "$TO" "$TSUBJ" ;;
			(patch-id) PRINT_TEXT "Tag %s points into the rewritten span – re-point it to its counterpart, the same change: %s" 33 "$TAG" "$TSUBJ" ;;
			(rewrite) PRINT_TEXT "Tag %s points into the rewritten span – re-point it to its counterpart, what the rewrite made of it: %s" 33 "$TAG" "$TSUBJ" ;;
			(subject) PRINT_TEXT "Tag %s points into the rewritten span – a guess at its counterpart, by its subject alone, to check is the same change before re-pointing it: %s" 33 "$TAG" "$TSUBJ" ;;
			(*)
				PRINT_TEXT "Tag %s points into the rewritten span – re-point it or it stays on pre-rewrite history:" 33 "$TAG"
				TO="<its counterpart in the new span>" ;;
		esac
		ECHO_E "\e[0;33m  $(_LIT "$RETAG") $TO\e[0m"
		[ -n "$TNOTE" ] && PRINT_TEXT "%s" 90 "$TNOTE"
	done

	# A branch left in the span is named the same way rather than moved – git's `rebase.updateRefs`
	# moves one as its rebase completes, ahead of the verify and the CAS, so every rebase here pins
	# it off, or an abort or a refused CAS would leave that branch rewritten
	local STRANDED=""
	[ -n "$ADVANCED" ] || STRANDED=$(comm -23 <(git for-each-ref refs/heads --merged "$2" --format='%(refname) %(worktreepath)' 2>/dev/null | sort) <(git for-each-ref refs/heads --merged "$3" --format='%(refname) %(worktreepath)' 2>/dev/null | sort))
	local ENTRY BREF BSHA BSUBJ NAMED=false
	for ENTRY in ${(f)STRANDED}; do
		BREF=${ENTRY%% *}
		BSHA=$(git rev-parse "$BREF")
		BSUBJ=$(git log -1 --format=%s "$BSHA")
		_SPAN_COUNTERPART "$BSHA" "$3"
		HIT=$REPLY
		# A branch checked out in a worktree is that worktree's to move, as git's own update leaves
		# it – but skipping it silently reads exactly like no stranded branch at all, while it sits
		# on pre-rewrite history either way, so name it and its counterpart and stop there: the move
		# is that checkout's to make, over whatever work is sitting in it, and a command prescribed
		# from here would be one aimed at someone else's worktree
		if [ -n "${ENTRY#* }" ]; then
			PRINT_TEXT "Branch %s points into the rewritten span, checked out in %s – that checkout's to move:" 33 "${BREF#refs/heads/}" "${ENTRY#* }"
			case ${HIT#* } in
				(dropped) ECHO_E "\e[0;33m  this run dropped its commit, with no counterpart here: $(_LIT "$BSUBJ")\e[0m" ;;
				(squashed) ECHO_E "\e[0;33m  this run squashed its commit into ${HIT:0:12}: $(_LIT "$BSUBJ")\e[0m" ;;
				(patch-id) ECHO_E "\e[0;33m  its counterpart here is ${HIT:0:12} – the same change: $(_LIT "$BSUBJ")\e[0m" ;;
				(rewrite) ECHO_E "\e[0;33m  its counterpart here is ${HIT:0:12} – what the rewrite made of it: $(_LIT "$BSUBJ")\e[0m" ;;
				(subject) ECHO_E "\e[0;33m  a guess at its counterpart here, by its subject alone, to check is the same change first: ${HIT:0:12} – $(_LIT "$BSUBJ")\e[0m" ;;
				(*) ECHO_E "\e[0;33m  its counterpart in the new span is unresolved\e[0m" ;;
			esac
			NAMED=true
			continue
		fi
		TO=${HIT:0:12}
		case ${HIT#* } in
			(dropped)
				PRINT_TEXT "Branch %s points at a commit this run dropped, with no counterpart in the new span – it keeps that commit as it was, to move or delete by hand if it shouldn't: %s" 33 "${BREF#refs/heads/}" "$BSUBJ"
				NAMED=true
				continue ;;
			(squashed) PRINT_TEXT "Branch %s points at a commit this run squashed into %s – if it should follow the rewrite, re-point it there: %s" 33 "${BREF#refs/heads/}" "$TO" "$BSUBJ" ;;
			(patch-id) PRINT_TEXT "Branch %s points into the rewritten span – if it should follow the rewrite, to its counterpart, the same change: %s" 33 "${BREF#refs/heads/}" "$BSUBJ" ;;
			(rewrite) PRINT_TEXT "Branch %s points into the rewritten span – if it should follow the rewrite, to its counterpart, what the rewrite made of it: %s" 33 "${BREF#refs/heads/}" "$BSUBJ" ;;
			(subject) PRINT_TEXT "Branch %s points into the rewritten span – if it should follow the rewrite, a guess at its counterpart, by its subject alone, to check is the same change first: %s" 33 "${BREF#refs/heads/}" "$BSUBJ" ;;
			(*)
				PRINT_TEXT "Branch %s points into the rewritten span – if it should follow the rewrite:" 33 "${BREF#refs/heads/}"
				TO="<its counterpart in the new span>" ;;
		esac
		ECHO_E "\e[0;33m  $(_LIT "$(_BRANCH_CMD -f "${BREF#refs/heads/}" "$TO")")\e[0m"
		NAMED=true
	done
	if [ "$NAMED" = "true" ] && [ "$(git config --type=bool --get rebase.updateRefs 2>/dev/null)" = "true" ]; then
		ECHO_E "\e[0;90m  rebase.updateRefs is set, but git edit moves only the branch it rewrites\e[0m"
	fi
	return 0
}

# The plumbing modes compose commits with `commit-tree`, which runs none of a rebase's
# machinery, so anything keyed to a SHA is orphaned by them while surviving `-d` or `--move`
# Every rebuild records its old->new pair here for the CAS to hand git's own two interfaces
_REWRITE_PAIRS=()

_RECORD_REWRITE () {
	_REWRITE_PAIRS+=("$1 $2")
}

# Delivers the held-back rewrite list once the run lands – notes copied, `post-rewrite` run
_EMIT_REWRITES () {
	# A held-back list that a hand-typed `git rebase --continue` let git deliver is not delivered twice
	if [ ${#_REWRITE_PAIRS[@]} -eq 0 ] || [ "$_REWRITES_GIT_DELIVERED" = "true" ]; then
		_REWRITE_PAIRS=()
		_CAPTURE_DISCARD
		return 0
	fi
	local MAP=${(F)_REWRITE_PAIRS} SIG NOTES
	# Copied again where the signal the landing defers cut the copy short before it moved a notes
	# ref – one that moved holds the copy, which a second would append to every note again
	NOTES=$(git for-each-ref --format='%(refname) %(objectname)' refs/notes 2>/dev/null)
	SIG=$_DEFERRED_SIGNAL
	print -r -- "$MAP" | git notes copy --for-rewrite=rebase 2>/dev/null
	if [ "$_DEFERRED_SIGNAL" != "$SIG" ] && [ "$(git for-each-ref --format='%(refname) %(objectname)' refs/notes 2>/dev/null)" = "$NOTES" ]; then
		print -r -- "$MAP" | git notes copy --for-rewrite=rebase 2>/dev/null
	fi
	# `git hook run` reaches hooks defined in config as well as the file, as git's own run does –
	# from 2.40, which gave it `--to-stdin`, while a release that old knows only the file
	if _HOOK_RUN_AVAILABLE; then
		_LANDED_OUT MKTEMP_FILE git-edit-rewrites
		local IN=$REPLY
		_TEMP_FILES+=("$IN")
		print -r -- "$MAP" > "$IN"
		git hook run --ignore-missing --to-stdin="$IN" post-rewrite -- rebase
		rm -f "$IN"
	else
		# To stderr, as git runs every hook – its output stays out of the stdout a caller parses
		_LANDED_OUT git rev-parse --git-path hooks/post-rewrite 2>/dev/null
		local HOOK=$REPLY
		if [ -n "$HOOK" ] && [ -x "$HOOK" ]; then
			print -r -- "$MAP" | "$HOOK" rebase >&2
		fi
	fi
	# One ref move reports one rewrite – a mode that moves twice must not replay
	# the first move's pairs into the second
	_REWRITE_PAIRS=()
	_CAPTURE_DISCARD
}

# Whether `git hook run` takes `--to-stdin` (git 2.40), probed once per run
_HOOK_RUN_PROBED=""
_HOOK_RUN_AVAILABLE () {
	if [ -z "$_HOOK_RUN_PROBED" ]; then
		_HOOK_RUN_PROBED=no
		_LANDED_OUT eval 'export LC_ALL=C; git hook run -h 2>&1'
		[[ "$REPLY" == *"--to-stdin"* ]] && _HOOK_RUN_PROBED=yes
	fi
	[ "$_HOOK_RUN_PROBED" = yes ]
}

# A rebase route's rewrite delivery, held back for the landing to make – git copies notes and
# runs `post-rewrite` as its rebase finishes, ahead of the verify and the CAS, so an aborted or
# refused rewrite would be announced as one (see `_CAPTURE_BEGIN`)
_CAPTURE_REWRITES=false
_CAPTURE_DIR=""
_CAPTURE_PIN_ARGS=()
_CAPTURE_PINS=""
_CAPTURE_EXEC_ARGS=()
_CAPTURE_EXEC=""
_REWRITES_GIT_DELIVERED=false

# Tells whether anything consumes a rewrite's old->new list – a `post-rewrite` hook, a file or one
# defined in config, or notes told to follow rewrites – since only then is there one to hold back
_REWRITE_CONSUMED () {
	[ -n "$GIT_NOTES_REWRITE_REF" ] && return 0
	[ -n "$(git config --get-all notes.rewriteRef 2>/dev/null)" ] && return 0
	local HOOK=$(git rev-parse --path-format=absolute --git-path hooks/post-rewrite 2>/dev/null)
	[ -n "$HOOK" ] && [ -x "$HOOK" ] && return 0
	git config --get-regexp '^hook\..*\.event$' 2>/dev/null | awk '$2 == "post-rewrite" { found = 1 } END { exit !found }'
}

# Arms the hold-back for a rebase in an isolated worktree – git's notes copy and `post-rewrite` run
# are pinned off, and an `--exec` step after every pick saves the list git would have handed them,
# for `_CAPTURE_COLLECT` to deliver once the CAS has landed
_CAPTURE_BEGIN () {
	# Args: [resume <dir>] – a paused run re-arms around the list its dir has already saved
	local SF
	SF=$(_STATE_FILE_PATH) || return 0
	if [ "$1" = "resume" ]; then
		[[ "$2" == */git-edit-capture.?* ]] || return 0
		_CAPTURE_DIR=$2
		mkdir -p "$_CAPTURE_DIR" || return 0
	else
		_REWRITE_CONSUMED || return 0
		# A dir of its own per run – runs overlap in a shared checkout, and under one fixed name a
		# second run discarded the list the first had saved, which then landed unannounced
		_CAPTURE_DIR=$(mktemp -d "${SF:h}/git-edit-capture.XXXXXX" 2>/dev/null) || return 0
	fi
	_CAPTURE_REWRITES=true
	# Only the rebase's last step can tell who delivers – run without these pins (a `git rebase
	# --continue` typed into the pause worktree), git delivers the list itself as that run finishes,
	# while an earlier step typed in by hand leaves the delivery to whichever run takes the last
	local LIST=$_CAPTURE_DIR/rewrites
	local MARK=$_CAPTURE_DIR/delivered
	local SCRIPT=$_CAPTURE_DIR/step.sh
	{
		print -r -- '#!/bin/sh'
		print -r -- 'D=$(git rev-parse --git-path rebase-merge 2>/dev/null)'
		print -r -- "[ -f \"\$D/rewritten-list\" ] && cp \"\$D/rewritten-list\" ${(qq)LIST}"
		print -r -- "if ! grep -qvE '^(#|\$)' \"\$D/git-rebase-todo\" 2>/dev/null; then"
		print -r -- "	if [ \"\$(git config --get edit.captureRewrites)\" = 1 ]; then rm -f ${(qq)MARK}; else : > ${(qq)MARK}; fi"
		print -r -- 'fi'
		print -r -- 'exit 0'
	} > "$SCRIPT"
	_CAPTURE_PIN_ARGS=(-c notes.rewrite.rebase=false -c notes.rewrite.amend=false -c hook.post-rewrite.enabled=false -c edit.captureRewrites=1)
	# That switch holds back hooks defined in config but never a hook file, so a file is held back by
	# a hooks dir running every other hook from its own path – symlinks followed, as managers link them
	local HOOKS=$(git rev-parse --path-format=absolute --git-path hooks 2>/dev/null)
	local WRAPPERS=$_CAPTURE_DIR/hooks
	rm -rf "$WRAPPERS"
	if [ -n "$HOOKS" ] && [ -x "$HOOKS/post-rewrite" ]; then
		mkdir -p "$WRAPPERS"
		local H
		for H in "$HOOKS"/*(N-.x); do
			[ "${H:t}" = "post-rewrite" ] && continue
			printf '#!/bin/sh\nexec %s "$@"\n' "${(qq)H}" > "$WRAPPERS/${H:t}"
			chmod +x "$WRAPPERS/${H:t}"
		done
		_CAPTURE_PIN_ARGS+=(-c "core.hooksPath=$WRAPPERS")
	fi
	# Both forms – the arrays for a command run as is, the quoted strings for one built up and `eval`d
	_CAPTURE_PINS=${(j: :)${(q)_CAPTURE_PIN_ARGS[@]}}
	_CAPTURE_EXEC_ARGS=(--exec "sh ${(qq)SCRIPT}")
	_CAPTURE_EXEC=${(j: :)${(q)_CAPTURE_EXEC_ARGS[@]}}
}

# Removes a capture dir, and only one named the way `_CAPTURE_BEGIN` names them – the path is
# read back from the state file too
_CAPTURE_REMOVE () {
	# Args: <dir>
	[[ "$1" == */git-edit-capture.?* ]] && rm -rf "$1"
	return 0
}

# Adds a rewrite the run makes outside any rebase – an edit's amend – to the held-back list
_CAPTURE_RECORD () {
	# Args: <old> <new>
	[ "$_CAPTURE_REWRITES" = "true" ] || return 0
	print -r -- "$1 $2" >> "$_CAPTURE_DIR/extra"
}

# Moves pairs a plumbing step recorded ahead of the rebase into the held-back list, which persists –
# a pause in between would lose them from memory, and the landing follows them on through the rebase
_CAPTURE_HOLD_PAIRS () {
	if [ ${#_REWRITE_PAIRS[@]} -gt 0 ]; then
		print -r -- "${(F)_REWRITE_PAIRS}" >> "$_CAPTURE_DIR/extra"
	fi
	_REWRITE_PAIRS=()
}

# Turns the held-back list into the pairs the landing delivers – git's list runs through the run's
# own steps, so each replaced commit is followed to where it finally landed, and one the run made
# along the way (a fold's `fixup!`) is left out, as the plumbing routes never list one either
_CAPTURE_COLLECT () {
	# Args: <old tip> <new tip>
	[ "$_CAPTURE_REWRITES" = "true" ] || return 0
	_REWRITES_GIT_DELIVERED=false
	[ -f "$_CAPTURE_DIR/delivered" ] && _REWRITES_GIT_DELIVERED=true
	local -A NEXT
	local LINE F
	# Read in the shell, and the commits again where a signal cut their
	# list short – this runs once the branch moved
	local -a HELD
	for F in "$_CAPTURE_DIR/rewrites" "$_CAPTURE_DIR/extra"; do
		[ -f "$F" ] && HELD+=(${(f)"$(<"$F")"})
	done
	for LINE in "${_REWRITE_PAIRS[@]}" "${HELD[@]}"; do
		[ -n "$LINE" ] && NEXT[${LINE%% *}]=${${LINE#* }%% *}
	done
	_REWRITE_PAIRS=()
	local OLD NEW HOPS
	_LANDED_OUT git rev-list --reverse "$1" --not "$2" 2>/dev/null
	for OLD in ${(f)REPLY}; do
		NEW=${NEXT[$OLD]}
		[ -z "$NEW" ] && continue
		HOPS=0
		while [ -n "${NEXT[$NEW]}" ] && [ $HOPS -lt 1000 ]; do
			NEW=${NEXT[$NEW]}
			HOPS=$((HOPS + 1))
		done
		_REWRITE_PAIRS+=("$OLD $NEW")
	done
}

# Drops a delivered (or discarded) list, so a later landing in the same run starts clean
_CAPTURE_DISCARD () {
	[ "$_CAPTURE_REWRITES" = "true" ] || return 0
	rm -f "$_CAPTURE_DIR/rewrites" "$_CAPTURE_DIR/extra" "$_CAPTURE_DIR/delivered"
}

# Prints a stopped rebase's remaining todo, bar comments, the hold-back's capture steps and the
# replay record's step – git-edit's own, and no step a resolver has to reason about
_REBASE_TODO_LEFT () {
	# Args: <git dir holding the rebase>
	LC_ALL=C grep -avE '^(#|$)' "$1/rebase-merge/git-rebase-todo" 2>/dev/null | LC_ALL=C sed -e '/git-edit-capture\..*step\.sh/d' -e '/^exec .*git-edit-replayed/d'
}

# Passes a rebase's output on without the line git prints as it runs one of git-edit's own steps –
# the hold-back's or the replay record's, which no list of steps shows either – read past the CR a
# progress line redraws itself with, as a terminal shows the line – and without git's advice to
# finish, skip or abort the rebase by hand, which loses the run's own pause, where a git before
# 2.45 has no `advice.mergeConflict` to pin it off with
_DROP_OWN_STEPS () {
	local L
	while IFS= read -r L || [ -n "$L" ]; do
		[[ "${${L%$'\r'}##*$'\r'}" == "Executing: "*(git-edit-replayed|git-edit-capture.*step.sh)* ]] && continue
		[[ "${L#hint: }" == ('Resolve all conflicts manually, mark them as resolved with'|'"git add/rm <conflicted_files>", then run "git rebase --continue".'|'You can instead skip this commit: run "git rebase --skip".'|'To abort and get back to the state before "git rebase", run "git rebase --abort".'|"Otherwise, please use 'git rebase --skip'") ]] && continue
		print -r -- "$L"
	done
}

# Numbers a stopped rebase's current step and its total as `msgnum` and `end` do, but without
# git-edit's own steps, which would inflate both and keep the last pick from ever reading as final
_REBASE_STEP () {
	# Args: <git dir holding the rebase> – prints "<now> <end>"
	local NOW=$(LC_ALL=C sed -e '/git-edit-capture\..*step\.sh/d' -e '/^exec .*git-edit-replayed/d' "$1/rebase-merge/done" 2>/dev/null | LC_ALL=C grep -ac .)
	local LEFT=$(_REBASE_TODO_LEFT "$1" | grep -c .)
	print -r -- "$NOW $((NOW + LEFT))"
}

# Puts into `REPLY` the index in the caller's `ALL` of the journal line `--undo` takes back, 0 for
# none – the newest that is no undo's own record, so a further undo takes back the run before, nor
# repeats the ref, old and new of a later one an undo recorded – an older build's line for a move
# another run journaled from the reflog meanwhile
_UNDO_PICK () {
	local -i I
	local -a F
	local -A UNDONE
	REPLY=0
	for (( I = ${#ALL}; I >= 1; I-- )); do
		F=(${=${ALL[I]%%$'\t'*}})
		if [ "${F[5]}" = undo ]; then
			UNDONE[${F[2]}:${F[4]}:${F[3]}]=1
			continue
		fi
		(( ${+UNDONE[${F[2]}:${F[3]}:${F[4]}]} )) && continue
		REPLY=$I
		return 0
	done
}

# Reverts the last journaled ref move, CAS-guarded – refuses where the branch has moved
# since, whose later commit or rewrite would otherwise be discarded, and a run made under another
# label than the caller's, as every session and worktree appends to the one journal
GIT_UNDO () {
	local JF=$(_JOURNAL_FILE_PATH)
	if [ -z "$JF" ] || [ ! -s "$JF" ]; then
		PRINT_ERR "Nothing to undo (no completed git-edit operation on record)"
		exit 1
	fi
	local LINE="" CAND
	local -i I
	local -a ALL F
	ALL=("${(@f)$(<"$JF")}")
	_UNDO_PICK
	I=$REPLY
	(( I )) && LINE=${ALL[I]}
	F=(${=${LINE%%$'\t'*}})
	if [ -z "$LINE" ]; then
		PRINT_ERR "Nothing to undo (no completed git-edit operation on record)"
		exit 1
	fi
	local LAST=$LINE
	local RUN_ACTOR=""
	if [[ "$LAST" == *$'\t'* ]]; then
		RUN_ACTOR=${LAST##*$'\t'}
		LAST=${LAST%$'\t'*}
		# One journaled before labels were kept as given holds the mapped one alone, the caller's own
		# where that matches its own, as the pause loader reads one
		[ -n "$_ACTOR_MAPPED" ] && [ "$RUN_ACTOR" = "$_ACTOR" ] && RUN_ACTOR=$_ACTOR_ID
	fi
	local REF=$(print -r -- "$LAST" | awk '{print $2}')
	local OLD=$(print -r -- "$LAST" | awk '{print $3}')
	local NEW=$(print -r -- "$LAST" | awk '{print $4}')
	local LABEL=$(print -r -- "$LAST" | cut -d' ' -f5-)

	# Only a pause on the branch it would move is in the way, whose landing the undo would strand
	if _STATE_EXISTS; then
		local SF=$(_STATE_FILE_PATH)
		local SB=$(LC_ALL=C sed -n 's/^branch=//p' "$SF" 2>/dev/null | head -1)
		if [ -z "$SB" ] || [ "$SB" = "$REF" ]; then
			# Whose it is, as the wait reads it – another caller's continue or abort is never this one's
			local WHO=$(LC_ALL=C sed -n 's/^actor=//p' "$SF" 2>/dev/null | tail -1)
			local WHO_ID=$(LC_ALL=C sed -n 's/^actor_id=//p' "$SF" 2>/dev/null | tail -1)
			if [ -n "$WHO_ID" ]; then
				WHO=$WHO_ID
			elif [ "$WHO" = "$_ACTOR" ]; then
				WHO=$_ACTOR_ID
			fi
			_PAUSE_OWNER "$SF"
			if [ -n "$REPLY" ] && [ "$WHO" != "$_ACTOR_ID" ]; then
				PRINT_ERR "An operation is in flight${SB:+ on ${SB#refs/heads/}}, paused for its resolution – $REPLY, not yours – nothing was undone"
				ECHO_E "\e[0;31m  Wait for it to clear, then undo ('git edit --status' shows it) – or ask its owner to finish it: its --continue and --abort are theirs to run.\e[0m" >&2
			elif [ "$WHO" = "$_ACTOR_ID" ]; then
				# Unlabeled, every unlabeled pause counts as the caller's, as its resume takes it
				PRINT_ERR "Your operation is in flight${SB:+ on ${SB#refs/heads/}} – finish it with --continue or --abort before undoing"
			else
				PRINT_ERR "An operation is in flight${SB:+ on ${SB#refs/heads/}}, paused for its resolution${REPLY:+ – $REPLY} – nothing was undone"
				ECHO_E "\e[0;31m  If it is yours, 'git edit --continue' or 'git edit --abort' it before undoing – if another session's, wait for it ('git edit --status' shows it).\e[0m" >&2
			fi
			exit 1
		fi
	fi

	# An unlabeled caller, a person at a terminal, has no label to tell its own run by
	if [ -n "$_ACTOR_ID" ] && [ "$RUN_ACTOR" != "$_ACTOR_ID" ] && [ ${#OPT_ALLOW_OTHER_ACTOR} -eq 0 ]; then
		PRINT_ERR "The last operation ($LABEL) is another caller's – refusing to take it back"
		# The caller's own newest run, never skipped to – where its ref still holds what it landed, on
		# another branch say, the inverse its landing printed still applies
		local OWN=""
		for (( I = I - 1; I >= 1; I-- )); do
			CAND=${ALL[I]}
			[[ "$CAND" == *$'\t'* ]] || continue
			[[ "${CAND##*$'\t'}" == "$_ACTOR_ID" || ( -n "$_ACTOR_MAPPED" && "${CAND##*$'\t'}" == "$_ACTOR" ) ]] || continue
			F=(${=${CAND%%$'\t'*}})
			[ "${F[5]}" = undo ] && continue
			OWN=$CAND
			break
		done
		local WHO="It ran as $(_LIT "${RUN_ACTOR:-an unlabeled caller}"), this undo as $(_LIT "$_ACTOR_ID")." MINE=$(_LIT "${F[5,-1]}")
		local OTHER="--allow-other-actor takes back that caller's run instead, not yours."
		if [ -z "$OWN" ]; then
			ECHO_E "\e[0;31m  $WHO No run of yours is on record to take back – $OTHER\e[0m" >&2
		elif [ "$(git rev-parse -q --verify "${F[2]}" 2>/dev/null)" = "${F[4]}" ]; then
			ECHO_E "\e[0;31m  $WHO Your own last run ($MINE) is still where $(_LIT "${F[2]#refs/heads/}") stands, so the command its landing printed takes it back, the ref alone:\e[0m" >&2
			ECHO_E "\e[0;31m    $(_LIT "$(_UNDO_REF_CMD "${F[2]}" "${F[3]}" "${F[4]}" "${F[5,-1]}")")\e[0m" >&2
			_RAW_UNDO_STEPS "${F[2]}" "${F[3]}" "${F[4]}" "${F[5,-1]}" >&2
			ECHO_E "\e[0;31m  $OTHER\e[0m" >&2
		else
			ECHO_E "\e[0;31m  $WHO Your own last run ($MINE) no longer moves back by ref, $(_LIT "${F[2]#refs/heads/}") having moved on since – take it back with a rewrite of its own: -d a commit it added, -M a reword back, -s a split together. $OTHER\e[0m" >&2
		fi
		exit 1
	fi

	PRINT_ACTION "Undoing last operation (%s)..." "${NEW}"

	# Held across the move, so the journal never names a run the branch no longer carries
	_JOURNAL_LOCK "$JF"
	local RC=$?
	if (( RC )); then
		_REFUSE_JOURNAL_LOCK "$JF" "nothing was undone" $RC
		exit 1
	fi
	# The run chosen still the last – one journaled while the lock was awaited is the repo's last now
	ALL=("${(@f)$(<"$JF")}")
	_UNDO_PICK
	I=$REPLY
	# Gone from the journal altogether, it was taken back – only an undo removes a line – and a
	# second undo would take back the run before it, which nobody asked for
	if (( ! ${ALL[(Ie)$LINE]} )); then
		_JOURNAL_UNLOCK "$JF"
		PRINT_ERR "Another undo took back $LABEL while this one waited – it is undone, so nothing was left to do"
		ECHO_E "\e[0;31m  Don't run --undo again for it: that would take back the run before it.\e[0m" >&2
		exit 1
	fi
	if [ "${ALL[I]}" != "$LINE" ]; then
		_JOURNAL_UNLOCK "$JF"
		PRINT_ERR "Another run landed while this undo waited – nothing was undone"
		ECHO_E "\e[0;31m  Run 'git edit --undo' again, which then reads the run that is last now.\e[0m" >&2
		exit 1
	fi
	local TAB=$'\t'
	# Taken back already outside git-edit – the raw `update-ref` a refusal names, say – so nothing
	# moves, while the journal records it undone, for a further undo to pass over
	if [ "$(git rev-parse -q --verify "$REF" 2>/dev/null)" = "$OLD" ]; then
		_JOURNAL_REPLACE "$JF" "$LINE" "$EPOCHSECONDS $REF $NEW $OLD undo $LABEL${_ACTOR_ID:+$TAB$_ACTOR_ID}"
		_JOURNAL_UNLOCK "$JF"
		PRINT_TEXT "%s" 32 "Undid: $LABEL – ${REF#refs/heads/} already sat at ${OLD:0:7}, taken back outside git-edit, so nothing moved"
		# What that raw undo left to do, where it is still undone
		_RAW_UNDO_STEPS "$REF" "$OLD" "$NEW" "$LABEL"
		_EMIT_TRAILER "git-edit: ok – $REF unchanged, already at ${OLD:0:7}"
		_STATUS_EMITTED=true
		return 0
	fi
	# A second signal mid-move takes this line out too, as the rewrite below would
	_UNDONE_LINE=$LINE
	local CMD="git update-ref -m ${(q-)${:-git edit: undo $LABEL$_REFLOG_TAG}} ${(q-)REF} ${(q-)OLD} ${(q-)NEW}"
	PRINT_CMD "$CMD"
	if ! _MOVE_REF "$CMD"; then
		_JOURNAL_UNLOCK "$JF"
		PRINT_ERR "Ref '$REF' has moved since that operation – refusing to rewind over newer work"
		ECHO_E "\e[0;31m  Expected $(_LIT "$REF") at ${NEW:0:7}, found $(git rev-parse --short "$REF" 2>/dev/null).\e[0m" >&2
		exit 1
	fi
	# Named from here, so a second signal's trailer says the undo moved the branch
	_LANDED_MOVE="$REF moved $NEW → $OLD"
	# The undone entry leaves the journal – that line itself, as one appended since by another run
	# sits after it – and the undo goes in as a move of its own, which `--carry` and the landing
	# guards read, while a further `--undo` passes over it to the run before
	local TAB=$'\t'
	_JOURNAL_REPLACE "$JF" "$LINE" "$EPOCHSECONDS $REF $NEW $OLD undo $LABEL${_ACTOR_ID:+$TAB$_ACTOR_ID}"
	_JOURNALED_MOVE="$REF $NEW $OLD"
	_JOURNAL_UNLOCK "$JF"
	SCRIPT_INITIAL_HEAD=$NEW
	PRINT_TEXT "%s" 32 "Undid: $LABEL"
	# The checkout follows, as after any landing – but for what a commit, a fold or an `--exec` that
	# only added commits landed, which may have come from it and stays there as uncommitted changes,
	# as an `--exec` rewriting history is a rewrite like any other
	local UNDONE=undo
	if [[ "${LABEL%% *}" == (commit|amend-into) ]] || { [ "${LABEL%% *}" = exec ] && _IS_ANCESTOR "$OLD" "$NEW"; }; then
		UNDONE=undo-keep
	fi
	_PRINT_REWRITE_APPLY_HINT "${REF#refs/heads/}" "$NEW" "$OLD" "$UNDONE"
	_PRINT_DEFERRED_SIGNAL
	_PRINT_TODO
	_EMIT_TRAILER "git-edit: ok – $REF moved $NEW → $OLD"
	_STATUS_EMITTED=true
}

# Lists a change's removed and added lines, sorted, to tell that a merge kept the edits whole
_CHANGED_LINES () {
	# Args: <from file> <to file>
	git diff --no-index --no-color --no-ext-diff --no-textconv -U0 -- "$1" "$2" 2>/dev/null | awk 'f && /^[-+]/; /^@@/ {f = 1}' | LC_ALL=C sort
}

# Lists the spans of <from file> a change touches, in half-lines – `2s 2e` for lines s to e it
# rewrites or removes, the point `2s+1` for an insertion after line s – as where an edit sits
# tells it from one beside it, which matching text (a blank line, a `}`) cannot – `-t` adds each
# hunk's span of <to file> as two more columns
_CHANGED_SPANS () {
	# Args: [-t] <from file> <to file>
	local T=""
	[ "$1" = -t ] && T=1 && shift
	git diff --no-index --no-color --no-ext-diff --no-textconv -U0 --inter-hunk-context=0 -- "$1" "$2" 2>/dev/null | \
		LC_ALL=C awk -v t="$T" '
			function span(s, c) { return c == 0 ? (2 * s + 1) " " (2 * s + 1) : (2 * s) " " (2 * (s + c - 1)) }
			/^@@ -/ {
				n = split(substr($2, 2), o, ","); m = split(substr($3, 2), w, ",")
				print span(o[1] + 0, n < 2 ? 1 : o[2] + 0) (t ? " " span(w[1] + 0, m < 2 ? 1 : w[2] + 0) : "")
			}'
}

# Answers whether a rename's destination can take the carry – absent from the checkout,
# holding byte for byte what checking the rewrite out writes there, as a clean filter can
# hash an edit away, a symlink pointing where the landed one does, or the source's own
# file, a case-only rename on a filesystem that ignores case
_CARRY_DEST_FREE () {
	# Args: <checkout> <new tip> <path> <source>
	[ ! -e "$1/$3" ] && [ ! -L "$1/$3" ] && return 0
	if [ -L "$1/$3" ]; then
		[ "$(_TREE_ENTRY "$2" "$3")" = "120000 $(_WORKTREE_HASH "$1" "$3")" ]
		return
	fi
	[ -f "$1/$3" ] && [ "$1/$3" -ef "$1/$4" ] && return 0
	[ -f "$1/$3" ] && git -C "$1" cat-file --filters "${2}:$3" 2>/dev/null | cmp -s - "$1/$3"
}

# Puts into `REPLY` the mode git stages <path> of <checkout> at – a regular file's as its
# <index mode> has it where `core.fileMode` is off, as git then reads no executable bit off the
# file, else as <old mode>
_WORKTREE_MODE () {
	# Args: <checkout> <path> [<old mode> <core.fileMode> [<index mode>]]
	if [ -L "$1/$2" ]; then REPLY=120000
	elif [ "$4" = false ] && [[ "$5" == 100(644|755) ]]; then REPLY=$5
	elif [ "$4" = false ] && [[ "$3" == 100(644|755) ]]; then REPLY=$3
	elif [ -x "$1/$2" ]; then REPLY=100755
	else REPLY=100644
	fi
}

# Puts into `REPLY` the mode a carried file takes, three-way as its content – what landed, unless
# the checkout's own differs from before, a regular file's executable bit all that can
_CARRY_MODE () {
	# Args: <checkout's mode> <old mode> <new mode>
	if [ "$1" != "$2" ] && [[ "$1 $2 $3" == 100(644|755)" "100(644|755)" "100(644|755) ]]; then REPLY=$1; else REPLY=$3; fi
}

# Moves <file> onto <path> in one rename, a symlink there replaced rather than followed into the
# directory it points at – BSD `mv` spells that `-h`, GNU `-T` – never onto a directory
_MOVE_ONTO () {
	# Args: <file> <path>
	[ -d "$2" ] && [ ! -L "$2" ] && return 1
	mv -fh "$1" "$2" 2>/dev/null || mv -fT "$1" "$2" 2>/dev/null
}

# Answers whether two paths name one directory entry – a case-only pair on a filesystem that
# ignores case – a symlink's own, never where it points
_SAME_ENTRY () {
	# Args: <path> <path>
	local -a A B
	A=(${=$(command ls -di -- "$1" 2>/dev/null)}) B=(${=$(command ls -di -- "$2" 2>/dev/null)})
	[ -n "${A[1]}" ] && [ "${A[1]}" = "${B[1]}" ]
}

# Answers whether <checkout> lists <path> under exactly that spelling, each directory on the way
# too, where a filesystem that ignores case finds it under any
_SPELLED_AS () {
	# Args: <checkout> <path>
	local D=$1 C
	local -a E
	for C in "${(@s:/:)2}"; do
		E=("$D"/*(DN:t))
		(( ${E[(Ie)$C]} )) || return 1
		D+=/$C
	done
	return 0
}

# Respells each directory `DIR_RENAMED` holds that the rewrite renamed by case
# alone, on a filesystem that ignores case – one directory either way, which no
# move of a file in it respells – into `DIR_RESPELT`
_DIR_RESPELL () {
	# Args: <checkout> – the caller declares `DIR_RESPELT`
	local CO=$1 S T
	for S in "${(@k)DIR_RENAMED}"; do
		T=${DIR_RENAMED[$S]}
		[ -d "$CO/$S" ] && [ ! -L "$CO/$S" ] && [ "$CO/$S" -ef "$CO/$T" ] && ! _LEADING_NON_DIR "$CO" "$S" && \
			! _SPELLED_AS "$CO" "$T" || continue
		# BSD `mv` renames a directory onto itself by case, GNU only told the target is no directory
		{ mv -f "$CO/$S" "$CO/$T" 2>/dev/null && _SPELLED_AS "$CO" "$T"; } || \
			{ mv -fT "$CO/$S" "$CO/$T" 2>/dev/null && _SPELLED_AS "$CO" "$T"; } || continue
		_ONE_LINE "$S → $T"
		DIR_RESPELT+=("$REPLY")
	done
}

# Puts into `REPLY` <old> where the rewrite from it changed a `.gitattributes`, so a merge reads
# every side under the attributes the edits were made under, as a file rendered under the new ones
# differs on each line `eol` rewrites – nothing where none changed, or where this git reads
# attributes off no tree (2.40 can)
_ATTR_SOURCE () {
	# Args: <old> – reads the caller's `DIFF_PATHS`
	local P
	REPLY=""
	for P in "${DIFF_PATHS[@]}"; do
		[[ "$P" == (*/|).gitattributes ]] || continue
		git --attr-source="$1" cat-file -e "$1" 2>/dev/null && REPLY=$1
		return 0
	done
}

# Puts into `REPLY` the command that merges a file's edits on <old>'s <source>, markers and all –
# onto what <new> landed at <path> where they sit at <path> itself, else from <edits> into <path>,
# which holds what landed – read under the attributes the caller's `ATTR_SRC` names, its other
# sides kept in a temp dir of the step's own, which two run at once never share and the OS clears
_MERGE_CMD () {
	# Args: <old> <new> <source> <path> <edits>
	local T='T=$(mktemp -d) && ' B='"$T/base"' L='"$T/landed"' G="git${ATTR_SRC:+ --attr-source=${ATTR_SRC:0:12}}"
	if [ "$5" = "$4" ]; then
		REPLY="$T$G cat-file --filters $(_SHQ "${1:0:12}:$3") > $B && $G cat-file --filters $(_SHQ "${2:0:12}:$4") > $L && git merge-file -- $(_SHQ "$4") $B $L"
	else
		REPLY="$T$G cat-file --filters $(_SHQ "${1:0:12}:$3") > $B && git merge-file -- $(_SHQ "$4") $B $(_SHQ "$5")"
	fi
}

# Puts into `REPLY` the `MERGE_HEAD`, `CHERRY_PICK_HEAD` or `REVERT_HEAD` of a merge, cherry-pick or
# revert in progress in <checkout>, failing where none is – a file in <git dir>, but for the latter
# two a ref alone under reftable, read there as the pseudoref, which a branch of its name never is
_PICK_IN_PROGRESS () {
	# Args: <checkout> <its git dir> – reads `_REF_STORAGE`, filled in once where still unset
	local N
	REPLY=MERGE_HEAD
	[ -f "$2/MERGE_HEAD" ] && return 0
	# Read again where a signal cut it short – read empty, it would say none is going on
	if [ -z "$_REF_STORAGE" ]; then
		_LANDED_OUT git -C "$1" config --get extensions.refStorage 2>/dev/null
		_REF_STORAGE=${REPLY:-files}
	fi
	for N in CHERRY_PICK_HEAD REVERT_HEAD; do
		REPLY=$N
		if [ "$_REF_STORAGE" != reftable ]; then
			[ -f "$2/$N" ] && return 0
			continue
		fi
		# Unflagged, the ambiguity resolves to the pseudoref ahead of a branch
		_LANDED_OUT git -C "$1" -c core.warnAmbiguousRefs=false rev-parse -q --verify --symbolic-full-name "$N" 2>/dev/null
		[ "$REPLY" = "$N" ] && return 0
	done
	REPLY=""
	return 1
}

# Puts into `REPLY` what <checkout> is halfway through – a merge, rebase, cherry-pick or revert,
# or a conflict left unmerged – failing where it is through none
_HALFWAY_THROUGH () {
	# Args: <checkout>
	# Read again where a signal cut it short – read empty, it would say none is going on
	_LANDED_OUT git -C "$1" rev-parse --absolute-git-dir 2>/dev/null
	local GD=$REPLY PICK=""
	_PICK_IN_PROGRESS "$1" "$GD" && PICK=$REPLY
	REPLY=""
	if [ "$PICK" = MERGE_HEAD ]; then REPLY="a merge"
	elif [ -d "$GD/rebase-merge" ] || [ -d "$GD/rebase-apply" ]; then REPLY="a rebase"
	elif [ -n "$PICK" ]; then REPLY="a ${${${PICK%_HEAD}//_/-}:l}"
	# A sequence of them stopped, its stop committed by hand, the rest still to pick
	elif [ -d "$GD/sequencer" ]; then REPLY="a cherry-pick or revert sequence"
	elif [ -n "$(git -C "$1" ls-files -u 2>/dev/null | head -1)" ]; then REPLY="a conflict"
	fi
	[ -n "$REPLY" ]
}

# Writes <path> of <checkout> as the "<mode> <blob>" <entry> has it checked out, or takes it out
# where that is empty, its directories with it once empty, as git does – only over the file as it
# was read, hashing <hash>, failing 1 where it changed since and 2 where nothing could be written
# The file is written in the caller's `CARRY_TMP` first – a symlink as a file holding its target
# where `core.symlinks` is off, as git writes one there
_CARRY_TAKE () {
	# Args: <checkout> <path> <entry> <hash> – reads the caller's `CARRY_TMP` and `SYMLINKS`
	local CO=$1 P=$2 D TMPF=$CARRY_TMP
	if [ -z "$3" ]; then
		[ "$(_WORKTREE_HASH "$CO" "$P")" = "$4" ] || return 1
		rm -f "$CO/$P" 2>/dev/null || return 2
		D=${P:h}
		while [ "$D" != . ] && rmdir -- "$CO/$D" 2>/dev/null; do D=${D:h}; done
		return 0
	fi
	[ -d "$CO/${P:h}" ] || mkdir -p "$CO/${P:h}" 2>/dev/null || return 2
	rm -f "$TMPF"
	if [ "${3% *}" = 120000 ] && [ "$SYMLINKS" != false ]; then
		ln -s -- "$(git cat-file blob "${3#* }")" "$TMPF" 2>/dev/null || return 2
	elif [ "${3% *}" = 120000 ]; then
		git cat-file blob "${3#* }" > "$TMPF" 2>/dev/null || { rm -f "$TMPF"; return 2; }
	else
		git -C "$CO" cat-file --filters --path="$P" "${3#* }" > "$TMPF" 2>/dev/null || { rm -f "$TMPF"; return 2; }
		if [ "${3% *}" = 100755 ]; then chmod 755 "$TMPF"; else chmod 644 "$TMPF"; fi
	fi
	if [ "$(_WORKTREE_HASH "$CO" "$P" 2>/dev/null)" != "$4" ]; then
		rm -f "$TMPF"
		return 1
	fi
	_MOVE_ONTO "$TMPF" "$CO/$P" || { rm -f "$TMPF"; return 2; }
}

# Queues the index entries a write onto what landed leaves behind – a rename's source going where
# still as before, its new path taking what landed where it has none, and a path merged in place
# taking it where still as before, so the edits read as changes to it, never a staged revert, each
# naming <item> for <list>, a sync's rename by its new path's entry alone – failing where none needs
# writing
_CARRY_QUEUE () {
	# Args: <source> <path> [<list> <item>] – reads the caller's `HOW`, `IDX_ENT`, `DIFF_O` and
	# `DIFF_N`, adding to `_SYNC_QUEUE`'s lists
	local -i N=${#Q_PATH}
	if [ "$1" != "$2" ]; then
		if [ -n "${IDX_ENT[$1]}" ] && [ "${IDX_ENT[$1]}" = "${DIFF_O[$1]}" ]; then
			if [ "$HOW" = carry ]; then _SYNC_QUEUE "$1" "" "$3" "$4"; else _SYNC_QUEUE "$1" ""; fi
		fi
		[ -z "${IDX_ENT[$2]}" ] && _SYNC_QUEUE "$2" "${DIFF_N[$2]}" "$3" "$4"
	elif [ "${IDX_ENT[$2]}" = "${DIFF_O[$2]}" ]; then
		_SYNC_QUEUE "$2" "${DIFF_N[$2]}" "$3" "$4"
	fi
	(( ${#Q_PATH} > N ))
}

# Fills `DIR_RENAMED` with each directory a rewrite renamed whole, to its new one – every path <old>
# tracked under it gone to the same tail under that one, none tracked there at <new> or <tip>, as
# git's own directory renames read – the shallowest alone, and `DIR_PARTLY` with each renamed
# file's own directory not renamed whole
_DIR_RENAMES () {
	# Args: <old> <new> [<tip>] – reads the caller's `RENAMED_TO`, the caller declaring
	# `DIR_RENAMED` associative and `DIR_PARTLY`
	local S T P W
	local -i FIRST
	local -A CAND BAD OWN WHOLE
	local -x GIT_LITERAL_PATHSPECS=1
	DIR_RENAMED=(); DIR_PARTLY=()
	# Every level both sides share a tail from – `old/cases/a.json` to `new/cases/a.json` names
	# `old/cases` and `old` – one going two places renamed to neither
	for P in "${(@k)RENAMED_TO}"; do
		S=$P T=${RENAMED_TO[$P]} FIRST=1
		while [[ "$S" == */* && "$T" == */* ]] && [ "${S:t}" = "${T:t}" ]; do
			S=${S:h} T=${T:h}
			(( FIRST )) && OWN[$S]=1
			FIRST=0
			if (( ${+CAND[$S]} )) && [ "${CAND[$S]}" != "$T" ]; then BAD[$S]=1; else CAND[$S]=$T; fi
		done
	done
	for S in "${(@k)CAND}"; do
		(( ${+BAD[$S]} )) && continue
		T=${CAND[$S]}
		[ -n "$(git ls-tree --full-tree --name-only "$2" -- "$S" 2>/dev/null)" ] && continue
		[ -n "$3" ] && [ -n "$(git ls-tree --full-tree --name-only "$3" -- "$S" 2>/dev/null)" ] && continue
		FIRST=1
		for P in ${(0)"$(git ls-tree -r -z --full-tree --name-only "$1" -- "$S" 2>/dev/null)"}; do
			[ "${RENAMED_TO[$P]}" = "$T/${P:$(( ${#S} + 1 ))}" ] || { FIRST=0; break; }
		done
		(( FIRST )) && WHOLE[$S]=$T
	done
	for S in "${(@k)WHOLE}"; do
		for W in "${(@k)WHOLE}"; do
			[ "${S:0:$(( ${#W} + 1 ))}" = "$W/" ] && continue 2
		done
		DIR_RENAMED[$S]=${WHOLE[$S]}
	done
	for S in "${(@k)OWN}"; do
		(( ${+WHOLE[$S]} )) || DIR_PARTLY+=("$S")
	done
}

# Keeps in `DIR_RENAMED` and `DIR_PARTLY` only the directories under which <checkout>'s
# index still tracks a file the rewrite renamed away – one the checkout renamed itself,
# a `git mv` committed or folded, holds its own layout
_DIR_INDEXED () {
	# Args: <checkout> – reads the caller's `RENAMED_TO`
	local S P
	local -A KEEP
	local -a PART
	local -x GIT_LITERAL_PATHSPECS=1
	for S in "${(@k)DIR_RENAMED}" "${DIR_PARTLY[@]}"; do
		for P in ${(0)"$(git -C "$1" ls-files -z -- "$S" 2>/dev/null)"}; do
			(( ${+RENAMED_TO[$P]} )) || continue
			if (( ${+DIR_RENAMED[$S]} )); then KEEP[$S]=${DIR_RENAMED[$S]}; else PART+=("$S"); fi
			break
		done
	done
	DIR_RENAMED=("${(@kv)KEEP}")
	DIR_PARTLY=("${PART[@]}")
}

# Puts into `reply` each <path> outside <checkout>'s sparse checkout, as its patterns tell – none
# where it has none – failing with every one there where this git can't ask them (2.42 can)
_SPARSE_OUT () {
	# Args: <checkout> <path>...
	local CO=$1 LINE PF
	local -a ALL IN
	shift
	ALL=("$@") reply=()
	(( ${#ALL} )) && [ "$(git -C "$CO" config --bool core.sparseCheckout 2>/dev/null)" = true ] || return 0
	# A patterns file git can't read leaves the checkout full, as its own checkout writes it – the
	# flag shared from the main worktree's config, say, where a linked one has no file
	PF=$(git -C "$CO" rev-parse --path-format=absolute --git-path info/sparse-checkout 2>/dev/null)
	[ -n "$PF" ] && [ -f "$PF" ] && [ -r "$PF" ] || return 0
	if LINE=$(print -rN -- "${ALL[@]}" | git -C "$CO" sparse-checkout check-rules -z 2>/dev/null); then
		IN=(${(0)LINE})
		reply=("${(@)ALL:|IN}")
		return 0
	fi
	reply=("${ALL[@]}")
	return 1
}

# Puts into `REPLY` the command that widens <checkout>'s sparse checkout to take in each <path>,
# then carries the edits made on <old> there
_SPARSE_CARRY_CMD () {
	# Args: <checkout> <old> <path>...
	local CO=$1 OLD=$2 P
	local -a DIRS
	shift 2
	# A directory as cone mode takes it, a top-level file by its name
	for P in "$@"; do if [ "${P:h}" = . ]; then DIRS+=("$P"); else DIRS+=("${P:h}"); fi; done
	_AT_TOP "$CO"
	REPLY="$REPLY$(_PATHS_CMD --plain "git sparse-checkout add" "${(@u)DIRS}") && git edit --carry=${OLD:0:12}"
}

# Fills `DIR_FROM` and `DIR_TO` with the untracked files left in each directory `DIR_RENAMED` holds
# and their place under the new one, the same tail – `DIR_TAKEN` with those that place can't take,
# outside a sparse checkout among them, and `DIR_STAYS` with those right in a directory
# `DIR_PARTLY` holds, which take none along
# Ignored files, and anything under a symlink or a file of the caller's, are no business of it
_DIR_UNTRACKED () {
	# Args: <checkout> <old> <new> – the caller declares the four arrays
	local CO=$1 S T U TO NU WHY
	local -i K
	local -A TRACKED OUTSIDE
	local -x GIT_LITERAL_PATHSPECS=1
	DIR_FROM=(); DIR_TO=(); DIR_TAKEN=(); DIR_STAYS=()
	for S in "${(@k)DIR_RENAMED}" "${DIR_PARTLY[@]}"; do
		[ -d "$CO/$S" ] && [ ! -L "$CO/$S" ] || continue
		_LEADING_NON_DIR "$CO" "$S" && continue
		T=${DIR_RENAMED[$S]}
		# A case-only rename on a filesystem that ignores case left its files where they go
		[ -n "$T" ] && [ "$CO/$S" -ef "$CO/$T" ] && continue
		# A path either side tracks is a rename's own, which the rest of the run handles
		TRACKED=()
		for U in ${(0)"$(git ls-tree -r -z --full-tree --name-only "$2" -- "$S" 2>/dev/null; git ls-tree -r -z --full-tree --name-only "$3" -- "$S" 2>/dev/null)"}; do
			TRACKED[$U]=1
		done
		for U in ${(0)"$(git -C "$CO" ls-files -z --others --exclude-standard -- "$S" 2>/dev/null)"}; do
			(( ${+TRACKED[$U]} )) && continue
			if [ -z "$T" ]; then
				[ "${U:h}" = "$S" ] && DIR_STAYS+=("$U")
				continue
			fi
			_ONE_LINE "$U"; NU=$REPLY
			# A repository of its own, which `ls-files` names by its directory
			if [ "${U[-1]}" = / ]; then
				DIR_TAKEN+=("$NU – untracked, a repository of its own")
				continue
			fi
			TO=$T/${U:$(( ${#S} + 1 ))}
			if [ -e "$CO/$TO" ] || [ -L "$CO/$TO" ]; then
				_ONE_LINE "$TO"
				DIR_TAKEN+=("$NU – untracked, $REPLY exists already")
			elif _LEADING_NON_DIR "$CO" "$TO"; then
				_ONE_LINE "$REPLY"
				DIR_TAKEN+=("$NU – untracked, your symlink or file $REPLY stands where its directory goes")
			else
				DIR_FROM+=("$U")
				DIR_TO+=("$TO")
			fi
		done
	done
	# Nothing goes outside a sparse checkout, where git keeps no file
	(( ${#DIR_TO} )) || return 0
	WHY="outside your sparse checkout"
	_SPARSE_OUT "$CO" "${DIR_TO[@]}" || WHY="maybe outside your sparse checkout, which this git can't ask (2.42 can)"
	for U in "${reply[@]}"; do OUTSIDE[$U]=1; done
	for (( K = ${#DIR_TO}; K >= 1; K-- )); do
		(( ${+OUTSIDE[${DIR_TO[K]}]} )) || continue
		_ONE_LINE "${DIR_TO[K]}"; TO=$REPLY
		_ONE_LINE "${DIR_FROM[K]}"
		DIR_TAKEN+=("$REPLY – untracked, its place $TO $WHY")
		DIR_FROM[K]=() DIR_TO[K]=()
	done
	return 0
}

# Moves each of `DIR_FROM` to its place in `DIR_TO`, never over a file there, into `DIR_MOVED` – one
# that can't go into `DIR_TAKEN` – taking out the directories that leaves empty
_DIR_MOVE () {
	# Args: <checkout> – the caller declares `DIR_MOVED`
	local CO=$1 U TO NU NT
	local -i K
	for (( K = 1; K <= ${#DIR_FROM}; K++ )); do
		U=${DIR_FROM[K]} TO=${DIR_TO[K]}
		_ONE_LINE "$U"; NU=$REPLY
		_ONE_LINE "$TO"; NT=$REPLY
		# `mv -n` succeeds moving nothing where a file took the place since, so the result tells – and
		# nothing goes through a symlink standing where its directory goes since the files were read
		if ! _LEADING_NON_DIR "$CO" "$TO" && mkdir -p "$CO/${TO:h}" 2>/dev/null && [ ! -e "$CO/$TO" ] && [ ! -L "$CO/$TO" ] && mv -n "$CO/$U" "$CO/$TO" 2>/dev/null && \
		   [ ! -e "$CO/$U" ] && [ ! -L "$CO/$U" ]; then
			DIR_MOVED+=("$NU → $NT")
			_DIR_PRUNE "$CO" "$U"
		else
			DIR_TAKEN+=("$NU – untracked, not movable to $NT")
		fi
	done
}

# Takes out the directories moving <path> away left empty, up to the
# one `DIR_RENAMED` holds it under – nothing outside one
_DIR_PRUNE () {
	# Args: <checkout> <path>
	local S D
	for S in "${(@k)DIR_RENAMED}"; do
		[ "${2:0:$(( ${#S} + 1 ))}" = "$S/" ] || continue
		D=${2:h}
		while rmdir -- "$1/$D" 2>/dev/null && [ "$D" != "$S" ]; do D=${D:h}; done
		return 0
	done
}

# Merges the checkout's uncommitted edits onto what a rewrite landed – `_SYNC_CHECKOUT`'s carry, the
# sync a run makes run by hand: each path it changed whose file holds edits on the content before
# merges onto what landed, a renamed file moved to its new path edits or none, as are the untracked
# files of a directory renamed whole, writing only a clean merge that keeps the edits' own lines
# whole, and only over the file as it was read, while a file still as before, or missing where the
# rewrite added one, takes what is at the tip
# Nothing goes through a symlink or outside a sparse checkout, and no staging of another's is
# overwritten or orphaned – each such path is left as it is, named
GIT_CARRY () {
	# Args: [<old tip>] – by default, the tip the checkout was last brought to, else the last
	#       journaled rewrite of its branch
	local CO REF OLD NEW LINE GD WHAT OF AT
	local -a J
	CO=$(git rev-parse --show-toplevel 2>/dev/null)
	if ! REF=$(git symbolic-ref -q HEAD); then
		# Detached by an operation stopped partway – a rebase's branch and step named, with the way on
		if _HALFWAY_THROUGH "$CO"; then
			WHAT=$REPLY
			if [ "$WHAT" = "a rebase" ]; then
				GD=$(git rev-parse --absolute-git-dir 2>/dev/null)
				for LINE in rebase-merge/head-name rebase-apply/head-name; do { OF=$(<"$GD/$LINE") } 2>/dev/null && break; done
				if { AT=$(<"$GD/rebase-merge/msgnum") && J=("$AT" "$(<"$GD/rebase-merge/end")"); } 2>/dev/null || \
				   { AT=$(<"$GD/rebase-apply/next") && J=("$AT" "$(<"$GD/rebase-apply/last")"); } 2>/dev/null; then
					AT=", stopped at step ${J[1]} of ${J[2]}"
				else
					AT=""
				fi
				[[ "$OF" == refs/heads/* ]] && WHAT+=" of ${OF#refs/heads/}"
				PRINT_ERR "Your checkout is halfway through $WHAT$AT, HEAD detached there – finish it with 'git rebase --continue' or abort it with 'git rebase --abort', then run --carry again"
			else
				PRINT_ERR "Your checkout is halfway through $WHAT, HEAD detached there – finish or abort it first, then run --carry again"
			fi
			exit 1
		fi
		PRINT_ERR "--carry needs a checked-out branch – HEAD is detached"
		exit 1
	fi
	# Its files and index are that operation's to finish, as a run's sync leaves them
	if _HALFWAY_THROUGH "$CO"; then
		PRINT_ERR "Your checkout is halfway through $REPLY – finish or abort it first, then run --carry again"
		exit 1
	fi
	if [ -n "$1" ]; then
		if ! OLD=$(_PEEL_SHA "$1" commit); then
			PRINT_ERR "--carry=$1 names no commit here"
			exit 1
		fi
		NEW=$(git rev-parse HEAD)
	# From the checkout's mark, where every landing it missed since is on record
	elif NEW=$(git rev-parse HEAD) && _BROUGHT_UPTO "$CO" "$REF" "$NEW" && [ -n "$REPLY" ]; then
		OLD=$REPLY
		# At the tip, nothing to carry – but a file recorded as left unbrought, its record's base telling
		local -A UNBROUGHT
		[ "$OLD" = "$NEW" ] && _UNBROUGHT_READ "$CO"
		if [ "$OLD" = "$NEW" ] && (( ! ${#UNBROUGHT} )); then
			PRINT_TEXT "%s" 32 "Nothing to carry – your checkout was brought along to the tip already."
			_EMIT_TRAILER "git-edit: ok – carried 0 path(s) across ${OLD:0:7}..${NEW:0:7}"
			_STATUS_EMITTED=true
			return 0
		fi
	else
		NEW=""
		local JF=$(_JOURNAL_FILE_PATH)
		if [ -n "$JF" ] && [ -s "$JF" ]; then
			# Newest first – every branch's runs share the journal
			for LINE in "${(@Oaf)$(<"$JF")}"; do
				J=(${=${LINE%$'\t'*}})
				# A `--commit` took the checkout's own files – nothing there to carry
				if [ "${J[2]}" = "$REF" ] && [ "${J[5]}" != commit ]; then
					OLD=${J[3]}
					NEW=${J[4]}
					break
				fi
			done
		fi
		if [ -z "$OLD" ]; then
			PRINT_ERR "No rewrite of ${REF#refs/heads/} on record – name the tip your edits were made on: --carry=<sha>"
			exit 1
		fi
	fi
	PRINT_ACTION "Carrying uncommitted edits from %s onto %s..." "$OLD" "$NEW"
	# Past a tip moved on since, as onto the rewrite – a path the tip changed again left as it is
	_SYNC_CHECKOUT "$CO" "$OLD" "$NEW" carry "$(git rev-parse HEAD)"
	_PRINT_DEFERRED_SIGNAL
	_EMIT_TRAILER "git-edit: ok – carried $REPLY path(s) across ${OLD:0:7}..${NEW:0:7}"
	_STATUS_EMITTED=true
}

# Names what left the caller's checkout behind its branch – its mark below the tip, the landings
# since on record, and each file a run's sync left unbrought that still lacks what landed – with
# the carry bringing each along: the bare one from the mark, else one from the file's recorded base
_STATUS_UNBROUGHT () {
	local CO REF TIP M P B OURS FROM
	local -i KM KB
	local -a R STEP_FROM STEP_TO
	local -A UNBROUGHT FB_BLOB BY_FROM
	local _MERGE_FILE_IDS=-
	CO=$(git rev-parse --show-toplevel 2>/dev/null) && REF=$(git symbolic-ref -q HEAD 2>/dev/null) && \
		TIP=$(git rev-parse -q --verify HEAD 2>/dev/null) || return 0
	_BROUGHT_UPTO "$CO" "$REF" "$TIP"
	M=$REPLY
	[ "$M" = "$TIP" ] && M=""
	_LANDING_STEPS "$REF" "$TIP" "$TIP"
	KM=${STEP_FROM[(Ie)$M]}
	_UNBROUGHT_READ "$CO"
	for P in "${(@k)UNBROUGHT}"; do
		R=(${=UNBROUGHT[$P]})
		# One merged by hand since holds what the landing changed, as a merge of it would read
		if [ -f "$CO/$P" ] && [ ! -L "$CO/$P" ]; then
			_BLOB_AT "${R[1]}" "$P"
			B=$REPLY
			_BLOB_AT "${R[3]}" "$P"
			if [ -n "$B" ] && [ -n "$REPLY" ] && OURS=$(git -C "$CO" hash-object -w -- "$P" 2>/dev/null) && [ -n "$OURS" ]; then
				_LANDING_LACKED "$OURS" "$B" "$REPLY"
				(( $? == 1 )) && continue
			fi
		fi
		# What a fold read, no commit a carry starts from, takes the merge its sync named
		if [ "$(git cat-file -t "${R[1]}" 2>/dev/null)" != commit ]; then
			_AT_TOP "$CO"
			B=$REPLY
			_MERGE_CMD "${R[1]}" "$TIP" "$P" "$P" "$P"
			PRINT_TEXT "Left unbrought by a run's sync, its edits conflicting with what landed: %s – merge that in, markers and all, once you mean to resolve it: %s" 33 "$(_ALL_PATHS "$P")" "$B$REPLY"
			continue
		fi
		# A base at or past the mark on the way to the tip is one the bare carry starts below
		KB=${STEP_FROM[(Ie)${R[1]}]}
		FROM=${R[1]}
		(( KM && KB && KB <= KM )) && FROM=$M
		BY_FROM[$FROM]+="$P"$'\0'
	done
	if [ -n "$M" ]; then
		_CARRY_CMD "$CO"
		PRINT_TEXT "Your checkout was left behind at %s, the landings since not brought along%s – bring it along with: %s" 33 "${M:0:7}" \
			"${BY_FROM[$M]:+, files a sync left unbrought among them: $(_SOME_PATHS "${(@0)${BY_FROM[$M]%$'\0'}}")}" "$REPLY"
		unset "BY_FROM[$M]"
	fi
	for FROM in "${(@k)BY_FROM}"; do
		_CARRY_CMD "$CO" "$FROM"
		PRINT_TEXT "Left unbrought by a run's sync, still lacking what landed past %s: %s – bring them along with: %s" 33 "${FROM:0:7}" \
			"$(_SOME_PATHS "${(@0)${BY_FROM[$FROM]%$'\0'}}")" "$REPLY"
	done
	return 0
}

# Reports the in-flight operation in the same format as the original pause, so a caller
# landing mid-operation – after a context reset or from another session – can re-enter
# without reading state files, falling back to the journal's last completed operation
GIT_STATUS_REPORT () {
	_NAME_ORPHANED_WORKTREES
	_STATUS_UNBROUGHT
	if _STATE_EXISTS; then
		_LOAD_STATE
		# Read, not taken up – a pause replaced meanwhile is reported as read, never refused as ended
		_STATE_OWNED="" _STATE_ID=""
		# A placement pauses as a reorder, under the name its run gave it,
		# and a drop or squash as a rebase, named by its action
		PRINT_TEXT "In-flight operation: %s (target %s, branch %s)" 33 "${${STATE_PLACE_LABEL:+placement – $STATE_PLACE_LABEL}:-${${STATE_ACTION:-$STATE_OPERATION}:-unknown}}" "${${STATE_TARGET:0:7}:-unknown}" "${STATE_BRANCH:-unknown}"
		# Whose it is, as the resume guard reads it – another label's, or one cut short, has its
		# trailer then no step to take there
		local OWNER="" FOREIGN=""
		_PAUSE_FOREIGN && FOREIGN=$REPLY
		_PAUSE_OWNER "$_STATE_PATH"
		local WHOSE=$REPLY
		if [ "$FOREIGN" = cut ]; then
			OWNER="an unknown caller's"
			PRINT_TEXT "Paused by %s run – its state file names neither caller nor operation, cut short, say – so not yours to resume: leave it to whoever paused it." 33 "an unknown caller's"
		elif [ -n "$FOREIGN" ]; then
			OWNER=$WHOSE
			PRINT_TEXT "Paused by %s run – not yours to resume: leave it to that caller, or wait for it." 33 "$WHOSE"
		elif [ -n "$WHOSE" ]; then
			PRINT_TEXT "Paused by %s run." 33 "$WHOSE"
		fi
		# No run resumes a pause naming no operation this version knows, so clearing it is the one step
		if [[ "$STATE_OPERATION" != (amend-into|snapshot|reorder|onto|land|rebase|edit|split) ]]; then
			if [ -n "$OWNER" ]; then
				_EMIT_TRAILER "git-edit: paused – a pause with no operation on record is $OWNER, not yours: leave it to that caller, or clear it with 'git edit --abort --allow-other-actor'"
				_STATUS_EMITTED=true
				return 0
			fi
			PRINT_ERR "The pause records no operation this version knows${STATE_OPERATION:+ ('$STATE_OPERATION')} – its state file cut short, or written by a newer git-edit – so nothing can resume it"
			ECHO_E "\e[0;31m  Clear it with 'git edit --abort', then run it again.\e[0m" >&2
			exit 1
		fi
		# One whose branch moved off the tip it read can't land – its `--continue` refuses at once – so
		# the step named is the abort and redo, as that refusal names it
		if [ -z "$OWNER" ] && [[ "$STATE_OPERATION" == (amend-into|snapshot|reorder|onto|land|rebase) ]] && \
		   [[ "$STATE_BRANCH" == refs/* ]] && [ -d "$STATE_WORKTREE" ]; then
			local AT=${STATE_HEAD_WITH_FIXUP:-$STATE_ORIG_HEAD} NOW
			NOW=$(git rev-parse -q --verify "$STATE_BRANCH" 2>/dev/null)
			if [ -n "$NOW" ] && [ "$NOW" != "$AT" ] && [ "$NOW" != "$(git -C "$STATE_WORKTREE" rev-parse -q --verify HEAD 2>/dev/null)" ]; then
				_MOVED_BY "$STATE_BRANCH"
				PRINT_TEXT "Branch '%s' moved from %s to %s since this paused%s – the resolution in %s was built on the old tip, so it can't land." 33 "${STATE_BRANCH#refs/heads/}" "${AT:0:7}" "${NOW:0:7}" "${REPLY:+ – $REPLY}" "$STATE_WORKTREE"
				_PAUSE_NAME
				[ -n "$STATE_PLACE_LABEL" ] || REPLY+=" ${STATE_TARGET:0:7}"
				_EMIT_TRAILER "git-edit: paused – $REPLY can no longer land: 'git edit --abort', then redo it against the new tip"
				_STATUS_EMITTED=true
				return 0
			fi
		fi
		if [ -d "$STATE_WORKTREE" ]; then
			PRINT_TEXT "Worktree: %s" 33 "$STATE_WORKTREE"
			# Hand the pre-op tip over for a reorder so the step-kind guidance matches the
			# original pause – the other operations change the tree by design, so no
			# resolution is determined for them – a placement's is what it built, as its resume reads
			local STATUS_PREOP=""
			[ "$STATE_OPERATION" = "reorder" ] && STATUS_PREOP=${STATE_PLACED:-$STATE_ORIG_HEAD}
			# Its guidance is the owner's to follow
			local UNMERGED_LIST=""
			[ -z "$OWNER" ] && UNMERGED_LIST=$(_PRINT_CONFLICT_DETAIL "$STATE_WORKTREE" "$STATUS_PREOP")
			# A paused edit or split with no rebase running is authoring, not resolving, so
			# it reports as the pause it is rather than as a conflict
			local STATUS_GITDIR=$(git -C "$STATE_WORKTREE" rev-parse --git-dir 2>/dev/null)
			local STATUS_AUTHORING=false
			local STATUS_VERIFY=false
			local STATUS_MODE=false
			# A gate pause holds a finished rebuild it refused – with no rebase running and
			# nothing unmerged, the conflict report would show no files
			if [ -n "$STATE_MODE_STRAY" ] && [ ! -d "$STATUS_GITDIR/rebase-merge" ] && [ ! -d "$STATUS_GITDIR/rebase-apply" ]; then
				STATUS_MODE=true
				PRINT_TEXT "A file mode changed at %s that nothing asked for – the result is built in the worktree, not applied." 33 "${STATE_MODE_STRAY:0:7}"
			elif [ -n "$STATE_VERIFY_FAILED" ] && [ ! -d "$STATUS_GITDIR/rebase-merge" ] && [ ! -d "$STATUS_GITDIR/rebase-apply" ]; then
				STATUS_VERIFY=true
				PRINT_TEXT "Verification failed at %s – the result is built in the worktree, not applied." 33 "${STATE_VERIFY_FAILED:0:7}"
			elif [ "$STATE_OPERATION" = "split" ]; then
				STATUS_AUTHORING=true
				if [ -z "$OWNER" ]; then
					PRINT_TEXT "Authoring phase – edit the worktree back to what the %s commit should leave behind." 33 "first"
					_PRINT_SPLIT_KEEPS "$STATE_TARGET"
				fi
			elif [ "$STATE_OPERATION" = "edit" ] && [ ! -d "$STATUS_GITDIR/rebase-merge" ] && [ ! -d "$STATUS_GITDIR/rebase-apply" ]; then
				STATUS_AUTHORING=true
				# Past the amend, the worktree holds what the replay built – a gate cut off, say
				if [ -n "$OWNER" ]; then
					:
				elif [ "$(git -C "$STATE_WORKTREE" rev-parse HEAD 2>/dev/null)" = "$STATE_TARGET" ]; then
					PRINT_TEXT "Authoring phase – edit files in the worktree (add %s to also reword)." 33 '--text "…"'
				elif _PAUSE_HAND_ABORTED; then
					PRINT_TEXT "The replay was aborted by hand, nothing applied – reset the worktree to the amend: %s" 33 "git -C $(_SHQ "$STATE_WORKTREE") reset --hard ${STATE_AMENDED:0:12}"
				else
					PRINT_TEXT "Past the amend – the result is built in the worktree, not applied; edits made there now land nowhere." 33
				fi
			fi
			if [ -n "$OWNER" ]; then
				# A placement's name holds its anchor already
				_PAUSE_NAME
				[ -n "$STATE_PLACE_LABEL" ] || REPLY+=" ${STATE_TARGET:0:7}"
				_EMIT_TRAILER "git-edit: paused – $REPLY is $OWNER, not yours: leave it to that caller, or wait for it ('--allow-other-actor' takes it on)"
				_STATUS_EMITTED=true
			elif [ "$STATUS_MODE" = "true" ]; then
				EMIT_MODE_PAUSED "$STATE_MODE_STRAY" "$STATE_WORKTREE"
			elif [ "$STATUS_VERIFY" = "true" ]; then
				EMIT_VERIFY_PAUSED "$STATE_VERIFY_FAILED" "$STATE_WORKTREE"
			elif [ "$STATUS_AUTHORING" = "true" ]; then
				PRINT_TEXT "Then %s – or cancel via %s." 33 "git edit --continue" "git edit --abort"
				EMIT_PAUSED "$STATE_OPERATION" "$STATE_TARGET" "$STATE_WORKTREE"
			elif [ ! -d "$STATUS_GITDIR/rebase-merge" ] && [ ! -d "$STATUS_GITDIR/rebase-apply" ] && _PAUSE_HAND_ABORTED; then
				# The verdict its resume gives, which refuses it
				PRINT_ERR "The rebase in $STATE_WORKTREE was aborted by hand – nothing was applied, and 'git edit --continue' refuses it"
				ECHO_E "\e[0;31m  Clear the pause with 'git edit --abort'.\e[0m" >&2
				exit 1
			else
				# One finished by hand that lost a commit – a raw `git rebase --skip` – gets the
				# verdict its resume gives too, refused
				[ ! -d "$STATUS_GITDIR/rebase-merge" ] && [ ! -d "$STATUS_GITDIR/rebase-apply" ] && \
					_REQUIRE_PICKS_KEPT "$STATE_WORKTREE"
				PRINT_TEXT "Resolve there, then %s – or cancel via %s." 33 "git edit --continue" "git edit --abort"
				EMIT_CONFLICT "$STATE_WORKTREE" "$UNMERGED_LIST"
			fi
		elif [ -n "$OWNER" ]; then
			_PAUSE_NAME
			PRINT_ERR "The paused $REPLY's worktree is gone, and the pause is $OWNER, not yours – leave it to that caller, or clear it with 'git edit --abort --allow-other-actor'"
			exit 1
		else
			PRINT_ERR "State exists but its worktree is gone${WHOSE:+ – the pause is $WHOSE} – run 'git edit --abort' to clear"
			exit 1
		fi
	else
		local JF=$(_JOURNAL_FILE_PATH)
		if [ -n "$JF" ] && [ -s "$JF" ]; then
			local LAST=$(tail -1 "$JF")
			LAST=${LAST%$'\t'*}
			PRINT_TEXT "No operation in flight. Last completed: %s (%s → %s)" 32 "$(print -r -- "$LAST" | cut -d' ' -f5-)" "$(print -r -- "$LAST" | awk '{print substr($3,1,7)}')" "$(print -r -- "$LAST" | awk '{print substr($4,1,7)}')"
			# Its undo, the caller's own as `--undo` takes it, with what a raw one leaves to do – while
			# the ref holds what it landed, or sits back where it started, taken back outside git-edit
			local CUR
			local -a ALL F
			ALL=("${(@f)$(<"$JF")}")
			_UNDO_PICK
			if (( REPLY && REPLY == ${#ALL} )) && [[ -z "$_ACTOR_ID" || "${ALL[REPLY]}" == *$'\t'"$_ACTOR_ID" ]]; then
				F=(${=${ALL[REPLY]%%$'\t'*}})
				CUR=$(git rev-parse -q --verify "${F[2]}" 2>/dev/null)
				if [ "$CUR" = "${F[4]}" ]; then
					ECHO_E "\e[0;90mUndo: git edit --undo  (or, the ref alone: $(_LIT "$(_UNDO_REF_CMD "${F[2]}" "${F[3]}" "${F[4]}" "${F[5,-1]}")"))\e[0m"
					_RAW_UNDO_STEPS "${F[2]}" "${F[3]}" "${F[4]}" "${F[5,-1]}"
				elif [ "$CUR" = "${F[3]}" ]; then
					PRINT_TEXT "Taken back outside git-edit – %s sits at %s again" 33 "${F[2]#refs/heads/}" "${F[3]:0:7}"
					_RAW_UNDO_STEPS "${F[2]}" "${F[3]}" "${F[4]}" "${F[5,-1]}"
				fi
			fi
		else
			PRINT_TEXT "%s" 32 "No operation in flight."
		fi
		_EMIT_TRAILER "git-edit: ok – no operation in flight"
		_STATUS_EMITTED=true
	fi
}

# Names the checkout that has <ref> checked out – an isolated run reports from its temp
# worktree, and the index that needs reconciling is the branch's own, wherever that sits
_BRANCH_CHECKOUT () {
	# Args: <refname>
	local LINE WT="" HERE=$(cd "$_START_DIR" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null)
	local -a FOUND
	for LINE in "${(@f)$(git worktree list --porcelain 2>/dev/null)}"; do
		case $LINE in
			"worktree "*) WT=${LINE#worktree } ;;
			"branch $1") FOUND+=("$WT") ;;
		esac
	done
	(( ${#FOUND} )) || return 1
	# Of a branch checked out twice (`git worktree add -f`), the caller's copy is the one it stands in
	[ -n "$HERE" ] && (( ${FOUND[(Ie)$HERE]} )) && { print -r -- "$HERE"; return 0; }
	print -r -- "${FOUND[1]}"
}

# Re-syncs the stranded index entries of every other checkout holding <ref> – a branch checked out
# twice (`git worktree add -f`) – and names them, its files left as they are, once per move
_RESYNC_OTHER_CHECKOUTS () {
	# Args: <ref> <old tip> <new tip>
	[ -n "$_IN_LANDED_STEP" ] || { _LANDED_STEP "$0" "$@"; return; }
	[ "$_OTHERS_RESYNCED" = "$1 $2 $3" ] && return 0
	_OTHERS_RESYNCED="$1 $2 $3"
	# Read again where a signal cut it short – read empty, the caller's checkout would count as another
	_LANDED_OUT _BRANCH_CHECKOUT "$1"
	local PRIMARY=$REPLY LINE WT="" O FORMER=pre-rewrite
	local -a OTHERS RESYNCED LEFT_ALONE LOCKED
	# Commits only added on top rewrote nothing
	_IS_ANCESTOR "$2" "$3" && FORMER=previous
	# Nothing there was taken whole by this run
	local -A WHOLE_IDX
	for LINE in "${(@f)$(git worktree list --porcelain 2>/dev/null)}"; do
		case $LINE in
			"worktree "*) WT=${LINE#worktree } ;;
			"branch $1") [ "$WT" = "$PRIMARY" ] || OTHERS+=("$WT") ;;
		esac
	done
	for O in "${OTHERS[@]}"; do
		[ -d "$O" ] || continue
		_RESYNC_STRANDED_ENTRIES "$O" "$2" "$3"
		# Its mark kept at or below <old>, and each file left other than what landed recorded there, so
		# the guard reading that checkout's record refuses a commit there taking the landing back
		_BROUGHT_HOLD "$O" "$2"
		_UNBROUGHT_OTHER "$O" "$2" "$3"
		PRINT_TEXT "Also checked out at %s – its files left as they were%s" 33 "$O" "${RESYNCED:+, index entries re-synced: $(_SOME_PATHS "${RESYNCED[@]}")}"
		(( ${#LEFT_ALONE} )) && PRINT_TEXT "  Its index entries left alone, differing from the $FORMER tip: %s" 33 "$(_ALL_PATHS "${LEFT_ALONE[@]}")"
		(( ${#RESET_SPARSE} )) && PRINT_TEXT "  Files this git can't place in its sparse checkout (2.42 can), left out as outside it: %s – write those inside it with: %s" 33 "$(_SOME_PATHS "${RESET_SPARSE[@]}")" "cd $(_SHQ "$O") && git sparse-checkout reapply"
		if (( ${#LOCKED} )); then
			PRINT_TEXT "  Its index entries not re-synced, the index was locked: %s" 33 "$(_SOME_PATHS "${LOCKED[@]}")"
			_LOCKED_RESYNC_STEP "$O" "${2:0:12}" "git restore --source=${3:0:12} --staged" "${LOCKED[@]}"
			PRINT_TEXT "  Re-sync each still on the $FORMER tip once it is free: %s" 33 "$REPLY"
		fi
	done
	return 0
}

# Fills `DIFF_PATHS` with what changed from <old> to <new>, and `DIFF_O`/`DIFF_N` with the
# "<mode> <blob>" each side holds – one raw diff, as a git call a path took a minute on thousands
_DIFF_ENTRIES () {
	# Args: <old> <new> – the caller declares `DIFF_PATHS`, and `DIFF_O`/`DIFF_N` associative
	local P
	local -a RAW META
	local -i K
	DIFF_PATHS=(); DIFF_O=(); DIFF_N=()
	RAW=("${(@0)$(git diff-tree -r -z --no-renames "$1" "$2" 2>/dev/null)}")
	for (( K = 1; K + 1 <= ${#RAW}; K += 2 )); do
		META=(${=${RAW[K]#:}})
		P=${RAW[K + 1]}
		[ -n "$P" ] || continue
		DIFF_PATHS+=("$P")
		[ "${META[1]}" = 000000 ] || DIFF_O[$P]="${META[1]} ${META[3]}"
		[ "${META[2]}" = 000000 ] || DIFF_N[$P]="${META[2]} ${META[4]}"
	done
}

# Succeeds where <arg>s fit one command line with room to spare – counted in bytes, as the limit
# is, so a few hundred long paths read past it as surely as thousands of short ones
_ARGV_FITS () {
	# Args: <arg>...
	setopt local_options no_multibyte
	(( ${#${(j::)@}} + 9 * $# <= 262144 ))
}

# Runs `git <arg>... -- <path>...` once for each command line's worth of paths, as `_ARGV_FITS`
# counts it, each path taken literally – printing what each run prints, nothing where no path is
# given, and failing as the worst run fails
_GIT_PATH_CHUNKS () {
	# Args: <git arg>... `--` <path>...
	setopt local_options no_multibyte
	local -x GIT_LITERAL_PATHSPECS=1
	local -i I=${@[(i)--]} N B RC=0
	local -a CMD REST
	local S
	CMD=("${(@)@[1,I-1]}") REST=("${(@)@[I+1,-1]}")
	while (( ${#REST} )); do
		N=0 B=0
		for S in "${REST[@]}"; do
			(( (B += ${#S} + 9) > 262144 && N )) && break
			N+=1
		done
		git "${CMD[@]}" -- "${(@)REST[1,N]}"
		B=$?
		(( B > RC )) && RC=B
		REST=("${(@)REST[N+1,-1]}")
	done
	return $RC
}

# Fills `TREE_ENT` with the "<mode> <object>" <tree-ish> holds at each <path> – a directory's
# too, as `ls-tree` names one, none where it holds none – one `ls-tree` a command line of paths
_TREE_ENTRIES () {
	# Args: <tree-ish> <path>... – the caller declares `TREE_ENT` associative
	local REV=$1 E
	shift
	TREE_ENT=()
	(( $# )) || return 0
	# Recursing reaches a path under a directory, which `-t` lists too
	for E in ${(0)"$(_GIT_PATH_CHUNKS ls-tree -r -t -z --full-tree "$REV" -- "$@" 2>/dev/null)"}; do
		TREE_ENT[${E#*$'\t'}]="${E%% *} ${${E%%$'\t'*}##* }"
	done
}

# Fills `OBJ_AT` with the object <rev>:<path> names for each <path> where `git cat-file -e` finds
# one – in one `cat-file --batch-check`, which reads a line per name, so a name with a newline or a
# trailing CR, and a submodule's commit, which it answers without looking it up, are asked apart
_OBJECTS_AT () {
	# Args: <rev> <path>... – the caller declares `OBJ_AT` associative
	local REV=$1 P
	local -a ASK ANS ALONE
	local -i K
	shift
	OBJ_AT=()
	for P in "$@"; do
		if [[ "$P" == *$'\n'* || "$P" == *$'\r' ]]; then ALONE+=("$P"); else ASK+=("$P"); fi
	done
	# Each answer read back by position – one missing echoes its name, which opens on <rev> and a colon
	(( ${#ASK} )) && ANS=("${(@f)$(print -rl -- "${(@)ASK/#/$REV:}" | git cat-file --batch-check='%(objectname) %(objecttype)' 2>/dev/null)}")
	if (( ${#ANS} == ${#ASK} )) && (( ! ${ANS[(I)]} )); then
		for (( K = 1; K <= ${#ASK}; K++ )); do
			if [[ "${ANS[K]}" =~ '^[0-9a-f]{40,64} (blob|tree|commit|tag)$' ]]; then
				OBJ_AT[${ASK[K]}]=${ANS[K]%% *}
			elif [[ "${ANS[K]}" =~ '^[0-9a-f]{40,64} submodule$' ]]; then
				ALONE+=("${ASK[K]}")
			fi
		done
	else
		ALONE+=("${ASK[@]}")
	fi
	for P in "${ALONE[@]}"; do
		git cat-file -e "$REV:$P" 2>/dev/null && OBJ_AT[$P]=$(git rev-parse "$REV:$P")
	done
	return 0
}

# Fills `WT_HASH` with what `_WORKTREE_HASH` prints for each <path> of <checkout> that is a file
# there, under no link or file, in one `hash-object --stdin-paths` – a name it misreads, a link and
# every path where the batch fails left to `_WORKTREE_HASH`
_WORKTREE_HASHES () {
	# Args: <checkout> <path>... – the caller declares `WT_HASH` associative
	local CO=$1 P
	local -a ASK ANS
	local -i K
	shift
	WT_HASH=()
	for P in "$@"; do
		# One holding a newline, ending in a CR it strips, or opening on a quote it unquotes
		[[ "$P" == *$'\n'* || "$P" == *$'\r' || "$P" == \"* ]] && continue
		[ -f "$CO/$P" ] && [ ! -L "$CO/$P" ] && ! _LEADING_NON_DIR "$CO" "$P" && ASK+=("$P")
	done
	(( ${#ASK} )) || return 0
	ANS=("${(@f)$(print -rl -- "${ASK[@]}" | git -C "$CO" hash-object --stdin-paths 2>/dev/null)}") || return 0
	(( ${#ANS} == ${#ASK} )) || return 0
	for (( K = 1; K <= ${#ASK}; K++ )); do
		[[ "${ANS[K]}" =~ '^[0-9a-f]{40,64}$' ]] || { WT_HASH=(); return 0; }
		WT_HASH[${ASK[K]}]=${ANS[K]}
	done
}

# Puts into `REPLY` the hash of <path> of <checkout> as `WT_HASH` read it, or as `_WORKTREE_HASH`
# reads it now where that holds none, failing as it fails
_HASH_READ () {
	# Args: <checkout> <path> – reads the caller's `WT_HASH`
	if (( ${+WT_HASH[$2]} )); then
		REPLY=${WT_HASH[$2]}
	else
		REPLY=$(_WORKTREE_HASH "$1" "$2")
	fi
}

# Fills `IDX_ENT` with the "<mode> <blob>" an index holds at stage 0 for each <path>, `conflict`
# where it holds stages – one `ls-files`, narrowed to the paths where they are few
_INDEX_ENTRIES () {
	# Args: <checkout> <index file, empty for its own> <path>... – the caller declares `IDX_ENT`
	local CO=$1 IDX=$2 E P META
	local -x GIT_LITERAL_PATHSPECS=1
	local -a SPEC
	shift 2
	IDX_ENT=()
	(( $# )) || return 0
	_ARGV_FITS "$@" && SPEC=(-- "$@")
	for E in ${(0)"$(if [ -n "$IDX" ]; then GIT_INDEX_FILE=$IDX git -C "$CO" ls-files -s -z "${SPEC[@]}"; else git -C "$CO" ls-files -s -z "${SPEC[@]}"; fi 2>/dev/null)"}; do
		META=${E%%$'\t'*}
		P=${E#*$'\t'}
		if [ "${META##* }" != 0 ]; then IDX_ENT[$P]=conflict
		elif [ "${IDX_ENT[$P]}" != conflict ]; then IDX_ENT[$P]=${META% *}
		fi
	done
}

# Fills `reply` with each <name> an index holds an entry at – one `ls-files` a depth, leaving out
# what lies under the names it asks for, as a directory's would bring its whole tree
_INDEX_AT () {
	# Args: <checkout> <index file> <name>...
	local CO=$1 IDX=$2 D ALL=""
	local -i N TOP=0
	local -a SPEC
	local -A WANT
	local -x GIT_LITERAL_PATHSPECS=1
	shift 2
	reply=()
	# Past a hundred names, which git matches each entry against,
	# or one command line, the whole index is read instead
	if (( $# <= 100 )); then
		for D in "$@"; do (( ${#${D//[^\/]}} > TOP )) && TOP=${#${D//[^\/]}}; done
		for (( N = 0; N <= TOP; N++ )); do
			SPEC=()
			for D in "$@"; do (( ${#${D//[^\/]}} == N )) && SPEC+=(":(top,literal)$D" ":(exclude,top,literal)$D/"); done
			(( ${#SPEC} )) || continue
			_ARGV_FITS "${SPEC[@]}" || { ALL=1; break; }
			# Magic read for the exclusion alone, each name marked literal
			reply+=(${(0)"$(GIT_LITERAL_PATHSPECS=0 GIT_INDEX_FILE=$IDX git -C "$CO" ls-files -z -- "${SPEC[@]}" 2>/dev/null)"})
		done
		[ -n "$ALL" ] || return 0
	fi
	reply=()
	for D in "$@"; do WANT[$D]=1; done
	for D in ${(0)"$(GIT_INDEX_FILE=$IDX git -C "$CO" ls-files -z 2>/dev/null)"}; do (( ${+WANT[$D]} )) && reply+=("$D"); done
	return 0
}

# Fills `IN_WAY` with each <path> an index holds no entry at whose entry, put there, would replace
# another – one under it, or one at a directory it lies in – as `--index-info` and a reset do,
# naming that one, but for those the caller's `GOES` takes out alongside
_ENTRIES_IN_THE_WAY () {
	# Args: <checkout> <index file> <path>... – reads the caller's
	# `IDX_ENT`, read for those paths, so holding what lies under each
	local CO=$1 IDX=$2 P D E
	local -a DIRS
	local -A UNDER HELD
	shift 2
	IN_WAY=()
	# Each directory an entry staying lies in, in one pass – its parents taken already where it was
	for E in "${(@k)IDX_ENT}"; do
		(( ${+GOES[$E]} )) && continue
		D=$E
		while [[ "$D" == */* ]]; do
			D=${D%/*}
			(( ${+UNDER[$D]} )) && break
			UNDER[$D]=$E
		done
	done
	for P in "$@"; do
		if (( ${+UNDER[$P]} )); then
			IN_WAY[$P]=${UNDER[$P]}
			continue
		fi
		D=$P
		while [[ "$D" == */* ]]; do D=${D%/*}; DIRS+=("$D"); done
	done
	(( ${#DIRS} )) || return 0
	_INDEX_AT "$CO" "$IDX" "${(@u)DIRS}"
	for D in "${reply[@]}"; do (( ${+GOES[$D]} )) || HELD[$D]=1; done
	for P in "$@"; do
		(( ${+IN_WAY[$P]} )) && continue
		D=$P
		while [[ "$D" == */* ]]; do
			D=${D%/*}
			(( ${+HELD[$D]} )) && { IN_WAY[$P]=$D; break; }
		done
	done
	return 0
}

# Puts into `REPLY` why <path>'s entry stays out –
# <blocker> staged under it, or at a directory it lies in
_IN_WAY_WHY () {
	# Args: <path> <blocker> <noun for what put it there>
	if [[ "$2" == "$1"/* ]]; then
		REPLY="files staged under it where the $3 put a file"
	else
		_ONE_LINE "$2"
		REPLY="$REPLY staged where its directory goes"
	fi
}

# Fills the caller's `FLAG_AU` and `FLAG_SW` with the <path>s an index flags assume-unchanged or
# skip-worktree – a lowercase `ls-files -v` tag the one, `S` or `s` the other
_INDEX_FLAGS () {
	# Args: <checkout> <index file, empty for its own> <path>...
	local CO=$1 IDX=$2 L
	local -x GIT_LITERAL_PATHSPECS=1
	local -a SPEC
	local -A WANT
	shift 2
	FLAG_AU=() FLAG_SW=()
	(( $# )) || return 0
	# Many paths are read from the whole index instead, as `_INDEX_ENTRIES` does
	if _ARGV_FITS "$@"; then SPEC=(-- "$@"); else for L in "$@"; do WANT[$L]=1; done; fi
	for L in ${(0)"$(if [ -n "$IDX" ]; then GIT_INDEX_FILE=$IDX git -C "$CO" ls-files -v -z "${SPEC[@]}"; else git -C "$CO" ls-files -v -z "${SPEC[@]}"; fi 2>/dev/null)"}; do
		(( ${#WANT} == 0 || ${+WANT[${L[3,-1]}]} )) || continue
		[[ "${L[1]}" == [a-z] ]] && FLAG_AU+=("${L[3,-1]}")
		[[ "${L[1]}" == [Ss] ]] && FLAG_SW+=("${L[3,-1]}")
	done
	return 0
}

# Sets the flags `_INDEX_FLAGS` read again, on each of those paths the index still holds
_INDEX_FLAGS_BACK () {
	# Args: <checkout> <index file, empty for its own>
	local CO=$1 IDX=$2 L
	local -x GIT_LITERAL_PATHSPECS=1
	local -a AU SW HELD SPEC
	(( ${#FLAG_AU} + ${#FLAG_SW} )) || return 0
	# Many paths read the whole index instead – a sparse checkout flags thousands
	_ARGV_FITS "${FLAG_AU[@]}" "${FLAG_SW[@]}" && SPEC=(-- "${FLAG_AU[@]}" "${FLAG_SW[@]}")
	HELD=(${(0)"$(if [ -n "$IDX" ]; then GIT_INDEX_FILE=$IDX git -C "$CO" ls-files -z "${SPEC[@]}"; else git -C "$CO" ls-files -z "${SPEC[@]}"; fi 2>/dev/null)"})
	AU=(${FLAG_AU:*HELD}) SW=(${FLAG_SW:*HELD})
	if [ -n "$IDX" ]; then
		{ (( ! ${#AU} )) || print -rN -- "${AU[@]}" | GIT_INDEX_FILE=$IDX git -C "$CO" update-index --assume-unchanged -z --stdin; } && \
		{ (( ! ${#SW} )) || print -rN -- "${SW[@]}" | GIT_INDEX_FILE=$IDX git -C "$CO" update-index --skip-worktree -z --stdin; }
	else
		{ (( ! ${#AU} )) || print -rN -- "${AU[@]}" | git -C "$CO" update-index --assume-unchanged -z --stdin; } && \
		{ (( ! ${#SW} )) || print -rN -- "${SW[@]}" | git -C "$CO" update-index --skip-worktree -z --stdin; }
	fi 2>/dev/null
}

# Puts into `reply` the files <checkout> reads as modified only through their attributes – each byte
# for byte the blob its index holds, which `eol` or `text` would store otherwise, so nobody's edit:
# a file committed with CRLF under `eol=lf` reads so wherever git wrote it in its index's second
_RENORM_ONLY () {
	# Args: <checkout> [<path>... – those alone, where they fit one command line]
	local CO=$1
	local -x GIT_LITERAL_PATHSPECS=1
	local -a REC F CAND BLOB SUMS SPEC
	local -i I
	shift
	reply=()
	(( $# )) && _ARGV_FITS "$@" && SPEC=(-- "$@")
	REC=("${(@0)$(git -C "$CO" diff-files -z --ignore-submodules "${SPEC[@]}" 2>/dev/null)}")
	for (( I = 1; I < ${#REC}; I += 2 )); do
		# ":<mode> <mode> <blob> <blob> M" – a changed mode is an edit
		F=(${=REC[I]#:})
		[[ "${F[5]}" == M && "${F[1]}" == "${F[2]}" && "${F[1]}" == 1006(44|55) ]] || continue
		CAND+=("${REC[I+1]}") BLOB+=("${F[3]}")
	done
	(( ${#CAND} )) || return 0
	if _ARGV_FITS "${CAND[@]}"; then
		SUMS=(${(f)"$(git -C "$CO" hash-object --no-filters -- "${CAND[@]}" 2>/dev/null)"})
	else
		for (( I = 1; I <= ${#CAND}; I++ )); do SUMS+=("$(git -C "$CO" hash-object --no-filters -- "${CAND[I]}" 2>/dev/null)"); done
	fi
	(( ${#SUMS} == ${#CAND} )) || return 0
	for (( I = 1; I <= ${#CAND}; I++ )); do
		[ "${SUMS[I]}" = "${BLOB[I]}" ] && reply+=("${CAND[I]}")
	done
	return 0
}

# Has <worktree> know each file `_RENORM_ONLY` finds as checked out – one read as modified refuses a
# rebase, its resume and a checkout over it, and a blanket `git add` restages it
# Written back from the index flagged assume-unchanged, which the refresh then takes as current
# unhashed, the flag dropped in that same write – a second later, as git re-hashes a file written
# in its index's own second, and the hash differs
_RENORM_SETTLE () {
	# Args: <worktree> [<path>... – as `_RENORM_ONLY` takes them]
	local WT=$1
	local -a P
	local -i AT N=0
	[ -n "$WT" ] && [ -d "$WT" ] || return 0
	_RENORM_ONLY "$@"
	P=("${reply[@]}")
	(( ${#P} )) || return 0
	# Named before the flag goes on, so a run stopped from here takes it off on its way out – in a
	# subshell, whose traps are reset and which runs no exit trap, through traps of its own
	_RENORM_FLAGGED=("$WT" "${P[@]}")
	if (( ZSH_SUBSHELL )); then
		setopt local_options local_traps
		trap '_RENORM_UNFLAG "${_RENORM_FLAGGED[@]}"; exit 129' HUP
		trap '_RENORM_UNFLAG "${_RENORM_FLAGGED[@]}"; exit 130' INT
		trap '_RENORM_UNFLAG "${_RENORM_FLAGGED[@]}"; exit 143' TERM
	fi
	if ! print -rN -- "${P[@]}" | git -C "$WT" update-index --assume-unchanged -z --stdin 2>/dev/null; then
		_RENORM_FLAGGED=()
		return 0
	fi
	print -rN -- "${P[@]}" | git -C "$WT" checkout-index -f -u -z --stdin 2>/dev/null
	AT=$EPOCHSECONDS
	while (( EPOCHSECONDS <= AT && ++N <= 30 )); do sleep 0.05; done
	_RENORM_UNFLAG "$WT" "${P[@]}"
	return 0
}

# Takes the assume-unchanged flag `_RENORM_SETTLE` put on <path>s in <worktree> off again – never
# left on, which would hide a later edit – a peer's index lock waited out
_RENORM_UNFLAG () {
	# Args: <worktree> <path>...
	local WT=$1
	local -i N=0
	shift
	until print -rN -- "$@" | git -C "$WT" update-index -q --refresh --no-assume-unchanged -z --stdin 2>/dev/null; do
		(( ++N > 50 )) && break
		sleep 0.1
	done
	_RENORM_FLAGGED=()
}

# Answers whether the rebase in <worktree> stopped only over files read as modified through their
# attributes – git's own write of one, re-read in the same second – settling them, so a resume
# passes where the stop's step is retried or done
_RENORM_STOPPED () {
	# Args: <worktree> <its output, in C>
	local GD=$(git -C "$1" rev-parse --absolute-git-dir 2>/dev/null)
	[ -d "$GD/rebase-merge" ] && [ -z "$(_UNMERGED_IN "$1")" ] || return 1
	[[ "$2" == *"would be overwritten by "* || "$2" == *"left changes to the index and/or the working tree"* || \
	   "$2" == *"mark them as resolved using git add"* ]] && [[ "$2" != *"untracked working tree files would be"* ]] || return 1
	_RENORM_ONLY "$1"
	(( ${#reply} )) || return 1
	PRINT_TEXT "%s read as modified only through its attributes – settled, resuming" 90 "$(_SOME_PATHS "${reply[@]}")" >&2
	_RENORM_SETTLE "$1"
	git -C "$1" diff-files --quiet --ignore-submodules 2>/dev/null
}

# Runs <command>, `eval`d in C, then <resume command> past each stop `_RENORM_STOPPED` settles in
# <worktree>, the rebase's – the last run's output on stdout, its status returned
_RENORM_EVAL () {
	# Args: <worktree> <command> <resume command>
	local OUT RC
	local -i N=0
	OUT=$( export LC_ALL=C; eval "$2" 2>&1 )
	RC=$?
	while (( RC )) && (( ++N <= 100 )) && _RENORM_STOPPED "$1" "$OUT"; do
		OUT=$( export LC_ALL=C; eval "$3" 2>&1 )
		RC=$?
	done
	print -r -- "$OUT"
	return $RC
}

# Puts into `REPLY` the plain resume of a rebase begun with no editor of its own
_RENORM_RESUME_CMD () {
	REPLY="GIT_SEQUENCE_EDITOR=true GIT_EDITOR=true git -c commit.cleanup=verbatim -c rerere.enabled=true -c rerere.autoUpdate=false -c rebase.updateRefs=false -c advice.mergeConflict=false -c advice.resolveConflict=false $_CAPTURE_PINS rebase --continue"
}

# Takes <index>'s lock – whoever creates `index.lock` owns the index until letting go, created
# exclusively as git does, `noclobber` opening it `O_EXCL` – a peer mid-`add`, or a `git status`
# refreshing it for a moment, waited out for ~5 s, failing past that
_LOCK_INDEX () {
	# Args: <index file>
	local -i W=0
	until ( setopt noclobber; : > "$1.lock" ) 2>/dev/null; do
		(( ++W > 50 )) && return 1
		sleep 0.1
	done
	return 0
}

# Resets each path's index entry to the checkout's `HEAD` where it still holds the entry this run
# expects – checked and written under git's own index lock, so a peer staging one meanwhile keeps it
_RESET_IF_STAGED_AS () {
	# Args: <checkout> (<path> <expected "mode blob", empty for none>)...
	# Fills `RESET_DONE`, `RESET_KEPT` – a path, or the staged file in its way – `RESET_LOCKED`, and
	# `RESET_SPARSE` with the entries flagged as maybe outside a sparse checkout, which git can't ask
	local CO=$1 IDX TMP P HAVE
	local -i I
	local -a PAIRS CAND
	local -x GIT_LITERAL_PATHSPECS=1
	shift
	PAIRS=("$@")
	RESET_DONE=(); RESET_KEPT=(); RESET_LOCKED=(); RESET_SPARSE=()
	(( ${#PAIRS} )) || return 0
	IDX=$(git -C "$CO" rev-parse --path-format=absolute --git-path index 2>/dev/null) || return 1
	TMP="$IDX.git-edit.$$"
	_TEMP_FILES+=("$TMP")
	if ! _LOCK_INDEX "$IDX"; then
		for (( I = 1; I <= ${#PAIRS}; I += 2 )); do RESET_LOCKED+=("${PAIRS[I]}"); done
		return 0
	fi
	{
		# A copy that failed would leave `reset` building an index of these paths alone
		if [ -e "$IDX" ] && ! cp -p "$IDX" "$TMP" 2>/dev/null; then
			for (( I = 1; I <= ${#PAIRS}; I += 2 )); do RESET_LOCKED+=("${PAIRS[I]}"); done
			return 0
		fi
		local -A IDX_ENT
		local -a PP
		for (( I = 1; I <= ${#PAIRS}; I += 2 )); do PP+=("${PAIRS[I]}"); done
		_INDEX_ENTRIES "$CO" "$TMP" "${PP[@]}"
		local -A GOES IN_WAY
		local -a ADDS HELD
		for (( I = 1; I <= ${#PAIRS}; I += 2 )); do
			P=${PAIRS[I]}
			if [ "${IDX_ENT[$P]}" = "${PAIRS[I + 1]}" ]; then
				CAND+=("$P")
				GOES[$P]=1
				[ -n "${IDX_ENT[$P]}" ] || ADDS+=("$P")
			else
				RESET_KEPT+=("$P")
			fi
		done
		# A reset of a path the index holds nothing at takes along what its pathspec reaches
		# under it, and drops one at a directory it lies in where `HEAD` has the path – staging
		# that stays, named, the path left as it is
		(( ${#ADDS} )) && _ENTRIES_IN_THE_WAY "$CO" "$TMP" "${ADDS[@]}"
		for P in "${(@k)IN_WAY}"; do
			if [[ "${IN_WAY[$P]}" == "$P"/* ]]; then
				RESET_KEPT+=("$P")
			elif [ -n "$(git -C "$CO" ls-tree --full-tree HEAD -- "$P" 2>/dev/null)" ]; then
				RESET_KEPT+=("${IN_WAY[$P]}")
			else
				continue
			fi
			HELD+=("$P")
		done
		CAND=("${(@)CAND:|HELD}")
		RESET_KEPT=("${(@u)RESET_KEPT}")
		if (( ${#CAND} )); then
			# A fresh entry drops an assume-unchanged or skip-worktree flag, which goes back on after
			local -a FLAG_AU FLAG_SW GONE_ITA ABSENT
			_INDEX_FLAGS "$CO" "$TMP" "${CAND[@]}"
			# A git before 2.35 adds an entry outside a sparse checkout unflagged, reading as deleted
			# there – flagged as a later one flags it, each one absent where this git can't ask
			if [[ "$(git --version 2>/dev/null)" =~ '^git version 2\.([0-9]+)\.' ]] && (( match[1] < 35 )); then
				for P in "${(@)ADDS:*CAND}"; do [ -e "$CO/$P" ] || [ -L "$CO/$P" ] || ABSENT+=("$P"); done
				_SPARSE_OUT "$CO" "${ABSENT[@]}" || RESET_SPARSE=("${reply[@]}")
				FLAG_SW+=("${reply[@]}")
			fi
			# An intent-to-add entry holding the blob `HEAD` has is one `reset` finds nothing to change
			# in – taken out first, so `HEAD`'s takes its place
			local -A ITA
			_INDEX_ITA "$CO" "${CAND[@]}"
			for P in "${CAND[@]}"; do (( ${+ITA[$P]} )) && GONE_ITA+=("$P"); done
			# The paths through stdin, as a large rewrite strands more than one command line holds
			if { (( ! ${#GONE_ITA} )) || print -rN -- "${GONE_ITA[@]}" | GIT_INDEX_FILE=$TMP git -C "$CO" update-index --force-remove -z --stdin 2>/dev/null; } && \
			   print -rN -- "${CAND[@]}" | GIT_INDEX_FILE=$TMP git -C "$CO" reset -q --pathspec-from-file=- --pathspec-file-nul >/dev/null 2>&1 && \
			   { _INDEX_FLAGS_BACK "$CO" "$TMP"; true; } && \
			   mv -f "$TMP" "$IDX"; then
				RESET_DONE=("${CAND[@]}")
			else
				RESET_LOCKED+=("${CAND[@]}") RESET_SPARSE=()
			fi
		fi
	} always {
		rm -f "$TMP" "$IDX.lock"
	}
}

# Re-syncs a fold's paths to the new tip where their entries still hold what the fold read, and
# names any staged anew meanwhile, which keep their staging
_RESYNC_FOLDED () {
	# Args: <checkout> <tree the fold read> <path>...
	[ -n "$_IN_LANDED_STEP" ] || { _LANDED_STEP "$0" "$@"; return; }
	local CO=$1 TREE=$2 P
	local -a PAIRS
	local -A TREE_ENT
	shift 2
	# Read by the sync, which merges what the replay changed past it into each file
	_FOLD_READ=("$CO" "$TREE" "$@")
	_TREE_ENTRIES "$TREE" "$@"
	for P in "$@"; do PAIRS+=("$P" "${TREE_ENT[$P]}"); done
	_RESET_IF_STAGED_AS "$CO" "${PAIRS[@]}"
	(( ${#RESET_KEPT} )) && PRINT_TEXT "Left staged, changed since the fold read it: %s" 33 "$(_ALL_PATHS "${RESET_KEPT[@]}")"
	if (( ${#RESET_LOCKED} )); then
		_LOCKED_RESYNC_STEP "$CO" "${TREE:0:12}" "git reset -q" "${RESET_LOCKED[@]}"
		PRINT_TEXT "Not re-synced, the index was locked: %s – once it is free, re-sync each still as the fold read it: %s" 33 "$(_SOME_PATHS "${RESET_LOCKED[@]}")" "$REPLY"
	fi
	return 0
}

# Brings into <checkout>'s files what a fold's replay changed in those it folded as staged – a
# landing above its target, say – by the sync, which merges each from what the fold read, where any
# differs so at <new> – where the sync can't run, naming each file's merge
_SYNC_FOLDED () {
	# Args: <checkout> <old tip> <new tip> – reads `_FOLD_READ`
	[ -n "$_IN_LANDED_STEP" ] || { _LANDED_STEP "$0" "$@"; return; }
	local CO=$1 P
	local -a GO
	local -A TREE_ENT AT_NEW
	[ -n "${_FOLD_READ[1]}" ] && [ "${_FOLD_READ[1]}" -ef "$CO" ] && (( ${#_FOLD_READ} > 2 )) || return 0
	_TREE_ENTRIES "$3" "${(@)_FOLD_READ[3,-1]}"
	AT_NEW=("${(@kv)TREE_ENT}")
	TREE_ENT=()
	_TREE_ENTRIES "${_FOLD_READ[2]}" "${(@)_FOLD_READ[3,-1]}"
	for P in "${(@)_FOLD_READ[3,-1]}"; do
		[[ "${TREE_ENT[$P]% *}" == 100(644|755) && "${AT_NEW[$P]% *}" == 100(644|755) ]] && \
			[ "${TREE_ENT[$P]#* }" != "${AT_NEW[$P]#* }" ] && [ -f "$CO/$P" ] && [ ! -L "$CO/$P" ] && \
			! git -C "$CO" cat-file --filters "$3:$P" 2>/dev/null | cmp -s - "$CO/$P" && GO+=("$P")
	done
	(( ${#GO} )) || return 0
	if _SYNCS_CHECKOUT "$CO"; then
		_SYNC_CHECKOUT "$CO" "$2" "$3"
		return 0
	fi
	_TODO_ADD "the merge of $(_ALL_PATHS "${GO[@]}")" "%s" 33 \
		"Files you folded lack what the replay changed in them since, as $_SYNC_WHY – merge it in once it can run:"
	local -a CHANGED
	local -A NOT_BROUGHT
	for P in "${GO[@]}"; do
		_MERGE_CMD "${_FOLD_READ[2]}" "$3" "$P" "$P" "$P"
		_TODO_CMD "$REPLY"
		NOT_BROUGHT[$P]=${_FOLD_READ[2]}
	done
	# Each recorded on what the fold read, as that merge reads it – the landings guard and `--status`
	# naming it till then
	_UNBROUGHT_NOTE "$CO" "$2" "$3"
	return 0
}

# Fills the caller's `ITA` with the <path>s an index holds intent-to-add – read from the entries'
# own flags, as `git status` shows one whose file is gone as a tracked file deleted
_INDEX_ITA () {
	# Args: <checkout> <path>...
	local CO=$1 NAME REST FL
	local -x GIT_LITERAL_PATHSPECS=1
	local -a SPEC F
	local -i K
	shift
	ITA=()
	(( $# )) || return 0
	# Many paths read the whole index instead, past what one command line holds – only the
	# caller's paths are looked up in `ITA`
	_ARGV_FITS "$@" && SPEC=(-- "$@")
	# A name, then each entry's stat lines closing on its `flags: <hex>` line and the next name
	F=("${(@0)$(git -C "$CO" ls-files --debug -z "${SPEC[@]}" 2>/dev/null)}")
	NAME=${F[1]}
	for (( K = 2; K <= ${#F}; K++ )); do
		REST=${F[K]}
		[[ "$REST" == *"flags: "* ]] || break
		FL=${${REST#*flags: }%%$'\n'*}
		# `CE_INTENT_TO_ADD`
		[[ -n "$FL" && "$FL" != *[^0-9a-f]* ]] && (( 16#$FL & 0x20000000 )) && ITA[$NAME]=1
		NAME=${REST#*flags: *$'\n'}
	done
	return 0
}

# Tells whether an index entry gives way to what landed at its path, as `git commit -- <paths>`
# has it – an intent-to-add one where the rewrite adds the file, stating no content, and one a file
# this run took whole superseded, though not what a peer staged since the file was read – left as
# it was, either reads as a staged revert of what landed
_ENTRY_SUPERSEDED () {
	# Args: <path> <index entry> <new tip's entry> – reads the caller's `ITA` and `WHOLE_IDX`
	{ (( ${+ITA[$1]} )) && [ -n "$3" ]; } || { (( ${+WHOLE_IDX[$1]} )) && [ "$2" = "${WHOLE_IDX[$1]}" ]; }
}

# Re-syncs the index entries a ref move stranded in <checkout> – an entry still holding the
# pre-rewrite tip's blob reads as a staged revert of the rewrite, the foreign staging a peer's
# plain commit sweeps in – guarded per path on exactly that equality, so a peer's staging (or
# the caller's own) on a changed path stays put and is named instead
_RESYNC_STRANDED_ENTRIES () {
	# Args: <checkout> <old tip> <new tip> – fills the caller's `RESYNCED`, `LEFT_ALONE` and `LOCKED`
	local CO=$1 OLD=$2 NEW=$3 P IDXENT
	local -a PAIRS DIFF_PATHS
	local -A DIFF_O DIFF_N IDX_ENT
	RESYNCED=(); LEFT_ALONE=(); LOCKED=()
	_DIFF_ENTRIES "$OLD" "$NEW"
	_INDEX_ENTRIES "$CO" "" "${DIFF_PATHS[@]}"
	local -A ITA
	_INDEX_ITA "$CO" "${DIFF_PATHS[@]}"
	for P in "${DIFF_PATHS[@]}"; do
		IDXENT=${IDX_ENT[$P]}
		# A conflicted path is mid-merge – a reset would discard its stages
		if [ "$IDXENT" = conflict ]; then
			LEFT_ALONE+=("$P")
		elif [ "${DIFF_O[$P]}" = "$IDXENT" ]; then
			PAIRS+=("$P" "$IDXENT")
		# One staged as the new tip has it is in sync already – not an intent-to-add one, whose empty
		# blob an empty file landed matches while it stages nothing
		elif [ "$IDXENT" = "${DIFF_N[$P]}" ] && (( ! ${+ITA[$P]} )); then
			:
		elif _ENTRY_SUPERSEDED "$P" "$IDXENT" "${DIFF_N[$P]}"; then
			PAIRS+=("$P" "$IDXENT")
		else
			LEFT_ALONE+=("$P")
		fi
	done
	# A peer mid-`add` holds the index lock – its entries stay stranded, named as such rather
	# than as differing, since they do not
	_RESET_IF_STAGED_AS "$CO" "${PAIRS[@]}"
	RESYNCED=("${RESET_DONE[@]}"); LOCKED=("${RESET_LOCKED[@]}"); LEFT_ALONE+=("${RESET_KEPT[@]}")
}

# Hashes a worktree path as git would stage it – a symlink by the name it points at, which
# `git hash-object` reads through to the file instead
_WORKTREE_HASH () {
	# Args: <checkout> <path>
	if [ -L "$1/$2" ]; then
		printf '%s' "$(readlink "$1/$2")" | git hash-object --stdin
	else
		git -C "$1" hash-object -- "$2"
	fi
}

# Puts into `REPLY` the shallowest leading part of <path> that <checkout> holds as no directory – a
# symlink, wherever it points, or a file – failing where none is: git writes nothing through a link
# or under a file, and a restore replaces either with a directory
_LEADING_NON_DIR () {
	# Args: <checkout> <path>
	local D=${2:h}
	local -a UP
	REPLY=""
	while [ "$D" != . ] && [ "$D" != / ] && [ -n "$D" ]; do UP=("$D" "${UP[@]}"); D=${D:h}; done
	for D in "${UP[@]}"; do
		{ [ -L "$1/$D" ] || { [ -e "$1/$D" ] && [ ! -d "$1/$D" ]; }; } && { REPLY=$D; return 0; }
	done
	return 1
}

# Tells whether a worktree file's edits sit on the pre-rewrite content – merging the rewrite in
# would change it, so committing it whole takes the rewrite back there – where edits made on the
# new content, a change landed through the checkout first, merge to themselves
_EDITS_LACK_REWRITE () {
	# Args: <worktree file> <old blob> <new blob> – false where it cannot tell, a binary say
	local BASE=$(MKTEMP_FILE git-edit-base) THEIRS=$(MKTEMP_FILE git-edit-theirs) MERGED=$(MKTEMP_FILE git-edit-merged)
	_TEMP_FILES+=("$BASE" "$THEIRS" "$MERGED")
	local RC=255
	if git cat-file blob "$2" > "$BASE" 2>/dev/null && git cat-file blob "$3" > "$THEIRS" 2>/dev/null; then
		git merge-file -p -q "$1" "$BASE" "$THEIRS" > "$MERGED" 2>/dev/null
		RC=$?
	fi
	if [ $RC -eq 0 ]; then
		! cmp -s "$MERGED" "$1"
	elif [ $RC -le 127 ]; then
		# Edits beside the rewrite's own lines conflict too, made on the new content as much as on
		# the old – the file holds the rewrite where its changed lines take in all of the rewrite's
		[ -n "$(LC_ALL=C comm -23 <(_CHANGED_LINES "$BASE" "$THEIRS") <(_CHANGED_LINES "$BASE" "$1"))" ]
	else
		false
	fi
	RC=$?
	rm -f "$BASE" "$THEIRS" "$MERGED"
	return $RC
}

# Tells whether a worktree file's changed lines take in every line a move from <old blob> to <new
# blob> changed – edits made on the new content, beside its lines – false where it can't tell
_EDITS_HOLD_MOVE () {
	# Args: <worktree file> <old blob> <new blob>
	local BASE=$(MKTEMP_FILE git-edit-base) THEIRS=$(MKTEMP_FILE git-edit-theirs) RC=1
	_TEMP_FILES+=("$BASE" "$THEIRS")
	if git cat-file blob "$2" > "$BASE" 2>/dev/null && git cat-file blob "$3" > "$THEIRS" 2>/dev/null; then
		local MOVED=$(_CHANGED_LINES "$BASE" "$THEIRS")
		[ -n "$MOVED" ] && [ -z "$(LC_ALL=C comm -23 <(print -r -- "$MOVED") <(_CHANGED_LINES "$BASE" "$1"))" ] && RC=0
	fi
	rm -f "$BASE" "$THEIRS"
	return $RC
}

# Tells whether a run brings <checkout> along itself – the one it acted in, an agent's as a
# person's, the sync being built for a checkout other sessions edit – with no merge, rebase or
# cherry-pick halfway there, its index free and its hold taken – else putting why into `_SYNC_WHY`
_SYNCS_CHECKOUT () {
	# Args: <checkout>
	# Asked once a run – the reconcile paths ask in turn
	[[ "$_SYNC_VERDICT" == *:"$1" ]] && { [[ "$_SYNC_VERDICT" == yes:* ]]; return; }
	_SYNC_VERDICT="no:$1"
	# Read again where a signal cut it short, as this runs once the branch moved
	_LANDED_OUT eval 'cd "$_START_DIR" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null'
	local HERE=$REPLY
	if [ -z "$HERE" ] || [ "${HERE:A}" != "${1:A}" ]; then
		_SYNC_WHY="it is checked out at $1, not where this run started"
		return 1
	fi
	if _HALFWAY_THROUGH "$1"; then
		_SYNC_WHY="it is halfway through $REPLY – finish or abort that first"
		return 1
	fi
	# Another run's sync of it held past the wait – this one's, read old, would take that one's back
	if [ "$_SYNC_HELD" = - ]; then
		_SYNC_WHY="another run was still bringing it along past the wait"
		return 1
	fi
	# An index held past the wait takes none of the sync's writes – waited out as
	# `_WAIT_INDEX_UNLOCKED` does, its path asked once
	local LOCK=$(git -C "$1" rev-parse --path-format=absolute --git-path index.lock 2>/dev/null)
	local -i W=0
	while [ -n "$LOCK" ] && [ -e "$LOCK" ] && (( ++W <= 50 )); do sleep 0.1; done
	if [ -n "$LOCK" ] && [ -e "$LOCK" ]; then
		_SYNC_WHY="its index was locked by another run past the wait"
		return 1
	fi
	_SYNC_VERDICT="yes:$1"
}

# Prints the "<mode> <blob>" an index holds for <path> at stage 0,
# `conflict` where it holds stages, nothing where it holds none
_INDEX_ENTRY () {
	# Args: <checkout> <path>
	local -x GIT_LITERAL_PATHSPECS=1
	git -C "$1" ls-files -s -- "$2" 2>/dev/null | awk '{ if ($3 != 0) c = 1; else e = $1" "$2 } END { print (c ? "conflict" : e) }'
}

# Prints the "<mode> <blob>" <tree-ish> holds for <path>, nothing where it has none
_TREE_ENTRY () {
	# Args: <tree-ish> <path>
	local -x GIT_LITERAL_PATHSPECS=1
	git ls-tree --full-tree "$1" -- "$2" 2>/dev/null | awk 'NR == 1 { print $1" "$3 }'
}

# Answers whether <path> of <checkout> is a directory holding only files the caller's rewrite takes
# out – tracked before, gone after – so the file it puts there can take its place, as git's own
# merge brings it, where no empty directory under it holds that up
_DIR_ALL_GOING () {
	# Args: <checkout> <path> – reads the caller's `DIFF_O` and `DIFF_N`
	local F
	local -a E
	[ -d "$1/$2" ] && [ ! -L "$1/$2" ] || return 1
	E=("$1/$2"/**/*(DN/^F))
	(( ${#E} )) && return 1
	for F in "$1/$2"/**/*(DN^/); do
		F=${F#"$1/"}
		(( ${+DIFF_O[$F]} )) && [ -z "${DIFF_N[$F]}" ] || return 1
	done
	return 0
}

# Queues <path>'s entry as `_SYNC_QUEUE` does – a carry's <item> going on its <list> at once, its
# report marking what became of the entry, a sync's once the entry is written
_SYNC_NOTE_Q () {
	# Args: <path> <entry> [<list> <item>] – reads the caller's `HOW`
	_SYNC_QUEUE "$@"
	[ "$HOW" = carry ] && [ -n "$3" ] && set -A "$3" "${(@P)3}" "$4"
	return 0
}

# Brings <checkout> from <old> to <new> – the one implementation behind both the sync a run makes of
# the checkout it moved and `--carry`: a file still as before takes what landed, edits merge onto it
# where they merge cleanly, a conflict writing nothing, as they may be a peer's, a file standing
# where one lands is kept, and nothing goes through a symlink, outside a sparse checkout or over
# another's staging – each path named, a sync's lines worded for its move, a carry's for itself
# • Every file still as its base has it goes in one two-tree merge, its entry first set back to that
#   where a re-sync took it ahead, as a carry finds a checkout a landing left – one with edits, or
#   anything else of its own, path by path
# • Each file merges from its own base, as `_FILE_BASES` tells it – the tip it was last brought to
# • The index entries it changes are written in one step at the end, each only where it still holds
#   what was read and drops no staging in its way
_SYNC_CHECKOUT () {
	# Args: <checkout> <old tip> <new tip> [carry <tip>] – a sync reads `_MOVING_REF`, a drop's content
	#       and an undo's named apart – a carry puts the count it carried into `REPLY`, exiting 1
	#       where it leaves a path to merge by hand
	local CO=$1 OLD=$2 NEW=$3 HOW=${4:-sync} TIP=${5:-$3} P SRC O N I IP HE MODE WTM WH TMPF OURS BLOB ERR DST WHY NP NS L ITEM
	local HOOK_BASE FBE FBT FBN UNEDITED LINE Q HASHED UPTO OWN_HOOK CB BELOW _MERGE_FILE_IDS=-
	local -i RC K
	local -x GIT_LITERAL_PATHSPECS=1
	local -a CHANGED CLEAN CARRIED CONFLICTED MERGE_CMDS KEPT KEPT_EDITS GONE_EDITED LEFT DELETED FAILED STALE LOCKED IDX_LOCKED
	local -a OWN_LATER
	local -a DIFF_PATHS MODE_ONLY HOOKED PARTIAL BROUGHT RESYNCED BLOCKED REAPPLY ASK REBASE ORDER RF
	local -a Q_PATH Q_NEW Q_ON Q_OUT Q_BY
	local -A UNSTAGED STAGED STAGED_DIRS RENAMED_FROM RENAMED_TO IS_DIRTY DIFF_O DIFF_N IDX_ENT READ_ENT UNDER_LINK DIR_RENAMED
	local -A TIP_ENT WT_HASH SPARSE_OUT PAIRED FB_ENT FB_TIP FB_NAME TT_EXP TT_FROM ITA WRITTEN NOT_BROUGHT
	local -a STEP_FROM STEP_TO
	local -a DIR_PARTLY DIR_FROM DIR_TO DIR_TAKEN DIR_STAYS DIR_MOVED DIR_RESPELT
	# Its words – a carry's its own, a sync's its move's, commits only added on top rewriting nothing
	local NOUN=rewrite FORMER=pre-rewrite WHILE="it ran"
	if [ "$HOW" = carry ]; then
		WHILE=carrying
	elif _IS_ANCESTOR "$OLD" "$NEW"; then
		NOUN=landing FORMER=previous
	fi
	_DIFF_ENTRIES "$OLD" "$NEW"
	CHANGED=("${DIFF_PATHS[@]}")
	# The tip the checkout was last brought to – a sync's only where every landing it missed since is
	# on record, which it then brings along too: each path they changed and none since, other than
	# <new> in the checkout, from the mark's entry – and where a sync or carry made it, the end of the
	# walk for each file's base
	local BROUGHT_AT="" BROUGHT_END="" CO_REF
	local -a WIDENED ON_MARK
	local -A WIDE
	if CO_REF=$(git -C "$CO" symbolic-ref -q HEAD 2>/dev/null); then
		if [ "$HOW" = carry ]; then _BROUGHT_READ "$CO" "$CO_REF"; else _BROUGHT_UPTO "$CO" "$CO_REF" "$OLD"; fi
		BROUGHT_AT=$REPLY
		(( ${#reply} )) || BROUGHT_END=$REPLY
	fi
	if [ "$HOW" = sync ] && [ -n "$BROUGHT_AT" ] && [ "$BROUGHT_AT" != "$OLD" ]; then
		local -a MISSED
		for P in ${(0)"$(git diff-tree -r -z --no-renames --name-only "$BROUGHT_AT" "$OLD" 2>/dev/null)"}; do
			if (( ${+DIFF_O[$P]} || ${+DIFF_N[$P]} )); then ON_MARK+=("$P"); else MISSED+=("$P"); fi
		done
		# One the landing changes too, its entry still the mark's – a missed landing's sync held back by
		# a locked index, say – moves from there as a widened path does, its entry no one's staging
		if (( ${#ON_MARK} )); then
			local -A TREE_ENT
			_TREE_ENTRIES "$BROUGHT_AT" "${ON_MARK[@]}"
			_INDEX_ENTRIES "$CO" "" "${ON_MARK[@]}"
			ON_MARK=()
			for P in "${(@k)IDX_ENT}"; do
				[[ "${TREE_ENT[$P]% *}" == 100(644|755) ]] && [ "${IDX_ENT[$P]}" = "${TREE_ENT[$P]}" ] && \
					[ "${IDX_ENT[$P]}" != "${DIFF_O[$P]}" ] || continue
				DIFF_O[$P]=${TREE_ENT[$P]}
				ON_MARK+=("$P")
			done
			IDX_ENT=()
		fi
		if (( ${#MISSED} )); then
			local -A TREE_ENT AT_MARK
			for P in ${(0)"$(_GIT_PATH_CHUNKS -C "$CO" diff --ignore-submodules=dirty -z --name-only --no-renames "$NEW" -- "${MISSED[@]}" 2>/dev/null)"} \
			         ${(0)"$(_GIT_PATH_CHUNKS -C "$CO" diff --cached --ignore-submodules=dirty -z --name-only --no-renames "$NEW" -- "${MISSED[@]}" 2>/dev/null)"}; do
				WIDE[$P]=1
			done
			_TREE_ENTRIES "$BROUGHT_AT" "${(@k)WIDE}"
			AT_MARK=("${(@kv)TREE_ENT}")
			_TREE_ENTRIES "$NEW" "${(@k)WIDE}"
			for P in "${(@k)WIDE}"; do
				[[ "${AT_MARK[$P]% *}" != 040000 && "${TREE_ENT[$P]% *}" != 040000 && "${AT_MARK[$P]}" != "${TREE_ENT[$P]}" ]] || continue
				[ -z "${AT_MARK[$P]}" ] || DIFF_O[$P]=${AT_MARK[$P]}
				[ -z "${TREE_ENT[$P]}" ] || DIFF_N[$P]=${TREE_ENT[$P]}
				WIDENED+=("$P")
			done
			WIDE=()
			for P in "${WIDENED[@]}"; do WIDE[$P]=1; done
			CHANGED+=("${WIDENED[@]}")
		fi
	fi
	# A sync with no mark ending the walk records each other file a landing left stale, as the mark
	# it writes ends the walk for every file from then on
	local -A UNB_BY
	if (( ! ${#CHANGED} )) && [ "$HOW" != carry ]; then
		if [ -n "$CO_REF" ] && [ -z "$BROUGHT_END" ]; then
			_UNBROUGHT_UNSEEN "$CO" "$OLD" "$NEW"
			(( ${#NOT_BROUGHT} )) && _UNBROUGHT_NOTE "$CO" "$OLD" "$NEW"
		fi
		_BROUGHT_PUT "$CO" "$NEW"
		return 0
	fi
	# A carry's paths too that a landing on the way changed and a later one took back, none changed
	# from <old> to <new> – a file brought along in between holds the first, as its own base tells
	local -A EXTRA
	if [ "$HOW" = carry ] && P=$(git -C "$CO" symbolic-ref -q HEAD 2>/dev/null); then
		# None from a carry at the tip – one for the files its record names
		[ "$OLD" != "$NEW" ] && _LANDING_STEPS "$P" "$OLD" "$NEW"
		for (( K = 1; K <= ${#STEP_FROM}; K++ )); do
			[ "${STEP_FROM[K]}" = "$OLD" ] && (( K == 1 )) && break
			for P in ${(0)"$(git diff-tree -r -z --no-renames --name-only "${STEP_FROM[K]}" "${STEP_TO[K]}" 2>/dev/null)"}; do
				(( ${+DIFF_O[$P]} || ${+DIFF_N[$P]} )) || EXTRA[$P]=1
			done
			[ "${STEP_FROM[K]}" = "$OLD" ] && break
		done
		# And each a run left unbrought here on a landing at or below <old> – one past the walk's reach
		# that moved the mark on, say – its record's base telling what the file lacks
		local -A UNBROUGHT BELOW_OLD
		_UNBROUGHT_READ "$CO"
		for P in "${(@k)UNBROUGHT}"; do
			(( ${+DIFF_O[$P]} || ${+DIFF_N[$P]} )) && continue
			Q=${${UNBROUGHT[$P]}[(w)3]}
			if (( ! ${+BELOW_OLD[$Q]} )); then
				BELOW_OLD[$Q]=""
				_IS_ANCESTOR "$Q" "$OLD" && BELOW_OLD[$Q]=1
			fi
			[ -n "${BELOW_OLD[$Q]}" ] && EXTRA[$P]=1
		done
		if (( ${#EXTRA} )); then
			local -A TREE_ENT
			_TREE_ENTRIES "$NEW" "${(@k)EXTRA}"
			for P in "${(@k)EXTRA}"; do
				if [[ "${TREE_ENT[$P]% *}" == 100(644|755) ]]; then
					DIFF_O[$P]=${TREE_ENT[$P]} DIFF_N[$P]=${TREE_ENT[$P]}
					CHANGED+=("$P")
				else
					unset "EXTRA[$P]"
				fi
			done
		fi
	fi
	# The tip's entry of each path – the move's own where it is the tip still, as for a sync
	if [ "$TIP" = "$NEW" ]; then
		TIP_ENT=("${(@kv)DIFF_N}")
	else
		local -A TREE_ENT
		_TREE_ENTRIES "$TIP" "${CHANGED[@]}"
		TIP_ENT=("${(@kv)TREE_ENT}")
	fi
	# Where the checkout differs from <old>: its files from its index, its index from <old>
	for P in ${(0)"$(git -C "$CO" diff --ignore-submodules=dirty -z --name-only --no-renames 2>/dev/null)"}; do UNSTAGED[$P]=1; done
	for P in ${(0)"$(git -C "$CO" diff --cached --ignore-submodules=dirty -z --name-only --no-renames "$OLD" 2>/dev/null)"}; do STAGED[$P]=1; done
	# A path a missed landing changed is staged as it differs from the mark
	for P in "${ON_MARK[@]}"; do unset "STAGED[$P]"; done
	if (( ${#WIDENED} )); then
		for P in "${WIDENED[@]}"; do unset "STAGED[$P]"; done
		for P in ${(0)"$(_GIT_PATH_CHUNKS -C "$CO" diff --cached --ignore-submodules=dirty -z --name-only --no-renames "$BROUGHT_AT" -- "${WIDENED[@]}" 2>/dev/null)"}; do
			STAGED[$P]=1
		done
	fi
	# Asked only where a path went and another came, as a rename needs both – NUL-separated, status,
	# source and destination each, as a quote, backslash or tab in a name comes back C-quoted otherwise
	(( ${#DIFF_O} < ${#CHANGED} && ${#DIFF_N} < ${#CHANGED} )) && \
		RF=(${(0)"$(git diff --ignore-submodules=dirty -z -M --name-status --diff-filter=R "$OLD" "$NEW" 2>/dev/null)"})
	for (( K = 1; K + 2 <= ${#RF}; K += 3 )); do
		RENAMED_FROM[${RF[K + 2]}]=${RF[K + 1]}
		RENAMED_TO[${RF[K + 1]}]=${RF[K + 2]}
	done
	# Read before an entry moves – a sync's index telling a rename the run brings from one the
	# checkout made itself – and the untracked files to take along before a file moves, a `.gitignore`
	# of the renamed directory's own still telling the ignored ones – a carry's directory renamed by
	# case alone respelt first, so its files read as carried where they need nothing else
	if (( ${#RENAMED_TO} )); then
		if [ "$HOW" = carry ]; then
			_DIR_RENAMES "$OLD" "$NEW" "$TIP"
		else
			_DIR_RENAMES "$OLD" "$NEW"
			_DIR_INDEXED "$CO"
		fi
		(( ${#DIR_RENAMED} + ${#DIR_PARTLY} )) && _DIR_UNTRACKED "$CO" "$OLD" "$NEW"
		[ "$HOW" = carry ] && _DIR_RESPELL "$CO"
	fi
	# Each directory a staged or edited entry lies in
	for P in "${(@k)STAGED}" "${(@k)UNSTAGED}"; do
		while [[ "$P" == */* ]]; do P=${P%/*}; STAGED_DIRS[$P]=1; done
	done
	for P in "${CHANGED[@]}"; do
		# One under a symlink or a file of the caller's, not one <old> had there, takes no file there
		if [[ "$P" == */* ]] && _LEADING_NON_DIR "$CO" "$P" && [ -z "${DIFF_O[$REPLY]}" ]; then
			UNDER_LINK[$P]=$REPLY
			IS_DIRTY[$P]=1
		elif (( ${+UNSTAGED[$P]} || ${+STAGED[$P]} )); then
			IS_DIRTY[$P]=1
		# One the rewrite adds needs its place free – an untracked or ignored file there,
		# or a directory, is the caller's, bar one holding only files the rewrite takes out
		# alongside, which wait with it where edited
		elif [ -z "${DIFF_O[$P]}" ] && { [ -e "$CO/$P" ] || [ -L "$CO/$P" ]; } && ! _DIR_ALL_GOING "$CO" "$P"; then
			IS_DIRTY[$P]=1
		# As does one with staging in its way – under it, or at a directory it lies in – which the
		# two-tree merge below would drop
		elif (( ${+STAGED_DIRS[$P]} )); then
			IS_DIRTY[$P]=1
		else
			SRC=$P
			while [[ "$SRC" == */* ]]; do
				SRC=${SRC%/*}
				(( ${+STAGED[$SRC]} || ${+UNSTAGED[$SRC]} )) && { IS_DIRTY[$P]=1; break; }
			done
		fi
	done
	# A path the clean set adds where a kept one needs its directory, or the reverse, waits with it
	for P in "${CHANGED[@]}"; do
		(( ${+IS_DIRTY[$P]} )) && continue
		for SRC in "${(@k)IS_DIRTY}"; do
			if [[ "$SRC" == "$P"/* || "$P" == "$SRC"/* ]]; then
				IS_DIRTY[$P]=1
				break
			fi
		done
	done
	# A renamed file's edits go along to its new path, which they hold up the same way, and a new path
	# held up keeps its source where it is
	for P in "${(@k)RENAMED_TO}"; do
		(( ${+IS_DIRTY[$P]} )) && IS_DIRTY[${RENAMED_TO[$P]}]=1
	done
	for P in "${(@k)RENAMED_FROM}"; do
		(( ${+IS_DIRTY[$P]} )) && IS_DIRTY[${RENAMED_FROM[$P]}]=1
	done

	# A peer's `git add` holding the index for a moment is waited out, as every write below needs it
	_WAIT_INDEX_UNLOCKED "$CO"
	# Flags a fresh entry would drop, set again once the sync is done
	local -a FLAG_AU FLAG_SW
	_INDEX_FLAGS "$CO" "" "${CHANGED[@]}"
	# What the checkout holds at each path that differs from <old>, read once – its index entry, an
	# intent-to-add one, its file's hash – but a rename's source, read at its new path's turn, as the
	# moves before it can change what stands at its name
	local -a DIRTY RENAME_SRCS
	DIRTY=("${(@k)IS_DIRTY}")
	if (( ${#DIRTY} )) || [ "$HOW" = carry ]; then
		_INDEX_ENTRIES "$CO" "" "${CHANGED[@]}"
		_INDEX_ITA "$CO" "${CHANGED[@]}"
		RENAME_SRCS=("${(@k)RENAMED_TO}")
		_WORKTREE_HASHES "$CO" "${(@)DIRTY:|RENAME_SRCS}"
		# Each file's own base, where it differs from <old>
		_FILE_BASES "$CO" "$OLD" "$NEW" "${(@)DIRTY:|RENAME_SRCS}"
	fi
	# A path a missed landing changed sits on the mark, but where its file tells another base
	for P in "${WIDENED[@]}" "${ON_MARK[@]}"; do
		(( ${+FB_TIP[$P]} )) || [ -z "${DIFF_O[$P]}" ] || FB_TIP[$P]=$BROUGHT_AT FB_NAME[$P]=$P FB_ENT[$P]=${DIFF_O[$P]}
	done
	# An undo's sync finds a file the sync of the run it takes back left unbrought still on that
	# record's base – the undo's own target, as a rule – which the record, its landing gone from the
	# journal with the run, no longer tells: it merges from there, so no conflict that isn't one
	if [ "$HOW" = sync ] && [ "${_MOVING_REF[4]%% *}" = undo ] && [ -n "$CO_REF" ]; then
		local UF UTEXT ULINE
		local -a UR
		local -A FB_BLOB
		UF=$(git -C "$CO" rev-parse --path-format=absolute --git-path git-edit-unbrought 2>/dev/null)
		if [ -n "$UF" ] && [ -s "$UF" ] && { UTEXT=$(<"$UF") } 2>/dev/null; then
			for ULINE in "${(@f)UTEXT}"; do
				UR=(${=${ULINE%%$'\t'*}})
				P=${ULINE#*$'\t'}
				[ "${UR[2]}" = "$CO_REF" ] && [ "${UR[3]}" = "$NEW" ] && [ "${UR[4]}" = "$OLD" ] && (( ${+IS_DIRTY[$P]} )) || continue
				_BLOB_AT "${UR[5]}" "$P"
				[ -n "$REPLY" ] && _FILE_BASE_SET "$P" "${UR[5]}" "$P" "$REPLY"
			done
		fi
	fi
	# A rename's source a run left unbrought merges from its record's base too, while its file still
	# lacks the landing that left it – read now, but where another rename lands on its name
	if (( ${#RENAME_SRCS} )); then
		local -A UNBROUGHT FB_BLOB
		local -a REC
		local _MERGE_FILE_IDS=- RB RA RW
		_UNBROUGHT_READ "$CO"
		for P in "${RENAME_SRCS[@]}"; do
			(( ${+UNBROUGHT[$P]} && ! ${+RENAMED_FROM[$P]} && ! ${+FB_TIP[$P]} )) && [ -f "$CO/$P" ] && [ ! -L "$CO/$P" ] || continue
			REC=(${=UNBROUGHT[$P]})
			_BLOB_AT "${REC[1]}" "$P"; RB=$REPLY
			_BLOB_AT "${REC[3]}" "$P"; RA=$REPLY
			[ -n "$RB" ] && [ -n "$RA" ] && [ "$RA" != "$RB" ] && RW=$(git -C "$CO" hash-object -- "$P" 2>/dev/null) && [ -n "$RW" ] || continue
			_LANDING_LACKED "$RW" "$RB" "$RA"
			(( $? == 1 )) || _FILE_BASE_SET "$P" "${REC[1]}" "$P" "$RB"
		done
	fi
	# A path taken back on the way stays only where its file has a base of its own
	if (( ${#EXTRA} )); then
		local -a DROP
		for P in "${(@k)EXTRA}"; do
			(( ${+FB_ENT[$P]} )) && continue
			DROP+=("$P")
			unset "IS_DIRTY[$P]"
		done
		CHANGED=("${(@)CHANGED:|DROP}")
	fi
	# Outside a sparse checkout git keeps no file – for a carry, a skip-worktree entry's path, or one
	# the rewrite adds where the index holds none yet, as the checkout's patterns tell, which a git
	# before 2.42 can't, each such path taken as outside it – a flagged path only maybe outside where
	# this git can't ask, as is one a git before 2.35 lands, flagged unasked – each its own step
	local SPARSE_ASKED=1 SPARSE_WHY="outside your sparse checkout" SPARSE_MAYBE=""
	if [ "$HOW" = carry ]; then
		for P in "${FLAG_SW[@]}"; do SPARSE_OUT[$P]=1; done
		for P in "${CHANGED[@]}"; do [ -n "${DIFF_N[$P]}" ] && [ -z "${IDX_ENT[$P]}" ] && ASK+=("$P"); done
		_SPARSE_OUT "$CO" "${ASK[@]}" || SPARSE_ASKED=""
		ASK=("${reply[@]}")
		for P in "${ASK[@]}"; do SPARSE_OUT[$P]=1; done
		(( ${#SPARSE_OUT} )) && ! _SPARSE_OUT "$CO" "${(@k)SPARSE_OUT}" && \
			SPARSE_MAYBE=1 SPARSE_WHY="maybe outside your sparse checkout, which this git can't ask (2.42 can)"
		for P in "${(@k)SPARSE_OUT}"; do
			(( ${+DIFF_O[$P]} || ${+DIFF_N[$P]} )) || continue
			IS_DIRTY[$P]=1
			# A rename's other path with it
			[ -n "${RENAMED_FROM[$P]}" ] && IS_DIRTY[${RENAMED_FROM[$P]}]=1
			[ -n "${RENAMED_TO[$P]}" ] && IS_DIRTY[${RENAMED_TO[$P]}]=1
		done
	fi
	# A dirty path whose file is still as its base has it goes in the two-tree merge all the same, its
	# entry set back to that first where a re-sync took it ahead – anything else about it, a mode of
	# the checkout's own, a rename, staging, a directory or a link, waits for a step of its own, as do
	# a path still dirty's directories and the paths under it
	local FILEMODE=$(git -C "$CO" config --bool core.fileMode 2>/dev/null)
	for P in "${CHANGED[@]}"; do
		(( ${+IS_DIRTY[$P]} )) || continue
		(( ${+UNDER_LINK[$P]} || ${+RENAMED_FROM[$P]} || ${+RENAMED_TO[$P]} || ${+ITA[$P]} || ${+SPARSE_OUT[$P]} || ${+STAGED_DIRS[$P]} )) && continue
		O=${DIFF_O[$P]} N=${DIFF_N[$P]} I=${IDX_ENT[$P]} FBE=${FB_ENT[$P]-${DIFF_O[$P]}}
		[[ "${FBE% *}" == 100(644|755) ]] && (( ${+WT_HASH[$P]} )) && [ "${WT_HASH[$P]}" = "${FBE#* }" ] || continue
		if [ -n "$N" ]; then
			# A change of content – one of mode alone may be the checkout's own already
			[[ "${N% *}" == 100(644|755) ]] && [ "${TIP_ENT[$P]}" = "$N" ] && [ "${N#* }" != "${FBE#* }" ] || continue
			[ "$I" = "$O" ] || [ "$I" = "$N" ] || [ "$I" = "$FBE" ] || continue
			# The mode as git stages it the one before, a chmod of the checkout's its own
			_WORKTREE_MODE "$CO" "$P" "${O% *}" "$FILEMODE" "${I% *}"
			[ "$REPLY" = "${FBE% *}" ] || continue
		else
