#!/bin/zsh

# `git edit` – Edit, reword, drop, squash, reorder, split, or fold past commits
#
# Usage: `git edit -h` prints the full flag reference, `man git-edit` the details.
#
# A convenience wrapper around `git rebase --interactive` and plumbing,
# hardened for AI coding agents and parallel sessions: every ref move is an
# atomic compare-and-swap, the plumbing and isolated modes never touch the
# main working tree, and staged changes are not consumed until the final
# update lands – a failure or `--abort` leaves everything as it was.
# Conflicts pause with a temp worktree to resolve in (`git edit --continue`
# / `--abort`), and every run ends in a machine-readable trailer.
#
# If you want to alter the commit message as well, add the
# `-m` switch. You can also delete (drop) one or more commits
# (or ranges) by using `-d`, or merge (fixup/squash) one or
# more commits into another one (defaulting to the oldest
# commit in the selection) using `-s`/`--squash`. Whenever
# multiple commit hashes are supplied, `-s`/`--squash` is
# assumed as the default mode and the oldest commit becomes
# the `<target>`.
#
# Use it as "git edit" by adding its parent folder to your `PATH`,
# e.g. by adding this line to ~/.zshrc:
# export PATH=$PATH:/your/path/to/git-custom-commands
#
# WARNING: Note that this will change the SHA1 of the commit
# as well as of all later commits – it rewrites the history
# from that point forward. This is unproblematic as long as
# you either didn't push these commits yet, or are a single
# developer. If not, it can cause other maintainers, branches,
# or forks quite the hassle. So please know what you're doing
# when using `git push --force`!
#
# Released by Thomas Bachem <mail@thomasbachem.com>
# under the MIT License


# zsh sources the caller's `.zshenv` for every invocation, scripts included – a `setopt
# sh_word_split` or `ksh_arrays` there would run a different script than the selftest proves.
# Every option that changes parsing goes back to zsh's default here, first, since `pipefail`
# below is one of them. Its aliases go too – zsh expands them in scripts, and a colored `grep`
# put an escape into a SHA. Functions stay: a `git ()` wrapper there is deliberate, and passes
# through
emulate zsh
unalias -a

# Make a pipeline fail if any element fails
# (required for `$?` to work with `tee` below)
set -o pipefail

# Names this script assigns are its own – one a caller exported would seed it before the script set
# it, a `TARGET` joining a squash or an `OPT_DROP` posing as `-d` – so each starts unset, a list
# scenario 118 holds to the script, kept as exported for what runs on the caller's behalf
_UNSET_OWN () {
	local N
	local -a KEPT
	for N in "$@"; do
		[ -n "${(P)N+set}" ] && KEPT+=("$N=${(P)N}")
		unset $N
	done
	# Declared once the list is through, which names it too
	typeset -ga _CALLER_ENV
	_CALLER_ENV=("${KEPT[@]}")
}
_UNSET_OWN ACTION AMEND_INTO_TARGET AMEND_NEW_HEAD AMEND_OLD_SHA AMEND_PATHSPECS AMEND_REF \
	AMEND_SOURCE AMEND_TREE AMEND_TREE_GIVEN ARG_SCAN C COMMANDLINE COMMIT COMMITS COMMITS_DESIRED \
	COMMITS_RESOLVED COMMITS_TOPO D DIFF_N DIFF_O DIFF_PATHS DIR_HAS_EQUALS EDIT_TARGET EXEC_BASE \
	EXEC_CHANGED EXEC_DRY_BASE EXEC_DRY_BUILT EXEC_LABEL EXEC_NEW_HEAD EXEC_PEER_MOVE EXEC_REF EXTRA \
	IDX_ENT IS_REF LEFT_ALONE LOCKED MARKED MOVE_ANCHOR MOVE_ARGS MOVE_EMPTY MOVE_END MOVE_FIRST \
	MOVE_FROM MOVE_FROM_RESOLVED MOVE_KIND MOVE_LAST MOVE_PART MOVE_RUN MOVE_SET MOVE_SORTED \
	MOVE_SPAN MOVE_SPAN_NEW MOVE_SPAN_OLD MOVE_TO ONTO_NEW_HEAD ONTO_REF ONTO_UPSTREAM \
	OPEN_EDITOR_CMD OPEN_EDITOR_NAME OPT_ABORT OPT_AFTER OPT_ALLOW_MODE_CHANGE OPT_ALLOW_NEW_PATH \
	OPT_ALLOW_OTHER_ACTOR OPT_ALLOW_PUSHED OPT_AMEND_INTO OPT_BASE OPT_BEFORE OPT_CARRY OPT_COMMIT \
	OPT_CONTINUE OPT_DIR OPT_DROP OPT_DRY_RUN OPT_EDIT OPT_EXEC OPT_HELP OPT_JOBS OPT_MESSAGE \
	OPT_MOVE OPT_NO_VERIFY OPT_NO_VERIFY_SPAN OPT_ONTO OPT_REORDER OPT_RESQUASH OPT_REWORD \
	OPT_SELFTEST OPT_SKIP OPT_SNAPSHOT OPT_SPLIT OPT_SQUASH OPT_STATUS OPT_TEXT OPT_TREE OPT_UNDO \
	OPT_VERIFY OPT_VERIFY_SPAN OPT_VERSION OPT_WHOLE OPT_YES ORIG_BRANCH ORIG_HEAD PARSE_ERR \
	PARSE_MSG PREV_NEW PREV_OLD RAW_TEXT_VALUE REBASE_OUT REORDER_NEW_HEAD REORDER_REF RESET_DONE \
	RESET_KEPT RESET_LOCKED RESOLVE_SCAN_MAX RESUME_ABSORBS RESUME_GD RESUME_HEAD RESUME_STRAY \
	RESUME_WT_GD RESYNCED S SCRIPT_INITIAL_HEAD SELFTEST_DIR SELFTEST_JOBS SELFTEST_SCOPE SHA \
	SPLIT_NEW_HEAD SPLIT_REF SPLIT_TARGET SQUASH_HAS_EQUALS STATE_ACTION STATE_ACTOR \
	STATE_ALLOW_MODE_CHANGE STATE_AMENDED STATE_BRANCH STATE_CAPTURE STATE_DEPTH STATE_FILES \
	STATE_FIXUP STATE_FOLD STATE_FORK STATE_HEAD_WITH_FIXUP STATE_MAINDIR STATE_MESSAGE \
	STATE_MODE_STRAY STATE_NO_VERIFY STATE_OPERATION STATE_ORIG_HEAD STATE_PATHSPECS STATE_REBASEBASE \
	STATE_REPLAY_TIP STATE_RESOLVED STATE_RRPRE STATE_RRPRE_SET STATE_SPAN STATE_SQUASH_TARGET \
	STATE_STAGEDTREE STATE_STOP_HEAD STATE_TARGET STATE_TARGETS STATE_TODO_LEFT STATE_TREE \
	STATE_UPSTREAM STATE_VERIFY_CMD STATE_VERIFY_FAILED STATE_VERIFY_RESULT STATE_VERIFY_SPAN \
	STATE_WORKTREE STATE_WT_OURS STEP T TARGET TEXT_APART TEXT_VALUE TREE_BASE TREE_SHA UNTOLD \
	VERIFY_APART VERIFY_VALUE WHOLE_HEAD WHOLE_IDX WHOLE_PATHS WHOLE_TREE WORKTREE_DIR WT_DEFAULT \
	WT_OURS _ACTOR _ACTOR_MAPPED _AT_PROMPT _BANNER_REPO _CALLER_ENV _CALLER_GCP _CALLER_GCP_SET \
	_CAPTURE_DIR _CAPTURE_EXEC _CAPTURE_EXEC_ARGS _CAPTURE_PINS _CAPTURE_PIN_ARGS _CAPTURE_REWRITES \
	_CLEANUP_HOOK _COLOR _CONFIG_ADOPTED _DEFERRED_SIGNAL _DIM _EXPECT_PAUSE _HOOK_RUN_PROBED \
	_LANDED_MOVE _LANDING _LAST_ERROR _LITB _MODE_STRAY_AT _OFF _ONTO_FORK _ONTO_FORK_GUESSED _PAD \
	_REAL_EDITOR _REBUILT_VIA_REPLAY _RED _REFLOG_TAG _REPLAY_FLAGS _REPLAY_PROBED _RERERE_DIR \
	_RERERE_OPTOUT _RERERE_PRE _RERERE_SCOPE_OWNED _RERERE_STATE_FILE _RESOLVED_SHA _REWORDED_TARGET \
	_REWORDED_TIP _REWRITES_GIT_DELIVERED _REWRITE_PAIRS _SELF _SNAPSHOT_ERA _SNAPSHOT_RESOLVED_TREES \
	_SNAPSHOT_STAGES _SNAPSHOT_TIP _SNAPSHOT_TREE _START_DIR _STATE_OWNED _STATE_PATH _STATUS_EMITTED \
	_SYNC_VERDICT _TEMP_FILES _TEMP_WORKTREES _V _VERIFY_BYPASSED _VERIFY_FAILED _VERIFY_LITTER \
	_VERIFY_NO_RESUME _WHOLE_WHAT

# A switch set to 0, false, no or off is off, as most tools read one
for _V in GIT_EDIT_NO_AUTO_OPEN GIT_EDIT_NO_RESOLVE GIT_EDIT_NO_REPLAY GIT_EDIT_PROGRESS; do
	[[ "${(P)_V:l}" == (0|false|no|off) ]] && unset $_V
done
unset _V

# Released version – bumped together with the `v<version>` tag it ships under
GIT_EDIT_VERSION="1.7.0"

# Suspend background maintenance for this process and every git it spawns – from git 2.54
# `rerere gc` runs detached per commit, and its `MERGE_RR.lock` kills a rebase reaching its
# next conflict, wedging every later continue on "you have staged changes" – and keep what the
# script parses as it reads it, a non-ASCII path as itself (its quoted form names no file), no
# signature lines in a `git log`, a full `pick <7 hex>` in todo lines, paths from the top, and
# messages and names in the encoding a rebuilt commit is written in, the repo's commit encoding
# Appended to what `git -c` passes, which outranks every other source – a caller's own `-c` and
# `GIT_CONFIG_COUNT` included, so a pin there would lose to both
# Its own rebases add `--no-autosquash` and an empty `rebase.instructionFormat` instead, as a
# caller's autosquash folds another's `fixup!` into the span and a pin reaches `--exec` commands
# The caller's own value is kept for the run a terminal pause resumes in
_CALLER_GCP=$GIT_CONFIG_PARAMETERS _CALLER_GCP_SET=${GIT_CONFIG_PARAMETERS+1}
_V=$(git config --get i18n.commitEncoding 2>/dev/null)
for _K _V in maintenance.auto false gc.auto 0 core.quotePath false log.showSignature false \
		rebase.abbreviateCommands false core.abbrev 7 diff.relative false i18n.logOutputEncoding "${_V:-UTF-8}"; do
	GIT_CONFIG_PARAMETERS+="${GIT_CONFIG_PARAMETERS:+ }'$_K=$_V'"
done
export GIT_CONFIG_PARAMETERS
unset _K _V
# Pathspec semantics are git-edit's own – a caller's glob setting refuses the `:(literal)` names
# it passes, a literal one reads them as file names – and so are its diffs and greps, which
# `GIT_DIFF_OPTS` widens past `-U0` and `GREP_OPTIONS` colors on BSD – all kept for what runs on
# the caller's behalf
for _V in GIT_GLOB_PATHSPECS GIT_NOGLOB_PATHSPECS GIT_ICASE_PATHSPECS GIT_LITERAL_PATHSPECS GIT_DIFF_OPTS GREP_OPTIONS; do
	[ -n "${(P)_V+set}" ] && _CALLER_ENV+=("$_V=${(P)_V}")
done
unset _V GIT_GLOB_PATHSPECS GIT_NOGLOB_PATHSPECS GIT_ICASE_PATHSPECS GIT_LITERAL_PATHSPECS GIT_DIFF_OPTS GREP_OPTIONS

# Exports the caller's own settings again, in the subshell of a command run on their behalf – an
# `--exec` command or a verify check – and drops `pipefail`, which a check's `| head` would trip
_CALLER_ENV_BACK () {
	set +o pipefail
	[ ${#_CALLER_ENV} -eq 0 ] || export "${_CALLER_ENV[@]}"
}

# As `_CALLER_ENV_BACK`, git-edit's config pins out too – for an editor, which an app started cold
# keeps for every git it later runs
_CALLER_ENV_FULL () {
	unset GIT_CONFIG_PARAMETERS
	[ -n "$_CALLER_GCP_SET" ] && export GIT_CONFIG_PARAMETERS=$_CALLER_GCP
	_CALLER_ENV_BACK
}

# Prints `_CALLER_ENV_FULL` as `sh` lines, for an editor git starts in a stand-in
_CALLER_ENV_SH () {
	local KV
	print -r -- "unset GIT_CONFIG_PARAMETERS"
	[ -n "$_CALLER_GCP_SET" ] && print -r -- "GIT_CONFIG_PARAMETERS=${(qq)_CALLER_GCP}; export GIT_CONFIG_PARAMETERS"
	for KV in "${_CALLER_ENV[@]}"; do print -r -- "${KV%%=*}=${(qq)${KV#*=}}; export ${KV%%=*}"; done
}

# The script itself, for the run a terminal pause resumes in – resolved now, as `$0` names the
# function inside one – and the pause such a resume is for, which reaches nothing it runs
_SELF=${0:A}
_EXPECT_PAUSE=$GIT_EDIT_EXPECT_PAUSE
unset GIT_EDIT_EXPECT_PAUSE

# Cap on the commits a stale SHA's resolution computes a patch id for – the author date
# filter ahead of it normally leaves a handful, so this only bites on imported or scripted
# history sharing one second, where a match stops being unique and degrades to a suggestion
RESOLVE_SCAN_MAX=100

# Blank-line padding reads well in a terminal, but a caller piping through `| tail -N` – how
# most agent runs consume this – loses a line of summary to each, so pad only for a terminal
_PAD=""
[ -t 1 ] && _PAD=$'\n'

# Same reasoning for color: escapes read as emphasis in a terminal but as noise in a
# captured run, where they also split literal text a caller greps for – honors `NO_COLOR`
# and `TERM=dumb` alongside the pipe check
_COLOR=true
if [ ! -t 1 ] || [ -n "$NO_COLOR" ] || [ "$TERM" = "dumb" ]; then
	_COLOR=false
fi

# Gutter colors for the excerpt streams (`git show`/`git log` output piped
# through `sed`, which can't route through `ECHO_E`) – empty when color is off,
# so one `sed` script serves both cases
_DIM=$'\e[0;90m'
_RED=$'\e[0;31m'
_OFF=$'\e[0m'
if [ "$_COLOR" != "true" ]; then
	_DIM=""
	_RED=""
	_OFF=""
fi

# Puts <text> into `REPLY` with each raw control byte in caret notation, tabs and newlines kept – a
# subject's or path's, never a template's, so a crafted one can't clear the screen or set a title
_CARET () {
	# Args: <text> [<backslash>] – what `^\` takes for its backslash, `ECHO_E` passing its data mark
	# so the caret starts no escape there
	# Bytes, whatever the locale – a C1 control is a 2-byte UTF-8 pair there
	local LC_ALL=C
	REPLY=$1
	[[ "$REPLY" == *[$'\001'-$'\010'$'\013'-$'\037'$'\177']* || "$REPLY" == *$'\302'* ]] || return 0
	# A substitution per byte present, as a pass per character slows to seconds on a long line
	local -i c
	local K
	for (( c = 1; c <= 31; c++ )); do
		(( c == 9 || c == 10 )) && continue
		[[ "$REPLY" == *${(#)c}* ]] || continue
		K=${(#)$(( c + 64 ))}
		REPLY=${REPLY//${(#)c}/^${K/\\/${2:-\\}}}
	done
	REPLY=${REPLY//$'\177'/^?}
	# C1 controls, U+0080–U+009F, which a terminal may run as much – as `cat -v` shows their bytes
	# Gated on the lead byte alone – a byte range past ASCII matches nothing in Linux's zsh
	[[ "$REPLY" == *$'\302'* ]] || return 0
	for (( c = 128; c <= 159; c++ )); do
		[[ "$REPLY" == *$'\302'${(#)c}* ]] || continue
		K=${(#)$(( c - 64 ))}
		REPLY=${REPLY//$'\302'${(#)c}/M-BM-^${K/\\/${2:-\\}}}
	done
}

# Prints the closing status line verbatim and on one line, whatever a name or message in it holds
_EMIT_TRAILER () {
	# Args: <line>
	# Rerere's notes first, so the trailer stays last – only where no pause keeps the scope open
	if [ -n "$_RERERE_SCOPE_OWNED" ] && [ ! -f "$_RERERE_STATE_FILE" ]; then
		[[ "$1" == "git-edit: ok"* ]]
		_RERERE_SCOPE_END $?
		_RERERE_SCOPE_OWNED=""
	fi
	_CARET "${1//$'\n'/ }"
	print -r -- "$REPLY"
}

# The byte a data backslash is held as on its way through `ECHO_E` – a NUL, which no name, subject
# or template holds, in a name since `$'…'` quoting does not reach inside double quotes
_LITB=$'\0'

# Prints <text> marked as data for `ECHO_E` – its backslashes held as `_LITB`, so a `\e[0m` in a
# name prints as itself and never hides part of a printed command
_LIT () {
	# Args: <text>
	print -r -- "${1//\\/$_LITB}"
}

# Prints the unmerged paths in <worktree> one a line, read NUL-separated – the line form C-quotes a
# name with a quote or backslash, which then names no file
_UNMERGED_IN () {
	# Args: <worktree>
	local -a U
	U=(${(0)"$(git -C "$1" diff -z --name-only --diff-filter=U 2>/dev/null)"})
	(( ${#U} )) && print -rl -- "${U[@]}"
	return 0
}

# Passes stdin on with each raw control byte in caret notation, as `_CARET` takes a string – the
# `sed` after it under `LC_ALL=C`, as BSD sed in a UTF-8 locale dies on a byte no UTF-8 holds
_CARET_LINES () {
	# Args: [--crlf] – a command's output, whose CRLF line endings are no control the text carries,
	# nor the CR a progress line redraws itself with, of which the last state shows
	local L
	while IFS= read -r L || [ -n "$L" ]; do
		[ "$1" = --crlf ] && { L=${L%$'\r'}; L=${L##*$'\r'}; }
		_CARET "$L"
		print -r -- "$REPLY"
	done
}

# Emits one colorized line, its escapes stripped in-shell when color is off
ECHO_E () {
	setopt local_options extended_glob
	# Renders only the colors the templates use – `\e[0m`, `\e[22m`, a `0;` or `1;` 3x or 9x one – so
	# a `\e[2J`, a title-setting sequence, a conceal or a `\n` that a ref name, path or subject
	# carried stays literal – git-edit's own newlines are real ones in the template
	_CARET "$*" "$_LITB"
	local raw=$REPLY out="" code
	while [[ "$raw" == *'\e['* ]]; do
		out+="${raw%%'\e['*}"
		raw="${raw#*'\e['}"
		# `code` is what precedes the first `m`, a color only where the templates use it – any other
		# sequence stays the literal `\e[` and is reprocessed as text rather than run
		code="${raw%%m*}"
		if [[ "$raw" == *m* && "$code" == (0|22|[01]';'[39][0-7]) ]]; then
			out+=$'\e'"[${code}m"
			raw="${raw#${code}m}"
		else
			out+='\e['
		fi
	done
	out+="$raw"
	# Data's backslashes back, past the rendering `_LIT` kept them out of
	out=${out//$_LITB/\\}
	if [ "$_COLOR" = "true" ]; then
		print -r -- "$out"
	else
		print -r -- "${out//$'\e'\[[0-9;]#m/}"
	fi
}

# Name the repo every run acts on – it is the cwd's, never an argument, so a caller working
# across repos has no other signal that a rewrite is aimed where they meant
_BANNER_REPO=$(git rev-parse --show-toplevel 2>/dev/null)
ECHO_E "\e[1;94mgit edit – Edit, reword, drop, squash, reorder, split, or fold past commits\e[0m${_BANNER_REPO:+\e[0;90m  ${_BANNER_REPO//\\/$_LITB}\e[0m}"

# Global cleanup hook – a shell command any sub-operation can set, run once on script exit
# before the error trailer, by `GIT_EXEC` for temp worktrees and by auto-isolation for its own
_CLEANUP_HOOK=""

# Set by the modes whose verification has no pause behind it – `--exec` and a split – so the
# gate prints no hint pointing at a worktree its exit removes, or at a resume there is none of
_VERIFY_NO_RESUME=false

# The gate command a `--no-verify` run bypassed, printed once above the trailer. A repo with no
# `edit.verifyCmd` prints nothing either, so without this the two read alike from outside: the
# run that had a check and declined it looks like the one that never had one
_VERIFY_BYPASSED=""

# What the gate's check runs left untracked, removed after each one and named once per gate
typeset -a _VERIFY_LITTER

# Where the run started – an isolated run reports from its temp worktree, so a command it prints
# for the branch's checkout names that checkout only where it is not the caller's own
_START_DIR=$PWD

# The caller's own label – an agent session's id, a CI job – closing every reflog message and
# journal line, for a history viewer to name who moved the branch and `--undo` whose run it takes
# back – any other character mapped to `_`, as one could break the quoted command it rides in
_ACTOR=""
_ACTOR_MAPPED=""
_REFLOG_TAG=""
if [ -n "$GIT_EDIT_ACTOR" ]; then
	_ACTOR=${GIT_EDIT_ACTOR//[^A-Za-z0-9_-]/_}
	_REFLOG_TAG=" [$_ACTOR]"
	[ "$_ACTOR" = "$GIT_EDIT_ACTOR" ] || _ACTOR_MAPPED=true
fi

# Temp files to remove however the run ends – a conflict exits straight from the handler,
# past whatever `rm` followed the call that made them, and the pause clears the hook above
# to keep its worktree, so these need a list of their own
_TEMP_FILES=()
# Throwaway worktrees likewise – a gate's, which no pause ever keeps
_TEMP_WORKTREES=()
# Each file taken whole, with the index entry it had then – a re-sync resets only an entry still so
typeset -A WHOLE_IDX

# Tracks whether a status trailer was emitted, so the global trap doesn't put an `error …`
# line on top of an explicit `ok …` or `conflict …` one
_STATUS_EMITTED=false

# Last message passed to `PRINT_ERR`, so the exit trap can name the actual reason in the
# trailer rather than leaving agents to scrape stderr
_LAST_ERROR=""

# The ref move the run landed, so a signal stopping it afterwards reports the move in its
# trailer rather than reading like a run that changed nothing
_LANDED_MOVE=""

# Set as the run starts moving its branch – zsh holds a signal until the `update-ref` it arrived
# during returns, so `_LANDED_MOVE` alone would still read the moved branch as untouched
_LANDING=false

# The first HUP, INT or TERM a landing run finished through rather than stop halfway
_DEFERRED_SIGNAL=""

# The state file holding a pause this run recorded or resumed – the repo has one slot, and a pause
# another run recorded there meanwhile is that run's to keep, not this one's
_STATE_OWNED=""

# Runs the cleanup hook, then emits a machine-readable error trailer matching the success
# form (`git-edit: ok …`), so a `^git-edit:` grep dispatches either outcome on one rule
_GLOBAL_EXIT_TRAP () {
	local CODE=$?
	# A resumable operation keeps its worktree: an interrupt mid-verification would otherwise
	# remove the one the saved state still points at – completions clear their state first, and
	# a failed run keeps it only for a pause of its own, never for one a parallel run recorded
	local SF=$(_STATE_FILE_PATH)
	# A resume that landed is resumable no more, so one stopped before its own `_CLEAR_STATE`
	# clears the state here, sparing `--abort` a pause it would call untouched, and its worktree
	# goes below – the state it resumed only, as a pause another run wrote holds that run's work
	if [ -n "$_LANDED_MOVE" ] && [ -n "$STATE_WORKTREE" ] && [ -n "$SF" ] \
		&& grep -qxF "worktree=$STATE_WORKTREE" "$SF" 2>/dev/null; then
		_CLEAR_STATE
	fi
	if [ -n "$_CLEANUP_HOOK" ] && { [ $CODE -eq 0 ] || [ -z "$_STATE_OWNED" ] || [ ! -f "$_STATE_OWNED" ]; }; then
		eval "$_CLEANUP_HOOK" 2>/dev/null
		_CLEANUP_HOOK=""
	fi
	if [ ${#_TEMP_FILES[@]} -gt 0 ]; then
		rm -f "${_TEMP_FILES[@]}" 2>/dev/null
		_TEMP_FILES=()
	fi
	local W
	for W in "${_TEMP_WORKTREES[@]}"; do
		git worktree remove --force "$W" >/dev/null 2>&1
		rm -rf "$W"
	done
	_TEMP_WORKTREES=()
	if [ -n "$_RERERE_SCOPE_OWNED" ] && [ ! -f "$_RERERE_STATE_FILE" ]; then
		_RERERE_SCOPE_END $CODE
		_RERERE_SCOPE_OWNED=""
	fi
	# A held-back rewrite delivery outlives the run only with the pause it belongs to
	if [ -n "$_CAPTURE_DIR" ] && ! grep -qxF "capture=$_CAPTURE_DIR" "$SF" 2>/dev/null; then
		_CAPTURE_REMOVE "$_CAPTURE_DIR"
	fi
	if [ $CODE -ne 0 ] && [ "$_STATUS_EMITTED" != "true" ]; then
		if [ -n "$_LAST_ERROR" ]; then
			_EMIT_TRAILER "git-edit: error – $_LAST_ERROR"
		else
			_EMIT_TRAILER "git-edit: error – exit code $CODE"
		fi
	fi
}
trap '_GLOBAL_EXIT_TRAP' EXIT

# Routes a termination signal through the exit trap, as a failed run leaves – untrapped, zsh
# dies without running it and the operation's worktree stays registered, PIPE included: a
# reader gone mid-run, a GUI quitting say, ends the run at its next line of output
_TRAP_TERMINATION () {
	trap '_ON_TERMINATION HUP 129' HUP
	trap '_ON_TERMINATION INT 130' INT
	trap '_ON_TERMINATION TERM 143' TERM
	trap '_ON_TERMINATION PIPE 141' PIPE
}

# Stops the run, unless its branch is already moving – stopping then would only strand what the
# move still owes: journal entry `--undo` reads, rewrite delivery, index re-sync
_ON_TERMINATION () {
	# Args: <signal> <exit code>
	# A closed reader is no request to stop, so a landing run takes each SIGPIPE in stride – each,
	# since a descriptor a caller's `>&2` saved comes back pointing at the dead pipe
	if [ "$1" = PIPE ]; then
		exec >/dev/null 2>&1
		[ "$_LANDING" = true ] && return
	elif [ "$_LANDING" = true ] && [ -z "$_DEFERRED_SIGNAL" ]; then
		_DEFERRED_SIGNAL=$1
		return
	fi
	_LAST_ERROR="stopped by SIG$1${_LANDED_MOVE:+ after $_LANDED_MOVE}"
	# A signal at a pause's prompt leaves the pause as q does, and says so as q does
	[ -n "$_AT_PROMPT" ] && _PRINT_LEFT_PAUSED
	exit $2
}
_TRAP_TERMINATION


# ------------------------------------------- FUNCTIONS --------------------------------------------

