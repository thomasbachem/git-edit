		(( ${#Q_PATH} )) && _INDEX_FLAGS_BACK "$CO" ""
		# A path whose entry stayed is named once – a peer's staging meanwhile kept, its file named as
		# written, and one left already saying so – by the worst of what its entries met
		local -A ENT_WHY ENT_PATHS
		local -a ENT_KEYS ENT_LOCKED ENT_LOCKED_PATHS ENT_IN_WAY ENT_IN_WAY_PATHS ERRS
		_AT_TOP "$CO"
		local AT=$REPLY
		for (( K = 1; K <= ${#Q_PATH}; K++ )); do
			[ "${Q_OUT[K]}" = done ] && continue
			ITEM=${Q_ON[K]}
			(( ${+ENT_WHY[$ITEM]} )) || ENT_KEYS+=("$ITEM")
			case ${Q_OUT[K]} in
				(kept) [ -n "${ENT_WHY[$ITEM]}" ] || ENT_WHY[$ITEM]=kept ;;
				(in-way)
					_IN_WAY_WHY "${Q_PATH[K]}" "${Q_BY[K]}" rewrite
					[ "${ENT_WHY[$ITEM]}" = locked ] || ENT_WHY[$ITEM]=$REPLY ;;
				(*) ENT_WHY[$ITEM]=locked ;;
			esac
			# The paths an item's command takes, NUL-joined
			[ "${Q_OUT[K]}" = kept ] || ENT_PATHS[$ITEM]+=${Q_PATH[K]}$'\0'
		done
		for LINE in "${ENT_KEYS[@]}"; do
			L=${LINE%%:*} ITEM=${LINE#*:} WHY=${ENT_WHY[$LINE]}
			case $L in
				(CARRIED) NS="written, edits carried" ;;
				(BROUGHT) NS="written, brought to what landed" ;;
				(*) NS="" ;;
			esac
			# Its line found by its text as it is – a substituted value is never a pattern here
			if [ "$WHY" = kept ]; then
				case $L in
					(CARRIED) CARRIED=("${(@)CARRIED/#%$ITEM/$ITEM (its index entry left as staged meanwhile)}") ;;
					(BROUGHT) BROUGHT=("${(@)BROUGHT/#%$ITEM/$ITEM (its index entry left as staged meanwhile)}") ;;
					(LEFT) LEFT=("${(@)LEFT/#%$ITEM/$ITEM, its index entry left as staged meanwhile}") ;;
					(*) RESYNCED=("${(@)RESYNCED:#$ITEM}") ;;
				esac
				continue
			fi
			case $L in
				(CARRIED) CARRIED=("${(@)CARRIED:#$ITEM}") ;;
				(BROUGHT) BROUGHT=("${(@)BROUGHT:#$ITEM}") ;;
				(RESYNCED) RESYNCED=("${(@)RESYNCED:#$ITEM}") ;;
			esac
			if [ "$L" = LEFT ]; then
				if [ "$WHY" = locked ]; then
					_LOCKED_RESYNC_STEP "$CO" "${OLD:0:12}" "git restore --source=HEAD --staged" "${(@0)ENT_PATHS[$LINE]%$'\0'}"
					WHY="its index entry not re-synced, the index locked – once it is free, where still on the pre-rewrite content: $REPLY"
				else
					WHY="its index entry not written, $WHY – once that staging is committed or unstaged: $AT$(_PATHS_CMD "git restore --source=HEAD --staged" "${(@0)ENT_PATHS[$LINE]%$'\0'}")"
				fi
				LEFT=("${(@)LEFT/#%$ITEM/$ITEM, $WHY}")
			elif [ "$WHY" = locked ]; then
				ENT_LOCKED+=("$ITEM${NS:+ ($NS)}")
				ENT_LOCKED_PATHS+=("${(@0)ENT_PATHS[$LINE]%$'\0'}")
			else
				ENT_IN_WAY+=("$ITEM (${NS:+$NS – }$WHY)")
				ENT_IN_WAY_PATHS+=("${(@0)ENT_PATHS[$LINE]%$'\0'}")
			fi
		done

		(( ${#CARRIED} )) && PRINT_TEXT "Carried onto the new content: %s" 32 "$(_ALL_PATHS "${CARRIED[@]}")"
		(( ${#BROUGHT} )) && PRINT_TEXT "Brought to what landed, holding no edits: %s" 32 "$(_SOME_PATHS "${BROUGHT[@]}")"
		(( ${#RESYNCED} )) && PRINT_TEXT "Index entries brought to what landed, their files left as they are: %s" 32 "$(_SOME_PATHS "${RESYNCED[@]}")"
		(( ${#DIR_MOVED} )) && PRINT_TEXT "Untracked files moved along with their renamed directory: %s" 32 "$(_ALL_PATHS "${DIR_MOVED[@]}")"
		(( ${#DIR_RESPELT} )) && PRINT_TEXT "Directories the rewrite renamed by case alone, now spelled as it has them: %s" 32 "$(_ALL_PATHS "${DIR_RESPELT[@]}")"
		(( ${#DIR_STAYS} )) && PRINT_TEXT "Untracked files left where they are, in a directory the rewrite renamed only in part: %s" 33 "$(_ALL_PATHS "${DIR_STAYS[@]}")"
		[ -z "$SPARSE_ASKED" ] && REAPPLY=("${ASK[@]}" "${REAPPLY[@]}")
		if (( ${#REAPPLY} )); then
			PRINT_TEXT "This git can't ask your sparse checkout's patterns (2.42 can) – the files the rewrite added, left out as outside it: %s – write those inside it with: %s" 33 "$(_SOME_PATHS "${REAPPLY[@]}")" "${AT}git sparse-checkout reapply"
		fi
		if (( ${#MERGE_CMDS} )); then
			PRINT_TEXT "%s" 33 "Merge the conflicting ones, markers and all, once you mean to resolve them:"
			for LINE in "${MERGE_CMDS[@]}"; do ECHO_E "\e[0;33m  $(_LIT "$AT$LINE")\e[0m"; done
		fi
		if (( ${#ENT_LOCKED} )); then
			_LOCKED_RESYNC_STEP "$CO" "${OLD:0:12}" "git restore --source=HEAD --staged" "${(@u)ENT_LOCKED_PATHS}"
			ERRS+=("Index entries left on the pre-rewrite content, the index locked: $(_ALL_PATHS "${ENT_LOCKED[@]}") – re-sync each still so once it is free, the files left as they are: $REPLY")
		fi
		(( ${#ENT_IN_WAY} )) && ERRS+=("Index entries not written, staging in their way: $(_ALL_PATHS "${ENT_IN_WAY[@]}") – write them once that staging is committed or unstaged: $AT$(_PATHS_CMD "git restore --source=HEAD --staged" "${(@u)ENT_IN_WAY_PATHS}")")
		(( ${#BLOCKED} )) && ERRS+=("Left as they were, staging in their way: $(_ALL_PATHS "${BLOCKED[@]}") – carry them once that staging is committed or unstaged: git edit --carry=${OLD:0:12}")
		(( ${#LEFT} )) && ERRS+=("Left as they were, to merge by hand: $(_ALL_PATHS "${LEFT[@]}")")
		# Brought along, bar what a carry again or a re-sync takes – one left to merge by hand is its
		# owner's, as a sync leaves it
		(( ${#ENT_LOCKED} + ${#ENT_IN_WAY} + ${#BLOCKED} )) || _BROUGHT_CARRIED "$CO" "$OLD" "$NEW"
		if (( ${#ERRS} )); then
			for LINE in "${(@)ERRS[1,-2]}"; do PRINT_TEXT "%s" 33 "$LINE"; done
			PRINT_ERR "${ERRS[-1]}"
			exit 1
		fi
		(( ${#CARRIED} + ${#BROUGHT} + ${#DIR_MOVED} + ${#RESYNCED} + ${#DIR_RESPELT} )) || \
			PRINT_TEXT "%s" 32 "Nothing to carry – no path the rewrite changed holds its pre-rewrite content, edited or not."
		REPLY=$(( ${#CARRIED} + ${#BROUGHT} + ${#DIR_MOVED} ))
		return 0
	fi
	# The lists each write stood for take it once done – a file the sync wrote, or a path left
	# already, whatever became of its entry
	for (( K = 1; K <= ${#Q_PATH}; K++ )); do
		P=${Q_PATH[K]}
		L=${Q_ON[K]%%:*}
		ITEM=${Q_ON[K]#*:}
		case ${Q_OUT[K]} in
			(done) [ -z "$L" ] || set -A "$L" "${(@P)L}" "$ITEM" ;;
			(kept)
				if [[ "$L" == (CLEAN|CARRIED|HOOKED) ]]; then
					_ONE_LINE "$ITEM"
					set -A "$L" "${(@P)L}" "$REPLY (its staging left as a peer staged it)"
				else
					[ "$L" = LEFT ] && LEFT+=("$ITEM")
					_ONE_LINE "$P"
					LEFT+=("$REPLY – staged meanwhile")
				fi ;;
			(in-way)
				_ONE_LINE "$P"
				NP=$REPLY
				_IN_WAY_WHY "$P" "${Q_BY[K]}" "$NOUN"
				[[ "$L" == (CLEAN|CARRIED|HOOKED) ]] && REPLY+=" – its file written all the same"
				LEFT+=("$NP – $REPLY") ;;
			(*)
				[[ "$L" == (LEFT|CLEAN|CARRIED|HOOKED) ]] && set -A "$L" "${(@P)L}" "$ITEM"
				if [ "$L" = STALE ]; then LOCKED+=("$P"); else IDX_LOCKED+=("$P"); fi ;;
		esac
	done
	# Brought to <new> – each path left recorded, or for whoever's it is – bar what git or a locked
	# index kept back, which the carry from the mark brings
	if (( ${#STALE} + ${#LOCKED} + ${#IDX_LOCKED} )); then
		_BROUGHT_HOLD "$CO" "$OLD"
	else
		_BROUGHT_PUT "$CO" "$NEW"
	fi

	# A path outside a sparse checkout took its entry alone, git keeping no file there – named apart
	local -a CAME OUTSIDE GONE OUT_GONE
	local -A GONE_OUT
	# One the move took out there too, a rename's source say, as the patterns tell – its entry gone
	for P in "${CLEAN[@]}"; do [ -z "${DIFF_N[$P]}" ] && [ ! -e "$CO/$P" ] && [ ! -L "$CO/$P" ] && GONE+=("$P"); done
	if (( ${#GONE} )) && _SPARSE_OUT "$CO" "${GONE[@]}"; then
		for P in "${reply[@]}"; do GONE_OUT[$P]=1; done
	fi
	for P in "${CLEAN[@]}"; do
		if (( ${+GONE_OUT[$P]} )); then OUT_GONE+=("$P")
		elif [ -n "${DIFF_N[$P]}" ] && [ ! -e "$CO/$P" ] && [ ! -L "$CO/$P" ]; then OUTSIDE+=("$P")
		else CAME+=("$P")
		fi
	done
	# Told by its skip-worktree flag, in one read
	if (( ${#OUTSIDE} )); then
		local -A FLAGGED_S
		for LINE in ${(0)"$(_GIT_PATH_CHUNKS -C "$CO" ls-files -v -z -- "${OUTSIDE[@]}" 2>/dev/null)"}; do
			[ "${LINE[1]}" = S ] && FLAGGED_S[${LINE[3,-1]}]=1
		done
		local -a OUT_S
		for P in "${OUTSIDE[@]}"; do if (( ${+FLAGGED_S[$P]} )); then OUT_S+=("$P"); else CAME+=("$P"); fi; done
		OUTSIDE=("${OUT_S[@]}")
	fi
	OUTSIDE+=("${OUT_GONE[@]}")
	(( ${#CAME} )) && PRINT_TEXT "Your checkout came along – now as they landed: %s" 32 "$(_SOME_PATHS "${CAME[@]}")"
	(( ${#OUTSIDE} )) && PRINT_TEXT "Outside your sparse checkout, no file written – their index entries now as they landed: %s" 32 "$(_SOME_PATHS "${OUTSIDE[@]}")"
	(( ${#CARRIED} )) && PRINT_TEXT "Uncommitted edits merged onto what landed: %s" 32 "$(_SOME_PATHS "${CARRIED[@]}")"
	(( ${#HOOKED} )) && PRINT_TEXT "Files still as the commit read them, which its hooks then changed, now as they landed: %s" 32 "$(_SOME_PATHS "${HOOKED[@]}")"
	# What the move took out of the checkout – a file it removed, anything a drop changed – named
	# with the way back, an undo's aside, and `--undo` only where it brings the checkout back, as it
	# leaves what a commit, fold or `--exec` only adding commits landed as uncommitted changes
	local -a TAKEN
	local KIND=${_MOVING_REF[4]%% *}
	if [ "$KIND" != undo ]; then
		for P in "${CLEAN[@]}" "${CARRIED[@]}"; do
			# Not a rename's source, its file gone to its new name
			(( ${+WIDE[$P]} || ${+RENAMED_TO[$P]} )) && continue
			[ -n "${DIFF_O[$P]}" ] && { [ -z "${DIFF_N[$P]}" ] || [ "$KIND" = drop ]; } && TAKEN+=("$P")
		done
	fi
	if (( ${#TAKEN} )) && { [[ "$KIND" == (commit|amend-into) ]] || { [ "$KIND" = exec ] && [ "$NOUN" = landing ]; }; }; then
		PRINT_TEXT "Taken out of your checkout with the %s: %s – back with %s" 33 "$NOUN" "$(_SOME_PATHS "${TAKEN[@]}")" "git show ${OLD:0:12}:<path>"
	elif (( ${#TAKEN} )); then
		PRINT_TEXT "Taken out of your checkout with the %s: %s – back with %s while that is the last run, else %s" 33 \
			"$NOUN" "$(_SOME_PATHS "${TAKEN[@]}")" "git edit --undo" "git show ${OLD:0:12}:<path>"
	fi
	(( ${#DIR_MOVED} )) && PRINT_TEXT "Untracked files moved along with their renamed directory: %s" 32 "$(_SOME_PATHS "${DIR_MOVED[@]}")"
	(( ${#DIR_RESPELT} )) && PRINT_TEXT "Directories the $NOUN renamed by case alone, now spelled as it has them: %s" 32 "$(_ALL_PATHS "${DIR_RESPELT[@]}")"
	(( ${#DIR_STAYS} )) && PRINT_TEXT "Untracked files left where they are, in a directory the $NOUN renamed only in part: %s" 33 "$(_ALL_PATHS "${DIR_STAYS[@]}")"
	if (( ${#CONFLICTED} )); then
		_AT_TOP "$CO"
		local AT=$REPLY
		# The merge puts markers into the live file – the edits' owner's call, which a session landing
		# over another's edits can't make, so an agent's run says whose it is
		if _IS_NON_INTERACTIVE; then
			PRINT_TEXT "Uncommitted edits conflict with what landed – left as they were, as changes to it: %s" 33 "$(_ALL_PATHS "${CONFLICTED[@]}")"
			_TODO_ADD "the merge of $(_ALL_PATHS "${CONFLICTED[@]}"), if those edits are yours" "%s" 33 \
				"If those edits are yours, merge them, markers and all, once you mean to resolve them – if another session's, leave them: its next commit of the file that would take it back is refused, naming this merge:"
		else
			PRINT_TEXT "Your uncommitted edits conflict with what landed – left as they were, as changes to it: %s" 33 "$(_ALL_PATHS "${CONFLICTED[@]}")"
			_TODO_ADD "the merge of $(_ALL_PATHS "${CONFLICTED[@]}")" "%s" 33 "Merge them, markers and all, once you mean to resolve them:"
		fi
		for P in "${MERGE_CMDS[@]}"; do _TODO_CMD "$AT$P"; done
	fi
	# Whose they are no sync can tell, so nothing is offered that takes them
	(( ${#KEPT} )) && PRINT_TEXT "Files stood where the $NOUN put its own – they stay, as changes to what landed: %s" 33 "$(_SOME_PATHS "${KEPT[@]}")"
	(( ${#KEPT_EDITS} )) && PRINT_TEXT "Uncommitted edits stay as they were, now changes to what landed, which no merge could take them onto: %s" 33 "$(_ALL_PATHS "${KEPT_EDITS[@]}")"
	(( ${#OWN_LATER} )) && PRINT_TEXT "Files you committed keep your later edits, now changes to what landed: %s" 32 "$(_SOME_PATHS "${OWN_LATER[@]}")"
	_PRINT_MODE_ONLY "$CO" "$NEW" "${MODE_ONLY[@]}"
	# What git refused or a locked index kept back takes the carry, which writes only a file and an
	# entry still as this sync left them, so a peer's write or staging since stays
	(( ${#STALE} )) && PRINT_TEXT "Not brought along – git refused%s, their entries holding what landed: %s" 33 "${ERR:+ ($ERR)}" "$(_SOME_PATHS "${STALE[@]}")"
	(( ${#LOCKED} )) && PRINT_TEXT "Not brought along – git refused%s, the index still on the $FORMER content: %s" 33 "${ERR:+ ($ERR)}" "$(_SOME_PATHS "${LOCKED[@]}")"
	# Files kept as they are, their entries alone left behind – committed as staged, they take it back
	(( ${#IDX_LOCKED} )) && PRINT_TEXT "Index entries not re-synced, the index was locked – they still hold the $FORMER content: %s" 33 "$(_SOME_PATHS "${IDX_LOCKED[@]}")"
	(( ${#STALE} + ${#LOCKED} + ${#IDX_LOCKED} )) && _CARRY_TODO "$CO" "$OLD" "Bring those along once that is cleared: %s"
	_INDEX_FLAGS_BACK "$CO" ""
	(( ${#GONE_EDITED} )) && PRINT_TEXT "Removed by the $NOUN – your edits to them stay, untracked: %s" 33 "$(_ALL_PATHS "${GONE_EDITED[@]}")"
	(( ${#DELETED} )) && PRINT_TEXT "Deleted in your checkout – they stay deleted: %s" 33 "$(_ALL_PATHS "${DELETED[@]}")"
	# Whose they are no sync can tell – the staging may be a peer's – so none is called the caller's
	(( ${#LEFT} )) && PRINT_TEXT "Left as they were, for whoever's they are to reconcile: %s" 33 "$(_ALL_PATHS "${LEFT[@]}")"
	# A file staged and edited both keeps a staged revert of what landed – the carry merges that into
	# the file, its entry left, for the staging's owner to stage its part again
	(( ${#PARTIAL} )) && _CARRY_TODO "$CO" "$OLD" \
		"Whoever staged %s – a peer's staging, or the caller's own – brings what landed into the file with %s, then stages their part again" \
		"$(_ALL_PATHS "${PARTIAL[@]}")" -- "${PARTIAL[@]}"
	_PRINT_SUBMODULES_MOVED "$CO" "${SUBMODULES[@]}"
	_OTHER_CHECKOUTS_TODO "$GD" "${_MOVING_REF[1]}" "$OLD"
	# Brought along – a second signal from here on has no carry to name
	_SYNC_DONE=1
	return 0
}

# Fills `STEP_FROM` and `STEP_TO` with the landings journaled on <ref> that led to <new> in the last
# 7 days, newest first, each its old and new tip, at most 40 – an undo puts back a tip, the line of
# the run it took back gone, so the walk goes on from that tip to the landing that made it
# • An undo taking the checkout back as it came is a step too, from the tip it undid, the walk going
#   on from the tip it put back – one keeping what a commit, fold or `--exec` only adding commits
#   landed is none, its content the checkout's
# • Where <old> is no tip on the way, the move from <old> to <new> stands first, the walk going on
#   from <old>, as nothing tells what came between
_LANDING_STEPS () {
	# Args: <ref> <old> <new>
	local REF=$1 OLD=$2 AT=$3 JF=$(_JOURNAL_FILE_PATH) LINE TEXT
	local -i NOW=$EPOCHSECONDS K REACHED=0
	local -a J
	STEP_FROM=() STEP_TO=()
	[ -n "$JF" ] && [ -s "$JF" ] && { TEXT=$(<"$JF") } 2>/dev/null
	for K in 1 2; do
		for LINE in "${(@Oaf)TEXT}"; do
			(( ${#STEP_FROM} < 40 )) || break
			J=(${=${LINE%%$'\t'*}})
			[[ "${J[1]}" == <1-9999999999> ]] && (( J[1] >= NOW - 604800 )) && [ "${J[2]}" = "$REF" ] && [ "${J[4]}" = "$AT" ] && [ -n "${J[3]}" ] || continue
			if [ "${J[5]}" = undo ]; then
				[[ "${J[6]}" == (commit|amend-into) ]] && continue
				[ "${J[6]}" = exec ] && _IS_ANCESTOR "${J[4]}" "${J[3]}" && continue
				STEP_FROM+=("${J[3]}") STEP_TO+=("${J[4]}")
				[ "${J[3]}" = "$OLD" ] && REACHED=1
				continue
			fi
			STEP_FROM+=("${J[3]}") STEP_TO+=("${J[4]}")
			AT=${J[3]}
			[ "$AT" = "$OLD" ] && REACHED=1
		done
		(( REACHED )) || [ "$OLD" = "$3" ] && return 0
		# <old> on no landing that led here – its own move first, then what led to it
		STEP_FROM=("$OLD") STEP_TO=("$3") AT=$OLD REACHED=1
	done
	return 0
}

# Puts into `REPLY` the blob <tip> holds at <name>, nothing where it holds none – asked once, kept
# in the caller's `FB_BLOB`
_BLOB_AT () {
	# Args: <tip> <name>
	if (( ! ${+FB_BLOB[$1:$2]} )); then
		FB_BLOB[$1:$2]=$(git rev-parse -q --verify "$1:$2" 2>/dev/null)
	fi
	REPLY=${FB_BLOB[$1:$2]}
}

# Tells whether the edits in blob <ours> lack the change a landing made from blob <before> to blob
# <after> – 0 where they do, 1 where they hold it, its lines all among theirs where the merge
# conflicts, 2 where no text merge tells, a binary say
_LANDING_LACKED () {
	# Args: <ours> <before> <after> – reads the caller's `_MERGE_FILE_IDS`, `-` until asked
	local ID RC OURS BASE THEIRS
	if [ "$_MERGE_FILE_IDS" = - ]; then
		_MERGE_FILE_IDS=""
		[[ "$(LC_ALL=C git merge-file -h 2>&1)" == *object-id* ]] && _MERGE_FILE_IDS=yes
	fi
	ID=$(_MERGE_LANDING "$1" "$2" "$3")
	RC=$?
	if (( RC == 0 )); then
		[ "$ID" = "$1" ] && return 1
		return 0
	fi
	(( RC > 127 )) && return 2
	OURS=$(MKTEMP_FILE git-edit-ours) BASE=$(MKTEMP_FILE git-edit-base) THEIRS=$(MKTEMP_FILE git-edit-theirs)
	_TEMP_FILES+=("$OURS" "$BASE" "$THEIRS")
	RC=2
	if git cat-file blob "$1" > "$OURS" 2>/dev/null && git cat-file blob "$2" > "$BASE" 2>/dev/null && git cat-file blob "$3" > "$THEIRS" 2>/dev/null; then
		RC=1
		[ -n "$(LC_ALL=C comm -23 <(_CHANGED_LINES "$BASE" "$THEIRS") <(_CHANGED_LINES "$BASE" "$OURS"))" ] && RC=0
	fi
	rm -f "$OURS" "$BASE" "$THEIRS"
	return $RC
}

# Fills `FB_ENT`, `FB_TIP` and `FB_NAME` with each <path>'s own base, where it is other than <old>'s
# entry at its own name – the tip its file was last brought to, the old tip of the earliest landing
# it lacks past the last it holds:
# • A path a run left unbrought – a conflict, staging, or no sync at all – takes its record's base,
#   `_UNBROUGHT_BASE`'s, while the file still lacks the landing that left it
# • Else the landings that led to <new> tell, newest first: a file holding a tip's content as it
#   is was brought to that tip, one holding a landing's change to that landing's new tip, one
#   lacking it to a tip before – a landing that changed none of it, or renamed it alone, telling
#   nothing – down to the one from the checkout's mark, below which every landing was brought
# • Where none tells – no journal, a peer's staging on the path, a binary, a path added on the way –
#   it keeps <old>, the one base a carry names for every file
_FILE_BASES () {
	# Args: <checkout> <old> <new> <path>... – reads the caller's `DIFF_O`, `DIFF_N`, `IDX_ENT`,
	# `WT_HASH` and `BROUGHT_END`, and its `STEP_FROM` and `STEP_TO`, filled here where empty
	local CO=$1 OLD=$2 NEW=$3 P W I A B NAME FROM BT BN BB CT CN CB RF REF _MERGE_FILE_IDS=""
	local -i S RC K LIM
	local -a ASK QUERY ANS GOT REC FALLBACK
	local -A FB_BLOB UNBROUGHT SEEN
	shift 3
	FB_ENT=() FB_TIP=() FB_NAME=()
	# A regular file at <new> holding neither side's content, its name on one line
	for P in "$@"; do
		W=${WT_HASH[$P]}
		[ -n "$W" ] && [[ "${DIFF_N[$P]% *}" == 100(644|755) ]] && [[ "$P" != (*$'\n'*|*$'\r') ]] || continue
		[ "$W" = "${DIFF_N[$P]#* }" ] || [ "$W" = "${DIFF_O[$P]#* }" ] || [ "${IDX_ENT[$P]}" = conflict ] || ASK+=("$P")
	done
	(( ${#ASK} )) || return 0
	# Its content in the object store, as each landing's merge reads it
	ANS=("${(@f)$(print -rl -- "${ASK[@]}" | git -C "$CO" hash-object -w --stdin-paths 2>/dev/null)}")
	(( ${#ANS} == ${#ASK} )) || return 0
	# Whether git merges blobs by ID (2.43), asked once a merge is due
	_MERGE_FILE_IDS=-
	REF=$(git -C "$CO" symbolic-ref -q HEAD 2>/dev/null)
	_UNBROUGHT_READ "$CO"
	(( ${#STEP_FROM} )) || [ -z "$REF" ] || _LANDING_STEPS "$REF" "$OLD" "$NEW"
	# A landing at or below the checkout's mark was brought – a file holding what came before it holds
	# an edit – so the walk ends at the landing from there
	LIM=${#STEP_FROM}
	[ -n "$BROUGHT_END" ] && (( ${STEP_FROM[(Ie)$BROUGHT_END]} )) && LIM=${STEP_FROM[(ie)$BROUGHT_END]}
	[ "$BROUGHT_END" = "$NEW" ] && LIM=0
	# Every tip's blob at each name as it stands at <new>, in one call
	for P in "${ASK[@]}"; do
		for (( S = 1; S <= LIM; S++ )); do QUERY+=("${STEP_FROM[S]}:$P" "${STEP_TO[S]}:$P"); done
	done
	if (( ${#QUERY} )); then
		GOT=("${(@f)$(print -rl -- "${QUERY[@]}" | git cat-file --batch-check='%(objectname) %(objecttype)' 2>/dev/null)}")
		if (( ${#GOT} == ${#QUERY} )); then
			for (( S = 1; S <= ${#QUERY}; S++ )); do
				if [[ "${GOT[S]}" == *" blob" ]]; then FB_BLOB[${QUERY[S]}]=${GOT[S]%% *}; else FB_BLOB[${QUERY[S]}]=""; fi
			done
		fi
	fi
	for (( K = 1; K <= ${#ASK}; K++ )); do
		P=${ASK[K]} W=${ANS[K]} NAME=${ASK[K]}
		BT="" BN="" BB="" CT="" CN="" CB=""
		SEEN=()
		# Left unbrought by a run, its record tells – unless the file holds by now all that changed from
		# its base to the landing that left it, merged by hand
		if (( ${+UNBROUGHT[$P]} )); then
			REC=(${=UNBROUGHT[$P]})
			_BLOB_AT "${REC[3]}" "$P"; A=$REPLY
			_BLOB_AT "${REC[1]}" "$P"; BB=$REPLY
			if [ -n "$BB" ]; then
				RC=0
				[ -n "$A" ] && [ "$A" != "$BB" ] && { _LANDING_LACKED "$W" "$BB" "$A"; RC=$?; }
				(( RC == 1 )) || BT=${REC[1]} BN=$P
			fi
		fi
		# Else each landing, newest first
		for (( S = 1; S <= LIM && ! ${#BT}; S++ )); do
			_BLOB_AT "${STEP_TO[S]}" "$NAME"; A=$REPLY
			[ -n "$A" ] || break
			SEEN[$A]=1
			if [ "$W" = "$A" ]; then BT=${STEP_TO[S]} BN=$NAME BB=$A; break; fi
			FROM=$NAME
			_BLOB_AT "${STEP_FROM[S]}" "$NAME"; B=$REPLY
			# Missing before it – renamed into place, followed back to its old name, or added there
			if [ -z "$B" ]; then
				RF=x$(git diff -z -M --name-status --diff-filter=R "${STEP_FROM[S]}" "${STEP_TO[S]}" 2>/dev/null)
				GOT=("${(@0)RF#x}") FROM=""
				for (( RC = 1; RC + 2 <= ${#GOT}; RC += 3 )); do
					[ "${GOT[RC + 2]}" = "$NAME" ] && FROM=${GOT[RC + 1]} && break
				done
				[ -n "$FROM" ] || break
				_BLOB_AT "${STEP_FROM[S]}" "$FROM"; B=$REPLY
				[ -n "$B" ] || break
				_BLOB_AT "${STEP_TO[S]}" "$NAME"; A=$REPLY
			fi
			SEEN[$B]=1
			if [ "$W" = "$B" ]; then BT=${STEP_FROM[S]} BN=$FROM BB=$B; break; fi
			if [ "$B" != "$A" ]; then
				# The move a sync makes is its own merge's to take – what it lacks is what lies before
				if (( S == 1 )) && [ "${STEP_FROM[S]}" = "$OLD" ]; then
					RC=0
				else
					_LANDING_LACKED "$W" "$B" "$A"
					RC=$?
				fi
				if (( RC == 1 )); then BT=${STEP_TO[S]} BN=$NAME BB=$A; break; fi
				(( RC == 2 )) && { CT="" CN=-; break; }
				CT=${STEP_FROM[S]} CN=$FROM CB=$B
			fi
			NAME=$FROM
		done
		[ -z "$BT" ] && [ -n "$CT" ] && BT=$CT BN=$CN BB=$CB
		# No text merge tells, or a peer's staging on the path tells another story – the one base
		I=${IDX_ENT[$P]}
		if [ "$CN" = - ] || { [ -n "$BT" ] && [ -n "$I" ] && [ "${I#* }" != "${DIFF_O[$P]#* }" ] && [ "${I#* }" != "${DIFF_N[$P]#* }" ] && \
		   (( ! ${+SEEN[${I#* }]} && ! ${+UNBROUGHT[$P]} )); }; then
			FALLBACK+=("$P")
			continue
		fi
		[ -n "$BT" ] || continue
		_FILE_BASE_SET "$P" "$BT" "$BN" "$BB"
	done
	# Those it couldn't tell keep the one base a carry names for every file – the old tip of the
	# earliest landing one of them lacks that <old> still holds, never one past a landing they lack
	if (( ${#FALLBACK} )); then
		_CARRY_BASE "$CO" "$OLD" "${FALLBACK[@]}"
		BT=$REPLY
		if [ "$BT" != "$OLD" ]; then
			for P in "${FALLBACK[@]}"; do
				_BLOB_AT "$BT" "$P"
				[ -n "$REPLY" ] && _FILE_BASE_SET "$P" "$BT" "$P" "$REPLY"
			done
		fi
	fi
	return 0
}

# Sets <path>'s base in the caller's `FB_ENT`, `FB_TIP` and `FB_NAME` – <name> at <tip>, holding
# <blob> – where it is a regular file and other than <old>'s own entry there
_FILE_BASE_SET () {
	# Args: <path> <tip> <name> <blob> – reads the caller's `DIFF_O`
	local E
	local -x GIT_LITERAL_PATHSPECS=1
	[ "$3" = "$1" ] && [ "$4" = "${DIFF_O[$1]#* }" ] && return 0
	E=$(git ls-tree --full-tree "$2" -- "$3" 2>/dev/null)
	[[ "${E%% *}" == 100(644|755) ]] || return 0
	FB_TIP[$1]=$2 FB_NAME[$1]=$3 FB_ENT[$1]="${E%% *} $4"
}

# Fills the caller's `UNBROUGHT` with each path a run left unbrought in <checkout> – its base tip,
# the landing that left it and when, and the file's blob then where stored, "<base> <old> <new>
# <epoch> [<blob>]" – a record on its branch, of a landing of the last 7 days still standing, the
# newest per path, `REPLY` naming the record
# One line a path, "<epoch> <ref> <old> <new> <base> [<blob>]", a tab and the path closing it
_UNBROUGHT_READ () {
	# Args: <checkout>
	local CO=$1 F JF REF TEXT LINE JT=""
	local -a R
	UNBROUGHT=()
	F=$(git -C "$CO" rev-parse --path-format=absolute --git-path git-edit-unbrought 2>/dev/null)
	REPLY=$F
	[ -n "$F" ] && [ -s "$F" ] && { TEXT=$(<"$F") } 2>/dev/null || return 0
	REF=$(git -C "$CO" symbolic-ref -q HEAD 2>/dev/null)
	JF=$(_JOURNAL_FILE_PATH) && { JT=$(<"$JF") } 2>/dev/null
	for LINE in "${(@f)TEXT}"; do
		R=(${=${LINE%%$'\t'*}})
		(( ${#R} == 5 || ${#R} == 6 )) && [[ "${R[1]}" == <1-9999999999> ]] && (( R[1] >= EPOCHSECONDS - 604800 )) && [ "${R[2]}" = "$REF" ] || continue
		# An undo leaves the landing no line of its own
		[[ $'\n'"$JT" == *$'\n'<->" ${R[2]} ${R[3]} ${R[4]} "* ]] || continue
		UNBROUGHT[${LINE#*$'\t'}]="${R[5]} ${R[3]} ${R[4]} ${R[1]}${R[6]:+ ${R[6]}}"
	done
	REPLY=$F
}

# Puts into `REPLY` the base tip of <path> where a run left it unbrought in <checkout> – the old tip
# its file still sits on – nothing where none did, or the landing that left it was undone or is past
# 7 days
_UNBROUGHT_BASE () {
	# Args: <checkout> <path>
	local -A UNBROUGHT
	_UNBROUGHT_READ "$1"
	REPLY=${${UNBROUGHT[$2]}%% *}
}

# Records in <checkout> each path its move from <old> to <new> left unbrought, with the base its
# file still sits on, and clears each it brought along – the caller's `NOT_BROUGHT` (path -> base),
# its `UNB_BY` naming another landing that left one, and the rest of its `CHANGED` – dropping lines
# past 7 days, of another branch, or of a landing undone since
_UNBROUGHT_NOTE () {
	# Args: <checkout> <old> <new>
	local CO=$1 F P REF TMPF
	local -i K
	local -a OUT
	local -A UNBROUGHT KEEP BY
	# Only a caller declaring `UNB_BY` names one – read so, as a name unset there is no association
	[[ ${(t)UNB_BY} == association* ]] && BY=("${(@kv)UNB_BY}")
	_UNBROUGHT_READ "$CO"
	F=$REPLY
	KEEP=("${(@kv)UNBROUGHT}")
	for P in "${CHANGED[@]}"; do unset "KEEP[$P]"; done
	# Nothing to add, nothing this move touched to clear, and no line the read dropped – of a landing
	# undone, say
	local -a RAW
	[ -n "$F" ] && { RAW=("${(@f)$(<"$F")}") } 2>/dev/null
	[ -n "$F" ] && (( ${#NOT_BROUGHT} || ${#KEEP} < ${#UNBROUGHT} || ${#RAW} > ${#UNBROUGHT} )) || return 0
	REF=$(git -C "$CO" symbolic-ref -q HEAD 2>/dev/null) || return 0
	for P in "${(@k)KEEP}"; do
		OUT+=("${${KEEP[$P]}[(w)4]} $REF ${${KEEP[$P]}[(w)2]} ${${KEEP[$P]}[(w)3]} ${${KEEP[$P]}[(w)1]}${${KEEP[$P]}[(w)5]:+ ${${KEEP[$P]}[(w)5]}}"$'\t'"$P")
	done
	# Each file newly left stored as it stands, which the landings guard reads its owner's edits since
	# against – in one call, none where it answers short
	local -a NEW_PATHS SNAPS
	for P in "${(@k)NOT_BROUGHT}"; do
		[[ "$P" == *$'\n'* ]] || [ "${${UNBROUGHT[$P]}[(w)1]}" = "${NOT_BROUGHT[$P]}" ] || \
			{ [ -f "$CO/$P" ] && [ ! -L "$CO/$P" ] && NEW_PATHS+=("$P"); }
	done
	(( ${#NEW_PATHS} )) && SNAPS=("${(@f)$(print -rl -- "${NEW_PATHS[@]}" | git -C "$CO" hash-object -w --stdin-paths 2>/dev/null)}")
	(( ${#SNAPS} == ${#NEW_PATHS} )) || SNAPS=()
	local -A SNAP
	for (( K = 1; K <= ${#SNAPS}; K++ )); do SNAP[${NEW_PATHS[K]}]=${SNAPS[K]}; done
	# A path left again on the same base keeps the landing that first left it there, which an undo of
	# a later one leaves standing, and its file as it stood then
	for P in "${(@k)NOT_BROUGHT}"; do
		[[ "$P" == *$'\n'* ]] && continue
		if [ "${${UNBROUGHT[$P]}[(w)1]}" = "${NOT_BROUGHT[$P]}" ]; then
			OUT+=("${${UNBROUGHT[$P]}[(w)4]} $REF ${${UNBROUGHT[$P]}[(w)2]} ${${UNBROUGHT[$P]}[(w)3]} ${NOT_BROUGHT[$P]}${${UNBROUGHT[$P]}[(w)5]:+ ${${UNBROUGHT[$P]}[(w)5]}}"$'\t'"$P")
		else
			OUT+=("$EPOCHSECONDS $REF ${BY[$P]:-$2 $3} ${NOT_BROUGHT[$P]}${SNAP[$P]:+ ${SNAP[$P]}}"$'\t'"$P")
		fi
	done
	TMPF="$F.$$"
	if (( ${#OUT} )); then
		print -rl -- "${OUT[@]}" > "$TMPF" 2>/dev/null || return 0
		if (( ${+builtins[zf_mv]} )); then zf_mv -f "$TMPF" "$F" 2>/dev/null; else mv -f "$TMPF" "$F" 2>/dev/null; fi
	else
		rm -f "$F"
	fi
	return 0
}

# Records in <checkout>, a branch's other checkout no sync brings along, each file the move from
# <old> to <new> changed that it leaves other than what landed – on the base its record names, else
# <old> – and clears each one now as landed, as a sync's record does
_UNBROUGHT_OTHER () {
	# Args: <checkout> <old> <new>
	local CO=$1 P
	local -a CHANGED DIFF_PATHS
	local -A DIFF_O DIFF_N NOT_BROUGHT UNBROUGHT
	_DIFF_ENTRIES "$2" "$3"
	(( ${#DIFF_PATHS} )) || return 0
	CHANGED=("${DIFF_PATHS[@]}")
	# Its files against what landed, a removed one's lingering untracked too
	for P in ${(0)"$(_GIT_PATH_CHUNKS -C "$CO" diff -z --name-only --no-renames --ignore-submodules=dirty "$3" -- "${DIFF_PATHS[@]}" 2>/dev/null)"}; do
		NOT_BROUGHT[$P]=""
	done
	for P in "${DIFF_PATHS[@]}"; do
		[ -z "${DIFF_N[$P]}" ] && [ -f "$CO/$P" ] && [ ! -L "$CO/$P" ] && NOT_BROUGHT[$P]=""
	done
	_UNBROUGHT_READ "$CO"
	for P in "${(@k)NOT_BROUGHT}"; do
		if [[ "${DIFF_O[$P]% *} ${DIFF_N[$P]% *}" == *(120000|160000)* ]]; then
			unset "NOT_BROUGHT[$P]"
		else
			NOT_BROUGHT[$P]=${${UNBROUGHT[$P]}%% *}
			[ -n "${NOT_BROUGHT[$P]}" ] || NOT_BROUGHT[$P]=$2
		fi
	done
	_UNBROUGHT_NOTE "$CO" "$2" "$3"
}

# Adds to the caller's `NOT_BROUGHT` each file of <checkout> outside its `CHANGED` that a landing
# left stale – one other than <new> whose walk finds a landing it lacks – with that walk's base, and
# to its `UNB_BY` the newest such landing, which the record names
# • For a sync that started with no mark ending the walk – an older git-edit's checkout, say – so
#   the mark it writes ends the walk for every other file, as uncommitted work no landing touched
#   records nothing
_UNBROUGHT_UNSEEN () {
	# Args: <checkout> <old> <new>
	local CO=$1 P B
	local -i S
	local -a ASK STEP_FROM STEP_TO
	local -A SEEN DIFF_O DIFF_N IDX_ENT WT_HASH FB_ENT FB_TIP FB_NAME FB_BLOB TREE_ENT UNBROUGHT
	for P in "${CHANGED[@]}" "${(@k)NOT_BROUGHT}"; do SEEN[$P]=1; done
	# One already recorded keeps its record
	_UNBROUGHT_READ "$CO"
	for P in ${(0)"$(git -C "$CO" diff --ignore-submodules=dirty -z --name-only --no-renames "$3" 2>/dev/null)"} \
	         ${(0)"$(git -C "$CO" diff --cached --ignore-submodules=dirty -z --name-only --no-renames "$3" 2>/dev/null)"}; do
		(( ${+SEEN[$P]} || ${+UNBROUGHT[$P]} )) && continue
		SEEN[$P]=1
		ASK+=("$P")
	done
	(( ${#ASK} )) || return 0
	_TREE_ENTRIES "$3" "${ASK[@]}"
	for P in "${ASK[@]}"; do
		[[ "${TREE_ENT[$P]% *}" == 100(644|755) ]] && DIFF_O[$P]=${TREE_ENT[$P]} DIFF_N[$P]=${TREE_ENT[$P]}
	done
	(( ${#DIFF_N} )) || return 0
	ASK=("${(@k)DIFF_N}")
	_INDEX_ENTRIES "$CO" "" "${ASK[@]}"
	_WORKTREE_HASHES "$CO" "${ASK[@]}"
	_FILE_BASES "$CO" "$2" "$3" "${ASK[@]}"
	for P in "${(@k)FB_TIP}"; do
		NOT_BROUGHT[$P]=${FB_TIP[$P]}
		for (( S = 1; S <= ${#STEP_FROM}; S++ )); do
			_BLOB_AT "${STEP_FROM[S]}" "$P"
			B=$REPLY
			_BLOB_AT "${STEP_TO[S]}" "$P"
			[ "$B" != "$REPLY" ] && UNB_BY[$P]="${STEP_FROM[S]} ${STEP_TO[S]}" && break
		done
	done
	return 0
}

# Puts into `REPLY` the tip <checkout>'s last sync or carry on <ref> finished at – its "brought"
# mark, `git-edit-brought` in its own git dir, or <file> where given – nothing where it keeps none
# for <ref>, and into `reply` `held` where no sync or carry made it, only a run that left the
# checkout unbrought, which tells no file's base
# • Nothing either where the checkout's `HEAD` moved since but by git-edit's own ref moves – a
#   switch away and back, say, while the branch moved, its files as git left them, not as the mark
#   tells – or where its reflog no longer names the entry the mark was written at
_BROUGHT_READ () {
	# Args: <checkout> <ref> [<file>]
	local F=$3 TEXT L G A
	local -a T E
	REPLY="" reply=()
	[ -n "$F" ] || F=$(git -C "$1" rev-parse --path-format=absolute --git-path git-edit-brought 2>/dev/null) && [ -n "$F" ] || return 0
	{ TEXT=$(<"$F") } 2>/dev/null || return 0
	T=(${=${TEXT%%$'\n'*}})
	[ "${T[1]}" = "$2" ] && [[ ${#T[2]} == (40|64) && "${T[2]}" != *[^0-9a-f]* ]] || return 0
	[[ "$TEXT" == *$'\n'?* ]] || return 0
	_BROUGHT_HEADS "${F%/*}"
	E=("${reply[@]}")
	reply=()
	for L in "${E[@]}"; do
		[ "$L" = "${TEXT#*$'\n'}" ] && break
		# Bar one moving nothing – a reset to `HEAD`, a stash's say, or a checkout of the branch it
		# is on, which a `checkout -B` names apart, as "branch: Reset to …" – its message telling,
		# as git-edit's own moves of the branch leave the entry before it no tip to compare with
		G=${L#*$'\t'*$'\t'}
		A=${${G#checkout: moving from }%% to *}
		[[ "$G" == "git edit: "* || "$G" == "reset: moving to HEAD" ]] || [ "$G" = "checkout: moving from $A to $A" ] || return 0
	done
	(( ${E[(Ie)${TEXT#*$'\n'}]} )) || return 0
	REPLY=${T[2]}
	[ "${T[3]}" = held ] && reply=(held)
	return 0
}

# Puts into `reply` the newest entries of the `HEAD` reflog in git dir <dir>, newest first, each its
# commit, unix-time selector and message – where a mark stands, and what moved `HEAD` since
_BROUGHT_HEADS () {
	# Args: <git dir> [<count>]
	reply=("${(@f)$(git --git-dir="$1" reflog show -n "${2:-50}" --date=unix --format='%H%x09%gd%x09%gs' HEAD -- 2>/dev/null)}")
	reply=("${(@)reply:#}")
	return 0
}

# Writes <tip> as <checkout>'s mark on the branch it has checked out, or on <ref> to <file>, `held`
# where no sync or carry made it, the checkout's newest `HEAD` reflog entry on its second line – a
# copy moved into place, so a reader never meets half a line
_BROUGHT_PUT () {
	# Args: <checkout> <tip> [<ref> <file> [held]]
	local REF=$3 F=$4
	{ [ -n "$REF" ] || REF=$(git -C "$1" symbolic-ref -q HEAD 2>/dev/null); } && \
		{ [ -n "$F" ] || F=$(git -C "$1" rev-parse --path-format=absolute --git-path git-edit-brought 2>/dev/null); } && [ -n "$F" ] || return 0
	_BROUGHT_HEADS "${F%/*}" 1
	print -r -- "$REF $2${5:+ $5}"$'\n'"${reply[1]}" > "$F.$$" 2>/dev/null || return 0
	if (( ${+builtins[zf_mv]} )); then zf_mv -f "$F.$$" "$F" 2>/dev/null; else mv -f "$F.$$" "$F" 2>/dev/null; fi
	return 0
}

# Puts into `REPLY` <checkout>'s mark on <ref> where it is <tip> or the old tip of a landing
# journaled on the way to <tip> – every landing it missed since on record – else nothing
_BROUGHT_UPTO () {
	# Args: <checkout> <ref> <tip> [<file>]
	local M
	local -a STEP_FROM STEP_TO
	_BROUGHT_READ "$1" "$2" "$4"
	M=$REPLY
	[ -n "$M" ] && [ "$M" != "$3" ] || return 0
	_LANDING_STEPS "$2" "$3" "$3"
	(( ${STEP_FROM[(Ie)$M]} )) || REPLY=""
	return 0
}

# Keeps <checkout>'s mark at or below <old> for a run that may leave it unbrought – one there
# already stays, else <old> is written held, the one tip the checkout is known to stand on, where a
# carry starts but the walk for a file's base goes on past, as before any mark
_BROUGHT_HOLD () {
	# Args: <checkout> <old> [<ref> <file>]
	local REF=$3
	[ -n "$REF" ] || REF=$(git -C "$1" symbolic-ref -q HEAD 2>/dev/null) || return 0
	_BROUGHT_UPTO "$1" "$REF" "$2" "$4"
	[ -n "$REPLY" ] || _BROUGHT_PUT "$1" "$2" "$REF" "$4" held
	return 0
}

# Moves <checkout>'s mark to <new> once a carry from <old> brought it along – where <old> is the
# mark or a landing's old tip before it, or no mark tells, never past landings a later <old> skipped
_BROUGHT_CARRIED () {
	# Args: <checkout> <old> <new>
	local REF M
	local -a STEP_FROM STEP_TO
	REF=$(git -C "$1" symbolic-ref -q HEAD 2>/dev/null) || return 0
	_BROUGHT_UPTO "$1" "$REF" "$3"
	M=$REPLY
	if [ -n "$M" ] && [ "$M" != "$2" ]; then
		_LANDING_STEPS "$REF" "$M" "$M"
		(( ${STEP_FROM[(Ie)$2]} )) || return 0
	fi
	_BROUGHT_PUT "$1" "$3"
}

# Brings <paths> in <checkout> from <old> to <new> in one two-tree merge – from <old> to <old> with
# just them taken from <new>, so git checks each file before writing anything and keeps the rest of
# the index as is – run on a copy of the index under its lock, each path checked there first to
# still hold the entry the sync read, <old>'s but where it read another, with no staging in its way:
# a peer's `git add` meanwhile would have the merge drop that staging, file and all
# • A path whose file is still as another base has it – an older tip's, or <old>'s where a re-sync
#   took its entry ahead – merges from that, its entry set to it first, its stat read off the file
# Returns 1 where git refused, its words in `REPLY`, and 2 where the index stayed locked
_SYNC_TWO_TREE () {
	# Args: <checkout> <old tip> <new tip> <path>... – reads the caller's `DIFF_O` and `DIFF_N`, its
	# `TT_EXP` and `TT_FROM` with a path's entry as read and its file's base where either isn't
	# <old>'s, its `WIDE` with each path whose `DIFF_O` is the mark's, and fills its `TT_MOVED` with
	# each path staged since, `TT_IN_WAY` with each one staging blocks (path -> the staged one), the
	# merge taking the rest
	local CO=$1 OLD=$2 NEW=$3 IDX TMP PRIV MID FROM OUT P E
	local -x GIT_LITERAL_PATHSPECS=1
	local -a TAKE ADDS BACK
	local -A IDX_ENT GOES IN_WAY
	shift 3
	REPLY="" TT_MOVED=() TT_IN_WAY=() FROM=$OLD
	IDX=$(git -C "$CO" rev-parse --path-format=absolute --git-path index 2>/dev/null)
	if [ -z "$IDX" ] || ! _LOCK_INDEX "$IDX"; then
		REPLY="the index is locked"
		return 2
	fi
	# Its own, as a stop meanwhile tells it
	_INDEX_LOCK_OWN=$IDX
	TMP="$IDX.git-edit.$$" PRIV=$(MKTEMP_FILE git-edit-sync-index)
	_TEMP_FILES+=("$TMP" "$PRIV")
	{
		# A copy that failed would leave the merge building an index of these paths alone
		if [ -e "$IDX" ] && ! cp -p "$IDX" "$TMP" 2>/dev/null; then
			REPLY="the index could not be copied"
			return 2
		fi
		_INDEX_ENTRIES "$CO" "$TMP" "$@"
		for P in "$@"; do
			if [ "${IDX_ENT[$P]}" != "${TT_EXP[$P]-${DIFF_O[$P]}}" ]; then
				TT_MOVED+=("$P")
				continue
			fi
			TAKE+=("$P")
			[ -n "${IDX_ENT[$P]}" ] || [ -z "${DIFF_N[$P]}" ] || ADDS+=("$P")
			# One the merge takes out goes alongside, never in the way – a file turned into a directory
			[ -n "${DIFF_N[$P]}" ] || GOES[$P]=1
		done
		(( ${#ADDS} )) && _ENTRIES_IN_THE_WAY "$CO" "$TMP" "${ADDS[@]}"
		if (( ${#IN_WAY} )); then
			TT_IN_WAY=("${(@kv)IN_WAY}")
			ADDS=("${(@k)IN_WAY}")
			TAKE=("${(@)TAKE:|ADDS}")
		fi
		(( ${#TAKE} )) || return 0
		for P in "${TAKE[@]}"; do
			[ "${IDX_ENT[$P]}" = "${TT_FROM[$P]-${DIFF_O[$P]}}" ] || BACK+=("$P")
		done
		if (( ${#BACK} )); then
			{ for P in "${BACK[@]}"; do E=${TT_FROM[$P]}; printf '%s %s\t%s\0' "${E% *}" "${E#* }" "$P"; done; :; } | \
				GIT_INDEX_FILE=$TMP git -C "$CO" update-index -z --index-info 2>/dev/null || { REPLY="the index could not be written"; return 1; }
			GIT_INDEX_FILE=$TMP git -C "$CO" update-index -q --refresh >/dev/null 2>&1
		fi
		rm -f "$PRIV"
		# The tree each path merges from – <old>'s, but where a file's base is another, or a missed
		# landing's path sits on the mark
		if GIT_INDEX_FILE=$PRIV git read-tree "$OLD" 2>/dev/null && \
		   { (( ! (${#TT_FROM} + ${#WIDE}) )) || {
		       { for P in "${TAKE[@]}"; do
		           { (( ${+TT_FROM[$P]} )) && [ "${TT_FROM[$P]}" != "${DIFF_O[$P]}" ]; } || (( ${+WIDE[$P]} )) || continue
		           E=${TT_FROM[$P]-${DIFF_O[$P]}}
		           if [ -n "$E" ]; then printf '%s %s\t%s\0' "${E% *}" "${E#* }" "$P"; else printf '0 %s\t%s\0' "${(l:${#OLD}::0:)}" "$P"; fi
		         done; :; } | GIT_INDEX_FILE=$PRIV git update-index -z --index-info 2>/dev/null && \
		       FROM=$(GIT_INDEX_FILE=$PRIV git write-tree 2>/dev/null); }; } && \
		   { for P in "${TAKE[@]}"; do
		       if [ -n "${DIFF_N[$P]}" ]; then printf '%s %s\t%s\0' "${DIFF_N[$P]% *}" "${DIFF_N[$P]#* }" "$P"
		       else printf '0 %s\t%s\0' "${(l:${#OLD}::0:)}" "$P"
		       fi
		     done
		     # Whatever the last path was – `pipefail` reads this block's own status
		     :
		   } | GIT_INDEX_FILE=$PRIV git update-index -z --index-info 2>/dev/null && \
		   MID=$(GIT_INDEX_FILE=$PRIV git write-tree 2>/dev/null) && \
		   OUT=$(GIT_INDEX_FILE=$TMP git -C "$CO" read-tree -m -u "$FROM" "$MID" 2>&1) && \
		   mv -f "$TMP" "$IDX"; then
			return 0
		fi
		REPLY=${${${OUT%%$'\n'*}##(error|fatal): }:-the two-tree merge failed}
		return 1
	} always {
		rm -f "$TMP" "$PRIV" "$IDX.lock"
		_INDEX_LOCK_OWN=""
	}
}

# Waits ~5 s for <checkout>'s index lock to go – a peer's `git add`, or a `git status` refreshing it
_WAIT_INDEX_UNLOCKED () {
	# Args: <checkout>
	local LOCK=$(git -C "$1" rev-parse --path-format=absolute --git-path index.lock 2>/dev/null)
	local -i W=0
	while [ -n "$LOCK" ] && [ -e "$LOCK" ] && (( ++W <= 50 )); do sleep 0.1; done
	return 0
}

# Queues <path>'s index entry to become "<mode> <blob>", or to go where that is empty, for
# `_SYNC_WRITE_ENTRIES` – <list> taking <item> once it is written
_SYNC_QUEUE () {
	# Args: <path> <entry> [<list> <item>] – appends to the caller's `Q_PATH`, `Q_NEW` and `Q_ON`
	Q_PATH+=("$1")
	Q_NEW+=("$2")
	Q_ON+=("${3:+$3:$4}")
}

# Writes the queued index entries where each still holds what the sync read – checked and written
# under git's own index lock in one step, as `_RESET_IF_STAGED_AS` does, so a peer staging one
# meanwhile keeps it, as does staging an entry would replace
_SYNC_WRITE_ENTRIES () {
	# Args: <checkout> <null object id> – reads the caller's `Q_PATH`, `Q_NEW` and `READ_ENT`, and
	# fills its `Q_OUT` with `done`, `kept`, `in-way` or `locked` for each, and `Q_BY` with the staged
	# path in an `in-way` one's way
	local CO=$1 NULL=$2 IDX TMP
	local -i K
	local -a WRITE ADDS
	Q_OUT=() Q_BY=()
	(( ${#Q_PATH} )) || return 0
	IDX=$(git -C "$CO" rev-parse --path-format=absolute --git-path index 2>/dev/null)
	if [ -z "$IDX" ] || ! _LOCK_INDEX "$IDX"; then
		Q_OUT=("${(@)Q_PATH/*/locked}")
		return 0
	fi
	TMP="$IDX.git-edit.$$"
	_TEMP_FILES+=("$TMP")
	{
		# A copy that failed would leave the writes building an index of these paths alone
		if [ -e "$IDX" ] && ! cp -p "$IDX" "$TMP" 2>/dev/null; then
			Q_OUT=("${(@)Q_PATH/*/locked}")
			return 0
		fi
		local -A IDX_ENT GOES IN_WAY
		_INDEX_ENTRIES "$CO" "$TMP" "${Q_PATH[@]}"
		for (( K = 1; K <= ${#Q_PATH}; K++ )); do
			if [ "${IDX_ENT[${Q_PATH[K]}]}" != "${READ_ENT[${Q_PATH[K]}]}" ]; then
				Q_OUT[K]=kept
				continue
			fi
			Q_OUT[K]=done
			if [ -z "${Q_NEW[K]}" ]; then
				GOES[${Q_PATH[K]}]=1
			elif [ -z "${IDX_ENT[${Q_PATH[K]}]}" ]; then
				ADDS+=("${Q_PATH[K]}")
			fi
		done
		# `--index-info` drops whatever an entry it adds clashes with – staged under it, or at a
		# directory it lies in – so such an entry stays out, the staging kept
		(( ${#ADDS} )) && _ENTRIES_IN_THE_WAY "$CO" "$TMP" "${ADDS[@]}"
		for (( K = 1; K <= ${#Q_PATH}; K++ )); do
			[ "${Q_OUT[K]}" = done ] || continue
			if (( ${+IN_WAY[${Q_PATH[K]}]} )); then
				Q_OUT[K]=in-way
				Q_BY[K]=${IN_WAY[${Q_PATH[K]}]}
			elif [ -n "${Q_NEW[K]}" ]; then
				WRITE+=("${Q_NEW[K]}"$'\t'"${Q_PATH[K]}")
			else
				WRITE+=("0 $NULL"$'\t'"${Q_PATH[K]}")
			fi
		done
		# An entry written so carries no stat of its file, which reads as not up to date till something
		# refreshes it – a `sparse-checkout` then keeps a file it would take out – so it is refreshed in
		# that same step
		if (( ${#WRITE} )) && ! { print -rN -- "${WRITE[@]}" | GIT_INDEX_FILE=$TMP git -C "$CO" update-index -z --index-info 2>/dev/null && \
		                           { GIT_INDEX_FILE=$TMP git -C "$CO" update-index -q --refresh >/dev/null 2>&1; true; } && \
		                           mv -f "$TMP" "$IDX"; }; then
			Q_OUT=("${(@)Q_OUT/done/locked}")
		fi
	} always {
		rm -f "$TMP" "$IDX.lock"
	}
}

# Names the submodules a rewrite moved whose checkouts are where they were, with the command that
# brings them along – git updates the pointer, never the submodule's own checkout
_PRINT_SUBMODULES_MOVED () {
	# Args: <checkout> <path>...
	local CO=$1
	shift
	(( $# )) || return 0
	_AT_TOP "$CO"
	PRINT_TEXT "Submodules the $NOUN moved, still checked out as before: %s – bring them along with %s" 33 "$(_SOME_PATHS "$@")" "${REPLY}$(_PATHS_CMD "git submodule update" "$@")"
}

# Puts into `REPLY` the steps, run at <checkout>'s top, that move each <path> back to <old name>
# ahead of a carry – one from a tip that predates a rename takes the edits from the old name alone
_MOVE_BACK_CMD () {
	# Args: <checkout> (<path> <old name>)...
	local CO=$1
	local -i I
	shift
	REPLY=""
	for (( I = 1; I < $#; I += 2 )); do
		# Checked again as it runs – a file put there since the step was printed stops it, kept
		REPLY+="[ ! -e $(_SHQ "${@[I + 1]}") ] && [ ! -L $(_SHQ "${@[I + 1]}") ] && "
		[ "${@[I + 1]:h}" = . ] || [ -d "$CO/${@[I + 1]:h}" ] || REPLY+="mkdir -p -- $(_SHQ "${@[I + 1]:h}") && "
		REPLY+="mv -- $(_SHQ "${@[I]}") $(_SHQ "${@[I + 1]}") && "
	done
}

# Tells whether a fold of what is staged can unstage <path> ahead of a move back – a restore misses
# one outside a sparse checkout or clears its skip-worktree flag, any path where git can't ask
_MOVE_BACK_STAGED_OK () {
	# Args: <checkout> <path>
	[ "$_WHOLE_WHAT" = "Folded as staged" ] || return 0
	local -a FLAG_AU FLAG_SW
	_INDEX_FLAGS "$1" "" "$2"
	(( ! ${#FLAG_SW} )) && _SPARSE_OUT "$1" "$2" && (( ! ${#reply} ))
}

# Tells whether a file can move back to <old name> in <checkout> – nothing there or in the way, no
# link above it, nor at <tip>, whose own file there the carry would merge the edits onto
_NAME_FREE () {
	# Args: <checkout> <tip> <old name>
	local D=$3
	[ ! -e "$1/$3" ] && [ ! -L "$1/$3" ] && ! git -C "$1" cat-file -e "$2:$3" 2>/dev/null || return 1
	while D=${D:h}; [ "$D" != . ]; do
		[ -L "$1/$D" ] && return 1
		[ -d "$1/$D" ] && return 0
		[ -e "$1/$D" ] && return 1
	done
	return 0
}

# Puts into `REPLY` the tip a carry of <path>s past <old> starts from – the old tip of the earliest
# journaled landing of the last 7 days, in a run to <old> unbroken but by undos, that one of those
# files lacks while <old> still holds it, else <old> – as a carry from a later one takes it back
# Into `reply` each <path> a later landing renamed into place, moved there by hand, and its old name
_CARRY_BASE () {
	# Args: <checkout> <old> <path>...
	local CO=$1 OLD=$2 AT=$2 JF=$(_JOURNAL_FILE_PATH) REF LINE P N B A T HIT _MERGE_FILE_IDS="" RENAMES MARK LAST=""
	local -i NOW=$(date +%s) I K
	local -a J PATHS NAMES RF BACK
	shift 2
	REPLY=$OLD reply=()
	REF=$(git -C "$CO" symbolic-ref -q HEAD) && [ -n "$JF" ] && [ -s "$JF" ] || return 0
	# Down to the landing from the checkout's mark, below which every landing was brought – one a sync
	# or carry made
	_BROUGHT_READ "$CO" "$REF"
	MARK=$REPLY REPLY=$OLD
	(( ${#reply} )) && MARK=""
	reply=()
	[ "$MARK" = "$OLD" ] && return 0
	# Each path under its name at the step walked, followed back through a landing's rename into
	# it – a case-only one too – so a landing on its old name counts
	PATHS=("$@") NAMES=("$@")
	# Newest first, each landing found by its new tip being where the next one started
	for LINE in "${(@Oaf)$(<"$JF")}"; do
		[ -n "$LAST" ] && break
		J=(${=${LINE%%$'\t'*}})
		[[ "${J[1]}" == <1-9999999999> ]] && (( J[1] >= NOW - 604800 )) && [ "${J[2]}" = "$REF" ] && [ "${J[4]}" = "$AT" ] && [ -n "${J[3]}" ] || continue
		# An undo puts back an earlier tip, the line of the run it took back gone from the journal – the
		# walk goes on from that tip to the landing that made it
		[ "${J[5]}" = undo ] || AT=${J[3]}
		[ -n "$MARK" ] && [ "${J[5]}" != undo ] && [ "$AT" = "$MARK" ] && LAST=1
		RENAMES="" HIT=""
		for (( K = 1; K <= ${#PATHS}; K++ )); do
			P=${PATHS[K]} N=${NAMES[K]}
			[ -n "$P" ] && A=$(git rev-parse -q --verify "${J[4]}:$N" 2>/dev/null) || continue
			if ! B=$(git rev-parse -q --verify "${J[3]}:$N" 2>/dev/null); then
				# One diff a step, read only where a path is missing from its old tip
				[ -n "$RENAMES" ] || RENAMES=x$(git diff -z -M --name-status --diff-filter=R "${J[3]}" "${J[4]}" 2>/dev/null)
				RF=("${(@0)RENAMES#x}") N=""
				for (( I = 1; I + 2 <= ${#RF}; I += 3 )); do
					[ "${RF[I + 2]}" = "${NAMES[K]}" ] && N=${RF[I + 1]} && break
				done
				[ "${J[5]}" = undo ] || NAMES[K]=${N:-${NAMES[K]}}
				[ -n "$N" ] && B=$(git rev-parse -q --verify "${J[3]}:$N" 2>/dev/null) || continue
			fi
			[ -z "$HIT" ] && T=$(git rev-parse -q --verify "$OLD:$P" 2>/dev/null) && [ "$B" != "$A" ] || continue
			[ -f "$CO/$P" ] && [ ! -L "$CO/$P" ] && [ "$(_MERGE_LANDING "$T" "$B" "$A")" = "$T" ] && \
				_EDITS_LACK_REWRITE "$CO/$P" "$B" "$A" || continue
			# An old name held by something else, here or at the tip, takes no move back – a carry from
			# there leaves the file as it is, so it's left to the guard's merge into the new name
			if [ "$N" != "$P" ] && ! [ "$CO/$N" -ef "$CO/$P" ] && ! _NAME_FREE "$CO" "$REF" "$N"; then
				PATHS[K]=""
				continue
			fi
			REPLY=${J[3]} HIT=1
		done
		# The names the carry reads at that tip – one with no file of its own, not one a filesystem
		# ignoring case reads as the new name's, taken back to it first
		[ -n "$HIT" ] || continue
		BACK=()
		for (( K = 1; K <= ${#PATHS}; K++ )); do
			[ -n "${PATHS[K]}" ] && [ "${NAMES[K]}" != "${PATHS[K]}" ] && _NAME_FREE "$CO" "$REF" "${NAMES[K]}" && \
				BACK+=("${PATHS[K]}" "${NAMES[K]}")
		done
	done
	reply=("${BACK[@]}")
	return 0
}

# Adds to what the run leaves to do the carry that brings <checkout> along from <old> – a bare one
# where its mark is at or below <old>, else from an earlier landing's old tip where one of <path>s
# predates that landing too, a file moved to its new name by hand going back first – run in that
# checkout where the caller stands in another
_CARRY_TODO () {
	# Args: <checkout> <old> <message, its last %s the command> [<arg>... --] [<path>...]
	local CO=$1 OLD=$2 MSG=$3 CMD HERE FROM REF
	local -a ARGS BACK
	shift 3
	while (( $# )) && [ "$1" != -- ]; do ARGS+=("$1"); shift; done
	(( $# )) && shift
	_CARRY_BASE "$CO" "$OLD" "$@"
	FROM=${REPLY:0:12}
	BACK=("${reply[@]}")
	if (( ${#BACK} )); then
		_AT_TOP "$CO"
		CMD=$REPLY
		_MOVE_BACK_CMD "$CO" "${BACK[@]}"
		CMD+="${REPLY}git edit --carry=$FROM"
	else
		# A bare carry from the checkout's mark at or below <old>, as it brings every landing missed
		# since – the next run's printed carry the same – else from that one tip
		if REF=$(git -C "$CO" symbolic-ref -q HEAD 2>/dev/null) && _BROUGHT_UPTO "$CO" "$REF" "$OLD" && [ -n "$REPLY" ]; then
			FROM=""
		fi
		_CARRY_CMD "$CO" "$FROM"
		CMD=$REPLY
	fi
	_TODO_ADD "$CMD" "$MSG" 33 "${ARGS[@]}" "$CMD"
	# Named – a second signal stopping the run has no carry of its own to name
	_SYNC_DONE=1
}

# Puts into `REPLY` the `git edit --carry=<old>` that brings <checkout> along – a bare one, from its
# mark, without <old> – run there where the caller stands in another checkout
_CARRY_CMD () {
	# Args: <checkout> [<old>]
	local HERE=$(cd "$_START_DIR" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null)
	if [ -n "$HERE" ] && [ "${HERE:A}" = "${1:A}" ]; then
		REPLY="git edit --carry${2:+=${2:0:12}}"
	else
		REPLY="git -C $(_SHQ "$1") edit --carry${2:+=${2:0:12}}"
	fi
}

# Adds the carry for each other checkout of <ref> – a branch checked out twice, by `git worktree add
# -f` – which the sync of <checkout> brings none of along, told off the git dirs alone
_OTHER_CHECKOUTS_TODO () {
	# Args: <checkout's git dir> <ref> <old tip>
	local GD=$1 REF=$2 OLD=$3 COMMON A H WT
	local -a OTHERS
	[[ "$REF" == refs/heads/* ]] || return 0
	COMMON=$GD
	[[ "$GD" == */worktrees/* ]] && COMMON=${GD%/worktrees/*}
	for A in "$COMMON" "$COMMON"/worktrees/*(N/); do
		[ "${A:A}" = "${GD:A}" ] && continue
		H="" WT=""
		# A reftable repository keeps each worktree's HEAD in its tables – asked there, one fork each
		if [ -d "$COMMON/reftable" ]; then
			H="ref: $(git --git-dir="$A" symbolic-ref -q HEAD 2>/dev/null)"
		else
			{ H=$(<"$A/HEAD") } 2>/dev/null
		fi
		[ "$H" = "ref: $REF" ] || continue
		# The main worktree's checkout is the one its git dir sits in, none where that is bare
		if [ "$A" = "$COMMON" ]; then
			[[ "$COMMON" == */.git ]] && WT=${COMMON%/.git}
		else
			{ WT=$(<"$A/gitdir") } 2>/dev/null
			WT=${WT%/.git}
		fi
		[ -n "$WT" ] && [ -d "$WT" ] && OTHERS+=("$WT")
	done
	for WT in "${OTHERS[@]}"; do
		_BROUGHT_HOLD "$WT" "$OLD"
		_CARRY_TODO "$WT" "$OLD" "The branch's other checkout, %s, stays as it was – bring it along with %s" "$WT" --
	done
}

# Brings the branch's checkout along after a tree-changing move – the sync, where it can run – else
# re-syncs the index entries the move stranded and names the paths whose files still hold the
# content before it, with the one carry that brings them along, never a restore, which run later
# would take a peer's edit made since
# An undo keeping what a commit, fold or `--exec` landed re-syncs the entries alone, its files
# holding that as uncommitted changes, as it may have come from the checkout
_RECONCILE_CHECKOUT () {
	# Args: <checkout> <old tip> <new tip> <stale headline> [<current headline>] [<unused>]
	#       [undo | keep – an undo's move, keep one leaving files]
	[ -n "$_IN_LANDED_STEP" ] || { _LANDED_STEP "$0" "$@"; return; }
	local CO=$1 OLD=$2 NEW=$3 STALE_HEADLINE=$4 CURRENT_HEADLINE=$5 P SRC NP
	local -a RESYNCED LEFT_ALONE LOCKED STALE MODIFIED MISSING REVERTING RENAMED GONE MODE_ONLY HOOKED SUBMODULES DIRS LINKED UNDER_FILE EDITED_OLD
	if [ "$7" != keep ] && _SYNCS_CHECKOUT "$CO"; then
		_SYNC_CHECKOUT "$CO" "$OLD" "$NEW"
		return 0
	fi
	# Every path here is a name, never a pattern – `[id].tsx` would match `i.tsx` beside it
	local -x GIT_LITERAL_PATHSPECS=1
	if [ "$7" = keep ]; then
		_RECONCILE_KEEP "$CO" "$OLD" "$NEW" "$STALE_HEADLINE"
		return 0
	fi
	# Not brought along – its mark stays at or below <old>, where the carry starts
	_BROUGHT_HOLD "$CO" "$OLD"
	# Commits only added on top rewrote nothing, so a landing takes nothing out of history
	local FORMER=pre-rewrite NOUN=rewrite
	_IS_ANCESTOR "$OLD" "$NEW" && FORMER=previous NOUN=landing
	# A rename leaves its new path missing from the checkout, which reads as stale there, while
	# edits on the old path sit untracked once the re-sync moved the entry – a restore of the new
	# path would strand them, so the two are named together instead
	local -A RENAMED_FROM RENAMED_TO
	local -i I
	local -a RENAME_FIELDS
	# NUL-separated, status, source and destination each – a quote, backslash or tab in a name
	# comes back C-quoted in the line form
	RENAME_FIELDS=(${(0)"$(git diff --ignore-submodules=dirty -z -M --name-status --diff-filter=R "$OLD" "$NEW" 2>/dev/null)"})
	for (( I = 1; I + 2 <= ${#RENAME_FIELDS[@]}; I += 3 )); do
		RENAMED_FROM[${RENAME_FIELDS[I + 2]}]=${RENAME_FIELDS[I + 1]}
		RENAMED_TO[${RENAME_FIELDS[I + 1]}]=${RENAME_FIELDS[I + 2]}
	done
	# Directories renamed, read before the re-sync moves an entry – the index tells a rename the
	# run brings from one the checkout made itself
	local -A DIR_RENAMED
	local -a DIR_PARTLY DIR_FROM DIR_TO DIR_TAKEN DIR_STAYS DIR_ALONG
	if (( ${#RENAMED_TO} )); then
		_DIR_RENAMES "$OLD" "$NEW"
		_DIR_INDEXED "$CO"
	fi
	_RESYNC_STRANDED_ENTRIES "$CO" "$OLD" "$NEW"
	if [ ${#RESYNCED[@]} -gt 0 ]; then
		PRINT_TEXT "Index entries re-synced to the new tip: %s" 32 "$(_SOME_PATHS -q "${RESYNCED[@]}")"
	fi
	if (( ${#RESET_SPARSE} )); then
		_AT_TOP "$CO"
		PRINT_TEXT "This git can't ask your sparse checkout's patterns (2.42 can) – the files the %s added, left out as outside it: %s – write those inside it with: %s" 33 "$NOUN" "$(_SOME_PATHS "${RESET_SPARSE[@]}")" "${REPLY}git sparse-checkout reapply"
	fi
	# The carry below re-syncs them, an entry still so alone
	(( ${#LOCKED} )) && PRINT_TEXT "Index locked – entries still on the $FORMER tip: %s" 33 "$(_SOME_PATHS -q "${LOCKED[@]}")"
	if [ ${#LEFT_ALONE[@]} -gt 0 ]; then
		PRINT_TEXT "Index entries left alone – they differ from the $FORMER tip (a peer's staging, or your own): %s" 33 "$(_ALL_PATHS -q "${LEFT_ALONE[@]}")"
	fi
	# Each side's entries, and where the checkout differs from the new tip – by content and mode, by
	# content alone – and from the old one, read once for the lot
	local -a DIFF_PATHS GONE_AT
	local -A DIFF_O DIFF_N VS_HEAD VS_CONTENT VS_OLD GONE_HASH
	_DIFF_ENTRIES "$OLD" "$NEW"
	for P in ${(0)"$(git -C "$CO" diff --ignore-submodules=dirty -z --name-only HEAD 2>/dev/null)"}; do VS_HEAD[$P]=1; done
	for P in ${(0)"$(git -C "$CO" -c core.fileMode=false diff --ignore-submodules=dirty -z --name-only HEAD 2>/dev/null)"}; do VS_CONTENT[$P]=1; done
	for P in ${(0)"$(git -C "$CO" diff --ignore-submodules=dirty -z --name-only "$OLD" 2>/dev/null)"}; do VS_OLD[$P]=1; done
	# A file read as modified only through its attributes – byte for byte a tip's blob, which `eol` or
	# `text` would store otherwise – holds that tip's content: the old one's stale, the new one's
	# current where its entry is too – hashed raw in one go, a name `--stdin-paths` misreads left out
	local -a RAW_AT RAW_SHA
	local -A IDX_ENT
	for P in "${(@k)VS_HEAD}"; do
		[ -n "${DIFF_O[$P]}${DIFF_N[$P]}" ] && [ -f "$CO/$P" ] && [ ! -L "$CO/$P" ] && [[ "$P" != (*$'\n'*|*$'\r'|\"*) ]] && RAW_AT+=("$P")
	done
	if (( ${#RAW_AT} )); then
		RAW_SHA=("${(@f)$(print -rl -- "${RAW_AT[@]}" | git -C "$CO" hash-object --no-filters --stdin-paths 2>/dev/null)}")
		_INDEX_ENTRIES "$CO" "" "${RAW_AT[@]}"
		local FILEMODE=$(git -C "$CO" config --type=bool --get core.fileMode 2>/dev/null)
		(( ${#RAW_SHA} == ${#RAW_AT} )) && for (( I = 1; I <= ${#RAW_AT}; I++ )); do
			P=${RAW_AT[I]}
			[ "${RAW_SHA[I]}" = "${DIFF_O[$P]#* }" ] && unset "VS_OLD[$P]"
			[ "${RAW_SHA[I]}" = "${DIFF_N[$P]#* }" ] && [ "${IDX_ENT[$P]}" = "${DIFF_N[$P]}" ] || continue
			unset "VS_CONTENT[$P]"
			# Still a mode change where git reads the bit and it differs
			[ "$FILEMODE" = false ] || [[ -x "$CO/$P" && "${DIFF_N[$P]% *}" == 100755 || ! -x "$CO/$P" && "${DIFF_N[$P]% *}" != 100755 ]] && \
				unset "VS_HEAD[$P]"
		done
	fi
	# A removed path's file, hashed as git stages it, in one go – a link by its target, and a name
	# `--stdin-paths` misreads, alone: one holding a newline, ending in a CR it strips (a macOS
	# `Icon\r`), or opening on a quote it unquotes
	for P in "${DIFF_PATHS[@]}"; do
		[ -z "${DIFF_N[$P]}" ] && [ -f "$CO/$P" ] && [ ! -L "$CO/$P" ] && [[ "$P" != (*$'\n'*|*$'\r'|\"*) ]] && GONE_AT+=("$P")
	done
	if (( ${#GONE_AT} )); then
		local -a GONE_SHA GONE_RAW
		GONE_SHA=("${(@f)$(print -rl -- "${GONE_AT[@]}" | git -C "$CO" hash-object --stdin-paths 2>/dev/null)}")
		# Byte for byte the old blob is as before too, read as modified only through its attributes
		GONE_RAW=("${(@f)$(print -rl -- "${GONE_AT[@]}" | git -C "$CO" hash-object --no-filters --stdin-paths 2>/dev/null)}")
		(( ${#GONE_SHA} == ${#GONE_AT} )) && for (( I = 1; I <= ${#GONE_AT}; I++ )); do
			GONE_HASH[${GONE_AT[I]}]=${GONE_SHA[I]}
			[ "${GONE_RAW[I]}" = "${DIFF_O[${GONE_AT[I]}]#* }" ] && GONE_HASH[${GONE_AT[I]}]=${GONE_RAW[I]}
		done
	fi
	# A case-only rename on a filesystem that ignores case leaves one file under both names – the
	# new name's, read against the old one's content, where a `clean` of the old name does nothing
	local -A ADDED_LOWER CASE_FROM CASE_TO
	for P in "${DIFF_PATHS[@]}"; do
		[ -z "${DIFF_O[$P]}" ] && [ -n "${DIFF_N[$P]}" ] && ADDED_LOWER[${(L)P}]=$P
	done
	if (( ${#ADDED_LOWER} )); then
		for P in "${DIFF_PATHS[@]}"; do
			SRC=${ADDED_LOWER[${(L)P}]}
			[ -n "${DIFF_O[$P]}" ] && [ -z "${DIFF_N[$P]}" ] && [ -n "$SRC" ] && [ "$SRC" != "$P" ] && \
				[ "$CO/$P" -ef "$CO/$SRC" ] && CASE_FROM[$SRC]=$P && CASE_TO[$P]=$SRC
		done
	fi
	# A path the rewrite removed lingers untracked once its entry is gone, so it takes a
	# `clean` where the others take a restore
	for P in "${DIFF_PATHS[@]}"; do
		# Under a symlink or a file of the caller's, not one the old tip had there, which a restore or a
		# clean would replace or reach through – nothing stands under a file, so only a path the
		# rewrite puts there is named
		if [[ "$P" == */* ]] && _LEADING_NON_DIR "$CO" "$P" && [ -z "${DIFF_O[$REPLY]}" ]; then
			if [ -L "$CO/$REPLY" ]; then
				LINKED+=("$P")
			elif [ -n "${DIFF_N[$P]}" ]; then
				UNDER_FILE+=("$P")
			fi
			continue
		fi
		if [ -n "${DIFF_N[$P]}" ]; then
			# A submodule's checkout is a repository of its own, which the rewrite moved the commit of
			if [ "${DIFF_N[$P]% *}" = 160000 ]; then
				[ "$(git -C "$CO/$P" rev-parse -q --verify HEAD 2>/dev/null)" = "${DIFF_N[$P]#* }" ] || SUBMODULES+=("$P")
				continue
			fi
			if (( ${+VS_HEAD[$P]} )); then
				# Only the pre-rewrite blob itself is stale content a restore reclaims – a
				# worktree matching neither tip carries edits on top, a peer's or your own,
				# and naming those for reconciling would prescribe discarding them
				# The new tip's content under another mode is neither: no edit, just a bit a
				# file moved into place lost, a chmod not committed, or one the rewrite made and
				# the checkout never got – told apart, since "uncommitted edits" on a file just
				# committed whole invites committing "the rest"
				SRC=${RENAMED_FROM[$P]}
				# A directory where the file goes holds what no restore of it may take, untracked files say
				if [ -d "$CO/$P" ] && [ ! -L "$CO/$P" ]; then
					DIRS+=("$P")
				elif (( ! ${+VS_CONTENT[$P]} )); then
					MODE_ONLY+=("$P")
				elif [ -n "${CASE_FROM[$P]}" ]; then
					if [ "$(_WORKTREE_HASH "$CO" "$P" 2>/dev/null)" = "${DIFF_O[${CASE_FROM[$P]}]#* }" ]; then
						STALE+=("$P")
					elif [ ! -L "$CO/$P" ] && _EDITS_LACK_REWRITE "$CO/$P" "${DIFF_O[${CASE_FROM[$P]}]#* }" "${DIFF_N[$P]#* }"; then
						REVERTING+=("$P")
					else
						MODIFIED+=("$P")
					fi
				elif [ -n "$SRC" ] && [ ! -e "$CO/$P" ] && [ ! -L "$CO/$P" ] && { [ -e "$CO/$SRC" ] || [ -L "$CO/$SRC" ]; } && \
				     [ "$(_WORKTREE_HASH "$CO" "$SRC" 2>/dev/null)" != "${DIFF_O[$SRC]#* }" ]; then
					_ONE_LINE "$P"; NP=$REPLY
					_ONE_LINE "$SRC"
					RENAMED+=("$REPLY → $NP")
					EDITED_OLD+=("$SRC")
				# A file `--commit` took whole, still as it was read – the commit's hooks changed it there,
				# where a fold's tip differs by what later commits replayed onto it
				elif [ ${#OPT_COMMIT} -gt 0 ] && [ -n "$WHOLE_TREE" ] && (( ${WHOLE_PATHS[(Ie)$P]} )) && \
				     [ "$(_WORKTREE_HASH "$CO" "$P" 2>/dev/null)" = "$(git rev-parse -q --verify "${WHOLE_TREE}:${P}" 2>/dev/null)" ]; then
					HOOKED+=("$P")
				elif (( ! ${+VS_OLD[$P]} )); then
					STALE+=("$P")
				# No edits there – deleted, or never moved in from the old path of an earlier rename
				elif [ ! -e "$CO/$P" ] && [ ! -L "$CO/$P" ]; then
					MISSING+=("$P")
				elif [ ! -L "$CO/$P" ] && [ -n "${DIFF_O[$P]}" ] && \
				     _EDITS_LACK_REWRITE "$CO/$P" "${DIFF_O[$P]#* }" "${DIFF_N[$P]#* }"; then
					REVERTING+=("$P")
				else
					MODIFIED+=("$P")
				fi
			fi
		elif [ -e "$CO/$P" ] && (( ! ${+CASE_TO[$P]} )); then
			# Same test for a path the rewrite removed, but the re-sync took its index entry
			# with it – the file is untracked now, so only its hash tells the blob the rewrite
			# left from work someone put there, and a `clean` on the latter leaves nothing
			if [ "${GONE_HASH[$P]:-$(_WORKTREE_HASH "$CO" "$P" 2>/dev/null)}" = "${DIFF_O[$P]#* }" ]; then
				GONE+=("$P")
			elif [ -z "${RENAMED_TO[$P]}" ] || [ -e "$CO/${RENAMED_TO[$P]}" ]; then
				MODIFIED+=("$P")
			# Its new path reads as no change where git keeps no file there – outside a sparse checkout
			elif (( ! ${+VS_HEAD[${RENAMED_TO[$P]}]} )) && [ ! -L "$CO/${RENAMED_TO[$P]}" ]; then
				_ONE_LINE "${RENAMED_TO[$P]}"; NP=$REPLY
				_ONE_LINE "$P"
				RENAMED+=("$REPLY → $NP")
				EDITED_OLD+=("$P")
			fi
		fi
	done
	# Untracked files left in a directory renamed whole are named with where `--carry` takes them
	if (( ${#DIR_RENAMED} + ${#DIR_PARTLY} )); then
		_DIR_UNTRACKED "$CO" "$OLD" "$NEW"
		for (( I = 1; I <= ${#DIR_FROM}; I++ )); do
			_ONE_LINE "${DIR_TO[I]}"; NP=$REPLY
			_ONE_LINE "${DIR_FROM[I]}"
			DIR_ALONG+=("$REPLY → $NP")
		done
	fi
	_PRINT_SUBMODULES_MOVED "$CO" "${SUBMODULES[@]}"
	if [ ${#MODIFIED[@]} -gt 0 ]; then
		PRINT_TEXT "Worktree files left alone – uncommitted edits there, not the $FORMER content (a peer's, or your own): %s" 33 "$(_ALL_PATHS -q "${MODIFIED[@]}")"
	fi
	if [ ${#MISSING[@]} -gt 0 ]; then
		PRINT_TEXT "Worktree files left alone, missing from the checkout – deleted there, or never moved in from the old path of an earlier landing's rename: %s" 33 "$(_ALL_PATHS -q "${MISSING[@]}")"
	fi
	if [ ${#DIRS[@]} -gt 0 ]; then
		PRINT_TEXT "Worktree directories left alone where the $NOUN put a file – a peer's, or your own: %s" 33 "$(_ALL_PATHS -q "${DIRS[@]}")"
	fi
	if [ ${#LINKED[@]} -gt 0 ]; then
		PRINT_TEXT "Worktree paths left alone under a symlink of yours, which git writes no file through: %s" 33 "$(_ALL_PATHS -q "${LINKED[@]}")"
	fi
	if [ ${#UNDER_FILE[@]} -gt 0 ]; then
		PRINT_TEXT "Worktree paths left alone where a file of yours stands in place of their directory – a peer's, or your own: %s" 33 "$(_ALL_PATHS -q "${UNDER_FILE[@]}")"
	fi
	if [ ${#HOOKED[@]} -gt 0 ]; then
		PRINT_TEXT "Worktree files still as the commit read them, which its hooks then changed: %s" 33 "$(_SOME_PATHS -q "${HOOKED[@]}")"
	fi
	if [ ${#REVERTING[@]} -gt 0 ]; then
		PRINT_TEXT "Worktree files left alone with uncommitted edits on the $FORMER content – committed whole, they take the $NOUN back there: %s" 33 "$(_SOME_PATHS -q "${REVERTING[@]}")"
	fi
	if [ ${#RENAMED[@]} -gt 0 ]; then
		PRINT_TEXT "Renamed by the $NOUN, with uncommitted edits left untracked at the old path and the new one missing: %s" 33 "$(_ALL_PATHS "${RENAMED[@]}")"
	fi
	(( ${#DIR_ALONG} )) && PRINT_TEXT "Untracked files left behind in a directory the $NOUN renamed whole: %s" 33 "$(_SOME_PATHS "${DIR_ALONG[@]}")"
	(( ${#DIR_TAKEN} )) && PRINT_TEXT "Left in a directory the $NOUN renamed whole, to move by hand: %s" 33 "$(_ALL_PATHS "${DIR_TAKEN[@]}")"
	(( ${#DIR_STAYS} )) && PRINT_TEXT "Untracked files left where they are, in a directory the $NOUN renamed only in part: %s" 33 "$(_ALL_PATHS "${DIR_STAYS[@]}")"
	_PRINT_MODE_ONLY "$CO" "$NEW" "${MODE_ONLY[@]}"
	# Halfway through a rebase, `HEAD` is no tip the files can be read against, so the carry is named
	if [ $(( ${#STALE[@]} + ${#GONE[@]} + ${#REVERTING[@]} + ${#RENAMED[@]} + ${#DIR_ALONG[@]} + ${#HOOKED[@]} + ${#LOCKED[@]} )) -eq 0 ] && \
	   [[ "$_SYNC_WHY" != *halfway* ]]; then
		# "Index re-synced" holds only where no entry was left alone or locked out, nor a file left out
		[ -n "$CURRENT_HEADLINE" ] && [ $(( ${#RESET_SPARSE[@]} + ${#MODIFIED[@]} + ${#MISSING[@]} + ${#DIRS[@]} + ${#LINKED[@]} + ${#UNDER_FILE[@]} + ${#MODE_ONLY[@]} + ${#LEFT_ALONE[@]} + ${#DIR_TAKEN[@]} + ${#DIR_STAYS[@]} )) -eq 0 ] && PRINT_TEXT "%s" 32 "$CURRENT_HEADLINE"
		_SYNC_DONE=1
		return 0
	fi
	if (( ${#STALE} + ${#GONE} )); then
		PRINT_TEXT "%s" 33 "$STALE_HEADLINE"
		# A name holding a newline one a line too, as `$'…'` spells it
		for P in "${STALE[@]}" "${GONE[@]}"; do
			if [[ "$P" == *$'\n'* ]]; then print -r -- "${(qqqq)P}"; else print -r -- "$P"; fi
		done | head -10 | _CARET_LINES | LC_ALL=C sed "/./!d;s/^/${_DIM}  /;s/\$/${_OFF}/"
		if [ $(( ${#STALE[@]} + ${#GONE[@]} )) -gt 10 ]; then
			PRINT_TEXT "  … and %s more" 90 "$(( ${#STALE[@]} + ${#GONE[@]} - 10 ))"
		fi
	fi
	# One carry brings it all along – stale files to what landed, edits merged onto it, what a drop
	# handed back taken out – checking each file and entry as it runs, where a restore printed now
	# and run later would take a peer's edit made since
	# Pinned to this move's old tip, which a later one would otherwise take the place of – or to an
	# earlier landing's, where an edited file predates that one too – a name respelt by case read
	# under the old spelling, which the earlier tips hold
	PRINT_TEXT "Your checkout was not brought along – %s." 33 "$_SYNC_WHY"
	local -a BASE_OF
	for P in "${REVERTING[@]}"; do BASE_OF+=("${CASE_FROM[$P]:-$P}"); done
	# Each file whose edits sit on the content before recorded so, its re-synced entry no longer
	# telling – an earlier record's base kept, else the old tip of the earliest landing it lacks
	if (( ${#REVERTING} )); then
		local -a CHANGED=("${REVERTING[@]}")
		local -A NOT_BROUGHT
		for P in "${REVERTING[@]}"; do
			_UNBROUGHT_BASE "$CO" "$P"
			[ -n "$REPLY" ] || _CARRY_BASE "$CO" "$OLD" "$P"
			NOT_BROUGHT[$P]=$REPLY
		done
		_UNBROUGHT_NOTE "$CO" "$OLD" "$NEW"
	fi
	if [[ "$_SYNC_WHY" == "it is checked out at"* ]]; then
		_CARRY_TODO "$CO" "$OLD" "Bring that checkout along – files to what landed, edits merged onto it: %s" -- "${BASE_OF[@]}" "${EDITED_OLD[@]}"
	else
		_CARRY_TODO "$CO" "$OLD" "Once that is done, bring your checkout along – files to what landed, edits merged onto it: %s" -- "${BASE_OF[@]}" "${EDITED_OLD[@]}"
	fi
}

# Names the checkout files at <new>'s content whose mode alone differs, both modes given, and offers
# the chmod matching the committed one – it discards no content, though a deliberate chmod not yet
# committed is undone by it all the same
_PRINT_MODE_ONLY () {
	# Args: <checkout> <new tip> <path>...
	local CO=$1 NEW=$2 P HERE THERE CHMOD=""
	local -x GIT_LITERAL_PATHSPECS=1
	local -a MODE_NOTES TO_X TO_NOX
	shift 2
	(( $# )) || return 0
	for P in "$@"; do
		# `--full-tree`, as `$P` is the repo's path and a pathspec would read it from the cwd
		THERE=$(git ls-tree --full-tree "$NEW" -- "$P" 2>/dev/null | awk '{print $1}')
		HERE=100644
		[ -x "$CO/$P" ] && HERE=100755
		_ONE_LINE "$P" -q
		MODE_NOTES+=("$REPLY ($HERE here, $THERE committed)")
		if [ "$THERE" = 100755 ]; then TO_X+=("$P"); else TO_NOX+=("$P"); fi
	done
	PRINT_TEXT "Worktree files at the new tip's content, only their mode differing – no edits there: %s" 33 "$(_SOME_PATHS "${MODE_NOTES[@]}")"
	(( ${#TO_X} )) && CHMOD=$(_PATHS_CMD --plain "chmod -- +x" "${TO_X[@]}")
	(( ${#TO_NOX} )) && CHMOD="${CHMOD:+$CHMOD && }$(_PATHS_CMD --plain "chmod -- -x" "${TO_NOX[@]}")"
	_AT_TOP "$CO"
	PRINT_TEXT "Match the committed mode: %s" 33 "$REPLY$CHMOD"
}

# Re-syncs the index entries an undo of a commit, fold or `--exec` stranded and names what that run
# landed, which stays in the checkout as uncommitted changes – it may have come from there
_RECONCILE_KEEP () {
	# Args: <checkout> <undone tip> <tip it went back to> <headline>
	local CO=$1 OLD=$2 NEW=$3 P REF
	local -a RESYNCED LEFT_ALONE LOCKED KEPT DIFF_PATHS
	local -A DIFF_O DIFF_N VS_HEAD
	# Its files stay as they are – no carry to name, a second signal stopping the run included – a
	# checkout brought to the undone tip now on <new>, what that run landed its edits
	_SYNC_DONE=1
	REF=$(git -C "$CO" symbolic-ref -q HEAD 2>/dev/null) && _BROUGHT_READ "$CO" "$REF" && [ "$REPLY" = "$OLD" ] && (( ! ${#reply} )) && \
		_BROUGHT_PUT "$CO" "$NEW"
	_RESYNC_STRANDED_ENTRIES "$CO" "$OLD" "$NEW"
	(( ${#RESYNCED} )) && PRINT_TEXT "Index entries re-synced to the new tip: %s" 32 "$(_SOME_PATHS -q "${RESYNCED[@]}")"
	(( ${#LEFT_ALONE} )) && PRINT_TEXT "Index entries left alone – they differ from the undone run's tip (a peer's staging, or your own): %s" 33 "$(_ALL_PATHS -q "${LEFT_ALONE[@]}")"
	# Held as the undone run staged them, its content committed as staged – reset only where each
	# still holds that, a peer's staging since stopping the step whole, named
	if (( ${#LOCKED} )); then
		_AT_TOP "$CO"
		PRINT_TEXT "Index locked – entries still as the undone run had them: %s – once it is free, re-sync them, which resets none where one holds other staging since, listing those: %s" 33 \
			"$(_SOME_PATHS -q "${LOCKED[@]}")" "$REPLY$(_PATHS_CMD "git diff-index --cached --exit-code --name-only ${OLD:0:12}" "${LOCKED[@]}") && $(_PATHS_CMD "git restore --staged" "${LOCKED[@]}")"
	fi
	_DIFF_ENTRIES "$OLD" "$NEW"
	for P in ${(0)"$(git -C "$CO" diff --no-ext-diff --no-textconv --ignore-submodules=dirty -z --name-only HEAD 2>/dev/null)"}; do VS_HEAD[$P]=1; done
	# One the tip lacks now differs untracked, which `diff` never lists
	for P in "${DIFF_PATHS[@]}"; do
		{ (( ${+VS_HEAD[$P]} )) || { [ -z "${DIFF_N[$P]}" ] && { [ -e "$CO/$P" ] || [ -L "$CO/$P" ]; }; }; } && KEPT+=("$P")
	done
	(( ${#KEPT} )) && PRINT_TEXT "%s %s" 33 "$4" "$(_SOME_PATHS "${KEPT[@]}")"
	return 0
}

# Brings the branch's checkout along after a worktree-isolated run moved it – or, where it can't,
# re-syncs the index entries the move stranded and names the carry that does the rest
_PRINT_REWRITE_APPLY_HINT () {
	# Args: <branch-name> [<old-head> <new-head>] [drop | squash | undo | undo-keep]
	[ -n "$_IN_LANDED_STEP" ] || { _LANDED_STEP "$0" "$@"; return; }
	local BRANCH="$1"
	local ACTION_NAME="$4"
	# Commits only added on top rewrote nothing – a `--commit`, or an `--exec` committing at the tip
	local MOVED=rewritten FORMER=pre-rewrite
	if [ -n "$2" ] && [ -n "$3" ] && _IS_ANCESTOR "$2" "$3"; then
		MOVED=advanced FORMER=previous
	fi
	# A pure history rewrite leaves the tip tree byte-identical, so the checkout already
	# matches and a stash/reset dance would cycle unrelated WIP for nothing
	if [ -n "$2" ] && [ -n "$3" ] && \
	   [ "$(git rev-parse "$2^{tree}" 2>/dev/null)" = "$(git rev-parse "$3^{tree}" 2>/dev/null)" ]; then
		PRINT_TEXT "Branch %s $MOVED – tip tree unchanged, your checkout is already current." 32 "$BRANCH"
		return
	fi
	# Reconcile only what the rewrite touched – a blanket `reset --hard` discards unrelated
	# WIP and a stash dance cycles a checkout parallel sessions share, both risking work the
	# rewrite took care not to touch – and both sides of a rename, which `--name-only` would
	# otherwise fold into its destination
	local -a CHANGED
	local DIFF
	if [ -n "$2" ] && [ -n "$3" ]; then
		# A gitlink by its commit, whatever `submodule.<name>.ignore` hides from a plain diff
		# A diff that failed lists nothing, which is no "nothing changed"
		if ! DIFF=$(git diff --ignore-submodules=dirty -z --name-only --no-renames "$2" "$3" 2>/dev/null); then
			PRINT_TEXT "Branch %s $MOVED – git could not list what changed, so your checkout was not reconciled: list it with %s, and re-sync each index entry still as the $FORMER tip has it with %s" 33 "$BRANCH" "git diff --name-only ${2:0:12} ${3:0:12}" "git restore --staged -- <path>"
			return 0
		fi
		CHANGED=(${(0)DIFF})
	fi
	if [ -n "${CHANGED[1]}" ]; then
		_RESYNC_OTHER_CHECKOUTS "refs/heads/$BRANCH" "$2" "$3"
		# Read again where a signal cut it short – read empty, the re-sync below would run in its place,
		# and the sync a re-run of this makes would find its entries taken
		_LANDED_OUT _BRANCH_CHECKOUT "refs/heads/$BRANCH"
		local CO=$REPLY
		if [ -z "$CO" ]; then
			PRINT_TEXT "Branch %s $MOVED – checked out nowhere, nothing to reconcile." 32 "$BRANCH"
			return
		fi
		# An undone commit, fold or `--exec` keeps what it landed, as that may have come from the
		# checkout – every other undone run takes the checkout back as it came
		if [ "$ACTION_NAME" = undo-keep ]; then
			_RECONCILE_CHECKOUT "$CO" "$2" "$3" \
				"Branch $BRANCH moved back – what the undone run landed stays in your checkout, as uncommitted changes:" "" "" keep
			return
		fi
		# The checkout comes along, a drop's content leaving it as the commit left the history
		if _SYNCS_CHECKOUT "$CO"; then
			PRINT_TEXT "Branch %s $MOVED." 32 "$BRANCH"
			_SYNC_CHECKOUT "$CO" "$2" "$3"
			return
		fi
		if [ "$ACTION_NAME" = undo ]; then
			_RECONCILE_CHECKOUT "$CO" "$2" "$3" \
				"Branch $BRANCH moved back – your checkout still holds what the undone run landed in:" "" "" undo
		elif [ "$ACTION_NAME" = drop ]; then
			_RECONCILE_CHECKOUT "$CO" "$2" "$3" \
				"Branch $BRANCH rewritten – the dropped content is still in your checkout, in:"
		else
			_RECONCILE_CHECKOUT "$CO" "$2" "$3" \
				"Branch $BRANCH $MOVED – your checkout still holds the $FORMER content of:" \
				"Branch $BRANCH $MOVED – index re-synced, your checkout is current."
		fi
	else
		PRINT_TEXT "Branch %s $MOVED – your checkout was left as it was." 32 "$BRANCH"
	fi
}

# Names the untracked files a staging sweep absorbs – an amend takes them as readily as edits, so a
# scratch file left there joins the commit and reads as a tool bug in the summary – name
# them up front so the amend stays deliberate, and ignored paths never reach here anyway
_PRINT_UNTRACKED_ABSORB () {
	# Args: [<worktree>]
	local WT=${1:-.}
	local -a UNTRACKED
	# NUL-separated, so a name holding a newline counts once and one ending in a CR shows it
	UNTRACKED=(${(0)"$(git -C "$WT" ls-files -z --others --exclude-standard 2>/dev/null)"})
	if [ ${#UNTRACKED} -eq 0 ]; then
		return 0
	fi
	PRINT_TEXT "Absorbing %s untracked file(s) that were not in the commit:" 33 "${#UNTRACKED[@]}"
	printf '%s\n' "${(@)UNTRACKED//$'\n'/^J}" | head -10 | _CARET_LINES | LC_ALL=C sed "/./!d;s/^/${_DIM}  /;s/\$/${_OFF}/"
	if [ ${#UNTRACKED[@]} -gt 10 ]; then
		PRINT_TEXT "  … and %s more" 90 "$(( ${#UNTRACKED[@]} - 10 ))"
	fi
}

# Sweeps orphaned temp worktrees – ours go with the operation that made them, so debris
# from a killed process or a deleted repo – sweep only the provable case, a `.git` pointer
# whose gitdir is gone, since anything still registered may be a resolution someone wants
_GC_ORPHANED_WORKTREES () {
	setopt local_options null_glob
	local BASE=${TMPDIR:-/tmp}
	local -a REMOVED
	local DIR
	for DIR in "${BASE%/}"/git-edit-*; do
		if [ ! -d "$DIR" ] || [ ! -f "$DIR/.git" ]; then
			continue
		fi
		if ! _WORKTREE_GITDIR "$DIR" || [ -e "$REPLY" ]; then
			continue
		fi
		# A dangling pointer can also mean the repo's volume is merely
		# unmounted, so only sweep what has sat untouched for a day – `-mtime +1`
		# truncates to whole days and would mean two, so `-mmin` carries the 24h
		if [ -z "$(find "$DIR" -maxdepth 0 -mmin +1440 2>/dev/null)" ]; then
			continue
		fi
		if rm -rf "$DIR" 2>/dev/null; then
			REMOVED+=("${DIR:t}")
		fi
	done
	if [ -n "${REMOVED[1]}" ]; then
		PRINT_TEXT "Swept %s orphaned temp worktree(s) – their repo is gone" 90 "${#REMOVED[@]}"
	fi
}

# Puts into `REPLY` the admin dir <worktree>'s `.git` pointer names, failing where it names none
# Read in-process, as `sed -n 's/^gitdir: //p'` would fork once per temp dir, over dozens
_WORKTREE_GITDIR () {
	# Args: <worktree>
	local -a POINTER
	REPLY=""
	{ POINTER=("${(@f)$(<"$1/.git")}") } 2>/dev/null
	POINTER=("${(@M)POINTER:#gitdir: *}")
	REPLY=${(F)POINTER#gitdir: }
	while [[ "$REPLY" == *$'\n' ]]; do REPLY=${REPLY%$'\n'}; done
	# A relative pointer (`worktree.useRelativePaths`) runs from the worktree, not from here
	[[ -z "$REPLY" || "$REPLY" == /* ]] || REPLY=$1/$REPLY
	[ -n "$REPLY" ]
}

# Leaves this run's mark, its pid and start time, in the admin dir of a worktree it made – what
# tells one a killed run left behind from one in use, as a stale lock is told
_MARK_WORKTREE_OWNER () {
	# Args: <worktree>
	_LOCK_MARK_SET
	_WORKTREE_GITDIR "$1" && { print -r -- "$_LOCK_MARK" > "$REPLY/git-edit-owner" } 2>/dev/null
	return 0
}

# Fills the caller's `GONE_WT` with the temp worktrees a killed run left registered – a run's own,
# no pause naming it, whose maker and any run holding it are gone – and `UNSURE_WT` with those
# no mark tells of, an older git-edit's or one a live run is making, or any beside a pause cut short
_ORPHANED_TEMP_WORKTREES () {
	local LINE WT SF N GD CUT=""
	local -a NAMED
	GONE_WT=() UNSURE_WT=()
	if SF=$(_STATE_FILE_PATH) && [ -f "$SF" ]; then
		NAMED=(${(f)"$(LC_ALL=C sed -n 's/^worktree=//p' "$SF" 2>/dev/null)"})
		(( ${#NAMED} )) || CUT=1
	fi
	for LINE in "${(@f)$(git worktree list --porcelain 2>/dev/null)}"; do
		[[ "$LINE" == "worktree "* ]] || continue
		WT=${LINE#worktree }
		# `MKTEMP_DIR`'s names – the main worktree's `.git`, a directory, names no admin dir
		[[ "${WT:t}" == git-edit-*.?????? ]] && [ -d "$WT" ] && _WORKTREE_GITDIR "$WT" || continue
		GD=$REPLY
		for N in "${NAMED[@]}"; do [ "$WT" -ef "$N" ] && continue 2; done
		if [ -n "$CUT" ] || [ ! -f "$GD/git-edit-owner" ]; then
			UNSURE_WT+=("$WT")
		elif _LOCK_STALE "$GD/git-edit-owner" && _LOCK_STALE "$GD/git-edit-run.lock"; then
			GONE_WT+=("$WT")
		fi
	done
}

# Sweeps the temp worktrees killed runs left registered, as the run starting holds none yet – only
# those whose maker is provably gone, made 10 min ago or more, an unmarked one left to `--status`
_GC_KILLED_RUN_WORKTREES () {
	local WT
	local -a GONE_WT UNSURE_WT SWEPT OLD
	_ORPHANED_TEMP_WORKTREES
	for WT in "${GONE_WT[@]}"; do
		_WORKTREE_GITDIR "$WT" && OLD=("$REPLY/git-edit-owner"(Nmm+9)) && (( ${#OLD} )) || continue
		git worktree remove --force "$WT" >/dev/null 2>&1 || continue
		rm -rf "$WT"
		SWEPT+=("$WT")
	done
	(( ${#SWEPT} )) && PRINT_TEXT "Swept %s temp worktree(s) a killed run left registered: %s" 90 "${#SWEPT}" "$(_SOME_PATHS "${SWEPT[@]}")"
	return 0
}

# Deletes the transient refs a run killed past its exit trap left, named by its pid – one whose
# process is gone, as a live one is still using its own
_GC_KILLED_RUN_REFS () {
	local R
	for R in ${(f)"$(git for-each-ref --format='%(refname)' 'refs/git-edit/replay-*' 2>/dev/null)"}; do
		kill -0 "${R##*-}" 2>/dev/null || git update-ref -d "$R" 2>/dev/null
	done
	return 0
}

# Names the temp worktrees no pause names, with the step removing each – those a killed run left
# behind, and those no mark tells of, removed only once no run is live in the repository
_NAME_ORPHANED_WORKTREES () {
	local WT CMD=""
	local -a GONE_WT UNSURE_WT
	_ORPHANED_TEMP_WORKTREES
	if (( ${#GONE_WT} )); then
		for WT in "${GONE_WT[@]}"; do CMD+="${CMD:+ && }git worktree remove --force $(_SHQ "$WT")"; done
		PRINT_TEXT "Temp worktrees a killed run left registered, which no pause names – a run sweeps them once 10 min old, or remove them now: %s" 33 "$CMD"
	fi
	if (( ${#UNSURE_WT} )); then
		CMD=""
		for WT in "${UNSURE_WT[@]}"; do CMD+="${CMD:+ && }git worktree remove --force $(_SHQ "$WT")"; done
		PRINT_TEXT "Temp worktrees no pause names, whose run nothing tells gone – an older git-edit's, or one still in flight – once no git-edit run is live in this repository, remove them with: %s" 33 "$CMD"
	fi
	return 0
}

# Refuses a git older than 2.31, the newest feature the script uses without a probe – below it
# some reads come back empty instead of failing (rerere scoping first, then `config --type` and
# `--exec`'s pushed guard), so the run would go on with them quietly off
_REQUIRE_GIT_VERSION () {
	local LINE=$(git --version 2>/dev/null)
	# Only a line that parses is judged (`2.50.1 (Apple Git-155)`, `2.39.5.windows.1`) – an
	# unfamiliar format says nothing about age
	[[ "$LINE" =~ '^git version ([0-9]+)\.([0-9]+)' ]] || return 0
	if (( match[1] < 2 || (match[1] == 2 && match[2] < 31) )); then
		PRINT_ERR "git 2.31 or later is required, found ${LINE#git version }"
		ECHO_E "\e[0;31m  Update git and re-run – below 2.31 some checks would read as off instead of failing.\e[0m" >&2
		exit 1
	fi
}

# Refuses where a commit the run validated is no longer in the tip it then read – a peer's rewrite
# landing between the two would have the run replay the old commits back
_REQUIRE_IN_TIP () {
	# Args: <tip> <commit>...
	local TIP=$1 C
	shift
	for C in "$@"; do
		[ -n "$C" ] || continue
		git merge-base --is-ancestor "$C" "$TIP" 2>/dev/null && continue
		PRINT_ERR "The branch moved while this run read it – ${C:0:7} is no longer in its history"
		ECHO_E "\e[0;31m  Nothing was applied – re-read the SHAs with 'git log' and run it again.\e[0m" >&2
		exit 1
	done
}

# Refuses a git dir, work tree or index named through the environment – a dotfiles alias's
# `--git-dir` – unless it names this directory's own, which it then drops – as every git a temp
# worktree runs would take it, and work on the caller's checkout
_REQUIRE_PLAIN_GIT_ENV () {
	# Set at all – an empty one breaks every git call as surely as a wrong one
	(( ${+GIT_DIR} + ${+GIT_WORK_TREE} + ${+GIT_INDEX_FILE} + ${+GIT_COMMON_DIR} + ${+GIT_OBJECT_DIRECTORY} + ${+GIT_ALTERNATE_OBJECT_DIRECTORIES} )) || return 0
	local -a WITH WITHOUT VARS=(GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES)
	local A
	# The common dir last, where refs live – another repository's moves none of the rest
	WITH=("$(git rev-parse --absolute-git-dir 2>/dev/null)" "$(git rev-parse --show-toplevel 2>/dev/null)" "$(git rev-parse --path-format=absolute --git-path index 2>/dev/null)" "$(git rev-parse --path-format=absolute --git-path objects 2>/dev/null)" "$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)")
	WITHOUT=("$(unset $VARS; git rev-parse --absolute-git-dir 2>/dev/null)" "$(unset $VARS; git rev-parse --show-toplevel 2>/dev/null)" "$(unset $VARS; git rev-parse --path-format=absolute --git-path index 2>/dev/null)" "$(unset $VARS; git rev-parse --path-format=absolute --git-path objects 2>/dev/null)" "$(unset $VARS; git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)")
	# Objects written elsewhere, or read from an alternate the repo lacks, would leave the branch
	# pointing at what it does not hold – one naming the repo's own store says nothing
	for A in ${(s.:.)GIT_ALTERNATE_OBJECT_DIRECTORIES}; do
		[ "${A:A}" = "${WITHOUT[4]:A}" ] || WITH[4]=$A
	done
	if [ -n "${WITH[1]}" ] && [ "${(j:|:)WITH}" = "${(j:|:)WITHOUT}" ]; then
		unset $VARS
		return 0
	fi
	# A work tree whose only repository `GIT_DIR` names, as a dotfiles setup's – nothing finds it
	# without, so the route is a `.git` file pointing there, which `--separate-git-dir` makes
	if [ -z "${WITHOUT[1]}" ] && [ -n "${WITH[1]}" ] && [ -n "${WITH[2]}" ] && \
	   (( ! ${+GIT_INDEX_FILE} && ! ${+GIT_COMMON_DIR} && ! ${+GIT_OBJECT_DIRECTORY} && ! ${+GIT_ALTERNATE_OBJECT_DIRECTORIES} )); then
		# Its top named only where `GIT_WORK_TREE` or `core.worktree` names it – else git takes the cwd
		# for it, which no listing proves, skip-worktree entries and a subdirectory mirroring the
		# tracked names passing alike – a `.git` file in a subdirectory would have every file deleted
		local TOP="" CMD
		if (( ${+GIT_WORK_TREE} )) || [ -n "$(git config --get core.worktree 2>/dev/null)" ]; then
			TOP=${WITH[2]:A}
		fi
		CMD="printf 'gitdir: %s\n' $(_SHQ "${WITH[1]}") > $(_SHQ "${TOP:-<top of the work tree>}/.git")"
		[ "$(git config --type=bool --get core.bare 2>/dev/null)" = true ] && \
			CMD="git --git-dir=$(_SHQ "${WITH[1]}") config core.bare false && $CMD"
		PRINT_ERR "GIT_DIR names this work tree's only repository – git edit's temp worktrees would take it too and work on this checkout, so nothing was done"
		if [ -n "$TOP" ]; then
			ECHO_E "\e[0;31m  Give the work tree a .git file pointing there, as git init --separate-git-dir does, then run git edit without GIT_DIR: $(_LIT "$CMD")\e[0m" >&2
		else
			ECHO_E "\e[0;31m  Give the work tree a .git file pointing there, at its top – the directory its tracked paths start from, which neither GIT_WORK_TREE nor core.worktree names, and the current directory need not be – as git init --separate-git-dir does, then run git edit without GIT_DIR: $(_LIT "$CMD")\e[0m" >&2
		fi
		exit 1
	fi
	PRINT_ERR "GIT_DIR, GIT_WORK_TREE, GIT_COMMON_DIR, GIT_INDEX_FILE or an object directory names another repository, work tree, index or object store than this directory's"
	ECHO_E "\e[0;31m  Run git edit from inside the checkout, without them – its temp worktrees would take them too.\e[0m" >&2
	exit 1
}

# Refuses a cwd in no repository, or one removed – a pause worktree its `--continue` cleared – where
# every git call fails alike, and each mode would answer as for an empty repository
_REQUIRE_REPOSITORY () {
	git rev-parse --git-dir >/dev/null 2>&1 && return 0
	# A shell started there has no path for it – zsh sets `PWD` to `.`
	if [[ "$PWD" != /* ]] || [ ! -d "$PWD" ] || [ ! "$PWD" -ef . ]; then
		PRINT_ERR "The current directory is gone – removed, as a pause worktree is once its run lands – so nothing was done"
		ECHO_E "\e[0;31m  cd into the repository's checkout, then run it again.\e[0m" >&2
	else
		PRINT_ERR "Not inside a git repository ($PWD) – nothing was done"
		ECHO_E "\e[0;31m  cd into the repository's checkout, then run it again.\e[0m" >&2
	fi
	exit 1
}

# Refuses every mutating mode while another operation is paused, the plumbing ones included –
# starting a second rewrite moves the branch under the paused one, whose CAS then refuses at
# apply time, which is safe but strands work that was resolvable a moment earlier
# The check `_AWAIT_PAUSE` makes alone waits – later ones may hold a lock, a wait blocking others
_REQUIRE_NO_INFLIGHT () {
	# Args: [--wait – waits out another caller's pause first, up to `WAIT_SECS`]
	local SB WAITED="" SF=$(_STATE_FILE_PATH)
	_PAUSE_IN_WAY || return 0
	if [ "$1" = --wait ]; then
		_WAIT_OUT_PAUSE && return 0
		WAITED=$REPLY
		_PAUSE_IN_WAY || return 0
	fi
	SB=$REPLY
	_PAUSE_OWNER "$SF"
	if [ -n "$WAITED" ]; then
		PRINT_ERR "Another git-edit operation is still in flight${SB:+ on $SB} after waiting ${WAITED}s, paused for its resolution${REPLY:+ – $REPLY} – nothing ran"
		ECHO_E "\e[0;31m  Wait longer with --wait=600 – run in the background, or in the foreground with a 10-minute call timeout ('git edit --status' shows the pause).\e[0m" >&2
		[ -n "$SB" ] && _RACE_LOST=("refs/heads/$SB" "$(_JOURNAL_FILE_PATH)")
		exit 1
	fi
	PRINT_ERR "Another git-edit operation is in flight${SB:+ on $SB}, paused for its resolution${REPLY:+ – $REPLY}"
	_ECHO_INFLIGHT_STEP "$SF"
	exit 1
}

# Prints the step a refusal over the pause <state file> holds names – another caller's left to that
# caller or waited for, as its continue and abort are not this one's, the caller's own or one naming
# nobody continued or aborted where it is the caller's – as is any to an unlabeled caller, which
# may take one up
_ECHO_INFLIGHT_STEP () {
	# Args: <state file> [<step offered beside, as "or name another path">]
	_PAUSE_WHOSE "$1"
	if [ "$REPLY" = other ] && [ -n "$_ACTOR_ID" ] && _PAUSE_OWNER "$1" && [ -n "$REPLY" ]; then
		ECHO_E "\e[0;31m  Leave it to that caller, or wait for it to clear: run this again with --wait=<secs>${2:+ – $2} ('git edit --status' shows it).\e[0m" >&2
	else
		ECHO_E "\e[0;31m  If it is yours, 'git edit --continue' or 'git edit --abort' it – if another session's, wait for it ('git edit --status' shows it)${2:+, $2}.\e[0m" >&2
	fi
}

# Tells whose the pause <state file> holds is into `REPLY`, as the wait reads it – `own`, `other`
# for another caller's, or `any` for one predating labels, which any caller may resume – one
# predating `actor_id` by its `actor` line, and one naming neither caller nor operation, cut short
# or still being written, another's to a labeled caller
_PAUSE_WHOSE () {
	# Args: <state file>
	local LINE=$(LC_ALL=C grep -a '^actor=' "$1" 2>/dev/null | tail -1) ID=$(LC_ALL=C grep -a '^actor_id=' "$1" 2>/dev/null | tail -1)
	REPLY=other
	if [ -z "$LINE" ]; then
		# An unlabeled caller's own, as its resume takes any
		if [ -z "$_ACTOR_ID" ]; then
			REPLY=own
		elif LC_ALL=C grep -aq '^operation=' "$1" 2>/dev/null; then
			REPLY=any
		fi
		return 0
	fi
	LINE=${LINE#actor=}
	if [ -n "$ID" ]; then
		LINE=${ID#actor_id=}
	elif [ "$LINE" = "$_ACTOR" ]; then
		LINE=$_ACTOR_ID
	fi
	[ "$LINE" = "$_ACTOR_ID" ] && REPLY=own
	return 0
}

# Tells whether a recorded pause is in this run's way, `REPLY` naming its branch
_PAUSE_IN_WAY () {
	REPLY=""
	_STATE_EXISTS || return 1
	local SF=$(_STATE_FILE_PATH)
	local SB=$(LC_ALL=C sed -n 's/^branch=//p' "$SF" 2>/dev/null | head -1) HERE=$(git symbolic-ref -q HEAD)
	SB=${SB#refs/heads/}
	REPLY=$SB
	# Neither mode pauses unplaced, so neither needs the slot – only a pause on its own branch is in
	# the way, whose landing it would strand
	if [ ${#OPT_COMMIT} -gt 0 -o ${#OPT_EXEC} -gt 0 ] && [ ${#OPT_AFTER} -eq 0 ] && [ ${#OPT_BEFORE} -eq 0 ] && \
	   [ -n "$SB" ] && [ -n "$HERE" ] && [ "$SB" != "${HERE#refs/heads/}" ]; then
		return 1
	fi
	return 0
}

# Waits up to `WAIT_SECS` for the pause in the way to clear, asking every 2 s, and tells whether it
# did – a pause taken meanwhile waited out alike, the caller's own or one predating labels never, as
# only a continue or abort ends those – `REPLY` holding the seconds waited where it ran out, empty
# where it never waited
_WAIT_OUT_PAUSE () {
	local SF=$(_STATE_FILE_PATH) SB ID WHAT AGE PLACED
	local -i T WAITED
	# Counted to the fraction, as a start floored to its second overshoots a short bound by nearly one
	local -F START=$EPOCHREALTIME LEFT
	local -F 2 NAP
	REPLY=""
	(( WAIT_SECS > 0 )) || return 1
	# Each nap a background `sleep` the run waits on, as a trapped signal cuts that wait short – one
	# reaches a foreground `sleep` or a `zselect` only once its time is up, and the trap ends the nap
	while _PAUSE_IN_WAY; do
		SB=$REPLY
		# Whose it is, as the resume guard reads it – one predating labels being anyone's to resume,
		# the caller's too – read off a file still there, as one gone meanwhile names nobody
		_PAUSE_WHOSE "$SF"
		if [ "$REPLY" != other ] && [ -f "$SF" ]; then
			_WAITING="" REPLY=""
			return 1
		fi
		# Announced before the bound is read, and counted from there, as reading the pause can take a
		# short one's whole second
		if [ -z "$_WAITING" ]; then
			_PAUSE_OWNER "$SF"
			_WAITING=${REPLY:-"another run's"}
			WHAT=$(LC_ALL=C sed -n 's/^action=//p' "$SF" 2>/dev/null | tail -1)
			[ -n "$WHAT" ] || WHAT=$(LC_ALL=C sed -n 's/^operation=//p' "$SF" 2>/dev/null | tail -1)
			ID=$(LC_ALL=C sed -n 's/^target=//p' "$SF" 2>/dev/null | tail -1)
			# A placement by what it placed, as `_PAUSE_NAME` names it – its anchor in that name
			PLACED=$(LC_ALL=C sed -n 's/^place_label=//p' "$SF" 2>/dev/null | tail -1)
			[ -n "$PLACED" ] && WHAT="${PLACED%% *} placed ${PLACED#* }" ID=""
			# Stood since the pause was written – its nonce's clock, else the file's
			T=$(LC_ALL=C sed -n 's/^nonce=[0-9]*\.\([0-9]*\).*/\1/p' "$SF" 2>/dev/null | tail -1)
			(( T > 1000000000 )) || T=$(zmodload -F zsh/stat b:zstat 2>/dev/null && zstat +mtime -- "$SF" 2>/dev/null)
			AGE=""
			(( T > 0 && EPOCHSECONDS >= T )) && AGE=$(_AGO $(( EPOCHSECONDS - T )))
			PRINT_TEXT "Waiting up to %s for %s paused %s to clear – re-checking every 2s, then running" 33 \
				"${WAIT_SECS}s" "$_WAITING" "${WHAT:-operation}${ID:+ ${ID:0:7}}${SB:+ on $SB}${AGE:+ (paused $AGE ago)}"
			START=$EPOCHREALTIME
		fi
		LEFT=$(( WAIT_SECS - (EPOCHREALTIME - START) ))
		if (( LEFT <= 0 )); then
			# The bound itself, which the last check's own moment overshoots
			_WAITING="" REPLY=$WAIT_SECS
			return 1
		fi
		NAP=$(( LEFT < 2 ? LEFT : 2 ))
		sleep $NAP &
		_NAP_PID=$!
		wait $_NAP_PID
		_NAP_PID=""
	done
	if [ -n "$_WAITING" ]; then
		WAITED=$(( EPOCHREALTIME - START + 0.5 ))
		(( WAITED > WAIT_SECS )) && WAITED=$WAIT_SECS
		PRINT_TEXT "The pause cleared after %s – running." 32 "${WAITED}s"
		_WAITING=""
		# The trailer's old head is the tip the run starts from, which the pause's landing moved
		SCRIPT_INITIAL_HEAD=$(git rev-parse HEAD 2>/dev/null)
	fi
	return 0
}

# Waits out another caller's pause in the run's way, its arguments checked and its commits pinned
# by SHA already, just before it takes a lock or worktree – where the tip moved meanwhile, <plan>
# runs again on those SHAs, the stale-SHA resolution mapping any a landing rewrote, as a name like
# `HEAD~1` may mean another commit by now
_AWAIT_PAUSE () {
	# Args: [<plan> <pinned arg>...]
	local FROM=$(git rev-parse -q --verify HEAD 2>/dev/null)
	_REQUIRE_NO_INFLIGHT --wait
	[ $# -gt 0 ] && [ "$(git rev-parse -q --verify HEAD 2>/dev/null)" != "$FROM" ] && "$@"
	return 0
}

# Prints <rev> with each commit it names as that commit's SHA – a range end by end, an open end as
# `HEAD`'s – and anything naming no commit as given, for the refusal that reads it
_PINNED_REV () {
	# Args: <rev>
	local S E
	[ -n "$1" ] || return 0
	if [[ "$1" == *".."* && "$1" != *"..."* ]]; then
		S=$(_PEEL_SHA "${${1%%..*}:-HEAD}" commit) || S=${1%%..*}
		E=$(_PEEL_SHA "${${1#*..}:-HEAD}" commit) || E=${1#*..}
		print -r -- "$S..$E"
	else
		_PEEL_SHA "$1" commit || print -r -- "$1"
	fi
}

# Names whose pause <state file> holds into `REPLY` – empty where it predates labels, the label as
# given where the file keeps it
_PAUSE_OWNER () {
	# Args: <state file>
	local LINE=$(LC_ALL=C grep -a '^actor=' "$1" 2>/dev/null | tail -1) ID=$(LC_ALL=C grep -a '^actor_id=' "$1" 2>/dev/null | tail -1)
	REPLY=
	[ -n "$LINE" ] || return 0
	LINE=${LINE#actor=}
	[ -n "$ID" ] && LINE=${ID#actor_id=}
	REPLY="${${LINE:+$LINE's}:-an unlabeled caller's}"
}

# Names the loaded pause into `REPLY` as its caller knows it – a placement by what its run placed,
# as it pauses as a reorder, the rest by action or operation
_PAUSE_NAME () {
	REPLY=${STATE_ACTION:-$STATE_OPERATION}
	[ -n "$STATE_PLACE_LABEL" ] && REPLY="${STATE_PLACE_LABEL%% *} placed ${STATE_PLACE_LABEL#* }"
	return 0
}

# Tells whether the loaded pause is not the labeled caller's to resume or cancel, `REPLY` naming
# why – `other` for another label's or an unlabeled run's, `cut` for a file naming neither its
# caller nor its operation – one cut short, as one from before labels were kept held both
_PAUSE_FOREIGN () {
	REPLY=""
	[ -n "$_ACTOR_ID" ] || return 1
	if [ -z "$STATE_ACTOR_SET" ] && [ -z "$STATE_OPERATION" ]; then
		REPLY=cut
	elif [ -n "$STATE_ACTOR_SET" ] && [ "$STATE_ACTOR_ID" != "$_ACTOR_ID" ]; then
		REPLY=other
	else
		return 1
	fi
}

# Refuses a pause or a landing where a parallel run's pause took the state slot while this one
# ran – that check came too late, so the same error, which drivers already wait out, and the exit
# trap removes a worktree the run made, as a pause records itself before anything is authored there
# The pause wins – landing past it would refuse its finished resolution at its CAS
_REFUSE_PEER_PAUSE () {
	# Args: [<ref this run moves> [<message typed in an editor> <command rerunning with it>]]
	local SF=$(_STATE_FILE_PATH) SB WHOSE
	SB=$(LC_ALL=C sed -n 's/^branch=//p' "$SF" 2>/dev/null | head -1)
	SB=${SB#refs/heads/}
	# The busy hint reads the branch this run lands on, never the pause's
	[[ "$1" == refs/heads/* ]] && _RACE_LOST=("$1" "$(_JOURNAL_FILE_PATH)")
	_UNWIND_KEPT_PATH
	_PAUSE_WHOSE "$SF"
	WHOSE=$REPLY
	_PAUSE_OWNER "$SF"
	# An undo never waits for a pause – the wording its own start check gives
	if [ ${#OPT_UNDO} -gt 0 ]; then
		PRINT_ERR "Another git-edit operation is in flight${SB:+ on $SB} (paused for resolution${REPLY:+ – $REPLY}) – it paused while this undo ran, so nothing was undone"
		ECHO_E "\e[0;31m  Wait for it to clear, then undo ('git edit --status' shows it).\e[0m" >&2
		exit 1
	fi
	PRINT_ERR "Another git-edit operation is in flight${SB:+ on $SB} (paused for resolution${REPLY:+ – $REPLY}) – it paused while this one ran, so nothing was applied"
	if [ "$WHOSE" = other ]; then
		ECHO_E "\e[0;31m  Its resolution lands only on the tip it read – rerun with --wait=600: it waits for that pause, then runs on the new tip ('git edit --status' shows it).\e[0m" >&2
	else
		ECHO_E "\e[0;31m  If it is yours, 'git edit --continue' or 'git edit --abort' it, then run this again – if another session's, rerun with --wait=600: it waits for that pause, then runs on the new tip ('git edit --status' shows it).\e[0m" >&2
	fi
	_KEEP_TYPED_MESSAGE "${2:-${_TYPED_KEEP[1]}}" "${3:-${_TYPED_KEEP[2]}}"
	exit 1
}

# Takes back the replay a first run left halfway in a `-C` path, as its refusal kept none of it – a
# temp worktree goes with the run, and a resume's path holds its pause
_UNWIND_KEPT_PATH () {
	[ -n "$_UNWIND_PATH" ] && [ -z "$_STATE_OWNED" ] || return 0
	git -C "$_UNWIND_PATH" rebase --abort >/dev/null 2>&1
	_UNWIND_PATH=""
}

# Tells whether a pause in the way of a landing on <ref> began since this run started – one on
# another branch is not, nor the pause this run took up or wrote, nor one standing as it started,
# which a run it was in the way of never got past
_PAUSE_BEGAN () {
	# Args: <ref>
	local SF=$(_STATE_FILE_PATH) KEYS SB
	[ -n "$SF" ] && [ -f "$SF" ] || return 1
	KEYS=$(_PAUSE_KEYS "$SF")
	[ -n "$KEYS" ] || return 1
	[ -n "$_STATE_OWNED" ] && [ "$KEYS" = "$_STATE_ID" ] && return 1
	[ "$KEYS" = "$_PAUSE_AT_START" ] && return 1
	SB=$(LC_ALL=C sed -n 's/^branch=//p' "$SF" 2>/dev/null | head -1)
	# A pause naming no branch, cut short or hand-made, is in every run's way
	[ -z "$SB" ] || [ "refs/heads/${SB#refs/heads/}" = "$1" ]
}

# Refuses a run that can no longer land, before it pauses, gates, resumes or lands – its branch
# moved off the tip it read, which its CAS would refuse, or another run's pause on that branch began
# since it started, whose resolution its landing would strand – a resolution or typed message kept
# A detached `HEAD` is left to the CAS, as a temp worktree's own would read in its place
_REQUIRE_CURRENT () {
	# Args: <ref> <tip the run read, empty for the pause alone> [<message typed in an editor>
	# <command rerunning with it>]
	local NOW
	if [ -n "$2" ] && [[ "$1" == refs/* ]]; then
		NOW=$(git rev-parse -q --verify "$1" 2>/dev/null)
		[ -n "$NOW" ] && [ "$NOW" != "$2" ] && _REFUSE_STALE "$1" "$2" "$NOW" "$3" "$4"
	fi
	_PAUSE_BEGAN "$1" && _REFUSE_PEER_PAUSE "$1" "$3" "$4"
	return 0
}

# Refuses a run whose branch moved from <tip read> to <now> since it read it, naming who moved
# it – where it resumes a pause, that pause and its resolution are kept for the abort and redo
_REFUSE_STALE () {
	# Args: <ref> <tip read> <now> [<message typed in an editor> <command rerunning with it>]
	_RACE_LOST=("$1" "$(_JOURNAL_FILE_PATH)")
	_MOVED_BY "$1"
	PRINT_ERR "Branch '${1#refs/heads/}' moved from ${2:0:7} to ${3:0:7} since this run read it${REPLY:+ – $REPLY} – nothing was applied"
	if [ -n "$_STATE_OWNED" ]; then
		_REQUIRE_OWN_PAUSE
		_CLEANUP_HOOK=""
		local WT=$(LC_ALL=C sed -n 's/^worktree=//p' "$_STATE_OWNED" 2>/dev/null | tail -1)
		# An edit's or a split's resume reads the branch again, so it rebuilds on the new tip
		if [[ "$STATE_OPERATION" == (edit|split) ]]; then
			PRINT_TEXT "Your work is intact in %s – %s again builds it on the new tip." 33 "$WT" "git edit --continue"
		else
			PRINT_TEXT "Your resolution is intact in %s" 33 "$WT"
			PRINT_TEXT "It was built on the old tip, so it can't apply – %s, then redo it against the new tip." 33 "git edit --abort"
		fi
	else
		_UNWIND_KEPT_PATH
		ECHO_E "\e[0;31m  Run it again on the new tip.\e[0m" >&2
	fi
	_KEEP_TYPED_MESSAGE "${4:-${_TYPED_KEEP[1]}}" "${5:-${_TYPED_KEEP[2]}}"
	exit 1
}

# Names what moved <ref> last into `REPLY`, from its reflog's newest entry – a git-edit run by its
# operation and label, anything else as a commit outside git-edit with its reflog message – empty
# where the ref keeps no reflog
_MOVED_BY () {
	# Args: <ref>
	local M=$(git reflog show -n 1 --format=%gs "$1" -- 2>/dev/null) TAG=""
	REPLY=""
	[ -n "$M" ] || return 0
	_CARET "${M%%$'\n'*}"
	M=$REPLY
	if [[ "$M" == "git edit: "* ]]; then
		M=${M#git edit: }
		if [[ "$M" == *" ["*"]" ]]; then
			TAG=${${M##* \[}%\]}
			M=${M% \[*}
		fi
		REPLY="git edit $M by ${${TAG:+[$TAG]}:-an unlabeled caller}"
		return 0
	fi
	(( ${#M} > 72 )) && M="${M[1,71]}…"
	if [[ "$M" == *": "* ]]; then
		REPLY="a commit outside git-edit (${M%%: *} '${M#*: }')"
	else
		REPLY="a commit outside git-edit ('$M')"
	fi
}

# Points a run that lost a race at the way many sessions share one history, where its branch is
# busy – other callers landed on <ref> 3 or more times in the last 10 minutes, as <journal>
# reads – so a lone caller never sees it, nor a `--commit`, which its fixup recipe already is
_PRINT_BUSY_HINT () {
	# Args: <ref> <journal>
	[ -n "$1" ] && [ -s "$2" ] && (( ! ${#OPT_COMMIT} )) || return 0
	local LINE BY
	local -a F
	local -i N=0 SINCE=$(( EPOCHSECONDS - 600 ))
	for LINE in "${(@f)$(tail -n 300 "$2" 2>/dev/null)}"; do
		F=(${=${LINE%%$'\t'*}})
		[[ "${F[1]}" == <1-9999999999> ]] && (( F[1] >= SINCE )) && [ "${F[2]}" = "$1" ] || continue
		BY=""
		[[ "$LINE" == *$'\t'* ]] && BY=${LINE#*$'\t'}
		[ "$BY" = "$_ACTOR_ID" ] || N+=1
	done
	(( N >= 3 )) || return 0
	ECHO_E "\e[0;33m  ${1#refs/heads/} is busy – other callers landed on it $N times in the last 10 minutes. Where many sessions fold into one history, land each fix at the tip as its own 'fixup! <target's subject>' commit, squashed in later one session at a time – 'Many sessions at once' in the README, or git-edit(1).\e[0m" >&2
}

# Refuses a branch that moved under a resolution – a parallel session landed a commit, so the
# rewrite cannot apply, but the resolution is finished and the worktree holds the only copy,
# so keep it and its state rather than letting the exit trap strand both
_REFUSE_MOVED_BRANCH () {
	# Args: <branch> <worktree> [<message typed in an editor> <command rerunning with it>]
	_CLEANUP_HOOK=""
	PRINT_ERR "Branch '$1' moved during resolution – refusing to overwrite"
	PRINT_TEXT "Your resolution is intact in %s" 33 "$2"
	PRINT_TEXT "It was built on the old tip, so it can't apply – %s, then redo it against the new tip." 33 "git edit --abort"
	_KEEP_TYPED_MESSAGE "$3" "$4"
	exit 1
}

# Refuses a plumbing rewrite whose ref moved under it, naming the move – what it built rests on the
# tip it read and lacks what landed since, so nothing of it is offered, only a rerun on the new tip
_REFUSE_MOVED_DURING () {
	# Args: <ref> <tip the run read> <name of the run> [<message typed in an editor> <command
	# rerunning with it>]
	local NOW=$(git rev-parse -q --verify "$1" 2>/dev/null) WHAT="Branch '${1#refs/heads/}'"
	[ "$1" = HEAD ] && WHAT=HEAD
	[[ "$1" == refs/* ]] && _RACE_LOST=("$1" "$(_JOURNAL_FILE_PATH)")
	if [ -n "$NOW" ] && [ "$NOW" != "$2" ]; then
		PRINT_ERR "$WHAT moved from ${2:0:7} to ${NOW:0:7} during the $3 – refusing to overwrite"
	else
		PRINT_ERR "$WHAT moved during the $3 – refusing to overwrite"
	fi
	ECHO_E "\e[0;31m  Nothing was applied – run the $3 again on its new tip.\e[0m" >&2
	_KEEP_TYPED_MESSAGE "$4" "$5"
	exit 1
}

# Keeps a message a person typed for a run refused after the editor closed, in a file in the
# repo's git dir no exit cleans up, and names the rerun taking it from there – a no-op without one
_KEEP_TYPED_MESSAGE () {
	# Args: <message> <command rerunning the run, its message left out>
	[ -n "$1" ] || return 0
	local KEPT
	KEPT=$(mktemp "$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)/git-edit-message.XXXXXX" 2>/dev/null) || return 0
	print -r -- "$1" > "$KEPT" || return 0
	PRINT_TEXT "The message you typed is kept in %s – reuse it: %s" 33 "$KEPT" "$2 --text - < $(_SHQ "$KEPT")"
}

# Saves a drop's or squash's pause – at a conflict, or where a gate refused the result –
# for `--continue` to resume in its worktree, a squash's `--text` beside it in a file
# of its own, as a state line can't hold a multi-line message
_SAVE_REBASE_STATE () {
	_SAVE_STATE "operation=rebase" "action=$ACTION" "worktree=$WORKTREE_DIR" "wt_ours=${WT_OURS:-0}" \
		"branch=refs/heads/$ORIG_BRANCH" "orig_head=$ORIG_HEAD" "target=$COMMIT" "targets=${(j: :)COMMITS}" \
		"squash_target=$TARGET" "message=${OPT_MESSAGE:+editor}" || exit 1
	[ -n "$TEXT_VALUE" ] && print -r -- "$TEXT_VALUE" > "$(_TEXT_MSG_PATH)"
	_CLEANUP_HOOK=""
}

# Puts into `REPLY` the command resuming a drop's or squash's rebase – the override carrying a
# squash's message lasts one rebase invocation, so each resume re-establishes it, aimed at the
# fold, since a resume commits the conflicted step too: `--text` from <file>, else `-m`'s editor
_REBASE_CONTINUE_CMD () {
	# Args: <--continue|--skip> [<file holding --text>] [real – `-m` asked for the editor]
	local SUBCMD=$1 FOLD_EDITOR PINS=""
	(( ${#_MSG_PIN} )) && PINS=${(j: :)${(q)_MSG_PIN[@]}}
	# A stand-in on every resume, as one commits the conflicted step too – the fold without a message
	# of its own keeps git's, its comments stripped
	if [ -n "$2" ] && [ -f "$2" ]; then
		FOLD_EDITOR=$(_FOLD_EDITOR_CMD "cp ${(qq)2}")
	elif [ "$3" = real ]; then
		_RESOLVE_REAL_EDITOR || exit 1
		FOLD_EDITOR=$(_FOLD_EDITOR_CMD "${(qq)_REAL_EDITOR}" "" strip tty)
		PINS+=" -c commit.status=false"
	else
		FOLD_EDITOR=$(_FOLD_EDITOR_CMD true "" strip)
	fi
	[ -n "$FOLD_EDITOR" ] || exit 1
	_TEMP_FILES+=("$FOLD_EDITOR")
	# Safe because the stand-in writes every replayed message back itself – `-m`'s comment character
	# pinned, where `auto` picked one, for the template git writes as for the stand-in's cleanup
	REPLY="GIT_SEQUENCE_EDITOR=true GIT_EDITOR=${(q)$(_SH_WORD "$FOLD_EDITOR")} git -c commit.cleanup=verbatim $PINS -c rerere.enabled=true -c rerere.autoUpdate=false -c rebase.updateRefs=false -c advice.mergeConflict=false -c advice.resolveConflict=false $_CAPTURE_PINS rebase $SUBCMD"
}

# Keeps a squash whose commits cancel each other out as one empty commit – skipping it would bring
# back the change one took away – with the message the squash would have taken: `--text`, `-m`'s
# editor on the one git combined, else the target's, as its fixups keep
_AMEND_EMPTY_FOLD () {
	# Args: [<file holding --text>] [real – `-m` asked for the editor]
	# Under the capture's pins, its pair recorded – a rewrite announced only once it lands
	local OLD=$(git rev-parse HEAD) RC FIXUP_MSG=$(git rev-parse --git-path rebase-merge/message-fixup)
	if [ -n "$1" ] && [ -f "$1" ]; then
		git -c commit.cleanup=verbatim "${_CAPTURE_PIN_ARGS[@]}" commit -q --amend --allow-empty -F "$1" </dev/null >/dev/null 2>&1
	elif [ "$2" = real ]; then
		_RESOLVE_REAL_EDITOR || return 1
		GIT_EDITOR=${(qq)_REAL_EDITOR} git "${_CAPTURE_PIN_ARGS[@]}" "${_MSG_PIN[@]}" commit -q --amend --allow-empty --edit -F "$(git rev-parse --git-path rebase-merge/message)" </dev/tty >/dev/tty
	elif [ -f "$FIXUP_MSG" ]; then
		# The target's own, as git holds it for the chain – past a first fixup, `HEAD` carries the
		# combination git writes, comments and all
		git -c commit.cleanup=verbatim "${_CAPTURE_PIN_ARGS[@]}" commit -q --amend --allow-empty -F "$FIXUP_MSG" </dev/null >/dev/null 2>&1
	else
		git -c commit.cleanup=verbatim "${_CAPTURE_PIN_ARGS[@]}" commit -q --amend --allow-empty --no-edit </dev/null >/dev/null 2>&1
	fi
	RC=$?
	(( RC == 0 )) && _CAPTURE_RECORD "$OLD" "$(git rev-parse HEAD)"
	return $RC
}

# Runs a drop's or squash's rebase command in its worktree, then whatever its stops need short of a
# resolution – a squash cancelling out is kept, empty – returning 0 once the rebase is done, 2 at a
# conflict and 1 where it stopped any other way, its output in `REBASE_OUT`
_REBASE_DRIVE () {
	# Args: <command, eval'd> [<file holding --text>] [real – `-m` asked for the editor]
	local CMD=$1 STATUS GITDIR OUTF=$(MKTEMP_FILE git-edit-rebase-out)
	local -i RENORM_N=0
	_TEMP_FILES+=("$OUTF")
	_RERERE_SCOPE_BEGIN
	while true; do
		# Pinned to C – the stops below are told apart by git's English wording, which homebrew git
		# localizes wherever the locale environment is empty – kept whole in a file for them, and
		# shown as it comes, a subject's control bytes inert
		( export LC_ALL=C; eval "$CMD" ) 2>&1 | tee "$OUTF" | _DROP_OWN_STEPS | _CARET_LINES --crlf >&2
		STATUS=${pipestatus[1]}
		REBASE_OUT=$(<"$OUTF")
		[ $STATUS -eq 0 ] && return 0
		GITDIR=$(git rev-parse --git-dir 2>/dev/null)
		[ -d "$GITDIR/rebase-merge" ] || [ -d "$GITDIR/rebase-apply" ] || return 1
		if [ -n "$(_UNMERGED_IN .)" ] || [[ "$REBASE_OUT" == *"CONFLICT ("* ]]; then
			return 2
		fi
		if (( ++RENORM_N <= 100 )) && _RENORM_STOPPED . "$REBASE_OUT"; then
			_REBASE_CONTINUE_CMD --continue "$2" "$3"
			CMD=$REPLY
			continue
		fi
		if [[ "$REBASE_OUT" == *"--allow-empty"* || "$REBASE_OUT" == *"No changes - did you forget to use"* ]] && \
		   [[ "$(tail -1 "$GITDIR/rebase-merge/done" 2>/dev/null)" == (fixup|squash|f|s)\ * ]]; then
			PRINT_TEXT "%s – the combined commit stays, empty." 33 "The squashed commits cancel each other out"
			_AMEND_EMPTY_FOLD "$2" "$3" || return 1
			_REBASE_CONTINUE_CMD --continue "$2" "$3"
			CMD=$REPLY
			continue
		fi
		return 1
	done
}

# Names how a rebase stopped where nothing was left to resolve – git's
# own first words, since no resume decides it
_REBASE_STOPPED () {
	local LINE
	# Except where git words a continue refused over unstaged changes as conflicts left to resolve
	if [[ "$REBASE_OUT" == *"mark them as resolved using git add"* ]]; then
		print -r -- "changes left unstaged refuse the continue"
		return 0
	fi
	for LINE in ${(f)REBASE_OUT}; do
		[[ "$LINE" == (error|fatal|hint):* ]] || continue
		print -r -- "${LINE#*: }"
		return 0
	done
	print -r -- "${REBASE_OUT##*$'\n'}"
}

# Runs a reorder's, placement's or fold's first rebase command, output in `REBASE_OUT`, returning
# 0 once done, 2 where it stopped at something to resolve, a conflict or a step it left empty, and
# 1 where it failed any other way, a hook's veto or a failed signature, which no pause can resolve
_REBASE_FIRST_RUN () {
	# Args: <command, eval'd>
	local OUTF=$(MKTEMP_FILE git-edit-rebase-out)
	_TEMP_FILES+=("$OUTF")
	# Pinned to C, as the stops are told apart by git's English wording
	_RENORM_RESUME_CMD
	_RENORM_EVAL . "$1" "$REPLY" >"$OUTF"
	local RC=$?
	REBASE_OUT=$(<"$OUTF")
	(( RC == 0 )) && return 0
	_REBASE_RESOLVABLE . "$REBASE_OUT" && return 2
	return 1
}

# Answers whether a rebase that failed in <worktree> stopped at something to
# resolve – a conflict, a step it left empty, or a continue refused over changes
# left unstaged – rather than on an error no pause can resolve
_REBASE_RESOLVABLE () {
	# Args: <worktree> <its output, in C>
	local GITDIR=$(git -C "$1" rev-parse --absolute-git-dir 2>/dev/null)
	[ -d "$GITDIR/rebase-merge" ] || [ -d "$GITDIR/rebase-apply" ] || return 1
	[ -n "$(_UNMERGED_IN "$1")" ] && return 0
	[[ "$2" == *"mark them as resolved using git add"* ]] && \
		[ -n "$(git -C "$1" diff-files --name-only --ignore-submodules 2>/dev/null)" ] && return 0
	[[ "$2" == *"CONFLICT ("* || "$2" == *"--allow-empty"* || "$2" == *"No changes - did you forget to use"* ]]
}

# Names what refused a resume – a conflict a later stop raised, or changes left unstaged, which git
# words as conflicts still to resolve – more to resolve only where a file still holds markers, and
# one holding none, which nothing stages for the caller, with the step staging it as it stands
_PRINT_RESUME_REFUSED () {
	# Args: <worktree> <the continue's output, in C>
	local F
	local -a LEFT ADD GONE
	local -x GIT_LITERAL_PATHSPECS=1
	for F in ${(0)"$(_UNMERGED_IN "$1")"}; do
		if [ -e "$1/$F" ] || [ -L "$1/$F" ]; then
			if _HAS_NEW_MARKERS "$1" "$F"; then LEFT+=("$F"); else ADD+=("$F"); fi
		else
			GONE+=("$F")
		fi
	done
	if (( ${#LEFT} + ${#ADD} + ${#GONE} == 0 )) && [[ "$2" == *"mark them as resolved using git add"* ]]; then
		PRINT_ERR "Changes left unstaged refuse the continue – stage or restore them, then 'git edit --continue'"
		return 0
	fi
	(( ${#LEFT} || ${#ADD} + ${#GONE} == 0 )) && PRINT_ERR "Conflict continues – resolve more files, then 'git edit --continue'"
	(( ${#ADD} + ${#GONE} )) || return 0
	local STEP="" WT=$(_SHQ "$1")
	(( ${#ADD} )) && STEP=$(_PATHS_CMD "git -C $WT add" "${ADD[@]}")
	(( ${#GONE} )) && STEP+="${STEP:+ && }$(_PATHS_CMD "git -C $WT rm --quiet" "${GONE[@]}")"
	F="Nothing tells a resolution of $(_SOME_PATHS "${ADD[@]}" "${GONE[@]}") – no conflict markers to go by, so they stay unstaged"
	if (( ${#LEFT} )); then PRINT_TEXT "%s" 33 "$F"; else PRINT_ERR "$F"; fi
	PRINT_TEXT "Once each holds what should land, stage it as it stands, then %s: %s" 33 "git edit --continue" "$STEP"
}

# Refuses a rebase that failed with nothing to resolve, its output in
# `REBASE_OUT`, in git's own words – a first run's exit takes its worktree,
# and the rebase in it, along, while a resume keeps its pause for another
_REFUSE_REBASE_FAILED () {
	# Args: <what to do once git's cause is fixed, or "resume">
	# A progress line's last state only, git's hints – the todo it rescheduled – left out
	local -a SAID=(${(f)"$(print -r -- "$REBASE_OUT" | _CARET_LINES --crlf | LC_ALL=C grep -v -e '^hint:' -e '^[[:space:]]*$')"})
	(( ${#SAID} )) || SAID=("exit code 1")
	local -i I=${SAID[(i)(error|fatal):*]}
	(( I > ${#SAID} )) && I=${#SAID}
	PRINT_ERR "git rebase failed without a conflict to resolve: ${SAID[I]#(error|fatal): }"
	# What else it said, a hook's own words say
	SAID[I]=()
	(( ${#SAID} )) && print -rl -- "${SAID[@]}" | tail -5 | LC_ALL=C sed "s/^/${_RED}  /;s/\$/${_OFF}/" >&2
	if [ "$1" = resume ]; then
		PRINT_TEXT "Nothing was applied – fix what git names, then %s, or abort the operation: %s" 33 "git edit --continue" "git edit --abort"
		_PAUSE_EXIT 1 retry
	fi
	ECHO_E "\e[0;31m  Nothing was applied and nothing paused – fix what git names, then $1\e[0m" >&2
	exit 1
}

# Pauses a drop or squash at a conflict, for the caller to resolve in its worktree
_REBASE_CONFLICT_PAUSE () {
	_SAVE_REBASE_STATE
	PRINT_ERR "Conflict during $ACTION – resolve in worktree, then 'git edit --continue'"
	PRINT_TEXT "Worktree: %s" 33 "$WORKTREE_DIR"
	local UNMERGED_LIST=$(_PRINT_CONFLICT_DETAIL "$WORKTREE_DIR")
	PRINT_TEXT "Or abort the operation: %s" 33 "git edit --abort"
	EMIT_CONFLICT "$WORKTREE_DIR" "$UNMERGED_LIST"
	_PAUSE_EXIT 2 conflict
}

# Runs a drop's or squash's own rebase from the start – a conflict pauses, and a rebase stopping
# any other way leaves the branch as it was, its worktree going with the run
_REBASE_FROM_START () {
	# Args: <sequence editor script> <file holding --text, or empty> <real, or empty – `-m` asked
	# for the editor> <rebase argument>...
	local SEQ=$1 TEXT_FILE=$2 EDITOR_MODE=$3
	shift 3
	local -a ARGS=("$@")
	# The fold's editor, where the squash brings a message of its own – a stand-in writing every
	# other step's message back, the editor itself on the terminal, as the run's output is captured
	local FOLD_EDITOR=true
	if [ -n "$TEXT_FILE" ]; then
		FOLD_EDITOR=$(_FOLD_EDITOR_CMD "cp ${(qq)TEXT_FILE}")
	elif [ "$EDITOR_MODE" = real ]; then
		_RESOLVE_REAL_EDITOR || exit 1
		FOLD_EDITOR=$(_FOLD_EDITOR_CMD "${(qq)_REAL_EDITOR}" "" strip tty)
	fi
	[ "$FOLD_EDITOR" != true ] && _TEMP_FILES+=("$FOLD_EDITOR")
	_REBASE_DRIVE "GIT_SEQUENCE_EDITOR=${(q)SEQ} GIT_EDITOR=${(q)$(_SH_WORD "$FOLD_EDITOR")} git ${ARGS[*]}" "$TEXT_FILE" "$EDITOR_MODE"
	case $? in
		0) return 0 ;;
		2) _REBASE_CONFLICT_PAUSE ;;
	esac
	PRINT_ERR "git rebase stopped without a conflict to resolve: $(_REBASE_STOPPED)"
	ECHO_E "\e[0;31m  Nothing was applied – the branch is as it was.\e[0m" >&2
	exit 1
}

# Builds the rebase every drop and squash starts with, from the parent of its oldest commit –
# `--empty=drop` so a commit the rewrite leaves empty goes, as one rebuilt any other way does, and
# full SHAs in the todo, as two commits can share the 7 hex its edits would otherwise match
_REBASE_ARGS () {
	# Args: <oldest commit> – fills `reply`
	reply=(-c rerere.enabled=true -c rerere.autoUpdate=false -c rebase.updateRefs=false -c advice.mergeConflict=false -c advice.resolveConflict=false -c rebase.instructionFormat= -c core.abbrev=no $_CAPTURE_PINS rebase $_CAPTURE_EXEC --no-autosquash --no-autostash --empty=drop --interactive)
	# Each message kept as written, `#` lines too, whatever cleanup the caller configured – the fold's
	# editor stand-in strips git's template itself
	reply=(-c commit.cleanup=verbatim "${reply[@]}")
	if git show -s --pretty=%P "$1" | grep -q .; then
		reply+=("$1~")
	else
		reply+=(--root)
	fi
}

# Drops `COMMITS` by a rebase from the oldest one's parent
GIT_REBASE_DROP () {
	_CAPTURE_BEGIN
	_REBASE_ARGS "$COMMIT"
	local -a CMD=("${reply[@]}")
	PRINT_CMD "git ${CMD[*]} # -> drop"
	local SED_SCRIPT="" C
	for C in "${COMMITS[@]}"; do
		SED_SCRIPT+=" -e 's/^pick $C/drop $C/'"
	done
	# `-i` with its suffix attached, the one in-place form BSD and GNU sed both read – the backup
	# goes with the rebase's state directory
	_REBASE_FROM_START "LC_ALL=C sed -i.git-edit$SED_SCRIPT" "" "" "${CMD[@]}"
}

# Squashes `COMMITS` into the oldest by a rebase – `squash` given a message or `-m`, else `fixup`
GIT_REBASE_SQUASH () {
	_CAPTURE_BEGIN
	# `squash` opens `GIT_EDITOR` on the combined message where `fixup` does not, so it is used
	# where the caller supplies one (`--text`) or wants to edit it (`-m`)
	local OP=fixup
	[[ -n "$TEXT_VALUE" || -n "$OPT_MESSAGE" ]] && OP=squash
	# Without a message in hand, the editor opens partway through – refused up front where none can
	[[ "$OP" == squash && -z "$TEXT_VALUE" ]] && _REQUIRE_TTY_FOR_EDITOR
	# The initial run opens an editor only for the fold, never for a clean pick, so `--text`'s own
	# `#` lines just need git's cleanup out of the way – with `-m` the editor shows git's template,
	# whose comments still have to go
	_REBASE_ARGS "${COMMITS[1]}"
	local -a CMD=("${reply[@]}")
	# `-m`'s editor comments and cleans up as `git commit` would over the squashed messages – its
	# help the stand-in's, git's own status left out
	if [[ "$OP" == squash && -z "$TEXT_VALUE" ]]; then
		_SQUASH_MSG_STYLE "${COMMITS[@]}" || exit 1
		CMD=(-c commit.status=false ${(q)_MSG_PIN[@]} "${CMD[@]}")
	fi
	PRINT_CMD "git ${CMD[*]} # -> reorder+$OP"
	local SED_SCRIPT="" APPEND="" C
	for C in "${COMMITS[@]}"; do
		[[ "$C" == "$TARGET" ]] && continue
		SED_SCRIPT+=" -e '/^pick $C/d'"
		APPEND+=$'\\\n'"$OP $C"
	done
	local TEXT_FILE=""
	if [ -n "$TEXT_VALUE" ]; then
		TEXT_FILE=$(MKTEMP_FILE git-edit-squash-msg)
		_TEMP_FILES+=("$TEXT_FILE")
		printf '%s\n' "$TEXT_VALUE" > "$TEXT_FILE"
	fi
	_REBASE_FROM_START "LC_ALL=C sed -i.git-edit$SED_SCRIPT -e '/^pick $TARGET/a$APPEND'" "$TEXT_FILE" "${OPT_MESSAGE:+real}" "${CMD[@]}"
}

# Puts into `REPLY` how many commits a drop or squash left empty and its rebase dropped, and into
# `reply` each as "<sha> <subject>" – the caller named the others, so only these go unasked
# • Matched by authorship and subject, which a rebase keeps as it changes every SHA – a subject
#   alone takes a twin left standing for the one dropped
# • Listed only where the count agrees, and with `--sure` only those sharing that with no other
#   commit of the span, where which twin went is no guess
# • Returns 1 where the rebase dropped none
_EMPTIED_COMMITS () {
	# Args: [--sure] <old tip> <new tip> <squash target or empty> <commit the caller named>...
	local SURE=""
	[ "$1" = --sure ] && { SURE=1; shift; }
	local OLD=$1 NEW=$2 TGT=$3 LINE KEY F=$'\x01'
	shift 3
	local MB=$(git merge-base "$OLD" "$NEW" 2>/dev/null)
	local -a BEFORE GONE
	local -A NAMED SURVIVING SHARED
	REPLY=0 reply=()
	for LINE in "$@"; do NAMED[$LINE]=1; done
	for LINE in ${(f)"$(git log --format="%H %an$F%ae$F%ad$F%s" --date=raw ${MB:+$MB..}$OLD 2>/dev/null)"}; do
		(( ${+NAMED[${LINE%% *}]} )) && continue
		BEFORE+=("$LINE")
		SHARED[k:${LINE#* }]=$(( ${SHARED[k:${LINE#* }]:-0} + 1 ))
	done
	local -i AFTER=$(git rev-list --count ${MB:+$MB..}$NEW 2>/dev/null)
	# The squash's target is the one named commit left standing
	[ -n "$TGT" ] && AFTER=$(( AFTER - 1 ))
	(( ${#BEFORE} > AFTER )) || return 1
	while IFS= read -r KEY; do
		SURVIVING[k:$KEY]=$(( ${SURVIVING[k:$KEY]:-0} + 1 ))
	done <<< "$(git log --format="%an$F%ae$F%ad$F%s" --date=raw ${MB:+$MB..}$NEW 2>/dev/null)"
	local -i N=0
	for LINE in "${BEFORE[@]}"; do
		KEY=${LINE#* }
		if (( ${SURVIVING[k:$KEY]:-0} > 0 )); then
			SURVIVING[k:$KEY]=$(( ${SURVIVING[k:$KEY]} - 1 ))
			continue
		fi
		N+=1
		[ -n "$SURE" ] && (( ${SHARED[k:$KEY]} > 1 )) && continue
		GONE+=("${LINE%% *} ${${${KEY#*$F}#*$F}#*$F}")
	done
	REPLY=$(( ${#BEFORE} - AFTER ))
	# A commit whose authorship and subject find no counterpart is not one
	(( N == REPLY )) && reply=("${GONE[@]}")
	return 0
}

# Names the commits a drop or squash left empty and its rebase dropped
_PRINT_EMPTIED () {
	# Args: <old tip> <new tip> <squash target or empty> <commit the caller named>...
	[ -n "$_IN_LANDED_STEP" ] || { _LANDED_STEP "$0" "$@"; return; }
	local LINE
	_EMPTIED_COMMITS "$@" || return 0
	local -a GONE=("${reply[@]}")
	PRINT_TEXT "%s commit(s) left empty by the %s were dropped:" 33 "$REPLY" "${ACTION:-$STATE_ACTION}"
	(( ${#GONE} )) || return 0
	for LINE in "${GONE[@]}"; do print -r -- "${LINE:0:7} ${LINE#* }"; done | _CARET_LINES | LC_ALL=C sed "s/^/  emptied: /;s/^/${_DIM}/;s/\$/${_OFF}/"
}

# Prints the commit a squash's rebase made of its target – the target's place in the todo,
# each commit before it kept bar those squashed away, and those a replay dropped gone empty,
# which find no commit of their authorship and subject next in the new line – proven by the
# authorship a fold keeps, else the target itself
_SQUASHED_INTO () {
	# Args: <old tip> <new tip> <target> <commit the caller named>...
	local OLD=$1 NEW=$2 TGT=$3 C
	shift 3
	local OLDEST=$(git merge-base --octopus "$@" 2>/dev/null)
	local BASE=$(git rev-parse -q --verify "$OLDEST^" 2>/dev/null)
	local -a NEWS NKEYS
	local -i K=1
	NEWS=(${(f)"$(git rev-list --reverse ${BASE:+$BASE..}"$NEW" 2>/dev/null)"})
	(( ${#NEWS} )) && NKEYS=("${(@f)$(git log --no-walk=unsorted --format='%an%x01%ae%x01%ad%x01%s' --date=raw "${NEWS[@]}" 2>/dev/null)}")
	for C in ${(f)"$(git rev-list --reverse ${BASE:+$BASE..}"$OLD" 2>/dev/null)"}; do
		[ "$C" = "$TGT" ] && break
		(( ${argv[(Ie)$C]} )) && continue
		[ "$(git log -1 --format='%an%x01%ae%x01%ad%x01%s' --date=raw "$C" 2>/dev/null)" = "${NKEYS[K]}" ] && K+=1
	done
	C=${NEWS[K]}
	if [ -n "$C" ] && [ "$(git log -1 --format='%an%x01%ae%x01%ad' --date=raw "$C" 2>/dev/null)" = "$(git log -1 --format='%an%x01%ae%x01%ad' --date=raw "$TGT" 2>/dev/null)" ]; then
		print -r -- "$C"
	else
		print -r -- "$TGT"
	fi
}

# Lands what a drop's or squash's rebase built in its worktree – gated, compare-and-swapped onto the
# tip the run read, then reported – for the run that built it and for the resume finishing it
_LAND_REBASE () {
	# Args: <worktree> <branch ref> <old tip> <drop|squash> <commit naming the run> <squash target
	# or empty> <commit the caller named>...
	local WT=$1 REF=$2 OLD=$3 ACT=$4 LBL=$5 TGT=$6 NEW T
	shift 6
	local -a NAMED=("$@")
	NEW=$(git -C "$WT" rev-parse HEAD)
	# A drop undoes its commits' own mode changes at the tip, the one rebase action that means one
	local MEANT=""
	if [ "$ACT" = drop ]; then
		for T in "${NAMED[@]}"; do MEANT+="$(_MODE_LINES "$WT" "$T" "$T^")"$'\n'; done
	fi
	# A squash keeps the tip's content by construction – a replay that changed it, through a
	# resolution say, lands nothing, told before a gate runs on what can't land
	if [ "$ACT" = squash ] && ! _SAME_TREE "$NEW" "$OLD"; then
		PRINT_ERR "The squash would change the tip's content, at $(_SOME_PATHS -q ${(f)"$(_TREE_CHANGES "$OLD" "$NEW")"}) – not applied"
		if [ -n "$_STATE_OWNED" ]; then
			_CLEANUP_HOOK=""
			PRINT_TEXT "A resolution changed what the squashed commits add up to – %s, then squash again, each resolution keeping what the commits hold." 33 "git edit --abort"
			_PAUSE_EXIT 1 retry
		fi
		exit 1
	fi
	# A message `-m`'s editor took is kept for the rerun
	local TYPED="" RERUN="git edit -s${TGT:+=$TGT}"
	[ "$ACT" = squash ] && [ -s "$_MSG_TYPED" ] && TYPED=$(<"$_MSG_TYPED")
	for T in "${NAMED[@]}"; do [ "$T" = "$TGT" ] || RERUN+=" $T"; done
	_TYPED_KEEP=("$TYPED" "$RERUN")
	_VERIFY_CONFIGURED && _REQUIRE_CURRENT "$REF" "$OLD" "$TYPED" "$RERUN"
	if ! _GUARD_TIP_MODES "$WT" "$NEW" "$OLD" "$MEANT" || ! _VERIFY_REWRITE "$WT" "$NEW" "$OLD" ""; then
		[ -n "$_STATE_OWNED" ] || _SAVE_REBASE_STATE
		_CLEANUP_HOOK=""
		EMIT_GATE_PAUSED "$WT" "$NEW"
		_PAUSE_EXIT 2 gate
	fi
	# What went where, for a ref left on it – read ahead of the move, the commit the target became
	# kept for the line naming it, and a squash's members only where that is found in the new line
	local INTO=""
	_RUN_FATES=()
	if [ "$ACT" = drop ]; then
		for T in "${NAMED[@]}"; do _RUN_FATES[$T]=dropped; done
	elif [ "$ACT" = squash ] && [ -n "$TGT" ]; then
		INTO=$(_SQUASHED_INTO "$OLD" "$NEW" "$TGT" "${NAMED[@]}")
		if _IS_ANCESTOR "$INTO" "$NEW"; then
			for T in "${NAMED[@]}"; do [ "$T" = "$TGT" ] || _RUN_FATES[$T]="squashed $INTO"; done
		fi
	fi
	# One the rebase dropped as emptied is gone as surely as one named
	if _EMPTIED_COMMITS --sure "$OLD" "$NEW" "$TGT" "${NAMED[@]}"; then
		for T in "${reply[@]}"; do _RUN_FATES[${T%% *}]=dropped; done
	fi
	# Only where the ref still holds the tip the run read, so a concurrent commit, from an editor
	# working in the checkout say, is never overwritten
	local CMD="git update-ref -m ${(q-)${:-git edit: $ACT ${LBL:0:7}$_REFLOG_TAG}} ${(q-)REF} ${(q-)NEW} ${(q-)OLD}"
	PRINT_CMD "$CMD"
	if ! _MOVE_REF "$CMD"; then
		[ -n "$_STATE_OWNED" ] && _REFUSE_MOVED_BRANCH "${REF#refs/heads/}" "$WT" "$TYPED" "$RERUN"
		PRINT_ERR "Branch '${REF#refs/heads/}' moved during the $ACT – refusing to overwrite"
		ECHO_E "\e[0;31m  Nothing was applied – run the $ACT again on its new tip.\e[0m" >&2
		_KEEP_TYPED_MESSAGE "$TYPED" "$RERUN"
		exit 1
	fi
	_RECORD_REF_MOVE "$REF" "$OLD" "$NEW" "$ACT ${LBL:0:7}"
	_PRINT_REWRITE_APPLY_HINT "${REF#refs/heads/}" "$OLD" "$NEW" "$ACT"
	_PRINT_MODE_CHANGES "$OLD" "$NEW"
	_PRINT_TREE_IDENTITY "$OLD" "$NEW"
	_PRINT_EMPTIED "$OLD" "$NEW" "$TGT" "${NAMED[@]}"
	_PRINT_TODO early
	# What the caller selected names the bodies, and the commit the target became the line after
	if [ "$ACT" = squash ] && [ -n "$TGT" ]; then
		_PRINT_DROPPED_BODIES "$TGT" "${NAMED[@]}"
		_PRINT_COMMIT_LINE "$INTO" '  squashed into: %h %s'
	elif [ "$ACT" = drop ]; then
		# The hint above lists the restored paths, one per file – unbounded, so the commits' own
		# names follow it rather than precede it
		for T in "${NAMED[@]}"; do _PRINT_COMMIT_LINE "$T" '  dropped: %h %s'; done
	fi
}

# Answers whether the current squash could take the plumbing-only path, so `-s` can auto-route
# to `-S` safely:
# • The selected commits form a contiguous range
# • Target, where given, equals the oldest commit, so nothing reorders
# • No commit in the range is a merge
# Operates implicitly on the global `$COMMITS` array and optional `$TARGET`
_RESQUASH_ELIGIBLE () {
	local OLDEST=${COMMITS[1]}
	local NEWEST=${COMMITS[-1]}

	# Target must equal oldest – any other target requires reordering, which
	# the plumbing path can't do
	[ -n "$TARGET" ] && [ "$TARGET" != "$OLDEST" ] && return 1

	# Contiguity check: the inclusive range `OLDEST..NEWEST` must equal the
	# selected commits exactly, in the same order
	local EXPECTED
	if git rev-parse --verify "$OLDEST^" >/dev/null 2>&1; then
		EXPECTED=($(git rev-list --reverse "$OLDEST^..$NEWEST" 2>/dev/null))
	else
		EXPECTED=($(git rev-list --reverse "$NEWEST" 2>/dev/null))
	fi

	[ ${#EXPECTED[@]} -ne ${#COMMITS[@]} ] && return 1

	local i
	for (( i=1; i<=${#COMMITS[@]}; i++ )); do
		[ "${COMMITS[$i]}" != "${EXPECTED[$i]}" ] && return 1
	done

	# No merge commits in the range
	local C P_LIST
	for C in "${COMMITS[@]}"; do
		P_LIST=$(git log -1 --format='%P' "$C")
		[[ "$P_LIST" == *" "* ]] && return 1
	done

	_SQUASH_LEAVES_REACHABLE "$NEWEST" "${(@)COMMITS[1,-2]}" && return 1

	return 0
}

# Succeeds where a commit above <newest> takes one of <inner> as a parent – squashed away, that one
# would stay reachable through it, twice
_SQUASH_LEAVES_REACHABLE () {
	# Args: <newest> <inner commit>...
	local NEWEST=$1
	shift
	git rev-list --parents "$NEWEST..HEAD" 2>/dev/null | awk -v inner="$*" '
		BEGIN { n = split(inner, a, " "); for (i = 1; i <= n; i++) s[a[i]] = 1 }
		{ for (i = 2; i <= NF; i++) if ($i in s) found = 1 }
		END { exit !found }'
}

# Refuses an `--exec` result carrying commits made before the run that would take commits off
# the branch – built elsewhere, on a tip nothing names, so whatever reached the branch since
# would leave with the rest, the newest of those leading the list as the likeliest someone else's
_REFUSE_EXEC_PREBUILT () {
	# Args: <orig-head> <new-head> <ref> <commits-made-before-the-run> [<commit `HEAD` went back to,
	#       or the result was built on, empty for none>
	#       [<commit built on it with no step going there>]]
	local ORIG_HEAD=$1
	local NEW_HEAD=$2
	local BRANCH=${3#refs/heads/}
	local PRE_RUN=$4 BELOW=$5 BUILT=$6
	local -i LEAVING=$(git rev-list --count "$NEW_HEAD..$ORIG_HEAD" 2>/dev/null)
	# A rewind is the one shape with a mode of its own – a drop names its commits rather than
	# resetting past whatever the tip has become
	local REWIND=false
	git merge-base --is-ancestor "$NEW_HEAD" "$ORIG_HEAD" 2>/dev/null && REWIND=true
	if [ "$REWIND" = true ]; then
		PRINT_ERR "HEAD moved back to ${NEW_HEAD:0:7} – a reset past the tip drops whatever sits above it, a commit that reached $BRANCH meanwhile included"
	elif [ -n "$BUILT" ] && [ -z "$BELOW" ]; then
		PRINT_ERR "${BUILT:0:7} is a root commit, built on nothing the tip this run started on holds – landing it drops whatever $BRANCH held, a commit that reached it meanwhile included"
	elif [ -n "$BUILT" ]; then
		PRINT_ERR "${BUILT:0:7} was built on ${BELOW:0:7}, below the tip this run started on – landing it drops whatever sat above, a commit that reached $BRANCH meanwhile included"
	elif [ -n "$BELOW" ]; then
		PRINT_ERR "HEAD went back to ${BELOW:0:7}, below the tip this run started on, and the result was built there – landing it drops whatever sat above, a commit that reached $BRANCH meanwhile included"
	else
		PRINT_ERR "HEAD moved to ${NEW_HEAD:0:7}, carrying $PRE_RUN commit(s) made before this run – landing a history built elsewhere would drop whatever reached $BRANCH after it was built"
	fi
	ECHO_E "\e[0;31m  It takes $LEAVING commit(s) off $(_LIT "$BRANCH"), the newest first:\e[0m" >&2
	git log --format='%h %s' -5 "$NEW_HEAD..$ORIG_HEAD" 2>/dev/null | _CARET_LINES | LC_ALL=C sed "s/^/${_RED}    /;s/\$/${_OFF}/" >&2
	(( LEAVING > 5 )) && ECHO_E "\e[0;31m    … and $(( LEAVING - 5 )) more\e[0m" >&2
	if [ "$REWIND" = true ]; then
		ECHO_E "\e[0;31m  To drop commits, name them: git edit -d <sha>... – or pin the tip you expect with --base=<sha>.\e[0m" >&2
	elif (( PRE_RUN == 0 )); then
		# Built in the run itself, so on the tip it started on – the one pin that lands it
		ECHO_E "\e[0;31m  Where dropping those is the point, pin the tip this run started on, refused again if $(_LIT "$BRANCH") has moved past it: git edit --exec --base=${ORIG_HEAD:0:12} -- <the same command>\e[0m" >&2
	else
		ECHO_E "\e[0;31m  Name the tip it was built on, refused again if $(_LIT "$BRANCH") has moved past it: git edit --exec --base=<sha> -- ...\e[0m" >&2
	fi
}

# Fills `reply` with where an `--exec` result was built below <orig-head>, the tip the run started
# on – the commit `HEAD` went back to, or the commit below and the one built on it with no step of
# the command's going there, the first empty for a root commit – and empties it where nothing was
# Reads the run worktree's reflog, the command's own, newest first, following the result back to
# what it was built on: an entry making a commit builds on the one before, an amend on that one's
# parents, while a checkout, a reset or plumbing only went to it, so the entry that made it lies
# further down – ending at the start tip, a detour off that line building nothing it carries
# A rebase names what it drops in its todo, so its steps count as made, the commit it replays
# onto and a merged side as brought in – unless it replays nothing, a reset in disguise
_EXEC_BUILT_BELOW () {
	# Args: <orig-head> <new-head>
	setopt local_options extended_glob
	local ORIG=$1 L=$2 PREV PREV_PARENTS ENTRY LINE P OLD_FF="" GIVEN=""
	local ORIG_PARENTS=$(git log -1 --format=%P "$1" 2>/dev/null)
	local -a LOGGED HASH PARENTS SUBJ REB START RANGE F BROUGHT match mbegin mend
	local -A MADE IN
	local -i I J N
	reply=()
	LOGGED=("${(@f)$(git reflog --format='%H %P%x09%gs' HEAD 2>/dev/null)}")
	for ENTRY in "${LOGGED[@]}"; do
		[ -n "$ENTRY" ] || continue
		N+=1
		HASH[N]=${ENTRY%% *} ENTRY=${ENTRY#* }
		PARENTS[N]=${ENTRY%%$'\t'*} SUBJ[N]=${ENTRY#*$'\t'}
	done
	# A rebase's entries, oldest first, by subject – `rebase` in any form, a `pull` running one, a
	# commit made at its stop – and before git 2.38 a fast-forward, logged in the caller's language:
	# an untagged step within a rebase to a child of the commit before, one the rebase was given
	[[ "$(git --version 2>/dev/null)" =~ '^git version 2\.([0-9]+)\.' ]] && (( match[1] < 38 )) && OLD_FF=1
	for (( I = N; I >= 1; I-- )); do
		PREV=${HASH[I + 1]:-$ORIG}
		if [[ "${SUBJ[I]}" == ((#i)rebase*|"commit (rebase)"*|pull*\ \([a-z-]##\)*) ]] || \
		   { [ -n "$OLD_FF" ] && [ "${REB[I + 1]}" = 1 ] && \
		     [[ -n "${SUBJ[I]}" && "${SUBJ[I]}" != (checkout|reset|commit|merge|cherry-pick|revert|am|pull)* ]] && \
		     [[ -z "${PARENTS[I]}" || "${PARENTS[I]%% *}" = "$PREV" ]] && \
		     git merge-base --is-ancestor "${HASH[I]}" "$GIVEN" 2>/dev/null; }; then
			REB[I]=1
			[[ "${SUBJ[I]}" == (*" (start): checkout "*|[^\(]#": checkout "*) ]] && START[I]=1 GIVEN=$PREV
		fi
	done
	for (( I = 1; I <= N; I++ )); do
		[ "${HASH[I]}" = "$L" ] || continue
		[ "$L" = "$ORIG" ] && break
		if (( I < N )); then
			PREV=${HASH[I + 1]} PREV_PARENTS=${PARENTS[I + 1]}
		else
			PREV=$ORIG PREV_PARENTS=$ORIG_PARENTS
		fi
		# A rebase's start goes to the commit it replays onto, building there only where a step of
		# its own moves on before another starts – one replaying nothing only went there
		if [ "${START[I]}" = 1 ]; then
			for (( J = I - 1; J >= 1; J-- )); do
				[ "${REB[J]}" = 1 ] || continue
				[ "${START[J]}" = 1 ] && J=0 && break
				[ "${HASH[J]}" != "$L" ] && break
			done
			if (( J < 1 )); then
				REB[I]=""
			else
				BROUGHT+=("$L")
			fi
		fi
		if [ "${REB[I]}" = 1 ]; then
			MADE[$L]=1
			L=$PREV
			continue
		fi
		if git merge-base --is-ancestor "$L" "$ORIG" 2>/dev/null; then
			reply=("$L")
			return 0
		fi
		if [[ "${SUBJ[I]}" == "commit (amend)"* ]]; then
			[ "${PARENTS[I]}" = "$PREV_PARENTS" ] || continue
		elif [[ "${SUBJ[I]}" == (commit|merge|cherry-pick|revert|am|pull)* ]]; then
			git merge-base --is-ancestor "$PREV" "$L" 2>/dev/null || continue
			# A merged side is brought in, a fast-forward's commits on the line itself
			for P in ${=PARENTS[I]}; do
				[ "$P" != "$PREV" ] && ! git merge-base --is-ancestor "$PREV" "$P" 2>/dev/null && BROUGHT+=("$P")
			done
		else
			continue
		fi
		MADE[$L]=1
		L=$PREV
	done
	# What the walk never made – a commit plumbing built, or one off its line – shows in the result
	# itself: a commit on a parent below the tip, or on none, that nothing brought in
	RANGE=("${(@f)$(git rev-list --reverse --parents "$2" --not "$ORIG" "${BROUGHT[@]}" 2>/dev/null)}")
	for LINE in "${RANGE[@]}"; do
		IN[${LINE%% *}]=1
	done
	for LINE in "${RANGE[@]}"; do
		F=(${=LINE})
		(( ${#F} )) && [ -z "${MADE[${F[1]}]}" ] || continue
		if (( ${#F} == 1 )); then
			reply=("" "${F[1]}")
			return 0
		fi
		for P in "${(@)F[2,-1]}"; do
			[ "$P" != "$ORIG" ] && [ -z "${IN[$P]}" ] && git merge-base --is-ancestor "$P" "$ORIG" 2>/dev/null || continue
			reply=("$P" "${F[1]}")
			return 0
		done
	done
}

# Refuses an `--exec --base` whose tip the branch has moved past – naming what reached it since,
# and the rebase that carries those onto a history built on the base, inside the run itself
_REFUSE_EXEC_BASE_MOVED () {
	# Args: <base> <orig-head> <ref>
	local BASE=$1
	local ORIG_HEAD=$2
	local BRANCH=${3#refs/heads/}
	# `--commit` pins the tip it composed on, which the caller never named
	if [ ${#OPT_COMMIT} -gt 0 ]; then
		PRINT_ERR "$BRANCH moved to ${ORIG_HEAD:0:7} while the commit was composed on ${BASE:0:7} – nothing landed, so run it again"
		return 0
	fi
	if ! git merge-base --is-ancestor "$BASE" "$ORIG_HEAD" 2>/dev/null; then
		PRINT_ERR "$BRANCH was rewritten since --base ${BASE:0:7} – it is no longer an ancestor of the tip"
		ECHO_E "\e[0;31m  Rebuild on the current tip, ${ORIG_HEAD:0:12}.\e[0m" >&2
		return 0
	fi
	local -i SINCE=$(git rev-list --count "$BASE..$ORIG_HEAD" 2>/dev/null)
	PRINT_ERR "$BRANCH moved past --base ${BASE:0:7} – $SINCE commit(s) reached it since, which landing a history built on it would drop"
	git log --format='%h %s' -10 "$BASE..$ORIG_HEAD" 2>/dev/null | _CARET_LINES | LC_ALL=C sed "s/^/${_RED}    /;s/\$/${_OFF}/" >&2
	(( SINCE > 10 )) && ECHO_E "\e[0;31m    … and $(( SINCE - 10 )) more\e[0m" >&2
	ECHO_E "\e[0;31m  Rebuild on the tip, or carry them onto your history in the run:\e[0m" >&2
	ECHO_E "\e[0;31m    git edit --exec --base=${ORIG_HEAD:0:12} -- git rebase --onto <your history> ${BASE:0:12}\e[0m" >&2
}

# Lists each commit an `--exec` result brings in whose message ends in more blank lines than
# the one it replaces, as a line of SHA and subject – the one it replaces shares its subject or
# its author and author date, which a reword keeps, so a commit matching neither came from
# elsewhere, a branch brought in, and carries its message as it was
# Only a byte count sees them – `git log` and `git range-diff` both trim
_EXEC_GAINED_BLANK_LINES () {
	# Args: <orig-head> <new-head>
	# None where the new head descends from the old, as the run already found – no commit leaves
	[ "${_ANCESTRY[$1 $2]}" = 0 ] && return 0
	setopt local_options extended_glob
	local -A LEFT
	local SIDE RAW ENTRY BODY KEY
	local -a F
	local -i EXTRA BEFORE
	for SIDE in leaving arriving; do
		# `-z` ends each entry in a NUL rather than a newline, so a body keeps its own trailing
		# ones, and the `x` keeps the last entry's whether or not git closes it with a NUL
		if [ $SIDE = leaving ]; then
			RAW=$(git log -z --format='%H%x01%s%x01%ae %at%x01%B' "$2..$1" 2>/dev/null; print -n x)
		else
			RAW=$(git log -z --format='%H%x01%s%x01%ae %at%x01%B' "$1..$2" 2>/dev/null; print -n x)
		fi
		for ENTRY in "${(@0)${RAW%x}}"; do
			[ -z "$ENTRY" ] && continue
			F=("${(@ps:\x01:)ENTRY}")
			BODY=${F[4]}
			EXTRA=$(( ${#BODY} - ${#${BODY%%[$'\n']##}} - 1 ))
			(( EXTRA < 0 )) && EXTRA=0
			if [ $SIDE = leaving ]; then
				for KEY in "s ${F[2]}" "a ${F[3]}"; do
					(( EXTRA > ${LEFT[$KEY]:--1} )) && LEFT[$KEY]=$EXTRA
				done
			else
				BEFORE=-1
				for KEY in "s ${F[2]}" "a ${F[3]}"; do
					(( ${LEFT[$KEY]:--1} > BEFORE )) && BEFORE=${LEFT[$KEY]}
				done
				(( BEFORE >= 0 && EXTRA > BEFORE )) && print -r -- "${F[1]:0:7} ${F[2]}"
			fi
		done
	done
}

# Refuses an `--exec` result whose messages gained trailing blank lines – the mark of a loop
# feeding `%B` raw to `commit-tree`, which adds one to every message it rebuilds, one more per
# pass, where nothing downstream shows it
_REFUSE_EXEC_BLANK_LINES () {
	# Args: <new-head> <gained, one `<sha> <subject>` a line>
	local -a GAINED=("${(@f)2}")
	PRINT_ERR "HEAD moved to ${1:0:7}, but ${#GAINED} message(s) it brings in end in more blank lines than before – a message read with %B and fed raw to commit-tree gains one each pass, which git log and git range-diff both hide"
	print -rl -- "${(@)GAINED[1,5]}" | _CARET_LINES | LC_ALL=C sed "s/^/${_RED}    /;s/\$/${_OFF}/" >&2
	(( ${#GAINED} > 5 )) && ECHO_E "\e[0;31m    … and $(( ${#GAINED} - 5 )) more\e[0m" >&2
	ECHO_E "\e[0;31m  Take each message from git cat-file commit, or trim its trailing newlines to one, and rebuild.\e[0m" >&2
}

# Resolves where `--commit` or `--exec` places the commits it adds, `--after` or `--before` an
# anchor the tip reaches – a pushed commit or a merge above it refuses before anything is built
_RESOLVE_PLACE () {
	# Args: [<anchor pinned by an earlier call>]
	EXEC_PLACE_KIND="" EXEC_PLACE_ANCHOR="" EXEC_PLACE_BASE=""
	[ ${#OPT_AFTER} -gt 0 ] || [ ${#OPT_BEFORE} -gt 0 ] || return 0
	if [ ${#OPT_AFTER} -gt 0 ] && [ ${#OPT_BEFORE} -gt 0 ]; then
		PRINT_ERR "Take exactly one of --after=<sha> or --before=<sha>, not both"
		exit 1
	fi
	local ANCHOR=${OPT_AFTER[2]#=}
	EXEC_PLACE_KIND=after
	[ ${#OPT_BEFORE} -gt 0 ] && { ANCHOR=${OPT_BEFORE[2]#=}; EXEC_PLACE_KIND=before; }
	[ -n "$1" ] && ANCHOR=$1
	if [ -z "$ANCHOR" ] || ! _PEEL_SHA "$ANCHOR" commit >/dev/null; then
		PRINT_ERR "Unknown <sha>: $ANCHOR"
		exit 1
	fi
	_GUARD_REACHABLE "$ANCHOR"
	EXEC_PLACE_ANCHOR=$(git rev-parse "$_RESOLVED_SHA^{commit}")
	EXEC_PLACE_BASE=$EXEC_PLACE_ANCHOR
	if [ $EXEC_PLACE_KIND = before ] && ! EXEC_PLACE_BASE=$(git rev-parse -q --verify "$EXEC_PLACE_ANCHOR^" 2>/dev/null); then
		PRINT_ERR "--before ${EXEC_PLACE_ANCHOR:0:7} would place it below the root commit"
		exit 1
	fi
	local FIRST=$(git rev-list --reverse "$EXEC_PLACE_BASE..HEAD" 2>/dev/null | head -1)
	if [ -n "$FIRST" ]; then
		_GUARD_UNPUSHED "$FIRST"
		_GUARD_NO_MERGE_SPAN "$FIRST"
	fi
}

# Places the commits a `--commit` or an `--exec` command added on top `--after` or `--before` the
# anchor, replayed in the run's own worktree, so the branch never holds them at the tip – a
# conflict pauses as a reorder's does, nothing landed and the tip it read recorded
_EXEC_PLACE () {
	# Args: <worktree> <orig-head> <ref> – sets `EXEC_PLACED` to the placed commits, oldest first
	local WT=$1 ORIG_HEAD=$2 REF=$3 BUILT=$(git rev-parse HEAD)
	local -a ADDED REPLAY
	EXEC_PLACED=""
	[ "$BUILT" = "$ORIG_HEAD" ] && return 0
	if ! git merge-base --is-ancestor "$ORIG_HEAD" "$BUILT" 2>/dev/null || [ -n "$(git rev-list --merges "$ORIG_HEAD..$BUILT" 2>/dev/null)" ]; then
		PRINT_ERR "--$EXEC_PLACE_KIND places commits added on top of the tip – the command rewrote history instead, so nothing landed"
		exit 1
	fi
	ADDED=($(git rev-list --reverse "$ORIG_HEAD..$BUILT"))
	REPLAY=($(git rev-list --reverse "$EXEC_PLACE_BASE..$ORIG_HEAD"))
	# Already in place right above the tip
	if [ ${#REPLAY} -eq 0 ]; then
		EXEC_PLACED=${(j: :)ADDED}
		return 0
	fi
	# Guarded again on what is replayed – a peer may have dropped the anchor, landed a merge or pushed
	if ! git merge-base --is-ancestor "$EXEC_PLACE_ANCHOR" "$ORIG_HEAD" 2>/dev/null; then
		PRINT_ERR "${EXEC_PLACE_ANCHOR:0:7} left the branch while this run built – nothing landed; place it beside a commit the branch holds"
		exit 1
	fi
	_GUARD_UNPUSHED "${REPLAY[1]}"
	_GUARD_NO_MERGE_SPAN "${REPLAY[1]}"
	PRINT_ACTION "Placing ${#ADDED} commit(s) $EXEC_PLACE_KIND %s..." "$EXEC_PLACE_ANCHOR"
	# What the command left uncommitted never lands, and in the way it would stop the replay – a file
	# read as modified only through its attributes no leftover of it
	_RENORM_SETTLE .
	local LEFT=$(git -c core.quotePath=false status --porcelain --untracked-files=all 2>/dev/null | cut -c4-)
	if [ -n "$LEFT" ]; then
		git reset -q --hard && git clean -fdq
		PRINT_TEXT "Dropped what the command left uncommitted, which never lands: %s" 90 "$(_JOIN_PATHS "$LEFT")"
	fi
	_ORDER_EDITOR
	local SEQ=$REPLY
	_CAPTURE_BEGIN
	local REBASE_CMD="GIT_EDIT_REORDER_ORDER='${ADDED[*]} ${REPLAY[*]}' GIT_SEQUENCE_EDITOR=${(q-)$(_SH_WORD "$SEQ")} GIT_EDITOR=true git -c commit.cleanup=verbatim -c rerere.enabled=true -c rerere.autoUpdate=false -c rebase.updateRefs=false -c advice.mergeConflict=false -c advice.resolveConflict=false -c rebase.instructionFormat= $_CAPTURE_PINS rebase $_CAPTURE_EXEC --no-autosquash --no-autostash --interactive ${EXEC_PLACE_BASE}"
	PRINT_CMD "GIT_SEQUENCE_EDITOR=<placement script> git rebase --interactive ${EXEC_PLACE_BASE:0:12}" 90
	_RERERE_SCOPE_BEGIN
	_REBASE_FIRST_RUN "$REBASE_CMD"
	local RC=$?
	(( RC == 1 )) && _REFUSE_REBASE_FAILED "run it again."
	if (( RC != 0 )) && \
	   ! { _AUTO_RESOLVE_FINAL_STEP "$WT" "$BUILT" && _FINISH_AUTO_RESOLVED_STEP "$WT" "built" }; then
		rm -f "$SEQ"
		# A dry run lands nothing, so it holds no pause either – one would block every other run
		if [ ${#OPT_DRY_RUN} -gt 0 ]; then
			git rebase --abort >/dev/null 2>&1
			PRINT_ERR "Placing it $EXEC_PLACE_KIND ${EXEC_PLACE_ANCHOR:0:7} conflicts – a dry run pauses nothing, so nothing was kept"
			ECHO_E "\e[0;31m  Run it without --dry-run to resolve the placement, or place it beside another commit.\e[0m" >&2
			exit 1
		fi
		# The branch was never moved, so --abort has nothing to roll back, and a resume lands the
		# placement against the tip this run read
		_SAVE_STATE \
			"operation=reorder" \
			"worktree=$WT" \
			"branch=$REF" \
			"orig_head=$ORIG_HEAD" \
			"target=${REPLAY[1]}" \
			"placed=$BUILT" \
			"place_label=${EXEC_LABEL:-exec} $EXEC_PLACE_KIND ${EXEC_PLACE_ANCHOR:0:7}"
		_CLEANUP_HOOK=""
		PRINT_ERR "Conflict placing it $EXEC_PLACE_KIND ${EXEC_PLACE_ANCHOR:0:7} – nothing landed; resolve in the worktree, then 'git edit --continue'"
		PRINT_TEXT "Worktree: %s" 33 "$WT"
		local UNMERGED_LIST=$(_PRINT_CONFLICT_DETAIL "$WT" "$BUILT")
		PRINT_TEXT "Or abort the operation: %s" 33 "git edit --abort"
		EMIT_CONFLICT "$WT" "$UNMERGED_LIST"
		_PAUSE_EXIT 2 conflict
	fi
	rm -f "$SEQ"
	# A clean replay can still end elsewhere – a placed change partly taking back a commit it now
	# precedes – and lands what was built or nothing, as a resumed placement does
	if ! _SAME_TREE "$BUILT" HEAD; then
		PRINT_ERR "Placing it $EXEC_PLACE_KIND ${EXEC_PLACE_ANCHOR:0:7} no longer ends as it was built – it changes $(_JOIN_PATHS "$(_TREE_CHANGES "$BUILT" HEAD)") – so nothing landed"
		ECHO_E "\e[0;31m  Place it beside a commit it doesn't overlap, or land it at the tip.\e[0m" >&2
		exit 1
	fi
	EXEC_PLACED=${(j: :)${(f)"$(git rev-list --reverse "$EXEC_PLACE_BASE..HEAD" | head -${#ADDED})"}}
}

# Runs an arbitrary command inside a fresh per-invocation worktree, detached at the branch
# tip – where the command rewrites `HEAD`, the original ref moves by atomic CAS, refusing
# if the branch moved, so raw rewriting commands never touch the main checkout
GIT_EXEC () {
	local ORIG_HEAD=$(git rev-parse HEAD)
	local BRANCH=${$(git symbolic-ref -q HEAD 2>/dev/null)#refs/heads/}
	# The CAS runs in the temp worktree, where `HEAD` names that worktree's own, never the checkout's
	if [ -z "$BRANCH" ]; then
		PRINT_ERR "--exec requires being on a branch (got detached HEAD)"
		exit 1
	fi
	local REF="refs/heads/$BRANCH"
	# Defaults for the status trailer, updated below if `HEAD` changes
	EXEC_NEW_HEAD=$ORIG_HEAD
	EXEC_REF=$REF
	EXEC_CHANGED=false
	EXEC_PEER_MOVE=""
	EXEC_DRY_BUILT=""
	EXEC_DRY_BASE=""
	EXEC_PLACED=""

	# A pinned tip the branch has moved past refuses before the command runs – whatever it
	# builds on that base would drop what reached the branch since
	if [ -n "$EXEC_BASE" ] && [ "$EXEC_BASE" != "$ORIG_HEAD" ]; then
		_REFUSE_EXEC_BASE_MOVED "$EXEC_BASE" "$ORIG_HEAD" "$REF"
		exit 1
	fi

	# Unique per-invocation worktree so concurrent --exec calls never collide
	local WT
	WT=$(MKTEMP_DIR git-edit-exec) || exit 1
	rmdir "$WT"  # `git worktree add` wants to create the dir itself
	# Register cleanup via the global hook so the `EXIT` trap removes the worktree on any
	# exit path – success, failure or signal, a failed add's registration too
	_CLEANUP_HOOK="git worktree remove --force ${(q-)WT} 2>/dev/null; rm -rf ${(q-)WT}"
	_WORKTREE_ADD "$WT" "$ORIG_HEAD" || exit 1
	_LINK_WORKTREE_EXTRAS "$WT"

	cd "$WT" || exit 1

	# The caller's command runs in the worktree's copy of the directory the caller stands in, so its
	# relative paths name what they name there – at the top where the tip lacks that directory
	local RUN_PREFIX="" RUN_DIR=$WT RUN_AT="at the top"
	if [ -z "$EXEC_LABEL" ]; then
		RUN_PREFIX=$(cd "$_START_DIR" 2>/dev/null && git rev-parse --show-prefix 2>/dev/null)
		if [ -n "$RUN_PREFIX" ] && [ -d "$WT/$RUN_PREFIX" ]; then
			RUN_DIR=$WT/${RUN_PREFIX%/} RUN_AT="in $RUN_PREFIX"
		elif [ -n "$RUN_PREFIX" ]; then
			RUN_AT="at the top, as the tip has no $RUN_PREFIX"
			PRINT_TEXT "Note: the tip has no %s – the command runs at the worktree's top, with GIT_PREFIX naming where you stand." 90 "$RUN_PREFIX"
		fi
		# A program named by a relative path, which the shell reads from where the command runs, is
		# looked for there first – where it names nothing, the run would end in a bare 127
		local ABS_CMD=$_START_DIR/$1 C
		if [[ "$1" == */* && "$1" != /* ]] && [ ! -e "$RUN_DIR/$1" ] && [ ! -L "$RUN_DIR/$1" ]; then
			_ONE_LINE "$1"
			local NAMED=$REPLY
			# The tip's file as read from where the caller stands, else one only the checkout holds
			# there, else the tip's as read from the top
			C="${${:-$WT/$RUN_PREFIX$1}:a}"
			[[ "$C" == "$WT"/?* ]] && [ -f "$C" ] || C=""
			if [ -z "$C" ] && [ -e "$ABS_CMD" ]; then
				PRINT_ERR "--exec $NAMED: not at the tip – the command runs in a fresh worktree of it ($RUN_AT), which holds no uncommitted file"
				ECHO_E "\e[0;31m  Commit it first, or name it by its absolute path: $(_LIT "git edit --exec --") $(_LIT "$(_SHQ "${ABS_CMD:a}" "${@[2,-1]}")")\e[0m" >&2
				exit 1
			fi
			[ -n "$C" ] || { C="${${:-$WT/$1}:a}"; [[ "$C" == "$WT"/?* ]] && [ -f "$C" ] || C=""; }
			if [ -n "$C" ]; then
				C=${C#$WT/}
				# Its name from where the command runs – a top-level one keeping a slash, which the shell
				# would look up on `PATH` without
				local UP="" D
				[ "$RUN_DIR" = "$WT" ] || for D in ${(s:/:)RUN_PREFIX}; do UP+=../; done
				[[ -z "$UP" && "$C" != */* ]] && UP=./
				_ONE_LINE "$C"
				PRINT_ERR "--exec $NAMED: nothing there where the command runs, in a fresh worktree of the tip ($RUN_AT) – the tip holds $REPLY"
				ECHO_E "\e[0;31m  Name it from there: $(_LIT "git edit --exec --") $(_LIT "$(_SHQ "$UP$C" "${@[2,-1]}")")\e[0m" >&2
			else
				PRINT_ERR "--exec $NAMED: nothing there where the command runs, in a fresh worktree of the tip ($RUN_AT), nor where you stand"
				ECHO_E "\e[0;31m  Name the program from there, or by its absolute path.\e[0m" >&2
			fi
			exit 1
		fi
	fi

	# Run the caller's command – no `eval`, the array passes straight through so quoting
	# and special characters survive, the clock read first: a result committed before it
	# was built somewhere else, on a tip nothing here can name
	if [ -z "$EXEC_BASE" ]; then
		# In a second of its own – commit times have no finer grain, so one built in it reads as the run's
		zmodload zsh/datetime
		local -F BEGAN=$EPOCHREALTIME
		sleep $(( 1.0 - (BEGAN - ${BEGAN%.*}) + 0.01 ))
	fi
	local RUN_START=$(date +%s)
	# A labeled run is git-edit's own, already named by its action line
	[ -z "$EXEC_LABEL" ] && PRINT_CMD "$(_SHQ "$@") # (in $RUN_DIR)"
	# Its `HEAD` moves logged whatever the caller's config says, as the guard below reads them, and
	# `GIT_PREFIX` set as git sets it for an alias – the caller's own place, from the top
	( _CALLER_ENV_BACK; export GIT_CONFIG_PARAMETERS="${GIT_CONFIG_PARAMETERS:+$GIT_CONFIG_PARAMETERS }'core.logallrefupdates=true'"
		[ -z "$EXEC_LABEL" ] && export GIT_PREFIX=$RUN_PREFIX
		cd "$RUN_DIR" || exit 1
		"$@" )
	local STATUS=$?
	# The branch itself moved meanwhile – the command updating it, or a peer – which this run lands
	# nothing over, and reports rather than call it unchanged
	local NOW_TIP=$(git rev-parse -q --verify "$REF" 2>/dev/null)
	local MOVED_NOTE=""
	[ "$NOW_TIP" != "$ORIG_HEAD" ] && MOVED_NOTE="$BRANCH moved meanwhile, ${ORIG_HEAD:0:7} → ${NOW_TIP:0:7}, not by this run"

	if [ $STATUS -ne 0 ]; then
		# Where it ran, from a subdirectory – its relative paths named from there
		local RAN=""
		[ -n "$RUN_PREFIX" ] && RAN=" (run $RUN_AT)"
		if [ -n "$MOVED_NOTE" ]; then
			PRINT_ERR "Command exited with status $STATUS$RAN – this run applied nothing, though $MOVED_NOTE"
		elif [ -n "$EXEC_LABEL" ]; then
			# `--commit` runs no command of the caller's – its commit is what refused, a hook's doing
			PRINT_ERR "The commit was refused (exit $STATUS) – a hook of the repository's, most often – so nothing landed"
		else
			PRINT_ERR "Command exited with status $STATUS$RAN – leaving original branch unchanged"
		fi
		exit $STATUS
	fi
	# A rebase, merge, cherry-pick or revert the command left stopped is no result – its `HEAD`
	# sits partway, and landing it drops whatever the operation had still to replay
	local WT_GD=$(git rev-parse --absolute-git-dir 2>/dev/null) OP=""
	if [ -e "$WT_GD/rebase-merge" ]; then OP=rebase-merge
	elif [ -e "$WT_GD/rebase-apply" ]; then OP=rebase-apply
	elif _PICK_IN_PROGRESS "$WT" "$WT_GD"; then OP=$REPLY
	elif [ -e "$WT_GD/sequencer" ]; then OP=sequencer
	fi
	if [ -n "$OP" ]; then
		PRINT_ERR "The command exited 0 with $OP left in its worktree – an operation stopped partway, so nothing landed"
		ECHO_E "\e[0;31m  Have the command finish or abort it, then run it again.\e[0m" >&2
		exit 1
	fi
	[ -n "$EXEC_PLACE_KIND" ] && _EXEC_PLACE "$WT" "$ORIG_HEAD" "$REF"

	# Did the command move `HEAD`? If so, apply the new tip to the original ref
	local NEW_HEAD=$(git rev-parse HEAD)
	if [ "$NEW_HEAD" = "$ORIG_HEAD" ]; then
		if [ -n "$MOVED_NOTE" ]; then
			PRINT_TEXT "HEAD unchanged in the worktree – nothing to apply, but %s." 33 "$MOVED_NOTE"
			# The trailer's move is this run's alone – a peer's is named beside "unchanged"
			EXEC_PEER_MOVE="moved meanwhile by another run, ${ORIG_HEAD:0:7} → ${NOW_TIP:0:7}"
		else
			PRINT_TEXT "HEAD unchanged – nothing to apply." 33
		fi
		return 0
	fi

	# Pushed guard – any remote ref that was an ancestor of the old tip must still be one of
	# the new tip, checked on the result since `--exec` cannot know its targets up front,
	# with two `--merged` walks in place of a per-ref `merge-base` loop
	if [ ${#OPT_ALLOW_PUSHED} -eq 0 ]; then
		local R=$(comm -23 <(git for-each-ref refs/remotes --format='%(refname)' --merged "$ORIG_HEAD" | sort) <(git for-each-ref refs/remotes --format='%(refname)' --merged "$NEW_HEAD" | sort) | head -1)
		if [ -n "$R" ]; then
			PRINT_ERR "Command rewrote pushed history ($R would be orphaned) – not applied"
			ECHO_E "\e[0;31m  Rewritten history is at $NEW_HEAD; pass --allow-pushed to override.\e[0m" >&2
			exit 1
		fi
	fi

	# Built-elsewhere guard – the CAS covers only the command's own run, so a history built before
	# it, landed as a rewrite, would drop whatever reached the branch since, reporting `ok`
	# Every commit the result brings in counts, not just its tip, which a commit made on top in the
	# run would date anew, and a reset to an ancestor predates the run by definition – a descendant
	# drops nothing, and `--base` names the tip the history was built on
	if [ -z "$EXEC_BASE" ] && ! _IS_ANCESTOR "$ORIG_HEAD" "$NEW_HEAD"; then
		local -i PRE_RUN=0
		if ! _IS_ANCESTOR "$NEW_HEAD" "$ORIG_HEAD"; then
			PRE_RUN=$(git log --format=%ct "$ORIG_HEAD..$NEW_HEAD" 2>/dev/null | awk -v t="$RUN_START" '$1 < t' | wc -l)
		fi
		if _IS_ANCESTOR "$NEW_HEAD" "$ORIG_HEAD" || (( PRE_RUN > 0 )); then
			_REFUSE_EXEC_PREBUILT "$ORIG_HEAD" "$NEW_HEAD" "$REF" "$PRE_RUN"
			exit 1
		fi
		# Built on a commit below the start tip – a reset, checkout or plumbing there, a squash by
		# hand, a root of its own – it drops what sat above as surely, where a rebase names what it
		# drops in its todo, read from this run's own worktree, whose reflog is the command's
		_EXEC_BUILT_BELOW "$ORIG_HEAD" "$NEW_HEAD"
		if (( ${#reply} )); then
			_REFUSE_EXEC_PREBUILT "$ORIG_HEAD" "$NEW_HEAD" "$REF" 0 "${reply[@]}"
			exit 1
		fi
	fi

	# Message guard – a hand-rolled rebuild loop is the one place a message gets retyped, and
	# its commonest slip is invisible, so the dry run refuses it too, before anyone inspects
	local GAINED=$(_EXEC_GAINED_BLANK_LINES "$ORIG_HEAD" "$NEW_HEAD")
	if [ -n "$GAINED" ]; then
		_REFUSE_EXEC_BLANK_LINES "$NEW_HEAD" "$GAINED"
		exit 1
	fi

	# A dry run stops at the result – no gate, no CAS – and hands over the landing,
	# pinned to the tip it built on, so running the command outside `--exec` never
	# looks like the way to inspect a rewrite first
	if [ ${#OPT_DRY_RUN} -gt 0 ]; then
		EXEC_DRY_BASE=$ORIG_HEAD
		local MB=$(git merge-base "$ORIG_HEAD" "$NEW_HEAD" 2>/dev/null)
		local PUSHED_FLAG=""
		[ ${#OPT_ALLOW_PUSHED} -gt 0 ] && PUSHED_FLAG=" --allow-pushed"
		PRINT_TEXT "Dry run – built %s on %s, neither verified nor applied." 33 "${NEW_HEAD:0:12}" "${ORIG_HEAD:0:12}"
		[ -n "$MB" ] && PRINT_TEXT "Compare: %s" 33 "git range-diff ${MB:0:12}..${ORIG_HEAD:0:12} ${MB:0:12}..${NEW_HEAD:0:12}"
		PRINT_TEXT "Land it: %s" 32 "git edit --exec --base=${ORIG_HEAD:0:12}$PUSHED_FLAG -- git reset -q --hard $NEW_HEAD"
		EXEC_DRY_BUILT=$NEW_HEAD
		return 0
	fi

	# What the command left untracked never lands, so the gate runs without it – `clean` without
	# `-x` spares the links, which only ever stand in for ignored paths
	if _VERIFY_CONFIGURED; then
		local CLEANED=$(LC_ALL=C git -C "$WT" -c core.quotePath=false clean -fd 2>/dev/null | LC_ALL=C sed -n 's/^Removing //p')
		[ -n "$CLEANED" ] && PRINT_TEXT "Removed what the command left untracked, which never lands: %s" 90 "$(_JOIN_PATHS "$CLEANED")"
	fi

	# The command authored this content rather than replaying a commit somebody already made, so
	# a standing gate is worth more here than anywhere else, the worktree already at the result
	# Having no pause to offer, a failure refuses outright: the built commits stay in the object
	# store, reachable by SHA, and `--no-verify` applies them
	_VERIFY_NO_RESUME=true
	_VERIFY_CONFIGURED && _REQUIRE_CURRENT "$REF" "$ORIG_HEAD"
	if ! _VERIFY_REWRITE "$WT" "$NEW_HEAD" "$ORIG_HEAD" "$EXEC_PLACED"; then
		ECHO_E "\e[0;31m  Built history is at $NEW_HEAD – --no-verify runs the command again unchecked, or land that history as is: git edit --exec --no-verify --base=${ORIG_HEAD:0:12} -- git reset --hard ${NEW_HEAD:0:12}\e[0m" >&2
		exit 1
	fi
	_VERIFY_NO_RESUME=false

	# The reflog names the oldest commit a rewrite replaced, as most modes name their target –
	# a run that only added commits on top replaced none, and those commits say what it did
	local REPLACED=$(git rev-list --reverse --topo-order "$NEW_HEAD..$ORIG_HEAD" 2>/dev/null | head -1)
	local LABEL="${EXEC_LABEL:-exec}${REPLACED:+ ${REPLACED:0:7}}"
	[ -n "$EXEC_PLACED" ] && [ -n "$REPLACED" ] && LABEL="${EXEC_LABEL:-exec} $EXEC_PLACE_KIND ${EXEC_PLACE_ANCHOR:0:7}"

	# Atomic compare-and-swap – refuse where the branch moved during execution, such as a
	# concurrent commit from another session
	local UPDATE="git update-ref -m ${(q-)${:-git edit: $LABEL$_REFLOG_TAG}} ${(q-)REF} ${(q-)NEW_HEAD} ${(q-)ORIG_HEAD}"
	PRINT_CMD "$UPDATE"
	if ! _MOVE_REF "$UPDATE"; then
		# A `--commit` sits on the old tip, so landing it would take back what moved the branch –
		# refused as a tip moved before its gate is, the trailer saying nothing landed
		if [ ${#OPT_COMMIT} -gt 0 ]; then
			_REFUSE_EXEC_BASE_MOVED "$ORIG_HEAD" "$(git rev-parse -q --verify "$REF" 2>/dev/null)" "$REF"
		else
			PRINT_ERR "Ref '$REF' moved during ${EXEC_LABEL:-exec} – refusing to overwrite"
			PRINT_TEXT "Rewritten history is at %s (not applied)." 33 "$NEW_HEAD"
		fi
		exit 1
	fi
	_RECORD_REF_MOVE "$REF" "$ORIG_HEAD" "$NEW_HEAD" "$LABEL"
	# Placed below it, the anchor was replayed – named from here as it now stands
	if [ "$EXEC_PLACE_KIND" = before ] && [ -n "$EXEC_PLACED" ] && [ -n "$REPLACED" ]; then
		EXEC_PLACE_ANCHOR=$(git rev-list --reverse "${EXEC_PLACED##* }..$NEW_HEAD" 2>/dev/null | head -1)
	fi

	_PRINT_REWRITE_APPLY_HINT "$BRANCH" "$ORIG_HEAD" "$NEW_HEAD"

	# Update status trailer outputs (head moved, CAS succeeded)
	EXEC_NEW_HEAD=$NEW_HEAD
	EXEC_CHANGED=true
	if [ -n "$EXEC_PLACED" ] && [ -n "$REPLACED" ] && [ -z "$EXEC_LABEL" ]; then
		local C
		_PRINT_TODO early
		PRINT_TEXT "Placed $EXEC_PLACE_KIND %s:" 32 "${EXEC_PLACE_ANCHOR:0:7}"
		for C in ${=EXEC_PLACED}; do _PRINT_COMMIT_LINE "$C" '  %h %s'; done
	fi
}

# Quotes paths for a printed command – one git would read as a pattern marked literal, as
# `[id].tsx` would match `i.tsx` beside it
_QUOTE_PATHS () {
	# Args: <path>...
	_MARK_LITERAL "$@"
	_SHQ "${reply[@]}"
}

# Fills `reply` with <path>s, each git would read as a pattern marked literal – none where the
# caller's own `GIT_LITERAL_PATHSPECS` reads every name so, and a mark as part of the name
_MARK_LITERAL () {
	# Args: <path>...
	local P V=${${(M)_CALLER_ENV:#GIT_LITERAL_PATHSPECS=*}#*=}
	reply=()
	if [[ "${(L)V}" == (true|yes|on) ]] || { [[ "$V" == <-> ]] && (( 10#$V )); }; then
		reply=("$@")
		return 0
	fi
	for P in "$@"; do
		[[ "$P" == *[*?\[\\]* || "$P" == :* ]] && P=":(literal)$P"
		reply+=("$P")
	done
}

# Prints <command> run over <path>s for a person to paste – past 10, through `xargs` from a file the
# run writes and names, the count in its name, as no one command line holds every list
_PATHS_CMD () {
	# Args: [--plain] <command> <path>... – `--plain` for a command that takes no pathspecs, and a
	# `--` in <command> ending its options already, as `chmod -- +x` must – BSD ends them at the mode
	local PLAIN="" CMD F END=" --"
	[ "$1" = --plain ] && { PLAIN=1; shift; }
	CMD=$1
	shift
	[[ " $CMD " == *" -- "* ]] && END=""
	if [ -n "$PLAIN" ]; then reply=("$@"); else _MARK_LITERAL "$@"; fi
	if (( $# > 10 )) && F=$(MKTEMP_FILE "git-edit-${#}-paths" 2>/dev/null) && print -rN -- "${reply[@]}" > "$F"; then
		print -r -- "xargs -0 $CMD$END < $(_SHQ "$F")"
	else
		print -r -- "$CMD$END $(_SHQ "${reply[@]}")"
	fi
}

# Prints <path>s for a message whose entries need no action of their own – a report, or a list a
# printed command covers – past 10, the first of them and how many more
_SOME_PATHS () {
	# Args: [-q] <path>... – `-q` quotes each as `_SHQ` does, else they're joined by commas
	local Q="" S
	[ "$1" = -q ] && { Q=-q; shift; }
	S=$(_ALL_PATHS $Q "${@[1,10]}")
	(( $# > 10 )) && S+=" … and $(( $# - 10 )) more"
	print -r -- "$S"
}

# Prints every one of <path>s for a message, each on the message's line – for a list no printed
# command covers, whose every entry needs its own action
_ALL_PATHS () {
	# Args: [-q] <path>... – `-q` quotes each as `_SHQ` does, else they're joined by commas
	local Q="" P
	local -a OUT
	[ "$1" = -q ] && { Q=-q; shift; }
	# No name holding a newline quotes in one go
	if [ -n "$Q" ] && [[ "${(j::)@}" != *$'\n'* ]]; then _SHQ "$@"; return; fi
	for P in "$@"; do _ONE_LINE "$P" $Q; OUT+=("$REPLY"); done
	if [ -n "$Q" ]; then print -r -- "${(j: :)OUT}"; else print -r -- "${(j:, :)OUT}"; fi
}

# Puts <name> into `REPLY` as a message shows it on one line – one holding a newline spelled as
# `$'…'` spells it, and with `-q`, any other quoted as `_SHQ` does
_ONE_LINE () {
	# Args: <name> [-q]
	if [[ "$1" == *$'\n'* ]]; then REPLY=${(qqqq)1}
	elif [ "$2" = -q ]; then REPLY=$(_SHQ "$1")
	else REPLY=$1
	fi
}

# Prints <word>s quoted for a shell a person pastes them into – as `(q-)` does, but single-quoting a
# `!` too, which an interactive bash or zsh expands from its history, and spelling a control byte
# other than a tab or newline as `$'…'` does, as the terminal shows it in caret notation
_SHQ () {
	local W
	local -a OUT
	for W in "$@"; do
		if [[ "$W" == *[$'\001'-$'\010'$'\013'-$'\037'$'\177']* ]]; then OUT+=("${(qqqq)W}")
		elif [[ "$W" == *'!'* ]]; then OUT+=("${(qq)W}"); else OUT+=("${(q-)W}"); fi
	done
	print -r -- "${(j: :)OUT}"
}

# Puts into `REPLY` the `cd` a printed command needs first, its paths running from <checkout>'s top
# – none where the caller stands there, a path pasted from a subdirectory naming another file
_AT_TOP () {
	# Args: <checkout>
	REPLY=""
	[ "${_START_DIR:A}" = "${1:A}" ] || REPLY="cd $(_SHQ "$1") && "
}

# Puts into `REPLY` the step re-syncing <path>s' index entries in <checkout> once a locked index is
# free – <command> run only where every entry still holds what <tree> has, the run's read, else
# nothing reset and those staged anew since listed – plumbing, as `git diff` runs a textconv
_LOCKED_RESYNC_STEP () {
	# Args: <checkout> <tree> <command> <path>...
	local CO=$1 TREE=$2 CMD=$3
	shift 3
	_AT_TOP "$CO"
	REPLY+="$(_PATHS_CMD "git diff-index --cached --exit-code --name-only $TREE" "$@") && $(_PATHS_CMD "$CMD" "$@")"
}

# Folds each <name>'s case into `reply` as a case-insensitive filesystem reads it – a non-ASCII
# letter too, whatever the caller's locale or `no_multibyte`
_FOLD_CASE () {
	setopt local_options multibyte
	local LC_ALL L
	for L in C.UTF-8 en_US.UTF-8 UTF-8 C.utf8 en_US.utf8; do
		LC_ALL=$L
		[ "${(L)${:-$'\xc3\x89'}}" = $'\xc3\xa9' ] && break
	done
	reply=("${(@L)@}")
}

# Refuses a commit on <tip> whose <tree> holds two names a case-insensitive filesystem reads as
# one, a name new to the tip among them – landing both, as `git commit` refuses to – where a run
# removing the tip's spelling beside its new one renames it
_REFUSE_CASE_CLASH () {
	# Args: <tip> <tree>
	[ "$(git config --type=bool core.ignorecase 2>/dev/null)" = true ] || return 0
	local P X C F OTHER
	local -a ADDED NAMES
	local -A AT_TIP FIRST SECOND
	local -i K
	ADDED=(${(0)"$(git diff-tree -r -z --no-renames --name-only --diff-filter=A "$1" "$2")"})
	(( ${#ADDED} )) || return 0
	for X in ${(0)"$(git ls-tree -r -t -z --name-only --full-tree "$1")"}; do AT_TIP[$X]=1; done
	NAMES=(${(0)"$(git ls-tree -r -t -z --name-only --full-tree "$2")"})
	_FOLD_CASE "${NAMES[@]}"
	for (( K = 1; K <= ${#NAMES}; K++ )); do
		F=${reply[K]}
		if (( ! ${+FIRST[$F]} )); then FIRST[$F]=${NAMES[K]}; else SECOND[$F]=${NAMES[K]}; fi
	done
	for P in "${ADDED[@]}"; do
		X=""
		for C in "${(@s:/:)P}"; do
			X+="${X:+/}$C"
			# The tip spelling it exactly settles it, whatever other spelling sits beside it there
			(( ${+AT_TIP[$X]} )) && continue
			_FOLD_CASE "$X"
			(( ${+SECOND[${reply[1]}]} )) || continue
			OTHER=${FIRST[${reply[1]}]}
			[ "$OTHER" = "$X" ] && OTHER=${SECOND[${reply[1]}]}
			# A directory goes by its files, which whole files and `--rm` alike name one by one
			if (( ${+AT_TIP[$OTHER]} )) && [ "$(git cat-file -t "$1:$OTHER" 2>/dev/null)" = tree ]; then
				PRINT_ERR "$X differs from the tip's directory $OTHER only in case – one name to this filesystem, so spell it as the tip does, or rename it by removing each file under $OTHER/ by its tip spelling in the same run"
			elif (( ${+AT_TIP[$OTHER]} )); then
				PRINT_ERR "$X differs from the tip's $OTHER only in case – one name to this filesystem, so spell it as the tip does, or rename it by removing $OTHER in the same run"
			else
				PRINT_ERR "$X and $OTHER differ only in case – one name to this filesystem"
			fi
			exit 1
		done
	done
}

# Puts into `reply` where a run reading checkout paths stands, in one git call per kind – the
# toplevel, the prefix, `core.ignorecase` and `core.precomposeUnicode` as bools, and the merge,
# cherry-pick or revert in progress, as `_PICK_IN_PROGRESS` names it
_CHECKOUT_CONTEXT () {
	local L PICK=""
	local -a AT
	local -A CFG
	AT=("${(@f)$(git rev-parse --show-toplevel --show-prefix --absolute-git-dir 2>/dev/null)}")
	# A name holding a newline splits into more lines, a failed lookup into fewer – asked apart then
	(( ${#AT} == 3 )) || AT=("$(git rev-parse --show-toplevel)" "$(git rev-parse --show-prefix)" \
		"$(git rev-parse --absolute-git-dir)")
	# The last of a key's values wins, as `git config --get` reads it – a non-bool value as written
	for L in ${(f)"$(git config --type=bool-or-str --get-regexp '^(core\.(ignorecase|precomposeunicode)|extensions\.refstorage)$' 2>/dev/null)"}; do
		CFG[${L%% *}]=${L#* }
	done
	_REF_STORAGE=${CFG[extensions.refstorage]:-files}
	_PICK_IN_PROGRESS "${AT[1]}" "${AT[3]}" && PICK=$REPLY
	reply=("${AT[1]}" "${AT[2]}" "${CFG[core.ignorecase]}" "${CFG[core.precomposeunicode]}" "$PICK")
}

# Reads whole-file paths as `git commit -- <paths>` takes them, from where the caller stands –
# each a file or link in the checkout, or one the tip has and the checkout lost
_WHOLE_PATHS () {
	# Args: <path>... – fills the caller's WHOLE_PATHS, repo-relative and each once, and its
	# WHOLE_GONE with those of them a case-only rename removes
	_CHECKOUT_CONTEXT
	local TOP=${reply[1]} PREFIX=${reply[2]} GIVEN P AT_TIP E FAIL=""
	local ICASE=${reply[3]} S
	local PRECOMPOSE=${reply[4]}
	local -A RESPELT UNMERGED TREE_ENT TAG IGNORED SEEN
	local -a GIVENS PS GONE_AT_TIP NEW_HERE CHANGED
	local -i K
	# Taking files whole mid-merge splits the merge, the partial commit `git commit` refuses too
	if [ -n "${reply[5]}" ]; then
		PRINT_ERR "A ${${${reply[5]%_HEAD}//_/-}:l} is in progress – finish it with git commit before taking files whole"
		exit 1
	fi
	WHOLE_PATHS=()
	# Each name read first, up to one naming no file, refused once those before it pass
	for GIVEN in "$@"; do
		if [[ "$GIVEN" == *$'\n'* ]]; then
			FAIL="$(_SHQ "$GIVEN") has a newline in its name – commit it with git commit"
			break
		fi
		if [[ "$GIVEN" == /* ]]; then
			P=${GIVEN:h:A}/${GIVEN:t}
			[[ "$P" == "${TOP:A}/"?* ]] && P=${P#"${TOP:A}/"} || P=""
		else
			# Under a stand-in root, so a `..` past the top shows instead of normalizing away
			P=${${:-/@top@/$PREFIX$GIVEN}:a}
			[[ "$P" == /@top@/?* ]] && P=${P#/@top@/} || P=""
		fi
		if [ -z "$P" ]; then
			# The top itself, as `.` there names it
			if [[ "$GIVEN" == /* && "${GIVEN:A}" == "${TOP:A}" ]] || [[ "$GIVEN" != /* && "${${:-/@top@/$PREFIX$GIVEN}:a}" == /@top@ ]]; then
				FAIL="$GIVEN is a directory – name its files"
			else
				FAIL="$GIVEN names no file inside the repository"
			fi
			break
		fi
		[ "$PRECOMPOSE" = true ] && [[ "$P" == *[^[:ascii:]]* ]] && P=$(_COMPOSED "$P")
		GIVENS+=("$GIVEN") PS+=("$P")
	done
	# Then what git holds for all of them, a call per kind – as a pathspec reaches them, an unmerged
	# entry counting for each directory above it, a first `ls-files -t` entry for each one above too
	if (( ${#PS} )); then
		for E in ${(0)"$(git -C "$TOP" ls-files -u -z 2>/dev/null)"}; do
			P=${E#*$'\t'}
			while :; do UNMERGED[$P]=1; [[ "$P" == */* ]] || break; P=${P:h}; done
		done
		_TREE_ENTRIES HEAD "${PS[@]}"
		for P in "${PS[@]}"; do
			[ -d "$TOP/$P" ] && [ ! -L "$TOP/$P" ] && continue
			if [ ! -e "$TOP/$P" ] && [ ! -L "$TOP/$P" ]; then
				[[ "${TREE_ENT[$P]}" == ?* && "${TREE_ENT[$P]}" != "040000 "* ]] && GONE_AT_TIP+=("$P")
			elif [ -z "${TREE_ENT[$P]}" ]; then
				NEW_HERE+=("$P")
			fi
		done
		for E in ${(0)"$(_GIT_PATH_CHUNKS --literal-pathspecs -C "$TOP" ls-files -t -z -- "${GONE_AT_TIP[@]}" 2>/dev/null)"}; do
			P=${E#* }
			while :; do (( ${+TAG[$P]} )) || TAG[$P]=${E%% *}; [[ "$P" == */* ]] || break; P=${P:h}; done
		done
		for E in ${(0)"$(_GIT_PATH_CHUNKS --literal-pathspecs -C "$TOP" ls-files -z --others --ignored --exclude-standard -- "${NEW_HERE[@]}" 2>/dev/null)"}; do
			while :; do IGNORED[$E]=1; [[ "$E" == */* ]] || break; E=${E:h}; done
		done
	fi
	for (( K = 1; K <= ${#PS}; K++ )); do
		GIVEN=${GIVENS[K]} P=${PS[K]}
		# An unmerged file holds a resolution still to stage, as `git commit` refuses it too
		if (( ${+UNMERGED[$P]} )); then
			PRINT_ERR "$GIVEN is unmerged – resolve it and git add it first"
			exit 1
		fi
		AT_TIP=${TREE_ENT[$P]%% *}
		if [ -d "$TOP/$P" ] && [ ! -L "$TOP/$P" ]; then
			if [ "$AT_TIP" = "160000" ] || [[ "$(git -C "$TOP" ls-files -s -- ":(literal)$P" 2>/dev/null)" == 160000\ * ]]; then
				_REFUSE_WHOLE_SUBMODULE "$GIVEN" "$P" "$TOP"
			else
				PRINT_ERR "$GIVEN is a directory – name its files"
				# Its changed files, spelled from the name given, to name instead
				for E in ${(0)"$(git --no-optional-locks -C "$TOP" status --porcelain -z --no-renames --untracked-files=all -- ":(literal)$P" 2>/dev/null)"}; do
					CHANGED+=("${GIVEN%/}/${${E[4,-1]}#$P/}")
				done
				(( ${#CHANGED} )) && ECHO_E "\e[0;31m  Changed in it: $(_LIT "$(_ALL_PATHS -q "${CHANGED[@]}")")\e[0m" >&2
			fi
			exit 1
		elif [ ! -e "$TOP/$P" ] && [ ! -L "$TOP/$P" ]; then
			if [ -z "$AT_TIP" ]; then
				PRINT_ERR "$GIVEN: no such file, in the checkout or at the tip"
				exit 1
			elif [ "$AT_TIP" = "040000" ]; then
				PRINT_ERR "$GIVEN is a directory at the tip – name its files"
				exit 1
			# Outside a sparse checkout a file is absent by design, as `git commit` reads it too
			elif [ "${TAG[$P]}" = S ]; then
				PRINT_ERR "$GIVEN lies outside the sparse checkout – its absence there is no deletion"
				exit 1
			fi
		# As `git add` refuses one it does not track
		elif [ -z "$AT_TIP" ] && (( ${+IGNORED[$P]} )); then
			PRINT_ERR "$GIVEN is ignored, and the tip lacks it – git add would not take it either"
			exit 1
		fi
		# A tip path the checkout spells only otherwise – where case tells no names apart, its own
		# lookup finds that file under the other spelling
		if [ "$ICASE" = true ] && [ -n "$AT_TIP" ] && [ -e "$TOP/$P" ] && [ ! -L "$TOP/$P" ]; then
			S=${${:-$TOP/$P}:A}
			if [[ "$S" == "${TOP:A}/"?* ]]; then
				S=${S#"${TOP:A}/"}
				[ "$PRECOMPOSE" = true ] && [[ "$S" == *[^[:ascii:]]* ]] && S=$(_COMPOSED "$S")
				_FOLD_CASE "$S" "$P"
				[ "$S" != "$P" ] && [ "${reply[1]}" = "${reply[2]}" ] && RESPELT[$P]=$S
			fi
		fi
		(( ${+SEEN[$P]} )) || { SEEN[$P]=1; WHOLE_PATHS+=("$P"); }
	done
	if [ -n "$FAIL" ]; then
		PRINT_ERR "$FAIL"
		exit 1
	fi
	# Its old side of a case-only rename where that other spelling is named too – removed, as the
	# file now goes by the new name
	WHOLE_GONE=()
	for P in "${(@k)RESPELT}"; do
		(( ${WHOLE_PATHS[(Ie)${RESPELT[$P]}]} )) && WHOLE_GONE+=("$P")
	done
}

# Refuses a submodule named to take whole – read from the checkout it is a directory, its
# pointer no file – naming the route that records the pointer: staged and folded, or committed
# in `--exec`, whose worktree has no submodule checked out, so the pointer is set by hand there
_REFUSE_WHOLE_SUBMODULE () {
	# Args: <path as given> <path from the top> <top>
	local SHA REL INNER
	if [ ${#OPT_COMMIT} -gt 0 ]; then
		PRINT_ERR "$1 is a submodule – taking it whole records no pointer, so nothing was committed"
		SHA=$(git -C "$3/$2" rev-parse -q --verify HEAD 2>/dev/null) || SHA="<sha>"
		# From where the caller stands, as the command runs there
		REL=$(git rev-parse --show-cdup 2>/dev/null)$2
		INNER="git update-index --cacheinfo 160000,$SHA,$(_SHQ "$REL") && git commit -m \"…\""
		ECHO_E "\e[0;31m  Commit its pointer at the tip: $(_LIT "git edit --exec -- sh -c $(_SHQ "$INNER")")\e[0m" >&2
	else
		PRINT_ERR "$1 is a submodule – taking it whole records no pointer, so nothing was folded"
		SHA="<sha>"
		[[ -n "$AMEND_INTO_TARGET" && "$AMEND_INTO_TARGET" != auto ]] && SHA=${AMEND_INTO_TARGET:0:7}
		ECHO_E "\e[0;31m  Stage its pointer and fold that: $(_LIT "$(_PATHS_CMD "git add" "$1") && $(_PATHS_CMD "git edit --amend-into=$SHA" "$1")")\e[0m" >&2
	fi
	exit 1
}

# Prints <path> composed as git spells it – macOS hands a typed or pasted name over decomposed,
# which git composes on the way in, so every name it hands back would read as another – or as
# given where iconv can't read it, as git keeps it then
_COMPOSED () {
	# Args: <path>
	local OUT
	if OUT=$(print -rn -- "$1" | iconv -f UTF-8-MAC -t UTF-8 2>/dev/null); then
		print -rn -- "$OUT"
	else
		print -rn -- "$1"
	fi
}

# Composes the tip's tree with whole files from the checkout, in a private index – read as
# `git add` reads them, filters, executable bit and links included, the shared index untouched
_COMPOSE_WHOLE () {
	# Args: <path>... – sets WHOLE_PATHS, WHOLE_HEAD and WHOLE_TREE
	local -a WHOLE_GONE
	_WHOLE_PATHS "$@"
	if ! WHOLE_HEAD=$(git rev-parse --verify -q HEAD); then
		PRINT_ERR "No commit to build on – the branch has none yet"
		exit 1
	fi
	local TOP=$(git rev-parse --show-toplevel) IDX=$(MKTEMP_FILE git-edit-index) ERR P
	_TEMP_FILES+=("$IDX")
	_RECORD_WHOLE_IDX "$TOP"
	# An empty file is no index – read-tree writes its own
	rm -f "$IDX"
	if ! ERR=$(cd "$TOP" && GIT_INDEX_FILE=$IDX git read-tree "$WHOLE_HEAD" 2>&1 && \
		{ print -rN -- "${(@)WHOLE_PATHS:|WHOLE_GONE}" | GIT_INDEX_FILE=$IDX git update-index --add --remove -z --stdin; } 2>&1 && \
		{ (( ! ${#WHOLE_GONE} )) || print -rN -- "${WHOLE_GONE[@]}" | GIT_INDEX_FILE=$IDX git update-index --force-remove -z --stdin; } 2>&1); then
		PRINT_ERR "Could not take those files: ${ERR//$'\n'/ }"
		exit 1
	fi
	WHOLE_TREE=$(GIT_INDEX_FILE=$IDX git write-tree)
	rm -f "$IDX"
	if [ "$WHOLE_TREE" = "$(git rev-parse "$WHOLE_HEAD^{tree}")" ]; then
		PRINT_ERR "Nothing to take – each of the ${#WHOLE_PATHS} file(s) named is as the tip has it"
		exit 1
	fi
	_REFUSE_CASE_CLASH "$WHOLE_HEAD" "$WHOLE_TREE"
}

# Records each of `WHOLE_PATHS`' index entries as it stands before the landing – a peer staging one
# in between then differs from it, keeping that staging through the re-sync
_RECORD_WHOLE_IDX () {
	# Args: <top>
	local P E
	local -A WANT ENT CONFLICT
	WHOLE_IDX=()
	for P in "${WHOLE_PATHS[@]}"; do WANT[$P]=1; done
	# One `ls-files` – each entry counting for a path named at it or above it, as a pathspec reaches
	# it, the last at stage 0 kept, `conflict` where any is at another
	for E in ${(0)"$(_GIT_PATH_CHUNKS -C "$1" --literal-pathspecs ls-files -s -z -- "${WHOLE_PATHS[@]}" 2>/dev/null)"}; do
		P=${E#*$'\t'}
		E=${E%%$'\t'*}
		while :; do
			if (( ${+WANT[$P]} )); then
				if [ "${E##* }" != 0 ]; then CONFLICT[$P]=1; else ENT[$P]=${E% *}; fi
			fi
			[[ "$P" == */* ]] || break
			P=${P:h}
		done
	done
	for P in "${WHOLE_PATHS[@]}"; do
		if (( ${+CONFLICT[$P]} )); then WHOLE_IDX[$P]=conflict; else WHOLE_IDX[$P]=${ENT[$P]}; fi
	done
}

# Takes a commit composed on the tip as `--commit`'s tree – pinned to that tip, which a parent
# other than `HEAD` refuses, as a fold's `--tree` does
_COMPOSE_FROM_TREE () {
	local PARENT
	if ! WHOLE_HEAD=$(git rev-parse --verify -q HEAD); then
		PRINT_ERR "No commit to build on – the branch has none yet"
		exit 1
	fi
	if ! WHOLE_TREE=$(_PEEL_SHA "$AMEND_TREE" tree); then
		PRINT_ERR "Unknown <tree-ish>: $AMEND_TREE"
		exit 1
	fi
	PARENT=$(git rev-parse -q --verify "$(_PEEL_SHA "$AMEND_TREE" commit)^" 2>/dev/null)
	if [ "$PARENT" != "$WHOLE_HEAD" ]; then
		PRINT_ERR "--commit --tree takes a commit composed on the tip ${WHOLE_HEAD:0:7}${PARENT:+ – $AMEND_TREE rests on ${PARENT:0:7}}${PARENT:-, its parent pinning what it was composed on}"
		exit 1
	fi
	WHOLE_PATHS=(${(0)"$(git -c core.quotePath=false diff-tree -r -z --name-only "$WHOLE_HEAD" "$WHOLE_TREE")"})
	if [ ${#WHOLE_PATHS} -eq 0 ]; then
		PRINT_ERR "--tree $AMEND_TREE differs from the tip in nothing – nothing to commit"
		exit 1
	fi
	_REFUSE_CASE_CLASH "$WHOLE_HEAD" "$WHOLE_TREE"
	# Nothing read from the checkout supersedes what is staged there – entries off the old tip stay
	WHOLE_IDX=()
}

# Decodes one JSON string's content into `REPLY` – `\\` and `\"` already held as \x01 and \x02 –
# failing on a raw control character, an unknown escape or a lone surrogate
_EDITS_DECODE () {
	local S=$1 HEAD PIECE
	local -a PIECES
	local -i K CP HI B
	[[ "$S" == *[$'\x03'-$'\x1f']* ]] && return 1
	# Split and joined, then walked once – a `${S//…}`, an index or an array append each cost the
	# text's length, a string append the least
	S=${(pj:/:)"${(@ps:\x5c/:)S}"}
	S=${(pj:\b:)"${(@ps:\x5cb:)S}"} S=${(pj:\f:)"${(@ps:\x5cf:)S}"} S=${(pj:\n:)"${(@ps:\x5cn:)S}"}
	S=${(pj:\r:)"${(@ps:\x5cr:)S}"} S=${(pj:\t:)"${(@ps:\x5ct:)S}"}
	# Any backslash left but a `\u` opened an escape JSON has no use for
	[[ "$S" == *\\([^u]*|) ]] && return 1
	PIECES=("${(@ps:\\u:)S}")
	REPLY= K=0 HI=0
	for PIECE in "${PIECES[@]}"; do
		K+=1
		if (( K > 1 )); then
			HEAD=${PIECE[1,4]}
			[[ "$HEAD" == [[:xdigit:]][[:xdigit:]][[:xdigit:]][[:xdigit:]] ]] || return 1
			CP=$(( 16#$HEAD ))
			PIECE=${PIECE[5,-1]}
			# A high surrogate's low half opens the next piece, which nothing may come before
			if (( HI )); then
				(( CP >= 0xDC00 && CP <= 0xDFFF )) || return 1
				CP=$(( 0x10000 + ((HI - 0xD800) << 10) + (CP - 0xDC00) )) HI=0
			elif (( CP >= 0xD800 && CP <= 0xDBFF )); then
				[ -z "$PIECE" ] || return 1
				HI=$CP
				continue
			elif (( CP >= 0xDC00 && CP <= 0xDFFF )); then
				return 1
			fi
			# As UTF-8, a byte at a time
			if (( CP < 0x80 )); then
				REPLY+=${(#)CP}
			elif (( CP < 0x800 )); then
				B=$(( 0xC0 | CP >> 6 )); REPLY+=${(#)B}
				B=$(( 0x80 | CP & 0x3F )); REPLY+=${(#)B}
			elif (( CP < 0x10000 )); then
				B=$(( 0xE0 | CP >> 12 )); REPLY+=${(#)B}
				B=$(( 0x80 | CP >> 6 & 0x3F )); REPLY+=${(#)B}
				B=$(( 0x80 | CP & 0x3F )); REPLY+=${(#)B}
			else
				B=$(( 0xF0 | CP >> 18 )); REPLY+=${(#)B}
				B=$(( 0x80 | CP >> 12 & 0x3F )); REPLY+=${(#)B}
				B=$(( 0x80 | CP >> 6 & 0x3F )); REPLY+=${(#)B}
				B=$(( 0x80 | CP & 0x3F )); REPLY+=${(#)B}
			fi
		fi
		# The held `\` and `"` come back per piece, after the character decoded before it, so one
		# decoded as \x01 or \x02 stays itself
		PIECE=${(pj:\x5c:)"${(@ps:\x01:)PIECE}"}
		REPLY+=${(pj:\x22:)"${(@ps:\x02:)PIECE}"}
	done
	(( HI == 0 ))
}

# Parses `--edits` – {"<path>": [["<old>", "<new>"], ...]} and nothing else – into the parallel
# arrays `EDITS_PATH`, `EDITS_OLD` and `EDITS_NEW` in the order given, byte for byte, or refuses
# Its own, needing no more than zsh and git – split and joined, then walked once, as substitutions,
# indexes and array appends in a loop each made a large input quadratic
_EDITS_PARSE () {
	# Args: <JSON text>
	setopt local_options no_multibyte
	local J=$1 SHAPE='{"<path>": [["<old>", "<new>"], ...]}' KEY OLD PART TOK VAL NEXT ST=open
	local -a PARTS TOKS
	local -A SEEN WANTS=(open "'{'" obj "a string or '}'" key 'a string' colon "':'" list "'['"
		items "'[' or ']'" pair "'['" old 'a string' comma "','" new 'a string' close "']'"
		more "',' or ']'" after "',' or '}'")
	local -i K
	typeset -ga EDITS_PATH EDITS_OLD EDITS_NEW
	EDITS_PATH=() EDITS_OLD=() EDITS_NEW=()
	# Raw control characters are JSON nowhere, which frees two to hold the escaped `\` and `"`
	if [[ "$J" == *$'\0'* || "$J" == *[$'\x01'-$'\x08'$'\x0b'$'\x0c'$'\x0e'-$'\x1f']* ]]; then
		PRINT_ERR "--edits takes $SHAPE – a raw control character, which JSON escapes"
		exit 1
	fi
	J=${(pj:\x01:)"${(@ps:\x5c\x5c:)J}"}
	J=${(pj:\x02:)"${(@ps:\x5c\x22:)J}"}
	PARTS=("${(@ps:\":)J}")
	if (( ${#PARTS} % 2 == 0 )); then
		PRINT_ERR "--edits takes $SHAPE – a string left open"
		exit 1
	fi
	# Punctuation and strings in turn, whitespace dropped, each token stepping the state `ST` – in
	# the loop itself, as a function call per token grows zsh's heap with the input
	K=0
	for PART in "${PARTS[@]}"; do
		K+=1
		if (( K % 2 )); then
			PART=${PART//[$' \t\n\r']/}
			# Between strings only punctuation – a bare word would read as a string's place
			if [[ "$PART" == *[^\{\}\[\]:,]* ]]; then
				PRINT_ERR "--edits takes $SHAPE – a value outside quotes, where only strings belong"
				exit 1
			fi
			TOKS=(${(s::)PART})
		else
			# A string holding no escape, placeholder or control character is its own decoding
			if [[ "$PART" == *[$'\\'$'\x01'-$'\x1f']* ]]; then
				_EDITS_DECODE "$PART" || { PRINT_ERR "--edits takes $SHAPE – string $(( K / 2 )) holds an escape or character JSON does not allow"; exit 1; }
				VAL=$REPLY
			else
				VAL=$PART
			fi
			TOKS=(S)
		fi
		for TOK in "${TOKS[@]}"; do
			NEXT=
			case "$ST:$TOK" in
				open:\{) NEXT=obj ;;
				obj:\}|after:\}) NEXT=end ;;
				obj:S|key:S)
					if (( ${+SEEN[$VAL]} )); then
						PRINT_ERR "--edits names $(_SHQ "$VAL") twice – give each path one list of edits"
						exit 1
					fi
					SEEN[$VAL]=1 KEY=$VAL NEXT=colon ;;
				colon::) NEXT=list ;;
				list:\[) NEXT=items ;;
				items:\]|more:\]) NEXT=after ;;
				items:\[|pair:\[) NEXT=old ;;
				old:S) OLD=$VAL NEXT=comma ;;
				comma:,) NEXT=new ;;
				new:S) EDITS_PATH+=("$KEY") EDITS_OLD+=("$OLD") EDITS_NEW+=("$VAL") NEXT=close ;;
				close:\]) NEXT=more ;;
				more:,) NEXT=pair ;;
				after:,) NEXT=key ;;
			esac
			if [ -z "$NEXT" ]; then
				if [ "$ST" = end ]; then
					PRINT_ERR "--edits takes $SHAPE – nothing may follow it"
				else
					PRINT_ERR "--edits takes $SHAPE – ${WANTS[$ST]} expected where ${${TOK:#S}:+'$TOK'}${${(M)TOK:#S}:+a string} stands"
				fi
				exit 1
			fi
			ST=$NEXT
		done
	done
	if [ "$ST" != end ]; then
		PRINT_ERR "--edits takes $SHAPE – ${WANTS[$ST]} expected where the end stands"
		exit 1
	fi
}

# Tells whether the run names any of the inputs `--commit` and `--amend-into` compose from
_INPUTS_GIVEN () {
	(( ${#OPT_PATCH} + ${#OPT_PUT} + ${#OPT_EDITS} + ${#OPT_RM} + ${#OPT_CHMOD} > 0 ))
}

# Reads a repeatable option's values, as given glued or apart, into `reply`
_OPT_VALUES () {
	# Args: <option array name> – the `=` zparseopts keeps dropped where the value was glued on alone
	local -a A=("${(@P)1}")
	local FORMS=${INPUT_FORMS[--${${1#OPT_}:l}]}
	local -i K
	reply=()
	for (( K = 2; K <= ${#A}; K += 2 )); do
		if [ "${FORMS[K/2]}" = a ]; then reply+=("${A[K]}"); else reply+=("${A[K]#=}"); fi
	done
}

# Resolves an input's path as `git commit` reads one, from where the caller stands, to the repo's
# own spelling – a name outside it refuses
_INPUT_PATH () {
	# Args: <flag> <path> – sets `REPLY`, reads the caller's `_IN_PRECOMPOSE`
	local P
	if [[ "$2" == *$'\n'* ]] || [ -z "$2" ]; then
		PRINT_ERR "$1 names no path git can take: $(_SHQ "$2")"
		exit 1
	fi
	if [[ "$2" == /* ]]; then
		P=${2:h:A}/${2:t}
		[[ "$P" == "${_IN_TOP:A}/"?* ]] && P=${P#"${_IN_TOP:A}/"} || P=""
	else
		P=${${:-/@top@/$_IN_PREFIX$2}:a}
		[[ "$P" == /@top@/?* ]] && P=${P#/@top@/} || P=""
	fi
	if [ -z "$P" ]; then
		PRINT_ERR "$1 $2 names no file inside the repository"
		exit 1
	fi
	[ "$_IN_PRECOMPOSE" = true ] && [[ "$P" == *[^[:ascii:]]* ]] && P=$(_COMPOSED "$P")
	REPLY=$P
}

# Prints the "<mode> <blob>" the composer's index holds at exactly <path> – nothing for a path it
# lacks or a directory, whose files a pathspec would name instead
_INPUT_ENTRY () {
	local REC
	for REC in "${(@0)$(GIT_INDEX_FILE=$IDX git -C "$_IN_TOP" ls-files -s -z -- ":(top,literal)$1")}"; do
		[ "${REC#*$'\t'}" = "$1" ] && { print -r -- "${${REC%%$'\t'*}% *}"; return 0; }
	done
	return 0
}

# Puts into `REPLY` <path from the top> as an input names it from where the caller stands – from
# the caller's directory down, else absolute
_INPUT_SPELLING () {
	# Args: <path from the top> – reads the composer's `_IN_TOP` and `_IN_PREFIX`
	if [ -z "$_IN_PREFIX" ]; then REPLY=$1
	elif [[ "$1" == "$_IN_PREFIX"?* ]]; then REPLY=${1#"$_IN_PREFIX"}
	else REPLY=$_IN_TOP/$1
	fi
}

# Puts into `REPLY` the path <path as given> names read from the top instead of from where the
# caller stands – returns 1 where both readings are one, from the top or an absolute path
_INPUT_TOP_READING () {
	# Args: <path as given> – reads the composer's `_IN_PREFIX` and `_IN_PRECOMPOSE`
	REPLY=""
	[ -n "$_IN_PREFIX" ] && [[ "$1" != /* ]] || return 1
	REPLY=${${:-/@top@/$1}:a}
	[[ "$REPLY" == /@top@/?* ]] || { REPLY=""; return 1; }
	REPLY=${REPLY#/@top@/}
	[ "$_IN_PRECOMPOSE" = true ] && [[ "$REPLY" == *[^[:ascii:]]* ]] && REPLY=$(_COMPOSED "$REPLY")
	return 0
}

# Refuses a `--put` from a subdirectory of a path new to the tip where the same name read from the
# top is a tracked path – a name spelled from the top would silently add a file beside it, where
# `--edits` refuses the same spelling
_REFUSE_PUT_READINGS () {
	# Args: <path from the top> <path as given> – reads the composer's `_IN_TOP` and `_IN_PREFIX`
	local P=$1 GIVEN=$2 ALT KEY
	_INPUT_TOP_READING "$GIVEN" || return 0
	ALT=$REPLY
	[ -n "$(_INPUT_ENTRY "$ALT")" ] || return 0
	_INPUT_SPELLING "$ALT"
	KEY=$REPLY
	PRINT_ERR "--put $GIVEN: new to the tip – paths are read from where you stand, $_IN_PREFIX, so it names $P, while $ALT, its reading from the top, is tracked"
	ECHO_E "\e[0;31m  Nothing landed – put $(_LIT "$(_SHQ "$KEY")")=<file> for $ALT, or $(_LIT "$(_SHQ "$_IN_TOP/$P")")=<file> to add $P, then run this again.\e[0m" >&2
	exit 1
}

# Refuses an `--edits` path holding no file at the tip, naming what stands there instead – the
# commit that renamed or removed it, or the file a key read from the top names
_REFUSE_EDITS_NO_FILE () {
	# Args: <path from the top> <path as given> <"<mode> <blob>" the composer's index holds, or none>
	local P=$1 GIVEN=$2 C NEW ALT WHAT KEY
	local -a RF
	local -i RI
	case "${3%% *}" in
		120000) PRINT_ERR "--edits $GIVEN: not a file at the tip, a symlink – put a link onto it to repoint it" ;;
		160000) PRINT_ERR "--edits $GIVEN: not a file at the tip, a submodule – commit inside it instead" ;;
		*)
			if [ -n "$(GIT_INDEX_FILE=$IDX git -C "$_IN_TOP" ls-files -- ":(top,literal)$P/" 2>/dev/null | head -1)" ]; then
				PRINT_ERR "--edits $GIVEN: not a file at the tip, a directory – key the edits by each file in it"
				exit 1
			fi
			# Gone in history – read as a deletion, as the old name alone sees a rename
			C=$(git -c log.follow=false log -1 --format=%H --diff-filter=D "$WHOLE_HEAD" -- ":(top,literal)$P" 2>/dev/null)
			if [ -n "$C" ]; then
				RF=("${(@0)$(git diff -z -M --name-status --diff-filter=R "$C^" "$C" 2>/dev/null)}")
				for (( RI = 1; RI + 2 <= ${#RF}; RI += 3 )); do
					[ "${RF[RI + 1]}" = "$P" ] && NEW=${RF[RI + 2]} && break
				done
				WHAT=$(git log -1 --format='%h (%s)' "$C")
				if [ -n "$NEW" ] && [[ "$(_INPUT_ENTRY "$NEW")" == (100644|100755)\ * ]]; then
					_INPUT_SPELLING "$NEW"
					KEY=$REPLY
					PRINT_ERR "--edits $GIVEN: not a file at the tip – $WHAT renamed it to $NEW"
					ECHO_E "\e[0;31m  Edit it under that name, keying the edits $(_LIT "$(_SHQ "$KEY")"), then run this again.\e[0m" >&2
					exit 1
				fi
				[ -n "$NEW" ] && WHAT+=" renamed it to $NEW, which is gone since" || WHAT+=" removed it"
				PRINT_ERR "--edits $GIVEN: not a file at the tip – $WHAT"
				ECHO_E "\e[0;31m  See why with 'git show --stat ${C:0:12}' – put the file back only where that is meant, as --put <path>=<file> --base=${WHOLE_HEAD:0:12}\e[0m" >&2
				exit 1
			fi
			# A key spelled from the top, given from a subdirectory
			if _INPUT_TOP_READING "$GIVEN"; then
				ALT=$REPLY
				if [[ "$(_INPUT_ENTRY "$ALT")" == (100644|100755)\ * ]]; then
					_INPUT_SPELLING "$ALT"
					KEY=$REPLY
					PRINT_ERR "--edits $GIVEN: not a file at the tip – paths are read from where you stand, $_IN_PREFIX, so it names $P"
					ECHO_E "\e[0;31m  For $ALT, key the edits $(_LIT "$(_SHQ "$KEY")"), then run this again.\e[0m" >&2
					exit 1
				fi
			fi
			PRINT_ERR "--edits $GIVEN: not a file at the tip – --put it if it is new"
			;;
	esac
	exit 1
}

# Puts into `REPLY` how often <old> occurs in <text> – occurrences overlapping the first counted
# too, `}\n}\n` twice in `}\n}\n}\n` – each `--edits` old text must count 1, composed on the tip
# or resolving a fold's stop
_EDIT_MATCHES () {
	# Args: <text> <old>
	setopt local_options no_multibyte
	local LEAD
	REPLY=$(( (${#1} - ${#${1//$2}}) / ${#2} ))
	if (( REPLY == 1 )); then
		LEAD=${1%%$2*}
		[[ ${1[${#LEAD}+2,-1]} == *$2* ]] && REPLY=2
	fi
	return 0
}

# Puts into `REPLY` an edit's old text as a refusal shows it – its first 60 bytes, quoted on one
# line, as a newline inside quotes would split the message
_EDIT_SHOWN () {
	# Args: <old text>
	if [[ "$1" == *$'\n'* ]]; then REPLY=${(qqqq)${1[1,60]}}; else REPLY=$(_SHQ "${1[1,60]}"); fi
}

# Refuses a path named after `--` to take whole and by an input too, naming both ways
_REFUSE_TAKEN_TWICE () {
	# Args: <path from the top> <the input's flag> – reads the composer's `_IN_TOP` and `_IN_PREFIX`
	_INPUT_SPELLING "$1"
	PRINT_ERR "$REPLY: named after -- to take whole, and by $2 too – nothing landed"
	ECHO_E "\e[0;31m  Name it one way: drop it after -- to take only the $2 change, or drop the $2 to take the checkout's file whole.\e[0m" >&2
	exit 1
}

# Composes the tip's tree with the caller's own changes – patches, whole replacements, edits
# replayed onto the tip's text, mode bits and removals, in that order, then files taken whole – in
# a private index, so a peer's line in the same checkout file never comes along and the shared
# index stays untouched
_COMPOSE_INPUTS () {
	# Args: <"commit" or "fold"> [<path taken whole>...] – sets WHOLE_HEAD, WHOLE_TREE, WHOLE_PATHS
	# and WHOLE_IDX, `_INPUT_FLIPS` to the mode flips `--chmod` named, `_INPUT_WHOLE` to the files
	# taken whole
	local -a TAKEN WHOLE_GONE
	_INPUT_WHOLE=0
	# Files taken whole are named and checked as `-- <paths>` alone takes them
	if [ $# -gt 1 ]; then
		_WHOLE_PATHS "${@:2}"
		TAKEN=("${WHOLE_PATHS[@]}")
	fi
	setopt local_options no_multibyte
	_CHECKOUT_CONTEXT
	local _IN_TOP=${reply[1]} _IN_PREFIX=${reply[2]}
	local _IN_PRECOMPOSE=${reply[4]}
	local IDX=$(MKTEMP_FILE git-edit-index) ERR P SPEC SRC MODE BLOB TEXT OLD NEW BASE_AT TIP_AT FILE FILTER START
	local -a PATCHES PUTS PUT_SRCS PUT_GIVEN RMS CHMODS CHMOD_X NAMED FLIPS UNNAMED WHOLE_FLIPS
	local -A EDITS_GIVEN
	local -i K C HITS I J
	_TEMP_FILES+=("$IDX")
	# Mid-merge the commit would split it, as `git commit -- <paths>` refuses to
	if [ -n "${reply[5]}" ]; then
		PRINT_ERR "A ${${${reply[5]%_HEAD}//_/-}:l} is in progress – finish it with git commit before committing your own changes apart"
		exit 1
	fi
	typeset -ga EDITS_PATH EDITS_OLD EDITS_NEW
	EDITS_PATH=() EDITS_OLD=() EDITS_NEW=()
	if ! WHOLE_HEAD=$(git rev-parse --verify -q HEAD); then
		PRINT_ERR "No commit to build on – the branch has none yet"
		exit 1
	fi
	# Every value read and checked before anything is composed – a typo never reaches the index
	_OPT_VALUES OPT_PATCH
	for SPEC in "${reply[@]}"; do
		[ -f "$SPEC" ] || { PRINT_ERR "--patch $SPEC: no such file"; exit 1; }
		PATCHES+=("${SPEC:A}")
	done
	_OPT_VALUES OPT_PUT
	for SPEC in "${reply[@]}"; do
		if [[ "$SPEC" != ?*=?* ]]; then
			PRINT_ERR "--put takes <path>=<file>, got $(_SHQ "$SPEC")"
			exit 1
		fi
		# A path holding `=` splits where the rest names a file – a link as itself, as `git add` takes it
		FILE=
		for (( K = 1; K < ${#SPEC}; K++ )); do
			[ "${SPEC[K]}" = = ] && (( K > 1 )) || continue
			SRC=${SPEC[K+1,-1]}
			{ [ -f "$SRC" ] && [ ! -d "$SRC" ]; } || [ -L "$SRC" ] || continue
			if [ -n "$FILE" ]; then
				PRINT_ERR "--put $SPEC: splits into a path and an existing file more than one way – rename the file"
				exit 1
			fi
			FILE=$K
		done
		if [ -z "$FILE" ]; then
			[ -d "${SPEC#*=}" ] && PRINT_ERR "--put $SPEC: ${SPEC#*=} is a directory – put each file in it" || PRINT_ERR "--put $SPEC: no such file ${SPEC#*=}"
			exit 1
		fi
		SRC=${SPEC[FILE+1,-1]}
		_INPUT_PATH --put "${SPEC[1,FILE-1]}"
		if (( ${PUTS[(Ie)$REPLY]} )); then
			PRINT_ERR "--put $REPLY: named twice – put it once"
			exit 1
		fi
		PUTS+=("$REPLY") PUT_SRCS+=("${SRC:a}") PUT_GIVEN+=("${SPEC[1,FILE-1]}")
	done
	if [ ${#OPT_EDITS} -gt 0 ]; then
		_OPT_VALUES OPT_EDITS
		SPEC=${reply[1]}
		# Inline as `--edits "$(cat edits.json)"`, or a file – a pipe too – where only JSON quotes a path
		if [ -r "$SPEC" ] && [ ! -d "$SPEC" ]; then
			_EDITS_PARSE "$(<"$SPEC")"
		elif [[ "${SPEC//[[:space:]]/}" == \{* && ( "$SPEC" == *\"* || "${SPEC//[[:space:]]/}" == '{}' ) ]]; then
			_EDITS_PARSE "$SPEC"
		else
			PRINT_ERR "--edits $SPEC: no such file, nor inline JSON"
			exit 1
		fi
		for (( K = 1; K <= ${#EDITS_PATH}; K++ )); do
			_INPUT_PATH --edits "${EDITS_PATH[K]}"
			(( ${+EDITS_GIVEN[$REPLY]} )) || EDITS_GIVEN[$REPLY]=${EDITS_PATH[K]}
			EDITS_PATH[K]=$REPLY
		done
	fi
	_OPT_VALUES OPT_CHMOD
	for SPEC in "${reply[@]}"; do
		if [[ "$SPEC" != ?*=[+-]x ]]; then
			PRINT_ERR "--chmod takes <path>=+x or <path>=-x, got $(_SHQ "$SPEC")"
			exit 1
		fi
		_INPUT_PATH --chmod "${SPEC%=*}"
		# Said twice the same, as chmod takes it – both ways, one would silently win
		if (( ${CHMODS[(Ie)$REPLY]} )) && [ "${CHMOD_X[${CHMODS[(Ie)$REPLY]}]}" != "${SPEC##*=}" ]; then
			PRINT_ERR "--chmod $REPLY: named both +x and -x – give it one bit"
			exit 1
		fi
		CHMODS+=("$REPLY") CHMOD_X+=("${SPEC##*=}")
	done
	_OPT_VALUES OPT_RM
	for SPEC in "${reply[@]}"; do
		_INPUT_PATH --rm "$SPEC"
		if (( ${PUTS[(Ie)$REPLY]} + ${RMS[(Ie)$REPLY]} + ${EDITS_PATH[(Ie)$REPLY]} + ${CHMODS[(Ie)$REPLY]} )); then
			PRINT_ERR "--rm $REPLY: also named by another input – a removal takes the path alone"
			exit 1
		fi
		RMS+=("$REPLY")
	done
	# A file is taken whole or changed by an input – which one the caller meant is theirs to say
	for P in "${TAKEN[@]}"; do
		SPEC=
		(( ${PUTS[(Ie)$P]} )) && SPEC=--put
		(( ${EDITS_PATH[(Ie)$P]} )) && SPEC=--edits
		(( ${CHMODS[(Ie)$P]} )) && SPEC=--chmod
		(( ${RMS[(Ie)$P]} )) && SPEC=--rm
		[ -n "$SPEC" ] && _REFUSE_TAKEN_TWICE "$P" "$SPEC"
	done
	# Puts of checkout files onto their own paths alone are files taken whole, which that form takes
	# guarded against another caller's landing
	if [ ${#PUTS} -gt 0 ] && [ ${#PATCHES} -eq 0 ] && [ ${#OPT_EDITS} -eq 0 ] && [ ${#CHMODS} -eq 0 ] && [ ${#RMS} -eq 0 ]; then
		for (( K = 1; K <= ${#PUTS}; K++ )); do
			[ "${PUT_SRCS[K]}" -ef "$_IN_TOP/${PUTS[K]}" ] || break
		done
		if (( K > ${#PUTS} )); then
			PRINT_ERR "Every --put takes a checkout file onto its own path – take them whole, which refuses where that would take back what another caller landed: ${${1:#fold}:+git edit --commit --text \"…\" -- }${${1:#commit}:+git edit --amend-into=<sha> --whole -- }${(j: :)${(@q-)PUTS}}${TAKEN:+ ${(j: :)${(@q-)TAKEN}}}"
			exit 1
		fi
	fi
	# A put or removal replaces what the tip holds – where the caller names the commit it rests on,
	# a path changed since refuses rather than be reverted, a rename's old path most of all, as no
	# put check sees a path new to the tip – without one the landings below stand in for it
	for (( K = 1; K <= ${#PUTS} + ${#RMS}; K++ )); do
		[ -n "$EXEC_BASE" ] || break
		if (( K <= ${#PUTS} )); then P=${PUTS[K]} SPEC=--put; else P=${RMS[K - ${#PUTS}]} SPEC=--rm; fi
		TIP_AT=$(git rev-parse -q --verify "$WHOLE_HEAD:$P" 2>/dev/null)
		BASE_AT=$(git rev-parse -q --verify "$EXEC_BASE:$P" 2>/dev/null)
		if [ "$BASE_AT" != "$TIP_AT" ]; then
			_AT_TOP "$(git rev-parse --show-toplevel)"
			PRINT_ERR "$P: changed between --base ${EXEC_BASE:0:9} and the tip ${WHOLE_HEAD:0:9} (${REPLY}git log --oneline ${EXEC_BASE:0:9}..${WHOLE_HEAD:0:9} -- $(_QUOTE_PATHS "$P"))"
			if [ $SPEC = --put ]; then
				ECHO_E "\e[0;31m  Rebuild it from the tip and put it again, or replay your change with --edits, resting on the tip as --base=${WHOLE_HEAD:0:12} – as where taking it back is the point.\e[0m" >&2
			else
				ECHO_E "\e[0;31m  See whether it still goes, then remove it with the tip as --base.\e[0m" >&2
			fi
			exit 1
		fi
	done
	rm -f "$IDX"
	GIT_INDEX_FILE=$IDX git read-tree "$WHOLE_HEAD" || exit 1
	WHOLE_PATHS=()
	# Patches as cut, paths read from the top as `git apply` reads them – byte for byte, whatever the
	# repo's whitespace settings would strip, refuse or match loosely
	for FILE in "${PATCHES[@]}"; do
		if ! ERR=$(cd "$_IN_TOP" && GIT_INDEX_FILE=$IDX git -c apply.whitespace=nowarn -c apply.ignoreWhitespace=no apply --cached -- "$FILE" 2>&1); then
			PRINT_ERR "--patch ${FILE:t} does not apply to the tip: ${ERR//$'\n'/ }"
			exit 1
		fi
	done
	[ ${#PATCHES} -gt 0 ] && WHOLE_PATHS+=(${(0)"$(GIT_INDEX_FILE=$IDX git diff-index -z --cached --name-only "$WHOLE_HEAD")"})
	for P in "${TAKEN[@]}"; do
		(( ${WHOLE_PATHS[(Ie)$P]} )) && _REFUSE_TAKEN_TWICE "$P" --patch
	done
	# A put keeps the mode the tip gives the path – a new one takes what `git add` would give the
	# checkout's file, the source's where the checkout lacks one, as sources are often 644 copies
	for (( K = 1; K <= ${#PUTS}; K++ )); do
		P=${PUTS[K]} SRC=${PUT_SRCS[K]}
		MODE=$(_INPUT_ENTRY "$P")
		MODE=${MODE%% *}
		[ -n "$MODE" ] || _REFUSE_PUT_READINGS "$P" "${PUT_GIVEN[K]}"
		if [ "$MODE" = 160000 ]; then
			PRINT_ERR "--put $P: a submodule at the tip – a file put there would read as a broken one"
			exit 1
		fi
		# A link onto a link stays one, by the name it points at, as `git add` stages it – elsewhere a
		# put takes the content, a link's read through, and a file put on a link is a file
		if [ -L "$SRC" ] && [ "$MODE" = 120000 ]; then
			MODE=120000
			BLOB=$(printf '%s' "$(readlink "$SRC")" | git hash-object -w --stdin) || exit 1
		elif [ -L "$SRC" ] && [ ! -f "$SRC" ]; then
			PRINT_ERR "--put $P: $SRC is a link to no file – put a file there, or put the link onto a link"
			exit 1
		else
			[ "$MODE" = 120000 ] && MODE=
			if [ -z "$MODE" ]; then
				MODE=100644
				if [ "$(git config --type=bool core.fileMode 2>/dev/null)" != false ]; then
					FILE=$_IN_TOP/$P
					{ [ -f "$FILE" ] && [ ! -L "$FILE" ]; } || FILE=$SRC
					[ -x "$FILE" ] && MODE=100755
				fi
			fi
			# From the top, so the path's own attributes apply wherever the caller stands
			BLOB=$(git -C "$_IN_TOP" hash-object -w --path="$P" -- "$SRC") || exit 1
		fi
		if ! GIT_INDEX_FILE=$IDX git update-index --add --cacheinfo "$MODE,$BLOB,$P" 2>/dev/null; then
			PRINT_ERR "--put $P: a directory, or a file where one should be, stands in its way at the tip"
			exit 1
		fi
		WHOLE_PATHS+=("$P")
	done
	# Each edit replays onto the text the tip holds, after the inputs above – an old text matching
	# anything but once refuses, a peer's line inside it or the change already landed
	local -a EPATHS=("${(@u)EDITS_PATH}")
	for P in "${EPATHS[@]}"; do
		MODE=$(_INPUT_ENTRY "$P")
		[[ "$MODE" == (100644|100755)\ * ]] || _REFUSE_EDITS_NO_FILE "$P" "${EDITS_GIVEN[$P]:-$P}" "$MODE"
		TEXT=$(git cat-file blob "${MODE#* }"; print -n x)
		TEXT=${TEXT%x}
		# Edited as stored, then cleaned as `git add` would – where cleaning leaves the stored text as
		# it is, so a file stored before its attributes changed keeps its line ends
		FILE=--no-filters
		[ "$(print -rn -- "$TEXT" | git -C "$_IN_TOP" hash-object --path="$P" --stdin 2>/dev/null)" = "${MODE#* }" ] && FILE=--path=$P
		START=$TEXT
		C=0
		for (( K = 1; K <= ${#EDITS_PATH}; K++ )); do
			[ "${EDITS_PATH[K]}" = "$P" ] || continue
			OLD=${EDITS_OLD[K]} NEW=${EDITS_NEW[K]}
			C+=1
			if [ -z "$OLD" ]; then
				PRINT_ERR "--edits $P: edit $C has an empty old text, which matches everywhere"
				exit 1
			fi
			_EDIT_MATCHES "$TEXT" "$OLD"
			HITS=$REPLY
			# Matching the tip once, it lost that match to an earlier edit of the same file – the one
			# found by replaying them in turn
			if (( HITS != 1 && C > 1 )) && _EDIT_MATCHES "$START" "$OLD" && (( REPLY == 1 )); then
				SPEC=$START J=0
				for (( I = 1; I < K; I++ )); do
					[ "${EDITS_PATH[I]}" = "$P" ] || continue
					J+=1
					SPEC=${SPEC/${EDITS_OLD[I]}/${EDITS_NEW[I]}}
					_EDIT_MATCHES "$SPEC" "$OLD"
					(( REPLY == 1 )) || break
				done
				_EDIT_SHOWN "$OLD"
				PRINT_ERR "--edits $P: edit $C ($REPLY) overlaps edit $J – its old text matches the tip once, but not after edit $J, applied first"
				ECHO_E "\e[0;31m  Nothing landed – merge edits $J and $C into one edit, its old text spanning both, then run this again.\e[0m" >&2
				exit 1
			elif (( HITS == 0 )) && [[ $OLD == *$'\r'* && $TEXT != *$'\r'* ]]; then
				PRINT_ERR "--edits $P: no match for edit $C – the commit stores the file with LF line ends, where the old text has CRLF"
				exit 1
			elif (( HITS == 0 )) && [[ $OLD == *$'\n'* && $OLD != *$'\r'* && $TEXT == *$'\r\n'* ]]; then
				PRINT_ERR "--edits $P: no match for edit $C – the commit stores the file with CRLF line ends, where the old text has LF"
				exit 1
			# A filter's clean form is what the commit stores – an old text read from the
			# checkout holds the smudged one
			elif (( HITS == 0 )) && FILTER=$(git -C "$_IN_TOP" check-attr filter -- "$P" 2>/dev/null) && \
			     FILTER=${FILTER##*: filter: } && [[ "$FILTER" != (unspecified|unset|set) ]] && \
			     [[ "$(git -C "$_IN_TOP" cat-file --filters --path="$P" "${MODE#* }" 2>/dev/null; print -n x)" == *$OLD* ]]; then
				PRINT_ERR "--edits $P: no match for edit $C – its $(_SHQ "$FILTER") filter stores the cleaned text, where the old text is the smudged form the checkout holds"
				ECHO_E "\e[0;31m  Nothing landed – put the whole file instead, which git cleans as git add does: --put=$(_LIT "$(_SHQ "$P")")=<file>\e[0m" >&2
				exit 1
			elif (( HITS != 1 )); then
				(( HITS )) && SPEC="$HITS matches" || SPEC="no match"
				_EDIT_SHOWN "$OLD"
				PRINT_ERR "--edits $P: $SPEC for edit $C ($REPLY) – a peer's line sits inside it, or the tip already carries it: rebuild the file and --put it"
				exit 1
			fi
			TEXT=${TEXT/$OLD/$NEW}
		done
		BLOB=$(print -rn -- "$TEXT" | git -C "$_IN_TOP" hash-object -w "$FILE" --stdin) || exit 1
		GIT_INDEX_FILE=$IDX git update-index --cacheinfo "${MODE%% *},$BLOB,$P" || exit 1
		WHOLE_PATHS+=("$P")
	done
	# A mode bit as `chmod` sets it, whatever the path has – a link or a missing path refuses
	for (( K = 1; K <= ${#CHMODS}; K++ )); do
		P=${CHMODS[K]}
		MODE=$(_INPUT_ENTRY "$P")
		if [[ "${MODE%% *}" != 100644 && "${MODE%% *}" != 100755 ]]; then
			PRINT_ERR "--chmod $P: not a file in the commit – nothing to chmod"
			exit 1
		fi
		GIT_INDEX_FILE=$IDX git update-index --cacheinfo "$([ "${CHMOD_X[K]}" = +x ] && print 100755 || print 100644),${MODE#* },$P" || exit 1
		WHOLE_PATHS+=("$P")
	done
	for P in "${RMS[@]}"; do
		if [ -z "$(_INPUT_ENTRY "$P")" ]; then
			if [ -n "$(GIT_INDEX_FILE=$IDX git -C "$_IN_TOP" ls-files -- ":(top,literal)$P/" 2>/dev/null | head -1)" ]; then
				PRINT_ERR "--rm $P: a directory at the tip – name its files, one --rm each"
			else
				PRINT_ERR "--rm $P: not at the tip – nothing to remove"
			fi
			exit 1
		fi
		(cd "$_IN_TOP" && GIT_INDEX_FILE=$IDX git update-index --force-remove -- "$P") || exit 1
		WHOLE_PATHS+=("$P")
	done
	# Files taken whole, read as `git add` reads them – filters, executable bit and links – one the
	# checkout lacks removed, each one's index entry recorded first for the re-sync after the landing
	# Nothing an input read supersedes what is staged there – entries off the old tip stay
	WHOLE_IDX=()
	if [ ${#TAKEN} -gt 0 ]; then
		local -a COMPOSED=("${WHOLE_PATHS[@]}")
		WHOLE_PATHS=("${TAKEN[@]}")
		_RECORD_WHOLE_IDX "$_IN_TOP"
		WHOLE_PATHS=("${COMPOSED[@]}" "${TAKEN[@]}")
		if ! ERR=$(cd "$_IN_TOP" && { print -rN -- "${(@)TAKEN:|WHOLE_GONE}" | GIT_INDEX_FILE=$IDX git update-index --add --remove -z --stdin; } 2>&1 && \
			{ (( ! ${#WHOLE_GONE} )) || print -rN -- "${WHOLE_GONE[@]}" | GIT_INDEX_FILE=$IDX git update-index --force-remove -z --stdin; } 2>&1); then
			PRINT_ERR "Could not take those files whole: ${ERR//$'\n'/ }"
			exit 1
		fi
		_INPUT_WHOLE=${#TAKEN}
	fi
	WHOLE_TREE=$(GIT_INDEX_FILE=$IDX git write-tree)
	rm -f "$IDX"
	WHOLE_PATHS=("${(@u)WHOLE_PATHS}")
	if [ "$WHOLE_TREE" = "$(git rev-parse "$WHOLE_HEAD^{tree}")" ]; then
		PRINT_ERR "Nothing to ${${1:#fold}:+commit}${${1:#commit}:+fold} – every input${TAKEN:+ and file taken whole} left the tree as it was"
		exit 1
	fi
	# On the tree composed, so a patch's new paths count and a removal in the same run renames
	_REFUSE_CASE_CLASH "$WHOLE_HEAD" "$WHOLE_TREE"
	# A flip `--chmod` names is meant – any other, a patch's mode lines say, refuses as a whole
	# file's does unless `--allow-mode-change` says it is meant
	NAMED=("${CHMODS[@]}")
	# Read raw, as `--summary` quotes a name holding `"`, `\` or a tab
	local -a RAW TYPED
	RAW=(${(0)"$(git diff-tree -r -z --raw "$WHOLE_HEAD" "$WHOLE_TREE")"})
	for (( K = 1; K < ${#RAW}; K += 2 )); do
		SPEC=${RAW[K]#:} P=${RAW[K+1]}
		[[ ${SPEC%% *} != 000000 && ${${SPEC#* }%% *} != 000000 && ${SPEC%% *} != ${${SPEC#* }%% *} ]] || continue
		FLIPS+=("$P")
		[[ ${SPEC%% *} == 120000 || ${${SPEC#* }%% *} == 120000 ]] && TYPED+=("$P")
	done
	# A file taken whole refuses a flip as `-- <paths>` alone does, a chmod in the checkout its cause
	WHOLE_FLIPS=("${(@)FLIPS:*TAKEN}")
	if [ ${#WHOLE_FLIPS} -gt 0 ] && [ ${#OPT_ALLOW_MODE_CHANGE} -eq 0 ]; then
		SPEC=$(git -c core.quotePath=false diff-tree -r --summary "$WHOLE_HEAD" "$WHOLE_TREE" -- "${(@)WHOLE_FLIPS/#/:(literal)}" | LC_ALL=C grep -a '^ mode change')
		PRINT_ERR "A file-mode change rides along on a file taken whole – a lost executable bit, most often – so nothing ${${1:#fold}:+landed}${${1:#commit}:+folded}"
		print -r -- "$SPEC" | _CARET_LINES | LC_ALL=C sed "s/^ /${_RED}    /;s/\$/${_OFF}/" >&2
		_MODE_REMEDY "$SPEC"
		exit 1
	fi
	TYPED=("${(@)TYPED:|TAKEN}")
	# A type change no --chmod can name, each named together with the plain flips beside it
	UNNAMED=(${${${FLIPS:|NAMED}:|TYPED}:|TAKEN})
	if [ $(( ${#TYPED} + ${#UNNAMED} )) -gt 0 ] && [ ${#OPT_ALLOW_MODE_CHANGE} -eq 0 ]; then
		SPEC=""
		[ ${#TYPED} -gt 0 ] && SPEC="A link becomes a file, or a file a link: ${(j:, :)TYPED} – pass --allow-mode-change where that is meant"
		[ ${#UNNAMED} -gt 0 ] && SPEC+="${SPEC:+ – and }A mode change outside --chmod rides along: ${(j:, :)UNNAMED} – drop the patch's mode lines, name the path with --chmod where the flip is meant, or pass --allow-mode-change"
		PRINT_ERR "$SPEC"
		exit 1
	fi
	_INPUT_FLIPS=${#FLIPS}
	# Each route guarded on a tree holding its own paths alone, with its own remedies – against other
	# callers' landings of the last 7 days, or the `--base` named, which puts and removals met above
	# – an edit or a patch as much as a put, as one built from a checkout file that predates a landing
	# takes it back all the same
	local -a INPUT_PATHS=(${${${WHOLE_PATHS:|PUTS}:|RMS}:|TAKEN}) BY
	(( ${#OPT_PATCH} )) && BY+=(--patch)
	(( ${#OPT_EDITS} )) && BY+=(--edits)
	(( ${#OPT_CHMOD} )) && BY+=(--chmod)
	local -i ROUTES=$(( (${#PUTS} + ${#RMS} > 0) + (${#TAKEN} > 0) + (${#INPUT_PATHS} > 0) ))
	# Every path the run composed is the caller's own – an edit or a patch beside hunks it left
	# uncommitted as much as a put – an edited, patched or put one where its file holds the commit
	# already, as a put composed in scratch leaves the checkout file without it
	_LANDED_OWN=("$_IN_TOP" "${PUTS[@]}" "${RMS[@]}" "${TAKEN[@]}" "${INPUT_PATHS[@]}")
	_LANDED_INPUTS=("${INPUT_PATHS[@]}" "${PUTS[@]}")
	_LANDED_PUTS=("${PUTS[@]}")
	if [ -z "$EXEC_BASE" ] && [ $(( ${#PUTS} + ${#RMS} )) -gt 0 ]; then
		REPLY=$WHOLE_TREE
		(( ROUTES == 1 )) || _TREE_HOLDING "$WHOLE_HEAD" "$WHOLE_TREE" "$_IN_TOP" "${PUTS[@]}" "${RMS[@]}" || exit 1
		WHOLE_TREE=$REPLY _WHOLE_WHAT='Put or removed' _GUARD_WHOLE_LANDINGS
	fi
	if [ ${#INPUT_PATHS} -gt 0 ]; then
		REPLY=$WHOLE_TREE
		(( ROUTES == 1 )) || _TREE_HOLDING "$WHOLE_HEAD" "$WHOLE_TREE" "$_IN_TOP" "${INPUT_PATHS[@]}" || exit 1
		_GUARD_STAGED_FOLD "$WHOLE_HEAD" "$REPLY" "Changed by ${(j:, :)BY}" "${INPUT_PATHS[@]}"
	fi
	# Files taken whole are guarded as `-- <paths>` alone guards them – conflict markers first
	if [ ${#TAKEN} -gt 0 ]; then
		_GUARD_FOLD_MARKERS "$WHOLE_HEAD" "$WHOLE_TREE" "taken whole" "${TAKEN[@]}"
		REPLY=$WHOLE_TREE
		(( ROUTES == 1 )) || _TREE_HOLDING "$WHOLE_HEAD" "$WHOLE_TREE" "$_IN_TOP" "${TAKEN[@]}" || exit 1
		_GUARD_STAGED_FOLD "$WHOLE_HEAD" "$REPLY" "${${1:#fold}:+Committed whole}${${1:#commit}:+Folded whole}" "${TAKEN[@]}"
	fi
}

# Puts into `REPLY` the tree of <tip> holding <path>s as <tree> has them – each one <tree> lacks
# removed – the paths one route composed, apart from the rest
_TREE_HOLDING () {
	# Args: <tip> <tree> <top> <path>...
	local TIP=$1 TREE=$2 TOP=$3 IDX=$(MKTEMP_FILE git-edit-index)
	local -a RECS LISTED GONE
	shift 3
	_TEMP_FILES+=("$IDX")
	rm -f "$IDX"
	GIT_INDEX_FILE=$IDX git read-tree "$TIP" || return 1
	RECS=(${(0)"$(git --literal-pathspecs ls-tree --full-tree -r -z "$TREE" -- "$@")"})
	LISTED=("${(@)RECS#*$'\t'}")
	GONE=("${(@)argv:|LISTED}")
	# Removals first, so a file turned directory takes its new entries
	if (( ${#GONE} )); then
		print -rN -- "${GONE[@]}" | (cd "$TOP" && GIT_INDEX_FILE=$IDX git update-index --force-remove -z --stdin) || return 1
	fi
	if (( ${#RECS} )); then
		print -rN -- "${RECS[@]}" | GIT_INDEX_FILE=$IDX git update-index -z --index-info || return 1
	fi
	REPLY=$(GIT_INDEX_FILE=$IDX git write-tree) || return 1
	rm -f "$IDX"
}

# Merges a landing's change into <ours> – the result's blob on stdout, or a failure where it
# conflicts or cannot run, a binary say
_MERGE_LANDING () {
	# Args: <ours blob> <before blob> <after blob>
	local ID RC OURS BASE THEIRS
	# One spawn where git merges blobs by ID (2.43), its result mostly in the object store already –
	# a crash takes the files below instead, as 2.53 aborts there in a linked worktree
	if [ -n "$_MERGE_FILE_IDS" ]; then
		ID=$(git merge-file --object-id -q "$1" "$2" "$3" 2>/dev/null)
		RC=$?
		if (( RC <= 127 )); then
			[ $RC -eq 0 ] && print -r -- "$ID"
			return $RC
		fi
	fi
	OURS=$(MKTEMP_FILE git-edit-ours) BASE=$(MKTEMP_FILE git-edit-base) THEIRS=$(MKTEMP_FILE git-edit-theirs)
	_TEMP_FILES+=("$OURS" "$BASE" "$THEIRS")
	git cat-file blob "$1" > "$OURS" && git cat-file blob "$2" > "$BASE" && git cat-file blob "$3" > "$THEIRS" && \
		git merge-file -q "$OURS" "$BASE" "$THEIRS" 2>/dev/null
	RC=$?
	[ $RC -eq 0 ] && git hash-object --no-filters -- "$OURS"
	rm -f "$OURS" "$BASE" "$THEIRS"
	return $RC
}

# Succeeds where <ours> – a copy edited beside a landing – touches none of its changed lines, read
# against its before, which edits made on the landed lines would overlap, and lacks the landing
# by its lines – an edit on the line next to a landed one folds that line into its own hunk
# • Given <kept>, the file's blob when a run's sync conflicting there left it unbrought (`-` where
#   none was stored), an overlap tells only where <ours> changed since the lines of <kept> the
#   landing conflicts with – edits elsewhere in the file leave those as they were
_EDITS_MISS_LANDING () {
	# Args: <ours blob> <before blob> <after blob> [<kept blob> or -]
	local O=$(MKTEMP_FILE git-edit-ours) B=$(MKTEMP_FILE git-edit-base) A=$(MKTEMP_FILE git-edit-theirs) SHARED
	local D=$(MKTEMP_FILE git-edit-landed) KEPT=$(MKTEMP_FILE git-edit-kept)
	local -x LANDED CONF
	_TEMP_FILES+=("$O" "$B" "$A" "$D" "$KEPT")
	# Prints "overlap" where a span on stdin meets one in the env var `v` names – with `p` set, the
	# third and fourth column of each such line instead
	local OVERLAP='
		BEGIN { n = split(ENVIRON[v], F, /[ \n]+/); for (i = 1; i < n; i += 2) { S[++k] = F[i] + 0; E[k] = F[i + 1] + 0 } }
		NF { for (i = 1; i <= k; i++) if (S[i] <= $2 + 0 && $1 + 0 <= E[i]) { if (p) { print $3, $4; next } print "overlap"; exit } }'
	if git cat-file blob "$1" > "$O" && git cat-file blob "$2" > "$B" && git cat-file blob "$3" > "$A"; then
		LANDED=$(_CHANGED_SPANS "$B" "$A")
		SHARED=$(_CHANGED_SPANS "$B" "$O" | awk -v v=LANDED "$OVERLAP")
		# The kept file's spans whose before the landing changed too, read in its own lines
		if [ -n "$SHARED" ] && [ -n "$4" ]; then
			if [ "$4" = - ] || ! git cat-file blob "$4" > "$KEPT" 2>/dev/null; then
				SHARED=""
			else
				CONF=$(_CHANGED_SPANS -t "$B" "$KEPT" | awk -v v=LANDED -v p=1 "$OVERLAP")
				[ -n "$CONF" ] && SHARED=$(_CHANGED_SPANS "$KEPT" "$O" | awk -v v=CONF "$OVERLAP")
			fi
		fi
		# Held where <ours> gained each line the landing added, and lost each it removed, as often
		# as the landing did against its before – a line it both removes and adds (a move) tells
		# nothing, so the miss stands
		if [ -z "$SHARED" ]; then
			git diff --no-index --no-color --no-ext-diff --no-textconv -U0 -- "$B" "$A" > "$D" 2>/dev/null
			(( $? <= 1 )) && SHARED=$(LC_ALL=C awk '
				FILENAME == ARGV[1] { if (f && /^[-+]/) { L = substr($0, 2); N[L] += /^[+]/ ? 1 : -1; SEEN[L] = 1 } if (/^@@/) f = 1; next }
				FILENAME == ARGV[2] { CB[$0]++; next }
				{ CO[$0]++ }
				END {
					for (L in SEEN) { k++; d = CO[L] - CB[L]; if (N[L] == 0 || (N[L] > 0 && d < N[L]) || (N[L] < 0 && d > N[L])) exit }
					if (k) print "held"
				}' "$D" "$B" "$O")
		fi
	else
		SHARED=unknown
	fi
	rm -f "$O" "$B" "$A" "$D" "$KEPT"
	[ -z "$SHARED" ]
}

# Renders seconds as their largest whole unit – 3d, 5h, 12m, 40s
_AGO () {
	# Args: <seconds>
	if (( $1 >= 86400 )); then
		print -r -- "$(( $1 / 86400 ))d"
	elif (( $1 >= 3600 )); then
		print -r -- "$(( $1 / 3600 ))h"
	elif (( $1 >= 60 )); then
		print -r -- "$(( $1 / 60 ))m"
	else
		print -r -- "${1}s"
	fi
}

# Refuses composed content taking back another caller's landing of the last 7 days, whatever route
# composed it – a file lacking one the tip still carries, one a landing removed, or the removal of
# one it added – where a conflict proves nothing, later edits on its lines conflicting too, but in
# a file that landing's sync left unbrought
_GUARD_WHOLE_LANDINGS () {
	local REF JF=$(_JOURNAL_FILE_PATH) LINE ACTOR MOVE P OURS TIP BEFORE AFTER MERGED WHO GONE MODE Q QOURS DST DSTBLOB O
	local HEAD_BLOB NAME_AT_TIP AT_TIP N LATER
	local TOPDIR=$(git rev-parse --show-toplevel)
	REF=$(git symbolic-ref -q HEAD) || return 0
	[ -n "$JF" ] && [ -s "$JF" ] || return 0
	local -i NOW=$(date +%s) K I RI RJ OLDEST_K=0 MRC
	local OLDEST_OLD=""
	local -a J MOVES CHANGED QUERIES ANSWERS HITS HIT_PATHS M RESTORE REMOVED EDITED RF RT RENAMED LIVE RAW LM OWN
	local -a CHMOD_X CHMOD_NX CARRIED RENAMED_DST UNB R REWRITTEN
	local KIND BMODE AMODE HIT B L FROM UB UB_READ="" FIRST_OLD=""
	local -i FIRST_K=0
	# The paths a run's sync left unbrought, read where a merge first conflicts
	local -A UNBROUGHT UNB_AT
	# Opens each printed merge – its sides kept in the step's own temp dir, as `_MERGE_CMD`'s are
	local T='T=$(mktemp -d) && '
	local -A MODE_OF RENAMED_TO RENAMES_OF IS_CHANGED LANDED AWAY NAME_THEN NAME_WAS ST_BASE ST_THEIRS ST_FROM ABOVE
	# Each carried path whose merge of what landed came out clean – the carry's would too
	local -A CLEAN
	local MCLEAN
	# The commit a fold lands in, once known – `auto` picks it only after the inputs are guarded
	local INTO=""
	[[ -n "$AMEND_INTO_TARGET" && "$AMEND_INTO_TARGET" != auto ]] && INTO=$AMEND_INTO_TARGET
	# Oldest first, as journaled – this caller's own landings are its to take back, an unlabeled
	# caller's being every unlabeled one, which nothing tells apart
	for LINE in "${(@f)$(<"$JF")}"; do
		J=(${=${LINE%%$'\t'*}})
		[[ "${J[1]}" == <1-9999999999> ]] && (( J[1] >= NOW - 604800 )) && [ "${J[2]}" = "$REF" ] || continue
		ACTOR=""
		[[ "$LINE" == *$'\t'* ]] && ACTOR=${LINE##*$'\t'}
		[ "$ACTOR" = "$_ACTOR_ID" ] && continue
		MOVES+=("${J[1]} ${J[3]} ${J[4]} ${J[5]:-run} ${ACTOR:--}")
	done
	[ ${#MOVES} -gt 0 ] || return 0
	# Only content this commit changes can take a landing back – a file, a link or a removal – each
	# side's entries read in one `ls-tree`
	local -A TREE_ENT AT_TREE
	local -a DIFFERS
	DIFFERS=(${(0)"$(git diff-tree -z -r --name-only --no-renames "$WHOLE_HEAD" "$WHOLE_TREE")"})
	_TREE_ENTRIES "$WHOLE_TREE" "${DIFFERS[@]}"
	AT_TREE=("${(@kv)TREE_ENT}")
	_TREE_ENTRIES "$WHOLE_HEAD" "${DIFFERS[@]}"
	for P in "${DIFFERS[@]}"; do
		MODE=${AT_TREE[$P]%% *}
		[ "$MODE" = 160000 ] && continue
		CHANGED+=("$P")
		MODE_OF[$P]=$MODE
	done
	[ ${#CHANGED} -gt 0 ] || return 0
	RF=("${(@0)$(git diff -z -M --name-status --diff-filter=R "$WHOLE_HEAD" "$WHOLE_TREE" 2>/dev/null)}")
	for (( RI = 1; RI + 2 <= ${#RF}; RI += 3 )); do
		RENAMED_TO[${RF[RI + 1]}]=${RF[RI + 2]}
	done
	# A move's two tips in one batch, read back by position – a pruned one tells nothing
	for MOVE in "${MOVES[@]}"; do
		M=(${=MOVE})
		QUERIES+=("${M[2]}" "${M[3]}")
	done
	ANSWERS=("${(@f)$(print -rl -- "${QUERIES[@]}" | git cat-file --batch-check='%(objectname) %(objecttype)')}")
	if [ ${#ANSWERS} -ne ${#QUERIES} ]; then
		PRINT_ERR "git cat-file answered ${#ANSWERS} of ${#QUERIES} lookups – refusing rather than guess"
		exit 1
	fi
	for (( K = 1; K <= ${#MOVES}; K++ )); do
		[[ "${ANSWERS[2 * K - 1]}" =~ '^[0-9a-f]{40,64} commit$' && "${ANSWERS[2 * K]}" =~ '^[0-9a-f]{40,64} commit$' ]] || continue
		ANSWERS[2*K-1]=${ANSWERS[2 * K - 1]% *} ANSWERS[2*K]=${ANSWERS[2 * K]% *}
		LIVE+=($K)
	done
	# What each live move changed, in one diff read back by its header – NUL-separated, as a line
	# per path loses a name's trailing CR, macOS's `Icon\r`, and splits one holding a newline
	for P in "${CHANGED[@]}"; do IS_CHANGED[$P]=1; done
	(( ${#LIVE} )) && RAW=("${(@0)$(for K in "${LIVE[@]}"; do print -r -- "${ANSWERS[2 * K]} ${ANSWERS[2 * K - 1]}"; done | git diff-tree --stdin -r -z --no-renames --always)}")
	# A header opens each move's entries, `:<modes> <blobs> <status>` then the path – a path read
	# only right after its entry, so one spelling a SHA never reads as a header
	RI=0 K=0
	for (( I = 1; I <= ${#RAW}; I++ )); do
		if [[ "${RAW[I]}" == :* ]] && (( K )); then
			P=${RAW[I + 1]} LM=(${=RAW[I]#:})
			[[ "${LM[3]}" == *[^0]* ]] || LM[3]=-
			[[ "${LM[4]}" == *[^0]* ]] || LM[4]=-
			(( ${+IS_CHANGED[$P]} )) && LANDED[$K:$P]="${LM[1]} ${LM[2]} ${LM[3]} ${LM[4]}"
			I+=1
		elif [ -n "${RAW[I]}" ]; then
			RI+=1 K=${LIVE[RI]:-0}
			(( K )) && [ "${RAW[I]}" = "${ANSWERS[2 * K]}" ] || { RI=-1; break; }
		fi
	done
	if (( RI != ${#LIVE} )); then
		PRINT_ERR "git diff-tree's answer does not match the ${#LIVE} landing(s) asked about – refusing rather than guess"
		exit 1
	fi
	local _MERGE_FILE_IDS=""
	[[ "$(LC_ALL=C git merge-file -h 2>&1)" == *object-id* ]] && _MERGE_FILE_IDS=yes
	for (( I = 1; I <= ${#CHANGED}; I++ )); do
		P=${CHANGED[I]}
		OURS=${AT_TREE[$P]#* }
		HEAD_BLOB=${TREE_ENT[$P]#* }
		DST=${RENAMED_TO[$P]}
		[ -z "$OURS" ] && [ -n "$DST" ] && DSTBLOB=$(git rev-parse -q --verify "$WHOLE_TREE:$DST" 2>/dev/null)
		# A landing's rename into the path – a case-only one too – followed back newest first, one
		# diff a landing, so an earlier one's edit under the old name counts as one on the path
		N=$P
		for (( K = ${#MOVES}; K >= 1; K-- )); do
			M=(${=MOVES[K]})
			if [ "$N" != "$P" ]; then
				unset "LANDED[$K:$P]"
				LM=(${(0)"$(git --literal-pathspecs diff-tree -r -z --no-renames "${M[2]}" "${M[3]}" -- "$N" 2>/dev/null)"})
				LM=(${=LM[1]#:})
				[[ "${LM[3]}" == *[^0]* ]] || LM[3]=-
				[[ "${LM[4]}" == *[^0]* ]] || LM[4]=-
				(( ${#LM} >= 4 )) && [ "${LM[3]}" != - ] && [ "${LM[4]}" != - ] && \
					LANDED[$K:$P]="${LM[1]} ${LM[2]} ${LM[3]} ${LM[4]}" NAME_THEN[$K:$P]=$N
			else
				LM=(${=LANDED[$K:$P]})
			fi
			if (( ${#LM} >= 4 )) && [ "${LM[3]}" = - ] && [ "${LM[4]}" != - ]; then
				(( ${+RENAMES_OF[${M[2]}:${M[3]}]} )) || RENAMES_OF[${M[2]}:${M[3]}]=$(git diff -z -M --name-status --diff-filter=R "${M[2]}" "${M[3]}" 2>/dev/null)
				RF=("${(@0)RENAMES_OF[${M[2]}:${M[3]}]}")
				for (( RI = 1; RI + 2 <= ${#RF}; RI += 3 )); do
					[ "${RF[RI + 2]}" = "$N" ] || continue
					N=${RF[RI + 1]}
					# Edited as it renamed – judged as that edit on the old name, as two landings are,
					# unless the file in its place holds little of it, the caller's own an addition's
					# remedy keeps
					B=$(git --literal-pathspecs ls-tree --full-tree "${M[2]}" -- "$N" 2>/dev/null)
					B=${B%%$'\t'*}
					L=${B%% *}
					B=${B##* }
					if [ -n "$OURS" ] && [ -n "$B" ] && [ "$B" != "${LM[4]}" ] && \
						{ [ "$OURS" = "${LM[4]}" ] || [ "$OURS" = "$HEAD_BLOB" ] || [ -z "$HEAD_BLOB" ] || \
						[ "${MODE_OF[$P]}" = 120000 ] || _HOLDS_MOST_OF "$OURS" "${LM[4]}" || _HOLDS_MOST_OF "$OURS" "$HEAD_BLOB"; }; then
						LANDED[$K:$P]="$L ${LM[2]} $B ${LM[4]}" NAME_THEN[$K:$P]=$N
					fi
					break
				done
			fi
			# The name a carry from this landing's old tip reads
			[ "$N" != "$P" ] && NAME_WAS[$K:$P]=$N
		done
		# Oldest first, so the carry named takes in every later landing the file lacks as well
		for (( K = 1; K <= ${#MOVES}; K++ )); do
			M=(${=MOVES[K]})
			# A move that left the path as it was, or whose tips were pruned, tells nothing
			(( ${+LANDED[$K:$P]} )) || continue
			LM=(${=LANDED[$K:$P]})
			BMODE=${LM[1]} AMODE=${LM[2]} BEFORE=${LM[3]#-} AFTER=${LM[4]#-}
			# Nor one above a fold's target, both its tips holding it – the fold's replay applies it
			# again – or, its tips rewritten since, one whose change the target lacks
			if [ -n "$INTO" ]; then
				if (( ! ${+ABOVE[$K]} )); then
					ABOVE[$K]=0
					if ! git merge-base --is-ancestor "${M[3]}" "$WHOLE_HEAD" 2>/dev/null; then
						ABOVE[$K]=-1
					elif git merge-base --is-ancestor "$INTO" "${M[2]}" 2>/dev/null && \
						git merge-base --is-ancestor "$INTO" "${M[3]}" 2>/dev/null; then
						ABOVE[$K]=1
					fi
				fi
				(( ABOVE[$K] == 1 )) && continue
				if (( ABOVE[$K] == -1 )); then
					B=$(git --literal-pathspecs ls-tree --full-tree "$INTO" -- "$P" 2>/dev/null)
					B=${B%%$'\t'*}
					L=${B%% *} B=${B##* }
					if [ "$BEFORE" = "$AFTER" ]; then
						[ "$L" = "$AMODE" ] || continue
					elif [ -z "$BEFORE" ]; then
						[ -n "$B" ] || continue
					elif [ -z "$AFTER" ]; then
						[ -z "$B" ] || continue
					elif [ -z "$B" ]; then
						continue
					elif [ "$B" != "$AFTER" ]; then
						# Content no merge reads, a binary's, counts as held
						MERGED=$(_MERGE_LANDING "$B" "$BEFORE" "$AFTER")
						(( $? > 127 )) || [ "$MERGED" = "$B" ] || continue
					fi
				fi
			fi
			# An edit a later move renamed away is read at the tip under its new name – else that
			# move alone counts, and the carry from its old tip takes this one back
			TIP=$HEAD_BLOB NAME_AT_TIP=""
			if [ -z "$TIP" ] && [ -n "$OURS" ] && [ -n "$BEFORE" ] && [ -n "$AFTER" ]; then
				(( ${+RENAMES_OF[${M[3]}:$WHOLE_HEAD]} )) || RENAMES_OF[${M[3]}:$WHOLE_HEAD]=$(git diff -z -M --name-status --diff-filter=R "${M[3]}" "$WHOLE_HEAD" 2>/dev/null)
				RF=("${(@0)RENAMES_OF[${M[3]}:$WHOLE_HEAD]}")
				for (( RI = 1; RI + 2 <= ${#RF}; RI += 3 )); do
					[ "${RF[RI + 1]}" = "$P" ] || continue
					NAME_AT_TIP=${RF[RI + 2]}
					TIP=$(git rev-parse -q --verify "$WHOLE_HEAD:$NAME_AT_TIP" 2>/dev/null)
					break
				done
			fi
			# Each kind takes its own remedy – a merge carries only edits made beside a landing (or
			# across its rename), while a file still as before it or one it added is restored whole
			GONE="" HIT="" FROM=$P MCLEAN=""
			# A file this commit renames answers with its new name's content
			# where the landing changed it under the old one
			O=$OURS
			[ -z "$OURS" ] && [ -n "$DST" ] && [ -n "$BEFORE" ] && [ -n "$AFTER" ] && O=$DSTBLOB
			# A tip no longer carrying this landing, a later one rewriting its lines, is judged on the
			# change from its old tip to the tip – each later landing with it, the caller's own too – where
			# the file still holds what came before it on its lines, edits there being made since
			LATER=""
			if [ -n "$BEFORE" ] && [ -n "$AFTER" ] && [ -n "$TIP" ] && [ -n "$O" ] && [ "$TIP" != "$AFTER" ] && \
				[ "${MODE_OF[$P]}" != 120000 ]; then
				MERGED=$(_MERGE_LANDING "$TIP" "$BEFORE" "$AFTER")
				MRC=$?
				(( MRC <= 127 )) && [ "$MERGED" != "$TIP" ] && _EDITS_MISS_LANDING "$O" "$BEFORE" "$AFTER" && \
					AFTER=$TIP LATER=", changed again since"
			fi
			# Content first, once – a `continue` in here finds it taking nothing back, leaving the mode
			for KIND in carry; do
				if [ "$BEFORE" = "$AFTER" ]; then
					continue
				elif [ -z "$O" ]; then
					# A removal takes back a file such a run added, which the checkout never got, and one
					# it edited where the tip still holds that edit, the removal decided on what came before
					[ -n "$TIP" ] || continue
					if [ -z "$BEFORE" ]; then
						KIND=restore GONE=", which added it"
					else
						[ -n "$AFTER" ] && [ "$TIP" != "$BEFORE" ] || continue
						KIND=removed GONE=", which edited it – removing the file takes that edit back"
					fi
				elif [ -z "$BEFORE" ]; then
					# A file the landing added has no before to merge from – edits on top keep most of what it
					# landed with, or of what the tip holds since, as an input editing the tip's text does, a
					# file of the caller's own in its place hardly any, and a tip that lost it lacks the landing
					[ -n "$AFTER" ] && [ -n "$TIP" ] && [ "$O" != "$AFTER" ] && [ "$O" != "$TIP" ] && [ "${MODE_OF[$P]}" != 120000 ] && \
						[[ "$_WHOLE_WHAT" != "Changed by "* ]] && ! _HOLDS_MOST_OF "$O" "$AFTER" && ! _HOLDS_MOST_OF "$O" "$TIP" || continue
					# That file is the caller's own work, which a restore would overwrite for good
					KIND=own GONE=", which added it – yours holds other content"
				elif [ -z "$AFTER" ]; then
					[ -z "$TIP" ] || continue
					KIND=leave GONE=", which removed it"
				elif [ -z "$TIP" ] || [ "$O" = "$AFTER" ]; then
					continue
				# The landing's own before, which no merge need read – a binary or a link as much as
				# text, and a later landing on top where the tip still carries this one, or where the
				# merge conflicts, as a copy holding no edits loses nothing to the restore
				elif [ "$O" = "$BEFORE" ] && { [ "$TIP" = "$AFTER" ] || ! MERGED=$(_MERGE_LANDING "$TIP" "$BEFORE" "$AFTER") || [ "$MERGED" = "$TIP" ]; }; then
					KIND=restore GONE=", the file still as before it"
				else
					[ "${MODE_OF[$P]}" != 120000 ] || continue
					MERGED=$(_MERGE_LANDING "$O" "$BEFORE" "$AFTER")
					MRC=$?
					# A conflict lacks the landing only where the file's edits share none of its changed
					# lines – edits on those lines, made after it, conflict as much – and the file
					# lacks a line it added or holds one it removed
					# • Where this landing's sync conflicted, its record tells the edits predate it – they
					#   take it back until changed on its lines since, or holding all of it
					if (( MRC == 0 )); then
						[ "$MERGED" != "$O" ] || continue
						MCLEAN=1
					elif (( MRC <= 127 )); then
						[ -n "$UB_READ" ] || { UB_READ=1; _UNBROUGHT_READ "$TOPDIR"; }
						R=(${=UNBROUGHT[$P]}) UB=""
						(( ${#R} >= 4 )) && [ "${R[2]}" = "${M[2]}" ] && [ "${R[3]}" = "${M[3]}" ] && UB=${R[5]:--}
						# The record's own merge wherever it matches – a carry conflicts as that sync did,
						# edits beside the landing's lines too – but for staging apart from the checkout
						# file, which the staging's own remedies rebuild
						if ! _EDITS_MISS_LANDING "$O" "$BEFORE" "$AFTER"; then
							[ -n "$UB" ] && _EDITS_MISS_LANDING "$O" "$BEFORE" "$AFTER" "$UB" || continue
							KIND=unbrought UNB_AT[$P]=${R[1]}
						elif [ -n "$UB" ] && { [ "$_WHOLE_WHAT" != "Folded as staged" ] || \
							[ "$(_WORKTREE_HASH "$TOPDIR" "$P" 2>/dev/null)" = "$O" ]; }; then
							KIND=unbrought UNB_AT[$P]=${R[1]}
						fi
					else
						continue
					fi
					[ "$(_MERGE_LANDING "$TIP" "$BEFORE" "$AFTER")" = "$TIP" ] || continue
				fi
				HIT=1
			done
			[ -n "$HIT" ] && GONE=$LATER$GONE
			if [ -z "$HIT" ]; then
				# A flip of the executable bit, or a file added executable, alone or beside content the
				# file holds, taken back by a file under the other mode where the tip holds the landed
				# one – a whole file carries the checkout's bit
				[[ "$BMODE$AMODE" == (100644100755|100755100644|000000100755) ]] && [ -n "$OURS" ] && [ -n "$TIP" ] && \
					[ "${MODE_OF[$P]}" = "${BMODE/000000/100644}" ] && [[ "$(git --literal-pathspecs ls-tree --full-tree "$WHOLE_HEAD" -- "$P")" == "$AMODE "* ]] || continue
				KIND=mode GONE=", which made it executable"
				[ "$BMODE" = 000000 ] && GONE=", which added it executable"
				[ "$AMODE" = 100644 ] && GONE=", which made it non-executable"
			fi
			# The old name restores nothing at the tip – a carry follows
			# the rename, as for the rename's own landing
			[ -n "$NAME_AT_TIP" ] && KIND=carry GONE=", a later run renaming it to $NAME_AT_TIP" AWAY[$P]=$NAME_AT_TIP
			# A file this commit renames takes what landed under its old name, whatever its kind
			[ "$O" != "$OURS" ] && KIND=renamed GONE=", which this commit renames to $DST"
			# An addition or removal that is one side of a rename takes the carry, which follows it –
			# where the old side holds edits, as untouched the two sides restore and leave as they are
			if [ "$KIND" != carry ] && [ -z "$BEFORE$OURS" -o -z "$AFTER" ]; then
				# Once per landing, however many of its paths ask
				(( ${+RENAMES_OF[${M[2]}:${M[3]}]} )) || RENAMES_OF[${M[2]}:${M[3]}]=$(git diff -z -M --name-status --diff-filter=R "${M[2]}" "${M[3]}" 2>/dev/null)
				RF=("${(@0)RENAMES_OF[${M[2]}:${M[3]}]}")
				for (( RI = 1; RI + 2 <= ${#RF}; RI += 3 )); do
					if [ "${RF[RI + 1]}" = "$P" ]; then
						[ "$OURS" != "$BEFORE" ] || continue
						# Followed to the tip, where a later run may have renamed it again – one that
						# removed it since leaves nothing to carry onto, so the removal's remedy stands
						Q=${RF[RI + 2]} AT_TIP=""
						if git rev-parse -q --verify "$WHOLE_HEAD:$Q" >/dev/null 2>&1; then
							AT_TIP=$Q
						else
							(( ${+RENAMES_OF[${M[3]}:$WHOLE_HEAD]} )) || RENAMES_OF[${M[3]}:$WHOLE_HEAD]=$(git diff -z -M --name-status --diff-filter=R "${M[3]}" "$WHOLE_HEAD" 2>/dev/null)
							RT=("${(@0)RENAMES_OF[${M[3]}:$WHOLE_HEAD]}")
							for (( RJ = 1; RJ + 2 <= ${#RT}; RJ += 3 )); do
								[ "${RT[RJ + 1]}" = "$Q" ] && AT_TIP=${RT[RJ + 2]} && break
							done
						fi
						if [ -n "$AT_TIP" ]; then
							KIND=carry GONE=", which renamed it to $Q"
							[ "$AT_TIP" = "$Q" ] || GONE+=", $AT_TIP at the tip"
							AWAY[$P]=$AT_TIP
						else
							GONE=", which renamed it to $Q, removed since"
						fi
					elif [ "${RF[RI + 2]}" = "$P" ]; then
						Q=${RF[RI + 1]}
						QOURS=$(git rev-parse -q --verify "$WHOLE_TREE:$Q" 2>/dev/null) || QOURS=$(_WORKTREE_HASH "$TOPDIR" "$Q" 2>/dev/null)
						[ -n "$QOURS" ] && [ "$QOURS" != "$(git rev-parse -q --verify "${M[2]}:$Q" 2>/dev/null)" ] && \
							KIND=carry GONE=", which renamed $Q to it" FROM=$Q
					fi
				done
			fi
			[ -n "${NAME_THEN[$K:$P]}" ] && GONE+=", on its old name ${NAME_THEN[$K:$P]}"
			# A carry reads a landing as held once a later rewrite replaced its new tip, a fold's old tip
			# being off the branch anyway – then the file's record names its sync's merge, else the old
			# tip's file is merged – bar staging apart from the checkout file, its own remedies rebuilding it
			if [ "$KIND" = carry ] && [ "$FROM" = "$P" ] && (( ! ${+AWAY[$P]} && ! ${+NAME_WAS[$K:$P]} )) && \
				! git merge-base --is-ancestor "${M[3]}" "$WHOLE_HEAD" 2>/dev/null && \
				{ [ "$_WHOLE_WHAT" != "Folded as staged" ] || [ "$(_WORKTREE_HASH "$TOPDIR" "$P" 2>/dev/null)" = "$O" ]; }; then
				[ -n "$UB_READ" ] || { UB_READ=1; _UNBROUGHT_READ "$TOPDIR"; }
				if (( ${+UNBROUGHT[$P]} )); then
					KIND=unbrought UNB_AT[$P]=${${UNBROUGHT[$P]}%% *}
				elif git cat-file -e "${M[2]}:$P" 2>/dev/null; then
					KIND=rewritten UNB_AT[$P]=${M[2]} GONE+=", its tips replaced by a rewrite since"
				fi
			fi
			# The label last, as one given with a space spells it as `$'…'` does
			WHO="${M[5,-1]}'s"
			[ "${M[5,-1]}" = "-" ] && WHO="an unlabeled caller's"
			[ "$KIND" = unbrought ] && GONE+=", its sync conflicting with the edits in your checkout"
			HITS+=("$P – $WHO ${M[4]} run $(_AGO $(( NOW - M[1] ))) ago (${M[2]:0:7}..${M[3]:0:7})$GONE")
			HIT_PATHS+=("$P")
			# The carry a change built from a stale file takes first, every later landing with it
			if [ -z "$FIRST_OLD" ] || (( K < FIRST_K )); then
				FIRST_K=$K
				FIRST_OLD=${M[2]}
			fi
			# A carry reads a file renamed since from its old name – where something else holds that,
			# here or at the tip, what landed is merged into the new name instead
			Q=${NAME_WAS[$K:$P]}
			[ "$KIND" = carry ] && [ -n "$Q" ] && [ -n "$BEFORE" ] && [ -n "$HEAD_BLOB" ] && ! [ "$TOPDIR/$Q" -ef "$TOPDIR/$P" ] && \
				{ ! _NAME_FREE "$TOPDIR" "$WHOLE_HEAD" "$Q" || ! _MOVE_BACK_STAGED_OK "$TOPDIR" "$P"; } && KIND=merge
			# What a staged fold's staging is rebuilt from where the checkout holds more than it
			ST_BASE[$P]=$BEFORE ST_THEIRS[$P]=$HEAD_BLOB ST_FROM[$P]=$FROM
			case "$KIND" in
				# From the landing's before to the tip, as a carry from its old tip takes in every one since
				merge)
					RENAMED_DST+=("$P")
					Q=$(_SHQ "$P") B='"$T/base"' L='"$T/landed"'
					RENAMED+=("${T}git show ${BEFORE:0:12} > $B && git show ${HEAD_BLOB:0:12} > $L && git merge-file -- $Q $B $L")
					;;
				restore) RESTORE+=("$P") ;;
				unbrought) UNB+=("$P") ;;
				rewritten) REWRITTEN+=("$P") ;;
				own) OWN+=("$P") ;;
				mode) [ "$AMODE" = 100755 ] && CHMOD_X+=("$P") || CHMOD_NX+=("$P") ;;
				leave) REMOVED+=("$P") ;;
				removed) EDITED+=("$P") ;;
				# Through files – `merge-file` sizes its inputs by `stat`, which a pipe answers short – kept
				# in the step's own temp dir
				renamed)
					RENAMED_DST+=("$DST")
					ST_BASE[$DST]=$BEFORE ST_THEIRS[$DST]=$AFTER ST_FROM[$DST]=$DST
					Q=$(_SHQ "$DST") B='"$T/base"' L='"$T/landed"'
					RENAMED+=("${T}git show ${BEFORE:0:12} > $B && git show ${AFTER:0:12} > $L && git merge-file -- $Q $B $L")
					;;
				*)
					CARRIED+=("$P")
					[ -n "$MCLEAN" ] && CLEAN[$P]=1
					# Staged again under the name the carry moves it to
					if (( ${+AWAY[$P]} )); then
						Q=${AWAY[$P]}
						ST_BASE[$Q]=$BEFORE ST_THEIRS[$Q]=$(git rev-parse -q --verify "$WHOLE_HEAD:$Q" 2>/dev/null) ST_FROM[$Q]=$FROM
					fi
					# By journal order, which two landings in one second keep
					if [ -z "$OLDEST_OLD" ] || (( K < OLDEST_K )); then
						OLDEST_K=$K
						OLDEST_OLD=${M[2]}
					fi
					;;
			esac
			break
		done
	done
	[ ${#HITS} -gt 0 ] || return 0
	PRINT_ERR "${_WHOLE_WHAT:-Committed whole}, ${#HITS} file(s) would take back what another caller landed: ${(j:, :)HIT_PATHS}"
	print -rl -- "${HITS[@]}" | _CARET_LINES | LC_ALL=C sed "s/^/${_RED}    /;s/\$/${_OFF}/" >&2
	# The `cd` each printed command needs first – read once, as `ECHO_E` leaves `REPLY` its own
	_AT_TOP "$TOPDIR"
	local AT=$REPLY FROM=""
	# The run again that follows such a step comes from where the caller stood, its paths read there
	[ -n "$AT" ] && FROM=" from $(_LIT "$(_SHQ "$_START_DIR")")"
	# A file a landing since renamed into place, moved there by hand, goes back to the name the
	# carry's tip has first – the carry takes its edits from there alone
	local -a BACK BACK_PATHS
	for P in "${CARRIED[@]}"; do
		Q=${NAME_WAS[$OLDEST_K:$P]}
		[ -n "$Q" ] && _NAME_FREE "$TOPDIR" "$WHOLE_HEAD" "$Q" && _MOVE_BACK_STAGED_OK "$TOPDIR" "$P" && BACK+=("$P" "$Q") BACK_PATHS+=("$P")
	done
	_MOVE_BACK_CMD "$TOPDIR" "${BACK[@]}"
	local MOVE_BACK=$REPLY
	# Staging and a tree hold no checkout file to restore or merge – the staging is taken from the tip
	# instead, and a tree composed again
	case "$_WHOLE_WHAT" in
		"Folded as staged")
			# Staging holds nothing a carry merges into – the checkout takes what landed, and is staged
			# from again, as is a file merged under its new name, while a bit taken back is set on the
			# staging alone, as staged again from the checkout it takes the checkout's bit once more
			# A file a landing renamed away is unstaged first, as the carry leaves a staged old path
			# where it is, and staged again under its new name
			local -a AWAY_OLD STAGE PLAIN ADD_PATHS STEPS REFOLD RESTAGED
			for P in "${CARRIED[@]}"; do
				if (( ${+AWAY[$P]} )); then
					AWAY_OLD+=("$P") STAGE+=("${AWAY[$P]}")
				else
					STAGE+=("$P")
					(( ${BACK_PATHS[(Ie)$P]} + ! ${+CLEAN[$P]} )) || PLAIN+=("$P")
				fi
			done
			if [ $(( ${#STAGE} + ${#RENAMED_DST} )) -gt 0 ]; then
				# A pathspec naming the old path finds nothing staged there any more – both named
				# from the top, where the step's `cd` leaves the caller
				local AGAIN="run this again"
				if [ ${#AWAY_OLD} -gt 0 ] && [ ${#AMEND_PATHSPECS} -gt 0 ]; then
					local -a AWAY_NEW
					for P in "${AWAY_OLD[@]}"; do AWAY_NEW+=("${AWAY[$P]}"); done
					AGAIN+=" naming $(_LIT "$(_ALL_PATHS -q "${AWAY_NEW[@]}")") in place of $(_LIT "$(_ALL_PATHS -q "${AWAY_OLD[@]}")")"
					[ -n "$AT" ] && AGAIN+=", paths from the top, where that cd leaves you"
				else
					AGAIN+=$FROM
				fi
				# A sparse checkout's `git add` refuses a path outside it unless told – 2.34 takes the flag
				local ADD="git add"
				[ "$(git config --bool core.sparseCheckout 2>/dev/null)" = true ] && [[ "$(git add -h 2>&1)" == *(--|\])sparse\ * ]] && ADD="git add --sparse"
				# Staged again whole only where the checkout file holds just what was staged, as a clean carry
				# at its path does itself – one holding more, another caller's lines say, has its staging
				# rebuilt alone, what landed merged in, under its own mode, one conflicting with that replayed
				local FILEMODE=$(git config --bool core.filemode 2>/dev/null) S X
				for X in "${(@u)STAGE[@]}" "${RENAMED_DST[@]}"; do
					P=${ST_FROM[$X]:-$X}
					S=$(git --literal-pathspecs ls-tree --full-tree "$WHOLE_TREE" -- "$P")
					S=${S%%$'\t'*}
					MODE=${S%% *}
					S=${S##* }
					if [ -n "$S" ] && [ "$(_WORKTREE_HASH "$TOPDIR" "$P" 2>/dev/null)" = "$S" ] && { [ "$MODE" = 120000 ] || \
						[ "$FILEMODE" = false ] || [ "$MODE" = "$([ -x "$TOPDIR/$P" ] && print 100755 || print 100644)" ]; }; then
						if (( ${PLAIN[(Ie)$X]} )); then RESTAGED+=("$X"); else ADD_PATHS+=("$X"); fi
					elif [ -n "$S" ] && [ -n "${ST_BASE[$X]}" ] && [ -n "${ST_THEIRS[$X]}" ] && [ "$MODE" != 120000 ] && \
						_MERGE_LANDING "$S" "${ST_BASE[$X]}" "${ST_THEIRS[$X]}" >/dev/null; then
						O='"$T/staged"' B='"$T/base"' L='"$T/landed"'
						STEPS+=("Then rebuild the staging of $(_LIT "$(_SHQ "$X")") alone, what landed merged in, as the checkout holds more than you staged there, which 'git add' would take in too: $(_LIT "${AT}${T}git cat-file blob ${S:0:12} > $O && git cat-file blob ${ST_BASE[$X]:0:12} > $B && git cat-file blob ${ST_THEIRS[$X]:0:12} > $L && git merge-file -- $O $B $L && git update-index --add --cacheinfo $MODE,\$(git hash-object -w --no-filters -- $O),$(_SHQ "$X")")")
					else
						REFOLD+=("$X")
					fi
				done
				[ ${#ADD_PATHS} -gt 0 ] && STEPS=("Then stage them again with: $(_LIT "${AT}$(_PATHS_CMD "$ADD" "${ADD_PATHS[@]}")") (each holding just what you staged)" "${STEPS[@]}")
				if (( ${#STEPS} )); then
					STEPS[-1]+=" – and $AGAIN."
				elif (( ${#RESTAGED} )); then
					STEPS=("Then $AGAIN.")
				fi
			fi
			# What the carry does with the staging – a file staged whole it stages again as merged
			local KEEPS="leaves the staging as it is"
			(( ${#AWAY_OLD} + ${#BACK} )) && KEEPS="leaves the rest of the staging as it is"
			if (( ${#RESTAGED} )) && (( ${#RESTAGED} == ${#CARRIED} )); then
				KEEPS="stages each file again as merged, as you staged it whole"
			elif (( ${#RESTAGED} )); then
				KEEPS="stages $(_LIT "$(_ALL_PATHS -q "${RESTAGED[@]}")") again as merged, as you staged those whole, and leaves the rest of the staging as it is"
			fi
			if [ ${#AWAY_OLD} -gt 0 ]; then
				ECHO_E "\e[0;31m  The staging predates what landed, and a carry moves no file staged at a path renamed since – unstage those first, the files kept as they are: $(_LIT "${AT}$(_PATHS_CMD "git restore --staged" "${AWAY_OLD[@]}")")\e[0m" >&2
				ECHO_E "\e[0;31m  Then merge what landed into the checkout with 'git edit --carry=${OLDEST_OLD:0:12}', which $KEEPS.\e[0m" >&2
			elif [ ${#BACK} -gt 0 ]; then
				# Unstaged first, as the carry leaves a file staged at its new path as it is
				ECHO_E "\e[0;31m  The staging predates what landed, and a carry takes a file renamed since from its old name alone – unstage those, move them back there and merge what landed into the checkout, which $KEEPS, with: $(_LIT "${AT}$(_PATHS_CMD "git restore --staged" "${BACK_PATHS[@]}") && ${MOVE_BACK}git edit --carry=${OLDEST_OLD:0:12}")\e[0m" >&2
			elif [ ${#CARRIED} -gt 0 ]; then
				ECHO_E "\e[0;31m  The staging predates what landed – merge that into the checkout with 'git edit --carry=${OLDEST_OLD:0:12}', which $KEEPS.\e[0m" >&2
			fi
			for Q in "${RENAMED[@]}"; do
				ECHO_E "\e[0;31m  Merge what landed into the new name with: $(_LIT "${AT}$Q")\e[0m" >&2
			done
			for Q in "${STEPS[@]}"; do
				ECHO_E "\e[0;31m  $Q\e[0m" >&2
			done
			[ ${#REFOLD} -gt 0 ] && ECHO_E "\e[0;31m  The checkout holds more than you staged in $(_LIT "$(_ALL_PATHS -q "${REFOLD[@]}")"), which 'git add' would take in too, and what landed can't be merged into the staging alone – replay your change onto the tip with --edits or --patch instead, which read neither, then drop the staging it leaves behind with: $(_LIT "${AT}$(_PATHS_CMD "git restore --staged" "${REFOLD[@]}")")\e[0m" >&2
			# A file the landing removed leaves the index as the tip has it, unstaged
			RESTORE+=("${OWN[@]}" "${REMOVED[@]}")
			[ ${#RESTORE} -gt 0 ] && ECHO_E "\e[0;31m  Take what landed, unstaging yours with: $(_LIT "${AT}$(_PATHS_CMD "git restore --staged" "${RESTORE[@]}")") – your files stay as they are.\e[0m" >&2
			[ ${#CHMOD_X} -gt 0 ] && ECHO_E "\e[0;31m  Take the bit that landed, keeping what you staged, with: $(_LIT "${AT}$(_PATHS_CMD --plain "git update-index --chmod=+x" "${CHMOD_X[@]}")") – then run this again$FROM.\e[0m" >&2
			[ ${#CHMOD_NX} -gt 0 ] && ECHO_E "\e[0;31m  Take the bit that landed, keeping what you staged, with: $(_LIT "${AT}$(_PATHS_CMD --plain "git update-index --chmod=-x" "${CHMOD_NX[@]}")") – then run this again$FROM.\e[0m" >&2
			RESTORE=() RENAMED=() OWN=() REMOVED=() CHMOD_X=() CHMOD_NX=()
			;;
		"Folded from --tree")
			ECHO_E "\e[0;31m  The tree predates what landed – compose it again on the current tip, then run this again.\e[0m" >&2
			RESTORE=() RENAMED=() OWN=() CHMOD_X=() CHMOD_NX=()
			;;
		'Put or removed')
			# The composer's own `PUTS` and `RMS` – a put renamed away goes to its new name, one a landing
			# removed is left out below, and a removal is looked at first, whatever the landing did
			local -a PUT_STALE
			for P in "${HIT_PATHS[@]}"; do
				(( ${PUTS[(Ie)$P]} )) && ! (( ${REMOVED[(Ie)$P]} + ${UNB[(Ie)$P]} )) || continue
				if (( ! ${+AWAY[$P]} )); then
					PUT_STALE+=("$P")
					continue
				fi
				_INPUT_SPELLING "${AWAY[$P]}"
				ECHO_E "\e[0;31m  $(_LIT "$(_SHQ "$P")") is $(_LIT "$(_SHQ "${AWAY[$P]}")") at the tip – replay your change there with --edits on $(_LIT "$(_SHQ "$REPLY")"), or put that file rebuilt from the tip, then run this again.\e[0m" >&2
			done
			if [ ${#PUT_STALE} -gt 0 ]; then
				ECHO_E "\e[0;31m  What you put predates what landed – rebuild it from the tip, or replay your change with --edits, then run this again: $(_LIT "$(_ALL_PATHS -q "${PUT_STALE[@]}")") (the tip's copy: git show ${WHOLE_HEAD:0:12}:<path>)\e[0m" >&2
			fi
			EDITED=()
			for P in "${HIT_PATHS[@]}"; do
				(( ${RMS[(Ie)$P]} )) && EDITED+=("$P")
			done
			RESTORE=() RENAMED=() OWN=() CHMOD_X=() CHMOD_NX=()
			;;
		"Changed by "*)
			# Edits and patches rest on the tip – content lacking what landed comes from a file they
			# were built from, which the carry brings along first, unless the change undoes it by hand
			local -a STALE=("${CARRIED[@]}" "${RESTORE[@]}" "${RENAMED_DST[@]}")
			(( ${#STALE} )) && ECHO_E "\e[0;31m  Your change takes back what landed on $(_LIT "$(_ALL_PATHS -q "${STALE[@]}")") – built from a checkout file that predates it, bring the file along with 'git edit --carry=${FIRST_OLD:0:12}' and build the change from it again, or leave out the part undoing it, then run this again.\e[0m" >&2
			(( ${#CHMOD_X} + ${#CHMOD_NX} )) && ECHO_E "\e[0;31m  The bit you set on $(_LIT "$(_ALL_PATHS -q "${CHMOD_X[@]}" "${CHMOD_NX[@]}")") takes back the one that landed – drop that --chmod, or the patch's mode line, then run this again.\e[0m" >&2
			RESTORE=() RENAMED=() CHMOD_X=() CHMOD_NX=()
			;;
		*)
			# The carry moves a file renamed away to its new name, which the run then names
			# instead – both spelled as the run reads its paths, from where the caller stands
			local -a AWAY_OLD AWAY_NEW
			local _IN_TOP=$TOPDIR _IN_PREFIX=$(cd "$_START_DIR" 2>/dev/null && git rev-parse --show-prefix 2>/dev/null)
			for P in "${CARRIED[@]}"; do
				(( ${+AWAY[$P]} )) || continue
				_INPUT_SPELLING "$P"
				AWAY_OLD+=("$REPLY")
				_INPUT_SPELLING "${AWAY[$P]}"
				AWAY_NEW+=("$REPLY")
			done
			if [ ${#AWAY_OLD} -gt 0 ]; then
				ECHO_E "\e[0;31m  Merge your edits onto what landed with 'git edit --carry=${OLDEST_OLD:0:12}', then run this again naming $(_LIT "$(_ALL_PATHS -q "${AWAY_NEW[@]}")") in place of $(_LIT "$(_ALL_PATHS -q "${AWAY_OLD[@]}")").\e[0m" >&2
			elif [ ${#BACK} -gt 0 ]; then
				ECHO_E "\e[0;31m  Merge your edits onto what landed, moving each file renamed since back to its old name first, where the carry takes the edits from, with: $(_LIT "${AT}${MOVE_BACK}git edit --carry=${OLDEST_OLD:0:12}") – then run this again$FROM.\e[0m" >&2
			elif [ -n "$OLDEST_OLD" ]; then
				ECHO_E "\e[0;31m  Merge your edits onto what landed with 'git edit --carry=${OLDEST_OLD:0:12}', then run this again.\e[0m" >&2
			fi
			;;
	esac
	# A file a sync left on its conflict takes the merge that sync named, from the base it sits on,
	# which a carry would conflict on again – then whatever the route builds from the file
	case "$_WHOLE_WHAT" in
		"Folded as staged") Q="stage it again and run this again$FROM" ;;
		"Folded from --tree") Q="compose the tree again on the current tip" ;;
		'Put or removed') Q="put it again as resolved" ;;
		"Changed by "*) Q="build your change from it again and run this again" ;;
		*) Q="run this again$FROM" ;;
	esac
	for P in "${UNB[@]}"; do
		_MERGE_CMD "${UNB_AT[$P]}" "$WHOLE_HEAD" "$P" "$P" "$P"
		ECHO_E "\e[0;31m  Your checkout's $(_LIT "$(_SHQ "$P")") still sits on ${UNB_AT[$P]:0:7}, where the sync of what landed conflicted with its edits – merge that in, markers and all, with: $(_LIT "${AT}$REPLY") – resolve the conflict, then $Q.\e[0m" >&2
	done
	for P in "${REWRITTEN[@]}"; do
		_MERGE_CMD "${UNB_AT[$P]}" "$WHOLE_HEAD" "$P" "$P" "$P"
		ECHO_E "\e[0;31m  Your checkout's $(_LIT "$(_SHQ "$P")") predates ${UNB_AT[$P]:0:7}, its landing replaced by a rewrite since – merge what landed in, markers and all, with: $(_LIT "${AT}$REPLY") – resolve any conflict, then $Q.\e[0m" >&2
	done
	[ ${#RESTORE} -gt 0 ] && ECHO_E "\e[0;31m  Take what landed with: $(_LIT "${AT}$(_PATHS_CMD "git restore --source=HEAD --worktree" "${RESTORE[@]}")") – or leave it out.\e[0m" >&2
	# A restore would overwrite the caller's own file for good
	[ ${#OWN} -gt 0 ] && ECHO_E "\e[0;31m  Your own $(_LIT "$(_ALL_PATHS -q "${OWN[@]}")") stands where another caller added one – move yours aside or merge the two by hand, then run this again, or pass --base as below where yours is meant to replace it.\e[0m" >&2
	[ ${#CHMOD_X} -gt 0 ] && ECHO_E "\e[0;31m  Take the bit that landed with: $(_LIT "${AT}$(_PATHS_CMD --plain "chmod -- +x" "${CHMOD_X[@]}")")\e[0m" >&2
	[ ${#CHMOD_NX} -gt 0 ] && ECHO_E "\e[0;31m  Take the bit that landed with: $(_LIT "${AT}$(_PATHS_CMD --plain "chmod -- -x" "${CHMOD_NX[@]}")")\e[0m" >&2
	_MARK_LITERAL "${REMOVED[@]}"
	[ ${#REMOVED} -gt 0 ] && ECHO_E "\e[0;31m  Leave out what was removed: $(_LIT "$(_ALL_PATHS -q "${reply[@]}")")\e[0m" >&2
	_MARK_LITERAL "${EDITED[@]}"
	[ ${#EDITED} -gt 0 ] && ECHO_E "\e[0;31m  Look at what landed on $(_LIT "$(_ALL_PATHS -q "${reply[@]}")") first – keep the file, or remove it with --base as below.\e[0m" >&2
	for Q in "${RENAMED[@]}"; do
		ECHO_E "\e[0;31m  Merge what landed into the new name with: $(_LIT "${AT}$Q")\e[0m" >&2
	done
	ECHO_E "\e[0;31m  Pass --base=${WHOLE_HEAD:0:12} where taking it back is the point.\e[0m" >&2
	exit 1
}

# Tells whether <blob> keeps at least half the lines of <landed blob>, each counted as often as it
# occurs – how edits made on top of a file look, where one written in its place keeps few
_HOLDS_MOST_OF () {
	# Args: <blob> <landed blob>
	local -i TOTAL KEPT
	TOTAL=$(git cat-file blob "$2" 2>/dev/null | LC_ALL=C grep -ac .)
	(( TOTAL > 0 )) || return 0
	KEPT=$(LC_ALL=C comm -12 <(git cat-file blob "$1" 2>/dev/null | LC_ALL=C grep -a . | LC_ALL=C sort) \
		<(git cat-file blob "$2" 2>/dev/null | LC_ALL=C grep -a . | LC_ALL=C sort) | LC_ALL=C grep -ac .)
	(( KEPT * 2 >= TOTAL ))
}

# Refuses whole files carrying a conflict the tip's version lacks – an opening and a closing marker
# line at the file's own `conflict-marker-size`, as a merge leaves them, whoever left them there
_GUARD_WHOLE_MARKERS () {
	# Args: [<how the files were taken, "taken whole" by default>]
	local TOP=$(git rev-parse --show-toplevel) P N RE NEW E OUT ALL=""
	local -a BAD FILES ATTR
	local -A TREE_ENT SIZE OF_SIZE MAYBE
	local -i K
	# Each file's entry and marker size read in one call each, and the files that hold an opening
	# marker's run at all in one `git grep` a size – only those read line by line
	_TREE_ENTRIES "$WHOLE_TREE" "${WHOLE_PATHS[@]}"
	for P in "${WHOLE_PATHS[@]}"; do [[ "${TREE_ENT[$P]}" == 100* ]] && FILES+=("$P"); done
	(( ${#FILES} )) || return 0
	ATTR=("${(@0)$(print -rN -- "${FILES[@]}" | git -C "$TOP" check-attr -z --stdin conflict-marker-size 2>/dev/null)}")
	for (( K = 1; K + 2 <= ${#ATTR}; K += 3 )); do SIZE[${ATTR[K]}]=${ATTR[K + 2]}; done
	for P in "${FILES[@]}"; do
		N=${SIZE[$P]}
		[[ "$N" == <1-> ]] || N=7
		SIZE[$P]=$N
		OF_SIZE[$N]+="$P"$'\0'
	done
	for N in "${(@k)OF_SIZE}"; do
		OUT=$(_GIT_PATH_CHUNKS --literal-pathspecs -C "$TOP" grep --no-color -l -z -a -F -e "${(l:$N::<:)}" "$WHOLE_TREE" -- ${(0)OF_SIZE[$N]} 2>/dev/null)
		# A failed search, or a name read back otherwise, has every file read
		if (( $? > 1 )); then
			ALL=1
		else
			for E in ${(0)OUT}; do
				[[ "$E" == "$WHOLE_TREE":* ]] || { ALL=1; break; }
				MAYBE[${E#"$WHOLE_TREE":}]=1
			done
		fi
	done
	[ -n "$ALL" ] && for P in "${FILES[@]}"; do MAYBE[$P]=1; done
	for P in "${FILES[@]}"; do
		(( ${+MAYBE[$P]} )) || continue
		N=${SIZE[$P]}
		RE="^(<{$N}|>{$N})( |\$)"
		# Read whole – a pipe into `grep` would end the writer at a first match
		NEW=$(LC_ALL=C comm -23 <(git cat-file blob "$WHOLE_TREE:$P" 2>/dev/null | LC_ALL=C grep -aE "$RE" | LC_ALL=C sort -u) \
			<(git cat-file blob "$WHOLE_HEAD:$P" 2>/dev/null | LC_ALL=C grep -aE "$RE" | LC_ALL=C sort -u))
		[[ "$NEW" == *"${(l:$N::<:)}"* && "$NEW" == *"${(l:$N::>:)}"* ]] && BAD+=("$P")
	done
	(( ${#BAD} )) || return 0
	PRINT_ERR "Conflict markers in ${#BAD} file(s) ${1:-taken whole} – nothing landed: ${(j:, :)BAD}"
	ECHO_E "\e[0;31m  Resolve them first – or, where they are the file's content, give it a larger conflict-marker-size in .gitattributes, as 'git diff --check' reads it.\e[0m" >&2
	exit 1
}

# Refuses a fold of staged content, or of a `--tree`, carrying a conflict the tip lacks – as whole
# files are refused, those taken beside the inputs too
_GUARD_FOLD_MARKERS () {
	# Args: <tip> <fold tree> <how the files were taken> <path>...
	local WHOLE_HEAD=$1 WHOLE_TREE=$2 HOW=$3
	shift 3
	local -a WHOLE_PATHS=("$@")
	_GUARD_WHOLE_MARKERS "$HOW"
}

# Guards whole files against the tip they were composed on – a `--base` names the commit they
# rest on, refusing a path changed between it and the tip, and without one the journal's
# landings of the last 7 days stand in for it
_GUARD_WHOLE () {
	if [ -z "$EXEC_BASE" ]; then
		_GUARD_WHOLE_LANDINGS
		return 0
	fi
	local P
	local -a MOVED
	local -A TREE_ENT AT_BASE
	# Each side's entries in one `ls-tree` – mode and object, as a bit that landed is taken back too
	_TREE_ENTRIES "$EXEC_BASE" "${WHOLE_PATHS[@]}"
	AT_BASE=("${(@kv)TREE_ENT}")
	_TREE_ENTRIES "$WHOLE_HEAD" "${WHOLE_PATHS[@]}"
	for P in "${WHOLE_PATHS[@]}"; do
		[ "${AT_BASE[$P]}" = "${TREE_ENT[$P]}" ] || MOVED+=("$P")
	done
	[ ${#MOVED} -eq 0 ] && return 0
	PRINT_ERR "Changed between --base ${EXEC_BASE:0:7} and the tip ${WHOLE_HEAD:0:7}, so ${${_WHOLE_WHAT:-Committed whole}:l} they would take that back: ${(j:, :)MOVED}"
	ECHO_E "\e[0;31m  See what landed with 'git log --oneline ${EXEC_BASE:0:12}..${WHOLE_HEAD:0:12} -- <path>' and merge your edits onto it – or pass --base=${WHOLE_HEAD:0:12} where taking it back is the point.\e[0m" >&2
	exit 1
}

# Names what a fold took its content from, for the lines saying it is left as it was
_FOLD_SOURCE () {
	if [ ${#OPT_WHOLE} -gt 0 ] || [ ${#WHOLE_PATHS} -gt 0 ]; then
		print -r -- "the files are"
	elif [ -n "$AMEND_TREE$STATE_TREE" ]; then
		print -r -- "the tree is"
	else
		print -r -- "your staged changes are"
	fi
}

# Refuses a fold whose tree was composed on a tip the branch has moved past – it would take back
# what landed since – named as the caller gave it, whole files or a `--tree`
_TREE_MOVED () {
	# Args: <the tip now>
	if [ ${#OPT_WHOLE} -gt 0 ] && ! _INPUTS_GIVEN; then
		PRINT_ERR "The files were read on ${TREE_BASE:0:7}, but the branch moved to ${1:0:7} since – nothing was applied"
		ECHO_E "\e[0;31m  Run it again, reading them on the current tip.\e[0m" >&2
	elif _INPUTS_GIVEN; then
		PRINT_ERR "The inputs${OPT_WHOLE:+ and the files taken whole} were composed on ${TREE_BASE:0:7}, but the branch moved to ${1:0:7} since – nothing was applied"
		ECHO_E "\e[0;31m  Run it again, composing them on the current tip.\e[0m" >&2
	else
		PRINT_ERR "--tree $AMEND_TREE_GIVEN was composed on ${TREE_BASE:0:7}, but HEAD is ${1:0:7} now – nothing was applied"
		ECHO_E "\e[0;31m  Compose it again on the current tip, then retry.\e[0m" >&2
	fi
	exit 1
}

# Names the remedy for a mode change a checkout file carries – a chmod for a bit, while a symlink
# turned file, or the reverse, is a file to put back as it was
_MODE_REMEDY () {
	# Args: <the ` mode change` lines>
	if [[ "$1" == *120000* ]]; then
		ECHO_E "\e[0;31m  Put a symlink back where one was (git restore --source=HEAD -- <path>, if its content is not the point), or pass --allow-mode-change where the change is meant.\e[0m" >&2
	else
		ECHO_E "\e[0;31m  Restore the mode with chmod, or pass --allow-mode-change where the change is meant.\e[0m" >&2
	fi
}

# Guards a fold of staged content, or of a bare `--tree`, as whole files are guarded – either read
# before another caller's landing takes it back, the fold rebuilding those files as they hold them –
# and the paths an input route composed, on a tree holding them alone
_GUARD_STAGED_FOLD () {
	# Args: <tip> <tree> <what, "Folded as staged", "Folded from --tree", "Committed whole", "Folded
	# whole" or "Changed by <inputs>"> <path>...
	local WHOLE_HEAD=$1 WHOLE_TREE=$2 _WHOLE_WHAT=$3
	shift 3
	local -a WHOLE_PATHS=("$@")
	_GUARD_WHOLE
}

# Commits the composed tree from the `--exec` worktree, so the repo's hooks run on it
_COMMIT_WHOLE_TREE () {
	# Args: <tree> <message file>
	git read-tree --reset -u "$1" && git commit -q --cleanup=whitespace -F "$2"
}

# Commits whole files at the tip – composed apart from the shared index and guarded, then landed
# through `--exec` with its hooks, gate, CAS, journal and reconcile, pinned to the tip they read
GIT_COMMIT_WHOLE () {
	# Args: <path>...
	if ! git symbolic-ref -q HEAD >/dev/null; then
		PRINT_ERR "--commit requires being on a branch (got detached HEAD)"
		exit 1
	fi
	if [ -n "$AMEND_TREE" ]; then
		_COMPOSE_FROM_TREE
	elif _INPUTS_GIVEN; then
		_COMPOSE_INPUTS commit "$@"
	else
		_COMPOSE_WHOLE "$@"
	fi
	# The inputs' composer refused the flips no `--chmod` named already, a file taken whole's too
	if [ ${#OPT_ALLOW_MODE_CHANGE} -eq 0 ] && ! _INPUTS_GIVEN; then
		local FLIPS=$(git -c core.quotePath=false diff-tree -r --summary "$WHOLE_HEAD" "$WHOLE_TREE" | LC_ALL=C grep -a '^ mode change')
		if [ -n "$FLIPS" ]; then
			PRINT_ERR "A file-mode change rides along – a lost executable bit, most often – so nothing landed"
			print -r -- "$FLIPS" | _CARET_LINES | LC_ALL=C sed "s/^ /${_RED}    /;s/\$/${_OFF}/" >&2
			_MODE_REMEDY "$FLIPS"
			exit 1
		fi
	fi
	if [ -n "$AMEND_TREE" ]; then
		_GUARD_WHOLE_MARKERS "of the --tree"
	elif _INPUTS_GIVEN; then
		_GUARD_WHOLE_MARKERS "from the inputs"
	else
		_GUARD_WHOLE_MARKERS
	fi
	# A composed tree rests on the tip itself – the inputs, and files taken whole beside them, were
	# guarded as composed
	[ -z "$AMEND_TREE" ] && ! _INPUTS_GIVEN && _GUARD_WHOLE
	local MSG=$(MKTEMP_FILE git-edit-message)
	_TEMP_FILES+=("$MSG")
	print -r -- "$TEXT_VALUE" > "$MSG"
	if [ -z "$AMEND_TREE" ] && ! _INPUTS_GIVEN; then
		PRINT_ACTION "Committing ${#WHOLE_PATHS} whole file(s) on %s..." "$WHOLE_HEAD"
	elif (( _INPUT_WHOLE )); then
		PRINT_ACTION "Committing ${#WHOLE_PATHS} file(s), $_INPUT_WHOLE of them whole, on %s..." "$WHOLE_HEAD"
	else
		PRINT_ACTION "Committing ${#WHOLE_PATHS} file(s) on %s..." "$WHOLE_HEAD"
	fi
	[ -z "$AMEND_TREE" ] && ! _INPUTS_GIVEN && _LANDED_OWN=("$(git rev-parse --show-toplevel)" "${WHOLE_PATHS[@]}")
	EXEC_BASE=$WHOLE_HEAD
	EXEC_LABEL=commit
	GIT_EXEC _COMMIT_WHOLE_TREE "$WHOLE_TREE" "$MSG"
	if [ "$EXEC_CHANGED" = true ]; then
		local MADE=${${EXEC_PLACED:-$EXEC_NEW_HEAD}%% *}
		git --no-pager -c core.quotePath=false show --no-color --stat --summary --format= "$MADE" | LC_ALL=C sed '/./!d'
		# What the run leaves to do right above the commit line, which stays among the last three
		_PRINT_TODO early
		_PRINT_COMMIT_LINE "$MADE" "  committed${EXEC_PLACED:+ $EXEC_PLACE_KIND ${EXEC_PLACE_ANCHOR:0:7}}: %h %s"
	fi
}

# Builds the tree a scoped fold carries – the base commit's tree with only the
# pathspec-matched entries applied, composed from the source's exact blobs like the split
# path, so binary files and mode changes come along and nothing else leaks in – the source
# being the staged index, or the `--tree` a caller composed apart from it
_STAGED_TREE_FOR () {
	local BASE=$1
	# An unmerged entry reads as a deletion below – the caller refuses the empty tree instead
	[ -z "$AMEND_TREE" ] && [ -n "$(git ls-files -u -- "${AMEND_PATHSPECS[@]}" 2>/dev/null)" ] && return 1
	local TMPIDX=$(MKTEMP_FILE git-edit-amend-idx)
	rm -f "$TMPIDX"
	GIT_INDEX_FILE=$TMPIDX git read-tree "$BASE" || { rm -f "$TMPIDX"; return 1; }
	local META PATHNAME DSTMODE DSTSHA I
	local -a RAW F
	# NUL-separated, so each path reaches the index as its own bytes – one with a quote, a
	# backslash or a control character arrives quoted otherwise, and that quoting became the name
	if [ -n "$AMEND_TREE" ]; then
		RAW=("${(@0)$(git diff-tree -z -r "$BASE" "$AMEND_TREE" -- "${AMEND_PATHSPECS[@]}")}")
	else
		RAW=("${(@0)$(git diff-index -z --cached -r "$BASE" -- "${AMEND_PATHSPECS[@]}")}")
	fi
	for (( I = 1; I < ${#RAW[@]}; I += 2 )); do
		META=${RAW[I]}
		PATHNAME=${RAW[I+1]}
		[ -z "$META" ] && continue
		# Split on blanks as awk's fields would, in-process
		F=(${=META})
		DSTMODE=${F[2]}
		DSTSHA=${F[4]}
		if [ "$DSTMODE" = "000000" ]; then
			# From the top, as `update-index` reads a path from where it runs, unlike a `--cacheinfo`
			GIT_INDEX_FILE=$TMPIDX git -C "$(git rev-parse --show-toplevel)" update-index --force-remove -- "$PATHNAME" || { rm -f "$TMPIDX"; return 1; }
		else
			GIT_INDEX_FILE=$TMPIDX git update-index --add --cacheinfo "$DSTMODE,$DSTSHA,$PATHNAME" || { rm -f "$TMPIDX"; return 1; }
		fi
	done
	GIT_INDEX_FILE=$TMPIDX git write-tree
	rm -f "$TMPIDX"
}

# Refuses a fold with nothing to fold – within the pathspec if one narrows it, since "something
# is staged" says nothing about the named paths
# Bytes alone decide – from git 2.55 a textconv driver's view sets porcelain's exit code too
_REQUIRE_FOLD_CHANGES () {
	if git diff "${AMEND_SOURCE[@]}" --quiet --no-textconv --no-ext-diff -- "${AMEND_PATHSPECS[@]}" 2>/dev/null; then
		if [ -n "$AMEND_TREE" ]; then
			PRINT_ERR "--tree $AMEND_TREE_GIVEN differs from HEAD in nothing${AMEND_PATHSPECS[1]:+ under ${AMEND_PATHSPECS[*]}} – nothing to fold"
			ECHO_E "\e[0;31m  Compose it on the current tip with the change in place, then retry.\e[0m" >&2
		elif [ ${#AMEND_PATHSPECS[@]} -gt 0 ]; then
			PRINT_ERR "No staged changes under ${AMEND_PATHSPECS[*]}"
			# Never "fold everything staged" – the index is shared, a peer's staging in it too
			ECHO_E "\e[0;31m  Stage them with 'git add -- <files>', then run this again naming those files.\e[0m" >&2
		else
			PRINT_ERR "No staged changes to amend"
			ECHO_E "\e[0;31m  Stage files with 'git add <files>' before running --amend-into.\e[0m" >&2
		fi
		exit 1
	fi
}

# Refuses before a wait the paths a run names that it would refuse after it – a file to take whole
# that neither the checkout nor the tip has, a fold's pathspec with nothing staged under it, a
# split's matching none of the commit's changes or all of them
_GUARD_NAMED_PATHS () {
	# Args: whole|staged|split=<commit> <path>...
	local KIND=$1
	local -a WHOLE_PATHS WHOLE_GONE AMEND_PATHSPECS AMEND_SOURCE=(--cached --ignore-submodules=none) ALL_FILES MATCHED
	shift
	if [ "$KIND" = whole ]; then
		_WHOLE_PATHS "$@"
	elif [[ "$KIND" == split=* ]]; then
		_SPLIT_MATCH "${KIND#split=}" "$@"
	else
		_LITERAL_FIRST index "$@"
		AMEND_PATHSPECS=("${reply[@]}")
		_REQUIRE_FOLD_CHANGES
	fi
}

# Folds currently-staged changes from the main index (or a `--tree` composed apart from it) into
# a target commit, leaving unstaged files alone – fixup plus autosquash in one operation,
# snapshotting the source as a fixup object, running the autosquash isolated, and CAS-updating
# the ref against the pre-op tip
GIT_AMEND_INTO () {
	local TARGET=$AMEND_INTO_TARGET

	# Pre-flight: must not be a stale in-flight operation
	_REQUIRE_NO_INFLIGHT

	# Pre-flight: must have changes to fold
	_REQUIRE_FOLD_CHANGES

	# Pre-flight: target must be reachable from `HEAD` (or resolvable to it)
	_GUARD_REACHABLE "$TARGET"
	TARGET=$_RESOLVED_SHA

	# Pre-flight: must be on a branch
	local ORIG_BRANCH=${$(git symbolic-ref -q HEAD 2>/dev/null)#refs/heads/}
	if [ -z "$ORIG_BRANCH" ]; then
		PRINT_ERR "--amend-into requires being on a branch (got detached HEAD)"
		exit 1
	fi

	local TARGET_FULL=$(git rev-parse "$TARGET")
	_GUARD_UNPUSHED "$TARGET_FULL"
	_GUARD_NO_MERGE_SPAN "$TARGET_FULL"

	local REF="refs/heads/$ORIG_BRANCH"
	local ORIG_HEAD=$(git rev-parse HEAD)
	_REQUIRE_IN_TIP "$ORIG_HEAD" "$TARGET"
	# A tree composed on an earlier tip would take back what landed on the branch since – asked again
	# here, as the dispatch read the tip a moment before
	[ -n "$TREE_BASE" ] && [ "$TREE_BASE" != "$ORIG_HEAD" ] && _TREE_MOVED "$ORIG_HEAD"
	# Repo root, not `pwd` – pathspecs in the success sync below must resolve
	# from the root even when the script was invoked from a subdirectory
	local MAIN_DIR=$(git rev-parse --show-toplevel)
	# Commits above the target pre-op – locates the amended commit in the
	# rebased chain afterwards (`NEW_HEAD~DEPTH`), for the completion summary
	local DEPTH=$(git rev-list --count "$TARGET_FULL..HEAD")
	# What the fold carries, read once – every check below and the fold itself read this tree, so
	# staging changed meanwhile by a peer can't pass the checks as one tree and land as another
	local FOLD_SNAP=$(_FOLD_TREE "$ORIG_HEAD")
	if [ -z "$FOLD_SNAP" ]; then
		PRINT_ERR "Cannot snapshot index (unmerged entries?) – resolve conflicts first"
		exit 1
	fi
	# The folded paths (root-relative): shown in the completion summary, and
	# scoping the success sync to exactly these entries
	local -a STAGED_PATHS
	STAGED_PATHS=(${(0)"$(git diff --ignore-submodules=none --name-only -z "$ORIG_HEAD" "$FOLD_SNAP")"})
	if [ ${#STAGED_PATHS} -eq 0 ]; then
		PRINT_ERR "The staged changes were unstaged meanwhile – nothing to fold"
		exit 1
	fi
	# A report, so capped – a bulk fold names the first of its paths
	local STAGED_FILES=$(_SOME_PATHS -q "${STAGED_PATHS[@]}")
	# Staging read before another caller's landing would take it back, the fold rebuilding those files
	# as staged – checked as whole files are, or against the tip a `--base` names – as is a bare tree,
	# which names no tip it was composed on
	if [ -z "$AMEND_TREE" ]; then
		_GUARD_FOLD_MARKERS "$ORIG_HEAD" "$FOLD_SNAP" "as staged" "${STAGED_PATHS[@]}"
		# The target as resolved here, landings above it applied again by the replay
		AMEND_INTO_TARGET=$TARGET_FULL _GUARD_STAGED_FOLD "$ORIG_HEAD" "$FOLD_SNAP" "Folded as staged" "${STAGED_PATHS[@]}"
	else
		# Whole files and the inputs were checked as they were composed
		if [ ${#OPT_WHOLE} -eq 0 ] && ! _INPUTS_GIVEN; then
			_GUARD_FOLD_MARKERS "$ORIG_HEAD" "$FOLD_SNAP" "of the --tree" "${STAGED_PATHS[@]}"
			_REFUSE_CASE_CLASH "$ORIG_HEAD" "$FOLD_SNAP"
		fi
		[ -n "$TREE_BASE" ] || AMEND_INTO_TARGET=$TARGET_FULL _GUARD_STAGED_FOLD "$ORIG_HEAD" "$FOLD_SNAP" "Folded from --tree" "${STAGED_PATHS[@]}"
	fi
	# Staging is the caller's own content – files and inputs composed apart named theirs as composed
	[ -z "$AMEND_TREE" ] && _LANDED_OWN=("$MAIN_DIR" "${STAGED_PATHS[@]}")

	# Pre-flight – a staged path the target predates is refused where a later commit introduces
	# it, since folding beneath that introduction replays it as an add/add conflict of the
	# whole file, and every descendant touching it re-conflicts in turn
	if [ ${#OPT_ALLOW_NEW_PATH} -eq 0 ]; then
		local ABSENT_PATH
		local ABSENT_INTRODUCER
		local ABSENT_FROM
		local ABSENT_RENAMES_READ
		local -i RI
		local -a RENAME_FIELDS
		local -A ABSENT_RENAMED
		local -a ABSENT_LINES ABSENT_GONE ABSENT_MOVED
		local -i ABSENT_ADDS
		# What the target holds of each path, asked in one call
		local -A OBJ_AT
		_OBJECTS_AT "$TARGET_FULL" "${STAGED_PATHS[@]}"
		for ABSENT_PATH in "${STAGED_PATHS[@]}"; do
			if (( ! ${+OBJ_AT[$ABSENT_PATH]} )); then
				# A path renamed since arrives by no add – the fixup's replay merges against the tip, and
				# that merge's rename detection carries the change to the old name: asked the same way
				# here, under its settings, so a pairing it still misses stops on a conflict, never lands
				ABSENT_FROM=
				# Only a path the fold keeps – a deletion meets that merge as a rename/delete conflict
				if git cat-file -e "$FOLD_SNAP:$ABSENT_PATH" 2>/dev/null; then
					if [ -z "$ABSENT_RENAMES_READ" ]; then
						ABSENT_RENAMES_READ=1
						# NUL-separated, status, source and destination each – a quote, backslash or tab in a
						# name comes back C-quoted in the line form
						if _MERGE_DETECTS_RENAMES; then
							ABSENT_RENAMES_READ=merge
							RENAME_FIELDS=(${(0)"$(git diff -z -M -l"$(git config --get merge.renameLimit || git config --get diff.renameLimit || echo 7000)" --name-status --diff-filter=R "$ORIG_HEAD" "$TARGET_FULL" 2>/dev/null)"})
							for (( RI = 1; RI + 2 <= ${#RENAME_FIELDS}; RI += 3 )); do
								ABSENT_RENAMED[${RENAME_FIELDS[RI + 1]}]=${RENAME_FIELDS[RI + 2]}
							done
						fi
					fi
					ABSENT_FROM=${ABSENT_RENAMED[$ABSENT_PATH]}
				fi
				if [ -n "$ABSENT_FROM" ]; then
					PRINT_TEXT "Note: %s is %s at %s – git's rename detection carries the fold there." 90 "$ABSENT_PATH" "$ABSENT_FROM" "${TARGET_FULL:0:7}"
					continue
				fi
				ABSENT_INTRODUCER=$(git -c log.follow=false log --diff-filter=A --format='%h (%s)' --reverse "$TARGET_FULL..HEAD" -- ":(literal)$ABSENT_PATH" | head -1)
				# The pathspec hides a rename's source, so an add there may be a rename the range-wide
				# pairing above missed – later edits outgrowing the old content – asked of that commit alone,
				# for a path kept where the merge pairs renames, as only then does an edit pause's change
				# at the old name replay through it
				ABSENT_FROM=
				if [ -n "$ABSENT_INTRODUCER" ] && [ "$ABSENT_RENAMES_READ" = merge ] && git cat-file -e "$FOLD_SNAP:$ABSENT_PATH" 2>/dev/null; then
					RENAME_FIELDS=(${(0)"$(git diff-tree -z -r -M --name-status --diff-filter=R --no-commit-id "${ABSENT_INTRODUCER%% *}" 2>/dev/null)"})
					for (( RI = 1; RI + 2 <= ${#RENAME_FIELDS}; RI += 3 )); do
						[ "${RENAME_FIELDS[RI + 2]}" = "$ABSENT_PATH" ] && { ABSENT_FROM=${RENAME_FIELDS[RI + 1]}; break; }
					done
					# Only a name the target holds is one an edit pause there can change
					[ -n "$ABSENT_FROM" ] && ! git cat-file -e "$TARGET_FULL:$ABSENT_FROM" 2>/dev/null && ABSENT_FROM=
				fi
				if [ -n "$ABSENT_FROM" ]; then
					ABSENT_MOVED+=("$ABSENT_PATH – was $ABSENT_FROM at ${TARGET_FULL:0:7}, renamed in $ABSENT_INTRODUCER")
				# A removal there removes nothing, the later add bringing the file back
				elif [ -n "$ABSENT_INTRODUCER" ] && ! git cat-file -e "$FOLD_SNAP:$ABSENT_PATH" 2>/dev/null; then
					ABSENT_GONE+=("$ABSENT_PATH – arrives in $ABSENT_INTRODUCER, bringing back what the fold removes")
				elif [ -n "$ABSENT_INTRODUCER" ]; then
					ABSENT_LINES+=("$ABSENT_PATH – arrives in $ABSENT_INTRODUCER")
				elif git cat-file -e "$FOLD_SNAP:$ABSENT_PATH" 2>/dev/null; then
					PRINT_TEXT "Note: %s does not exist at %s – the fold introduces it there, and every descendant inherits it." 90 "$ABSENT_PATH" "${TARGET_FULL:0:7}"
				fi
			fi
		done
		ABSENT_ADDS=${#ABSENT_LINES}
		if [ ${#ABSENT_LINES[@]} -gt 0 ] || [ ${#ABSENT_MOVED[@]} -gt 0 ]; then
			if (( ABSENT_ADDS )); then
				PRINT_ERR "${${AMEND_TREE:+Folded}:-Staged} path(s) do not exist at ${TARGET_FULL:0:7} – replaying the commit that introduces them would raise an add/add conflict"
			else
				PRINT_ERR "${${AMEND_TREE:+Folded}:-Staged} path(s) do not exist at ${TARGET_FULL:0:7} by that name – renamed in a later commit, whose replay would meet the fold's copy as an add/add conflict"
			fi
			# Each names the commit a path arrives in, its subject shown inert
			ABSENT_LINES+=("${ABSENT_MOVED[@]}" "${ABSENT_GONE[@]}")
			_CARET "${(F)ABSENT_LINES}"
			print -r -- "$REPLY" | LC_ALL=C sed "s/^/${_RED}  /;s/\$/${_OFF}/" >&2
			if (( ABSENT_ADDS )); then
				ECHO_E "\e[0;31m  Fold into the introducing commit or later – or pass --allow-new-path to override${ABSENT_GONE:+ for the added ones, folding the removals apart, as one there takes nothing}.\e[0m" >&2
			elif [ ${#ABSENT_GONE[@]} -gt 0 ]; then
				ECHO_E "\e[0;31m  Fold the removals into the commit that adds them or a later one.\e[0m" >&2
			fi
			# An edit pause authors at the target itself, where the file still has its old name
			if [ ${#ABSENT_MOVED[@]} -gt 0 ]; then
				local LEAD=Change
				(( ABSENT_ADDS + ${#ABSENT_GONE} )) && LEAD="For a renamed one, change"
				ECHO_E "\e[0;31m  $LEAD it under its old name in an edit pause: 'git edit ${TARGET_FULL:0:7}', make the change to the old path in the worktree the pause names, then 'git edit --continue'.\e[0m" >&2
			fi
			exit 1
		elif [ ${#ABSENT_GONE[@]} -gt 0 ]; then
			# No override to offer – the add replayed above brings the file back, so the fold changes nothing
			PRINT_ERR "${${AMEND_TREE:+Removed}:-Staged removal of} path(s) absent at ${TARGET_FULL:0:7} – the commit that adds them comes later and brings them back, so nothing would be removed"
			_CARET "${(F)ABSENT_GONE}"
			print -r -- "$REPLY" | LC_ALL=C sed "s/^/${_RED}  /;s/\$/${_OFF}/" >&2
			ECHO_E "\e[0;31m  Fold the removal into the commit that adds them or a later one.\e[0m" >&2
			exit 1
		fi
	fi

	# Pre-flight – a flipped file mode is refused, since a fold rarely means one: the usual
	# cause is a literal mode typed into `update-index --cacheinfo`, stripping an executable
	# bit, and it would ride into history invisibly, a diffstat counting lines only
	if [ ${#OPT_ALLOW_MODE_CHANGE} -eq 0 ]; then
		local MODE_FLIPS=$(git diff --ignore-submodules=none --summary "$ORIG_HEAD" "$FOLD_SNAP" 2>/dev/null | LC_ALL=C grep -a '^ mode change')
		if [ -n "$MODE_FLIPS" ]; then
			# Whole files take their mode from the checkout, where a chmod is the cause
			if [ ${#OPT_WHOLE} -gt 0 ]; then
				PRINT_ERR "A file-mode change rides along – a lost executable bit, most often – so nothing folded"
			else
				PRINT_ERR "The fold would change a file mode – a literal mode in 'git update-index --cacheinfo', taking the executable bit with it?"
			fi
			print -r -- "$MODE_FLIPS" | _CARET_LINES | LC_ALL=C sed "s/^ /${_RED}  /;s/\$/${_OFF}/" >&2
			if [ ${#OPT_WHOLE} -gt 0 ]; then
				_MODE_REMEDY "$MODE_FLIPS"
			else
				ECHO_E "\e[0;31m  Take the mode from 'git ls-tree HEAD -- <path>' instead – or pass --allow-mode-change to fold it anyway.\e[0m" >&2
			fi
			exit 1
		fi
	fi

	if [ ${#OPT_SNAPSHOT} -gt 0 ]; then
		_AMEND_INTO_SNAPSHOT
		return
	fi

	# Step 1 – snapshot the staged index as a commit object, `write-tree` plus `commit-tree`
	# building it without moving a ref or touching the index, so the staging survives to the CAS
	local TARGET_SUBJECT=$(git log -1 --format='%s' "$TARGET_FULL")

	# A message alongside the fold rewords the target in the same run, `git commit --amend -m`
	# semantics – done before the fixup exists, since rewording afterwards must find the
	# amended commit again, and a dropped empty replay makes any offset risk the wrong one
	local FIXUP_PARENT=$ORIG_HEAD
	# Armed ahead of the reword, whose map the hold-back then carries along with the rebase's
	_CAPTURE_BEGIN
	if [ -n "$TEXT_VALUE" ]; then
		AMEND_OLD_SHA=$TARGET_FULL
		_REWORD_AND_REBUILD "$TARGET_FULL" "$TEXT_VALUE" "$ORIG_HEAD"
		# The autosquash below rebuilds these commits again, so this step's map names intermediates
		# that never reach the branch – held back, the landing follows each on to its final commit,
		# and without the hold-back it goes out now, for the rebase's own copy to relay it onward
		if [ "$_CAPTURE_REWRITES" = "true" ]; then
			_CAPTURE_HOLD_PAIRS
		else
			_EMIT_REWRITES
		fi
		# The fixup rides on the rebuilt chain, and `fixup!` matches by subject,
		# so both must follow the reword
		FIXUP_PARENT=$_REWORDED_TIP
		TARGET_FULL=$_REWORDED_TARGET
		TARGET_SUBJECT=$(git log -1 --format='%s' "$TARGET_FULL")
	fi

	local STAGED_TREE=$FOLD_SNAP
	local FIXUP_COMMIT
	FIXUP_COMMIT=$(git commit-tree "$STAGED_TREE" -p "$FIXUP_PARENT" -m "fixup! $TARGET_SUBJECT" </dev/null) || exit 1
	PRINT_CMD "git write-tree + commit-tree -> ${FIXUP_COMMIT:0:7} # fixup! object, branch untouched"

	# Step 2: isolated worktree at the fixup commit object
	local WT
	WT=$(MKTEMP_DIR git-edit-amend-into) || exit 1
	rmdir "$WT"
	_CLEANUP_HOOK="git worktree remove --force ${(q-)WT} 2>/dev/null; rm -rf ${(q-)WT}"
	_WORKTREE_ADD "$WT" "$FIXUP_COMMIT" quiet || exit 1
	_LINK_WORKTREE_EXTRAS "$WT"

	cd "$WT" || exit 1

	# Determine rebase base (parent of target, or --root if target is initial commit)
	local REBASE_BASE
	if git rev-parse --verify "$TARGET_FULL^" >/dev/null 2>&1; then
		REBASE_BASE="$TARGET_FULL^"
	else
		REBASE_BASE="--root"
	fi

	# Step 3 – autosquash, where `GIT_SEQUENCE_EDITOR=true` accepts the auto-arranged todo and
	# `GIT_EDITOR=true` keeps any message editor shut, defensive under fixup semantics
	# `rerere` replays an already-resolved hunk, and `rr-cache` carries that across retries
	# The fold's own fixup alone goes beside its target – `--autosquash` moved every `fixup!` in the
	# span, another commit's included
	local SEQ=$(MKTEMP_FILE git-edit-fold-seq)
	_TEMP_FILES+=("$SEQ")
	cat > "$SEQ" <<'SEQEOF'
#!/bin/sh
awk -v fix="$GIT_EDIT_FOLD_FIXUP" -v tgt="$GIT_EDIT_FOLD_TARGET" '
	$1 == "pick" && length($2) >= 7 && index(fix, $2) == 1 { next }
	{ print }
	!done && $1 == "pick" && length($2) >= 7 && index(tgt, $2) == 1 { print "fixup " fix; done = 1 }
' "$1" > "$1.git-edit" && mv "$1.git-edit" "$1"
SEQEOF
	chmod +x "$SEQ"
	local REBASE_CMD="GIT_EDIT_FOLD_FIXUP=$FIXUP_COMMIT GIT_EDIT_FOLD_TARGET=$TARGET_FULL GIT_SEQUENCE_EDITOR=${(q-)$(_SH_WORD "$SEQ")} GIT_EDITOR=true git -c commit.cleanup=verbatim -c rerere.enabled=true -c rerere.autoUpdate=false -c rebase.updateRefs=false -c advice.mergeConflict=false -c advice.resolveConflict=false -c rebase.instructionFormat= $_CAPTURE_PINS rebase $_CAPTURE_EXEC --no-autosquash --no-autostash --interactive $REBASE_BASE"
	PRINT_CMD "$REBASE_CMD" 90
	_RERERE_SCOPE_BEGIN
	_REBASE_FIRST_RUN "$REBASE_CMD"
	local RC=$?
	# An `--edits` fold's stop resolves itself where each conflicted file holds every old text once in
	# the commit the stop builds – that commit's own content plus the fold's change, what a rebuild of
	# it holds – the replay going on, until one doesn't, which pauses as before
	local -i EDIT_STOPS=0
	local EDITS_TIP_OK="" EDITS_CONTINUE=""
	while (( RC == 2 )) && _EDITS_RESOLVE_STOP "$WT"; do
		EDIT_STOPS+=1
		# Resumed as a caller's continue resumes, each step's own message written back over git's
		if [ -z "$EDITS_CONTINUE" ]; then
			_RESUME_EDITOR "$WT"
			EDITS_CONTINUE="GIT_SEQUENCE_EDITOR=true GIT_EDITOR=${(q)REPLY} git -c commit.cleanup=verbatim -c rerere.enabled=true -c rerere.autoUpdate=false -c rebase.updateRefs=false -c advice.mergeConflict=false -c advice.resolveConflict=false $_CAPTURE_PINS rebase --continue"
		fi
		_REBASE_FIRST_RUN "$EDITS_CONTINUE"
		RC=$?
	done
	(( EDIT_STOPS )) && PRINT_TEXT "Made the edits in the %s commit(s) the replay stopped at, each holding every old text once." 90 "$EDIT_STOPS"
	(( RC == 1 )) && _REFUSE_REBASE_FAILED "fold again – $(_FOLD_SOURCE) untouched."
	if (( RC != 0 )) && \
	   ! { _AUTO_RESOLVE_FINAL_STEP "$WT" "$STAGED_TREE" guard-empty && _FINISH_AUTO_RESOLVED_STEP "$WT" "staged" }; then
		# Conflict during autosquash – save state and leave the worktree alive for `git edit
		# --continue`, or `git edit --abort` to cancel, since the branch never moved and the
		# staged changes are still staged in main
		_REFUSE_NEWLINE_NAMES --fold "$TARGET_FULL" "${STAGED_PATHS[@]}" "${AMEND_PATHSPECS[@]}"
		_SAVE_STATE \
			"operation=amend-into" \
			"fixup=$FIXUP_COMMIT" \
			"worktree=$WT" \
			"branch=$REF" \
			"orig_head=$ORIG_HEAD" \
			"target=$TARGET_FULL" \
			"depth=$DEPTH" \
			"rebasebase=$REBASE_BASE" \
			"stagedtree=$STAGED_TREE" \
			"maindir=$MAIN_DIR" \
			"files=$(_STATE_LIST_TABS "${STAGED_PATHS[@]}")" \
			"pathspecs=$(_STATE_LIST_TABS "${AMEND_PATHSPECS[@]}")" \
			"files_q=$(_STATE_LIST "${STAGED_PATHS[@]}")" \
			"pathspecs_q=$(_STATE_LIST "${AMEND_PATHSPECS[@]}")" \
			"tree=$AMEND_TREE"
		# Don't auto-cleanup the worktree – it holds the in-progress rebase
		_CLEANUP_HOOK=""

		PRINT_ERR "Conflict during autosquash – resolve in worktree, then 'git edit --continue'"
		PRINT_TEXT "Worktree: %s" 33 "$WT"
		local UNMERGED_LIST=$(_PRINT_CONFLICT_DETAIL "$WT")
		PRINT_TEXT "Or abort the operation: %s" 33 "git edit --abort"
		EMIT_CONFLICT "$WT" "$UNMERGED_LIST"
		_PAUSE_EXIT 2 conflict
	fi

	local NEW_HEAD=$(git rev-parse HEAD)

	# A tip tree identical to the pre-op tip means nothing folded – the target already carried
	# every staged hunk, a staged revert of a later change say, so the fixup dissolved and
	# each pick replayed itself, and landing it would report a fold that never happened
	if [ "$(git rev-parse 'HEAD^{tree}')" = "$(git rev-parse "$ORIG_HEAD^{tree}")" ]; then
		PRINT_ERR "The fold left history unchanged – ${TARGET_FULL:0:7} already carries that content"
		PRINT_TEXT "Nothing was applied; %s untouched." 33 "$(_FOLD_SOURCE)"
		exit 1
	fi

	# Verification gate – the fold is built but not applied, so a failure pauses with
	# everything in place and the resolution work survives
	local VERIFY_PRIMARY
	if [ "$REBASE_BASE" = "--root" ]; then
		VERIFY_PRIMARY=$(git rev-list --reverse "$NEW_HEAD" 2>/dev/null | head -1)
	else
		VERIFY_PRIMARY=$(git rev-list --reverse "$REBASE_BASE..$NEW_HEAD" 2>/dev/null | head -1)
	fi
	_VERIFY_CONFIGURED && _REQUIRE_CURRENT "$REF" "$ORIG_HEAD"
	if ! _GUARD_TIP_MODES "$WT" "$NEW_HEAD" "$ORIG_HEAD" "$(_MODE_LINES "$WT" "$ORIG_HEAD" "$STAGED_TREE")" || ! _VERIFY_REWRITE "$WT" "$NEW_HEAD" "$ORIG_HEAD" "$VERIFY_PRIMARY"; then
		_REFUSE_NEWLINE_NAMES --fold "$TARGET_FULL" "${STAGED_PATHS[@]}" "${AMEND_PATHSPECS[@]}"
		_SAVE_STATE \
			"operation=amend-into" \
			"fixup=$FIXUP_COMMIT" \
			"worktree=$WT" \
			"branch=$REF" \
			"orig_head=$ORIG_HEAD" \
			"target=$TARGET_FULL" \
			"depth=$DEPTH" \
			"rebasebase=$REBASE_BASE" \
			"stagedtree=$STAGED_TREE" \
			"maindir=$MAIN_DIR" \
			"files=$(_STATE_LIST_TABS "${STAGED_PATHS[@]}")" \
			"pathspecs=$(_STATE_LIST_TABS "${AMEND_PATHSPECS[@]}")" \
			"files_q=$(_STATE_LIST "${STAGED_PATHS[@]}")" \
			"pathspecs_q=$(_STATE_LIST "${AMEND_PATHSPECS[@]}")" \
			"tree=$AMEND_TREE"
		_CLEANUP_HOOK=""
		EMIT_GATE_PAUSED "$WT" "$NEW_HEAD"
		_PAUSE_EXIT 2 gate
	fi

	# Step 4 – atomic CAS-update of the branch ref, guarded on the pre-op tip, refusing where
	# the branch moved during autosquash, since nothing was consumed and the staging stands
	local UPDATE_CMD="git update-ref -m ${(q-)${:-git edit: amend-into ${TARGET_FULL:0:7}$_REFLOG_TAG}} ${(q-)REF} ${(q-)NEW_HEAD} ${(q-)ORIG_HEAD}"
	PRINT_CMD "$UPDATE_CMD" 90
	if ! _MOVE_REF "$UPDATE_CMD"; then
		PRINT_ERR "Branch '$REF' moved during autosquash – refusing to overwrite"
		PRINT_TEXT "Nothing was applied; %s untouched – retry when ready." 33 "$(_FOLD_SOURCE)"
		exit 1
	fi
	_RECORD_REF_MOVE "$REF" "$ORIG_HEAD" "$NEW_HEAD" "amend-into ${TARGET_FULL:0:7}"

	# Re-sync exactly the folded paths' index entries to the new `HEAD`, those staged changes
	# being history now – path-scoped, so anything a parallel session staged meanwhile keeps
	# its staged state where a whole-index reset would wipe it
	# A `--tree` fold staged nothing, so the summary reconciles its entries like any other rewrite's
	[ -z "$AMEND_TREE" ] && _RESYNC_FOLDED "$MAIN_DIR" "$STAGED_TREE" "${STAGED_PATHS[@]}"

	_PRINT_AMENDED_SUMMARY "$NEW_HEAD" "$DEPTH" "$STAGED_FILES" "$MAIN_DIR" "$REBASE_BASE" "$ORIG_HEAD" "$STAGED_TREE" ""

	# Export new `HEAD` + ref for the success trailer in the dispatch block
	AMEND_NEW_HEAD=$NEW_HEAD
	AMEND_REF=$REF
}

# Composes the tree a fold carries – a scoped fold takes the pre-op tip plus only the named staged
# entries, so whatever else sits in the shared index cannot ride along into a past commit, a
# parallel session's staging included, which can land in the turn between `git add` and the call
_FOLD_TREE () {
	# Args: <pre-op tip>
	if [ ${#AMEND_PATHSPECS[@]} -gt 0 ]; then
		_STAGED_TREE_FOR "$1"
	elif [ -n "$AMEND_TREE" ]; then
		print -r -- "$AMEND_TREE"
	else
		git write-tree 2>/dev/null
	fi
}

# Puts into `REPLY` <text> with the `--edits` for <path> made in turn, as composing them on the tip
# made them – failing where an old text matches anything but once
_EDITS_REPLACED () {
	# Args: <path from the top> <text>
	setopt local_options no_multibyte
	local TEXT=$2 OLD
	local -i K
	for (( K = 1; K <= ${#EDITS_PATH}; K++ )); do
		[ "${EDITS_PATH[K]}" = "$1" ] || continue
		OLD=${EDITS_OLD[K]}
		[ -n "$OLD" ] || return 1
		_EDIT_MATCHES "$TEXT" "$OLD"
		(( REPLY == 1 )) || return 1
		TEXT=${TEXT/$OLD/${EDITS_NEW[K]}}
	done
	REPLY=$TEXT
}

# Resolves the stop the replay in <worktree> is at by making the `--edits` in the content of the
# commit the stop builds – stage 3 at a pick, the target's own, stage 2, at the fold's fixup – that
# commit's original content plus the fold's change, what rebuilding it by replacement gives
# • Returns 1, touching nothing, unless each conflicted file is an edited one in a conflict over its
#   content, holding every old text exactly once there, and the edits made in the tip's text are
#   what the fold composed, as a cleaning filter can make them otherwise
_EDITS_RESOLVE_STOP () {
	# Args: <worktree> – reads the caller's `ORIG_HEAD`, `FOLD_SNAP` and `EDITS_TIP_OK`
	setopt local_options no_multibyte
	local WT=$1 GD STEP REV L P Q ID TEXT TAB=$'\t'
	local -i I STAGE
	local -a U F INFO
	local -A AT
	(( ${#OPT_EDITS} && ${#EDITS_PATH} && ! ${#OPT_PATCH} && ! ${#OPT_PUT} && ! ${#OPT_RM} && ! ${#OPT_CHMOD} && ! ${#OPT_WHOLE} )) || return 1
	if [ -z "$EDITS_TIP_OK" ]; then
		EDITS_TIP_OK=1
		for P in "${(@u)EDITS_PATH}"; do
			TEXT=$(git cat-file blob "$ORIG_HEAD:$P" 2>/dev/null; print -n x)
			_EDITS_REPLACED "$P" "${TEXT%x}" && \
				[ "${REPLY}x" = "$(git cat-file blob "$FOLD_SNAP:$P" 2>/dev/null; print -n x)" ] || { EDITS_TIP_OK=0; break; }
		done
	fi
	(( EDITS_TIP_OK )) || return 1
	GD=$(git -C "$WT" rev-parse --absolute-git-dir 2>/dev/null) && [ -f "$GD/rebase-merge/done" ] || return 1
	U=(${(f)"$(<"$GD/rebase-merge/done")"})
	U=(${U:#\#*})
	STEP=${U[-1]} U=()
	case ${STEP%% *} in
		p|pick) STAGE=3 REV=${${STEP#* }%% *} ;;
		f|fixup) STAGE=2 REV=HEAD ;;
		*) return 1 ;;
	esac
	# "<mode> <id> <stage>\t<path>" – keyed by stage and path, as a path may hold a colon
	for L in ${(0)"$(git -C "$WT" ls-files -u -z 2>/dev/null)"}; do
		AT[${${L%%$TAB*}##* }$TAB${L#*$TAB}]="${L%% *} ${${L#* }%% *}"
		U+=("${L#*$TAB}")
	done
	U=("${(@u)U}")
	(( ${#U} )) || return 1
	for P in "${U[@]}"; do
		[[ -n "${AT[1$TAB$P]}" && "${AT[2$TAB$P]}" == 100(644|755)\ * && "${AT[3$TAB$P]}" == 100(644|755)\ * ]] || return 1
		# A file the commit holds under the name it had before a later rename takes the tip name's edits,
		# paired as the replay's merge pairs it
		Q=$P
		if (( ! ${EDITS_PATH[(Ie)$P]} )); then
			Q=""
			if _MERGE_DETECTS_RENAMES; then
				(( ${#F} )) || F=("${(@0)$(git -C "$WT" diff-tree -r -z -M -l"$(git config --get merge.renameLimit || git config --get diff.renameLimit || echo 7000)" --diff-filter=R --name-status "$REV" "$ORIG_HEAD" 2>/dev/null)}")
				for (( I = 1; I + 2 <= ${#F}; I += 3 )); do
					[ "${F[I+1]}" = "$P" ] && (( ${EDITS_PATH[(Ie)${F[I+2]}]} )) && { Q=${F[I+2]}; break; }
				done
			fi
			[ -n "$Q" ] || return 1
		fi
		TEXT=$(git -C "$WT" cat-file blob "${AT[$STAGE$TAB$P]#* }" 2>/dev/null; print -n x)
		_EDITS_REPLACED "$Q" "${TEXT%x}" || return 1
		ID=$(print -rn -- "$REPLY" | git -C "$WT" hash-object -w --no-filters --stdin 2>/dev/null) && [ -n "$ID" ] || return 1
		INFO+=("${AT[$STAGE$TAB$P]%% *} $ID$TAB$P")
	done
	# Staged in the place of its stages, as a resolver's `git add` stages it, and written out, so the
	# replay goes on finding nothing unmerged nor unstaged
	{
		for P in "${U[@]}"; do
			print -rn -- "0 ${(l:${#ID}::0:)}$TAB$P"$'\0'
		done
		print -rN -- "${INFO[@]}"
	} | git -C "$WT" update-index -z --index-info 2>/dev/null || return 1
	print -rN -- "${U[@]}" | git -C "$WT" checkout-index -f -z --stdin 2>/dev/null
}

# Tells whether this git's `merge-tree` takes an explicit merge base, which 2.40 added – its usage
# spells the option `--[no-]merge-base` from 2.44 on
_MERGE_TREE_TAKES_BASE () {
	[[ "$( export LC_ALL=C; git merge-tree -h 2>&1 )" == *"merge-base"* ]]
}

# Folds by merging the fold into every commit from the target up instead of replaying the commits
# above it – where later commits rewrote the lines beside the fold, a replay stops at each of
# them, while a snapshot stops once per distinct content of the conflicted file
_AMEND_INTO_SNAPSHOT () {
	if [ -n "$TEXT_VALUE" ]; then
		PRINT_ERR "--snapshot takes no --text – fold first, then reword: git edit -M --text=\"…\" <sha>"
		exit 1
	fi
	if ! _MERGE_TREE_TAKES_BASE; then
		PRINT_ERR "--snapshot needs git 2.40 or later, whose merge-tree takes --merge-base"
		exit 1
	fi
	local STAGED_TREE=$FOLD_SNAP
	# The fold as a commit on the tip, the side every snapshot merges in
	STATE_FOLD=$(git commit-tree "$STAGED_TREE" -p "$ORIG_HEAD" -m "fold into ${TARGET_FULL:0:7}" </dev/null) || exit 1
	STATE_WORKTREE=$(MKTEMP_DIR git-edit-snapshot) || exit 1
	rmdir "$STATE_WORKTREE"
	_CLEANUP_HOOK="git worktree remove --force ${(q-)STATE_WORKTREE} 2>/dev/null; rm -rf ${(q-)STATE_WORKTREE}"
	_WORKTREE_ADD "$STATE_WORKTREE" "$ORIG_HEAD" quiet || exit 1
	_LINK_WORKTREE_EXTRAS "$STATE_WORKTREE"
	STATE_TARGET=$TARGET_FULL
	STATE_ORIG_HEAD=$ORIG_HEAD
	STATE_BRANCH=$REF
	STATE_MAINDIR=$MAIN_DIR
	STATE_DEPTH=$DEPTH
	STATE_STAGEDTREE=$STAGED_TREE
	# As a pause carries them, quoted
	STATE_FILES=$(_STATE_LIST "${STAGED_PATHS[@]}")
	STATE_PATHSPECS=$(_STATE_LIST "${AMEND_PATHSPECS[@]}")
	STATE_TREE=$AMEND_TREE
	STATE_REBASEBASE=--root
	git rev-parse -q --verify "$TARGET_FULL^" >/dev/null 2>&1 && STATE_REBASEBASE="$TARGET_FULL^"
	_RERERE_SCOPE_BEGIN
	_SNAPSHOT_RUN
}

# Puts into `reply` the caller's `STAGES` lines at <path> – the name after the line's first tab
# compared whole, as a pattern would read a `*` or `#` in it, and a tab name ending in another
_SNAPSHOT_STAGES_AT () {
	# Args: <path>
	local S
	reply=()
	for S in "${STAGES[@]}"; do
		[ "${S#*$'\t'}" = "$1" ] && reply+=("$S")
	done
	return 0
}

# Rebuilds each first-parent commit from the target up with the fold merged in, author and
# message kept – `git merge-tree` against the pre-op tip as base carries a renamed path's fold to
# its old name, and a conflict takes the resolution recorded for that path and content, or stops
_SNAPSHOT_BUILD () {
	# Args: <resolution map> – reads `STATE_TARGET`, `STATE_ORIG_HEAD` and `STATE_FOLD`, sets
	# `_SNAPSHOT_TIP`, or on a stop `_SNAPSHOT_ERA`, `_SNAPSHOT_TREE` and `_SNAPSHOT_STAGES`, and
	# returns 2 on a stop, 1 on a refusal it has printed
	local MAP=$1 C OUT RC TREE PARENT NEWC P BLOB LINE KEY IDX
	local -a ERAS MT_LINES STAGES PATHS PENDING SUBST NF
	local -A RES SEEN
	local FIRST_USE
	_REWRITE_PAIRS=()
	_SNAPSHOT_RESOLVED_TREES=()
	if [ -s "$MAP" ]; then
		# A tab through a variable – inside a subscript zsh keeps `$'\t'` as those four characters
		local TAB=$'\t' L
		# From the end, as a name may hold a tab
		while IFS= read -r L; do
			LINE=${L##*$TAB} L=${L%$TAB*}
			BLOB=${L##*$TAB} P=${L%$TAB*}
			RES[$P$TAB$BLOB]=$LINE
		done < "$MAP"
	fi
	PARENT=$(git rev-parse -q --verify "$STATE_TARGET^" 2>/dev/null)
	if [ -n "$PARENT" ]; then
		ERAS=(${(f)"$(git rev-list --reverse --first-parent "$PARENT..$STATE_ORIG_HEAD")"})
	else
		ERAS=(${(f)"$(git rev-list --reverse --first-parent "$STATE_ORIG_HEAD")"})
	fi
	PRINT_CMD "git merge-tree --write-tree --merge-base=${STATE_ORIG_HEAD:0:7} <commit> ${STATE_FOLD:0:7} # each of ${#ERAS[@]} commit(s)" 90
	for C in "${ERAS[@]}"; do
		# NUL-separated, as the line form quotes a name holding a quote, backslash or tab
		OUT=$(git merge-tree --write-tree -z --merge-base="$STATE_ORIG_HEAD" "$C" "$STATE_FOLD" 2>/dev/null)
		RC=$?
		MT_LINES=("${(@0)OUT}")
		TREE=${MT_LINES[1]}
		if [ $RC -eq 1 ]; then
			# The conflicted entries, a line per stage, run up to the blank line before git's messages
			STAGES=()
			for LINE in "${(@)MT_LINES[2,-1]}"; do
				[ -z "$LINE" ] && break
				STAGES+=("$LINE")
			done
			PATHS=(${(u)STAGES[@]#*$'\t'})
			# Only a conflict over content leaves all three stages at a path this commit has – a
			# deletion or a rename meeting the fold has no one text to resolve
			for P in "${PATHS[@]}"; do
				_SNAPSHOT_STAGES_AT "$P"
				if [ ${#reply} -ne 3 ] || ! git cat-file -e "$C:$P" 2>/dev/null; then
					PRINT_ERR "Merging the fold into ${C:0:7} meets $P in a conflict that is not over its content"
					ECHO_E "\e[0;31m  --snapshot resolves content conflicts only – fold without it to replay instead.\e[0m" >&2
					return 1
				fi
			done
			PENDING=()
			SUBST=()
			FIRST_USE=false
			for P in "${PATHS[@]}"; do
				KEY=$P$'\t'$(git rev-parse "$C:$P")
				if [ -n "${RES[$KEY]}" ]; then
					SUBST+=("$P"$'\t'"${RES[$KEY]}")
					[ -z "${SEEN[$KEY]}" ] && FIRST_USE=true
					SEEN[$KEY]=1
				else
					PENDING+=("$P")
				fi
			done
			if [ ${#SUBST[@]} -gt 0 ]; then
				IDX=$(MKTEMP_FILE git-edit-snapshot-idx)
				_TEMP_FILES+=("$IDX")
				rm -f "$IDX"
				GIT_INDEX_FILE=$IDX git read-tree "$TREE" || { rm -f "$IDX"; return 1; }
				for LINE in "${SUBST[@]}"; do
					# From the end, as a name may hold a tab
					P=${LINE%$'\t'*}
					LINE=${LINE##*$'\t'}
					if [ "$LINE" = "-" ]; then
						GIT_INDEX_FILE=$IDX git -C "$(git rev-parse --show-toplevel)" update-index --force-remove -- "$P" || { rm -f "$IDX"; return 1; }
					else
						GIT_INDEX_FILE=$IDX git update-index --add --cacheinfo "${LINE%% *},${LINE#* },$P" || { rm -f "$IDX"; return 1; }
					fi
				done
				TREE=$(GIT_INDEX_FILE=$IDX git write-tree) || { rm -f "$IDX"; return 1; }
				rm -f "$IDX"
			fi
			if [ ${#PENDING[@]} -gt 0 ]; then
				_SNAPSHOT_ERA=$C
				_SNAPSHOT_TREE=$TREE
				_SNAPSHOT_STAGES=()
				for P in "${PENDING[@]}"; do
					_SNAPSHOT_STAGES_AT "$P"
					_SNAPSHOT_STAGES+=("${reply[@]}")
				done
				return 2
			fi
			# The first commit each resolution reaches, for the gate's default tier to check
			[ "$FIRST_USE" = "true" ] && _SNAPSHOT_RESOLVED_TREES+=("$TREE")
		elif [ $RC -ne 0 ]; then
			PRINT_ERR "git merge-tree could not merge the fold into ${C:0:7}"
			return 1
		fi
		# The message ends on a NUL, so the capture keeps its trailing newlines
		NF=("${(@0)$(git log -1 --format='%an%x00%ae%x00%ad%x00%B%x00' --date=raw "$C")}")
		_MSG_FILE "${NF[4]}" || return 1
		if [ -n "$PARENT" ]; then
			NEWC=$(_COMMIT_TREE_AS "$C" "${NF[1]}" "${NF[2]}" "${NF[3]}" "$TREE" -p "$PARENT" -F "$REPLY") || return 1
		else
			NEWC=$(_COMMIT_TREE_AS "$C" "${NF[1]}" "${NF[2]}" "${NF[3]}" "$TREE" -F "$REPLY") || return 1
		fi
		_RECORD_REWRITE "$C" "$NEWC"
		PARENT=$NEWC
	done
	_SNAPSHOT_TIP=$PARENT
	return 0
}

# Lays the first conflict no resolution covers out in the worktree as any merge's – the commit
# checked out, the merge's result in place, its conflicted paths at their three stages – so `git
# status`, rerere and the resolution guard read it as usual, then pauses
_SNAPSHOT_PAUSE () {
	# Args: <worktree git dir>
	local WT=$STATE_WORKTREE P
	local -a PATHS=(${(u)_SNAPSHOT_STAGES[@]#*$'\t'})
	local NULL_OID=${(l:${#_SNAPSHOT_ERA}::0:)}
	git -C "$WT" checkout -qf --detach "$_SNAPSHOT_ERA" 2>/dev/null
	if ! git -C "$WT" read-tree --reset -u "$_SNAPSHOT_TREE" 2>/dev/null || \
	   ! { for P in "${PATHS[@]}"; do print -rn -- "0 $NULL_OID"$'\t'"$P"$'\0'; done; print -rn -- "${(pj:\0:)_SNAPSHOT_STAGES}"$'\0'; } | git -C "$WT" update-index -z --index-info; then
		PRINT_ERR "Could not lay the conflict at ${_SNAPSHOT_ERA:0:7} out in the worktree"
		exit 1
	fi
	: >| "$1/git-edit-snapshot-pending"
	print -r -- "$_SNAPSHOT_TREE" >| "$1/git-edit-snapshot-tree"
	for P in "${PATHS[@]}"; do
		print -r -- "$P"$'\t'"$(git rev-parse "$_SNAPSHOT_ERA:$P")" >> "$1/git-edit-snapshot-pending"
	done
	# A hunk resolved at an earlier stop arrives pre-filled – that stop's own record, recorded at
	# its continue, would otherwise count as this one's
	rm -f "$1/MERGE_RR"
	git -C "$WT" -c rerere.enabled=true -c rerere.autoUpdate=false rerere >/dev/null 2>&1
	_SNAPSHOT_SAVE_STATE
	_CLEANUP_HOOK=""
	PRINT_ERR "Conflict merging the fold into ${_SNAPSHOT_ERA:0:7} – resolve in the worktree, stage it, then 'git edit --continue'"
	_PRINT_COMMIT_LINE "$_SNAPSHOT_ERA" '  at: %h %s'
	PRINT_TEXT "%s" 33 "The resolution serves every later commit carrying the same content, so each stops once."
	PRINT_TEXT "Worktree: %s" 33 "$WT"
	local UNMERGED_LIST=$(_PRINT_CONFLICT_DETAIL "$WT")
	PRINT_TEXT "Or abort the operation: %s" 33 "git edit --abort"
	EMIT_CONFLICT "$WT" "$UNMERGED_LIST"
	_PAUSE_EXIT 2 conflict
}

_SNAPSHOT_SAVE_STATE () {
	_REFUSE_NEWLINE_NAMES --fold "$STATE_TARGET" "${(@Q)${(z)STATE_FILES}}" "${(@Q)${(z)STATE_PATHSPECS}}"
	_SAVE_STATE \
		"operation=snapshot" \
		"worktree=$STATE_WORKTREE" \
		"branch=$STATE_BRANCH" \
		"orig_head=$STATE_ORIG_HEAD" \
		"target=$STATE_TARGET" \
		"depth=$STATE_DEPTH" \
		"rebasebase=$STATE_REBASEBASE" \
		"stagedtree=$STATE_STAGEDTREE" \
		"fold=$STATE_FOLD" \
		"maindir=$STATE_MAINDIR" \
		"files=$(_STATE_LIST_TABS "${(@Q)${(z)STATE_FILES}}")" \
		"pathspecs=$(_STATE_LIST_TABS "${(@Q)${(z)STATE_PATHSPECS}}")" \
		"files_q=$STATE_FILES" \
		"pathspecs_q=$STATE_PATHSPECS" \
		"tree=$STATE_TREE"
}

# Builds the snapshot fold and lands it, or pauses at a conflict no resolution covers – the first
# run and every `--continue` alike, the build being quick and the map carrying what was resolved
_SNAPSHOT_RUN () {
	local WT=$STATE_WORKTREE LINE
	local GD=$(git -C "$WT" rev-parse --absolute-git-dir)
	local -a _SNAPSHOT_STAGES _SNAPSHOT_RESOLVED_TREES EMPTIED
	local _SNAPSHOT_TIP _SNAPSHOT_ERA _SNAPSHOT_TREE
	_SNAPSHOT_BUILD "$GD/git-edit-snapshot-map"
	case $? in
		0) ;;
		2) _SNAPSHOT_PAUSE "$GD" ;;
		*) exit 1 ;;
	esac
	local NEW_HEAD=$_SNAPSHOT_TIP
	# The last snapshot is the tip merged with its own fold, so it must carry the fold exactly
	if [ "$(git rev-parse "$NEW_HEAD^{tree}")" != "$(git rev-parse "$STATE_STAGEDTREE^{tree}")" ]; then
		PRINT_ERR "The rebuilt tip differs from the fold applied to the tip – refusing to land it"
		exit 1
	fi
	local RESOLUTIONS=0
	[ -s "$GD/git-edit-snapshot-map" ] && RESOLUTIONS=$(grep -c . "$GD/git-edit-snapshot-map")
	PRINT_TEXT "Merged the fold into %s commit(s) from %s up, with %s resolution(s)." 32 "${#_REWRITE_PAIRS[@]}" "${STATE_TARGET:0:7}" "$RESOLUTIONS"
	# A commit the fold emptied stays, as nothing here drops one – named, unless empty before too
	local -A TREE_OF PARENT_OF
	local -a SPAN=("$NEW_HEAD" "$STATE_ORIG_HEAD")
	local BELOW=$(git rev-parse -q --verify "$STATE_TARGET^" 2>/dev/null)
	if [ -n "$BELOW" ]; then
		SPAN+=(--not "$BELOW")
		TREE_OF[$BELOW]=$(git rev-parse "$BELOW^{tree}")
	fi
	for LINE in ${(f)"$(git log --format='%H %T %P' "${SPAN[@]}" 2>/dev/null)"}; do
		TREE_OF[${LINE%% *}]=${${LINE#* }%% *}
		PARENT_OF[${LINE%% *}]=${${LINE#* * }%% *}
	done
	for LINE in "${_REWRITE_PAIRS[@]}"; do
		[ "${TREE_OF[${LINE#* }]}" = "${TREE_OF[${PARENT_OF[${LINE#* }]}]}" ] && \
		[ "${TREE_OF[${LINE%% *}]}" != "${TREE_OF[${PARENT_OF[${LINE%% *}]}]}" ] && EMPTIED+=("${LINE#* }")
	done
	for LINE in "${EMPTIED[@]}"; do
		_PRINT_COMMIT_LINE "$LINE" '  left empty by the fold: %h %s'
	done
	git -C "$WT" checkout -qf --detach "$NEW_HEAD" 2>/dev/null
	STATE_RESOLVED="${_SNAPSHOT_RESOLVED_TREES[*]}"
	_VERIFY_CONFIGURED && _REQUIRE_CURRENT "$STATE_BRANCH" "$STATE_ORIG_HEAD"
	if ! _GUARD_TIP_MODES "$WT" "$NEW_HEAD" "$STATE_ORIG_HEAD" "$(_MODE_LINES "$WT" "$STATE_ORIG_HEAD" "$STATE_STAGEDTREE")" || ! _VERIFY_REWRITE "$WT" "$NEW_HEAD" "$STATE_ORIG_HEAD" ""; then
		_SNAPSHOT_SAVE_STATE
		_CLEANUP_HOOK=""
		EMIT_GATE_PAUSED "$WT" "$NEW_HEAD"
		_PAUSE_EXIT 2 gate
	fi
	local UPDATE_CMD="git update-ref -m ${(q-)${:-git edit: amend-into ${STATE_TARGET:0:7}$_REFLOG_TAG}} ${(q-)STATE_BRANCH} ${(q-)NEW_HEAD} ${(q-)STATE_ORIG_HEAD}"
	PRINT_CMD "$UPDATE_CMD" 90
	if ! _MOVE_REF "$UPDATE_CMD"; then
		[ -n "$_STATE_OWNED" ] && _REFUSE_MOVED_BRANCH "$STATE_BRANCH" "$WT"
		PRINT_ERR "Branch '$STATE_BRANCH' moved during the snapshot fold – refusing to overwrite"
		PRINT_TEXT "Nothing was applied; %s untouched – retry when ready." 33 "$(_FOLD_SOURCE)"
		exit 1
	fi
	_RECORD_REF_MOVE "$STATE_BRANCH" "$STATE_ORIG_HEAD" "$NEW_HEAD" "amend-into ${STATE_TARGET:0:7}"
	# The folded paths' index entries follow the new tip, as a replayed fold's do – a `--tree`
	# fold staged nothing, so the summary reconciles its entries like any other rewrite's
	AMEND_TREE=$STATE_TREE
	[ -z "$AMEND_TREE" ] && [ -n "$STATE_FILES" ] && _RESYNC_FOLDED "$STATE_MAINDIR" "$STATE_STAGEDTREE" "${(@Q)${(z)STATE_FILES}}"
	[ -n "$STATE_PATHSPECS" ] && AMEND_PATHSPECS=("${(@Q)${(z)STATE_PATHSPECS}}")
	_PRINT_AMENDED_SUMMARY "$NEW_HEAD" "$STATE_DEPTH" "${STATE_FILES:+$(_SOME_PATHS -q "${(@Q)${(z)STATE_FILES}}")}" "$STATE_MAINDIR" "$STATE_REBASEBASE" "$STATE_ORIG_HEAD" "$STATE_STAGEDTREE" "${_SNAPSHOT_RESOLVED_TREES:+resolved}"
	[ -n "$_STATE_OWNED" ] && _CLEAR_STATE
	AMEND_NEW_HEAD=$NEW_HEAD
	AMEND_REF=$STATE_BRANCH
}

# Records the resolution staged for each path that stopped, keyed by that path and the stopped
# commit's content so every commit carrying the same takes it, then builds again
_CONTINUE_SNAPSHOT () {
	if [ -n "$TEXT_VALUE" ]; then
		PRINT_ERR "--snapshot takes no --text – finish the fold, then reword: git edit -M --text=\"…\" <sha>"
		exit 1
	fi
	if [ ! -d "$STATE_WORKTREE" ]; then
		PRINT_ERR "Worktree no longer exists: $STATE_WORKTREE"
		_CLEAR_STATE
		exit 1
	fi
	_CLEANUP_HOOK="git worktree remove --force ${(q-)STATE_WORKTREE} 2>/dev/null; rm -rf ${(q-)STATE_WORKTREE}"
	PRINT_ACTION "Continuing the snapshot fold into %s..." "$STATE_TARGET"
	local WT=$STATE_WORKTREE P BLOB ENTRY
	local GD=$(git -C "$WT" rev-parse --absolute-git-dir)
	if [ -s "$GD/git-edit-snapshot-pending" ]; then
		local -a UNMERGED
		UNMERGED=(${(0)"$(_UNMERGED_IN "$WT")"})
		if (( ${#UNMERGED} )); then
			_CLEANUP_HOOK=""
			PRINT_ERR "Unresolved paths remain – resolve and stage them, then 'git edit --continue'"
			EMIT_CONFLICT "$WT" "${(F)UNMERGED}"
			_PAUSE_EXIT 2 conflict
		fi
		_GUARD_RESOLUTION_CLEAN "$WT" "$STATE_FOLD"
		# Staging beyond the stopped paths would never reach a commit – the snapshot takes their
		# resolutions alone – so it refuses rather than drop it
		local -a STOPPED EXTRA
		local SLINE
		while IFS= read -r SLINE; do STOPPED+=("${SLINE%$'\t'*}"); done < "$GD/git-edit-snapshot-pending"
		if [ -s "$GD/git-edit-snapshot-tree" ]; then
			for P in ${(0)"$(git -C "$WT" diff-index --cached -z --name-only "$(<"$GD/git-edit-snapshot-tree")" 2>/dev/null)"}; do
				(( ${STOPPED[(Ie)$P]} )) || EXTRA+=("$P")
			done
		fi
		if [ ${#EXTRA} -gt 0 ]; then
			_CLEANUP_HOOK=""
			PRINT_ERR "Staged beyond the stopped paths, which a snapshot fold would drop: ${(j:, :)EXTRA}"
			ECHO_E "\e[0;31m  Unstage them in $(_LIT "$WT") – fold them separately – then 'git edit --continue'.\e[0m" >&2
			exit 1
		fi
		# Recorded for rerere too, which pre-fills the same hunks at a later stop
		git -C "$WT" -c rerere.enabled=true -c rerere.autoUpdate=false rerere >/dev/null 2>&1
		while IFS= read -r SLINE; do
			# From the end, as a name may hold a tab
			P=${SLINE%$'\t'*} BLOB=${SLINE##*$'\t'}
			ENTRY=$(git -C "$WT" ls-files -s -- ":(literal)$P" 2>/dev/null)
			if [ -n "$ENTRY" ]; then
				ENTRY=${${ENTRY%%$'\t'*}% *}
			else
				ENTRY=-
			fi
			print -r -- "$P"$'\t'"$BLOB"$'\t'"$ENTRY" >> "$GD/git-edit-snapshot-map"
		done < "$GD/git-edit-snapshot-pending"
		rm -f "$GD/git-edit-snapshot-pending"
	fi
	_SNAPSHOT_RUN
	PRINT_COMPLETED "$AMEND_NEW_HEAD" "$AMEND_REF" true
}

# Aborts a paused snapshot fold – the branch never moved and nothing was consumed, so removing
# the worktree, its map with it, leaves the fold to retry
_ABORT_SNAPSHOT () {
	PRINT_ACTION "Aborting the snapshot fold into %s..." "$STATE_TARGET"
	local LANDED=""
	_ABORT_TAKE_PAUSE "amend-into ${STATE_TARGET:0:7}"
	if _PAUSE_WT_HERE; then
		local CMD="git worktree remove --force ${(q-)STATE_WORKTREE} 2>/dev/null; rm -rf ${(q-)STATE_WORKTREE}"
		PRINT_CMD "$CMD" 90
		_LANDED_RUN eval "$CMD"
	fi
	if [ -n "$LANDED" ]; then
		PRINT_TEXT "The fold had landed already, before its run cleared the pause – nothing to take back." 33
	elif [ -n "$STATE_TREE" ]; then
		PRINT_TEXT "Branch was never touched – the tree is intact, ready to retry." 32
	else
		PRINT_TEXT "Branch was never touched – %s still in place, ready to retry." 32 "$(_FOLD_SOURCE)"
	fi
	_UNREGISTER_GONE_WORKTREE "$STATE_WORKTREE"
	PRINT_TEXT "%s" 32 "Snapshot fold aborted, state cleared."
	EMIT_STATUS "$STATE_ORIG_HEAD" "$STATE_BRANCH" false
}

# Commits that last touched the exact lines the staged diff rewrites, as a fix belongs to whoever
# wrote the line, not the newest commit to touch the file – pure additions carry none, and a
# failed blame prints the path and git's reason and returns 1, as no evidence is no guess
_BLAME_AMEND_TARGETS () {
	local TOPLEVEL=$(git rev-parse --show-toplevel)
	local P HUNK START COUNT OUT
	local -a LARGS FOUND
	for P in "$@"; do
		LARGS=()
		while IFS= read -r HUNK; do
			# "@@ -<start>[,<count>]" – an absent count means one line, 0 means
			# a pure insertion
			START=${${HUNK#@@ -}%%[, ]*}
			COUNT=$(print -r -- "$HUNK" | LC_ALL=C sed -nE 's/^@@ -[0-9]+,([0-9]+).*/\1/p')
			[ -z "$COUNT" ] && COUNT=1
			[ "$COUNT" = "0" ] && continue
			LARGS+=(-L "$START,+$COUNT")
		done < <(git -C "$TOPLEVEL" diff "${AMEND_SOURCE[@]}" -U0 --inter-hunk-context=0 --no-renames --no-color --no-ext-diff \
			--no-textconv -- ":(literal)$P" 2>/dev/null | LC_ALL=C grep -aE '^@@')
		[ ${#LARGS[@]} -eq 0 ] && continue
		# Every line to the commit that wrote it, whatever ignore-revs files skip – an empty
		# `--ignore-revs-file=` clears them, where an empty `-c` sorts first and clears nothing
		if ! OUT=$(git -C "$TOPLEVEL" blame --no-textconv --ignore-revs-file= "${LARGS[@]}" --porcelain HEAD -- "$P" 2>/dev/null); then
			# A missing one fails blame first, so this reads no user or system config – `HOME` too, for
			# a git before 2.32 – and trusts the repo as that config did
			if ! OUT=$(HOME=/nonexistent XDG_CONFIG_HOME=/nonexistent GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 \
					git -C "$TOPLEVEL" -c safe.directory="$TOPLEVEL" blame --no-textconv --ignore-revs-file= "${LARGS[@]}" --porcelain HEAD -- "$P" 2>&1); then
				print -r -- "$P – ${OUT%%$'\n'*}"
				return 1
			fi
		fi
		FOUND+=(${(f)"$(print -r -- "$OUT" | LC_ALL=C grep -aoE '^[0-9a-f]{40,64}')"})
	done
	(( ${#FOUND} )) && print -rl -- ${(u)FOUND}
	return 0
}

# Answers whether a merge here pairs renames – `merge.renames`, else `diff.renames`, read raw, as
# `--type=bool` refuses a `copies` in any config file, even one a later file overrides
_MERGE_DETECTS_RENAMES () {
	local K L V
	for K in merge.renames diff.renames; do
		# The last value, as git takes it – one with no value at all fails the merge, pairing nothing
		L=$(git config --get-regexp "^${K/./\\.}\$" 2>/dev/null | tail -1)
		[ -n "$L" ] || continue
		[ "$L" = "$K" ] && return 1
		V=${L#"$K "}
		[[ "${V:l}" == (copies|copy) ]] && return 0
		# Any other value is git's boolean, `0x0` and `00` included – one it can't read, the merge dies on
		V=$(git -c edit.renamesprobe="$V" config --type=bool --get edit.renamesprobe 2>/dev/null) || return 0
		[ "$V" = true ]
		return
	done
	return 0
}


# Resolves `--amend-into=auto` to the newest unpushed commit touching the staged paths –
# conservative, since every staged path with history must agree on one target and paths
# with none follow that consensus, and each refusal lists the per-path candidates
_RESOLVE_AMEND_TARGET () {
	local -a PATHS
	# What the fold takes, as its messages name it – a composed tree's content was never staged
	local STAGED=staged
	[ -n "$AMEND_TREE" ] && STAGED=folded
	# Scoped to the same pathspec the fold will use – inferring a target from paths that will
	# not be folded answers a question nobody asked
	PATHS=(${(0)"$(git diff -z "${AMEND_SOURCE[@]}" --name-only -- "${AMEND_PATHSPECS[@]}")"})
	if [ -z "${PATHS[1]}" ]; then
		if [ -n "$AMEND_TREE" ]; then
			PRINT_ERR "--tree $AMEND_TREE_GIVEN differs from HEAD in nothing – nothing to fold"
		else
			PRINT_ERR "No staged changes to amend"
			ECHO_E "\e[0;31m  Stage files with 'git add <files>' before running --amend-into.\e[0m" >&2
		fi
		exit 1
	fi

	# A submodule's pointer has no lines to blame, and the commit that last moved it need not be the
	# one it belongs with – a gitlink on either side of the change, read from the raw diff's modes
	local -a RAW GITLINKS
	local -i K
	RAW=("${(@0)$(git diff -z --raw --no-relative --no-renames "${AMEND_SOURCE[@]}" -- "${AMEND_PATHSPECS[@]}" 2>/dev/null)}")
	for (( K = 1; K < ${#RAW}; K += 2 )); do
		[[ "${RAW[K]}" == :160000\ * || "${RAW[K]}" == :[0-7][0-7][0-7][0-7][0-7][0-7]\ 160000\ * ]] && GITLINKS+=("${RAW[K+1]}")
	done
	if (( ${#GITLINKS} )); then
		PRINT_ERR "Cannot auto-target: auto can't attribute a submodule pointer ($(_SOME_PATHS -q "${GITLINKS[@]}")) – nothing was folded"
		ECHO_E "\e[0;31m  Name the commit it belongs with, --amend-into=<sha> in place of auto – $(_FOLD_SOURCE) untouched.\e[0m" >&2
		exit 1
	fi

	# Staged paths are root-relative, so anchor the per-path lookups at the repo root and they
	# resolve from a subdirectory too
	local TOPLEVEL=$(git rev-parse --show-toplevel)
	local P C

	# Line-level evidence wins where it exists – it is the difference between
	# folding into the commit that wrote the code and the commit that merely
	# touched the file last
	local -a BLAMED
	local BLAME_OUT
	if ! BLAME_OUT=$(_BLAME_AMEND_TARGETS "${PATHS[@]}"); then
		PRINT_ERR "Cannot auto-target: blame can't attribute the $STAGED lines – ${BLAME_OUT}"
		ECHO_E "\e[0;31m  Pass an explicit --amend-into=<sha>.\e[0m" >&2
		exit 1
	fi
	BLAMED=(${${(@f)BLAME_OUT}:#})
	if [ ${#BLAMED[@]} -gt 1 ]; then
		PRINT_ERR "Cannot auto-target: the $STAGED lines were last touched by different commits"
		for C in "${BLAMED[@]}"; do
			ECHO_E "\e[0;31m  ${C:0:7} ($(_LIT "$(git log -1 --format=%s "$C" 2>/dev/null)"))\e[0m" >&2
		done
		ECHO_E "\e[0;31m  Pass an explicit --amend-into=<sha>, or ${${AMEND_TREE:+fold}:-stage and fold} per target.\e[0m" >&2
		exit 1
	fi
	if [ ${#BLAMED[@]} -eq 1 ]; then
		C=${BLAMED[1]}
		if [ -n "$(_REMOTES_CONTAINING "$C")" ]; then
			PRINT_ERR "Cannot auto-target: the $STAGED lines were last touched by a pushed commit (${C:0:7})"
			ECHO_E "\e[0;31m  Its history lies beyond the rewrite horizon – pass an explicit --amend-into=<sha>, or commit separately.\e[0m" >&2
			exit 1
		fi
		ECHO_E "\e[0;90mauto-target: commit that last touched the $STAGED lines\e[0m"
		AMEND_INTO_TARGET=$C
		return
	fi
	# No old lines anywhere – pure additions or new files, nothing to attribute, so fall back
	# to the file-level guess below
	local -a CAND_LINES
	local CANDIDATE=""
	local MULTIPLE=false
	for P in "${PATHS[@]}"; do
		C=$(git -C "$TOPLEVEL" -c log.follow=false log -1 --format=%H HEAD -- ":(literal)$P" 2>/dev/null)
		if [ -z "$C" ]; then
			# New file – follows the consensus of the paths with history
			continue
		fi
		if [ -n "$(_REMOTES_CONTAINING "$C")" ]; then
			PRINT_ERR "Cannot auto-target: '$P' was last touched by a pushed commit (${C:0:7})"
			ECHO_E "\e[0;31m  Its history lies beyond the rewrite horizon – pass an explicit --amend-into=<sha>, or commit separately.\e[0m" >&2
			exit 1
		fi
		CAND_LINES+=("  $P -> ${C:0:7} ($(git log -1 --format=%s "$C"))")
		if [ -z "$CANDIDATE" ]; then
			CANDIDATE=$C
		elif [ "$C" != "$CANDIDATE" ]; then
			MULTIPLE=true
		fi
	done

	if [ -z "$CANDIDATE" ]; then
		PRINT_ERR "Cannot auto-target: no $STAGED path has unpushed history"
		ECHO_E "\e[0;31m  All $STAGED paths are new files – pass an explicit --amend-into=<sha>.\e[0m" >&2
		exit 1
	fi
	if [ "$MULTIPLE" = "true" ]; then
		PRINT_ERR "Cannot auto-target: $STAGED paths point at different commits"
		local LINE
		for LINE in "${CAND_LINES[@]}"; do
			ECHO_E "\e[0;31m${LINE//\\/$_LITB}\e[0m" >&2
		done
		ECHO_E "\e[0;31m  Pass an explicit --amend-into=<sha>, or ${${AMEND_TREE:+fold}:-stage and fold} per target.\e[0m" >&2
		exit 1
	fi

	ECHO_E "\e[0;90mauto-target: newest unpushed commit touching ${#PATHS[@]} $STAGED path(s)\e[0m"
	AMEND_INTO_TARGET=$CANDIDATE
}

# Prints the amended commit's stat after a completed `--amend-into`, so the caller needs no
# follow-up `git show` to see where the fold landed
_PRINT_AMENDED_SUMMARY () {
	# Args: <new_head> <depth> <folded files, as `_SOME_PATHS -q` prints them> [<main-checkout>]
	#       [<rebase-base>] [<orig-head>] [<staged-tree>] [<resolved-flag>]
	[ -n "$_IN_LANDED_STEP" ] || { _LANDED_STEP "$0" "$@"; return; }
	# The autosquash replays the target first, so the commit above the base is the amended one
	local AMENDED
	if [ -n "$5" ]; then
		if [ "$5" = "--root" ]; then
			AMENDED=$(git rev-list --reverse "$1" 2>/dev/null | head -1)
		else
			AMENDED=$(git rev-list --reverse "$5..$1" 2>/dev/null | head -1)
		fi
	fi
	[ -z "$AMENDED" ] && AMENDED=$(git rev-parse "$1~$2" 2>/dev/null)
	[ -z "$AMENDED" ] && return 0
	if [ -n "$3" ]; then
		PRINT_TEXT "Folded %s – the amended commit as a whole now:" 32 "$3"
	else
		PRINT_TEXT "%s" 32 "Amended commit"
	fi
	git show --no-color --stat --format='' "$AMENDED" | head -12 | _CARET_LINES | LC_ALL=C sed "/./!d;s/^/${_DIM}/;s/\$/${_OFF}/"
	if [ -n "$AMEND_TREE" ]; then
		# The fold's content never sat in the checkout's index, so its entries are stranded like
		# any other rewrite's – re-synced where they still hold the pre-op tip, named where not
		[ -n "$4" ] && [ -n "$6" ] && _RECONCILE_CHECKOUT "$4" "$6" "$1" "Your checkout still holds the pre-fold content of:" "Index re-synced, your checkout is current."
	else
		[ -n "$4" ] && [ -n "$6" ] && _SYNC_FOLDED "$4" "$6" "$1"
		_PRINT_LEFTOVER_STATE "$4"
	fi
	[ -n "$6" ] && _PRINT_MODE_CHANGES "$6" "$1"
	[ -n "$6" ] && _PRINT_TREE_IDENTITY "$6" "$1"
	# Same count check as a reorder's summary – a resolution reproducing its predecessor's
	# content leaves that commit empty and the rebase drops it, which a clean diffstat and an
	# `ok` trailer would otherwise wave through
	[ -n "$6" ] && _PRINT_DROPPED_COMMITS "$6" "$1"
	# The fold's correct tip is knowable up front, the pre-op tip plus the staged changes, so a
	# tip that differs means content beyond the fold moved – a staged hunk dissolved against a
	# later commit's content, or a conflict resolution deliberately diverged
	if [ -n "$7" ] && [ "$(git rev-parse "$1^{tree}" 2>/dev/null)" != "$7" ]; then
		if [ -n "$8" ]; then
			PRINT_TEXT "Note: tip tree differs from the staged result – a resolution changed content beyond the fold (compare: %s)" 33 "git diff ${7:0:12} ${1:0:12}"
		else
			PRINT_TEXT "Note: tip tree differs from the staged result – part of the fold dissolved against a later commit's content (compare: %s)" 33 "git diff ${7:0:12} ${1:0:12}"
		fi
	fi

	# Names the commit that received the fold below every block that grows with the operation,
	# as the drop list and the notes above both do, so a caller reading back through a
	# `tail -3` still finds this line – what the run leaves to do right above it
	_PRINT_TODO early
	_PRINT_COMMIT_LINE "$AMENDED" '  amended: %h %s'
	# Same reasoning – a fold that also reworded replaced a subject, which a symbolic target can
	# resolve to the wrong one entirely
	if [ -n "$AMEND_OLD_SHA" ]; then
		_PRINT_COMMIT_LINE "$AMEND_OLD_SHA" '  replaced: %s'
	fi
}

# Joins newline-separated paths onto one line, capping the tail so a large leftover set
# cannot swamp the summary – the exact list is one `git diff --cached --name-only` away
_JOIN_PATHS () {
	local -a NAMES=(${(f)1})
	local MORE=$(( ${#NAMES[@]} - 4 ))
	if [ "$MORE" -gt 0 ]; then
		print -r -- "${(j:, :)NAMES[1,4]}, +$MORE more"
	else
		print -r -- "${(j:, :)NAMES}"
	fi
}

# States what the fold left behind in the main checkout – a fold consumes the staged changes
# and nothing else, but the caller cannot see that from here, and "did my WIP survive?"
# was the most common probe, so read their checkout by path rather than this worktree's
_PRINT_LEFTOVER_STATE () {
	local D=$1
	[ -z "$D" ] || [ ! -d "$D" ] && return 0
	local STAGED_PATHS=$(git -C "$D" diff --cached --name-only 2>/dev/null)
	local STAGED=$(print -r -- "$STAGED_PATHS" | grep -c .)
	local UNSTAGED=$(git -C "$D" diff --name-only 2>/dev/null | grep -c .)
	local UNTRACKED=$(git -C "$D" ls-files --others --exclude-standard 2>/dev/null | grep -c .)
	local PARTS=""
	[ "$UNSTAGED" -gt 0 ]  && PARTS="$UNSTAGED modified"
	[ "$UNTRACKED" -gt 0 ] && PARTS="${PARTS:+$PARTS, }$UNTRACKED untracked"
	if [ "$STAGED" -gt 0 ] && [ ${#AMEND_PATHSPECS[@]} -gt 0 ]; then
		# A scoped fold is meant to leave the rest staged – name the paths, since a count cannot say
		# whether they are the caller's own leftovers or another session's, which only they clear
		PRINT_TEXT "Left staged (outside the pathspec): %s" 32 "$(_JOIN_PATHS "$STAGED_PATHS")"
	elif [ "$STAGED" -gt 0 ]; then
		# Nothing should survive an unscoped fold – the caller expects an empty index, so anything
		# left over is worth flagging to them
		PRINT_TEXT "Left staged, not folded: %s" 33 "$(_JOIN_PATHS "$STAGED_PATHS")"
	else
		PRINT_TEXT "Index now empty; working tree keeps %s." 32 "${PARTS:-no changes}"
	fi
}

# Guards both split paths – resolves a <sha> an earlier rewrite staled, then
# refuses what neither can express: the initial commit, a merge, or pushed history
# Leaves the resolved SHA in `_RESOLVED_SHA` for the caller to adopt
_SPLIT_GUARDS () {
	local X=$1
	_GUARD_REACHABLE "$X"
	X=$_RESOLVED_SHA
	if ! git rev-parse --verify "$X^" >/dev/null 2>&1; then
		PRINT_ERR "Cannot split the initial commit"
		exit 1
	fi
	if [[ "$(git log -1 --format='%P' "$X")" == *" "* ]]; then
		PRINT_ERR "Cannot split merge commit ${X:0:7}"
		exit 1
	fi
	_GUARD_UNPUSHED "$X"
}

# Answers whether git would alter a name or email handed to it as an ident – refusing an empty
# one, trimming what `ident.c` calls crud off its ends, dropping an angle bracket or newline
_IDENT_ALTERED () {
	# Args: <name> <email>
	[[ -z "$1" || -z "$2" || "$1$2" == *[$'<>\n']* ]] && return 0
	local CH
	for CH in "${1[1]}" "${1[-1]}" "${2[1]}" "${2[-1]}"; do
		# A `.` was crud too before git 2.42
		[[ "$CH" == [[:cntrl:][:space:].,:\;\"\\\'] ]] && return 0
	done
	return 1
}
# Stops a run whose rebuild failed partway – every mode lands only at its end, so nothing moved
_REBUILD_FAILED () {
	# Args: <commit it was rebuilding>
	PRINT_ERR "Could not rebuild ${1:0:7} – nothing was applied"
	exit 1
}


# Puts into `REPLY` a file holding <message> byte for byte, for `commit-tree -F` – a `$(…)` capture
# drops a message's trailing newlines and `-m` completes its last line, so a commit only re-parented
# takes its message through here – one file a run, called outside a `$(…)` so it is cleaned up
_MSG_FILE () {
	# Args: <message>
	if [ -z "$_MSG_PATH" ]; then
		_MSG_PATH=$(MKTEMP_FILE git-edit-msg) || return 1
		_TEMP_FILES+=("$_MSG_PATH")
	fi
	print -rn -- "$1" > "$_MSG_PATH" || return 1
	REPLY=$_MSG_PATH
}

# Puts into `REPLY` <commit>'s message with git's subject – its first paragraph, blank lines
# ahead of it too – replaced by <subject>, everything from the blank line closing it kept byte for
# byte, a missing last newline too – with no body, <subject> and a newline, as `--text` gives
_SUBJECT_REPLACED () {
	# Args: <commit> <subject>
	setopt local_options no_multibyte
	local MSG LINE EOL=$'\n' SEEN=false
	# NUL-ended, so `$()` leaves the message's own trailing newlines
	MSG=$(git log -1 --format='%B%x00' "$1") || return 1
	MSG=${MSG%$'\0'}
	while [ -n "$MSG" ]; do
		if [[ "$MSG" == *$'\n'* ]]; then
			LINE=${MSG%%$'\n'*}$'\n'
		else
			LINE=$MSG
		fi
		# Whitespace alone, a carriage return too, is a blank line to git
		if [ -z "${LINE//[[:space:]]/}" ]; then
			[ "$SEEN" = true ] && break
		else
			SEEN=true
			# The subject keeps the line ending its last line had, so a CRLF message stays one
			[[ "$LINE" == *$'\r\n' ]] && EOL=$'\r\n' || EOL=$'\n'
		fi
		MSG=${MSG:${#LINE}}
	done
	[ -n "$MSG" ] || EOL=$'\n'
	REPLY=$2$EOL$MSG
}

# Commits as `commit-tree` does, the author line carried byte for byte from <source> – handed an
# ident, git trims a name's quotes and refuses an empty one, both of which `rebase` keeps
_COMMIT_TREE_AS () {
	# Args: <source commit> <author name> <email> <raw date> <commit-tree arg>... – prints the commit
	local SRC=$1 AN=$2 AE=$3 AD=$4 NEW OBJ WANT="" HDR BODY
	shift 4
	# Only an ident git would alter is read back, or a `+0000` date, as `%ad` prints a `-0000` zone so
	# too – the common one commits as handed
	if ! _IDENT_ALTERED "$AN" "$AE"; then
		[[ "$AD" == *' +0000' ]] && WANT=$(git cat-file commit "$SRC" | LC_ALL=C sed -n '/^author /{p;q;}')
		if [[ "$WANT" != *' -0000' ]]; then
			GIT_AUTHOR_NAME=$AN GIT_AUTHOR_EMAIL=$AE GIT_AUTHOR_DATE="@$AD" git commit-tree "$@" </dev/null
			return
		fi
	fi
	local STAND_IN=false
	# An empty name commits under a stand-in, replaced below
	if ! NEW=$(GIT_AUTHOR_NAME="$AN" GIT_AUTHOR_EMAIL="$AE" GIT_AUTHOR_DATE="@$AD" git commit-tree "$@" </dev/null 2>/dev/null); then
		NEW=$(GIT_AUTHOR_NAME=git-edit GIT_AUTHOR_EMAIL="$AE" GIT_AUTHOR_DATE="@$AD" git commit-tree "$@" </dev/null) || return 1
		STAND_IN=true
	fi
	[ -z "$WANT" ] && WANT=$(git cat-file commit "$SRC" | LC_ALL=C sed -n '/^author /{p;q;}')
	OBJ=$(git cat-file commit "$NEW"; print -n x) || return 1
	OBJ=${OBJ%x}
	HDR=${OBJ%%$'\n\n'*}
	BODY=${OBJ#*$'\n\n'}
	local -a HDR_LINES=("${(@f)HDR}") HDR_OUT=()
	local L SIGNED=false
	for L in "${HDR_LINES[@]}"; do
		[[ "$L" == gpgsig* ]] && SIGNED=true
	done
	# A signature covers the line it would replace, so it stands – bar a stand-in's
	if [ -z "$WANT" ] || [ "${HDR_LINES[(r)author *]}" = "$WANT" ] || { [ "$SIGNED" = true ] && [ "$STAND_IN" = false ]; }; then
		print -r -- "$NEW"
		return 0
	fi
	local SKIP=false
	for L in "${HDR_LINES[@]}"; do
		# A signature header runs on through its space-led lines
		if [[ "$L" == gpgsig* ]]; then
			SKIP=true
			continue
		fi
		[ "$SKIP" = true ] && [[ "$L" == " "* ]] && continue
		SKIP=false
		[[ "$L" == "author "* ]] && L=$WANT
		HDR_OUT+=("$L")
	done
	print -rn -- "${(F)HDR_OUT}"$'\n\n'"$BODY" | git hash-object -t commit -w --stdin
}

# Turns an extracted tree into the two commits and applies them – the extracted commit rests
# on the target's parent, the remainder carries the target's own tree and message, and
# the target's tree ends the pair either way, so neither split path can conflict
_SPLIT_APPLY () {
	local X=$1
	local TREE1=$2
	local REF=$3
	local ORIG_HEAD=$4
	local MSG=$5

	# Both halves keep the original author + date, the remainder its message as its bytes stand
	local -a XA=("${(@0)$(git log -1 --format='%an%x00%ae%x00%ad%x00%B%x00' --date=raw "$X")}")
	local C1 C2
	C1=$(_COMMIT_TREE_AS "$X" "${XA[1]}" "${XA[2]}" "${XA[3]}" "$TREE1" -p "$X^" -m "$MSG") || _REBUILD_FAILED "$X"
	_MSG_FILE "${XA[4]}" || _REBUILD_FAILED "$X"
	C2=$(_COMMIT_TREE_AS "$X" "${XA[1]}" "${XA[2]}" "${XA[3]}" "$X^{tree}" -p "$C1" -F "$REPLY") || _REBUILD_FAILED "$X"
	PRINT_CMD "git commit-tree ... -> ${C1:0:7} + ${C2:0:7} # split ${X:0:7}"

	# The remainder carries the split commit's own message and full tree, so it
	# is where anything keyed to the original belongs – not the extracted half
	_RECORD_REWRITE "$X" "$C2"

	# Rebuild descendants on top of the remainder commit
	PREV_OLD=$X
	PREV_NEW=$C2
	# From the branch's own tip – a split resumed with the checkout on another branch walked that
	_REBUILD_DESCENDANTS "$X" "$ORIG_HEAD"

	# A split authors an intermediate tree no commit ever carried, so it earns the gate as much
	# as any replay, even with the tip tree unchanged by construction – always in a throwaway
	# worktree, since the gate's failure path checks out over whatever it was handed
	# A `--no-verify` split authors that tree too, and the guard below is skipped on exactly that
	# flag – so record the bypass ahead of it, where every other mode records it from the gate
	_VERIFY_NOTE_BYPASS
	if _VERIFY_CONFIGURED; then
		_REQUIRE_CURRENT "$REF" "$ORIG_HEAD"
		local VWT
		VWT=$(MKTEMP_DIR git-edit-verify) || exit 1
		_TEMP_WORKTREES+=("$VWT")
		if _WORKTREE_ADD "$VWT" "$PREV_NEW" quiet >/dev/null 2>&1; then
			_LINK_WORKTREE_EXTRAS "$VWT"
			local VERIFY_OK=true
			# The gate's own hints name a worktree removed two lines below and a resume re-deriving
			# the halves rather than applying this result, so the refusal below is the recourse
			_VERIFY_NO_RESUME=true
			_VERIFY_REWRITE "$VWT" "$PREV_NEW" "$ORIG_HEAD" "$C1" || VERIFY_OK=false
			_VERIFY_NO_RESUME=false
			git worktree remove --force "$VWT" >/dev/null 2>&1
			rm -rf "$VWT"
			_TEMP_WORKTREES=(${_TEMP_WORKTREES:#$VWT})
			if [ "$VERIFY_OK" != "true" ]; then
				# No pause – a split's halves re-derive from its own worktree, so a refusal leaves the
				# authoring in place for another `--continue`
				PRINT_ERR "Verification failed at ${_VERIFY_FAILED:0:7} – the split was not applied"
				[ -n "$STATE_WORKTREE" ] && PRINT_TEXT "Fix it in %s, then 'git edit --continue' – or 'git edit --abort'." 33 "$STATE_WORKTREE"
				exit 1
			fi
		else
			rm -rf "$VWT"
			_TEMP_WORKTREES=(${_TEMP_WORKTREES:#$VWT})
			# Fail closed – an unverifiable split landing under an `ok` trailer reads as gated when
			# in fact nothing ever ran at all
			PRINT_ERR "Could not open a worktree to verify the split – not applied"
			if [ -n "$STATE_WORKTREE" ]; then
				PRINT_TEXT "Retry with 'git edit --continue', or apply unverified: %s" 33 "git edit --no-verify --continue"
			else
				PRINT_TEXT "Retry, or apply unverified with %s" 33 "--no-verify"
			fi
			exit 1
		fi
	fi

	# The remainder keeps the commit's full tree and descendants keep theirs, so the tip tree is
	# identical by construction – checked, as a rebuild that walked another history breaks it
	if [ "$(git rev-parse "$PREV_NEW^{tree}")" != "$(git rev-parse "$ORIG_HEAD^{tree}")" ]; then
		PRINT_ERR "The split's tip would differ from ${ORIG_HEAD:0:7}'s – not applied"
		exit 1
	fi

	# Atomic CAS ref update
	local CMD="git update-ref -m ${(q-)${:-git edit: split ${X:0:7}$_REFLOG_TAG}} ${(q-)REF} ${(q-)PREV_NEW} ${(q-)ORIG_HEAD}"
	PRINT_CMD "$CMD"
	if ! _MOVE_REF "$CMD"; then
		PRINT_ERR "Ref '$REF' moved during split – refusing to overwrite"
		PRINT_TEXT "Split history is at %s (not applied)." 33 "$PREV_NEW"
		exit 1
	fi
	_RECORD_REF_MOVE "$REF" "$ORIG_HEAD" "$PREV_NEW" "split ${X:0:7}"

	# Stated, checked above, so callers don't re-verify with a diff
	PRINT_TEXT "%s – split into:" 32 "Tip tree identical ✓"
	git show --no-color --stat --format='  %h %s' "$C1" | head -8 | _CARET_LINES | LC_ALL=C sed "/./!d;s/^/${_DIM}/;s/\$/${_OFF}/"
	git show --no-color --stat --format='  %h %s' "$C2" | head -8 | _CARET_LINES | LC_ALL=C sed "/./!d;s/^/${_DIM}/;s/\$/${_OFF}/"
	# Each half's stat has to stay under its own subject to say which files went
	# where, so the pair can't move below the block the way a fold's name does –
	# one line naming the commit that was split carries that into the tail instead
	_PRINT_TODO early
	_PRINT_COMMIT_LINE "$X" "  split: %h %s -> ${C1:0:7} + ${C2:0:7}"

	SPLIT_NEW_HEAD=$PREV_NEW
	SPLIT_REF=$REF
}

# Fills `reply` with <pathspec>s, one holding pattern characters made literal where it names a
# path <where> holds – git matches it as a pattern as well, so `app/[id].tsx` takes `app/i.tsx`
# beside it – and a pattern the caller meant, or magic given outright, left as it is
# A leading `:` no magic signature follows makes such a name too – git reads `:a.txt` as `a.txt`
_LITERAL_FIRST () {
	# Args: <"index", "tree:<tree-ish>" or commit> <pathspec>... – each read as the fold or split
	# matches it, a path the index or tree removes from `HEAD` and one the commit deletes included
	local AT=$1 P
	shift
	reply=()
	for P in "$@"; do
		if { [[ "$P" == :* && "$P" != :[\(/\!^]* ]] || [[ "$P" != :* && "$P" == *[\*\?\[]* ]]; } && \
		   [ -n "$(case $AT in
				(index) git ls-files -- ":(literal)$P"; git diff-index --cached --name-only HEAD -- ":(literal)$P" ;;
				(tree:*) git rev-parse -q --verify "${AT#tree:}:./$P"; git diff-tree -r --name-only HEAD "${AT#tree:}" -- ":(literal)$P" ;;
				(*) git diff-tree -r --name-only --no-commit-id "$AT^" "$AT" -- ":(literal)$P" ;;
			esac 2>/dev/null | head -1)" ]; then
			reply+=(":(literal)$P")
		else
			reply+=("$P")
		fi
	done
}

# Tells whether a pathspec excludes – `:!`, `:^` or an `exclude` among its long magic words
_IS_EXCLUDE_SPEC () {
	# Args: <pathspec>
	[[ "$1" == :[\!^]* ]] && return 0
	[[ "$1" == ':('*')'* ]] && [[ ",${${1#:\(}%%\)*}," == *,exclude,* ]]
}

# Refuses <pathspec>s that match none of <commit>'s changes, or all of them – a split needs a
# nonempty, proper subset – filling `reply` with them as the split matches them, and the caller's
# `ALL_FILES` and `MATCHED` with the paths the commit changes and those they match
_SPLIT_MATCH () {
	# Args: <commit> <pathspec>...
	local X=$1
	shift
	_LITERAL_FIRST "$X" "$@"
	local -a PATHSPECS=("${reply[@]}")
	# NUL-separated, so a name holding a newline counts once
	ALL_FILES=(${(0)"$(git diff-tree -z -r --name-only --no-commit-id "$X^" "$X")"})
	MATCHED=(${(0)"$(git diff-tree -z -r --name-only --no-commit-id "$X^" "$X" -- "${PATHSPECS[@]}")"})
	if [ ${#MATCHED} -eq 0 ]; then
		PRINT_ERR "Pathspec matches no changes in ${X:0:7}"
		exit 1
	fi
	if [ ${#MATCHED[@]} -eq ${#ALL_FILES[@]} ]; then
		PRINT_ERR "Pathspec covers every change in ${X:0:7} – nothing to split off"
		if [ ${#ALL_FILES[@]} -eq 1 ]; then
			# One file means no pathspec can separate the halves – send them to
			# the form that authors the split point instead
			ECHO_E "\e[0;31m  It touches one file, so drop the pathspec and split by content:\e[0m" >&2
			ECHO_E "\e[0;31m    git edit --split=${X:0:7} --text \"First subject\"\e[0m" >&2
		else
			ECHO_E "\e[0;31m  Narrow the pathspec to the subset you want extracted.\e[0m" >&2
		fi
		exit 1
	fi
}

# Splits a commit by pathspec into two, plumbing only – an extracted commit carrying the
# matched changes with its message from `--text`, then one with the original message
# carrying the rest, trees composed directly so no conflict is possible
GIT_SPLIT () {
	# A SHA an earlier rewrite staled resolves first, as in every other mode
	_SPLIT_GUARDS "$SPLIT_TARGET"
	local X=$_RESOLVED_SHA
	local -a PATHSPECS ALL_FILES MATCHED
	_SPLIT_MATCH "$X" "$@"
	PATHSPECS=("${reply[@]}")

	# Capture the ref to update
	local ORIG_HEAD=$(git rev-parse HEAD)
	_REQUIRE_IN_TIP "$ORIG_HEAD" "$X"
	local BRANCH=${$(git symbolic-ref -q HEAD 2>/dev/null)#refs/heads/}
	local REF
	if [ -n "$BRANCH" ]; then
		REF="refs/heads/$BRANCH"
	else
		REF="HEAD"
	fi

	# Extracted tree: the parent's tree with the matched paths at the commit's
	# versions, composed in a temp index from `diff-tree`'s exact blobs (no
	# patch application, so binary files and mode changes come along natively)
	local TMPIDX=$(MKTEMP_FILE git-edit-split-idx)
	rm -f "$TMPIDX"
	GIT_INDEX_FILE=$TMPIDX git read-tree "$X^" || { rm -f "$TMPIDX"; exit 1; }
	local META PATHNAME F
	local -a RAW FIELDS CLASH
	local -i I PASS
	# NUL-separated, as the line form quotes a name holding a quote, backslash or control byte –
	# and that quoting became the name
	RAW=("${(@0)$(git diff-tree -z -r "$X^" "$X" -- "${PATHSPECS[@]}")}")
	# Removals first – a directory that became a file, `d/x` gone and `d` added, sorts the file first
	for PASS in 1 2; do
		for (( I = 1; I < ${#RAW[@]}; I += 2 )); do
			META=${RAW[I]} PATHNAME=${RAW[I+1]}
			[ -z "$META" ] && continue
			FIELDS=(${=META})
			if [ "${FIELDS[2]}" = "000000" ]; then
				(( PASS == 1 )) || continue
				GIT_INDEX_FILE=$TMPIDX git -C "$(git rev-parse --show-toplevel)" update-index --force-remove -- "$PATHNAME" || { rm -f "$TMPIDX"; exit 1; }
				continue
			fi
			(( PASS == 2 )) || continue
			GIT_INDEX_FILE=$TMPIDX git update-index --add --cacheinfo "${FIELDS[2]},${FIELDS[4]},$PATHNAME" 2>/dev/null && continue
			rm -f "$TMPIDX"
			# A file turned directory where the pathspec names one side only – the other is a change of
			# the same path the extracted commit cannot leave out
			for F in "${ALL_FILES[@]}"; do
				(( ${MATCHED[(Ie)$F]} )) && continue
				[[ "$PATHNAME" == "$F"/* || "$F" == "$PATHNAME"/* ]] && CLASH+=("$F")
			done
			if (( ${#CLASH} )); then
				# The file is the path the other side's entries sit under
				local SWAP="a file into a directory" SPEC
				local -a KEPT
				[[ "${CLASH[1]}" == "$PATHNAME"/* ]] && SWAP="a directory into a file"
				# An exclude would leave out the side the remedy names again
				for SPEC in "$@"; do _IS_EXCLUDE_SPEC "$SPEC" || KEPT+=("$SPEC"); done
				PRINT_ERR "${X:0:7} turns $SWAP at one path, and the pathspec takes $(_SHQ "$PATHNAME") but leaves out $(_JOIN_PATHS "${(F)CLASH}") – one commit can't hold the one without the other"
				SPEC=""
				(( ${#KEPT} < $# )) && SPEC=", without the exclude"
				ECHO_E "\e[0;31m  Name both sides$SPEC: git edit --split=${X:0:7} --text <msg> -- $(_LIT "${KEPT:+$(_SHQ "${KEPT[@]}") }$(_QUOTE_PATHS "${CLASH[@]}")")\e[0m" >&2
				ECHO_E "\e[0;31m  Or split it by content: git edit --split=${X:0:7}\e[0m" >&2
			else
				PRINT_ERR "Could not compose the extracted tree at $(_SHQ "$PATHNAME") – nothing was applied"
				ECHO_E "\e[0;31m  Split it by content instead: git edit --split=${X:0:7}\e[0m" >&2
			fi
			exit 1
		done
	done
	local TREE1=$(GIT_INDEX_FILE=$TMPIDX git write-tree)
	rm -f "$TMPIDX"
	[ -z "$TREE1" ] && { PRINT_ERR "Failed to compose the extracted tree"; exit 1; }

	_SPLIT_APPLY "$X" "$TREE1" "$REF" "$ORIG_HEAD" "$TEXT_VALUE"
}

# Splits a commit whose halves share a file, where no pathspec can name them apart – hands
# back an isolated worktree holding the commit's content for the caller to edit down to
# the first commit's, the one hunk-level split describable without `git add -p`
GIT_SPLIT_PAUSE () {
	_REQUIRE_NO_INFLIGHT

	local BRANCH=${$(git symbolic-ref -q HEAD 2>/dev/null)#refs/heads/}
	if [ -z "$BRANCH" ]; then
		PRINT_ERR "Splitting by content requires being on a branch (got detached HEAD)"
		exit 1
	fi

	_SPLIT_GUARDS "$SPLIT_TARGET"
	local X=$_RESOLVED_SHA

	local WT
	WT=$(MKTEMP_DIR git-edit-split) || exit 1
	rmdir "$WT"  # `git worktree add` wants to create the dir itself
	# Until the pause is recorded, as a parallel run's may take the slot first
	_CLEANUP_HOOK="git worktree remove --force ${(q-)WT} 2>/dev/null; rm -rf ${(q-)WT}"
	_WORKTREE_ADD "$WT" "$X" quiet >/dev/null || { PRINT_ERR "Cannot create split worktree at ${X:0:7}"; exit 1; }
	_LINK_WORKTREE_EXTRAS "$WT"

	_SAVE_STATE "operation=split" "worktree=$WT" "branch=refs/heads/$BRANCH" \
		"orig_head=$(git rev-parse HEAD)" "target=$X" "maindir=$(git rev-parse --show-toplevel)"
	_CLEANUP_HOOK=""
	# A message given up front survives the pause in the sidecar
	if [ -n "$TEXT_VALUE" ]; then
		print -r -- "$TEXT_VALUE" > "$(_TEXT_MSG_PATH)"
	fi

	PRINT_ACTION "Splitting %s..." "$X"
	PRINT_TEXT "Worktree at the commit's own content: %s" 33 "$WT"
	PRINT_TEXT "Edit it back to what the %s commit should leave behind – undo there whatever belongs in the second:" 33 "first"
	git show --no-color --stat --format='' "$X" | _CARET_LINES | LC_ALL=C sed "/./!d;s/^/${_DIM}  /;s/\$/${_OFF}/"
	if [ -n "$TEXT_VALUE" ]; then
		PRINT_TEXT "Then %s – or cancel via %s." 33 "git edit --continue" "git edit --abort"
	else
		PRINT_TEXT "Then %s – or cancel via %s." 33 'git edit --continue --text "First subject"' "git edit --abort"
	fi
	_PRINT_SPLIT_KEEPS "$X"
	EMIT_PAUSED split "$X" "$WT"
	_PAUSE_EXIT 2 edit
}

# Names what a content split's second commit keeps – the remainder inherits a subject written
# for the whole change, so it usually wants a reword the caller would otherwise only notice
# later, and `-M --text` replaces the body along with it, so a body is named here, while the
# caller still reads the pause as "--text is the first commit's subject"
_PRINT_SPLIT_KEEPS () {
	# Args: <target>
	local BODY_LINES=$(git log -1 --format='%b' "$1" 2>/dev/null | grep -c .)
	if [ "$BODY_LINES" -gt 0 ]; then
		PRINT_TEXT "The second commit keeps %s's message, its %s-line body included – reword it afterwards with %s, restating the body lines that still hold." 33 "${1:0:7}" "$BODY_LINES" "git edit -M"
	else
		PRINT_TEXT "The second commit keeps %s's message – reword it afterwards with %s." 33 "${1:0:7}" "git edit -M"
	fi
}

# Resumes a paused content split – snapshot the authored worktree as the extracted commit's
# tree, then apply the pair, running from the main checkout so the descendant rebuild
# reads the branch as it stands and carries a commit that landed during the pause
_CONTINUE_SPLIT () {
	if [ ! -d "$STATE_WORKTREE" ]; then
		PRINT_ERR "Worktree no longer exists: $STATE_WORKTREE"
		_CLEAR_STATE
		exit 1
	fi
	cd "${STATE_MAINDIR:-.}" || exit 1

	local X=$STATE_TARGET
	PRINT_ACTION "Continuing split of %s..." "$X"

	# The authored tree rests on the target's parent, so a rewrite of the target
	# mid-pause would silently re-seat it on content it was never derived from
	if ! git merge-base --is-ancestor "$X" "$STATE_BRANCH" 2>/dev/null; then
		PRINT_ERR "Commit ${X:0:7} left the branch during the pause – the authored tree no longer rests on its parent"
		ECHO_E "\e[0;31m  Run 'git edit --abort' and redo the split against the current history.\e[0m" >&2
		exit 1
	fi

	local MSG=$TEXT_VALUE
	local MSGFILE=$(_TEXT_MSG_PATH)
	if [ -z "$MSG" ] && [ -f "$MSGFILE" ]; then
		MSG=$(cat "$MSGFILE")
	fi
	if [ -z "$MSG" ]; then
		PRINT_ERR "Pass --text with 'git edit --continue' – the extracted commit needs a message"
		exit 1
	fi

	# Snapshot the authored working tree through a temp index seeded from the
	# target – the worktree's own index stays as the caller left it, so a
	# refused continue doesn't quietly stage their mistake for the next one
	# A copy of that index, merged with the target, keeps the stat of each entry the target holds, so
	# a file read as modified only through its attributes is not hashed anew, changed
	local TMPIDX=$(MKTEMP_FILE git-edit-split-idx)
	rm -f "$TMPIDX"
	_PRINT_UNTRACKED_ABSORB "$STATE_WORKTREE"
	local TREE1=""
	# Its mtime kept – a fresh one would read an entry edited in the index's own second as clean
	if { cp -p -- "$(git -C "$STATE_WORKTREE" rev-parse --path-format=absolute --git-path index 2>/dev/null)" "$TMPIDX" 2>/dev/null && \
	     GIT_INDEX_FILE=$TMPIDX git -C "$STATE_WORKTREE" read-tree -m "$X" 2>/dev/null; } || \
	   { rm -f "$TMPIDX"; GIT_INDEX_FILE=$TMPIDX git -C "$STATE_WORKTREE" read-tree "$X" 2>/dev/null; }; then
		GIT_INDEX_FILE=$TMPIDX git -C "$STATE_WORKTREE" add -A >/dev/null 2>&1
		TREE1=$(GIT_INDEX_FILE=$TMPIDX git -C "$STATE_WORKTREE" write-tree)
	fi
	rm -f "$TMPIDX"
	if [ -z "$TREE1" ]; then
		PRINT_ERR "Failed to read the authored tree from $STATE_WORKTREE"
		exit 1
	fi

	if [ "$TREE1" = "$(git rev-parse "$X^^{tree}")" ]; then
		PRINT_ERR "Worktree matches ${X:0:7}'s parent – the extracted commit would be empty"
		ECHO_E "\e[0;31m  Edit $(_LIT "$STATE_WORKTREE") to the state the first commit should leave, then retry.\e[0m" >&2
		exit 1
	fi
	if [ "$TREE1" = "$(git rev-parse "$X^{tree}")" ]; then
		PRINT_ERR "Worktree is unchanged from ${X:0:7} – the remainder commit would be empty"
		ECHO_E "\e[0;31m  Undo the parts belonging to the second commit in $(_LIT "$STATE_WORKTREE"), then retry.\e[0m" >&2
		exit 1
	fi

	# The pair always ends at the target's tree, so a path the target never
	# touched can only be reverted again by the remainder – stray worktree
	# debris rather than anything the caller means to commit
	local STRAY=$(comm -23 \
		<(git diff-tree -r --name-only "$X^^{tree}" "$TREE1" | sort) \
		<(git diff-tree -r --name-only "$X^^{tree}" "$X^{tree}" | sort))
	if [ -n "$STRAY" ]; then
		PRINT_ERR "Worktree changes paths ${X:0:7} never touched – the remainder would just revert them"
		print -r -- "$STRAY" | _CARET_LINES | LC_ALL=C sed "s/^/${_RED}  /;s/\$/${_OFF}/" >&2
		ECHO_E "\e[0;31m  Undo them in $(_LIT "$STATE_WORKTREE") (git checkout -- <path>, or rm for ones it added), then retry.\e[0m" >&2
		exit 1
	fi

	# So is a mode neither the target nor its parent carries – a file written anew into the
	# worktree comes back without its executable bit, and the remainder would flip it straight
	# back, a stray pair no diffstat shows – `--allow-mode-change` keeps it
	if [ ${#OPT_ALLOW_MODE_CHANGE} -eq 0 ]; then
		local -a MODE_STRAYS
		local MP M1 MB MX
		for MP in ${(0)"$(git diff-tree -r -z --name-only "$X^^{tree}" "$TREE1")"}; do
			[ -z "$MP" ] && continue
			M1=$(git ls-tree --full-tree "$TREE1" -- ":(literal)$MP" 2>/dev/null | cut -d' ' -f1)
			MB=$(git ls-tree --full-tree "$X^" -- ":(literal)$MP" 2>/dev/null | cut -d' ' -f1)
			MX=$(git ls-tree --full-tree "$X" -- ":(literal)$MP" 2>/dev/null | cut -d' ' -f1)
			if [ -n "$M1" ] && [ "$M1" != "$MB" ] && [ "$M1" != "$MX" ]; then
				MODE_STRAYS+=("$MP: authored $M1, ${X:0:7} carries ${MX:-none}, its parent ${MB:-none}")
			fi
		done
		if [ ${#MODE_STRAYS[@]} -gt 0 ]; then
			PRINT_ERR "Worktree changes a file mode neither ${X:0:7} nor its parent carries – a file written anew, without its executable bit?"
			printf '%s\n' "${MODE_STRAYS[@]}" | _CARET_LINES | LC_ALL=C sed "s/^/${_RED}  /;s/\$/${_OFF}/" >&2
			ECHO_E "\e[0;31m  chmod it in $(_LIT "$STATE_WORKTREE") to the mode a half should carry, then retry – or pass --allow-mode-change to keep it.\e[0m" >&2
			exit 1
		fi
	fi

	_CLEANUP_HOOK="git worktree remove --force ${(q-)STATE_WORKTREE} 2>/dev/null; rm -rf ${(q-)STATE_WORKTREE}"

	_SPLIT_APPLY "$X" "$TREE1" "$STATE_BRANCH" "$(git rev-parse "$STATE_BRANCH")" "$MSG"
	_CLEAR_STATE
	PRINT_COMPLETED "$SPLIT_NEW_HEAD" "$SPLIT_REF" true
}

_ABORT_SPLIT () {
	PRINT_ACTION "Aborting split of %s..." "${STATE_TARGET:0:7}"

	local LANDED=""
	_ABORT_TAKE_PAUSE "split ${STATE_TARGET:0:7}"
	if _PAUSE_WT_HERE; then
		local CMD="git worktree remove --force ${(q-)STATE_WORKTREE} 2>/dev/null; rm -rf ${(q-)STATE_WORKTREE}"
		PRINT_CMD "$CMD" 90
		_LANDED_RUN eval "$CMD"
	fi

	_UNREGISTER_GONE_WORKTREE "$STATE_WORKTREE"
	if [ -n "$LANDED" ]; then
		PRINT_TEXT "The split had landed already, before its run cleared the pause – nothing to take back." 33
	else
		PRINT_TEXT "Branch was never touched – nothing to roll back." 32
	fi
	PRINT_TEXT "%s" 32 "Split aborted, state cleared."
	EMIT_STATUS "$STATE_ORIG_HEAD" "$STATE_BRANCH" false
}

# Names the commits a reorder's gate checks – each it put directly below one that came before it
# in the old order, matched by author and subject, which a replay keeps – a commit that needed one
# moved up fails until it reappears, and every such run of failures holds one of these
_REORDER_CHECKS () {
	# Args: <orig_head> <new_head>
	local ORIG=$1 NEW=$2 LINE KEY
	local -a HASHES=() KEYS=() CHECKS=()
	for LINE in ${(f)"$(git log --reverse --format='%H%x1f%ae%x1f%at%x1f%s' "$ORIG..$NEW" 2>/dev/null)"}; do
		HASHES+=("${LINE%%$'\x1f'*}")
		KEYS+=("${LINE#*$'\x1f'}")
	done
	# Each original's place, oldest first – 0 where two share a key, which places neither
	local -A WAS=()
	local -i I=0
	for KEY in ${(f)"$(git log --reverse --format='%ae%x1f%at%x1f%s' "$NEW..$ORIG" 2>/dev/null)"}; do
		I+=1
		(( ${+WAS[$KEY]} )) && WAS[$KEY]=0 || WAS[$KEY]=$I
	done
	local -A NOW=()
	for KEY in "${KEYS[@]}"; do
		NOW[$KEY]=$(( ${NOW[$KEY]:-0} + 1 ))
	done
	local -a POS=()
	for KEY in "${KEYS[@]}"; do
		[ ${NOW[$KEY]} -eq 1 ] && POS+=(${WAS[$KEY]:-0}) || POS+=(0)
	done
	# One it cannot place counts as out of order, so it can only add a check
	for (( I = 1; I < ${#HASHES[@]}; I++ )); do
		(( POS[I] == 0 || POS[I+1] == 0 || POS[I] > POS[I+1] )) && CHECKS+=("${HASHES[$I]}")
	done
	print -r -- "${CHECKS[*]}"
}

# Writes the sequence editor a reorder or a placement runs, its path in `REPLY` – it re-emits the
# span's `pick` lines in the order `GIT_EDIT_REORDER_ORDER` names, todo SHAs matched as prefixes
# Under `sh`, as a zsh script would read the caller's `.zshenv` past the `emulate` at the top
_ORDER_EDITOR () {
	REPLY=$(MKTEMP_FILE git-edit-reorder-seq)
	_TEMP_FILES+=("$REPLY")
	cat > "$REPLY" <<'SEQEOF'
#!/bin/sh
awk -v order="$GIT_EDIT_REORDER_ORDER" '
	BEGIN { n = split(order, O, " ") }
	/^pick / {
		member = 0
		for (i = 1; i <= n; i++) {
			if (index(O[i], $2) == 1) { member = 1; break }
		}
		if (member) {
			if (!done) {
				for (i = 1; i <= n; i++) print "pick", O[i]
				done = 1
			}
			next
		}
	}
	{ print }
' "$1" > "$1.new" && mv "$1.new" "$1"
SEQEOF
	chmod +x "$REPLY"
}

# Reorders a contiguous span, the positional args giving the new order oldest-first – runs
# the rebase in an isolated temp worktree under a scripted `GIT_SEQUENCE_EDITOR`, reusing
# the conflict pause machinery, and the branch ref only moves at the end
GIT_REORDER () {
	# Pre-flight: must not be a stale in-flight operation
	_REQUIRE_NO_INFLIGHT

	# Pre-flight: must be on a branch
	local ORIG_BRANCH=${$(git symbolic-ref -q HEAD 2>/dev/null)#refs/heads/}
	if [ -z "$ORIG_BRANCH" ]; then
		PRINT_ERR "${${OPT_MOVE:+--move}:---reorder} requires being on a branch (got detached HEAD)"
		exit 1
	fi
	local REF="refs/heads/$ORIG_BRANCH"
	local ORIG_HEAD=$(git rev-parse HEAD)
	_REQUIRE_IN_TIP "$ORIG_HEAD" "${COMMITS[@]}"

	if [ ${#COMMITS_DESIRED[@]} -lt 2 ]; then
		PRINT_ERR "--reorder needs at least two commits (in the desired new order)"
		exit 1
	fi

	# All commits must be distinct
	local UNIQUE_COUNT=$(printf '%s\n' "${COMMITS[@]}" | sort -u | wc -l | tr -d ' ')
	if [ "$UNIQUE_COUNT" -ne ${#COMMITS[@]} ]; then
		PRINT_ERR "--reorder arguments must be distinct commits"
		exit 1
	fi

	# No-op if the desired order matches the current order
	local SAME=true
	local i
	for (( i=1; i<=${#COMMITS[@]}; i++ )); do
		[ "${COMMITS[$i]}" != "${COMMITS_DESIRED[$i]}" ] && SAME=false
	done
	if [ "$SAME" = "true" ]; then
		PRINT_TEXT "%s" 33 "Desired order matches the current order – nothing to do."
		EMIT_STATUS "$ORIG_HEAD" "$REF" false
		exit 0
	fi

	# Contiguity: the span oldest..newest must equal the selection exactly
	local OLDEST=${COMMITS[1]}
	local NEWEST=${COMMITS[-1]}
	if ! git merge-base --is-ancestor "$NEWEST" HEAD 2>/dev/null; then
		PRINT_ERR "Commit ${NEWEST:0:7} is not reachable from HEAD"
		exit 1
	fi
	local EXPECTED
	if git rev-parse --verify "$OLDEST^" >/dev/null 2>&1; then
		EXPECTED=($(git rev-list --reverse "$OLDEST^..$NEWEST"))
	else
		EXPECTED=($(git rev-list --reverse "$NEWEST"))
	fi
	if [ ${#EXPECTED[@]} -ne ${#COMMITS[@]} ]; then
		PRINT_ERR "--reorder requires a contiguous span of commits"
		ECHO_E "\e[0;31m  Selected ${#COMMITS[@]}; range ${OLDEST:0:7}..${NEWEST:0:7} contains ${#EXPECTED[@]}.\e[0m" >&2
		exit 1
	fi
	for (( i=1; i<=${#COMMITS[@]}; i++ )); do
		if [ "${COMMITS[$i]}" != "${EXPECTED[$i]}" ]; then
			PRINT_ERR "--reorder requires a contiguous span of commits"
			exit 1
		fi
	done

	# No merge commits in the span
	local C P_LIST
	for C in "${COMMITS[@]}"; do
		P_LIST=$(git log -1 --format='%P' "$C")
		if [[ "$P_LIST" == *" "* ]]; then
			PRINT_ERR "--reorder cannot handle merge commit ${C:0:7}"
			exit 1
		fi
	done

	_GUARD_UNPUSHED "$OLDEST"
	_GUARD_NO_MERGE_SPAN "$OLDEST"

	# Rebase base (parent of the oldest, or --root for the initial commit)
	local REBASE_BASE
	if git rev-parse --verify "$OLDEST^" >/dev/null 2>&1; then
		REBASE_BASE="$OLDEST^"
	else
		REBASE_BASE="--root"
	fi
	# Total todo length, for the completion summary's log span
	local TOTAL
	if [ "$REBASE_BASE" = "--root" ]; then
		TOTAL=$(git rev-list --count HEAD)
	else
		TOTAL=$(git rev-list --count "$REBASE_BASE..HEAD")
	fi

	# Isolated worktree at the current tip
	local WT
	WT=$(MKTEMP_DIR git-edit-reorder) || exit 1
	rmdir "$WT"
	_CLEANUP_HOOK="git worktree remove --force ${(q-)WT} 2>/dev/null; rm -rf ${(q-)WT}"
	_WORKTREE_ADD "$WT" "$ORIG_HEAD" quiet || exit 1
	_LINK_WORKTREE_EXTRAS "$WT"
	cd "$WT" || exit 1

	_ORDER_EDITOR
	local SEQ=$REPLY

	_CAPTURE_BEGIN
	local REBASE_CMD="GIT_EDIT_REORDER_ORDER='${COMMITS_DESIRED[*]}' GIT_SEQUENCE_EDITOR=${(q-)$(_SH_WORD "$SEQ")} GIT_EDITOR=true git -c commit.cleanup=verbatim -c rerere.enabled=true -c rerere.autoUpdate=false -c rebase.updateRefs=false -c advice.mergeConflict=false -c advice.resolveConflict=false -c rebase.instructionFormat= $_CAPTURE_PINS rebase $_CAPTURE_EXEC --no-autosquash --no-autostash --interactive $REBASE_BASE"
	PRINT_CMD "GIT_SEQUENCE_EDITOR=<reorder script> git rebase --interactive $REBASE_BASE" 90
	_RERERE_SCOPE_BEGIN
	_REBASE_FIRST_RUN "$REBASE_CMD"
	local RC=$?
	(( RC == 1 )) && _REFUSE_REBASE_FAILED "run the ${${OPT_MOVE:+move}:-reorder} again."
	if (( RC != 0 )) && \
	   ! { _AUTO_RESOLVE_FINAL_STEP "$WT" "$ORIG_HEAD" && _FINISH_AUTO_RESOLVED_STEP "$WT" "pre-op" }; then
		rm -f "$SEQ"
		# Conflict while replaying – persist state for --continue/--abort
		# The branch was never moved, so --abort has nothing to roll back
		_SAVE_STATE \
			"operation=reorder" \
			"worktree=$WT" \
			"branch=$REF" \
			"orig_head=$ORIG_HEAD" \
			"target=$OLDEST"
		_CLEANUP_HOOK=""

		PRINT_ERR "Conflict while reordering – resolve in worktree, then 'git edit --continue'"
		PRINT_TEXT "Worktree: %s" 33 "$WT"
		local UNMERGED_LIST=$(_PRINT_CONFLICT_DETAIL "$WT" "$ORIG_HEAD")
		PRINT_TEXT "Or abort the operation: %s" 33 "git edit --abort"
		EMIT_CONFLICT "$WT" "$UNMERGED_LIST"
		_PAUSE_EXIT 2 conflict
	fi
	rm -f "$SEQ"

	local NEW_HEAD=$(git rev-parse HEAD)

	# A reorder lands only the tree it began with, as a resumed one does – a clean replay can still
	# end elsewhere, a revert moved before what it takes back losing its effect
	if ! _SAME_TREE "$ORIG_HEAD" "$NEW_HEAD"; then
		local MODE=${${OPT_MOVE:+move}:-reorder}
		PRINT_ERR "The $MODE no longer ends on the tree it began with: moving the commits changes the content of $(_JOIN_PATHS "$(_TREE_CHANGES "$ORIG_HEAD" "$NEW_HEAD")"), as a revert moved before what it reverts does – nothing landed"
		ECHO_E "\e[0;31m  Keep each commit after the ones it changes back or builds on, or drop a revert together with what it reverts: git edit -d <sha> <revert-sha>\e[0m" >&2
		exit 1
	fi

	_VERIFY_CONFIGURED && _REQUIRE_CURRENT "$REF" "$ORIG_HEAD"
	if ! _GUARD_TIP_MODES "$WT" "$NEW_HEAD" "$ORIG_HEAD" || ! _VERIFY_REWRITE "$WT" "$NEW_HEAD" "$ORIG_HEAD" "$(_REORDER_CHECKS "$ORIG_HEAD" "$NEW_HEAD")"; then
		_SAVE_STATE \
			"operation=reorder" \
			"worktree=$WT" \
			"branch=$REF" \
			"orig_head=$ORIG_HEAD" \
			"target=$OLDEST"
		_CLEANUP_HOOK=""
		EMIT_GATE_PAUSED "$WT" "$NEW_HEAD"
		_PAUSE_EXIT 2 gate
	fi

	# Atomic CAS-update, guarded on the pre-op tip
	local UPDATE_CMD="git update-ref -m ${(q-)${:-git edit: reorder ${OLDEST:0:7}..${NEWEST:0:7}$_REFLOG_TAG}} ${(q-)REF} ${(q-)NEW_HEAD} ${(q-)ORIG_HEAD}"
	PRINT_CMD "$UPDATE_CMD" 90
	if ! _MOVE_REF "$UPDATE_CMD"; then
		PRINT_ERR "Branch '$REF' moved during reorder – refusing to overwrite"
		PRINT_TEXT "Reordered history is at %s (not applied)." 33 "$NEW_HEAD"
		exit 1
	fi
	_RECORD_REF_MOVE "$REF" "$ORIG_HEAD" "$NEW_HEAD" "reorder ${OLDEST:0:7}..${NEWEST:0:7}"

	# Completion summary – tree identity, proven above, plus the rewritten span in its new order
	_PRINT_REORDER_SUMMARY "$ORIG_HEAD" "$NEW_HEAD"

	REORDER_NEW_HEAD=$NEW_HEAD
	REORDER_REF=$REF
}

# Resumes an in-flight `--reorder` after resolution, mirroring `_CONTINUE_AMEND_INTO` –
# continue the rebase in the preserved worktree, then CAS the branch from its pre-op tip
# A reorder's final step resolves to the pre-op tip's blobs, a fold's to the fixup's
_AUTO_RESOLVE_FINAL_STEP () {
	# Args: <worktree> <result tree-ish – pre-op head (reorder) or staged tree (fold)>
	#       [<guard-empty – decline when the resolution would empty the commit>]
	local WT=$1
	local SOURCE=$2
	local GUARD_EMPTY=$3
	local -x GIT_LITERAL_PATHSPECS=1
	[ -z "$SOURCE" ] && return 1
	local GITDIR=$(git -C "$WT" rev-parse --absolute-git-dir 2>/dev/null)
	[ -z "$GITDIR" ] && return 1
	local -a STEPS=(${=$(_REBASE_STEP "$GITDIR")})
	if [ "${STEPS[1]:-0}" -eq 0 ] || [ "${STEPS[1]}" != "${STEPS[2]}" ]; then
		return 1
	fi
	# A result tree matching the stopped rebase's `HEAD` leaves the final commit empty and the
	# rebase drops it – for a reorder that change was absorbed by the new order, tree identity
	# proving no loss, while for a fold it would be overwritten outright, so decline first
	if [ -n "$GUARD_EMPTY" ] && \
	   [ "$(git rev-parse "$SOURCE^{tree}" 2>/dev/null)" = "$(git -C "$WT" rev-parse 'HEAD^{tree}' 2>/dev/null)" ]; then
		return 1
	fi
	local -a UNMERGED
	UNMERGED=(${(0)"$(git -C "$WT" diff -z --name-only --diff-filter=U 2>/dev/null)"})
	[ -z "${UNMERGED[1]}" ] && return 1
	# Prove the identity on a scratch copy of the index first – staging the
	# restores before knowing left a declined pause spoofing an empty step
	# (conflict cleared, source blobs staged) with the real markers destroyed
	local PROBE=$GITDIR/git-edit-probe-index
	cp "$GITDIR/index" "$PROBE" 2>/dev/null || return 1
	local P ENTRY
	local -a FIELDS
	for P in "${UNMERGED[@]}"; do
		ENTRY=$(git -C "$WT" ls-tree "$SOURCE" -- "$P" 2>/dev/null)
		FIELDS=(${=ENTRY})
		# Absent in the result (e.g. resolved by deletion) – not reproducible here
		if [ "${FIELDS[2]}" != "blob" ] || \
		   ! GIT_INDEX_FILE=$PROBE git -C "$WT" update-index --cacheinfo "${FIELDS[1]}" "${FIELDS[3]}" "$P" >/dev/null 2>&1; then
			rm -f "$PROBE"
			return 1
		fi
	done
	local CANDIDATE_TREE=$(GIT_INDEX_FILE=$PROBE git -C "$WT" write-tree 2>/dev/null)
	rm -f "$PROBE"
	if [ -z "$CANDIDATE_TREE" ] || [ "$CANDIDATE_TREE" != "$(git rev-parse "$SOURCE^{tree}" 2>/dev/null)" ]; then
		return 1
	fi
	# Proven – stage for real
	for P in "${UNMERGED[@]}"; do
		git -C "$WT" checkout "$SOURCE" -- "$P" >/dev/null 2>&1 || return 1
		git -C "$WT" add -- "$P" >/dev/null 2>&1 || return 1
	done
	# The proof: on the last step the staged tree is the result
	local RESULT_TREE=$(git -C "$WT" write-tree 2>/dev/null)
	[ -n "$RESULT_TREE" ] && [ "$RESULT_TREE" = "$(git rev-parse "$SOURCE^{tree}" 2>/dev/null)" ]
}

# Finishes a rebase whose final step `_AUTO_RESOLVE_FINAL_STEP()` just staged
_FINISH_AUTO_RESOLVED_STEP () {
	# Args: <worktree> <blob source name – "pre-op" or "staged">
	local WT=$1
	local OUTPUT RC # Needs to be separate for `$?` to work properly
	# C locale – the captured evidence should read in English, not the
	# machine's language (homebrew git localizes on an empty locale env)
	_RESUME_EDITOR "$WT"
	local CMD="GIT_SEQUENCE_EDITOR=true GIT_EDITOR=${(q)$(_SH_WORD "$REPLY")} git -C ${(q)WT} -c commit.cleanup=verbatim -c rerere.enabled=true -c rerere.autoUpdate=false -c rebase.updateRefs=false -c advice.mergeConflict=false -c advice.resolveConflict=false $_CAPTURE_PINS rebase --continue"
	# A step it resolved empty goes as the run's own call
	_NOTE_LET_GO "$WT"
	OUTPUT=$(_RENORM_EVAL "$WT" "$CMD" "$CMD")
	RC=$?
	if [ $RC -eq 0 ]; then
		PRINT_TEXT "%s – restored the %s blobs and continued." 32 "Final step auto-resolved (staged tree proven identical)" "$2"
	else
		# The success line waits for the continue – and a failure surfaces the
		# discarded evidence instead of masquerading as one more conflict
		PRINT_TEXT "%s – restored the %s blobs, yet its continue failed:" 31 "Final step auto-resolved (staged tree proven identical)" "$2"
		print -r -- "$OUTPUT" | _DROP_OWN_STEPS | tail -5 | _CARET_LINES --crlf | LC_ALL=C sed 's/^/  /' >&2
	fi
	return $RC
}

# Prints the completion summary for both reorder paths – tree identity, which each proves before it
# lands, the span in its new order, oldest first as `--reorder` takes it, and a count check that
# matters most after a hand-resolved conflict, as an emptied commit is silently dropped otherwise
_PRINT_REORDER_SUMMARY () {
	# Args: <orig-head> <new-head>
	[ -n "$_IN_LANDED_STEP" ] || { _LANDED_STEP "$0" "$@"; return; }
	local BASE=$(git merge-base "$1" "$2" 2>/dev/null)
	# A span from the root shares no base – then all of the new tip's history
	local AFTER=$(git rev-list --count ${BASE:+$BASE..}"$2" 2>/dev/null)
	PRINT_TEXT "%s – new order (oldest-first):" 32 "Tip tree identical ✓"
	git log --reverse --format='  %h %s' -"${AFTER:-12}" "$2" | head -12 | _CARET_LINES | LC_ALL=C sed "/./!d;s/^/${_DIM}/;s/\$/${_OFF}/"
	_PRINT_DROPPED_COMMITS "$1" "$2"
}

# Resolves where `$1`, a branch tip, left `$2`, the upstream – a rewritten upstream orphans
# the fork commit and plain `merge-base` then answers a far older ancestor, so
# `--fork-point` reads the reflog, falling back where a fresh clone leaves it nothing
_ONTO_FORK_POINT () {
	local BRANCH_TIP=$1
	local UPSTREAM=$2
	# Returns through `$_ONTO_FORK` / `$_ONTO_FORK_GUESSED` rather than stdout:
	# a command substitution would run this in a subshell, and the caller needs
	# to know whether the reflog answered, not just what the answer was
	_ONTO_FORK_GUESSED=false
	_ONTO_FORK=$(git merge-base --fork-point "$UPSTREAM" "$BRANCH_TIP" 2>/dev/null)
	if [ -z "$_ONTO_FORK" ]; then
		_ONTO_FORK=$(git merge-base "$UPSTREAM" "$BRANCH_TIP" 2>/dev/null)
		_ONTO_FORK_GUESSED=true
	fi
}

# Replays the current branch onto `$ONTO_UPSTREAM`, deriving the fork point rather than
# taking it as an argument – automates the rebase-onto-a-rewritten-main sequence: find the
# fork, report what each side carries, replay in an isolated worktree, CAS the branch
GIT_ONTO () {
	_REQUIRE_NO_INFLIGHT

	local ORIG_BRANCH=${$(git symbolic-ref -q HEAD 2>/dev/null)#refs/heads/}
	if [ -z "$ORIG_BRANCH" ]; then
		PRINT_ERR "--onto requires being on a branch (got detached HEAD)"
		exit 1
	fi
	local REF="refs/heads/$ORIG_BRANCH"
	local ORIG_HEAD=$(git rev-parse HEAD)
	# Captured before the cd into the temp worktree – the replant changes what
	# this checkout should hold, so it has to be brought along afterwards
	local MAIN_DIR=$(git rev-parse --show-toplevel)

	local UPSTREAM_FULL
	if ! UPSTREAM_FULL=$(_PEEL_SHA "$ONTO_UPSTREAM" commit); then
		PRINT_ERR "Unknown upstream: $ONTO_UPSTREAM"
		exit 1
	fi
	# Another name at the same commit is a branch already there
	if [ "$UPSTREAM_FULL" = "$ORIG_HEAD" ] && [[ "$(git rev-parse -q --verify --symbolic-full-name "$ONTO_UPSTREAM" 2>/dev/null)" == (HEAD|$REF) ]]; then
		PRINT_ERR "--onto target is the branch itself – name the branch to replant onto"
		exit 1
	elif [ "$UPSTREAM_FULL" = "$ORIG_HEAD" ]; then
		PRINT_TEXT "%s" 33 "Already at $ONTO_UPSTREAM – nothing to replay."
		EMIT_STATUS "$ORIG_HEAD" "$REF" false
		exit 0
	fi

	_ONTO_FORK_POINT "$ORIG_HEAD" "$ONTO_UPSTREAM"
	local FORK=$_ONTO_FORK
	if [ -z "$FORK" ]; then
		PRINT_ERR "No common ancestor between '$ORIG_BRANCH' and '$ONTO_UPSTREAM' – nothing to replay from"
		exit 1
	fi

	# Already replanted: the upstream tip is the fork, so there is nothing to move
	if [ "$(git rev-parse "$FORK")" = "$UPSTREAM_FULL" ]; then
		PRINT_TEXT "%s" 33 "Already on top of $ONTO_UPSTREAM – nothing to replay."
		EMIT_STATUS "$ORIG_HEAD" "$REF" false
		exit 0
	fi

	local -a SPAN
	SPAN=("${(@f)$(git rev-list --reverse "$FORK..$ORIG_HEAD" 2>/dev/null)}")
	# None of its own past the fork – it moves to the upstream by compare-and-swap, where a replay of
	# nothing would land it, a fast-forward unless the upstream rewrote what it holds, and its
	# checkout comes along as after any landing
	if [ -z "${SPAN[1]}" ]; then
		_GUARD_ONTO_CHECKOUT_CLEAN "$MAIN_DIR" "$FORK" "$UPSTREAM_FULL" "$REF"
		local HOW="fast-forwarded by $(git rev-list --count "$ORIG_HEAD..$UPSTREAM_FULL" 2>/dev/null) commit(s) to $ONTO_UPSTREAM (${UPSTREAM_FULL:0:7})"
		git merge-base --is-ancestor "$ORIG_HEAD" "$UPSTREAM_FULL" 2>/dev/null || \
			HOW="moved to $ONTO_UPSTREAM (${UPSTREAM_FULL:0:7}), which rewrote the commits it held"
		local UPDATE_CMD="git update-ref -m ${(q-)${:-git edit: onto ${UPSTREAM_FULL:0:7}$_REFLOG_TAG}} ${(q-)REF} ${(q-)UPSTREAM_FULL} ${(q-)ORIG_HEAD}"
		PRINT_CMD "$UPDATE_CMD" 90
		if ! _MOVE_REF "$UPDATE_CMD"; then
			PRINT_ERR "Branch '$REF' moved during replant – refusing to overwrite"
			exit 1
		fi
		_RECORD_REF_MOVE "$REF" "$ORIG_HEAD" "$UPSTREAM_FULL" "onto ${UPSTREAM_FULL:0:7}"
		PRINT_TEXT "%s" 32 "Branch '$ORIG_BRANCH' carries no commits past the fork – $HOW."
		_SYNC_ONTO_CHECKOUT "$MAIN_DIR" "$ORIG_HEAD" "$UPSTREAM_FULL" "$REF"
		ONTO_NEW_HEAD=$UPSTREAM_FULL ONTO_REF=$REF
		return 0
	fi

	# The replay rewrites every commit in the span, so the same guards the
	# other rewriting modes apply hold here – anchored on the oldest, which
	# covers the rest since no descendant of an unpushed commit is pushed
	_GUARD_UNPUSHED "${SPAN[1]}"
	_GUARD_NO_MERGE_SPAN "${SPAN[1]}"
	_GUARD_ONTO_CHECKOUT_CLEAN "$MAIN_DIR" "$FORK" "$UPSTREAM_FULL" "$REF"

	PRINT_ACTION "Replanting %s onto %s..." "$ORIG_BRANCH" "$ONTO_UPSTREAM"
	_PRINT_ONTO_FORK "$FORK" "$UPSTREAM_FULL"
	local GAINED=$(git rev-list --count "$FORK..$UPSTREAM_FULL" 2>/dev/null)
	PRINT_TEXT "%s gained %s commit(s); replaying %s from '%s' on top:" 32 \
		"$ONTO_UPSTREAM" "${GAINED:-0}" "${#SPAN[@]}" "$ORIG_BRANCH"
	_PRINT_ONTO_TRIAGE "$UPSTREAM_FULL" "$ORIG_HEAD" "$FORK"

	local WT
	WT=$(MKTEMP_DIR git-edit-onto) || exit 1
	rmdir "$WT"
	_CLEANUP_HOOK="git worktree remove --force ${(q-)WT} 2>/dev/null; rm -rf ${(q-)WT}"
	_WORKTREE_ADD "$WT" "$ORIG_HEAD" quiet || exit 1
	_LINK_WORKTREE_EXTRAS "$WT"
	cd "$WT" || exit 1

	# The upstream's name and the span size are only known here – without them the resumed run
	# reports the replant against a bare SHA and a count that trivially matches itself
	_ONTO_REPLAY "$WT" "$REF" "$ORIG_HEAD" "$UPSTREAM_FULL" "$FORK" "onto ${UPSTREAM_FULL:0:7}" \
		"operation=onto" "worktree=$WT" "branch=$REF" "orig_head=$ORIG_HEAD" "target=$UPSTREAM_FULL" \
		"upstream=$ONTO_UPSTREAM" "span=${#SPAN[@]}" "fork=$FORK" "maindir=$MAIN_DIR"
	_SYNC_ONTO_CHECKOUT "$MAIN_DIR" "$ORIG_HEAD" "$ONTO_NEW_HEAD" "$REF"

	_PRINT_ONTO_SUMMARY "$UPSTREAM_FULL" "$ONTO_NEW_HEAD" "${#SPAN[@]}"

	ONTO_REF=$REF
}

# Says where a replay's fork point came from – whether the old base still sits on what it replays
# onto decides how surprising the run is, an orphaned one meaning that was rewritten underneath
_PRINT_ONTO_FORK () {
	# Args: <fork> <commit replayed onto> – named by `ONTO_UPSTREAM`, `_ONTO_FORK_GUESSED` read
	if [ "$_ONTO_FORK_GUESSED" = "true" ]; then
		# The reflog is what makes the fork point exact – without it this is the last common
		# ancestor, which after a content-changing rewrite of the upstream sits well below the
		# real fork, so the span takes in commits the upstream has in a form patch ids miss
		PRINT_TEXT "%s could not answer from %s's reflog – using the merge base %s." 33 \
			"Fork point" "$ONTO_UPSTREAM" "$(git log -1 --format='%h %s' "$1")"
		PRINT_TEXT "If %s was rewritten, this span may be too wide – check the list below before continuing." 33 "$ONTO_UPSTREAM"
	elif git merge-base --is-ancestor "$1" "$2" 2>/dev/null; then
		PRINT_TEXT "Fork point %s is still on %s." 32 "$(git log -1 --format='%h %s' "$1")" "$ONTO_UPSTREAM"
	else
		PRINT_TEXT "Fork point %s was orphaned by a rewrite – recovered from the reflog." 33 \
			"$(git log -1 --format='%h %s' "$1")"
	fi
}

# Replays the span from <fork> up to the worktree's `HEAD` onto <base> there, gates the result and
# lands it on <branch ref> by compare-and-swap from <old tip> – a conflict or a failed gate pausing
# with <state>, which a replant and a land both resume – the landed tip into `ONTO_NEW_HEAD`
_ONTO_REPLAY () {
	# Args: <worktree> <branch ref> <old tip> <base> <fork> <journal label> <state key=value>...
	local WT=$1 REF=$2 OLD=$3 BASE=$4 FORK=$5 LABEL=$6
	shift 6
	_CAPTURE_BEGIN
	# Detached, so the branch ref stays put until the CAS – and the branch can
	# stay checked out in whatever worktree the caller is using
	local REBASE_CMD="GIT_SEQUENCE_EDITOR=true GIT_EDITOR=true git -c commit.cleanup=verbatim -c rerere.enabled=true -c rerere.autoUpdate=false -c rebase.updateRefs=false -c advice.mergeConflict=false -c advice.resolveConflict=false -c rebase.instructionFormat= $_CAPTURE_PINS rebase $_CAPTURE_EXEC --no-autosquash --no-autostash --empty=drop --onto $BASE $FORK"
	# What a land leaves out – the target's by a land's record, what it dropped –
	# dropped from the todo by full SHA, as a drop's are
	if [ -n "$LAND_FROM" ] && (( ${#_LAND_CAUGHT} + ${#_LAND_GONE} )); then
		local SED_SCRIPT="" C
		for C in "${_LAND_CAUGHT[@]}" "${_LAND_GONE[@]}"; do SED_SCRIPT+=" -e 's/^pick $C/drop $C/'"; done
		REBASE_CMD="GIT_SEQUENCE_EDITOR=${(q-)${:-LC_ALL=C sed -i.git-edit$SED_SCRIPT}} GIT_EDITOR=true git -c commit.cleanup=verbatim -c rerere.enabled=true -c rerere.autoUpdate=false -c rebase.updateRefs=false -c advice.mergeConflict=false -c advice.resolveConflict=false -c rebase.instructionFormat= -c core.abbrev=no $_CAPTURE_PINS rebase $_CAPTURE_EXEC --no-autosquash --no-autostash --empty=drop --interactive --onto $BASE $FORK"
	fi
	PRINT_CMD "$REBASE_CMD" 90
	_RERERE_SCOPE_BEGIN
	_RENORM_RESUME_CMD
	if ! REBASE_OUT=$(_RENORM_EVAL "$WT" "$REBASE_CMD" "$REPLY"); then
		# A hook's veto or a failed signature pauses nothing, and leaves a `-C` path no rebase halfway
		if ! _REBASE_RESOLVABLE "$WT" "$REBASE_OUT"; then
			git -C "$WT" rebase --abort >/dev/null 2>&1
			_REFUSE_REBASE_FAILED "run it again."
		fi
		_SAVE_STATE "$@"
		_CLEANUP_HOOK=""
		PRINT_ERR "Conflict while ${${LAND_FROM:+landing $LAND_FROM}:-replanting} – resolve in worktree, then 'git edit --continue'"
		PRINT_TEXT "Worktree: %s" 33 "$WT"
		local UNMERGED_LIST=$(_PRINT_CONFLICT_DETAIL "$WT")
		_PRINT_ONTO_SKIP_HINT "$WT" "$BASE"
		PRINT_TEXT "Or abort the operation: %s" 33 "git edit --abort"
		EMIT_CONFLICT "$WT" "$UNMERGED_LIST"
		_PAUSE_EXIT 2 conflict
	fi

	local NEW_HEAD=$(git rev-parse HEAD)
	# Every commit dropped as already there – nothing to gate, move or journal, so an undo never
	# finds a move from a tip to itself
	if [ "$NEW_HEAD" = "$OLD" ]; then
		PRINT_TEXT "%s – nothing moved." 33 "The replay came out at the tip it started from, every commit dropped as empty"
		ONTO_NEW_HEAD=$NEW_HEAD
		return 0
	fi

	_VERIFY_CONFIGURED && _REQUIRE_CURRENT "$REF" "$OLD"
	if ! _VERIFY_REWRITE "$WT" "$NEW_HEAD" "$OLD" "" "$BASE"; then
		_SAVE_STATE "$@"
		_CLEANUP_HOOK=""
		EMIT_VERIFY_PAUSED "$_VERIFY_FAILED" "$WT" "$NEW_HEAD"
		_PAUSE_EXIT 2 gate
	fi

	local UPDATE_CMD="git update-ref -m ${(q-)${:-git edit: $LABEL$_REFLOG_TAG}} ${(q-)REF} ${(q-)NEW_HEAD} ${(q-)OLD}"
	PRINT_CMD "$UPDATE_CMD" 90
	if ! _MOVE_REF "$UPDATE_CMD"; then
		[ -n "$LAND_FROM" ] && _REFUSE_LAND_MOVED "$REF" "$OLD"
		PRINT_ERR "Branch '$REF' moved during replant – refusing to overwrite"
		PRINT_TEXT "Replanted history is at %s (not applied)." 33 "$NEW_HEAD"
		exit 1
	fi
	_RECORD_REF_MOVE "$REF" "$OLD" "$NEW_HEAD" "$LABEL"
	ONTO_NEW_HEAD=$NEW_HEAD
}

# Prints the full ref a `--land` value names – `refs/heads/<name>` wherever that branch exists,
# whatever tag or remote-tracking ref shares the name, else the ref git resolves it to, nothing for
# a bare commit or a revision such as `feat~1` – so a first run and its resume read one name alike
_LAND_REF_OF () {
	# Args: <name as given>
	# `show-ref --verify` takes a ref name alone – `rev-parse` reads `refs/heads/feat~1` as a revision
	if git show-ref --verify -q "refs/heads/$1" 2>/dev/null; then
		print -r -- "refs/heads/$1"
	else
		git rev-parse -q --verify --symbolic-full-name --end-of-options "$1" 2>/dev/null
	fi
}

# Prints the command that deletes <branch> (`-d`, `-D`) or points it at <commit> (`-f`) – a name
# opening on a dash through `update-ref` by its full ref, which `git branch` would read as an option
_BRANCH_CMD () {
	# Args: <-d|-D|-f> <branch name> [<commit>]
	if [[ "$2" != -* ]]; then
		print -r -- "git branch $1 $(_SHQ "$2")${3:+ $3}"
	elif [ "$1" = -f ]; then
		print -r -- "git update-ref $(_SHQ "refs/heads/$2") $3"
	else
		print -r -- "git update-ref -d $(_SHQ "refs/heads/$2")"
	fi
}

# Names where a land of <branch> can run instead – by `-C` from each other checkout holding a
# branch, as one checked out there cannot be switched to here – or after a switch here
_PRINT_LAND_ELSEWHERE () {
	# Args: <branch as named>
	local HERE=$(git rev-parse --show-toplevel 2>/dev/null) OWN=$(_LAND_REF_OF "$1") LINE WT="" C
	local AGAIN="git edit --land=$(_SHQ "$1")"
	local -a CMDS
	for LINE in "${(@f)$(git worktree list --porcelain 2>/dev/null)}"; do
		case $LINE in
			("worktree "*) WT=${LINE#worktree } ;;
			("branch refs/heads/"*)
				[ "${WT:A}" != "${HERE:A}" ] && [ "${LINE#branch }" != "$OWN" ] && \
					CMDS+=("onto ${LINE#branch refs/heads/}: git -C $(_SHQ "$WT") edit --land=$(_SHQ "$1")") ;;
		esac
	done
	if (( ${#CMDS} )); then
		ECHO_E "\e[0;31m  Run it from the checkout of the branch to land into:\e[0m" >&2
		for C in "${(@)CMDS[1,3]}"; do
			ECHO_E "\e[0;31m    $(_LIT "$C")\e[0m" >&2
		done
		ECHO_E "\e[0;31m  Or switch to one checked out nowhere else (git switch <branch>), then: $(_LIT "$AGAIN")\e[0m" >&2
	else
		ECHO_E "\e[0;31m  Check out the branch to land into first (git switch <branch>), then: $(_LIT "$AGAIN")\e[0m" >&2
	fi
}

# Finds where a land's own commits start – those reachable from <branch tip> and from nothing
# <target ref> ever held, its tip or a value in its reflog, past what an `--undo` took back: each
# undone land's commits, its entry's old..new whatever it was named, and their copies a rewrite in
# its window made – and past the copies of the target's commits a land of <target's name> into
# <branch ref> brought, by that branch's reflog – the fork the first commit on the branch's
# first-parent line with none of them at or below it, the tip itself where none is its own, none
# where the line runs out, into `_LAND_FORK`, and into `_LAND_FORK_HOW` whether a land taken back
# was set aside – failing where the target has no reflog to read
# The own commits go into `_LAND_OWN`, the catch-up copies into `_LAND_CAUGHT`, and the own commits
# looking like copies of the target's into `_LAND_ALIKE`, as `_LAND_HELD_COPIES` finds them – those
# a kept land of another branch than <branch as named> copied over joining `_LAND_CAUGHT`
_LAND_HELD_FORK () {
	# Args: <target ref> <target tip> <branch tip> <branch's full ref, empty for a revision>
	#       <target's name> <branch as named>
	_LAND_FORK="" _LAND_FORK_HOW="" _LAND_OWN=() _LAND_CAUGHT=() _LAND_ALIKE=()
	local SUBJ C L K NAME LINE
	local -a LOG BLOG OPEN OWN KEEP HELD WHOLE WHELD CAUGHT LANDS
	local -A OPENS WIN SET LKEY LABEL MINE TKEY
	local -i I J
	LOG=(${(f)"$(git log -g --format='%H %gs' "$1" -- 2>/dev/null)"})
	(( ${#LOG} )) || return 1
	# Oldest first – an undo pairs with the newest land of its name still open, its window running from
	# that land's entry to the undo's, a land landed and taken back within another's going out with it
	for (( I = ${#LOG}; I >= 1; I-- )); do
		SUBJ=${LOG[I]#* }
		[[ "$SUBJ" == "${LOG[I]}" ]] && SUBJ=""
		case $SUBJ in
			("git edit: land "*) NAME=${${SUBJ#git edit: land }% \[*\]}; OPENS[$NAME]+=" $I" ;;
			("git edit: undo land "*)
				NAME=${${SUBJ#git edit: undo land }% \[*\]}
				OPEN=(${=OPENS[$NAME]})
				(( ${#OPEN} )) || continue
				J=${OPEN[-1]}
				LABEL[$J]=$NAME
				for (( ; J > I; J-- )); do WIN[$J]+=" ${LOG[OPEN[-1]]%% *}"; done
				OPEN[-1]=()
				OPENS[$NAME]=${OPEN[*]} ;;
		esac
	done
	# What each undone land brought, from the value before its entry, by SHA and by author – a fold or
	# reword below it in the window copies it under its author and date
	for J in "${(@k)LABEL}"; do
		L=${LOG[J+1]%% *}
		[[ "$L" == *[^0]* ]] || L=""
		for LINE in ${(f)"$(git log --format='%H %an%x1f%ae%x1f%at' "${LOG[J]%% *}" ${L:+"^$L"} -- 2>/dev/null)"}; do
			SET[${LINE%% *}]=$J LKEY[${LINE#* }]=1
		done
	done
	HELD=("^$2") WHOLE=("$2")
	for (( I = 1; I <= ${#LOG}; I++ )); do
		[[ "${LOG[I]%% *}" == *[^0]* ]] || continue
		if (( ! ${+WIN[$I]} )); then
			HELD+=("^${LOG[I]%% *}") WHOLE+=("${LOG[I]%% *}")
			continue
		fi
		# Held all the same inside a window – a peer's commit made and taken back there
		for LINE in ${(f)"$(git log --format='%H %an%x1f%ae%x1f%at' "${LOG[I]%% *}" ${(@)${=WIN[$I]}/#/^} "^$2" -- 2>/dev/null)"}; do
			(( ${+SET[${LINE%% *}]} || ${+LKEY[${LINE#* }]} )) || WHELD+=("${LINE%% *}")
		done
	done
	WHELD=("${(@u)WHELD}")
	OWN=(${(f)"$(print -rl -- "${HELD[@]}" | git rev-list --ignore-missing --stdin "$3" 2>/dev/null)"}) || return 1
	# The target's commits a land of it into the branch copied there, by that entry's old..new – each
	# of the target's commits past the value before it pairing with one at most, oldest first, by
	# author name, email and date, as a replay's copy keeps them, else by its whole message after
	# git's cleanup, as a resolution committed by hand at a stop keeps that – a commit made in that
	# land's pause, left unpaired, stays the branch's
	[ -n "$4" ] && BLOG=(${(f)"$(git log -g --format='%H %gs' "$4" -- 2>/dev/null)"})
	# The names the branch had, by its reflog's renames, newest first – a land under an earlier one
	# is one of its own
	local -A NAMES
	NAMES[$6]=1
	for LINE in "${BLOG[@]}"; do
		SUBJ=${LINE#* }
		[[ "$SUBJ" == "Branch: renamed refs/heads/"*" to refs/heads/"* ]] || continue
		SUBJ=${SUBJ#Branch: renamed refs/heads/}
		(( ${+NAMES[${SUBJ##* to refs/heads/}]} )) && NAMES[${SUBJ% to refs/heads/*}]=1
	done
	if [ -n "$4" ]; then
		local -a LEFTB TS
		local -A BKEY TPID
		for (( I = 1; I < ${#BLOG}; I++ )); do
			SUBJ=${BLOG[I]#* }
			[ "${${SUBJ#git edit: land }% \[*\]}" = "$5" ] && [[ "$SUBJ" == "git edit: land "* ]] || continue
			L=${BLOG[I+1]%% *}
			[[ "$L" == *[^0]* ]] || continue
			TKEY=() LEFTB=()
			for LINE in ${(f)"$(print -rl -- "$2" ${(M)${LOG%% *}:#*[^0]*} | git log --stdin --ignore-missing --format='%H %an%x1f%ae%x1f%at' "^$L" -- 2>/dev/null)"}; do
				TKEY[A${LINE#* }]+=" ${LINE%% *}"
			done
			for LINE in ${(f)"$(git log --reverse --format='%H %an%x1f%ae%x1f%at' "${BLOG[I]%% *}" "^$L" "^$2" -- 2>/dev/null)"}; do
				TS=(${=TKEY[A${LINE#* }]})
				if (( ${#TS} )); then
					CAUGHT+=("${LINE%% *}")
					TKEY[A${LINE#* }]=${(j: :)TS[2,-1]}
				else
					LEFTB+=("${LINE%% *}")
				fi
			done
			(( ${#LEFTB} )) || continue
			# By message those left on both sides – the `M` prefix keeps an empty one a valid key – but for
			# what the catch-up never picked: the target's copies of the branch's own commits it held by
			# then, by their author key and subject, or their patch, which it left out as there already
			TS=(${=${(j: :)${(v)TKEY}}})
			(( ${#TS} )) || continue
			BKEY=() TPID=()
			for LINE in ${(f)"$(print -rl -- "^$2" ${${(M)${LOG%% *}:#*[^0]*}/#/^} | git log --stdin --ignore-missing --format='%H %an%x1f%ae%x1f%at%x1e%s' "$L" -- 2>/dev/null)"}; do
				BKEY[A${LINE#* }]=1 BKEY[C${LINE%% *}]=1
			done
			for LINE in ${(f)"$(git log --no-walk=unsorted -p --no-color --no-textconv --no-ext-diff --format='commit %H' ${${(k)BKEY[(I)C*]}#C} "${TS[@]}" -- 2>/dev/null | git patch-id --stable 2>/dev/null)"}; do
				if (( ${+BKEY[C${LINE#* }]} )); then BKEY[P${LINE%% *}]=1; else TPID[${LINE#* }]=${LINE%% *}; fi
			done
			for C in ${(f)"$(git log --no-walk=unsorted --format='%H %an%x1f%ae%x1f%at%x1e%s' "${TS[@]}" -- 2>/dev/null)"}; do
				(( ${+BKEY[A${C#* }]} )) && continue
				[ -n "${TPID[${C%% *}]}" ] && (( ${+BKEY[P${TPID[${C%% *}]}]} )) && continue
				TKEY[M$(_CLEAN_MESSAGE "${C%% *}")]+=" ${C%% *}"
			done
			for C in "${LEFTB[@]}"; do
				K=M$(_CLEAN_MESSAGE "$C") TS=(${=TKEY[$K]})
				(( ${#TS} )) || continue
				CAUGHT+=("$C")
				TKEY[$K]=${(j: :)TS[2,-1]}
			done
		done
	fi
	for C in "${OWN[@]}"; do MINE[$C]=1; done
	for C in "${WHELD[@]}" "${CAUGHT[@]}"; do unset "MINE[$C]"; done
	CAUGHT=("${(@u)CAUGHT}")
	_LAND_CAUGHT=("${(@)CAUGHT:*OWN}")
	local -i N=$(( ${#OWN} + 1 ))
	KEEP=("${(@k)MINE}")
	OWN=("${(@)OWN:*KEEP}")
	_LAND_OWN=("${OWN[@]}")
	if (( ! ${#OWN} )); then
		_LAND_FORK=$3
		return 0
	fi
	# Named where it decided something – one of the branch's own commits an undone land brought
	for C in "${OWN[@]}"; do
		(( ${+SET[$C]} )) || continue
		_LAND_FORK_HOW="a land of ${LABEL[${SET[$C]}]} that --undo took back set aside"
		break
	done
	# Past a commit held only in such a window, or a catch-up copy, where own commits sit below it –
	# a peer's the branch caught up to – the span carrying it, for the replay to leave out by name
	for C in ${(f)"$(git rev-list --first-parent -n $N "$3" 2>/dev/null)"}; do
		(( ${+MINE[$C]} )) && continue
		if (( ${#WHELD} + ${#_LAND_CAUGHT} )); then
			KEEP=(${(f)"$(print -rl -- "${HELD[@]}" | git rev-list --ignore-missing --stdin "$C" 2>/dev/null)"})
			(( ${#${(@)KEEP:*OWN}} )) && continue
		fi
		_LAND_FORK=$C
		break
	done
	# The lands of other branches it kept, each as `<value> <value before> <branch>`, the commits one
	# brought – a revision's land, `feat~1` say, naming no branch to tell its originals by
	for (( I = 1; I < ${#LOG}; I++ )); do
		SUBJ=${LOG[I]#* }
		NAME=${${SUBJ#git edit: land }% \[*\]}
		[[ "$SUBJ" == "git edit: land "* ]] && (( ! ${+NAMES[$NAME]} && ! ${+LABEL[$I]} )) || continue
		git show-ref --verify -q "refs/heads/$NAME" 2>/dev/null || continue
		L=${LOG[I+1]%% *}
		[[ "$L" == *[^0]* ]] && LANDS+=("${LOG[I]%% *} $L $NAME")
	done
	# The lands of this one, undone ones too, each as `<value> <value before> <its time> <the time
	# before>` by the reflog's dates, `-` for one unread – what tells a resolution's copy
	local -a SELFS TL
	local T0 T1
	for (( I = 1; I < ${#LOG}; I++ )); do
		SUBJ=${LOG[I]#* }
		[[ "$SUBJ" == "git edit: land "* ]] && (( ${+NAMES[${${SUBJ#git edit: land }% \[*\]}]} )) || continue
		L=${LOG[I+1]%% *}
		[[ "$L" == *[^0]* ]] || continue
		(( ${#TL} )) || TL=(${(f)"$(git log -g --date=unix --format='%H %gd' "$1" -- 2>/dev/null)"} -)
		T0=${${TL[I]##*@\{}%\}} T1=${${TL[I+1]##*@\{}%\}}
		[ "${TL[I]%% *}" = "${LOG[I]%% *}" ] && [ "${TL[I+1]%% *}" = "$L" ] && [[ "$T0$T1" == <-> ]] || T0=- T1=-
		SELFS+=("${LOG[I]%% *} $L $T0 $T1")
	done
	[ -n "$_LAND_FORK" ] && _LAND_HELD_COPIES "$2" "$_LAND_FORK" "${WHOLE[@]}" -- "${WHELD[@]}" -- "${LANDS[@]}" -- "$4" "${SELFS[@]}"
	return 0
}

# Finds the branch's own commits, `_LAND_OWN`, that look like copies of a commit the target holds or
# held past <fork> – sharing author name, email and date with it, and its subject or its patch, as a
# replay, pick or rewrite leaves one – into `_LAND_ALIKE` as
# `<own> <lookalike as the target first took it> <lookalike on <target tip>|-> <kind> <how>`:
# • Kind `.` where the tip holds its change and message, `=` its change alone, a commit on the tip
#   composing what it changes past the lookalike – or past the version a land of <branch> took –
#   where the tip lacks that, `-` where that does not apply or the target dropped the lookalike, `?`
#   where a copy a land of <branch> brought differs by what that land's resolution may account for
# • How the tip holds a `.` or `=` one's change: `p` its copy there of its patch, `f` the copy as
#   the target first took it, changed there since, `t` in another form, `l` a copy a land of
#   <branch> brought while the branch held it as it is – the difference that land's resolution
# • The one on the tip is of its patch first, else any, else a copy the target made of a lookalike
#   since, by that one's subject or patch – a reword or fold of its own there
# • One whose change and message the tip holds in a copy a kept land of another branch holding it
#   brought, the target took that way, so it goes into `_LAND_CAUGHT` instead
_LAND_HELD_COPIES () {
	# Args: <target tip> <fork> <value held whole>... `--` <commit held in an undone land's window>...
	#       `--` <land of another branch, as `<value> <value before> <branch>`>... `--`
	#       <branch's full ref, empty for a revision> <land of it, as `<value> <value before>
	#       <its time> <the time before>`>...
	_LAND_ALIKE=()
	(( ${#_LAND_OWN} )) || return 0
	local TIP=$1 FORK=$2 LINE K L C T OLD ONE KIND HOW BREF="" J S
	local -a WHOLE WHELD LANDS LIKE SELFS BRL WV
	local -A KEY CAND AT PID SUBJ MSG TIPS BROUGHT SELFOF WIN VERS HELD FIRST
	local -i I IN
	shift 2
	while (( $# )) && [ "$1" != -- ]; do WHOLE+=("$1"); shift; done
	shift
	while (( $# )) && [ "$1" != -- ]; do WHELD+=("$1"); shift; done
	(( $# )) && shift
	while (( $# )) && [ "$1" != -- ]; do LANDS+=("$1"); shift; done
	(( $# )) && shift && BREF=$1 && shift
	SELFS=("$@")
	set -- "${WHELD[@]}"
	# `%at` beside the name, as two commits a second apart still differ – `%x1f`
	# between, which no name holds, and `%x1e` before the subject, which a reword may
	# change – each line `<sha> <committer date> <key>%x1e<subject>`
	local FMT='%H %ct %an%x1f%ae%x1f%at%x1e%s'
	for LINE in ${(f)"$(print -rl -- "${_LAND_OWN[@]}" | git log --no-walk=unsorted --stdin --format="$FMT" 2>/dev/null)"}; do
		L=${LINE%% *} K=${${LINE#* * }%%$'\x1e'*}
		KEY[$K]+=" $L" SUBJ[$L]=${LINE#*$'\x1e'}
	done
	# Past the fork, as no copy of a commit is older than the commit – the branch's own history
	# included, since one that merged the target back in reaches its copies too
	for LINE in ${(f)"$(git log --format="$FMT" "$TIP" "^$FORK" -- 2>/dev/null)"}; do
		L=${LINE%% *} K=${${LINE#* * }%%$'\x1e'*}
		(( ${+KEY[$K]} )) && CAND[$K]+=" $L" AT[$L]=${${LINE#* }%% *} SUBJ[$L]=${LINE#*$'\x1e'} TIPS[$L]=1
	done
	# What the target held and holds no more – by a value outside an undone
	# land's window, or a peer's commit inside one
	for LINE in ${(f)"$( { print -rl -- "${WHOLE[@]}" "^$TIP" "^$FORK" | git log --ignore-missing --stdin --format="$FMT" -- 2>/dev/null
		(( $# )) && print -rl -- "$@" | git log --no-walk=unsorted --stdin --format="$FMT" -- 2>/dev/null } )"}; do
		L=${LINE%% *} K=${${LINE#* * }%%$'\x1e'*}
		(( ${+KEY[$K]} && ! ${+AT[$L]} )) && CAND[$K]+=" $L" AT[$L]=${${LINE#* }%% *} SUBJ[$L]=${LINE#*$'\x1e'}
	done
	for K in "${(@k)KEY}"; do
		(( ${+CAND[$K]} )) || continue
		for C in ${=KEY[$K]}; do
			OLD="" ONE="" LIKE=()
			(( ${+PID[$C]} )) || PID[$C]=$(_PATCH_ID "$C")
			for L in ${=CAND[$K]}; do
				(( ${+PID[$L]} )) || PID[$L]=$(_PATCH_ID "$L")
				{ [ -n "${PID[$C]}" ] && [ "${PID[$C]}" = "${PID[$L]}" ]; } || [ "${SUBJ[$L]}" = "${SUBJ[$C]}" ] && LIKE+=("$L")
			done
			(( ${#LIKE} )) || continue
			# Weighed against the oldest, the commit as the target first took it – a rewrite of the target
			# since dates its copy anew – of two dated in one second the one an older value of it held,
			# then the one of its patch, so no clock tie turns the copy as taken into the rewrite
			for L in "${LIKE[@]}"; do
				if [ -z "$OLD" ] || (( ${AT[$L]} < ${AT[$OLD]} )); then
					OLD=$L
				elif (( ${AT[$L]} == ${AT[$OLD]} )); then
					for T in "$L" "$OLD"; do
						(( ${+FIRST[$T]} )) && continue
						for (( I = ${#WHOLE}; I > 1; I-- )); do git merge-base --is-ancestor "$T" "${WHOLE[I]}" 2>/dev/null && break; done
						FIRST[$T]=$I
					done
					(( ${FIRST[$L]} > ${FIRST[$OLD]} )) || \
						{ (( ${FIRST[$L]} == ${FIRST[$OLD]} )) && [ "${PID[$L]}" = "${PID[$C]}" ] && [ "${PID[$OLD]}" != "${PID[$C]}" ]; } && OLD=$L
				fi
			done
			for L in "${LIKE[@]}"; do (( ${+TIPS[$L]} )) && [ "${PID[$L]}" = "${PID[$C]}" ] && ONE=$L && break; done
			[ -n "$ONE" ] || for L in "${LIKE[@]}"; do (( ${+TIPS[$L]} )) && ONE=$L && break; done
			if [ -z "$ONE" ]; then
				for T in ${=CAND[$K]}; do
					(( ${+TIPS[$T]} )) || continue
					for L in "${LIKE[@]}"; do
						{ [ -n "${PID[$L]}" ] && [ "${PID[$L]}" = "${PID[$T]}" ]; } || [ "${SUBJ[$L]}" = "${SUBJ[$T]}" ] || continue
						ONE=$T
						break 2
					done
				done
			fi
			if [ -z "$ONE" ]; then
				_LAND_ALIKE+=("$C $OLD - - -")
				continue
			fi
			# Its change on the tip – the patch the tip's copy has, or the one the target first took, a
			# change of the target's own since – else composed past that one
			KIND=. HOW=p
			if [ -n "${PID[$C]}" ] && [ "${PID[$C]}" = "${PID[$ONE]}" ]; then
				:
			elif [ -n "${PID[$C]}" ] && [ "${PID[$C]}" = "${PID[$OLD]}" ]; then
				HOW=f
			else
				KIND=$(_LAND_CHANGE_ON_TIP "$C" "$OLD" "$TIP")
				case $? in
					(2) KIND=. HOW=t ;;
					(0) HOW=- ;;
					(*) KIND=- HOW=- ;;
				esac
			fi
			# Of another patch than a copy a land of the branch brought – landed where the branch held it
			# throughout the window that land started in, the difference that land's resolution, else
			# weighed as any where a version there has the copy's patch, else composed past the one
			# version there the land took, else `?`
			if [ "$HOW" = - ] && (( ${#SELFS} )); then
				if (( ! ${+SELFOF[-]} )); then
					SELFOF[-]=-
					for (( J = 1; J <= ${#SELFS}; J++ )); do
						for T in ${(f)"$(git rev-list "${${=SELFS[J]}[1]}" "^${${=SELFS[J]}[2]}" -- 2>/dev/null)"}; do SELFOF[$T]=$J; done
					done
				fi
				J=${SELFOF[$OLD]:-${SELFOF[$ONE]}} L=$OLD
				(( ${+SELFOF[$OLD]} )) || L=$ONE
				if [ -n "$J" ]; then
					[ -n "$BREF" ] && (( ! ${#BRL} )) && BRL=(${(f)"$(git log -g --date=unix --format='%H %gd' "$BREF" -- 2>/dev/null)"})
					(( ${+WIN[$J]} )) || _LAND_START_WINDOW "$J"
					WV=(${=WIN[$J]})
					if [ "${WIN[$J]}" != ff ]; then
						S=$KIND KIND=? IN=0
						# A version held then of the copy's patch the land took as it was, so the rest is a
						# change since – else landed where every value in the window holds it
						for T in ${=HELD[$J/$K]}; do
							(( ${+PID[$T]} )) || PID[$T]=$(_PATCH_ID "$T")
							[ -n "${PID[$T]}" ] && [ "${PID[$T]}" = "${PID[$L]}" ] && KIND=$S && break
						done
						if [ "$KIND" = "?" ] && [ "${WIN[$J]}" != - ]; then
							for T in "${WV[@]}"; do git merge-base --is-ancestor "$C" "$T" 2>/dev/null && IN+=1; done
							(( IN == ${#WV} )) && KIND=. HOW=l
						fi
						LIKE=(${=VERS[$J/$K]})
						# Else the one version there of the copy's message, as a replay keeps it
						if [ "$KIND" = "?" ] && (( ${#LIKE} > 1 )); then
							(( ${+MSG[c$L]} )) || MSG[c$L]=$(_CLEAN_MESSAGE "$L")
							for T in "${LIKE[@]}"; do
								(( ${+MSG[c$T]} )) || MSG[c$T]=$(_CLEAN_MESSAGE "$T")
								[ "${MSG[c$T]}" = "${MSG[c$L]}" ] || LIKE=("${(@)LIKE:#$T}")
							done
						fi
						if [ "$KIND" = "?" ] && (( ${#LIKE} == 1 )); then
							if [ "${LIKE[1]}" = "$C" ]; then
								KIND=. HOW=l
							else
								# Changed since the one version the land took – that change alone composed
								S=$(_LAND_CHANGE_ON_TIP "$C" "${LIKE[1]}" "$TIP")
								case $? in
									(0) KIND=$S ;;
									(2) KIND=. HOW=t ;;
								esac
							fi
						fi
					fi
				fi
			fi
			if [ "$KIND" = . ] && [ "$HOW" != l ]; then
				(( ${+MSG[$C]} )) || MSG[$C]=$(git log -1 --format=%B "$C" 2>/dev/null)
				(( ${+MSG[$ONE]} )) || MSG[$ONE]=$(git log -1 --format=%B "$ONE" 2>/dev/null)
				[ "${MSG[$ONE]}" = "${MSG[$C]}" ] || KIND==
			fi
			if [ "$KIND" = . ] && (( ${#LANDS} )); then
				if (( ! ${#BROUGHT} )); then
					for L in "${LANDS[@]}"; do
						for T in ${(f)"$(git rev-list "${${=L}[1]}" "^${${=L}[2]}" -- 2>/dev/null)"}; do BROUGHT[$T]=${${=L}[3]}; done
					done
					BROUGHT[-]=-
				fi
				if (( ${+BROUGHT[$ONE]} )) && git merge-base --is-ancestor "$C" "refs/heads/${BROUGHT[$ONE]}" 2>/dev/null; then
					_LAND_CAUGHT+=("$C")
					continue
				fi
			fi
			_LAND_ALIKE+=("$C $OLD $ONE $KIND $HOW")
		done
	done
	return 0
}

# Puts into `WIN[<land>]` the values the branch, `BREF`, held in the window the land `SELFS[<land>]`
# started in, by its reflog read into `BRL`, for `_LAND_HELD_COPIES` – `ff` where the target took
# commits the branch held by then, a fast-forward's, `-` where the branch's reflog does not reach
# back past that window – the versions there into `VERS[<land>/<author key>]`, and those it held
# from the target's move before on into `HELD[<land>/<author key>]`, where a version a copy repeats
# the patch of is the one taken
# The window ends at the land's earliest copy, as a replay stamps each as it picks, and starts there
# too where that first pick took no resolution – else at the target's move before, a stop's copy
# stamped only once it resumes – a value in its second counting as in it
_LAND_START_WINDOW () {
	# Args: <land's index in `SELFS`>
	local J=$1 NEW OLD E P LINE S T F K HI LO
	local -a BV WV
	local -i REACHED=0
	NEW=${${=SELFS[J]}[1]} OLD=${${=SELFS[J]}[2]} E=${${=SELFS[J]}[3]} P=${${=SELFS[J]}[4]}
	WIN[$J]=-
	[ -n "$BREF" ] && [ "$E" != - ] || return 0
	for LINE in "${BRL[@]}"; do
		T=${${LINE##*@\{}%\}}
		[[ "$T" == <-> ]] && (( T <= E )) && [[ "${LINE%% *}" == *[^0]* ]] && BV+=("${LINE%% *}")
	done
	if (( ${#BV} )) && [ -z "$(print -rl -- ${BV/#/^} | git rev-list --stdin -n 1 "$NEW" -- 2>/dev/null)" ]; then
		WIN[$J]=ff
		return 0
	fi
	HI=$(git log --format=%ct "$NEW" "^$OLD" -- 2>/dev/null | LC_ALL=C sort -n | head -1)
	F=$(git rev-list --first-parent --reverse "$NEW" "^$OLD" -- 2>/dev/null | head -1)
	[[ "$HI" == <-> ]] && [ -n "$F" ] || return 0
	# Newest first, those dated from the target's move before up to it, then the one in force then
	BV=() LO=$P
	for LINE in "${BRL[@]}"; do
		S=${LINE%% *} T=${${LINE##*@\{}%\}}
		[[ "$T" == <-> ]] && (( T <= HI )) || continue
		[[ "$S" == *[^0]* ]] || break
		BV+=("$S $T")
		[[ "$P" == <-> ]] && (( T < P )) && break
	done
	(( ${#BV} )) || return 0
	for LINE in ${(f)"$(print -rl -- ${BV%% *} "^$FORK" | git log --ignore-missing --stdin --format='%H %an%x1f%ae%x1f%at' -- 2>/dev/null)"}; do
		HELD[$J/${LINE#* }]+=" ${LINE%% *}"
	done
	# A first pick of a version's patch took no resolution, so it never stopped
	(( ${+PID[$F]} )) || PID[$F]=$(_PATCH_ID "$F")
	for S in ${=HELD[$J/$(git log -1 --format='%an%x1f%ae%x1f%at' "$F" -- 2>/dev/null)]}; do
		(( ${+PID[$S]} )) || PID[$S]=$(_PATCH_ID "$S")
		[ -n "${PID[$S]}" ] && [ "${PID[$S]}" = "${PID[$F]}" ] && LO=$HI && break
	done
	[[ "$LO" == <-> ]] || return 0
	for LINE in "${BV[@]}"; do
		T=${LINE#* }
		WV+=("${LINE%% *}")
		(( T < LO )) && REACHED=1 && break
	done
	(( REACHED )) || return 0
	WIN[$J]=${(j: :)WV}
	for LINE in ${(f)"$(print -rl -- "${WV[@]}" "^$FORK" | git log --ignore-missing --stdin --format='%H %an%x1f%ae%x1f%at' -- 2>/dev/null)"}; do
		VERS[$J/${LINE#* }]+=" ${LINE%% *}"
	done
	return 0
}

# Finds where <branch ref>'s own commits start where the target keeps no reflog – the newest value
# in the branch's own reflog the target's tip still holds, or the commit a rebase or replant there
# put it onto – into `_LAND_FORK`, the reflog line into `_LAND_FORK_HOW`
_LAND_FORK_POINT () {
	# Args: <branch ref> <branch tip> <target tip>
	_LAND_FORK="" _LAND_FORK_HOW=""
	local LINE SHA SUBJ CAND
	local -a EVENTS
	EVENTS=(${(f)"$(git log -g --format='%H %gs' "$1" -- 2>/dev/null)"})
	(( ${#EVENTS} )) || return 1
	for LINE in "${EVENTS[@]}"; do
		SHA=${LINE%% *} SUBJ=${LINE#* }
		[[ "$SUBJ" == "$LINE" ]] && SUBJ=""
		# Each entry's own value first, a catch-up by merge, pull, land or `update-ref` included
		for CAND in "$SHA" ${${(M)SUBJ:#*"(finish): "*" onto "*}##* onto } ${${${(M)SUBJ:#git edit: onto *}#git edit: onto }%% *}; do
			CAND=$(git rev-parse -q --verify "$CAND^{commit}" 2>/dev/null) || continue
			git merge-base --is-ancestor "$CAND" "$2" 2>/dev/null && git merge-base --is-ancestor "$CAND" "$3" 2>/dev/null || continue
			_LAND_FORK=$CAND _LAND_FORK_HOW=${SUBJ:-an entry with no message}
			return 0
		done
	done
	return 1
}

# Prints the commits past <merge base> on <branch tip> sharing author and subject with one
# <target tip> holds past it – copies a rewrite of the target left, so a span from that base
# reaches into the target's own history – where one of them, or a commit below the newest of them,
# the replay would not drop as already there by patch, none where it drops all up to the newest
_LAND_LOOKALIKES () {
	# Args: <merge base> <target tip> <branch tip>
	local K LINE
	local -a SPAN KEYS
	local -A TKEY SAME
	local -i I LAST=0 BAD=0
	SPAN=(${(f)"$(git rev-list --reverse --topo-order "$3" "^$1" 2>/dev/null)"})
	(( ${#SPAN} )) || return 0
	for K in "${(@f)$(git log --format='%an%x1f%ae%x1f%s' "$2" "^$1" 2>/dev/null)}"; do [ -n "$K" ] && TKEY[$K]=1; done
	(( ${#TKEY} )) || return 0
	KEYS=("${(@f)$(git log --no-walk=unsorted --format='%an%x1f%ae%x1f%s' "${SPAN[@]}" 2>/dev/null)}")
	(( ${#KEYS} == ${#SPAN} )) || return 0
	for (( I = 1; I <= ${#SPAN}; I++ )); do (( ${+TKEY[${KEYS[I]}]} )) && LAST=I; done
	(( LAST )) || return 0
	for LINE in ${(f)"$(git cherry "$2" "$3" "$1" 2>/dev/null)"}; do
		[[ "$LINE" == "- "* ]] && SAME[${LINE#- }]=1
	done
	for (( I = 1; I <= LAST; I++ )); do
		(( ${+TKEY[${KEYS[I]}]} && ${+SAME[${SPAN[I]}]} )) || BAD=1
	done
	(( BAD )) || return 0
	for (( I = 1; I <= LAST; I++ )); do
		(( ${+TKEY[${KEYS[I]}]} )) && print -r -- "${SPAN[I]}"
	done
	return 0
}

# Tells whether <branch ref> built the commit at its <tip> – a commit, pick, merge or rewrite of its
# own – rather than only being put there, created, reset or caught up, by the oldest entry in its
# reflog holding that commit, a tip no entry holds counting as built
_LAND_BUILT () {
	# Args: <branch ref> <tip>
	local LINE SUBJ="" ONTO
	local -i FOUND=0
	for LINE in ${(f)"$(git log -g --format='%H %gs' "$1" -- 2>/dev/null)"}; do
		[ "${LINE%% *}" = "$2" ] || continue
		FOUND=1 SUBJ=${LINE#* }
		[[ "$SUBJ" == "$LINE" ]] && SUBJ=""
	done
	(( FOUND )) || return 0
	case $SUBJ in
		(""|"branch: "*|"reset: "*|*": Fast-forward"|"git edit: land "*|"git edit: undo "*) return 1 ;;
		(*"(finish): "*" onto "*) ONTO=${SUBJ##* onto } ;;
		("git edit: onto "*) ONTO=${${SUBJ#git edit: onto }%% *} ;;
		(*) return 0 ;;
	esac
	# A rebase or replant replaying nothing left the branch on the commit it went onto
	[ "$(git rev-parse -q --verify "$ONTO^{commit}" 2>/dev/null)" != "$2" ]
}

# Says which fork a land runs from and how it was found – the target's reflog, `--base`, the
# branch's own reflog where the target keeps none, or the merge base where neither does – and, for
# one the target dropped, which commits below it the target holds in no form, as those stay out,
# their count into `REPLY` – none of `_LAND_HELD_FORM`, which it holds in some form
_PRINT_LAND_FORK () {
	# Args: <fork> <target tip> <target|reflog|base|guess> <branch as named> <target's name>
	local DESC=$(git log -1 --format='%h %s' "$1" 2>/dev/null) FROM WHY
	case $3 in
		(target) FROM="from $5's reflog${_LAND_FORK_HOW:+ ($_LAND_FORK_HOW)}" ;;
		(reflog) FROM="from $4's reflog ($_LAND_FORK_HOW), $5 keeping none" ;;
		(guess)  FROM="the merge base, as neither $5 nor $4 keeps a reflog to read" ;;
		(*)      FROM="as --base names it" ;;
	esac
	if git merge-base --is-ancestor "$1" "$2" 2>/dev/null; then
		PRINT_TEXT "Fork point %s, %s – still on %s." 32 "$DESC" "$FROM" "$5"
		REPLY=0
		return 0
	fi
	if [ "$3" = base ]; then
		PRINT_TEXT "Fork point %s, %s – not on %s, so the commits up to it stay out, as --base asks." 33 "$DESC" "$FROM" "$5"
		WHY="they stay out, as --base asks"
	else
		PRINT_TEXT "Fork point %s, %s – %s rewrote or dropped it since, so only what %s made past it lands." 33 "$DESC" "$FROM" "$5" "$4"
		WHY="they stay out"
	fi
	local -a GONE
	GONE=(${${(M)${(f)"$(git cherry "$2" "$1" 2>/dev/null)"}:#+ *}#+ })
	GONE=("${(@)GONE:|_LAND_HELD_FORM}")
	if (( ${#GONE} )); then
		PRINT_TEXT "%s commit(s) below it %s holds in no form now – %s:" 33 "${#GONE}" "$5" "$WHY"
		git log --no-walk=unsorted --format='  %h %s' "${(@)GONE[1,12]}" 2>/dev/null | _CARET_LINES | \
			LC_ALL=C sed "/./!d;s/^/${_DIM}/;s/\$/${_OFF}/"
	fi
	REPLY=${#GONE}
}

# Prints the oldest commit on <branch tip>'s first-parent line past <fork> holding every one of
# <commit>... and all past <fork> not the branch's own – a catch-up copy, one the target held – as
# `--base` replays all past it, so a fork there lands only own commits – the tip where none does
_LAND_FIRST_PAST () {
	# Args: <branch tip> <fork> <target tip> <commit>...
	local BTIP=$1 FORK=$2 TIP=$3 D C
	shift 3
	local -a INDEP
	local -A CNT
	for C in ${(f)"$(git rev-list "$BTIP" "^$FORK" "^$TIP" 2>/dev/null)"}; do
		(( ${_LAND_OWN[(Ie)$C]} && ! ${_LAND_CAUGHT[(Ie)$C]} )) || set -- "$@" "$C"
	done
	INDEP=(${(f)"$(git merge-base --independent "$@" 2>/dev/null)"})
	for D in "${INDEP[@]}"; do
		for C in "$D" ${(f)"$(git rev-list --ancestry-path "$D..$BTIP" 2>/dev/null)"}; do CNT[$C]=$(( ${CNT[$C]:-0} + 1 )); done
	done
	for C in ${(f)"$(git rev-list --first-parent --reverse "$BTIP" "^$FORK" "^$TIP" 2>/dev/null)"}; do
		(( ${CNT[$C]:-0} == ${#INDEP} )) || continue
		print -r -- "$C"
		return 0
	done
	print -r -- "$BTIP"
}

# Refuses a land that would bring back what the target dropped – <dropped> the commits it held and
# holds no more that the span carries inside a merge, which no replay leaves them out of – naming
# them, those the tip holds a lookalike of as rewritten since, the fork past them landing what
# follows, the branch's own commits that fork leaves out, and where it fast-forwards, the one
# landing them back all the same – never a merge, which would bring them back too
_REFUSE_LAND_DROPPED () {
	# Args: <fork> <target tip> <branch tip> <branch as named> <target's name> <how found> <dropped>...
	local FORK=$1 TIP=$2 BTIP=$3 NAME=$4 TARGET=$5 D C AT LINE K
	_PRINT_LAND_FORK "$FORK" "$TIP" "$6" "$NAME" "$TARGET"
	shift 6
	local AGAIN="git edit --land=$(_SHQ "$NAME")"
	local -a SHAS BELOW PAST
	local -A DROP TKEY RE
	for D in "$@"; do SHAS+=("$D"); DROP[$D]=1; done
	# Rewritten, not dropped, where the tip holds a commit of its author, date and subject or patch
	local FMT='%H %an%x1f%ae%x1f%at'
	for LINE in ${(f)"$(git log --format="$FMT" "$TIP" "^$FORK" -- 2>/dev/null)"}; do TKEY[${LINE#* }]+=" ${LINE%% *}"; done
	for LINE in ${(f)"$(git log --no-walk=unsorted --format="$FMT" "${(@)SHAS[1,12]}" 2>/dev/null)"}; do
		D=${LINE%% *} K=${LINE#* }
		for C in ${=TKEY[$K]}; do
			[ "$(git log -1 --format=%s "$C" 2>/dev/null)" = "$(git log -1 --format=%s "$D" 2>/dev/null)" ] || \
				[ "$(_PATCH_ID "$C")" = "$(_PATCH_ID "$D")" ] || continue
			RE[$D]=$C
			break
		done
	done
	local HOW=dropped
	(( ${#RE} )) && HOW="dropped or rewritten"
	PRINT_ERR "$NAME carries ${#SHAS} commit(s) $TARGET held and has $HOW since, inside a merge no replay can leave them out of – landing would bring them back, so nothing landed"
	for D in "${(@)SHAS[1,12]}"; do
		print -r -- "  $(git log -1 --format='%h %s' "$D" 2>/dev/null)${RE[$D]:+ – rewritten since, held as ${RE[$D]:0:7}}"
	done | _CARET_LINES | LC_ALL=C sed "/./!d;s/^/${_DIM}/;s/\$/${_OFF}/" >&2
	AT=$(_LAND_FIRST_PAST "$BTIP" "$FORK" "$TIP" "${SHAS[@]}")
	PAST=(${(f)"$(git rev-list "$BTIP" "^$AT" "^$TIP" 2>/dev/null)"})
	# Only a step that lands as printed – a merge past it would end in the merge refusal
	[ -n "$(git rev-list --merges -n 1 "$BTIP" "^$AT" "^$TIP" 2>/dev/null)" ] && PAST=()
	(( ${#PAST} )) && ECHO_E "\e[0;31m  Land what follows the last of them: $(_LIT "$AGAIN") --base=${AT:0:12}\e[0m" >&2
	# A merge commit it leaves out is no work of the branch's own to name
	for C in ${(f)"$(git rev-list --reverse --no-merges "$AT" "^$FORK" "^$TIP" 2>/dev/null)"}; do
		(( ${_LAND_OWN[(Ie)$C]} && ! ${+DROP[$C]} && ! ${_LAND_CAUGHT[(Ie)$C]} && ! ${_LAND_GONE[(Ie)$C]} )) && BELOW+=("$C")
	done
	if (( ${#BELOW} )); then
		ECHO_E "\e[0;31m  ${#BELOW} commit(s) of $(_LIT "$NAME")'s own sit at or below ${AT:0:7}${PAST:+, which that leaves out} – to land them, take the merge carrying the dropped ones out of $(_LIT "$NAME") first, then run it again: $(_LIT "$AGAIN")\e[0m" >&2
		git log --no-walk=unsorted --format='  %h %s' "${(@)BELOW[1,12]}" 2>/dev/null | _CARET_LINES | \
			LC_ALL=C sed "/./!d;s/^/${_DIM}/;s/\$/${_OFF}/" >&2
	fi
	# From the fork they land back only as a fast-forward – a replay of the span would meet the merge
	if git merge-base --is-ancestor "$FORK" "$TIP" 2>/dev/null && git merge-base --is-ancestor "$TIP" "$BTIP" 2>/dev/null; then
		ECHO_E "\e[0;31m  To land them back all the same: $(_LIT "$AGAIN") --base=${FORK:0:12}\e[0m" >&2
		PAST+=("$FORK")
	fi
	(( ${#PAST} )) && ECHO_E "\e[0;31m  With --dry-run first, each lists what it would land.\e[0m" >&2
	exit 1
}

# Prints a commit on <tip> carrying what <own> changed past <lookalike>, the commit as the target
# took it – <own>'s change put onto <lookalike>'s parent, as its own may differ, and the difference
# from <lookalike> then onto <tip>, each in a private index – failing (2) where that brings nothing,
# the change the same or on <tip> already, and (1) where a step does not apply, or for a root commit
_LAND_CHANGE_ON_TIP () {
	# Args: <own> <lookalike> <tip>
	local OP LP T1 T2 TOP=$(git rev-parse --show-toplevel 2>/dev/null) IDX PATCH
	OP=$(git rev-parse -q --verify "$1^" 2>/dev/null) && LP=$(git rev-parse -q --verify "$2^" 2>/dev/null) || return 1
	IDX=$(MKTEMP_FILE git-edit-land-idx) || return 1
	_TEMP_FILES+=("$IDX")
	rm -f "$IDX"
	# `git apply` byte for byte from the top, whatever the repo's whitespace config, as `--patch` does
	if [ "$OP" = "$LP" ]; then
		T1=$(git rev-parse -q --verify "$1^{tree}" 2>/dev/null) || return 1
	else
		PATCH=$(git diff-tree -p --binary "$OP" "$1" -- 2>/dev/null) && GIT_INDEX_FILE=$IDX git read-tree "$LP" 2>/dev/null || return 1
		if print -r -- "$PATCH" | GIT_INDEX_FILE=$IDX git -C "$TOP" -c apply.whitespace=nowarn -c apply.ignoreWhitespace=no \
			apply --cached - 2>/dev/null; then
			T1=$(GIT_INDEX_FILE=$IDX git write-tree 2>/dev/null) || return 1
		else
			# Its context changed below, the target's own commits there – one line of it matching, a
			# result that is the lookalike's tree brings nothing, any other is no ground to compose on
			GIT_INDEX_FILE=$IDX git read-tree "$LP" 2>/dev/null && print -r -- "$PATCH" | GIT_INDEX_FILE=$IDX git -C "$TOP" \
				-c apply.whitespace=nowarn -c apply.ignoreWhitespace=no apply --cached -C1 - 2>/dev/null && \
				[ "$(GIT_INDEX_FILE=$IDX git write-tree 2>/dev/null)" = "$(git rev-parse -q --verify "$2^{tree}" 2>/dev/null)" ] && return 2
			return 1
		fi
	fi
	[ "$T1" != "$(git rev-parse -q --verify "$2^{tree}" 2>/dev/null)" ] || return 2
	PATCH=$(git diff-tree -p --binary "$2" "$T1" -- 2>/dev/null) && GIT_INDEX_FILE=$IDX git read-tree "$3" 2>/dev/null || return 1
	# One that applies only backwards is on the tip already
	if print -r -- "$PATCH" | GIT_INDEX_FILE=$IDX git -C "$TOP" -c apply.whitespace=nowarn -c apply.ignoreWhitespace=no \
		apply --cached - 2>/dev/null; then
		T2=$(GIT_INDEX_FILE=$IDX git write-tree 2>/dev/null) || return 1
	elif print -r -- "$PATCH" | GIT_INDEX_FILE=$IDX git -C "$TOP" -c apply.whitespace=nowarn -c apply.ignoreWhitespace=no \
		apply --cached --check -R - 2>/dev/null; then
		return 2
	else
		return 1
	fi
	[ "$T2" != "$(git rev-parse -q --verify "$3^{tree}" 2>/dev/null)" ] || return 2
	git commit-tree "$T2" -p "$3" -m "git edit: what ${1:0:7} changed past ${2:0:7}, composed on ${3:0:7}" </dev/null 2>/dev/null
}

# Refuses a land carrying the branch's own commits that look like copies of the target's, <alike>
# from `_LAND_HELD_COPIES` – naming each and its lookalike, then every step that lands as printed:
# • For each whose change or message the tip lacks, the reword, fold or pick bringing it – of the
#   folds composed on the tip the first alone, each moving the tip the next would be composed on
# • Where the tip's copies carry every patch, the branch moved onto them – by its own checkout in a
#   linked worktree, or by `git branch -f` where nothing else of its own follows
# • The fork past them and past all else not the branch's own, landing its commits that follow
# • The fork landing them back, where the target dropped every lookalike and all past it is its own
# • The branch's own commits no step lands, and how – a copy of a dropped one taken off first
_REFUSE_LAND_COPIES () {
	# Args: <fork> <target tip> <branch tip> <branch as named> <branch's full ref, empty for a
	#       revision> <target's name> <alike>...
	local FORK=$1 TIP=$2 BTIP=$3 NAME=$4 FULL=$5 TARGET=$6 E B L ON K H CO="" AT MOVE="" OR="" MSG SUBJECT DROPS=""
	shift 6
	local AGAIN="git edit --land=$(_SHQ "$NAME")"
	local -a OWNS REST PAST MERGES BELOW FOLDS STEPS GONE UNSURE LEFT
	local -A ONOF
	local -i ALL_ON=1 ALL_DROPPED=1 MSGS=0 BASES=0 CAP=6
	for E in "$@"; do
		B=${${=E}[1]} ON=${${=E}[3]} K=${${=E}[4]} H=${${=E}[5]}
		OWNS+=("$B") ONOF[$B]=$ON
		[ "$ON" = - ] || ALL_DROPPED=0
		[[ "$K" == [.=] ]] && [ "$H" = p ] || ALL_ON=0
		[ "$K" = = ] && MSGS=1
		case $K in
			(.) ;;
			(\?) UNSURE+=("$E") ;;
			(-) [ "$ON" = - ] && GONE+=("$B") || STEPS+=("$E") ;;
			(=) STEPS+=("$E") ;;
			(*) FOLDS+=("$E") ;;
		esac
	done
	PRINT_ERR "$NAME holds $# commit(s) that look like copies of commits $TARGET holds or held – same author and date, and the same subject or patch – so nothing landed"
	for E in "${(@)@[1,12]}"; do
		B=${${=E}[1]} L=${${=E}[2]} ON=${${=E}[3]} K=${${=E}[4]} H=${${=E}[5]}
		print -rn -- "  $(git log -1 --format='%h %s' "$B" 2>/dev/null) – "
		case $K$H in
			(.p) print -r -- "on $TARGET as ${ON:0:7}, change and message alike" ;;
			(.f) print -r -- "on $TARGET as ${ON:0:7}, its change as $TARGET first took it, changed there since" ;;
			(.t) print -r -- "on $TARGET as ${ON:0:7}, its change there already" ;;
			(.l) print -r -- "on $TARGET as ${ON:0:7}, as a land of $NAME took it – the difference that land's resolution" ;;
			(\=p) print -r -- "on $TARGET as ${ON:0:7}, its change alike, another message" ;;
			(\=f) print -r -- "on $TARGET as ${ON:0:7}, its change as $TARGET first took it, changed there since, another message" ;;
			(\=t) print -r -- "on $TARGET as ${ON:0:7}, its change there already, another message" ;;
			(\?*) print -r -- "like ${L:0:7} a land of $NAME brought${${ON:#$L}:+, which $TARGET holds as ${ON:0:7}}, another patch – that land's resolution, maybe" ;;
			(*) if [ "$ON" = - ]; then
					print -r -- "like ${L:0:7} $TARGET took, which $TARGET dropped since"
				else
					print -r -- "like ${L:0:7} $TARGET took${${ON:#$L}:+, which it holds as ${ON:0:7}}, another patch"
				fi ;;
		esac
	done | _CARET_LINES | LC_ALL=C sed "/./!d;s/^/${_DIM}/;s/\$/${_OFF}/" >&2
	# A fold composed on the tip first, as any other step moves the tip it was composed on – a step
	# for each of the others, past which the land again prints the next fold
	if (( ${#FOLDS} )); then
		B=${${=FOLDS[1]}[1]} ON=${${=FOLDS[1]}[3]} K=${${=FOLDS[1]}[4]}
		ECHO_E "\e[0;31m  Where ${B:0:7}'s change is meant for $(_LIT "$TARGET"), it alone, composed on the tip, is ${K:0:12} (git show ${K:0:12}) – fold it into ${ON:0:7}: $(_LIT "git edit --amend-into=${ON:0:12} --tree=${K:0:12}")\e[0m" >&2
		(( ${#FOLDS} > 1 )) && ECHO_E "\e[0;31m  The land run again names the next fold, for $(( ${#FOLDS} - 1 )) more holding a change of their own – each composed on the tip the one before leaves\e[0m" >&2
	fi
	for E in "${(@)STEPS[1,CAP]:#}"; do
		B=${${=E}[1]} L=${${=E}[2]} ON=${${=E}[3]} K=${${=E}[4]}
		if [ "$K" = = ]; then
			# The subject alone where that gives the branch's message byte for byte, else the message whole,
			# read from the commit, as no quoting keeps every message intact on a printed line
			SUBJECT=$(git log -1 --format=%s "$B" 2>/dev/null)
			MSG=$(git log -1 --format='%B%x00' "$B" 2>/dev/null)
			if _SUBJECT_REPLACED "$ON" "$SUBJECT" && [ "$REPLY" = "${MSG%$'\0'}" ]; then
				ECHO_E "\e[0;31m  Where ${B:0:7}'s is the message meant, give ${ON:0:7} on $(_LIT "$TARGET") its new subject: $(_LIT "git edit -M --subject=$(_SHQ "$SUBJECT") ${ON:0:12}")\e[0m" >&2
			else
				ECHO_E "\e[0;31m  Where ${B:0:7}'s is the message meant, give ${ON:0:7} on $(_LIT "$TARGET") its new message: $(_LIT "git edit -M --text=\"\$(git log -1 --format=%B ${B:0:12})\" ${ON:0:12}")\e[0m" >&2
			fi
		else
			ECHO_E "\e[0;31m  What ${B:0:7} changes past ${L:0:7} does not apply to $(_LIT "$TARGET")'s tip as it stands – see it with $(_LIT "git range-diff ${L:0:12}^! ${B:0:12}^!"); where it is meant for $(_LIT "$TARGET"), make it there, stage it and fold it into ${ON:0:7}: $(_LIT "git edit --amend-into=${ON:0:12} -- <paths>")\e[0m" >&2
		fi
	done
	(( ${#STEPS} > CAP )) && ECHO_E "\e[0;31m  $(( ${#STEPS} - CAP )) more need a reword or fold likewise – the land run again names them\e[0m" >&2
	for B in "${GONE[@]}"; do DROPS+=" ${B:0:12}"; done
	if (( ${#GONE} == 1 )); then
		ECHO_E "\e[0;31m  To land ${GONE[1]:0:7} back, its change included, as a commit of its own: $(_LIT "git edit --exec -- git cherry-pick$DROPS")\e[0m" >&2
	elif (( ${#GONE} )); then
		ECHO_E "\e[0;31m  To land the ${#GONE} copies of what $(_LIT "$TARGET") dropped back, their changes included, as commits of their own: $(_LIT "git edit --exec -- git cherry-pick$DROPS")\e[0m" >&2
	fi
	(( ${#FOLDS} + ${#STEPS} + ${#GONE} )) && ECHO_E "\e[0;31m  Then run it again: $(_LIT "$AGAIN")\e[0m" >&2 && OR=1
	# Nothing folds back what a land's own resolution may have made of one – a change of its own there
	# the caller's to make by hand
	for E in "${(@)UNSURE[1,CAP]:#}"; do
		B=${${=E}[1]} L=${${=E}[2]} ON=${${=E}[3]}
		ECHO_E "\e[0;31m  What ${B:0:7} changes past ${L:0:7} may be the resolution of the land of $(_LIT "$NAME") that brought it, so no fold is offered – compare them: $(_LIT "git range-diff ${L:0:12}^! ${B:0:12}^!")$([ "$ON" != - ] && print -r -- "; where it holds a change of its own, make that on $(_LIT "$TARGET") by hand, stage it and fold it into ${ON:0:7}: $(_LIT "git edit --amend-into=${ON:0:12} -- <paths>")")\e[0m" >&2
	done
	(( ${#UNSURE} > CAP )) && ECHO_E "\e[0;31m  $(( ${#UNSURE} - CAP )) more likewise\e[0m" >&2
	# The rest of its own past the fork, and whether a merge sits among it
	REST=(${(f)"$(git rev-list "$BTIP" "^$FORK" "^$TIP" 2>/dev/null)"})
	REST=("${(@)REST:*_LAND_OWN}")
	REST=("${(@)REST:|OWNS}")
	REST=("${(@)REST:|_LAND_CAUGHT}")
	MERGES=(${(f)"$(git rev-list --merges "$BTIP" "^$FORK" "^$TIP" 2>/dev/null)"})
	# The checkout a step on the branch runs in – never the main worktree's branch or the default
	# branch, as `_PRINT_LAND_LEFT` leaves them
	if [[ "$FULL" == refs/heads/* ]] && [ "$NAME" != "$(_DEFAULT_BRANCH)" ]; then
		CO=$(_BRANCH_CHECKOUT "$FULL")
		local PRIMARY=$(git worktree list --porcelain 2>/dev/null | LC_ALL=C sed -n '1s/^worktree //p')
		[ -n "$CO" ] && [ "${CO:A}" = "${PRIMARY:A}" ] && CO=-
	else
		CO=-
	fi
	# Onto the copies where each carries its patch, as a replant drops one only by that – nor past a
	# merge, which a replant refuses
	if (( ALL_ON )) && [ "$CO" != - ]; then
		# The copy of its newest lookalike, its first on the way down
		for B in ${(f)"$(git rev-list "$BTIP" "^$FORK" "^$TIP" 2>/dev/null)"}; do (( ${+ONOF[$B]} )) && ON=${ONOF[$B]} && break; done
		if [ -n "$CO" ]; then
			if (( ! ${#REST} )); then
				MOVE="git -C $(_SHQ "$CO") reset --keep ${ON:0:12}"
			elif (( ! ${#MERGES} )); then
				MOVE="git -C $(_SHQ "$CO") edit --onto=$(_SHQ "$TARGET")"
			fi
		elif (( ! ${#REST} )); then
			MOVE=$(_BRANCH_CMD -f "$NAME" "${ON:0:12}")
		fi
		[ -n "$MOVE" ] && ECHO_E "\e[0;31m  ${${OR:+Or move}:-Move} $(_LIT "$NAME") onto $(_LIT "$TARGET")'s copies$( (( MSGS )) && print -r -- ", $(_LIT "$TARGET")'s messages standing"), then run it again: $(_LIT "$MOVE")\e[0m" >&2 && OR=1
	fi
	# Past them, any merge, and all else not its own – a catch-up copy, a commit the target dropped –
	# as `--base` replays all that follows it
	AT=$(_LAND_FIRST_PAST "$BTIP" "$FORK" "$TIP" "${OWNS[@]}" "${MERGES[@]}")
	PAST=(${(f)"$(git rev-list "$BTIP" "^$AT" "^$TIP" 2>/dev/null)"})
	if (( ${#PAST} )); then
		# A merge commit it leaves out is no work of the branch's own to name
		BELOW=(${(f)"$(git rev-list --no-merges "$AT" "^$FORK" "^$TIP" 2>/dev/null)"})
		BELOW=("${(@)BELOW:*REST}")
		ECHO_E "\e[0;31m  ${${OR:+Or land}:-Land} what follows them, leaving them out$( (( ${#BELOW} )) && print -r -- " with ${#BELOW} commit(s) of its own at or below ${AT:0:7}"): $(_LIT "$AGAIN") --base=${AT:0:12}\e[0m" >&2
		BASES=1 OR=1
	elif (( ${#UNSURE} && ! ( ${#FOLDS} + ${#STEPS} + ${#GONE} ) )); then
		# Nothing follows them – the land past them ends the retry, nothing to land
		ECHO_E "\e[0;31m  ${${OR:+Or, where}:-Where} each difference is that resolution, nothing of $(_LIT "$NAME")'s own follows them, so this ends it, with nothing to land: $(_LIT "$AGAIN") --base=${AT:0:12}\e[0m" >&2
		OR=1
	fi
	# Its own that no step above lands – below them, or beside a merge carrying them
	[ -z "$MOVE" ] && LEFT=("${(@)REST:|PAST}")
	# Only where all past the fork is its own – a catch-up copy there would land back too
	PAST=(${(f)"$(git rev-list "$BTIP" "^$FORK" "^$TIP" 2>/dev/null)"})
	if (( ALL_DROPPED && ! ${#MERGES} )) && (( ${#${(@)PAST:|_LAND_OWN}} + ${#${(@)PAST:*_LAND_CAUGHT}} == 0 )); then
		ECHO_E "\e[0;31m  ${OR:+Or, }${${OR:+to}:-To} land them back all the same: $(_LIT "$AGAIN") --base=${FORK:0:12}\e[0m" >&2
		BASES=1
	fi
	(( BASES )) && ECHO_E "\e[0;31m  With --dry-run first, each lists what it would land.\e[0m" >&2
	# Each copy of a dropped one taken off first where its checkout can, the drop standing
	if (( ${#LEFT} )); then
		if (( ${#GONE} && ! ${#MERGES} )) && [ -n "$CO" ] && [ "$CO" != - ]; then
			ECHO_E "\e[0;31m  ${#LEFT} commit(s) of $(_LIT "$NAME")'s own sit below them, which no step above lands – to land them, $(_LIT "$TARGET")'s drop standing, take the copies of what it dropped off $(_LIT "$NAME") first: $(_LIT "git -C $(_SHQ "$CO") edit -d$DROPS"), then run it again: $(_LIT "$AGAIN")\e[0m" >&2
		else
			ECHO_E "\e[0;31m  ${#LEFT} commit(s) of $(_LIT "$NAME")'s own sit below them$( (( ${#MERGES} )) && print -r -- " or beside a merge carrying them"), which no step above lands – to land those, take the copies$( (( ${#MERGES} )) && print -r -- ", or that merge,") out of $(_LIT "$NAME") first, then run it again: $(_LIT "$AGAIN")\e[0m" >&2
		fi
		git log --no-walk=unsorted --format='  %h %s' "${(@)LEFT[1,12]}" 2>/dev/null | _CARET_LINES | \
			LC_ALL=C sed "/./!d;s/^/${_DIM}/;s/\$/${_OFF}/" >&2
	fi
	exit 1
}

# Lands <branch>'s commits on the checked-out branch – where its tip still sits below them and on
# their fork, a fast-forward by compare-and-swap, else their replay from the fork onto the tip in an
# isolated worktree, as a replant replays – <branch> itself never moving
GIT_LAND () {
	local TARGET=${$(git symbolic-ref -q HEAD 2>/dev/null)#refs/heads/}
	if [ -z "$TARGET" ]; then
		PRINT_ERR "--land lands into the checked-out branch, and HEAD is detached – nothing landed"
		_PRINT_LAND_ELSEWHERE "$LAND_BRANCH"
		exit 1
	fi
	local REF=refs/heads/$TARGET TIP=$(git rev-parse HEAD) MAIN_DIR=$(git rev-parse --show-toplevel)
	local LAND_FULL=$(_LAND_REF_OF "$LAND_BRANCH") LAND_TIP="" LAND_NAME=$LAND_BRANCH
	# A branch first – anything else said as what it resolved to, and a relative name such as `@{-1}`
	# taken as the branch it names now, so the resume and every hint name that one
	if [[ "$LAND_FULL" == refs/heads/* ]]; then
		LAND_TIP=$(_PEEL_SHA "$LAND_FULL" commit)
		LAND_NAME=${LAND_FULL#refs/heads/}
	elif LAND_TIP=$(git rev-parse -q --verify --end-of-options "$LAND_BRANCH" 2>/dev/null); then
		LAND_TIP=$(_PEEL_SHA "$LAND_TIP" commit)
	fi
	if [ -z "$LAND_TIP" ]; then
		PRINT_ERR "Unknown branch: $LAND_BRANCH – nothing landed"
		ECHO_E "\e[0;31m  Name one this repository has – 'git branch --list' shows them.\e[0m" >&2
		exit 1
	fi
	local AGAIN="git edit --land=$(_SHQ "$LAND_NAME")"
	if [ "$LAND_FULL" = "$REF" ]; then
		PRINT_ERR "$LAND_NAME is the checked-out branch itself – nothing landed"
		_PRINT_LAND_ELSEWHERE "$LAND_NAME"
		exit 1
	fi
	if [[ "$LAND_FULL" != refs/heads/* ]]; then
		PRINT_TEXT "%s names no branch – landing %s, which never moves." 33 "$LAND_BRANCH" \
			"${${LAND_FULL:+$LAND_FULL at ${LAND_TIP:0:7}}:-commit $(git log -1 --format='%h %s' "$LAND_TIP")}"
	fi
	LAND_FROM=$LAND_NAME
	ONTO_UPSTREAM=$TARGET

	# Where the branch's own commits start – past all the target ever held, by its reflog, `--base`
	# over it, the branch's own reflog where the target keeps none, the merge base where neither does
	local FORK HOW MB=$(git merge-base "$TIP" "$LAND_TIP" 2>/dev/null)
	if [ -n "$EXEC_BASE" ]; then
		if ! git merge-base --is-ancestor "$EXEC_BASE" "$LAND_TIP" 2>/dev/null; then
			PRINT_ERR "--base ${EXEC_BASE:0:7} is not in $LAND_NAME's history – nothing landed"
			ECHO_E "\e[0;31m  Name the commit it forked from ('git log --oneline $(_LIT "$(_SHQ "$LAND_NAME")")' lists them), or leave --base out for the fork the reflogs name: $(_LIT "$AGAIN")\e[0m" >&2
			exit 1
		fi
		FORK=$EXEC_BASE HOW=base
	elif _LAND_HELD_FORK "$REF" "$TIP" "$LAND_TIP" "${(M)LAND_FULL:#refs/heads/*}" "$TARGET" "$LAND_NAME"; then
		FORK=${_LAND_FORK:-$MB} HOW=target
	elif [[ "$LAND_FULL" == refs/heads/* ]] && _LAND_FORK_POINT "$LAND_FULL" "$LAND_TIP" "$TIP"; then
		FORK=$_LAND_FORK HOW=reflog
	else
		FORK=$MB HOW=guess
	fi
	if [ -z "$FORK" ]; then
		PRINT_ERR "$LAND_NAME shares no history with $TARGET – nothing to replay from, so nothing landed"
		ECHO_E "\e[0;31m  Join the two by a merge if that is meant: git edit --exec -- git merge --allow-unrelated-histories $(_LIT "$(_SHQ "$LAND_NAME")")\e[0m" >&2
		exit 1
	fi
	# The branch's own commits a `--base` the target lacks leaves out below it – held by the target
	# in no form, then or ever, nor as a copy a land brought, by the reflogs as a land without
	# `--base` reads them – which the branch alone keeps, so nothing that moves or deletes it is
	# offered, and those the target holds in some form go into `_LAND_HELD_FORM`
	local -a BELOW
	_LAND_HELD_FORM=()
	if [ "$HOW" = base ] && ! git merge-base --is-ancestor "$FORK" "$TIP" 2>/dev/null; then
		local -a NEVER HELD_AS
		local E
		BELOW=(${${(M)${(f)"$(git cherry "$TIP" "$FORK" 2>/dev/null)"}:#+ *}#+ })
		NEVER=(${(f)"$(git log -g --format='^%H' "$REF" -- 2>/dev/null | git rev-list --ignore-missing --stdin "$FORK" "^$TIP" 2>/dev/null)"})
		BELOW=("${(@)BELOW:*NEVER}")
		if (( ${#BELOW} )) && _LAND_HELD_FORK "$REF" "$TIP" "$LAND_TIP" "${(M)LAND_FULL:#refs/heads/*}" "$TARGET" "$LAND_NAME"; then
			for E in "${_LAND_ALIKE[@]}"; do
				[ "${${=E}[3]}" = - ] || _LAND_HELD_FORM+=("${E%% *}")
				[ "${${=E}[4]}" = . ] && HELD_AS+=("${E%% *}")
			done
			BELOW=("${(@)BELOW:|_LAND_CAUGHT}")
			BELOW=("${(@)BELOW:|HELD_AS}")
			# A catch-up copy whose original the tip still holds, by author, else by message – one of a
			# commit the target dropped it holds in no form
			if (( ${#_LAND_CAUGHT} )); then
				local -A TKEY
				local -a UNMET
				local K
				for E in ${(f)"$(git log --format='%an%x1f%ae%x1f%at' "$TIP" "^$LAND_TIP" -- 2>/dev/null)"}; do TKEY[A$E]=1; done
				for E in ${(f)"$(git log --no-walk=unsorted --format='%H %an%x1f%ae%x1f%at' "${_LAND_CAUGHT[@]}" -- 2>/dev/null)"}; do
					K=A${E#* }
					if [ -n "${TKEY[$K]}" ]; then _LAND_HELD_FORM+=("${E%% *}"); else UNMET+=("${E%% *}"); fi
				done
				(( ${#UNMET} )) && for E in ${(f)"$(git rev-list "$TIP" "^$LAND_TIP" -- 2>/dev/null)"}; do
					K=M$(_CLEAN_MESSAGE "$E") TKEY[$K]=1
				done
				for E in "${UNMET[@]}"; do
					K=M$(_CLEAN_MESSAGE "$E")
					[ -n "${TKEY[$K]}" ] && _LAND_HELD_FORM+=("$E")
				done
			fi
		fi
		_LAND_OWN=() _LAND_ALIKE=() _LAND_CAUGHT=()
	fi

	# Nothing of its own, or all of it on the target already – done, nothing to land, and a branch
	# deleted only where that was proven: one it built commits on, never one only put on the target's
	local -a OWN SPAN
	OWN=(${(f)"$(git rev-list "$FORK..$LAND_TIP" 2>/dev/null)"})
	if git merge-base --is-ancestor "$LAND_TIP" "$TIP" 2>/dev/null && \
	   { (( ${#OWN} )) || [[ "$LAND_FULL" != refs/heads/* ]] || _LAND_BUILT "$LAND_FULL" "$LAND_TIP"; }; then
		PRINT_TEXT "%s is already landed – %s holds every commit of it, so nothing landed." 32 "$LAND_NAME" "$TARGET"
		_PRINT_LAND_DONE "$LAND_FULL" -d "$TARGET"
		EMIT_STATUS "$TIP" "$REF" false "already landed"
		exit 0
	fi
	if (( ! ${#OWN} )); then
		_PRINT_LAND_FORK "$FORK" "$TIP" "$HOW" "$LAND_NAME" "$TARGET"
		local -i NO_FORM=$REPLY
		PRINT_TEXT "%s has no commits of its own past that fork – nothing to land." 32 "$LAND_NAME"
		# Under `--base`, only where some below it the target holds in no form
		git merge-base --is-ancestor "$FORK" "$TIP" 2>/dev/null || { [ "$HOW" = base ] && (( ! NO_FORM )); } || \
			PRINT_TEXT "To land what %s dropped since all the same, name an older fork: %s" 33 "$TARGET" "$AGAIN --base=<sha>"
		EMIT_STATUS "$TIP" "$REF" false "nothing to land"
		exit 0
	fi
	# A fork only guessed, its span past the merge base holding what looks like the target's history
	# rewritten since – a replay would bring back what the target dropped, so the caller names it
	if [[ "$HOW" == (reflog|guess) ]] && [ -n "$MB" ]; then
		local -a ALIKE
		ALIKE=(${(f)"$(_LAND_LOOKALIKES "$MB" "$TIP" "$LAND_TIP")"})
		if (( ${#ALIKE} )); then
			_PRINT_LAND_FORK "$FORK" "$TIP" "$HOW" "$LAND_NAME" "$TARGET"
			PRINT_ERR "$TARGET keeps no reflog to tell $LAND_NAME's own commits by, and past their merge base $LAND_NAME holds ${#ALIKE} commit(s) sharing author and subject with commits of $TARGET's, a rewrite's copies it seems – nothing landed"
			git log --no-walk=unsorted --format='  %h %s' "${(@)ALIKE[1,12]}" 2>/dev/null | _CARET_LINES | \
				LC_ALL=C sed "/./!d;s/^/${_DIM}/;s/\$/${_OFF}/" >&2
			ECHO_E "\e[0;31m  If those are $(_LIT "$TARGET")'s, land what follows the newest of them: $(_LIT "$AGAIN") --base=${ALIKE[-1]:0:12}\e[0m" >&2
			ECHO_E "\e[0;31m  If they are $(_LIT "$LAND_NAME")'s own, land from the merge base: $(_LIT "$AGAIN") --base=${MB:0:12}\e[0m" >&2
			ECHO_E "\e[0;31m  Either with --dry-run first lists what it would land.\e[0m" >&2
			exit 1
		fi
	fi
	SPAN=(${(f)"$(git rev-list --reverse "$LAND_TIP" "^$FORK" "^$TIP" 2>/dev/null)"})
	# What lands is the branch's own commits alone – a commit the target held and dropped since, on
	# the branch's line, stays out, the drop standing, as does one the target's by a land's record, a
	# copy a land of it into the branch made or another branch's commit a land of that one copied
	# over – while one inside a merge refuses, as no replay leaves it out
	local -a ALIKE LANDED
	if [ "$HOW" = target ]; then
		local -a DROPPED GONE CAUGHT
		local -A MINE ONLINE
		local P
		for P in "${_LAND_OWN[@]}"; do MINE[$P]=1; done
		for P in ${(f)"$(git rev-list --first-parent "$LAND_TIP" "^$FORK" "^$TIP" 2>/dev/null)"}; do ONLINE[$P]=1; done
		for P in "${SPAN[@]}"; do
			if (( ${_LAND_CAUGHT[(Ie)$P]} )); then
				CAUGHT+=("$P")
			elif (( ${+MINE[$P]} )); then
				continue
			elif (( ${+ONLINE[$P]} )); then
				GONE+=("$P")
			else
				DROPPED+=("$P")
			fi
		done
		_LAND_CAUGHT=("${CAUGHT[@]}") _LAND_GONE=("${GONE[@]}")
		(( ${#DROPPED} )) && _REFUSE_LAND_DROPPED "$FORK" "$TIP" "$LAND_TIP" "$LAND_NAME" "$TARGET" "$HOW" "${DROPPED[@]}"
		for P in "${SPAN[@]}"; do ALIKE+=(${(M)_LAND_ALIKE:#$P *}); done
		LANDED=(${${(M)ALIKE:#* . ?}%% *})
	else
		_LAND_CAUGHT=() _LAND_GONE=()
	fi
	# Every own one on the target in another form – by patch id, an earlier replay of it, say, or as a
	# copy it took, `_LAND_HELD_COPIES`'s kind `.` – a run's worth of commits the replay would drop as
	# empty or leave out, or some the target's drop keeping out
	local -a UNIQUE LEFT BYCOPY
	UNIQUE=(${${(M)${(f)"$(git cherry "$TIP" "$LAND_TIP" "$FORK" 2>/dev/null)"}:#+ *}#+ })
	LEFT=("${(@)UNIQUE:*_LAND_GONE}" "${(@)UNIQUE:*_LAND_CAUGHT}")
	UNIQUE=("${(@)UNIQUE:|_LAND_CAUGHT}")
	UNIQUE=("${(@)UNIQUE:|_LAND_GONE}")
	BYCOPY=("${(@)UNIQUE:*LANDED}")
	UNIQUE=("${(@)UNIQUE:|LANDED}")
	if (( ! ${#UNIQUE} && ${#ALIKE} == ${#LANDED} )); then
		# A catch-up copy of a commit the tip still holds – by author, else by message – is no drop
		if (( ${#LEFT} )); then
			local -A TKEY
			local C K
			for C in ${(f)"$(git log --format='%an%x1f%ae%x1f%at' "$TIP" "^$FORK" -- 2>/dev/null)"}; do TKEY[A$C]=1; done
			for C in ${(f)"$(git log --no-walk=unsorted --format='%H %an%x1f%ae%x1f%at' "${(@)LEFT:*_LAND_CAUGHT}" -- 2>/dev/null)"}; do
				K=A${C#* }
				[ -n "${TKEY[$K]}" ] && BYCOPY+=("${C%% *}") && LEFT=("${(@)LEFT:#${C%% *}}")
			done
			if (( ${#${(@)LEFT:*_LAND_CAUGHT}} )); then
				for C in ${(f)"$(git rev-list "$TIP" "^$FORK" -- 2>/dev/null)"}; do K=M$(_CLEAN_MESSAGE "$C"); TKEY[$K]=1; done
				for C in "${(@)LEFT:*_LAND_CAUGHT}"; do
					K=M$(_CLEAN_MESSAGE "$C")
					[ -n "${TKEY[$K]}" ] && BYCOPY+=("$C") && LEFT=("${(@)LEFT:#$C}")
				done
			fi
		fi
		if (( ${#LEFT} )); then
			_PRINT_LAND_FORK "$FORK" "$TIP" "$HOW" "$LAND_NAME" "$TARGET"
			PRINT_TEXT "%s has nothing of its own to land past that fork – %s commit(s) %s held and dropped since, or copies of such, stay out:" 32 \
				"$LAND_NAME" "${#LEFT}" "$TARGET"
			git log --no-walk=unsorted --format='  %h %s' "${(@)LEFT[1,12]}" 2>/dev/null | _CARET_LINES | \
				LC_ALL=C sed "/./!d;s/^/${_DIM}/;s/\$/${_OFF}/"
			PRINT_TEXT "To land what %s dropped since all the same, name the fork: %s" 33 "$TARGET" "$AGAIN --base=${FORK:0:12}"
			EMIT_STATUS "$TIP" "$REF" false "nothing to land"
			exit 0
		fi
		PRINT_TEXT "%s is already landed – each of its %s commit(s) is on %s in another form (by patch id%s), so nothing landed." 32 \
			"$LAND_NAME" "${#SPAN[@]}" "$TARGET" "${BYCOPY:+, or as a copy it took}"
		_PRINT_LAND_DONE "$LAND_FULL" -D "$TARGET" "${BELOW[@]}"
		EMIT_STATUS "$TIP" "$REF" false "already landed"
		exit 0
	fi
	# One of its own that looks like a copy of the target's refuses the whole land – leaving it out
	# might drop a change made on it since, landing it would land a second copy
	(( ${#ALIKE} )) && _REFUSE_LAND_COPIES "$FORK" "$TIP" "$LAND_TIP" "$LAND_NAME" "${(M)LAND_FULL:#refs/heads/*}" "$TARGET" "${ALIKE[@]}"
	_PRINT_LAND_FORK "$FORK" "$TIP" "$HOW" "$LAND_NAME" "$TARGET"

	# The tip still below them and on their fork – nothing to replay, nothing a conflict can stop, the
	# commits land as they are, a gate checking them in a worktree of their own – unless one of them
	# has to stay out, a catch-up copy or what the target dropped
	if (( ! ${#_LAND_CAUGHT} && ! ${#_LAND_GONE} )) && git merge-base --is-ancestor "$FORK" "$TIP" 2>/dev/null && \
	   git merge-base --is-ancestor "$TIP" "$LAND_TIP" 2>/dev/null; then
		PRINT_TEXT "Landing %s on %s – a fast-forward of %s commit(s)." 36 "$LAND_NAME" "$TARGET" "${#SPAN[@]}"
		if [ ${#OPT_DRY_RUN} -gt 0 ]; then
			git log --reverse --format='  %h %s' "$TIP..$LAND_TIP" 2>/dev/null | head -12 | _CARET_LINES | \
				LC_ALL=C sed "/./!d;s/^/${_DIM}/;s/\$/${_OFF}/"
			PRINT_TEXT "Dry run – would fast-forward %s to %s, nothing landed. Land it: %s" 33 "$TARGET" "${LAND_TIP:0:12}" \
				"$AGAIN${EXEC_BASE:+ --base=${EXEC_BASE:0:12}}"
			EMIT_STATUS "$TIP" "$REF" false "dry run"
			exit 0
		fi
		if _VERIFY_CONFIGURED; then
			_PREPARE_RUN_WORKTREE "$LAND_TIP" git-edit-land
			# Having no pause to offer, a failure refuses outright, as `--exec`'s does
			_VERIFY_NO_RESUME=true
			_VERIFY_CONFIGURED && _REQUIRE_CURRENT "$REF" "$TIP"
			if ! _VERIFY_REWRITE "$WORKTREE_DIR" "$LAND_TIP" "$TIP"; then
				ECHO_E "\e[0;31m  Nothing landed – fix it on $(_LIT "$LAND_NAME"), or land it unchecked: $(_LIT "$AGAIN") --no-verify\e[0m" >&2
				exit 1
			fi
			_VERIFY_NO_RESUME=false
		elif [ ${#OPT_VERIFY_SPAN} -gt 0 ] && [ ${#OPT_NO_VERIFY} -eq 0 ]; then
			PRINT_ERR "--verify-span needs a command – pass --verify=<cmd> or set edit.verifyCmd"
			exit 1
		else
			_VERIFY_NOTE_BYPASS
		fi
		local UPDATE_CMD="git update-ref -m ${(q-)${:-git edit: land $LAND_NAME$_REFLOG_TAG}} ${(q-)REF} ${(q-)LAND_TIP} ${(q-)TIP}"
		PRINT_CMD "$UPDATE_CMD" 90
		_MOVE_REF "$UPDATE_CMD" || _REFUSE_LAND_MOVED "$REF" "$TIP"
		_RECORD_REF_MOVE "$REF" "$TIP" "$LAND_TIP" "land $LAND_NAME"
		_PRINT_REWRITE_APPLY_HINT "$TARGET" "$TIP" "$LAND_TIP"
		_PRINT_LAND_LEFT "$LAND_FULL" "$LAND_TIP" "$LAND_TIP" "$TARGET"
		_PRINT_ONTO_SUMMARY "$TIP" "$LAND_TIP" "${#SPAN[@]}"
		LAND_NEW_HEAD=$LAND_TIP LAND_REF=$REF
		return 0
	fi

	# A replay runs from where the branch last met the target, where that sits above the fork – all
	# below it is the target's own – and a merge in it refuses, the replay flattening it
	git merge-base --is-ancestor "$FORK" "$MB" 2>/dev/null && FORK=$MB
	local MERGE=$(git rev-list --merges "$LAND_TIP" "^$FORK" "^$TIP" 2>/dev/null | head -1)
	if [ -n "$MERGE" ]; then
		local MERGE_MSG="Merge branch '$LAND_NAME' into $TARGET"
		[[ "$MERGE_MSG" == *[\"\$\`\\!]* ]] && MERGE_MSG=$(_SHQ "$MERGE_MSG") || MERGE_MSG="\"$MERGE_MSG\""
		PRINT_ERR "$LAND_NAME holds a merge commit past its fork, $(git log -1 --format='%h %s' "$MERGE") – replayed onto $TARGET it would be flattened, so nothing landed"
		# A merge brings all the branch holds – offered only where that is the span,
		# never past a fork the target no longer holds
		if git merge-base --is-ancestor "$FORK" "$TIP" 2>/dev/null; then
			ECHO_E "\e[0;31m  Land it as a merge instead: $(_LIT "git edit --exec -- git merge --no-ff -m $MERGE_MSG $(_SHQ "$LAND_NAME")")\e[0m" >&2
		else
			ECHO_E "\e[0;31m  A merge would bring along what $(_LIT "$TARGET") rewrote or dropped below the fork, so none is offered.\e[0m" >&2
			[ -n "$(git rev-list -n 1 "$LAND_TIP" "^$MERGE" "^$TIP" 2>/dev/null)" ] && \
				ECHO_E "\e[0;31m  Land what follows it: $(_LIT "$AGAIN") --base=${MERGE:0:12}\e[0m" >&2
			ECHO_E "\e[0;31m  Or take the merge out of $(_LIT "$LAND_NAME") first, then run it again: $(_LIT "$AGAIN")\e[0m" >&2
		fi
		exit 1
	fi

	if git merge-base --is-ancestor "$FORK" "$TIP" 2>/dev/null; then
		PRINT_TEXT "Landing %s on %s – %s moved past their fork, so they replay onto its tip." 36 "$LAND_NAME" "$TARGET" "$TARGET"
	else
		PRINT_TEXT "Landing %s on %s – %s no longer holds their fork, so they replay onto its tip." 36 "$LAND_NAME" "$TARGET" "$TARGET"
	fi
	local GAINED=$(git rev-list --count "$FORK..$TIP" 2>/dev/null)
	# A commit the target's by a land's record left out by name – the rebase tells a duplicate only
	# against the fork – as is what it dropped
	local -i REPLAYS=$(( ${#SPAN[@]} - ${#_LAND_CAUGHT} - ${#_LAND_GONE} ))
	PRINT_TEXT "%s gained %s commit(s); replaying %s from '%s' on top:" 32 \
		"$TARGET" "${GAINED:-0}" "$REPLAYS" "$LAND_NAME"
	_PRINT_ONTO_TRIAGE "$TIP" "$LAND_TIP" "$FORK"
	# A land only adds commits, so no pushed guard stands in its way – but a replay copies what it
	# replays, and pushed commits copied are two of each in the published history
	local ON=$(_REMOTES_CONTAINING "${SPAN[1]}" | head -3 | tr '\n' ' ' | LC_ALL=C sed 's/ $//')
	if [ -n "$ON" ]; then
		local -i UNPUSHED=$(git rev-list --count "$LAND_TIP" "^$FORK" "^$TIP" --not --remotes 2>/dev/null)
		PRINT_TEXT "%s of them already pushed (on: %s) – the replay lands copies under new SHAs, the pushed ones staying as they are." 33 \
			"$(( ${#SPAN[@]} - UNPUSHED ))" "$ON"
	fi
	if [ ${#OPT_DRY_RUN} -gt 0 ]; then
		PRINT_TEXT "Dry run – would replay %s commit(s) onto %s at %s, nothing landed. Land it: %s" 33 "$REPLAYS" "$TARGET" "${TIP:0:12}" \
			"$AGAIN${EXEC_BASE:+ --base=${EXEC_BASE:0:12}}"
		EMIT_STATUS "$TIP" "$REF" false "dry run"
		exit 0
	fi

	_PREPARE_RUN_WORKTREE "$LAND_TIP" git-edit-land
	cd "$WORKTREE_DIR" || exit 1
	# The rebase replays the branch from its tip, which the pause names as its target – the CAS moves
	# the checked-out branch from the tip it read
	_ONTO_REPLAY "$WORKTREE_DIR" "$REF" "$TIP" "$TIP" "$FORK" "land $LAND_NAME" \
		"operation=land" "worktree=$WORKTREE_DIR" "wt_ours=$WT_OURS" "branch=$REF" "orig_head=$TIP" \
		"target=$LAND_TIP" "upstream=$LAND_NAME" "span=$REPLAYS" "fork=$FORK" "maindir=$MAIN_DIR" \
		"caught=${_LAND_CAUGHT[*]}" "dropped=${_LAND_GONE[*]}" "below=${BELOW[*]}"
	# Every commit came out empty, with no stop to skip one – each change on the target already
	if [ "$ONTO_NEW_HEAD" = "$TIP" ]; then
		PRINT_TEXT "%s is already landed – each of its %s commit(s) came out empty on %s, its change there already, so nothing landed." 32 \
			"$LAND_NAME" "${#SPAN[@]}" "$TARGET"
		_PRINT_LAND_DONE "$LAND_FULL" -D "$TARGET" "${BELOW[@]}"
		PRINT_COMPLETED "$TIP" "$REF" false "already landed"
		exit 0
	fi
	_PRINT_REWRITE_APPLY_HINT "$TARGET" "$TIP" "$ONTO_NEW_HEAD"
	_PRINT_LAND_LEFT "$LAND_FULL" "$LAND_TIP" "$ONTO_NEW_HEAD" "$TARGET" "" "" "${BELOW[@]}"
	_PRINT_ONTO_SUMMARY "$TIP" "$ONTO_NEW_HEAD" "$REPLAYS"
	LAND_NEW_HEAD=$ONTO_NEW_HEAD LAND_REF=$REF
}

# Refuses a land whose target moved after the run read it – what it built sits on the old tip, so
# nothing of it is offered, only the run again, which lands onto the new one
_REFUSE_LAND_MOVED () {
	# Args: <ref> <tip the run read>
	local NOW=$(git rev-parse -q --verify "$1" 2>/dev/null)
	PRINT_ERR "Branch '${1#refs/heads/}' moved from ${2:0:7} to ${NOW:0:7} during the land – refusing to overwrite"
	ECHO_E "\e[0;31m  Nothing landed – land it onto the new tip: git edit --land=$(_LIT "$(_SHQ "$LAND_FROM")")\e[0m" >&2
	exit 1
}

# Prints the repository's main line – `init.defaultBranch`, else a remote's `HEAD`, `origin`'s
# first, else `main` or `master` – the first a branch here names, failing where none does
_DEFAULT_BRANCH () {
	local B R
	B=$(git config --get init.defaultBranch 2>/dev/null)
	[ -n "$B" ] && git show-ref --verify -q "refs/heads/$B" 2>/dev/null && { print -r -- "$B"; return 0; }
	for R in origin ${(f)"$(git remote 2>/dev/null)"}; do
		B=$(git symbolic-ref -q "refs/remotes/$R/HEAD" 2>/dev/null) || continue
		B=${B#refs/remotes/$R/}
		git show-ref --verify -q "refs/heads/$B" 2>/dev/null && { print -r -- "$B"; return 0; }
	done
	for B in main master; do
		git show-ref --verify -q "refs/heads/$B" 2>/dev/null && { print -r -- "$B"; return 0; }
	done
	return 1
}

# Names what is left to do with a branch whose commits the target holds – deleting it, for one
# checked out in a linked worktree once that checkout is retired, while one the main worktree has
# checked out stays, the land there likelier meant the other way round, as does one checked out
# nowhere where the target is a linked worktree's branch, a catch-up, and the repository's default
# branch wherever it stands, the main line a land into another branch catches up from – and none
# where it alone holds commits a `--base` left out below it
_PRINT_LAND_DONE () {
	# Args: <branch's full ref, empty where it names no branch> <-d|-D> <target's name>
	#       [<commit left out below --base>...]
	[[ "$1" == refs/heads/* ]] || return 0
	if (( $# > 3 )); then
		_PRINT_LAND_KEPT "${1#refs/heads/}" "$3" "left out below --base" "${@[4,-1]}"
		return 0
	fi
	local NAME=${1#refs/heads/} CO=$(_BRANCH_CHECKOUT "$1") DEL TCO=""
	local PRIMARY=$(git worktree list --porcelain 2>/dev/null | LC_ALL=C sed -n '1s/^worktree //p')
	local MAIN_LINE=$(_DEFAULT_BRANCH)
	DEL=$(_BRANCH_CMD "$2" "$NAME")
	if [ -n "$CO" ] && [ "${CO:A}" = "${PRIMARY:A}" ]; then
		PRINT_TEXT "Nothing to do – %s is checked out in the main worktree, %s, and stays." 32 "$NAME" "$CO"
		git merge-base --is-ancestor "refs/heads/$3" "$1" 2>/dev/null || \
			PRINT_TEXT "To land %s on it instead, from there: %s" 33 "$3" "git -C $(_SHQ "$CO") edit --land=$(_SHQ "$3")"
	elif [ -n "$CO" ] && [ "$NAME" != "$MAIN_LINE" ]; then
		PRINT_TEXT "Nothing to do – it is checked out in %s; once that checkout is retired, delete it: %s" 32 "$CO" "$DEL"
	elif [ -z "$CO" ] && [ -n "${TCO:=$(_BRANCH_CHECKOUT "refs/heads/$3")}" ] && [ "${TCO:A}" != "${PRIMARY:A}" ]; then
		# Landed into a linked worktree's branch, a catch-up likelier
		# than its end, as `_PRINT_LAND_LEFT` reads it
		PRINT_TEXT "Nothing to do – %s, checked out nowhere, stays as it is." 32 "$NAME"
	elif [ "$NAME" = "$MAIN_LINE" ]; then
		PRINT_TEXT "Nothing to do – %s, the repository's default branch%s, stays as it is." 32 "$NAME" "${CO:+, checked out in $CO}"
	else
		PRINT_TEXT "Nothing to do – delete it once its work is done: %s" 32 "$DEL"
	fi
}

# Prints the picks a resumed replay in <worktree> left out at its stops – skipped there, or emptied
# by the resolution – by its own record of what each pick became: a pick dropped as empty where it
# never stopped had its change on <base> already, so is none of them
_REPLAY_LEFT_OUT () {
	# Args: <worktree> <base it replayed onto> <tip it came out at>
	local T R
	local -a STOPPED REBUILT LEFT_OUT
	local -A PAIRED CHAIN DONE
	[ -n "$STATE_STOPS" ] || return 0
	for T in ${(z)STATE_STOPS}; do [[ "$T" == \$\'* ]] || STOPPED+=("${T#*:}"); done
	[ "$3" != "$2" ] && _PAIR_REPLAYED "$1" "$2" "$3"
	# Only what a rebuilt commit pairs with landed – one recorded against the base pairs with none
	for R in "${REBUILT[@]}"; do [ -n "${PAIRED[$R]}" ] && DONE[${PAIRED[$R]}]=1; done
	for R in "${(@u)STOPPED}"; do
		[ -n "$R" ] && (( ! ${+DONE[$R]} )) && print -r -- "$R"
	done
	return 0
}

# Says where the landed branch stands – a fast-forward leaves it at the new tip, a replay on the
# commits it copied, which only the branch's own checkout may move, and none the main worktree's,
# the repository's default branch or, landed into a linked worktree's branch, one checked out
# nowhere – and where a resumed replay left some of them out at its stops, skipped or emptied by
# the resolution, or a `--base` some below it, that the branch alone holds those, so nothing that
# moves or deletes it is offered
_PRINT_LAND_LEFT () {
	# Args: <branch's full ref> <its tip the run read> <new tip of the target> <target's name>
	#       [<worktree of the resumed replay, empty for none> <tip it replayed onto>
	#       [<commit left out below --base>...]]
	[[ "$1" == refs/heads/* ]] || return 0
	[ -n "$_IN_LANDED_STEP" ] || { _LANDED_STEP "$0" "$@"; return; }
	local NAME=${1#refs/heads/} NOW CO TCO="" MAIN_LINE="" WHY
	NOW=$(git rev-parse -q --verify "$1" 2>/dev/null)
	if [ "$NOW" != "$2" ]; then
		PRINT_TEXT "Branch %s moved on to %s while this ran – what it gained past %s did not land: %s" 33 \
			"$NAME" "${NOW:0:7}" "${2:0:7}" "git edit --land=$(_SHQ "$NAME")"
		return 0
	fi
	CO=$(_BRANCH_CHECKOUT "$1")
	if [ "$2" = "$3" ]; then
		PRINT_TEXT "Branch %s left as it was, at the tip %s now has%s." 32 "$NAME" "$4" "${CO:+ – checked out in $CO}"
		return 0
	fi
	local -a LEFT BELOW
	local PRIMARY=$(git worktree list --porcelain 2>/dev/null | LC_ALL=C sed -n '1s/^worktree //p')
	BELOW=("${(@)@[7,-1]}")
	[ -n "$5" ] && LEFT=(${(f)"$(_REPLAY_LEFT_OUT "$5" "$6" "$3")"})
	if (( ${#LEFT} + ${#BELOW} )); then
		(( ${#BELOW} )) && WHY="left out below --base"
		(( ${#LEFT} )) && WHY+="${WHY:+, }skipped, or emptied by a resolution"
		_PRINT_LAND_KEPT "$NAME" "$4" "$WHY" "${BELOW[@]}" "${LEFT[@]}"
	elif [ -n "$CO" ] && [ "${CO:A}" = "${PRIMARY:A}" ]; then
		# The main worktree's branch stays, as `_PRINT_LAND_DONE` leaves it – moved onto the copies it
		# would take in all the target holds, unlanded work too – a catch-up the likelier meaning
		PRINT_TEXT "Branch %s, checked out in the main worktree, %s, stays as it is – %s now holds copies of its commits." 32 "$NAME" "$CO" "$4"
		PRINT_TEXT "Once %s's work is done, land it there: %s" 33 "$4" "git -C $(_SHQ "$CO") edit --land=$(_SHQ "$4")"
	elif [ -n "$CO" ] && [ "$NAME" != "${MAIN_LINE:=$(_DEFAULT_BRANCH)}" ]; then
		PRINT_TEXT "Branch %s, checked out in %s, still holds the original commits, where %s now holds copies – once its work there is done, move that checkout onto them: %s" 33 \
			"$NAME" "$CO" "$4" "git -C $(_SHQ "$CO") reset --keep ${3:0:12}"
	elif [ -z "$CO" ] && [ -n "${TCO:=$(_BRANCH_CHECKOUT "refs/heads/$4")}" ] && [ "${TCO:A}" != "${PRIMARY:A}" ]; then
		# Landed into a linked worktree's branch, a catch-up likelier than its end – moved onto the copies
		# or deleted, it would take in that branch's unlanded work, or go
		PRINT_TEXT "Branch %s, checked out nowhere, stays as it is – %s, checked out in %s, now holds copies of its commits." 32 "$NAME" "$4" "$TCO"
	elif [ "$NAME" = "${MAIN_LINE:=$(_DEFAULT_BRANCH)}" ]; then
		# The main line, a land of it into another branch a catch-up – moved onto the copies or deleted,
		# it would take in that branch's unlanded work, or go
		PRINT_TEXT "Branch %s, the repository's default branch%s, stays as it is – %s now holds copies of its commits." 32 "$NAME" "${CO:+, checked out in $CO}" "$4"
	else
		PRINT_TEXT "Branch %s still holds the original commits, where %s now holds copies – once its work is done, point it at those (%s) or delete it (%s)." 33 \
			"$NAME" "$4" "$(_BRANCH_CMD -f "$NAME" "${3:0:12}")" "$(_BRANCH_CMD -D "$NAME")"
	fi
}

# Names the commits a land left on <branch> alone, the target holding them in no form – so nothing
# that moves or deletes it is offered, only the land that takes them once they should go
_PRINT_LAND_KEPT () {
	# Args: <branch's name> <target's name> <how they were left out> <commit>...
	local NAME=$1 TARGET=$2 WHY=$3 C
	shift 3
	PRINT_TEXT "Branch %s keeps %s commit(s) %s holds in no form – %s – and is the only branch holding them, so leave it as it is:" 33 \
		"$NAME" "$#" "$TARGET" "$WHY"
	for C in "${(@)@[1,12]}"; do
		git log -1 --format='  %h %s' "$C" 2>/dev/null | _CARET_LINES | LC_ALL=C sed "/./!d;s/^/${_DIM}/;s/\$/${_OFF}/"
	done
	PRINT_TEXT "Land them once they should go: %s" 33 "git edit --land=$(_SHQ "$NAME")"
}

# Splits the span into what the upstream already carries and what is genuinely
# this branch's, using patch ids – the rebase drops the former silently, and a
# caller who doesn't know that reads the shorter result as lost work
_PRINT_ONTO_TRIAGE () {
	local UPSTREAM=$1
	local TIP=$2
	local FORK=$3
	local -a UNIQUE DUPLICATE
	local LINE
	while IFS= read -r LINE; do
		[ -z "$LINE" ] && continue
		if [[ "$LINE" == "+ "* ]]; then
			UNIQUE+=("${LINE#+ }")
		else
			DUPLICATE+=("${LINE#- }")
		fi
	done < <(git cherry "$UPSTREAM" "$TIP" "$FORK" 2>/dev/null)

	local C
	# A land's copies of the target's own a land of it into the branch made, and what the target
	# dropped, which it leaves out – named apart
	local -a COPIED GONE
	if [ -n "$LAND_FROM" ]; then
		COPIED=("${(@)UNIQUE:*_LAND_CAUGHT}" "${(@)DUPLICATE:*_LAND_CAUGHT}") GONE=("${(@)UNIQUE:*_LAND_GONE}")
		UNIQUE=("${(@)UNIQUE:|_LAND_CAUGHT}")
		UNIQUE=("${(@)UNIQUE:|_LAND_GONE}")
		DUPLICATE=("${(@)DUPLICATE:|_LAND_CAUGHT}")
	fi
	for C in "${UNIQUE[@]}"; do
		git log -1 --format='  %h %s' "$C" 2>/dev/null | _CARET_LINES | LC_ALL=C sed "/./!d;s/^/${_DIM}/;s/\$/${_OFF}/"
	done
	if (( ${#COPIED} )); then
		PRINT_TEXT "%s commit(s) are %s's own by a land's record – it holds or held them in another form – and stay out:" 33 "${#COPIED}" "$ONTO_UPSTREAM"
		for C in "${COPIED[@]}"; do
			git log -1 --format='  %h %s' "$C" 2>/dev/null | _CARET_LINES | LC_ALL=C sed "/./!d;s/^/${_DIM}/;s/\$/${_OFF}/"
		done
	fi
	if (( ${#GONE} )); then
		PRINT_TEXT "%s commit(s) %s held and dropped since stay out – the drop stands:" 33 "${#GONE}" "$ONTO_UPSTREAM"
		for C in "${GONE[@]}"; do
			git log -1 --format='  %h %s' "$C" 2>/dev/null | _CARET_LINES | LC_ALL=C sed "/./!d;s/^/${_DIM}/;s/\$/${_OFF}/"
		done
	fi
	if [ ${#DUPLICATE[@]} -gt 0 ]; then
		PRINT_TEXT "%s commit(s) are already on %s and will be dropped:" 33 "${#DUPLICATE[@]}" "$ONTO_UPSTREAM"
		for C in "${DUPLICATE[@]}"; do
			git log -1 --format='  %h %s' "$C" 2>/dev/null | _CARET_LINES | LC_ALL=C sed "/./!d;s/^/${_DIM}/;s/\$/${_OFF}/"
		done
	fi
}

# Names the skip a replant wants – a conflict on a commit the upstream carries another way
# case where skipping is the answer rather than a merge – say so, since the
# generic "resolve it" advice produces a duplicate commit instead
_PRINT_ONTO_SKIP_HINT () {
	local WT=$1
	local UPSTREAM=$2
	local GITDIR=$(git -C "$WT" rev-parse --git-dir 2>/dev/null)
	local STOPPED=$(cat "$GITDIR/rebase-merge/stopped-sha" 2>/dev/null)
	[ -z "$STOPPED" ] && return 0
	# `git cherry` compares patch ids, so an upstream that took the same change
	# via a different commit still matches
	local VERDICT=$(git cherry "$UPSTREAM" "$STOPPED" "$STOPPED^" 2>/dev/null | head -1)
	if [[ "$VERDICT" == "- "* ]]; then
		PRINT_TEXT "%s is already on %s in another form – %s is likely right here." 33 \
			"$(git log -1 --format='%h %s' "$STOPPED" 2>/dev/null)" "$ONTO_UPSTREAM" "git edit --skip"
	fi
}

# Refuses before anything moves where the checkout holds uncommitted work on a path the replant
# rewrites and no sync can bring it along – halfway through a merge, rebase, cherry-pick or
# revert, or holding unmerged entries – as found only once the branch moved, the ref and the
# files would disagree; elsewhere the sync after the landing merges that work onto what landed
_GUARD_ONTO_CHECKOUT_CLEAN () {
	# Args: <checkout> <fork> <upstream> [<branch ref>]
	local DIR=$1
	local FORK=$2
	local UPSTREAM=$3
	[ -z "$DIR" ] || [ ! -d "$DIR" ] && return 0
	# A checkout on another branch is not the replant's to update
	[ -n "$4" ] && [ "$(git -C "$DIR" symbolic-ref -q HEAD 2>/dev/null)" != "$4" ] && return 0

	local -a AFFECTED UNSTAGED STAGED UNTRACKED DIRTY BLOCKED
	# What the upstream changed since the fork, the paths the replant rewrites – the branch's own
	# files land as they are, uncommitted work on them included
	# NUL-separated, as the line form C-quotes a name and splits one holding a newline
	AFFECTED=(${(0)"$(git -C "$DIR" diff -z --ignore-submodules=dirty --no-renames --name-only "$FORK" "$UPSTREAM" 2>/dev/null)"})
	[ ${#AFFECTED} -eq 0 ] && return 0
	_HALFWAY_THROUGH "$DIR" || return 0
	local WHAT=$REPLY
	# Unstaged, staged, and untracked all wait for the sync – but a file read as modified only
	# through its attributes, which the sync settles first, is nobody's work
	UNSTAGED=(${(0)"$(git -C "$DIR" diff -z --ignore-submodules=dirty --name-only 2>/dev/null)"})
	_RENORM_ONLY "$DIR" "${AFFECTED[@]}"
	UNSTAGED=("${(@)UNSTAGED:|reply}")
	STAGED=(${(0)"$(git -C "$DIR" diff -z --ignore-submodules=dirty --cached --name-only 2>/dev/null)"})
	UNTRACKED=(${(0)"$(git -C "$DIR" ls-files -z --others --exclude-standard 2>/dev/null)"})
	DIRTY=("${UNSTAGED[@]}" "${STAGED[@]}" "${UNTRACKED[@]}")
	[ ${#DIRTY} -eq 0 ] && return 0

	local A
	for A in "${AFFECTED[@]}"; do
		(( ${DIRTY[(Ie)$A]} )) && BLOCKED+=("$A")
	done
	[ ${#BLOCKED[@]} -eq 0 ] && return 0

	PRINT_ERR "Uncommitted work sits on ${#BLOCKED[@]} path(s) ${ONTO_UPSTREAM:-the upstream} changed since the fork, and your checkout is halfway through $WHAT, so no sync can bring it along – nothing was changed"
	ECHO_E "\e[0;31m  Finish or abort $(_LIT "$WHAT") first – or commit the work, if it is yours:\e[0m" >&2
	# Each with its own next step – a stash would take every session's work in the shared checkout,
	# and the work on a path may be another session's, which only it can commit
	# Paths from the top, which `--commit` reads from where it runs
	local KIND AT
	_AT_TOP "$DIR"
	AT=$REPLY
	for A in "${(@u)BLOCKED}"; do
		if (( ${UNTRACKED[(Ie)$A]} )); then KIND=untracked
		elif (( ${STAGED[(Ie)$A]} )); then KIND=staged
		else KIND=modified; fi
		print -r -- "${A//$'\n'/^J} ($KIND) – yours: $AT$(_PATHS_CMD --plain "git edit --commit --text '<subject>'" "$A"); another session's: wait for it to commit"
	done | _CARET_LINES | LC_ALL=C sed "/./!d;s/^/${_RED}  /;s/\$/${_OFF}/" >&2
	ECHO_E "\e[0;31m  Then run it again: $(_LIT "git edit --onto=$(_SHQ "${ONTO_UPSTREAM:-<upstream>}")")\e[0m" >&2
	exit 1
}

# Brings the caller's checkout along after the branch it is on was replanted, as after any landing
# – leaving a replant behind makes every commit the upstream gained read as a local deletion
_SYNC_ONTO_CHECKOUT () {
	# Args: <checkout> <from> <to> [<branch ref>]
	[ -n "$_IN_LANDED_STEP" ] || { _LANDED_STEP "$0" "$@"; return; }
	local DIR=$1
	local FROM=$2
	local TO=$3
	[ -z "$DIR" ] || [ ! -d "$DIR" ] && return 0
	if [ -n "$4" ] && [ "$(git -C "$DIR" symbolic-ref -q HEAD 2>/dev/null)" != "$4" ]; then
		PRINT_TEXT "%s – left as it is." 32 "The checkout holds another branch"
		return 0
	fi
	_SAME_TREE "$FROM" "$TO" && { PRINT_TEXT "%s" 32 "Branch replanted – tip tree unchanged, your checkout is already current."; return 0; }
	_RECONCILE_CHECKOUT "$DIR" "$FROM" "$TO" "Branch replanted – your checkout still holds the pre-replant content of:" \
		"Branch replanted – index re-synced, your checkout is current."
}

# Prints what the replant or land produced, so the caller doesn't reach for `git log` next
_PRINT_ONTO_SUMMARY () {
	# Args: <upstream> <new tip> [<commits replayed>] [<worktree of a resumed replay>]
	[ -n "$_IN_LANDED_STEP" ] || { _LANDED_STEP "$0" "$@"; return; }
	local UPSTREAM=$1
	local NEW_HEAD=$2
	local EXPECTED=$3
	local LANDED=$(git rev-list --count "$UPSTREAM..$NEW_HEAD" 2>/dev/null) MADE=""
	# Commits the caller made at a resumed replay's stops, which no pick rebuilt, counted apart from
	# the picks – by the replay's record, else by what lands past the picks expected
	if [ -n "$4" ] && [ -n "$EXPECTED" ] && [ -n "$LANDED" ]; then
		local -a REBUILT LEFT_OUT
		local -A PAIRED CHAIN
		local -i N=0
		local R
		_PAIR_REPLAYED "$4" "$UPSTREAM" "$NEW_HEAD"
		if (( ${#PAIRED} )); then
			for R in "${REBUILT[@]}"; do (( ${+PAIRED[$R]} )) || N+=1; done
		else
			N=$(( LANDED > EXPECTED ? LANDED - EXPECTED : 0 ))
		fi
		(( N )) && LANDED=$(( LANDED - N )) MADE=", and $N commit(s) made in its pause"
	fi
	local END=.
	[ "${LANDED:-0}" != 0 ] || [ -n "$MADE" ] && END=:
	if [ -n "$LAND_FROM" ]; then
		PRINT_TEXT "Landed %s of %s commit(s) from %s onto %s%s%s" 32 "${LANDED:-0}" "$EXPECTED" "$LAND_FROM" "$ONTO_UPSTREAM" "$MADE" "$END"
	elif [ -n "$EXPECTED" ]; then
		PRINT_TEXT "Replanted %s of %s commit(s) onto %s%s%s" 32 "${LANDED:-0}" "$EXPECTED" "$ONTO_UPSTREAM" "$MADE" "$END"
	else
		PRINT_TEXT "Replanted %s commit(s) onto %s%s" 32 "${LANDED:-0}" "$ONTO_UPSTREAM" "$END"
	fi
	git log --reverse --format='  %h %s' "$UPSTREAM..$NEW_HEAD" 2>/dev/null | head -12 | _CARET_LINES | \
		LC_ALL=C sed "/./!d;s/^/${_DIM}/;s/\$/${_OFF}/"
	if [ -n "$LAND_FROM" ] && (( ${#_LAND_CAUGHT} )); then
		PRINT_TEXT "%s commit(s) left out as %s's own by a land's record – it holds or held them in another form:" 32 "${#_LAND_CAUGHT}" "$ONTO_UPSTREAM"
		git log --no-walk=unsorted --format='  %h %s' "${(@)_LAND_CAUGHT[1,12]}" 2>/dev/null | _CARET_LINES | \
			LC_ALL=C sed "/./!d;s/^/${_DIM}/;s/\$/${_OFF}/"
	fi
	if [ -n "$LAND_FROM" ] && (( ${#_LAND_GONE} )); then
		PRINT_TEXT "%s commit(s) left out as %s held and dropped them since:" 32 "${#_LAND_GONE}" "$ONTO_UPSTREAM"
		git log --no-walk=unsorted --format='  %h %s' "${(@)_LAND_GONE[1,12]}" 2>/dev/null | _CARET_LINES | \
			LC_ALL=C sed "/./!d;s/^/${_DIM}/;s/\$/${_OFF}/"
	fi

	# A shorter result reads as lost work unless the shortfall is accounted for, and its two
	# causes are not interchangeable – the rebase drops what the upstream already carries,
	# while a skip was the caller's call – so the skips come from the replay's own record, as a
	# patch id tells no copy whose context or resolution changed, and the rest went as already there
	[ -z "$LANDED" ] || [ -z "$EXPECTED" ] || [ "$LANDED" -ge "$EXPECTED" ] && return 0
	local -a LEFT
	[ -n "$4" ] && LEFT=(${(f)"$(_REPLAY_LEFT_OUT "$4" "$UPSTREAM" "$NEW_HEAD")"})
	local -i SKIPPED=${#LEFT} DUPLICATES=$(( EXPECTED - LANDED - ${#LEFT} ))
	if [ "$DUPLICATES" -gt 0 ] && [ -n "$LAND_FROM" ]; then
		PRINT_TEXT "%s commit(s) were dropped as already on %s." 33 "$DUPLICATES" "$ONTO_UPSTREAM"
	elif [ "$DUPLICATES" -gt 0 ]; then
		PRINT_TEXT "%s commit(s) were dropped as already upstream." 33 "$DUPLICATES"
	fi
	if [ "$SKIPPED" -gt 0 ] && [ -n "$LAND_FROM" ]; then
		PRINT_TEXT "%s commit(s) were skipped, or emptied by a resolution – landed nowhere, still on %s alone." 33 "$SKIPPED" "$LAND_FROM"
	elif [ "$SKIPPED" -gt 0 ]; then
		PRINT_TEXT "%s commit(s) were skipped." 33 "$SKIPPED"
	fi
}

# Resumes a paused replant or land in its worktree
_CONTINUE_ONTO () {
	if [ ! -d "$STATE_WORKTREE" ]; then
		PRINT_ERR "Worktree no longer exists: $STATE_WORKTREE"
		_CLEAR_STATE
		exit 1
	fi

	cd "$STATE_WORKTREE" || exit 1
	# Only a worktree this tool made goes – a land's `-C` path is the caller's
	_STATE_WT_OURS && _CLEANUP_HOOK="git worktree remove --force ${(q-)STATE_WORKTREE} 2>/dev/null; rm -rf ${(q-)STATE_WORKTREE}"

	# A replant replays the branch from its tip onto the upstream it named, the tip the CAS moves from
	# – a land, the branch it names, its tip the pause's target, onto the tip the CAS moves from
	# Restored too, what the summary and the skip hint name the base by
	local REBASED=$STATE_ORIG_HEAD BASE=$STATE_TARGET WHAT=replant AGAIN LABEL
	if [ "$STATE_OPERATION" = land ]; then
		REBASED=$STATE_TARGET BASE=$STATE_ORIG_HEAD WHAT=land
		LAND_FROM=${STATE_UPSTREAM:-${STATE_TARGET:0:7}}
		_LAND_CAUGHT=(${=STATE_CAUGHT}) _LAND_GONE=(${=STATE_DROPPED})
		ONTO_UPSTREAM=${STATE_BRANCH#refs/heads/}
		AGAIN="git edit --land=$(_SHQ "$LAND_FROM")"
		LABEL="land $LAND_FROM"
		PRINT_ACTION "Continuing land of %s..." "$STATE_TARGET"
	else
		ONTO_UPSTREAM=${STATE_UPSTREAM:-${STATE_TARGET:0:7}}
		AGAIN="git edit --onto=$(_SHQ "$ONTO_UPSTREAM")"
		LABEL="onto ${STATE_TARGET:0:7}"
		PRINT_ACTION "Continuing replant onto %s..." "$ONTO_UPSTREAM"
	fi

	local GITDIR=$(git rev-parse --git-dir 2>/dev/null)
	if [ ! -d "$GITDIR/rebase-merge" ] && [ ! -d "$GITDIR/rebase-apply" ]; then
		[ "$(git rev-parse HEAD)" = "$REBASED" ] && _REFUSE_HAND_ABORT
		# A replant lands on the upstream it named, a land on the tip it read – a rebase redone by hand
		# onto another base is no finish of either
		if ! git merge-base --is-ancestor "$BASE" HEAD 2>/dev/null; then
			_CLEANUP_HOOK=""
			PRINT_ERR "The rebase finished in $STATE_WORKTREE is not built on $ONTO_UPSTREAM (${BASE:0:7}) – nothing was applied"
			ECHO_E "\e[0;31m  Cancel with 'git edit --abort', then run it again: $(_LIT "$AGAIN")\e[0m" >&2
			exit 1
		fi
		_REQUIRE_REPLAY_DONE "$STATE_WORKTREE"
		_GUARD_HAND_FINISH "$STATE_WORKTREE"
		_NOTE_STOPS_PASSED "$STATE_WORKTREE"
		PRINT_TEXT "%s – applying its result." 33 "${(C)WHAT[1]}${WHAT[2,-1]} already completed in worktree"
	else
		# The rebase in progress is the run's own, from the tip it read onto the base it named – one
		# begun there by hand would land whatever it built
		if [ ! -d "$GITDIR/rebase-merge" ] || [ "$(<"$GITDIR/rebase-merge/orig-head")" != "$REBASED" ] || \
		   [ "$(<"$GITDIR/rebase-merge/onto")" != "$BASE" ]; then
			_CLEANUP_HOOK=""
			PRINT_ERR "The rebase in progress in $STATE_WORKTREE is not this $WHAT's – nothing was applied"
			ECHO_E "\e[0;31m  Cancel with 'git edit --abort', which aborts it too, then run it again: $(_LIT "$AGAIN")\e[0m" >&2
			_PAUSE_EXIT 1 retry
		fi
		_NOTE_STOPS_PASSED "$STATE_WORKTREE"
		_REQUIRE_PICKS_KEPT "$STATE_WORKTREE"
		local CMD
		if [ ${#OPT_SKIP} -gt 0 ]; then
			_NOTE_LET_GO "$STATE_WORKTREE"
			CMD="GIT_SEQUENCE_EDITOR=true GIT_EDITOR=true git -c commit.cleanup=verbatim -c rerere.enabled=true -c rerere.autoUpdate=false -c rebase.updateRefs=false -c advice.mergeConflict=false -c advice.resolveConflict=false $_CAPTURE_PINS rebase --skip"
		else
			_STAGE_MARKS_GONE "$STATE_WORKTREE"
			_GUARD_RESOLUTION_CLEAN "$STATE_WORKTREE"
			_GUARD_STOP_MODES "$STATE_WORKTREE"
			_NOTE_RESOLVED_TREE "$STATE_WORKTREE"
			_NOTE_LET_GO "$STATE_WORKTREE"
			_CLEAR_RESCHEDULED_PICK "$STATE_WORKTREE"
			_RESUME_EDITOR "$STATE_WORKTREE"
			CMD="GIT_SEQUENCE_EDITOR=true GIT_EDITOR=${(q)$(_SH_WORD "$REPLY")} git -c commit.cleanup=verbatim -c rerere.enabled=true -c rerere.autoUpdate=false -c rebase.updateRefs=false -c advice.mergeConflict=false -c advice.resolveConflict=false $_CAPTURE_PINS rebase --continue"
		fi
		PRINT_CMD "$CMD"
		local CONTINUE_OUTPUT RESUME=$CMD
		# Past a stop the skip's replay made, a second skip would drop the commit it stopped at
		[ ${#OPT_SKIP} -gt 0 ] && { _RENORM_RESUME_CMD; RESUME=$REPLY; }
		if ! CONTINUE_OUTPUT=$(_RENORM_EVAL "$STATE_WORKTREE" "$CMD" "$RESUME"); then
			_CLEANUP_HOOK=""
			REBASE_OUT=$CONTINUE_OUTPUT
			_REBASE_RESOLVABLE "$STATE_WORKTREE" "$REBASE_OUT" || _REFUSE_REBASE_FAILED resume
			_PRINT_RESUME_REFUSED "$STATE_WORKTREE" "$CONTINUE_OUTPUT"
			PRINT_TEXT "Worktree: %s" 33 "$STATE_WORKTREE"
			local UNMERGED_LIST=$(_PRINT_CONFLICT_DETAIL "$STATE_WORKTREE" "" "$CONTINUE_OUTPUT")
			_PRINT_ONTO_SKIP_HINT "$STATE_WORKTREE" "$BASE"
			PRINT_TEXT "Or abort the operation: %s" 33 "git edit --abort"
			EMIT_CONFLICT "$STATE_WORKTREE" "$UNMERGED_LIST"
			_PAUSE_EXIT 2 conflict
		fi
	fi

	local NEW_HEAD=$(git rev-parse HEAD)
	# A lost commit a resolution took in is named as taken in, the closer cause
	_GUARD_ABSORBED "$STATE_WORKTREE" "$NEW_HEAD"
	_REQUIRE_PICKS_KEPT "$STATE_WORKTREE"

	# Every commit skipped or emptied – the tip it started from, so nothing to gate, move or journal,
	# and an undo never finds a move from a tip to itself
	if [ "$NEW_HEAD" = "$STATE_ORIG_HEAD" ]; then
		PRINT_TEXT "Nothing %s – every commit was skipped or came out empty, so %s stays at %s." 33 \
			"${${LAND_FROM:+landed}:-replanted}" "${STATE_BRANCH#refs/heads/}" "${NEW_HEAD:0:7}"
		[ -n "$LAND_FROM" ] && _PRINT_LAND_LEFT "$(_LAND_REF_OF "$LAND_FROM")" "$STATE_TARGET" "$NEW_HEAD" "$ONTO_UPSTREAM" "$STATE_WORKTREE" "$BASE" ${=STATE_BELOW}
		_PRINT_ONTO_SUMMARY "$BASE" "$NEW_HEAD" "$STATE_SPAN" "$STATE_WORKTREE"
		_CLEAR_STATE
		PRINT_COMPLETED "$NEW_HEAD" "$STATE_BRANCH" false "nothing ${${LAND_FROM:+landed}:-replanted}"
		return 0
	fi

	_VERIFY_CONFIGURED && _REQUIRE_CURRENT "$STATE_BRANCH" "$STATE_ORIG_HEAD"
	if ! _VERIFY_REWRITE "$STATE_WORKTREE" "$NEW_HEAD" "$STATE_ORIG_HEAD" "" "$BASE"; then
		_CLEANUP_HOOK=""
		EMIT_VERIFY_PAUSED "$_VERIFY_FAILED" "$STATE_WORKTREE" "$NEW_HEAD"
		_PAUSE_EXIT 2 gate
	fi

	local UPDATE_CMD="git update-ref -m ${(q-)${:-git edit: $LABEL$_REFLOG_TAG}} ${(q-)STATE_BRANCH} ${(q-)NEW_HEAD} ${(q-)STATE_ORIG_HEAD}"
	PRINT_CMD "$UPDATE_CMD" 90
	if ! _MOVE_REF "$UPDATE_CMD"; then
		_REFUSE_MOVED_BRANCH "$STATE_BRANCH" "$STATE_WORKTREE"
	fi
	_RECORD_REF_MOVE "$STATE_BRANCH" "$STATE_ORIG_HEAD" "$NEW_HEAD" "$LABEL"
	# A land's checkout follows as any landing's – a replant's is brought along, its uncommitted
	# edits merged onto what landed
	if [ -n "$LAND_FROM" ]; then
		_PRINT_REWRITE_APPLY_HINT "$ONTO_UPSTREAM" "$STATE_ORIG_HEAD" "$NEW_HEAD"
		_PRINT_LAND_LEFT "$(_LAND_REF_OF "$LAND_FROM")" "$STATE_TARGET" "$NEW_HEAD" "$ONTO_UPSTREAM" "$STATE_WORKTREE" "$BASE" ${=STATE_BELOW}
	else
		_SYNC_ONTO_CHECKOUT "$STATE_MAINDIR" "$STATE_ORIG_HEAD" "$NEW_HEAD" "$STATE_BRANCH"
	fi

	_PRINT_ONTO_SUMMARY "$BASE" "$NEW_HEAD" "$STATE_SPAN" "$STATE_WORKTREE"

	_CLEAR_STATE
	PRINT_COMPLETED "$NEW_HEAD" "$STATE_BRANCH" true
}

# Cancels a paused replant or land, removing its worktree unless it is the caller's `-C` path
_ABORT_ONTO () {
	# Labeled as `_CONTINUE_ONTO` journals each
	local WHAT=Replant LABEL="onto ${STATE_TARGET:0:7}"
	if [ "$STATE_OPERATION" = land ]; then
		WHAT=Land LABEL="land ${STATE_UPSTREAM:-${STATE_TARGET:0:7}}"
		PRINT_ACTION "Aborting land of %s..." "$STATE_TARGET"
	else
		PRINT_ACTION "Aborting replant onto %s..." "${STATE_UPSTREAM:-${STATE_TARGET:0:7}}"
	fi

	local LANDED=""
	_ABORT_TAKE_PAUSE "$LABEL"
	if _PAUSE_WT_HERE; then
		_LANDED_RUN git -C "$STATE_WORKTREE" rebase --abort 2>/dev/null
		if _STATE_WT_OURS; then
			local CMD="git worktree remove --force ${(q-)STATE_WORKTREE} 2>/dev/null; rm -rf ${(q-)STATE_WORKTREE}"
			PRINT_CMD "$CMD" 90
			_LANDED_RUN eval "$CMD"
		else
			PRINT_TEXT "%s, your -C path, stays." 33 "$STATE_WORKTREE"
		fi
	fi

	_UNREGISTER_GONE_WORKTREE "$STATE_WORKTREE"
	if [ -n "$LANDED" ]; then
		PRINT_TEXT "The ${(L)WHAT} had landed already, before its run cleared the pause – nothing to take back." 33
	else
		PRINT_TEXT "Branch was never touched – nothing to roll back." 32
	fi
	PRINT_TEXT "%s" 32 "$WHAT aborted, state cleared."
	EMIT_STATUS "$STATE_ORIG_HEAD" "$STATE_BRANCH" false
}

# Resumes a paused reorder or move in its worktree
_CONTINUE_REORDER () {
	if [ ! -d "$STATE_WORKTREE" ]; then
		PRINT_ERR "Worktree no longer exists: $STATE_WORKTREE"
		_CLEAR_STATE
		exit 1
	fi

	cd "$STATE_WORKTREE" || exit 1

	_CLEANUP_HOOK="git worktree remove --force ${(q-)STATE_WORKTREE} 2>/dev/null; rm -rf ${(q-)STATE_WORKTREE}"

	# A placement's pause holds commits the branch never had – what it built on the tip is the
	# result a clean replay reproduces, and the tip it read the one the CAS guards
	local BUILT=${STATE_PLACED:-$STATE_ORIG_HEAD}
	local LABEL=${STATE_PLACE_LABEL:-reorder around ${STATE_TARGET:0:7}}
	PRINT_ACTION "Continuing ${LABEL%% *}${STATE_PLACED:+ placed ${${LABEL#* }%% *}} %s..." "${${STATE_PLACE_LABEL:+${LABEL##* }}:-${STATE_TARGET:0:7}}"

	# If no rebase is in progress but `HEAD` has moved on, the resolution was
	# completed manually in the worktree – apply the result instead of
	# stranding it
	local GITDIR=$(git rev-parse --git-dir 2>/dev/null)
	if [ ! -d "$GITDIR/rebase-merge" ] && [ ! -d "$GITDIR/rebase-apply" ]; then
		# A same order refuses up front, so a reorder back on its tip was aborted by hand
		[ "$(git rev-parse HEAD)" = "$BUILT" ] && _REFUSE_HAND_ABORT
		_REQUIRE_REPLAY_DONE "$STATE_WORKTREE"
		_GUARD_HAND_FINISH "$STATE_WORKTREE"
		_NOTE_STOPS_PASSED "$STATE_WORKTREE"
		PRINT_TEXT "%s – applying its result." 33 "Rebase already completed in worktree"
	else
		# The rebase in progress is the run's own, started from what it built – one begun there by hand
		# would land whatever it built
		if [ ! -d "$GITDIR/rebase-merge" ] || [ "$(<"$GITDIR/rebase-merge/orig-head")" != "$BUILT" ]; then
			_CLEANUP_HOOK=""
			PRINT_ERR "The rebase in progress in $STATE_WORKTREE is not this ${LABEL%% *}'s – nothing was applied"
			ECHO_E "\e[0;31m  Finish or abort it there ('git -C $(_LIT "$(_SHQ "$STATE_WORKTREE")") rebase --abort'), or cancel with 'git edit --abort'.\e[0m" >&2
			_PAUSE_EXIT 1 retry
		fi
		_NOTE_STOPS_PASSED "$STATE_WORKTREE"
		_REQUIRE_PICKS_KEPT "$STATE_WORKTREE"
		_STAGE_MARKS_GONE "$STATE_WORKTREE"
		_GUARD_RESOLUTION_CLEAN "$STATE_WORKTREE"
		_GUARD_STOP_MODES "$STATE_WORKTREE"
		_NOTE_RESOLVED_TREE "$STATE_WORKTREE"
		_NOTE_LET_GO "$STATE_WORKTREE"
		_CLEAR_RESCHEDULED_PICK "$STATE_WORKTREE"
		_RESUME_EDITOR "$STATE_WORKTREE"
		local CMD="GIT_SEQUENCE_EDITOR=true GIT_EDITOR=${(q)$(_SH_WORD "$REPLY")} git -c commit.cleanup=verbatim -c rerere.enabled=true -c rerere.autoUpdate=false -c rebase.updateRefs=false -c advice.mergeConflict=false -c advice.resolveConflict=false $_CAPTURE_PINS rebase --continue"
		PRINT_CMD "$CMD"
		local CONTINUE_OUTPUT
		if ! CONTINUE_OUTPUT=$(_RENORM_EVAL "$STATE_WORKTREE" "$CMD" "$CMD") && \
		   ! { _AUTO_RESOLVE_FINAL_STEP "$STATE_WORKTREE" "$BUILT" && _FINISH_AUTO_RESOLVED_STEP "$STATE_WORKTREE" "${${STATE_PLACED:+built}:-pre-op}" }; then
			_CLEANUP_HOOK=""
			REBASE_OUT=$CONTINUE_OUTPUT
			_REBASE_RESOLVABLE "$STATE_WORKTREE" "$REBASE_OUT" || _REFUSE_REBASE_FAILED resume
			_PRINT_RESUME_REFUSED "$STATE_WORKTREE" "$REBASE_OUT"
			PRINT_TEXT "Worktree: %s" 33 "$STATE_WORKTREE"
			local UNMERGED_LIST=$(_PRINT_CONFLICT_DETAIL "$STATE_WORKTREE" "$BUILT" "$CONTINUE_OUTPUT")
			PRINT_TEXT "Or abort the operation: %s" 33 "git edit --abort"
			EMIT_CONFLICT "$STATE_WORKTREE" "$UNMERGED_LIST"
			_PAUSE_EXIT 2 conflict
		fi
	fi

	local NEW_HEAD=$(git rev-parse HEAD)
	_GUARD_ABSORBED "$STATE_WORKTREE" "$NEW_HEAD"
	_REQUIRE_PICKS_KEPT "$STATE_WORKTREE"

	# A reorder ends on the tree it began with, a placement on the one it built, their commits only
	# moved – a resolution that changed what the tip holds, or a placed commit gone empty, would land
	# something else under their name
	if ! _SAME_TREE "$BUILT" "$NEW_HEAD"; then
		_CLEANUP_HOOK=""
		if [ -n "$STATE_PLACED" ]; then
			PRINT_ERR "The placement no longer ends as it was built – a placed commit went empty, or a resolution changed content – so nothing landed"
			ECHO_E "\e[0;31m  Cancel with 'git edit --abort', then commit it at the tip or beside another anchor.\e[0m" >&2
		else
			PRINT_ERR "The reorder no longer ends on the tree it began with – a resolution changed $(_SHQ ${(f)"$(_TREE_CHANGES "$BUILT" "$NEW_HEAD")"}) – so nothing landed"
			ECHO_E "\e[0;31m  Cancel with 'git edit --abort', remove any rerere record it names as wrong, then reorder again, each resolution keeping what the commits hold.\e[0m" >&2
		fi
		exit 1
	fi

	_VERIFY_CONFIGURED && _REQUIRE_CURRENT "$STATE_BRANCH" "$STATE_ORIG_HEAD"
	if ! _GUARD_TIP_MODES "$STATE_WORKTREE" "$NEW_HEAD" "$BUILT" || ! _VERIFY_REWRITE "$STATE_WORKTREE" "$NEW_HEAD" "$STATE_ORIG_HEAD" "$(_REORDER_CHECKS "$STATE_ORIG_HEAD" "$NEW_HEAD")"; then
		_CLEANUP_HOOK=""
		EMIT_GATE_PAUSED "$STATE_WORKTREE" "$NEW_HEAD"
		_PAUSE_EXIT 2 gate
	fi

	local UPDATE_CMD="git update-ref -m ${(q-)${:-git edit: $LABEL$_REFLOG_TAG}} ${(q-)STATE_BRANCH} ${(q-)NEW_HEAD} ${(q-)STATE_ORIG_HEAD}"
	PRINT_CMD "$UPDATE_CMD" 90
	if ! _MOVE_REF "$UPDATE_CMD"; then
		_REFUSE_MOVED_BRANCH "$STATE_BRANCH" "$STATE_WORKTREE"
	fi
	_RECORD_REF_MOVE "$STATE_BRANCH" "$STATE_ORIG_HEAD" "$NEW_HEAD" "$LABEL"
	# A placement leaves the checkout behind as any rewrite does
	_SAME_TREE "$STATE_ORIG_HEAD" "$NEW_HEAD" || _PRINT_REWRITE_APPLY_HINT "${STATE_BRANCH#refs/heads/}" "$STATE_ORIG_HEAD" "$NEW_HEAD"

	_PRINT_REORDER_SUMMARY "$BUILT" "$NEW_HEAD"

	_CLEAR_STATE
	PRINT_COMPLETED "$NEW_HEAD" "$STATE_BRANCH" true
}

# Resumes a paused drop or squash like `_CONTINUE_REORDER` – the rebase lives in an isolated
# worktree and the branch moves only at the final CAS, so a pause costs nothing and can recur
_CONTINUE_REBASE () {
	if [ ! -d "$STATE_WORKTREE" ]; then
		PRINT_ERR "Worktree no longer exists: $STATE_WORKTREE"
		_CLEAR_STATE
		exit 1
	fi

	cd "$STATE_WORKTREE" || exit 1

	# Only a worktree this tool made goes – a `-C` path the caller named is theirs
	_STATE_WT_OURS && _CLEANUP_HOOK="git worktree remove --force ${(q-)STATE_WORKTREE} 2>/dev/null; rm -rf ${(q-)STATE_WORKTREE}"

	PRINT_ACTION "Continuing $STATE_ACTION of %s..." "${STATE_TARGET:0:7}"

	local GITDIR=$(git rev-parse --git-dir 2>/dev/null)
	# Every squash member a side, as one applied past the stop brings lines of its own
	local -a MEMBERS=()
	[ "$STATE_ACTION" = squash ] && MEMBERS=(${=STATE_TARGETS})
	if [ ! -d "$GITDIR/rebase-merge" ] && [ ! -d "$GITDIR/rebase-apply" ]; then
		# A resolution finished by hand in the worktree leaves no rebase in progress – apply its
		# result rather than stranding it
		[ "$(git rev-parse HEAD)" = "$STATE_ORIG_HEAD" ] && _REFUSE_HAND_ABORT
		_REQUIRE_REPLAY_DONE "$STATE_WORKTREE"
		_GUARD_HAND_FINISH "$STATE_WORKTREE" "${MEMBERS[@]}"
		_NOTE_STOPS_PASSED "$STATE_WORKTREE"
		PRINT_TEXT "%s – applying its result." 33 "Rebase already completed in worktree"
	else
		# The rebase in progress is the run's own, started from the tip it read – one begun there by
		# hand would land whatever it built
		if [ ! -d "$GITDIR/rebase-merge" ] || [ "$(<"$GITDIR/rebase-merge/orig-head")" != "$STATE_ORIG_HEAD" ]; then
			_CLEANUP_HOOK=""
			PRINT_ERR "The rebase in progress in $STATE_WORKTREE is not this $STATE_ACTION's – nothing was applied"
			ECHO_E "\e[0;31m  Finish or abort it there ('git -C $(_LIT "$(_SHQ "$STATE_WORKTREE")") rebase --abort'), or cancel with 'git edit --abort'.\e[0m" >&2
			_PAUSE_EXIT 1 retry
		fi
		_NOTE_STOPS_PASSED "$STATE_WORKTREE" "${MEMBERS[@]}"
		_REQUIRE_PICKS_KEPT "$STATE_WORKTREE"
		_STAGE_MARKS_GONE "$STATE_WORKTREE"
		_GUARD_RESOLUTION_CLEAN "$STATE_WORKTREE"
		_GUARD_STOP_MODES "$STATE_WORKTREE"
		_NOTE_RESOLVED_TREE "$STATE_WORKTREE"
		_NOTE_LET_GO "$STATE_WORKTREE"
		_CLEAR_RESCHEDULED_PICK "$STATE_WORKTREE"
		# `-m`'s editor where there is a terminal for it – without one the fold takes the message git
		# combines, as a plain squash would
		local EDITOR_MODE=""
		if [ "$STATE_MESSAGE" = editor ]; then
			# The comment character the run's template took, terminal or not
			_SQUASH_MSG_STYLE ${=STATE_TARGETS} || { _CLEANUP_HOOK=""; _PAUSE_EXIT 1 retry; }
			if _IS_NON_INTERACTIVE; then
				PRINT_TEXT "No terminal for -m's editor – the squash takes the message git combines; reword it after with %s" 33 "git edit -M"
			else
				EDITOR_MODE=real
			fi
		fi
		ACTION=$STATE_ACTION
		_REBASE_CONTINUE_CMD --continue "$(_TEXT_MSG_PATH)" "$EDITOR_MODE"
		# Taken before any print, which reuses `REPLY`
		local CONT=$REPLY
		PRINT_CMD "git rebase --continue"
		_REBASE_DRIVE "$CONT" "$(_TEXT_MSG_PATH)" "$EDITOR_MODE"
		case $? in
			0) ;;
			2)
				_CLEANUP_HOOK=""
				_PRINT_RESUME_REFUSED "$STATE_WORKTREE" "$REBASE_OUT"
				PRINT_TEXT "Worktree: %s" 33 "$STATE_WORKTREE"
				local UNMERGED_LIST=$(_PRINT_CONFLICT_DETAIL "$STATE_WORKTREE" "" "$REBASE_OUT")
				PRINT_TEXT "Or abort the operation: %s" 33 "git edit --abort"
				EMIT_CONFLICT "$STATE_WORKTREE" "$UNMERGED_LIST"
				_PAUSE_EXIT 2 conflict ;;
			*)
				_CLEANUP_HOOK=""
				PRINT_ERR "The rebase stopped without a conflict to resolve: $(_REBASE_STOPPED)"
				_PRINT_CONFLICT_DETAIL "$STATE_WORKTREE" "" "$REBASE_OUT" >/dev/null
				PRINT_TEXT "Retry with %s, or abort the operation: %s" 33 "git edit --continue" "git edit --abort"
				_PAUSE_EXIT 1 retry ;;
		esac
	fi

	_GUARD_ABSORBED "$STATE_WORKTREE" "$(git rev-parse HEAD)"
	_REQUIRE_PICKS_KEPT "$STATE_WORKTREE"
	_LAND_REBASE "$STATE_WORKTREE" "$STATE_BRANCH" "$STATE_ORIG_HEAD" "$STATE_ACTION" "$STATE_TARGET" "$STATE_SQUASH_TARGET" ${=STATE_TARGETS}
	_CLEAR_STATE
	PRINT_COMPLETED "$(git rev-parse "$STATE_BRANCH")" "$STATE_BRANCH" true
}

# Cancels a paused drop or squash, removing its worktree unless it is the caller's `-C` path
_ABORT_REBASE () {
	PRINT_ACTION "Aborting $STATE_ACTION of %s..." "${STATE_TARGET:0:7}"
	local LANDED=""
	_ABORT_TAKE_PAUSE "$STATE_ACTION ${STATE_TARGET:0:7}"

	if _PAUSE_WT_HERE; then
		_LANDED_RUN git -C "$STATE_WORKTREE" rebase --abort 2>/dev/null
		if _STATE_WT_OURS; then
			local CMD="git worktree remove --force ${(q-)STATE_WORKTREE} 2>/dev/null; rm -rf ${(q-)STATE_WORKTREE}"
			PRINT_CMD "$CMD" 90
			_LANDED_RUN eval "$CMD"
		else
			PRINT_TEXT "%s, your -C path, stays." 33 "$STATE_WORKTREE"
		fi
	fi

	_UNREGISTER_GONE_WORKTREE "$STATE_WORKTREE"
	if [ -n "$LANDED" ]; then
		PRINT_TEXT "The %s had landed already, before its run cleared the pause – nothing to take back." 33 "$STATE_ACTION"
	else
		PRINT_TEXT "Branch was never touched – nothing to roll back." 32
	fi
	PRINT_TEXT "%s" 32 "Operation aborted, state cleared."
	EMIT_STATUS "$STATE_ORIG_HEAD" "$STATE_BRANCH" false
}

# Reconciles what edit mode left behind – it authors in an isolated worktree, so an apply
# leaves the branch's checkout on the pre-edit content, its index holding that as a staged
# revert a later commit would carry – the index re-synced where nothing else touched it, the
# paths named either way, since a blanket reset takes unrelated WIP
_PRINT_EDIT_RECONCILE_HINT () {
	# Args: <main checkout> <base> <new head>
	[ -n "$_IN_LANDED_STEP" ] || { _LANDED_STEP "$0" "$@"; return; }
	local CO=$(_BRANCH_CHECKOUT "$STATE_BRANCH")
	[ -z "$CO" ] && CO=$1
	if [ -z "$CO" ] || [ ! -d "$CO" ]; then
		return 0
	fi
	_RECONCILE_CHECKOUT "$CO" "$2" "$3" "Your checkout still holds the pre-edit content of:" ""
}

# Replays the edited target's descendants onto the amended commit, from the branch's current
# tip – re-read here so commits that landed after the pause are carried, not dropped
# Pauses on conflict, returns on success with the worktree `HEAD` at the replayed tip
_EDIT_START_REPLAY () {
	local TIP=$(git rev-parse "$STATE_BRANCH")
	# A merge that landed meanwhile has no place in a linear replay, which would flatten it
	if [ -n "$(git rev-list --merges "$STATE_TARGET..$TIP" 2>/dev/null)" ]; then
		_CLEANUP_HOOK=""
		PRINT_ERR "A merge reached ${STATE_BRANCH#refs/heads/} during the edit – replaying would flatten it, so nothing was applied"
		ECHO_E "\e[0;31m  The edit stays in $(_LIT "$STATE_WORKTREE") – 'git edit --abort', then edit the commit again.\e[0m" >&2
		_PAUSE_EXIT 1 retry
	fi
	# Before the save, which carries the rerere baseline only once the scope holds one
	_RERERE_SCOPE_BEGIN
	_SAVE_STATE "operation=edit" "worktree=$STATE_WORKTREE" "wt_ours=$STATE_WT_OURS" "branch=$STATE_BRANCH" \
		"orig_head=$STATE_ORIG_HEAD" "target=$STATE_TARGET" "amended=$STATE_AMENDED" "replay_tip=$TIP" \
		"maindir=$STATE_MAINDIR" "message=$STATE_MESSAGE"
	STATE_REPLAY_TIP=$TIP
	if [ "$TIP" = "$STATE_TARGET" ]; then
		# Target is the tip itself – the amended commit is the whole result
		git checkout -q "$STATE_AMENDED" 2>/dev/null
		return 0
	fi
	# `--empty=drop`, as the run's `--exec` capture step makes the rebase interactive, whose own
	# default would stop at a commit the edit emptied
	local CMD="GIT_SEQUENCE_EDITOR=true GIT_EDITOR=true git -c commit.cleanup=verbatim -c rerere.enabled=true -c rerere.autoUpdate=false -c rebase.updateRefs=false -c advice.mergeConflict=false -c advice.resolveConflict=false -c rebase.instructionFormat= $_CAPTURE_PINS rebase $_CAPTURE_EXEC --empty=drop --onto $STATE_AMENDED $STATE_TARGET $TIP"
	PRINT_CMD "git rebase --onto ${STATE_AMENDED:0:7} ${STATE_TARGET:0:7} ${TIP:0:7}" 90
	_RENORM_RESUME_CMD
	if ! REBASE_OUT=$(_RENORM_EVAL "$STATE_WORKTREE" "$CMD" "$REPLY"); then
		_CLEANUP_HOOK=""
		# A hook's veto or a failed signature – the pause, the amend in it, stays for a retry
		_REBASE_RESOLVABLE "$STATE_WORKTREE" "$REBASE_OUT" || _REFUSE_REBASE_FAILED resume
		PRINT_ERR "Conflict while replaying descendants – resolve in worktree, then 'git edit --continue'"
		PRINT_TEXT "Worktree: %s" 33 "$STATE_WORKTREE"
		local UNMERGED_LIST=$(_PRINT_CONFLICT_DETAIL "$STATE_WORKTREE")
		PRINT_TEXT "Or abort the operation: %s" 33 "git edit --abort"
		EMIT_CONFLICT "$STATE_WORKTREE" "$UNMERGED_LIST"
		_PAUSE_EXIT 2 conflict
	fi
}

# Tells a pause whose run landed it but was cut off before clearing it – the journal's newest move
# of the branch goes from a tip the pause read onto exactly what its worktree built, under the
# pause's own label and caller, which a branch reset there by hand never shows
# Never a tip still holding the paused commit, where the run rewrites it – a peer's drop of all
# above it lands on the very commit an edit's worktree sits at while authoring
_PAUSE_LANDED () {
	# Args: <label the landing journals, as `edit <sha>`> [gone – the pause ended already, its
	# worktree the resume's to remove, so the tip's journal entry alone tells]
	local TIP=$(git rev-parse -q --verify "$STATE_BRANCH" 2>/dev/null) JF=$(_JOURNAL_FILE_PATH) LINE BY
	local -a F
	[ -n "$TIP" ] || return 1
	# A split builds its commits apart from its worktree, which stays at the paused commit
	if [ -z "$2" ] && [ "$STATE_OPERATION" != split ]; then
		[ -d "$STATE_WORKTREE" ] && [ "$TIP" = "$(git -C "$STATE_WORKTREE" rev-parse HEAD 2>/dev/null)" ] || return 1
	fi
	# A reorder may keep its oldest commit where it was, and a replant builds on the one it names –
	# an edit whose stop only added commits keeps it below them, so a tip holding those tells
	if [ "$STATE_OPERATION" = edit ] && [ -n "$STATE_AMENDED" ] && [ "$STATE_AMENDED" != "$STATE_TARGET" ] && \
	   git merge-base --is-ancestor "$STATE_TARGET" "$STATE_AMENDED" 2>/dev/null; then
		git merge-base --is-ancestor "$STATE_AMENDED" "$TIP" 2>/dev/null || return 1
	elif [[ "$STATE_OPERATION" != (reorder|onto) ]]; then
		git merge-base --is-ancestor "$STATE_TARGET" "$TIP" 2>/dev/null && return 1
	fi
	[ -n "$JF" ] && [ -s "$JF" ] || return 1
	for LINE in "${(@Oaf)$(<"$JF")}"; do
		F=(${=${LINE%%$'\t'*}})
		[ "${F[2]}" = "$STATE_BRANCH" ] || continue
		BY=""
		[[ "$LINE" == *$'\t'* ]] && BY=${LINE#*$'\t'}
		# The caller's label is the pause's, or for an unlabeled one the resume's own
		[ "${F[4]}" = "$TIP" ] && [[ "${F[3]}" == ("$STATE_ORIG_HEAD"|"$STATE_REPLAY_TIP") ]] && \
			[ "${(j: :)F[5,-1]}" = "$1" ] && [[ "$BY" == ("$STATE_ACTOR_ID"|"$_ACTOR_ID") ]]
		return
	done
	return 1
}

# Amends the paused commit with what the worktree holds, naming git's reason where it refuses – a
# hook, say – which leaves the pause as it was
_EDIT_AMEND () {
	local ERR
	local -a EMPTY=()
	_PRINT_UNTRACKED_ABSORB "$STATE_WORKTREE"
	git add -A >/dev/null 2>&1
	# An empty commit paused for its message stays empty, never one an edit emptied
	git diff-tree --quiet --root --no-commit-id -r --ignore-submodules=none HEAD 2>/dev/null && \
		git diff-index --cached --quiet --ignore-submodules=none HEAD -- 2>/dev/null && EMPTY=(--allow-empty)
	# The pause ran no rebase, so this is where the hold-back arms – never mid-replay, whose start
	# carried no `--exec` step to save the list the pins would then keep git from delivering
	[ "$_CAPTURE_REWRITES" = "true" ] || _CAPTURE_BEGIN
	if [ -n "$SUBJECT_VALUE" ]; then
		# From a file, as `-m` would end a kept body lacking a last newline in one
		_SUBJECT_REPLACED HEAD "$SUBJECT_VALUE" && _MSG_FILE "$REPLY" && \
			ERR=$(git -c commit.cleanup=verbatim "${_CAPTURE_PIN_ARGS[@]}" commit --amend "${EMPTY[@]}" -F "$REPLY" </dev/null 2>&1 >/dev/null)
	elif [ -n "$TEXT_VALUE" ]; then
		ERR=$(git -c commit.cleanup=verbatim "${_CAPTURE_PIN_ARGS[@]}" commit --amend "${EMPTY[@]}" -m "$TEXT_VALUE" </dev/null 2>&1 >/dev/null)
	elif [ "$STATE_MESSAGE" = editor ] && ! _IS_NON_INTERACTIVE; then
		_RESOLVE_REAL_EDITOR || exit 1
		GIT_EDITOR=${(qq)_REAL_EDITOR} git "${_CAPTURE_PIN_ARGS[@]}" commit --amend "${EMPTY[@]}" </dev/tty >/dev/tty 2>&1
	else
		[ "$STATE_MESSAGE" = editor ] && PRINT_TEXT "No terminal for -m's editor – the message stays; pass %s to replace it" 33 '--text "…"'
		ERR=$(git -c commit.cleanup=verbatim "${_CAPTURE_PIN_ARGS[@]}" commit --amend "${EMPTY[@]}" --no-edit </dev/null 2>&1 >/dev/null)
	fi
	if [ $? -ne 0 ]; then
		_CLEANUP_HOOK=""
		# One the edit emptied, named as that – git's own advice, `--allow-empty` or `git reset HEAD^`,
		# fits no pause
		if (( ! ${#EMPTY} )) && [ "$(git write-tree 2>/dev/null)" = "$(git rev-parse -q --verify "HEAD^^{tree}" 2>/dev/null || git hash-object -t tree /dev/null)" ]; then
			PRINT_ERR "The edit empties ${STATE_TARGET:0:7}, which an amend never lands – nothing was applied"
			ECHO_E "\e[0;31m  To drop the commit: 'git edit --abort', then 'git edit -d ${STATE_TARGET:0:12}' – or leave some of its change in $(_LIT "$STATE_WORKTREE"), then 'git edit --continue'.\e[0m" >&2
			_PAUSE_EXIT 1 edit
		fi
		PRINT_ERR "Amend failed – nothing was applied${ERR:+: ${ERR%%$'\n'*}}"
		[ -n "$ERR" ] && print -r -- "$ERR" | tail -15 | _CARET_LINES --crlf | LC_ALL=C sed "s/^/${_RED}  /;s/\$/${_OFF}/" >&2
		ECHO_E "\e[0;31m  The edit stays in $(_LIT "$STATE_WORKTREE") – fix what refused it, then 'git edit --continue', or 'git edit --abort'.\e[0m" >&2
		_PAUSE_EXIT 1 edit
	fi
	STATE_AMENDED=$(git rev-parse HEAD)
	_CAPTURE_RECORD "$STATE_TARGET" "$STATE_AMENDED"
	PRINT_CMD "git commit --amend -> ${STATE_AMENDED:0:7}" 90
}

# Resumes a paused edit – the phase is re-derived from the worktree itself, authoring with `HEAD`
# still at the target, replaying with a rebase in progress, or applying with the replay done, so a
# crash or an extra `--continue` lands right
_CONTINUE_EDIT () {
	if [ ! -d "$STATE_WORKTREE" ]; then
		PRINT_ERR "Worktree no longer exists: $STATE_WORKTREE"
		_CLEAR_STATE
		exit 1
	fi

	if _PAUSE_LANDED "edit ${STATE_TARGET:0:7}"; then
		PRINT_TEXT "The edit had landed already, its run cut off before clearing the pause – nothing left to do." 33
		if _STATE_WT_OURS; then
			git worktree remove --force "$STATE_WORKTREE" 2>/dev/null
			rm -rf "$STATE_WORKTREE"
		fi
		_CLEAR_STATE || exit 1
		EMIT_STATUS "$(git rev-parse "$STATE_BRANCH")" "$STATE_BRANCH" false
		exit 0
	fi

	cd "$STATE_WORKTREE" || exit 1

	# A branch rewritten below the paused commit no longer holds it – a replay onto its tip would
	# carry the old commits back beside their new copies
	if ! git merge-base --is-ancestor "$STATE_TARGET" "$(git rev-parse "$STATE_BRANCH")" 2>/dev/null; then
		PRINT_ERR "${STATE_BRANCH#refs/heads/} was rewritten under this edit – ${STATE_TARGET:0:7} is no longer in its history"
		ECHO_E "\e[0;31m  Nothing was applied – 'git edit --abort', then edit its counterpart anew.\e[0m" >&2
		_PAUSE_EXIT 1 retry
	fi

	_STATE_WT_OURS && _CLEANUP_HOOK="git worktree remove --force ${(q-)STATE_WORKTREE} 2>/dev/null; rm -rf ${(q-)STATE_WORKTREE}"

	PRINT_ACTION "Continuing edit of %s..." "${STATE_TARGET:0:7}"

	local GITDIR=$(git rev-parse --git-dir 2>/dev/null)
	local HEAD_NOW=$(git rev-parse HEAD)

	# A message goes in with the amend – past it, the reword is a run of its own
	if [ -n "$TEXT_VALUE$SUBJECT_VALUE" ] && [ "$HEAD_NOW" != "$STATE_TARGET" ]; then
		_CLEANUP_HOOK=""
		local MSG_FLAG=--text
		[ -n "$SUBJECT_VALUE" ] && MSG_FLAG=--subject
		PRINT_ERR "$MSG_FLAG takes effect at the amend, which is past – finish the edit, then reword: git edit -M $MSG_FLAG=\"…\" <sha>"
		exit 1
	fi

	if [ -d "$GITDIR/rebase-merge" ] || [ -d "$GITDIR/rebase-apply" ]; then
		# Mid-replay conflict – the run's own replay, onto the amend it recorded from the tip it read,
		# as a rebase begun there by hand would land whatever it built
		if [ -z "$STATE_AMENDED" ] || [ ! -d "$GITDIR/rebase-merge" ] || \
		   [ "$(<"$GITDIR/rebase-merge/onto")" != "$STATE_AMENDED" ] || [ "$(<"$GITDIR/rebase-merge/orig-head")" != "$STATE_REPLAY_TIP" ]; then
			_CLEANUP_HOOK=""
			PRINT_ERR "The rebase in progress in $STATE_WORKTREE is not this edit's replay – nothing was applied"
			ECHO_E "\e[0;31m  Finish or abort it there ('git -C $(_LIT "$(_SHQ "$STATE_WORKTREE")") rebase --abort'), then 'git edit --continue' – or 'git edit --abort'.\e[0m" >&2
			_PAUSE_EXIT 1 retry
		fi
		_NOTE_STOPS_PASSED "$STATE_WORKTREE"
		_REQUIRE_PICKS_KEPT "$STATE_WORKTREE"
		_STAGE_MARKS_GONE "$STATE_WORKTREE"
		_GUARD_RESOLUTION_CLEAN "$STATE_WORKTREE"
		_GUARD_STOP_MODES "$STATE_WORKTREE"
		_NOTE_RESOLVED_TREE "$STATE_WORKTREE"
		_NOTE_LET_GO "$STATE_WORKTREE"
		_CLEAR_RESCHEDULED_PICK "$STATE_WORKTREE"
		_RESUME_EDITOR "$STATE_WORKTREE"
		local CMD="GIT_SEQUENCE_EDITOR=true GIT_EDITOR=${(q)$(_SH_WORD "$REPLY")} git -c commit.cleanup=verbatim -c rerere.enabled=true -c rerere.autoUpdate=false -c rebase.updateRefs=false -c advice.mergeConflict=false -c advice.resolveConflict=false $_CAPTURE_PINS rebase --continue"
		PRINT_CMD "$CMD"
		local CONTINUE_OUTPUT
		if ! CONTINUE_OUTPUT=$(_RENORM_EVAL "$STATE_WORKTREE" "$CMD" "$CMD"); then
			_CLEANUP_HOOK=""
			REBASE_OUT=$CONTINUE_OUTPUT
			_REBASE_RESOLVABLE "$STATE_WORKTREE" "$REBASE_OUT" || _REFUSE_REBASE_FAILED resume
			_PRINT_RESUME_REFUSED "$STATE_WORKTREE" "$CONTINUE_OUTPUT"
			PRINT_TEXT "Worktree: %s" 33 "$STATE_WORKTREE"
			local UNMERGED_LIST=$(_PRINT_CONFLICT_DETAIL "$STATE_WORKTREE" "" "$CONTINUE_OUTPUT")
			PRINT_TEXT "Or abort the operation: %s" 33 "git edit --abort"
			EMIT_CONFLICT "$STATE_WORKTREE" "$UNMERGED_LIST"
			_PAUSE_EXIT 2 conflict
		fi
	elif [ "$HEAD_NOW" = "$STATE_TARGET" ]; then
		# Authoring done – amend the target with whatever changed, a subject it already has changing
		# nothing, as `-M` finds such a message unchanged
		local MSG_NOW NEW_SUBJECT=$SUBJECT_VALUE
		if [ -n "$SUBJECT_VALUE" ] && _SUBJECT_REPLACED HEAD "$SUBJECT_VALUE"; then
			MSG_NOW=$(git log -1 --format='%B%x00' HEAD)
			[ "$REPLY" = "${MSG_NOW%$'\0'}" ] && NEW_SUBJECT=""
		fi
		if [ -z "$(git status --porcelain --untracked-files=normal)" ] && [ -z "$TEXT_VALUE$NEW_SUBJECT" ] && \
		   { [ "$STATE_MESSAGE" != editor ] || _IS_NON_INTERACTIVE; }; then
			_CLEANUP_HOOK=""
			if [ -n "$SUBJECT_VALUE" ]; then
				PRINT_ERR "Nothing to amend – no changes in the worktree, and the commit's subject already reads as --subject gives it"
			else
				PRINT_ERR "Nothing to amend – no changes in the worktree and no --text"
			fi
			ECHO_E "\e[0;31m  Edit files in $(_LIT "$STATE_WORKTREE") (or pass --text \"…\"), then 'git edit --continue' – or 'git edit --abort'.\e[0m" >&2
			_PAUSE_EXIT 1 edit
		fi
		_EDIT_AMEND
		_EDIT_START_REPLAY
	elif [ -n "$STATE_AMENDED" ] && [ "$HEAD_NOW" = "$STATE_AMENDED" ]; then
		# Amend landed but the replay never ran (crash between), or was reset to the amend as the hint
		# says – run it now, unless it was quit by hand at a stop, a resolution still staged, which a
		# fresh replay would only misreport
		if [ -n "$(git status --porcelain --untracked-files=no --ignore-submodules=all)" ]; then
			_CLEANUP_HOOK=""
			PRINT_ERR "The replay after the edit was quit by hand at a stop – nothing was applied"
			ECHO_E "\e[0;31m  Cancel with 'git edit --abort', then edit again.\e[0m" >&2
			_PAUSE_EXIT 1 edit
		fi
		[ "$_CAPTURE_REWRITES" = "true" ] || _CAPTURE_BEGIN
		_EDIT_START_REPLAY
	elif [ -n "$STATE_AMENDED" ] && git merge-base --is-ancestor "$STATE_AMENDED" HEAD 2>/dev/null; then
		# The replay finished, possibly by hand – apply what it built, all of it committed, as a
		# restore or a replay below would take the rest
		_REQUIRE_REPLAY_DONE "$STATE_WORKTREE"
		_GUARD_HAND_FINISH "$STATE_WORKTREE"
		_NOTE_STOPS_PASSED "$STATE_WORKTREE"
		if [ -n "$(git status --porcelain --untracked-files=no --ignore-submodules=all)" ]; then
			_CLEANUP_HOOK=""
			PRINT_ERR "The worktree carries uncommitted edits past the finished replay, which would never land"
			ECHO_E "\e[0;31m  Commit or discard them in $(_LIT "$STATE_WORKTREE"), then 'git edit --continue' – or 'git edit --abort'.\e[0m" >&2
			_PAUSE_EXIT 1 edit
		fi
	elif [ -z "$STATE_AMENDED" ] && _EDIT_COMMITTED_AT_STOP "$HEAD_NOW"; then
		# Commits made by hand at the stop – an amend of the paused commit, or ones on top of it –
		# stand in for it, and what followed it replays onto them as for an amend of the tool's own
		# A submodule's own edits never land, while a gitlink moved there and left uncommitted would not
		if [ -n "$(git status --porcelain --untracked-files=no --ignore-submodules=dirty)" ]; then
			_CLEANUP_HOOK=""
			PRINT_ERR "Commits were made at the stop, with changes beside them still uncommitted"
			ECHO_E "\e[0;31m  Commit or discard them in $(_LIT "$STATE_WORKTREE"), then 'git edit --continue'.\e[0m" >&2
			_PAUSE_EXIT 1 edit
		fi
		STATE_AMENDED=$HEAD_NOW
		[ "$_CAPTURE_REWRITES" = "true" ] || _CAPTURE_BEGIN
		_CAPTURE_RECORD "$STATE_TARGET" "$STATE_AMENDED"
		_EDIT_START_REPLAY
	else
		# Anything else – a reset elsewhere, the paused commit dropped – lands nothing, while a
		# replay aborted by hand is back on the tip it began from, the amend kept in the pause, which
		# a reset to it resumes from
		_CLEANUP_HOOK=""
		if _PAUSE_HAND_ABORTED; then
			PRINT_ERR "The edit's replay in $STATE_WORKTREE was aborted by hand – nothing was applied"
		elif git merge-base --is-ancestor "$STATE_TARGET" "$HEAD_NOW" 2>/dev/null; then
			PRINT_ERR "The edit's worktree was reset to ${HEAD_NOW:0:7}, which holds commits that followed ${STATE_TARGET:0:7} on the branch, none made at its stop – nothing was applied"
		else
			PRINT_ERR "The edit's worktree no longer builds on ${STATE_TARGET:0:7} or its parent – nothing was applied"
		fi
		ECHO_E "\e[0;31m  Reset it there ('git -C $(_LIT "$(_SHQ "$STATE_WORKTREE")") reset --hard ${${STATE_AMENDED:-$STATE_TARGET}:0:12}'), then 'git edit --continue' – or 'git edit --abort'.\e[0m" >&2
		_PAUSE_EXIT 1 edit
	fi

	_REQUIRE_PICKS_KEPT "$STATE_WORKTREE"
	local NEW_HEAD=$(git rev-parse HEAD)
	local BASE=${STATE_REPLAY_TIP:-$STATE_ORIG_HEAD}
	# A commit that landed on the branch during the replay would be dropped by
	# a blind apply – redo the replay onto the fresh tip instead
	if [ "$(git rev-parse "$STATE_BRANCH")" != "$BASE" ]; then
		# From the amend again, so commits made on the finished replay by hand would be lost there
		local -a EXTRA
		_EDIT_HAND_COMMITS "$NEW_HEAD"
		if (( ${#EXTRA} )); then
			_CLEANUP_HOOK=""
			PRINT_ERR "${STATE_BRANCH#refs/heads/} moved, and a replay onto it would drop the commits made on the edit by hand – nothing was applied"
			git log --no-walk=unsorted --format='%h %s' "${EXTRA[@]}" 2>/dev/null | _CARET_LINES | LC_ALL=C sed "s/^/${_RED}  /;s/\$/${_OFF}/" >&2
			ECHO_E "\e[0;31m  Land the edit without them ('git -C $(_LIT "$(_SHQ "$STATE_WORKTREE")") reset --hard <last replayed commit>', then 'git edit --continue'), and add them after – or 'git edit --abort'.\e[0m" >&2
			_PAUSE_EXIT 1 retry
		fi
		PRINT_TEXT "Branch moved during the edit – replaying onto its current tip." 33
		_EDIT_START_REPLAY
		NEW_HEAD=$(git rev-parse HEAD)
		BASE=$STATE_REPLAY_TIP
	fi
	# A result that is the tip itself moves nothing – journaled, an undo would take back no move
	if [ "$NEW_HEAD" = "$BASE" ]; then
		_CLEANUP_HOOK=""
		PRINT_ERR "The edit's result is ${STATE_BRANCH#refs/heads/}'s tip ${BASE:0:7} itself, so it changes nothing – nothing was applied"
		ECHO_E "\e[0;31m  Clear the pause with 'git edit --abort'.\e[0m" >&2
		_PAUSE_EXIT 1 retry
	fi
	_GUARD_ABSORBED "$STATE_WORKTREE" "$NEW_HEAD"

	# The pause's own flips are meant – the amended commit against the one it replaced
	_VERIFY_CONFIGURED && _REQUIRE_CURRENT "$STATE_BRANCH" "$BASE"
	if ! _GUARD_TIP_MODES "$STATE_WORKTREE" "$NEW_HEAD" "$BASE" "$(_MODE_LINES "$STATE_WORKTREE" "$STATE_TARGET" "$STATE_AMENDED")" || ! _VERIFY_REWRITE "$STATE_WORKTREE" "$NEW_HEAD" "$STATE_ORIG_HEAD" "$STATE_AMENDED"; then
		_CLEANUP_HOOK=""
		EMIT_GATE_PAUSED "$STATE_WORKTREE" "$NEW_HEAD"
		_PAUSE_EXIT 2 gate
	fi

	local UPDATE_CMD="git update-ref -m ${(q-)${:-git edit: edit ${STATE_TARGET:0:7}$_REFLOG_TAG}} ${(q-)STATE_BRANCH} ${(q-)NEW_HEAD} ${(q-)BASE}"
	PRINT_CMD "$UPDATE_CMD" 90
	if ! _MOVE_REF "$UPDATE_CMD"; then
		_CLEANUP_HOOK=""
		PRINT_ERR "Branch '$STATE_BRANCH' moved during apply – run 'git edit --continue' to replay onto the new tip"
		_PAUSE_EXIT 1 retry
	fi
	_RECORD_REF_MOVE "$STATE_BRANCH" "$BASE" "$NEW_HEAD" "edit ${STATE_TARGET:0:7}"

	# Net history change – pre-answers the "does the result differ by exactly
	# my edit?" verification the caller would otherwise run
	PRINT_TEXT "Net history change (%s -> %s):" 32 "${BASE:0:7}" "${NEW_HEAD:0:7}"
	git --no-pager diff --no-color --stat "$BASE" "$NEW_HEAD" 2>/dev/null | _CARET_LINES | LC_ALL=C sed 's/^/  /'
	_PRINT_MODE_CHANGES "$BASE" "$NEW_HEAD"
	_PRINT_TREE_IDENTITY "$BASE" "$NEW_HEAD"
	# What followed the target against what the replay rebuilt on the amend – commits made at the
	# stop, counted from the merge base, would hide as many it dropped
	_PRINT_DROPPED_COMMITS "$BASE" "$NEW_HEAD" "$STATE_TARGET" "$STATE_AMENDED"
	_PRINT_EDIT_RECONCILE_HINT "$STATE_MAINDIR" "$BASE" "$NEW_HEAD"
	# A `--text` on the continue replaced the whole message at the amend, so name the body
	# lines it did not restate, as a reword does – every line above is a path or a subject
	# The commit the target became is the edited one as landed, the replay having gone onto it – a
	# command naming it only where the tip holds it – while commits made at the stop on top of the
	# target leave it as it was, no message of it replaced
	local EDITED="" AMENDED_AS=$STATE_AMENDED C
	local -a ADDED=()
	if [ -n "$STATE_AMENDED" ]; then
		_EDIT_AMEND_PARTS
		AMENDED_AS=${reply[1]} ADDED=("${(@)reply[2,-1]}")
	fi
	if [ -n "$AMENDED_AS" ]; then
		git merge-base --is-ancestor "$AMENDED_AS" "$NEW_HEAD" 2>/dev/null && EDITED=$AMENDED_AS
		_PRINT_LOST_BODY "The replaced message" "$STATE_TARGET" "$(git log -1 --format='%B' "$AMENDED_AS" 2>/dev/null)" "$EDITED"
		if [ -n "$SUBJECT_VALUE" ]; then
			_PRINT_SUBJECT_LINES "$STATE_TARGET" "git edit -M --text=\"…\" ${${EDITED:0:12}:-<the edited commit>}"
		fi
	fi
	# A pause outlives the run that opened it, so the name in its trailer is long
	# gone by now – and both blocks above grow with the edit, which would bury a
	# line printed before them – the commit as landed, where the tip holds it, its old subject named
	# above it where the continue replaced that
	_PRINT_TODO early
	if [ -n "$EDITED" ] && [ "$(git log -1 --format=%s "$EDITED" 2>/dev/null)" != "$(git log -1 --format=%s "$STATE_TARGET" 2>/dev/null)" ]; then
		_PRINT_COMMIT_LINE "$STATE_TARGET" '  replaced: %s'
	fi
	if [ -n "$STATE_AMENDED" ] && [ -z "$AMENDED_AS" ]; then
		PRINT_TEXT "%s stays as it was – the commit(s) made at the stop were added after it:" 32 "${STATE_TARGET:0:7}"
	else
		_PRINT_COMMIT_LINE "${EDITED:-$STATE_TARGET}" '  edited: %h %s'
	fi
	for C in "${ADDED[@]}"; do _PRINT_COMMIT_LINE "$C" '  added: %h %s'; done

	_CLEAR_STATE
	PRINT_COMPLETED "$NEW_HEAD" "$STATE_BRANCH" true
}

# Fills `EXTRA` with the commits on an edit's replay that it never built – made there by hand, by
# author, date and subject against what followed the paused commit
_EDIT_HAND_COMMITS () {
	# Args: <worktree HEAD>
	local KEY C
	local -A BUILT
	EXTRA=()
	[ -n "$STATE_AMENDED" ] || return 0
	for KEY in "${(@f)$(git log --format='%an%x1f%ae%x1f%at%x1f%s' "$STATE_TARGET..${STATE_REPLAY_TIP:-$STATE_ORIG_HEAD}" 2>/dev/null)}"; do
		BUILT[$KEY]=1
	done
	for C in ${(f)"$(git rev-list --reverse "$STATE_AMENDED..$1" 2>/dev/null)"}; do
		KEY=$(git log -1 --format='%an%x1f%ae%x1f%at%x1f%s' "$C" 2>/dev/null)
		(( ${+BUILT[$KEY]} )) || EXTRA+=("$C")
	done
}

# Tells whether commits made by hand at an edit's stop stand in for the paused commit – an amend
# of it, or ones on top of it, all on its parent, and for a root, which has none, a worktree
# history that is a single line from one root of its own
# • Never a reset to a commit that followed it on the branch, the old tip say – none made there
_EDIT_COMMITTED_AT_STOP () {
	# Args: <worktree HEAD>
	local MB=$(git merge-base "$1" "$STATE_ORIG_HEAD" 2>/dev/null)
	[ -z "$MB" ] || git merge-base --is-ancestor "$MB" "$STATE_TARGET" 2>/dev/null || return 1
	if git rev-parse -q --verify "$STATE_TARGET^" >/dev/null; then
		[ "$1" != "$(git rev-parse "$STATE_TARGET^")" ] && git merge-base --is-ancestor "$STATE_TARGET^" "$1" 2>/dev/null
	else
		[ -z "$(git rev-list --merges "$1" 2>/dev/null)" ] && [ "$(git rev-list --max-parents=0 "$1" 2>/dev/null | wc -l | tr -d ' ')" = 1 ]
	fi
}

# Fills `reply` with what an edit's `STATE_AMENDED` stands for – the commit the target became, then
# each one added after it at the stop, oldest first – the first empty where commits were only
# added on top of the target, which stays as it was
_EDIT_AMEND_PARTS () {
	local -a CS
	if [ "$STATE_AMENDED" != "$STATE_TARGET" ] && git merge-base --is-ancestor "$STATE_TARGET" "$STATE_AMENDED" 2>/dev/null; then
		reply=("" ${(f)"$(git rev-list --reverse "$STATE_AMENDED" "^$STATE_TARGET" 2>/dev/null)"})
		return 0
	fi
	if git rev-parse -q --verify "$STATE_TARGET^" >/dev/null 2>&1; then
		CS=(${(f)"$(git rev-list --reverse "$STATE_AMENDED" "^$STATE_TARGET^" 2>/dev/null)"})
	else
		CS=(${(f)"$(git rev-list --reverse "$STATE_AMENDED" 2>/dev/null)"})
	fi
	reply=("${CS[1]:-$STATE_AMENDED}" "${(@)CS[2,-1]}")
}

# Cancels a paused edit, removing its worktree unless it is the caller's `-C` path
_ABORT_EDIT () {
	PRINT_ACTION "Aborting edit of %s..." "${STATE_TARGET:0:7}"
	local LANDED=""
	_ABORT_TAKE_PAUSE "edit ${STATE_TARGET:0:7}"

	if _PAUSE_WT_HERE; then
		_LANDED_RUN git -C "$STATE_WORKTREE" rebase --abort 2>/dev/null
		if _STATE_WT_OURS; then
			local CMD="git worktree remove --force ${(q-)STATE_WORKTREE} 2>/dev/null; rm -rf ${(q-)STATE_WORKTREE}"
			PRINT_CMD "$CMD" 90
			_LANDED_RUN eval "$CMD"
		else
			PRINT_TEXT "%s, your -C path, stays." 33 "$STATE_WORKTREE"
		fi
	fi

	_UNREGISTER_GONE_WORKTREE "$STATE_WORKTREE"
	if [ -n "$LANDED" ]; then
		PRINT_TEXT "The edit had landed already, before its run cleared the pause – nothing to take back." 33
	else
		PRINT_TEXT "Branch was never touched – nothing to roll back." 32
	fi
	PRINT_TEXT "%s" 32 "Edit aborted, state cleared."
	EMIT_STATUS "$STATE_ORIG_HEAD" "$STATE_BRANCH" false
}

# Aborts an in-flight `--reorder` – abort the paused rebase and remove the worktree, with
# nothing to roll back since the branch was never moved
_ABORT_REORDER () {
	# A placement pauses as a reorder, under the name its run gave it
	if [ -n "$STATE_PLACE_LABEL" ]; then
		PRINT_ACTION "Aborting ${STATE_PLACE_LABEL%% *} placed ${${STATE_PLACE_LABEL#* }%% *} %s..." "${STATE_PLACE_LABEL##* }"
	else
		PRINT_ACTION "Aborting reorder around %s..." "${STATE_TARGET:0:7}"
	fi

	# Under the label its resume journals
	local LANDED=""
	_ABORT_TAKE_PAUSE "${STATE_PLACE_LABEL:-reorder around ${STATE_TARGET:0:7}}"
	if _PAUSE_WT_HERE; then
		_LANDED_RUN git -C "$STATE_WORKTREE" rebase --abort 2>/dev/null
		local CMD="git worktree remove --force ${(q-)STATE_WORKTREE} 2>/dev/null; rm -rf ${(q-)STATE_WORKTREE}"
		PRINT_CMD "$CMD" 90
		_LANDED_RUN eval "$CMD"
	fi

	_UNREGISTER_GONE_WORKTREE "$STATE_WORKTREE"
	if [ -n "$LANDED" ]; then
		PRINT_TEXT "The %s had landed already, before its run cleared the pause – nothing to take back." 33 "${${STATE_PLACE_LABEL:+placement}:-reorder}"
	else
		PRINT_TEXT "Branch was never touched – nothing to roll back." 32
	fi
	PRINT_TEXT "%s" 32 "${${STATE_PLACE_LABEL:+Placement}:-Reorder} aborted, state cleared."
	EMIT_STATUS "$STATE_ORIG_HEAD" "$STATE_BRANCH" false
}

# Names the state file for in-flight operations, currently `--amend-into` when an autosquash
# hits a conflict the caller must resolve – the file lives in the common git dir, shared
_STATE_FILE_PATH () {
	local DIR=$(git rev-parse --git-common-dir 2>/dev/null)
	[ -z "$DIR" ] && return 1
	case "$DIR" in
		/*) ;;
		*) DIR="$(pwd)/$DIR" ;;
	esac
	print -r -- "$DIR/git-edit-state"
}

# Refuses a pause over <name>s holding a newline, naming them – the pause flow reads names a line
# each – before it is recorded, so nothing landed
_REFUSE_NEWLINE_NAMES () {
	# Args: [--fold <target>] <name>... – `--fold` says a fold's input is kept
	# No plain-git route is named – a fixup and autosquash in the shared checkout refuse its
	# peers' unstaged edits, the fixup left on the branch, and a conflict stops it mid-rebase
	local FOLD="" SRC
	[ "$1" = --fold ] && { FOLD=${2:0:7}; shift 2; }
	local -a NL=("${(@M)@:#*$'\n'*}")
	(( ${#NL} )) || return 0
	PRINT_ERR "A name holding a newline can't be carried across a pause: $(_SOME_PATHS -q "${NL[@]}") – nothing landed"
	if [ -n "$FOLD" ]; then
		SRC=$(_FOLD_SOURCE)
		ECHO_E "\e[0;31m  ${(U)SRC[1]}${SRC[2,-1]} untouched – rename the file.\e[0m" >&2
	fi
	exit 1
}

# Prints <name>s as a pause's state carries a list under a `<key>_q=` – each quoted as `(z)` reads
# it back, so a tab or space in a name survives, where the `<key>=` an older build wrote joins
# them with tabs
_STATE_LIST () {
	# Args: <name>...
	print -r -- "${(j: :)${(q)@}}"
}

# Prints <name>s joined by tabs, as builds before the quoted keys wrote and read them – written ahead of
# the quoted line, so an older copy resuming the pause re-syncs those paths rather than the whole index
_STATE_LIST_TABS () {
	# Args: <name>...
	print -r -- "${(pj:\t:)@}"
}

# Writes the pause's state file, one key a line
_SAVE_STATE () {
	# Args: key=value pairs to persist (one per arg)
	local SF
	SF=$(_STATE_FILE_PATH) || { PRINT_ERR "Not in a git repo"; return 1; }
	local KV REF="" AT="" REPLAYED="" PAUSE_WT="" KEPT=""
	local SAVE_VERIFY_CMD=${VERIFY_VALUE:-$STATE_VERIFY_CMD}
	# One key a line – a value holding a newline, a path's say, would read back as keys of its own
	for KV in "$@"; do
		_REFUSE_NEWLINE_NAMES "${KV#*=}"
		case $KV in
			branch=*)     REF=${KV#*=} ;;
			orig_head=*)  AT=${KV#*=} ;;
			replay_tip=*) REPLAYED=${KV#*=} ;;
			worktree=*)   PAUSE_WT=${KV#*=} ;;
			wt_ours=0)    KEPT=1 ;;
		esac
	done
	local SF_NEW="$SF.$$"
	_TEMP_FILES+=("$SF_NEW")
	{
		# Whose run it is first, which the resume journals under and another caller's refuses – empty
		# for an unlabeled one, and first so a file cut short keeps it: only one from before labels
		# were kept has none
		print -r -- "actor=$_ACTOR"
		# And the label as given, which ownership goes by – one lacking it predates it
		print -r -- "actor_id=$_ACTOR_ID"
		for KV in "$@"; do print -r -- "$KV"; done
		# A mark of this one pause – the same run redone in the same `-C` path writes keys alike, and a
		# resume must still tell its own pause from the one taken after an abort
		zmodload zsh/datetime 2>/dev/null
		print -r -- "nonce=$$.${EPOCHREALTIME:-$SECONDS}"
		# The rerere scope's baseline rides along uninvited – every pause must
		# carry it for the resuming invocation to adopt (see _RERERE_SCOPE_BEGIN)
		if [ -n "$_RERERE_SCOPE_OWNED" ]; then echo "rrpre=$_RERERE_PRE"; fi
		# So do a --verify flag and the span tier – flags don't survive into the
		# resuming invocation, and a continue must re-verify what the original
		# run asked for, not silently less (or, with no standing config, nothing)
		if [ -n "$SAVE_VERIFY_CMD" ]; then print -r -- "verify_cmd=$SAVE_VERIFY_CMD"; fi
		if _VERIFY_SPAN_ON; then echo "verify_span=1"
		elif [ ${#OPT_NO_VERIFY_SPAN} -gt 0 ] || [ "$STATE_VERIFY_SPAN" = "0" ]; then echo "verify_span=0"; fi
		# And a mode change a continue let through – the landing must not refuse what a stop allowed
		if [ "$STATE_ALLOW_MODE_CHANGE" = "1" ]; then echo "allow_mode_change=1"; fi
		# And a rewrite of pushed history the run was allowed, which the resume's landing checks again
		if [ ${#OPT_ALLOW_PUSHED} -gt 0 ] || [ "$STATE_ALLOW_PUSHED" = "1" ]; then echo "allow_pushed=1"; fi
		# And a gate the run declined, and the trees resolvers staged at earlier
		# stops, which the gate checks in the default tier
		if [ ${#OPT_NO_VERIFY} -gt 0 ] || [ "$STATE_NO_VERIFY" = 1 ]; then echo "no_verify=1"; fi
		if [ -n "$STATE_RESOLVED" ]; then print -r -- "resolved=$STATE_RESOLVED"; fi
		# And a held-back rewrite delivery, which the resuming run must re-arm around its saved list
		if [ "$_CAPTURE_REWRITES" = "true" ]; then print -r -- "capture=$_CAPTURE_DIR"; fi
		# And the files a run took whole, whose staging the landing re-syncs to what they folded
		if [ ${#WHOLE_PATHS} -gt 0 ]; then print -r -- "whole=${(j: :)${(q)WHOLE_PATHS[@]}}"; fi
		if [ ${#WHOLE_IDX} -gt 0 ]; then print -r -- "whole_idx=${(j: :)${(@qq)${(@kv)WHOLE_IDX}}}"; fi
	} > "$SF_NEW"
	# Rewrites this run's own pause in place, and claims a free slot by a hard link – an exclusive
	# create where the filesystem has none – so a parallel run's pause taken meanwhile refuses this one
	# Under the journal's lock an abort ends a pause under, so none ends this one between the check
	# and the write, nor clears the slot between its own check and its removal
	_SLOT_LOCK "$SF" "nothing was applied"
	local JF=$REPLY
	# A first run's refusal takes back the replay it left in a `-C` path, for the rerun to reuse
	[ -n "$KEPT" ] && _UNWIND_PATH=$PAUSE_WT
	# No pause for a run whose branch moved off the tip it lands on – an edit's replay onto that
	# tip, the rest onto the one they read – as its resolution could never land
	# Under the lock `_MOVE_REF` looks for a pause under, so a landing and a pause never both pass
	_REQUIRE_CURRENT "$REF" "${REPLAYED:-$AT}"
	if [ -n "$_STATE_OWNED" ]; then
		_REQUIRE_OWN_PAUSE
		mv -f "$SF_NEW" "$SF"
	else
		# A signal held from the claim until the run notes the pause its own – stopped between the
		# two, the exit trap would remove the worktree of a pause left in the slot, one nobody can end
		_IN_WRITE=1
		if ln "$SF_NEW" "$SF" 2>/dev/null || { [ ! -e "$SF" ] && ( setopt noclobber; cat "$SF_NEW" > "$SF" ) 2>/dev/null; }; then
			_STATE_OWNED=$SF
			rm -f "$SF_NEW"
		else
			_IN_WRITE=""
			rm -f "$SF_NEW"
			_REFUSE_PEER_PAUSE "$REF"
		fi
	fi
	_UNWIND_PATH=""
	_STATE_OWNED=$SF
	_STATE_ID=$(_PAUSE_KEYS "$SF")
	[ -n "$JF" ] && _JOURNAL_UNLOCK "$JF"
	[ -n "$_IN_WRITE" ] && _RELEASE_HELD_SIGNAL
	# Notes the file held went with the rewrite – a later one is written again, not taken as there
	STATE_VERIFY_FAILED="" STATE_VERIFY_RESULT="" STATE_MODE_STRAY="" STATE_STOP_HEAD="" STATE_TODO_LEFT=""
	STATE_STOPS="" STATE_REPLAY="" STATE_SKIPPED="" STATE_FLAG_SKIPS="" STATE_MARKED=""
}

_LOAD_STATE () {
	local SF=$(_STATE_FILE_PATH)
	# Kept for the clear, which a run removing its worktree first could no longer resolve
	_STATE_PATH=$SF
	if [ -z "$SF" ] || [ ! -f "$SF" ]; then
		PRINT_ERR "No in-flight git-edit operation to continue or abort"
		exit 1
	fi
	STATE_OPERATION=""
	STATE_ACTION=""
	STATE_WORKTREE=""
	STATE_BRANCH=""
	STATE_ORIG_HEAD=""
	STATE_TARGET=""
	STATE_HEAD_WITH_FIXUP=""
	STATE_FIXUP=""
	STATE_WT_OURS=""
	STATE_DEPTH=""
	STATE_REBASEBASE=""
	STATE_STAGEDTREE=""
	STATE_FOLD=""
	STATE_MAINDIR=""
	STATE_FILES=""
	STATE_PATHSPECS=""
	STATE_TREE=""
	STATE_AMENDED=""
	STATE_REPLAY_TIP=""
	STATE_UPSTREAM=""
	STATE_SPAN=""
	STATE_FORK=""
	STATE_RRPRE=""
	STATE_RRPRE_SET=""
	STATE_VERIFY_FAILED=""
	STATE_VERIFY_RESULT=""
	STATE_VERIFY_CMD=""
	STATE_VERIFY_SPAN=""
	STATE_CAPTURE=""
	STATE_CAUGHT=""
	STATE_DROPPED=""
	STATE_BELOW=""
	STATE_TARGETS=""
	STATE_ALLOW_MODE_CHANGE=""
	STATE_ALLOW_PUSHED=""
	STATE_MODE_STRAY=""
	STATE_RESOLVED=""
	STATE_SQUASH_TARGET=""
	STATE_MESSAGE=""
	STATE_NO_VERIFY=""
	STATE_ACTOR=""
	STATE_ACTOR_ID=""
	STATE_ACTOR_SET=""
	local ID_SET=""
	STATE_STOP_HEAD=""
	STATE_STOPS=""
	STATE_MARKED=""
	STATE_REPLAY=""
	STATE_TODO_LEFT=""
	STATE_SKIPPED=""
	STATE_FLAG_SKIPS=""
	STATE_PLACED=""
	STATE_PLACE_LABEL=""
	# One read, kept – a resume holding the pause's worktree only after it tells by it whether another
	# run took the pause on meanwhile
	_STATE_READ=""
	{ _STATE_READ=$(<"$SF") } 2>/dev/null
	local KEY VAL
	while IFS='=' read -r KEY VAL; do
		case "$KEY" in
			operation)       STATE_OPERATION=$VAL ;;
			action)          STATE_ACTION=$VAL ;;
			worktree)        STATE_WORKTREE=$VAL ;;
			branch)          STATE_BRANCH=$VAL ;;
			orig_head)       STATE_ORIG_HEAD=$VAL ;;
			target)          STATE_TARGET=$VAL ;;
			head_with_fixup) STATE_HEAD_WITH_FIXUP=$VAL ;;
			fixup)           STATE_FIXUP=$VAL ;;
			wt_ours)         STATE_WT_OURS=$VAL ;;
			depth)           STATE_DEPTH=$VAL ;;
			rebasebase)      STATE_REBASEBASE=$VAL ;;
			stagedtree)      STATE_STAGEDTREE=$VAL ;;
			fold)            STATE_FOLD=$VAL ;;
			maindir)         STATE_MAINDIR=$VAL ;;
			# Lists held quoted, as `_STATE_LIST` writes them – one an older build joined
			# by tabs is quoted on the way in
			files_q)         STATE_FILES=$VAL ;;
			files)           STATE_FILES=${VAL:+$(_STATE_LIST "${(@ps:\t:)VAL}")} ;;
			whole)           WHOLE_PATHS=("${(@Q)${(z)VAL}}") ;;
			whole_idx)       WHOLE_IDX=("${(@Q)${(z)VAL}}") ;;
			pathspecs_q)     STATE_PATHSPECS=$VAL ;;
			pathspecs)       STATE_PATHSPECS=${VAL:+$(_STATE_LIST "${(@ps:\t:)VAL}")} ;;
			tree)            STATE_TREE=$VAL ;;
			amended)         STATE_AMENDED=$VAL ;;
			replay_tip)      STATE_REPLAY_TIP=$VAL ;;
			upstream)        STATE_UPSTREAM=$VAL ;;
			span)            STATE_SPAN=$VAL ;;
			fork)            STATE_FORK=$VAL ;;
			rrpre)           STATE_RRPRE=$VAL; STATE_RRPRE_SET=1 ;;
			verify_failed)   STATE_VERIFY_FAILED=$VAL ;;
			verify_result)   STATE_VERIFY_RESULT=$VAL ;;
			verify_cmd)      STATE_VERIFY_CMD=$VAL ;;
			verify_span)     STATE_VERIFY_SPAN=$VAL ;;
			capture)         STATE_CAPTURE=$VAL ;;
			caught)          STATE_CAUGHT=$VAL ;;
			dropped)         STATE_DROPPED=$VAL ;;
			below)           STATE_BELOW=$VAL ;;
			targets)         STATE_TARGETS=$VAL ;;
			allow_mode_change) STATE_ALLOW_MODE_CHANGE=$VAL ;;
			allow_pushed)    STATE_ALLOW_PUSHED=$VAL ;;
			mode_stray)      STATE_MODE_STRAY=$VAL ;;
			resolved)        STATE_RESOLVED=$VAL ;;
			squash_target)   STATE_SQUASH_TARGET=$VAL ;;
			message)         STATE_MESSAGE=$VAL ;;
			no_verify)       STATE_NO_VERIFY=$VAL ;;
			actor)           STATE_ACTOR=$VAL STATE_ACTOR_SET=1 ;;
			actor_id)        STATE_ACTOR_ID=$VAL ID_SET=1 ;;
			stop_head)       STATE_STOP_HEAD=$VAL ;;
			stops)           STATE_STOPS=$VAL ;;
			marked)          STATE_MARKED=$VAL ;;
			replay)          STATE_REPLAY=$VAL ;;
			todo_left)       STATE_TODO_LEFT=$VAL ;;
			skipped)         STATE_SKIPPED=$VAL ;;
			flag_skips)      STATE_FLAG_SKIPS=$VAL ;;
			placed)          STATE_PLACED=$VAL ;;
			place_label)     STATE_PLACE_LABEL=$VAL ;;
		esac
	done <<< "$_STATE_READ"
	# One from before labels were kept as given holds the mapped one alone, the caller's own where
	# that matches its own, as nothing there tells two mapping alike apart
	if [ -z "$ID_SET" ]; then
		STATE_ACTOR_ID=$STATE_ACTOR
		[ "$STATE_ACTOR" = "$_ACTOR" ] && STATE_ACTOR_ID=$_ACTOR_ID
	fi
	# The resuming or aborting run takes the pause over – `--status` only reads it
	_STATE_OWNED=$SF
	_STATE_ID=$(_PAUSE_KEYS <(print -r -- "$_STATE_READ"))
	# A gate the paused run declined stays declined for the run resuming it
	[ "$STATE_NO_VERIFY" = 1 ] && OPT_NO_VERIFY=(--no-verify)
	# Adopt the paused run's rerere scope, so the finalizer diffs against the
	# baseline from before the operation began – a state without one predates
	# the scope, and an unknown baseline must never forget anything
	if [ -n "$STATE_RRPRE_SET" ]; then
		_RERERE_SCOPE_BEGIN "$STATE_RRPRE"
	fi
}

# Notes a resume's verify flags onto its operation, as a first run's stick – once the resume is this
# caller's to run, as a re-pause of any kind keeps the state file as it stands
# The command first, so the tier sees it – a span tier with none refuses here, before anything is
# rebuilt, as recorded it would refuse every plain resume and leave the pause a dead end
_NOTE_RESUME_VERIFY () {
	if [ -n "$VERIFY_VALUE" ] && [ "$VERIFY_VALUE" != "$STATE_VERIFY_CMD" ]; then
		_STATE_NOTE "verify_cmd=$VERIFY_VALUE"
		STATE_VERIFY_CMD=$VERIFY_VALUE
	fi
	if [ ${#OPT_NO_VERIFY_SPAN} -gt 0 ] && [ "$STATE_VERIFY_SPAN" != "0" ]; then
		_STATE_NOTE "verify_span=0"
		STATE_VERIFY_SPAN=0
	elif [ ${#OPT_VERIFY_SPAN} -gt 0 ] && [ "$STATE_VERIFY_SPAN" != "1" ]; then
		if [ -z "$STATE_VERIFY_CMD" ] && [ -z "$(git config --get edit.verifyCmd 2>/dev/null)" ]; then
			PRINT_ERR "--verify-span needs a command – pass --verify=<cmd> or set edit.verifyCmd"
			exit 1
		fi
		_STATE_NOTE "verify_span=1"
		STATE_VERIFY_SPAN=1
	fi
}

# Names the sidecar carrying a paused `--text` across the exit, alongside the state file –
# the state file's own key=value lines can't hold a multi-line message
_TEXT_MSG_PATH () {
	local SF
	SF=$(_STATE_FILE_PATH) || return 1
	print -r -- "$SF-msg"
}

# Names the sidecar holding the failing verify run's output, alongside the state file – the pause
# prints only the last 15 lines and a driver reading the trailer through `| tail -N` cuts
# off even those, so the evidence has to outlive the invocation
_VERIFY_LOG_PATH () {
	local SF
	SF=$(_STATE_FILE_PATH) || return 1
	print -r -- "$SF-verify"
}

# Writes that sidecar and names it, header first, so a truncated or huge output still
# answers what ran, how it ended and how long it took – the check's own text is what
# tells a timeout from a red run
_VERIFY_SAVE_LOG () {
	# Args: <commit> <cmd> <exit-status> <seconds> <output>
	local LF
	LF=$(_VERIFY_LOG_PATH) || return 0
	# A parallel run's pause owns the sidecar too – this run's record is the tail printed above
	if [ -z "$_STATE_OWNED" ] && _STATE_EXISTS; then
		return 0
	fi
	{
		print -r -- "commit: $1"
		print -r -- "command: $2"
		print -r -- "exit: $3"
		print -r -- "seconds: $4"
		print -r -- ""
		print -r -- "$5"
	} > "$LF" 2>/dev/null || return 0
	PRINT_TEXT "Full output: %s" 33 "$LF"
}

# Tells whether the pause's worktree is one this tool made – by its name
# for a pause from before the record was kept
_STATE_WT_OURS () {
	[ "$STATE_WT_OURS" = 1 ] || { [ -z "$STATE_WT_OURS" ] && [[ "${STATE_WORKTREE:t}" == git-edit-* ]]; }
}

# Removes the pause this run took up or wrote, its state file and capture dirs, freeing the slot –
# a run owning none, as it never took one or its landing ended it, clears none, whatever the slot
# holds by now – failing, the pause kept, where the journal's lock can't be had
_CLEAR_STATE () {
	local JF="" RC
	_CAPTURE_REMOVE "$_CAPTURE_DIR"
	[ -n "$_STATE_OWNED" ] || return 0
	# Under the journal's lock a resume lands under, so no landing reads the slot between check and
	# clear – the journal beside the state file, as a run in a worktree it removed cannot resolve it
	if [ -z "$_JOURNAL_HELD" ]; then
		JF="${_STATE_OWNED:h}/git-edit-journal"
		_JOURNAL_LOCK "$JF"
		RC=$?
		if (( RC )); then
			_REFUSE_JOURNAL_LOCK "$JF" "the pause stays" $RC
			return 1
		fi
	fi
	_DROP_OWN_PAUSE
	[ -n "$JF" ] && _JOURNAL_UNLOCK "$JF"
	return 0
}

# Removes the pause this run took up or wrote, under the journal's lock the caller holds – where the
# slot still holds it, keys and nonce alike, as one taken after another run ended this one is that
# run's to keep – and lets go of it either way, as the slot is free from here
_DROP_OWN_PAUSE () {
	# Args: [keep-capture – the capture dir it records, the run's own, which its landing still reads]
	local SF=$_STATE_OWNED
	# Each read again, and the removal, where the signal a landing or an abort defers cut it short –
	# a pause read as another's, or left in place, would outlive the run that ended it
	[ -f "$SF" ] && _LANDED_OUT _PAUSE_KEYS "$SF"
	if [ -f "$SF" ] && [ "$REPLY" = "$_STATE_ID" ]; then
		_LANDED_OUT eval 'LC_ALL=C sed -n "s/^capture=//p" "$SF" 2>/dev/null | head -1'
		[ -n "$1" ] || _CAPTURE_REMOVE "$REPLY"
		_LANDED_OUT eval 'LC_ALL=C sed -n "s/^worktree=//p" "$SF" 2>/dev/null | tail -1'
		_UNREGISTER_GONE_WORKTREE "$REPLY"
		_LANDED_RUN rm -f "$SF" "$SF-msg" "$SF-verify"
	fi
	_STATE_OWNED="" _STATE_ID=""
}

# Drops git's record of <worktree> where its directory is gone – deleted by hand, say – that one
# alone, as `git worktree prune` would take every vanished one, other sessions' reflogs with them
_UNREGISTER_GONE_WORKTREE () {
	# Args: <worktree path>
	local WT=$1 GCD A G
	[ -n "$WT" ] && [ ! -e "$WT" ] || return 0
	_LANDED_OUT git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || return 0
	GCD=$REPLY
	for A in "$GCD"/worktrees/*(N/); do
		[ -f "$A/gitdir" ] && [ ! -e "$A/locked" ] || continue
		G=$(<"$A/gitdir")
		G=${G%/.git}
		[ "$G" = "$WT" ] || [ "${G:A}" = "${WT:A}" ] || continue
		_LANDED_RUN rm -rf "${A:?}"
	done
}

# Tells whether a pause's state file exists
_STATE_EXISTS () {
	local SF=$(_STATE_FILE_PATH)
	[ -n "$SF" ] && [ -f "$SF" ]
}

# Scopes rerere to the operation when the caller has explicitly opted out – every
# conflict-capable rebase force-enables it so a cascade or retry replays a resolution,
# but `rerere.enabled` false asks for no durable memory, so the run's records go
_RERERE_SCOPE_BEGIN () {
	# Args: [<baseline>] – with a baseline (even an empty one), adopt a paused
	# run's scope instead of snapshotting a fresh one
	[ -n "$_RERERE_SCOPE_OWNED" ] && return 0
	local DIR=$(git rev-parse --path-format=absolute --git-path rr-cache 2>/dev/null)
	[ -z "$DIR" ] && return 0
	_RERERE_DIR=$DIR
	_RERERE_STATE_FILE=$(_STATE_FILE_PATH)
	_RERERE_OPTOUT=false
	[ "$(git config --type=bool --get rerere.enabled 2>/dev/null)" = "false" ] && _RERERE_OPTOUT=true
	if [ $# -gt 0 ]; then
		_RERERE_PRE=$1
	else
		local -a PRE
		PRE=("$DIR"/*(N/:t))
		_RERERE_PRE="${PRE[*]}"
	fi
	_RERERE_SCOPE_OWNED=1
}

# Finalizes the rerere scope, called from the exit trap once no operation is in flight, using
# only the absolute paths captured at begin or adopt time – new entries are found by
# name, so nothing pre-existing is touched, and only a postimage counts as a resolution
_RERERE_SCOPE_END () {
	local CODE=$1
	[ -n "$_RERERE_DIR" ] && [ -d "$_RERERE_DIR" ] || return 0
	local -a NEW RESOLVED POSTIMAGES
	local E
	for E in "$_RERERE_DIR"/*(N/:t); do
		if [[ " $_RERERE_PRE " != *" $E "* ]]; then
			NEW+=("$E")
			POSTIMAGES=("$_RERERE_DIR/$E"/postimage*(N))
			[ ${#POSTIMAGES[@]} -gt 0 ] && RESOLVED+=("$E")
		fi
	done
	[ ${#NEW[@]} -eq 0 ] && return 0
	if [ "$_RERERE_OPTOUT" = "true" ]; then
		for E in "${NEW[@]}"; do rm -rf "$_RERERE_DIR/$E"; done
		if [ ${#RESOLVED[@]} -gt 0 ]; then
			PRINT_TEXT "Forgot %s resolution(s) rerere recorded during this run – it runs enabled so a cascade replays, and rerere.enabled=false keeps none of it." 90 "${#RESOLVED[@]}" >&2
		fi
	elif [ ${#RESOLVED[@]} -gt 0 ] && { [ ${#OPT_ABORT} -gt 0 ] || [ $CODE -ne 0 ]; }; then
		PRINT_TEXT "%s resolution(s) recorded by rerere outlive this run – a later conflict over the same lines arrives pre-filled, marker-free." 33 "${#RESOLVED[@]}" >&2
		PRINT_TEXT "If a resolution was wrong, remove: %s" 33 "${(j: :)${(@)RESOLVED/#/$_RERERE_DIR/}}" >&2
	fi
}

# Tells whether two commits hold the same tree, by object id – a quiet `git diff` passes a changed
# gitlink a caller's `diff.ignoreSubmodules` or a `.gitmodules` `ignore = all` hides
_SAME_TREE () {
	# Args: <commit or tree> <commit or tree>
	local A=$(git rev-parse -q --verify "$1^{tree}" 2>/dev/null)
	[ -n "$A" ] && [ "$A" = "$(git rev-parse -q --verify "$2^{tree}" 2>/dev/null)" ]
}

# Prints the paths two trees differ in, one per line and unquoted, gitlinks included whatever the
# caller's config ignores – what a refusal over a changed tree names
_TREE_CHANGES () {
	# Args: <commit or tree> <commit or tree>
	git -c core.quotePath=false diff-tree -r --name-only --no-renames --ignore-submodules=none "$1" "$2" 2>/dev/null
}

# Prints when a rewrite left the tip tree byte-identical to the pre-op tip – the strongest
# verification a content-preserving operation can get, free since both tips are at hand
# Reorders print their own variant beside the new order
_PRINT_TREE_IDENTITY () {
	# Args: <old-tip> <new-tip>
	[ "$1" = "$2" ] && return 0
	[ -n "$_IN_LANDED_STEP" ] || { _LANDED_STEP "$0" "$@"; return; }
	local OLD_TREE=$(git rev-parse "$1^{tree}" 2>/dev/null)
	[ -z "$OLD_TREE" ] && return 0
	if [ "$OLD_TREE" = "$(git rev-parse "$2^{tree}" 2>/dev/null)" ]; then
		PRINT_TEXT "%s – content byte-identical to the pre-op tip." 32 "Tip tree identical ✓"
	fi
}

# Names the notes a rewrite left behind on the pre-rewrite commits – whether they are copied
# is git's own policy, `notes copy` no-opping unless `notes.rewriteRef` is set, so this
# reports what that policy left, and a copy keeps the original, so both sides are counted
_PRINT_LEFT_NOTES () {
	# Args: <orig-tip> <new-tip>
	[ -n "$_IN_LANDED_STEP" ] || { _LANDED_STEP "$0" "$@"; return; }
	# A move that only advanced replaced no commit
	_IS_ANCESTOR "$1" "$2" && return 0
	# Every notes ref, not just the default one – `notes.rewriteRef` is a glob,
	# so a repo carrying `refs/notes/review` is the case this exists for
	local NREF
	local ANNOTATED=$(
		for NREF in ${(f)"$(git for-each-ref --format='%(refname)' refs/notes 2>/dev/null)"}; do
			git notes --ref="$NREF" list 2>/dev/null
		done | awk '{ print $2 }' | sort -u
	)
	[ -z "$ANNOTATED" ] && return 0
	local OLD_N NEW_N
	OLD_N=$(git rev-list "$1" --not "$2" 2>/dev/null | grep -Fxc -f <(printf '%s\n' "$ANNOTATED") 2>/dev/null) || OLD_N=0
	NEW_N=$(git rev-list "$2" --not "$1" 2>/dev/null | grep -Fxc -f <(printf '%s\n' "$ANNOTATED") 2>/dev/null) || NEW_N=0
	[ "${OLD_N:-0}" -le "${NEW_N:-0}" ] && return 0
	# Annotated commits, not note blobs – several refs can annotate one commit,
	# and the count is of what was replaced
	PRINT_TEXT "Notes stayed on %s replaced commit(s) – git copies notes only with notes.rewriteRef set:" 33 "$((OLD_N - NEW_N))"
	ECHO_E "\e[0;33m  git config notes.rewriteRef 'refs/notes/*'  # then re-run, or carry one over with git notes copy <old> <new>\e[0m"
}

# Names the signatures a rebuild could not carry – a rewritten commit is a new object, so
# its signature is invalid by construction and never re-created, and the header is read
# raw rather than through `%G?`, which needs gpg present and answers 'N' without it
_PRINT_LOST_SIGNATURES () {
	# Args: <orig-tip> <new-tip> – the replaced commits are those the new tip no longer reaches
	# A shortfall proves nothing alone, since a rebase re-signs under `commit.gpgsign` and
	# `-d`/`-s` carry one off deliberately, so the line states what both sides hold
	[ -n "$_IN_LANDED_STEP" ] || { _LANDED_STEP "$0" "$@"; return; }
	# A move that only advanced replaced no commit
	_IS_ANCESTOR "$1" "$2" && return 0
	local OLD_S NEW_S
	OLD_S=$(git rev-list "$1" --not "$2" 2>/dev/null | git cat-file --batch 2>/dev/null | grep -cE '^(gpgsig|gpgsig-sha256|mergetag) ') || OLD_S=0
	[ "${OLD_S:-0}" -eq 0 ] && return 0
	NEW_S=$(git rev-list "$2" --not "$1" 2>/dev/null | git cat-file --batch 2>/dev/null | grep -cE '^(gpgsig|gpgsig-sha256|mergetag) ') || NEW_S=0
	[ "${NEW_S:-0}" -gt 0 ] && return 0
	PRINT_TEXT "The replaced commit(s) carried %s signature(s), and the rewritten history carries none." 33 "$OLD_S"
}

# Prints the commits a replay dropped as empty – the count proves something vanished and the
# names say what, sparing the caller a log hunt, with subjects as the identity since a
# rewrite changes every SHA, and deliberate removals never route here
_PRINT_DROPPED_COMMITS () {
	# Args: <old-tip> <new-tip> [<old-from> <new-from> – what each side's replay span starts above,
	# the merge base by default, which commits added below the replay would offset]
	[ -n "$_IN_LANDED_STEP" ] || { _LANDED_STEP "$0" "$@"; return; }
	local MB=$(git merge-base "$1" "$2" 2>/dev/null)
	local FROM_OLD=${3:-$MB} FROM_NEW=${4:-$MB}
	local BEFORE
	local AFTER
	BEFORE=$(git rev-list --count ${FROM_OLD:+$FROM_OLD..}$1 2>/dev/null)
	AFTER=$(git rev-list --count ${FROM_NEW:+$FROM_NEW..}$2 2>/dev/null)
	if [ -z "$BEFORE" ] || [ -z "$AFTER" ] || [ "$AFTER" -ge "$BEFORE" ]; then
		return 0
	fi
	PRINT_TEXT "%s commit(s) resolved to empty and were dropped – %s before, %s after." 33 \
		"$((BEFORE - AFTER))" "$BEFORE" "$AFTER"
	# Which ones, by subject multiset – a rewrite changes every SHA, so subjects are the only
	# identity that survives, with an `s:` prefix since an empty subject is a legal message
	# Assignments, since `(( key++ ))` re-parses the subscript and would execute backticks
	local -A SURVIVING
	local SUBJECT
	while IFS= read -r SUBJECT; do
		SURVIVING[s:$SUBJECT]=$(( ${SURVIVING[s:$SUBJECT]:-0} + 1 ))
	done <<< "$(git log --format=%s ${FROM_NEW:+$FROM_NEW..}$2 2>/dev/null)"
	local -a DROPPED
	local LINE
	while IFS= read -r LINE; do
		SUBJECT=${LINE#* }
		if (( ${SURVIVING[s:$SUBJECT]:-0} > 0 )); then
			SURVIVING[s:$SUBJECT]=$(( ${SURVIVING[s:$SUBJECT]:-0} - 1 ))
		else
			DROPPED+=("$LINE")
		fi
	done <<< "$(git log --format='%h %s' ${FROM_OLD:+$FROM_OLD..}$1 2>/dev/null)"
	# Naming only where the arithmetic agrees: an op that also reworded left a
	# subject with no counterpart, and that commit is not a drop – the count
	# above stays authoritative either way
	[ ${#DROPPED[@]} -ne $((BEFORE - AFTER)) ] && return 0
	printf '%s\n' "${DROPPED[@]:0:12}" | _CARET_LINES | LC_ALL=C sed "s/^/  dropped: /;s/^/${_DIM}/;s/\$/${_OFF}/"
	[ ${#DROPPED[@]} -gt 12 ] && PRINT_TEXT "  +%s more" 90 "$(( ${#DROPPED[@]} - 12 ))"
	return 0
}

# Sets `REPLY` to the pattern of a conflict marker line at <size> – the base one a diff3 or zdiff3
# conflict writes too, which an agent clearing the other three misses
_MARKER_RE () {
	# Args: <size>
	REPLY="^(<{$1}|[|]{$1}|={$1}|>{$1})( |\$)"
}

# Fills `MARKED` with the staged paths in <worktree> holding conflict markers none of its sides
# brought, each at its own `conflict-marker-size` – an underline a file holds of its own passes
_MARKED_PATHS () {
	# Args: <worktree> [<rev a side came from>...]
	local WT=$1 FILE N RE STAGED OWN SIDE A
	shift
	local -a FILES SIDES ATTRS
	local -A SIZE
	SIDES=(HEAD "$@")
	git -C "$WT" rev-parse -q --verify REBASE_HEAD >/dev/null 2>&1 && SIDES+=(REBASE_HEAD)
	MARKED=()
	# NUL-separated – the line form C-quotes a name holding a quote or
	# backslash, which then shows no markers and passes
	FILES=(${(0)"$(git -C "$WT" diff --cached -z --name-only 2>/dev/null)"})
	(( ${#FILES} )) || return 0
	ATTRS=("${(@0)$(print -rn -- "${(pj:\0:)FILES}" | git -C "$WT" check-attr -z --stdin conflict-marker-size 2>/dev/null)}")
	for (( A = 1; A + 2 <= ${#ATTRS}; A += 3 )); do SIZE[${ATTRS[A]}]=${ATTRS[A + 2]}; done
	for FILE in "${FILES[@]}"; do
		N=${SIZE[$FILE]}
		[[ "$N" == <1-> ]] || N=7
		_MARKER_RE "$N"; RE=$REPLY
		# Read whole – piped into `grep -q`, `git show` died at an early marker once the blob
		# outgrew the pipe buffer, and `pipefail` read that as a clean file
		STAGED=$(git -C "$WT" show ":0:$FILE" 2>/dev/null | LC_ALL=C grep -aE "$RE")
		[ -n "$STAGED" ] || continue
		OWN=""
		for SIDE in "${SIDES[@]}"; do
			OWN+=$(git -C "$WT" show "$SIDE:$FILE" 2>/dev/null | LC_ALL=C grep -aE "$RE")$'\n'
		done
		[ -n "$(LC_ALL=C comm -23 <(print -r -- "$STAGED" | LC_ALL=C sort -u) <(print -r -- "$OWN" | LC_ALL=C sort -u))" ] && MARKED+=("$FILE")
	done
	return 0
}

# Tells whether <commit>'s <file> holds conflict-marker lines none of <sides> brought, at the
# file's own `conflict-marker-size` – as `_MARKED_PATHS` reads a staged blob
_COMMIT_ADDS_MARKERS () {
	# Args: <worktree> <commit> <file, from the top> <rev a side came from>...
	local WT=$1 C=$2 FILE=$3 N RE HAVE OWN="" SIDE
	shift 3
	N=$(git -C "$WT" check-attr conflict-marker-size -- "$FILE" 2>/dev/null)
	N=${N##*: }
	[[ "$N" == <1-> ]] || N=7
	_MARKER_RE "$N"; RE=$REPLY
	HAVE=$(git -C "$WT" show "$C:$FILE" 2>/dev/null | LC_ALL=C grep -aE "$RE")
	[ -n "$HAVE" ] || return 1
	for SIDE in "$@"; do
		OWN+=$(git -C "$WT" show "$SIDE:$FILE" 2>/dev/null | LC_ALL=C grep -aE "$RE")$'\n'
	done
	[ -n "$(LC_ALL=C comm -23 <(print -r -- "$HAVE" | LC_ALL=C sort -u) <(print -r -- "$OWN" | LC_ALL=C sort -u))" ]
}

# Sets `REPLY` to the commit the span a stop rebuilt opens above, in <worktree> under <tip> – the
# stop's own tip, or for a fixup's, which amends the commit it stopped on, that one's parent, empty
# for a root's – failing where the stop is no part of <tip>'s line
_SPAN_ABOVE_STOP () {
	# Args: <worktree> <tip at the stop> <tip>
	REPLY=$2
	git -C "$1" merge-base --is-ancestor "$2" "$3" 2>/dev/null && return 0
	REPLY=""
	git -C "$1" rev-parse -q --verify "$2^" >/dev/null || return 0
	REPLY=$(git -C "$1" rev-parse "$2^")
	git -C "$1" merge-base --is-ancestor "$REPLY" "$3" 2>/dev/null
}

# Answers whether <rebuilt> is <pick>'s copy, for `_PAIR_REPLAYED` – the author key its `AKEY` holds
# for each alike, else the message after git's cleanup
_SAME_PICK () {
	# Args: <worktree> <pick> <rebuilt>
	[ "${AKEY[$2]}" = "${AKEY[$3]}" ] || [ "$(_CLEAN_MESSAGE "$2" "$1")" = "$(_CLEAN_MESSAGE "$3" "$1")" ]
}

# Pairs each commit a replay rebuilt above <base> up to <tip> with the pick it replays – filling
# `REBUILT`, oldest first, `PAIRED`, and `CHAIN`, that pick and the fixups folded into it – from
# git's own record, which `_RECORD_REPLAY_PAIRS` had the replay save: a pick git left out, emptied
# or skipped, is recorded against the commit before it, which that commit's own pick claimed first
# – or for a stop `--skip` left, a commit made there with another author and message – so it
# pairs with nothing, going into `LEFT_OUT` as `<pick> <commit it was recorded against>`
# A replay that saved none – one begun anew past its stops – takes the picks `replay` noted in turn
# by author and date, which a replay keeps and a squash's new message leaves alone, picks sharing
# both told apart by the patch the rebuilt commit repeats, then by its subject
_PAIR_REPLAYED () {
	# Args: <worktree> <base, empty for a root's> <tip>
	local REC LINE OLD NEW PID_READ=""
	local -i I=1 J K N
	local -a ORIGS KEYS RKEYS RECS CAND
	local -A PID PICK AKEY
	REBUILT=(${(f)"$(git -C "$1" rev-list --reverse --no-merges "$3" ${2:+"^$2"} 2>/dev/null)"})
	PAIRED=() CHAIN=() LEFT_OUT=()
	ORIGS=(${=STATE_REPLAY})
	# The record is this replay's where it ends on a commit the replay rebuilt – git's own as it goes
	# where the replay is still in progress
	for REC in git-edit-replayed rebase-merge/rewritten-list; do
		REC=$(git -C "$1" rev-parse --path-format=absolute --git-path "$REC" 2>/dev/null)
		RECS=()
		[ -n "$REC" ] && [ -s "$REC" ] && RECS=(${(f)"$(<"$REC")"})
		(( ${#RECS} )) && (( ${REBUILT[(Ie)${${RECS[-1]#* }%% *}]} )) && break
		RECS=()
	done
	if (( ${#RECS} )); then
		for OLD in "${ORIGS[@]}"; do PICK[$OLD]=1; done
		[ -n "$STATE_FLAG_SKIPS" ] && for LINE in ${(f)"$(print -rl -- ${RECS%% *} ${${RECS#* }%% *} | \
			git -C "$1" log --no-walk=unsorted --stdin --format='%H %an%x1f%ae%x1f%at' 2>/dev/null)"}; do
			AKEY[${LINE%% *}]=${LINE#* }
		done
		for LINE in "${RECS[@]}"; do
			OLD=${LINE%% *} NEW=${${LINE#* }%% *}
			# A stop `--skip` left pairs only with its copy – author or message alike – as git records
			# its pick against the commit the caller made there, which is none, the pick landing nowhere
			if (( ! ${+PAIRED[$NEW]} )) && [[ " $STATE_FLAG_SKIPS " == *" $OLD "* ]] && ! _SAME_PICK "$1" "$OLD" "$NEW"; then
				(( ${+PICK[$OLD]} )) && LEFT_OUT+=("$LINE")
			elif (( ! ${+PAIRED[$NEW]} )); then
				PAIRED[$NEW]=$OLD CHAIN[$NEW]=$OLD
			elif (( ${+PICK[$OLD]} )); then
				LEFT_OUT+=("$OLD $NEW")
			else
				CHAIN[$NEW]+=" $OLD"
			fi
		done
		return 0
	fi
	(( ${#ORIGS} && ${#REBUILT} )) || return 0
	KEYS=("${(@f)$(git -C "$1" log --no-walk=unsorted --format='%an%x1f%ae%x1f%at' "${ORIGS[@]}" 2>/dev/null)}")
	RKEYS=("${(@f)$(git -C "$1" log --no-walk=unsorted --format='%an%x1f%ae%x1f%at' "${REBUILT[@]}" 2>/dev/null)}")
	(( ${#KEYS} == ${#ORIGS} && ${#RKEYS} == ${#REBUILT} )) || return 0
	for (( K = 1; K <= ${#REBUILT}; K++ )); do
		CAND=()
		for (( J = I; J <= ${#KEYS}; J++ )); do
			[ "${KEYS[J]}" = "${RKEYS[K]}" ] && CAND+=($J)
		done
		(( ${#CAND} )) || continue
		J=${CAND[1]}
		if (( ${#CAND} > 1 )); then
			if [ -z "$PID_READ" ]; then
				PID_READ=1
				for LINE in ${(f)"$(git -C "$1" log --no-walk=unsorted -p --no-color --no-textconv --no-ext-diff --format='commit %H' "${ORIGS[@]}" "${REBUILT[@]}" 2>/dev/null | git -C "$1" patch-id --stable 2>/dev/null)"}; do
					PID[${LINE#* }]=${LINE%% *}
				done
			fi
			J=0
			for N in "${CAND[@]}"; do
				[ -n "${PID[${ORIGS[N]}]}" ] && [ "${PID[${ORIGS[N]}]}" = "${PID[${REBUILT[K]}]}" ] && { J=$N; break; }
			done
			if (( ! J )); then
				OLD=$(git -C "$1" log -1 --format=%s "${REBUILT[K]}" 2>/dev/null)
				for N in "${CAND[@]}"; do
					[ "$(git -C "$1" log -1 --format=%s "${ORIGS[N]}" 2>/dev/null)" = "$OLD" ] && { J=$N; break; }
				done
				(( J )) || J=${CAND[1]}
			fi
		fi
		PAIRED[${REBUILT[K]}]=${ORIGS[J]} CHAIN[${REBUILT[K]}]=${ORIGS[J]}
		I=$(( J + 1 ))
	done
}

# Prints the lines <commit>'s change to <file> adds and removes, each with its sign
_COMMIT_CHANGE_LINES () {
	# Args: <worktree> <commit> <file, from the top>
	git -C "$1" diff-tree -p -U0 --root --no-commit-id --no-renames --no-ext-diff --no-textconv --no-color "$2" -- ":(literal)$3" 2>/dev/null | \
		LC_ALL=C awk 'H && /^[-+]/; /^@@/ { H = 1 }'
}

# Prints the lines a stop's rebuilt <commit> changes in <file> through its own commits – the pick
# it replays and the fixups folded into it, `CHAIN`'s, whose lines on a path the commit no longer
# holds count too, as a fold names a file by its path at the tip
_STOP_OWN_LINES () {
	# Args: <worktree> <stop's rebuilt commit> <file, from the top>
	local WT=$1 T=$2 FILE=$3 C P
	for C in ${=CHAIN[$T]}; do
		_COMMIT_CHANGE_LINES "$WT" "$C" "$FILE"
		for P in ${(0)"$(git -C "$WT" diff-tree -r -z --no-commit-id --name-only --no-renames --diff-filter=M "$C" 2>/dev/null)"}; do
			[ "$P" = "$FILE" ] && continue
			git -C "$WT" cat-file -e "$T:$P" 2>/dev/null && continue
			_COMMIT_CHANGE_LINES "$WT" "$C" "$P"
		done
	done
	return 0
}

# Prints the lines a stop's rebuilt <commit> changes in <file> beyond what its own commits change,
# `_STOP_OWN_LINES`' – so what the resolution took in, a line the fold rewrites never among it
_STOP_TOOK_IN () {
	# Args: <worktree> <stop's rebuilt commit> <file, from the top>
	local WT=$1 T=$2 FILE=$3 L
	local -A OWN
	for L in "${(@f)$(_STOP_OWN_LINES "$WT" "$T" "$FILE")}"; do [ -n "$L" ] && OWN[$L]=1; done
	for L in "${(@f)$(_COMMIT_CHANGE_LINES "$WT" "$T" "$FILE")}"; do
		[ -n "$L" ] && (( ! ${+OWN[$L]} )) && print -r -- "$L"
	done
	return 0
}

# Prints the lines of <original>'s change to <file> whose place a hunk of <rebuilt> still rewrites –
# a removed line mapped onto the rebuilt commit's parent, an added one onto the rebuilt commit – so
# that change rebased onto what now comes before it, not taken in by a stop
_STILL_REWRITTEN () {
	# Args: <worktree> <original commit> <rebuilt commit> <file, from the top>
	local -a DIFF=(-p -U0 --no-renames --no-ext-diff --no-textconv --no-color)
	{
		print -r -- '=MO'; git -C "$1" diff-tree "${DIFF[@]}" "$2^" "$3^" -- ":(literal)$4"
		print -r -- '=MN'; git -C "$1" diff-tree "${DIFF[@]}" "$2" "$3" -- ":(literal)$4"
		print -r -- '=R'; git -C "$1" diff-tree "${DIFF[@]}" --no-commit-id "$3" -- ":(literal)$4"
		print -r -- '=O'; git -C "$1" diff-tree "${DIFF[@]}" --no-commit-id "$2" -- ":(literal)$4"
	} 2>/dev/null | LC_ALL=C awk '
		# Maps line <x> through the hunks of map <m> to a range, empty where that diff removed it,
		# and tells whether a hunk of the rebuilt commit, its old side or new, overlaps that range
		function covered(m, x, old,   k, s, l, t, n, lo, hi, off) {
			off = 0; lo = -1
			for (k = 1; k <= NM[m]; k++) {
				s = MS[m, k]; l = ML[m, k]; t = MT[m, k]; n = MN[m, k]
				if (l > 0 && x >= s && x < s + l) { lo = n > 0 ? t : t + 1; hi = n > 0 ? t + n : t + 1; break }
				if ((l > 0 && s + l <= x) || (l == 0 && s < x)) off += n - l
			}
			if (lo < 0) { lo = x + off; hi = lo + 1 }
			for (k = 1; k <= NR; k++) {
				s = old ? RA[k] : RC[k]; l = old ? RB[k] : RD[k]
				if (l > 0 && (lo > s ? lo : s) < (hi < s + l ? hi : s + l)) return 1
			}
			return 0
		}
		/^=(MO|MN|R|O)$/ { S = substr($0, 2); H = 0; next }
		/^@@/ {
			H = 1
			split(substr($2, 2), A, ","); split(substr($3, 2), B, ",")
			a = A[1] + 0; b = (2 in A) ? A[2] + 0 : 1; c = B[1] + 0; d = (2 in B) ? B[2] + 0 : 1
			if (S == "MO" || S == "MN") { k = ++NM[S]; MS[S, k] = a; ML[S, k] = b; MT[S, k] = c; MN[S, k] = d }
			else if (S == "R") { NR++; RA[NR] = a; RB[NR] = b; RC[NR] = c; RD[NR] = d }
			else { OX = a; OY = c }
			next
		}
		!H || S != "O" { next }
		/^-/ { if (covered("MO", OX, 1)) print; OX++; next }
		/^\+/ { if (covered("MN", OY, 0)) print; OY++ }'
}

# Refuses a replay whose resolution at a stop took in what a later commit changes – a fold's stop
# resolved to the file as the tip holds it, say – which no tree check sees, the tip ending the same:
# a later commit, replayed, lost lines of its own change to a file a stop's commit changes, and most
# of them, blank and punctuation-only lines aside, sit in the stop's commit instead, beyond what its
# own commits change – a line it removed counting where the stop's commit holds what its hunk put in
# its place – or for a binary file, its whole change gone, the blob it made does – a pick git
# left out as emptied having lost all of them – where the rewrite itself emptied that change, a
# drop's or a replant's, nothing lost turns up there
_GUARD_ABSORBED () {
	# Args: <worktree> <new tip>
	local WT=$1 NEW=$2 T R O FILE L K NOTE BY PAIR PAST AFTER
	local -i I P V SIG MOVED ALL_SIG LOST_SIG
	local -a SH SB SF REBUILT LEFT_OUT FILES INTO LOSTL LOST VO VR VL HUNKS SUPERSEDED
	local -A PAIRED CHAIN AT HELD TOOK LEFT_AT OWNS UNDONE HUNK_HELD SWAPPED HUNK_ADDS REPLACED REBASED
	[ -n "$STATE_STOPS" ] && [ -n "$STATE_REPLAY" ] || return 0
	# Each stop's tip, the commit it builds and its files, NUL-joined
	for T in ${(z)STATE_STOPS}; do
		if [[ "$T" == \$\'* ]]; then
			(( ${#SH} )) && SF[-1]+="${(Q)T}"$'\0'
		else
			SH+=("${T%%:*}") SB+=("${T#*:}") SF+=("")
		fi
	done
	[ -n "${SH[1]}" ] && _SPAN_ABOVE_STOP "$WT" "${SH[1]}" "$NEW" || return 0
	_PAIR_REPLAYED "$WT" "$REPLY" "$NEW"
	# Where each stop's commit sits in the replay – none where git left its pick out – and every file
	# it changes beside those it conflicted on, a resolution staging a later commit's change to one
	# that never conflicted too, which `_STOP_TOOK_IN` finds beyond its own commits' lines
	for (( I = 1; I <= ${#SH}; I++ )); do
		[ -n "${SB[I]}" ] || continue
		for (( P = 1; P <= ${#REBUILT}; P++ )); do
			[ "${PAIRED[${REBUILT[P]}]}" = "${SB[I]}" ] || continue
			AT[$I]=$P
			SF[I]+="$(git -C "$WT" diff-tree -r -z --root --no-commit-id --name-only --no-renames "${REBUILT[P]}" 2>/dev/null)"
			break
		done
	done
	# Each commit the replay rebuilt, against the stops before it, and after it each pick git left
	# out recorded against it, against the stops up to it – in replay order
	for L in "${LEFT_OUT[@]}"; do LEFT_AT[${L#* }]+="${L%% *} "; done
	for (( P = 1; P <= ${#REBUILT}; P++ )); do
		O=${PAIRED[${REBUILT[P]}]}
		[ -n "$O" ] && VO+=("$O") VR+=("${REBUILT[P]}") VL+=($(( P - 1 )))
		for O in ${=LEFT_AT[${REBUILT[P]}]}; do VO+=("$O") VR+=("") VL+=($P); done
	done
	for (( V = 1; V <= ${#VO}; V++ )); do
		O=${VO[V]} R=${VR[V]} NOTE=""
		[ -n "$R" ] || NOTE=" (left out as emptied)"
		FILES=(${(0)"$(git -C "$WT" diff-tree -r -z --root --no-commit-id --name-only --no-renames "$O" 2>/dev/null)"})
		for FILE in "${FILES[@]}"; do
			# The commits of the stops before this one that conflicted on the file
			INTO=()
			for (( I = 1; I <= ${#SH}; I++ )); do
				(( ${+AT[$I]} )) && (( ${AT[$I]} <= ${VL[V]} )) && (( ${${(0)SF[I]}[(Ie)$FILE]} )) && INTO+=("${REBUILT[${AT[$I]}]}")
			done
			(( ${#INTO} )) || continue
			# A binary file has no lines – its change gone from the replay, with a stop's commit holding
			# the very blob the original made
			if [[ "$(git -C "$WT" diff-tree --numstat --root --no-commit-id --no-renames "$O" -- ":(literal)$FILE" 2>/dev/null)" == -$'\t'-$'\t'* ]]; then
				[ -z "$R" ] || git -C "$WT" diff-tree --quiet --no-renames --ignore-submodules=none "$R^" "$R" -- ":(literal)$FILE" 2>/dev/null || continue
				L=$(git -C "$WT" rev-parse -q --verify "$O:$FILE" 2>/dev/null) || continue
				for T in "${INTO[@]}"; do
					[ "$(git -C "$WT" rev-parse -q --verify "$T:$FILE" 2>/dev/null)" = "$L" ] || continue
					LOST+=("$(git -C "$WT" log -1 --format='%h %s' "${R:-$O}") – $FILE$NOTE")
					break
				done
				continue
			fi
			# Its own change's lines the replay lost, as many times as it lost each
			LOSTL=("${(@f)$(LC_ALL=C comm -23 <(_COMMIT_CHANGE_LINES "$WT" "$O" "$FILE" | LC_ALL=C sort) <([ -n "$R" ] && _COMMIT_CHANGE_LINES "$WT" "$R" "$FILE" | LC_ALL=C sort))}")
			HELD=() UNDONE=()
			for T in "${INTO[@]}"; do
				(( ${+TOOK[$T:$FILE]} )) || TOOK[$T:$FILE]=$(_STOP_TOOK_IN "$WT" "$T" "$FILE")
				(( ${+OWNS[$T:$FILE]} )) || OWNS[$T:$FILE]=$(_STOP_OWN_LINES "$WT" "$T" "$FILE")
				for L in "${(@f)TOOK[$T:$FILE]}"; do [ -n "$L" ] && HELD[$L]=$T; done
				# Its own lines, sign flipped – a line the later commit adds that the stop's own removes
				for L in "${(@f)OWNS[$T:$FILE]}"; do
					case $L in
						+*) UNDONE[-${L:1}]=1 ;;
						-*) UNDONE[+${L:1}]=1 ;;
					esac
				done
			done
			SIG=0 MOVED=0 BY=""
			# A line it removes is never held, the stop's commit holding what replaced it – so it moved
			# with a line its hunk adds that the stop's commit holds, the later version of that line
			HUNKS=("${(@f)$(git -C "$WT" diff-tree -p -U0 --root --no-commit-id --no-renames --no-ext-diff --no-textconv --no-color "$O" -- ":(literal)$FILE" 2>/dev/null | \
				LC_ALL=C awk '/^@@/ { H++; next } H && /^[-+]/ { print H "\t" $0 }')}")
			HUNK_HELD=() SWAPPED=() HUNK_ADDS=() REPLACED=()
			for L in "${HUNKS[@]}"; do
				[[ "${L#*$'\t'}" == +* ]] || continue
				HUNK_ADDS[${L%%$'\t'*}]=1
				(( ${+HELD[${L#*$'\t'}]} )) && HUNK_HELD[${L%%$'\t'*}]=${HELD[${L#*$'\t'}]}
			done
			for L in "${HUNKS[@]}"; do
				[[ "${L#*$'\t'}" == -* ]] || continue
				(( ${+HUNK_HELD[${L%%$'\t'*}]} )) && SWAPPED[${L#*$'\t'}]=${HUNK_HELD[${L%%$'\t'*}]}
				(( ${+HUNK_ADDS[${L%%$'\t'*}]} && ! ${+HUNK_HELD[${L%%$'\t'*}]} )) && REPLACED[${L#*$'\t'}]=1
			done
			# A line that would count as taken in whose place the rebuilt commit still rewrites is
			# its change rebased onto the stop's, never taken in – it counts toward neither side
			REBASED=()
			if [ -n "$R" ]; then
				for L in "${LOSTL[@]}"; do
					(( ${+HELD[$L]} || ${+SWAPPED[$L]} )) || continue
					for K in "${(@f)$(_STILL_REWRITTEN "$WT" "$O" "$R" "$FILE")}"; do
						[ -n "$K" ] && (( ${+HELD[$K]} || ${+SWAPPED[$K]} )) && REBASED[$K]=1
					done
					break
				done
			fi
			# A line it rewrote that the stop's commit only rewrites again – that line's old text
			# alone there, not what its hunk put in its place – counts where the later commit lost
			# most of its change to the file, a commit keeping the rest of it named as superseded
			ALL_SIG=0 LOST_SIG=0
			for L in "${(@f)$(_COMMIT_CHANGE_LINES "$WT" "$O" "$FILE")}"; do
				[[ "${L:1}" == *[^[:space:][:punct:]]* ]] && ALL_SIG+=1
			done
			for L in "${LOSTL[@]}"; do
				[[ "${L:1}" == *[^[:space:][:punct:]]* ]] && (( ! ${+REBASED[$L]} )) && LOST_SIG+=1
			done
			# A lost line the stop's own change undoes is the new order's doing, a moved commit's
			# change cancelling against it, not taken in – so it counts toward neither side
			for L in "${LOSTL[@]}"; do
				[[ "${L:1}" == *[^[:space:][:punct:]]* ]] || continue
				if (( ${+REBASED[$L]} )); then
					continue
				elif (( ${+HELD[$L]} && ${+REPLACED[$L]} && LOST_SIG * 2 <= ALL_SIG )); then
					SUPERSEDED+=("$(git -C "$WT" log -1 --format='%h %s' "${R:-$O}") – $FILE: ${${L:1}:0:72}")
					continue
				elif (( ${+HELD[$L]} )); then
					SIG+=1 MOVED+=1
					BY=${BY:-${HELD[$L]}}
				elif (( ${+UNDONE[$L]} )); then
					continue
				elif (( ${+SWAPPED[$L]} )); then
					SIG+=1 MOVED+=1
					BY=${BY:-${SWAPPED[$L]}}
				else
					SIG+=1
				fi
			done
			(( SIG && MOVED * 2 > SIG )) || continue
			LOST+=("$(git -C "$WT" log -1 --format='%h %s' "${R:-$O}") – $FILE$NOTE")
			# The latest commit named, which a placement's hint offers to place after
			PAST=$O
			# The two as the branch had them, older first, for the squash a reorder's hint offers –
			# and a stop's commit the new order put before a commit it followed, for its move
			if [ -n "${PAIRED[$BY]}" ] && git -C "$WT" merge-base --is-ancestor "$O" "${PAIRED[$BY]}" 2>/dev/null; then
				AFTER="${PAIRED[$BY]} $O"
				[ -n "$PAIR" ] || PAIR="${O:0:12} ${PAIRED[$BY]:0:12}"
			elif [ -z "$PAIR" ] && [ -n "${PAIRED[$BY]}" ]; then
				PAIR="${PAIRED[$BY]:0:12} ${O:0:12}"
			fi
		done
	done
	if (( ! ${#LOST} )); then
		if (( ${#SUPERSEDED} )); then
			PRINT_TEXT "%s" 90 "Superseded, an earlier commit now rewriting the line they rewrote:"
			printf '%s\n' "${(u)SUPERSEDED[@]}" | _CARET_LINES | LC_ALL=C sed "s/^/${_DIM}  /;s/\$/${_OFF}/"
		fi
		return 0
	fi
	_CLEANUP_HOOK=""
	PRINT_ERR "A resolution took in what a later commit changes – replayed, it lost lines of its own change that a stop's commit now holds, so nothing was applied"
	printf '%s\n' "${LOST[@]}" | _CARET_LINES | LC_ALL=C sed "s/^/${_RED}  /;s/\$/${_OFF}/" >&2
	# A reorder's stop holds no snapshot to take – its commit's change alone, on what the new order
	# puts first, which a change building on a commit moved past it lacks – so it offers the move
	# right after that commit where others stood between the two, and a placement the same
	if [ "$STATE_OPERATION" = reorder ] && [ -z "$STATE_PLACED" ]; then
		[ -n "$AFTER" ] && [ "$(git -C "$WT" rev-parse -q --verify "${AFTER% *}^" 2>/dev/null)" != "${AFTER#* }" ] || AFTER=""
		K=${AFTER:+ by moving it right after that commit instead: $(_LIT "git edit --move=${AFTER:0:12} --after=${${AFTER#* }:0:12}")}
		K+=${PAIR:+, or squash the two into one: $(_LIT "git edit -s=${PAIR% *} ${PAIR#* }")}
		ECHO_E "\e[0;31m  Cancel with 'git edit --abort', then run it again, resolving each stop to its own commit's change alone on what the new order puts before it – where that change builds on the commit named, keep their order${K:-.}\e[0m" >&2
	elif [ -n "$STATE_PLACED" ] && [ -n "$PAST" ]; then
		ECHO_E "\e[0;31m  Cancel with 'git edit --abort', then run it again, resolving each stop to what the commit it builds holds – the later commits replay their own changes on top – or placed past the change it builds on: --after=${PAST:0:12} in place of --${${STATE_PLACE_LABEL#* }%% *}=${STATE_PLACE_LABEL##* }\e[0m" >&2
	else
		ECHO_E "\e[0;31m  Cancel with 'git edit --abort', then run it again, resolving each stop to what the commit it builds holds – the later commits replay their own changes on top.\e[0m" >&2
	fi
	exit 1
}

# Refuses a replay finished by hand – a blanket `git add`, then `git rebase --continue` in the
# worktree – whose commits from the last stop on carry conflict markers that neither their parent
# nor the commit each replays brought, paired in replay order, as a resume with them still staged
# refuses
_GUARD_HAND_FINISH () {
	# Args: <worktree> [<rev a side came from>...]
	local WT=$1 STOP_TIP=${STATE_STOP_HEAD%% *} STOPPED=${${STATE_STOP_HEAD#* }:#$STATE_STOP_HEAD} C FILE
	shift
	local -a BAD FILES SPAN REBUILT LEFT_OUT
	local -A PAIRED CHAIN
	[ -n "$STOP_TIP" ] && _SPAN_ABOVE_STOP "$WT" "$STOP_TIP" HEAD || return 0
	STOP_TIP=$REPLY
	SPAN=(${STOP_TIP:+"^$STOP_TIP"})
	# Paired from the first stop on, whose picks `replay` holds
	[ -n "$STATE_REPLAY" ] && [ -n "${${STATE_STOPS%% *}%%:*}" ] && \
		_SPAN_ABOVE_STOP "$WT" "${${STATE_STOPS%% *}%%:*}" HEAD && _PAIR_REPLAYED "$WT" "$REPLY" HEAD
	for C in ${(f)"$(git -C "$WT" rev-list --reverse --no-merges "${SPAN[@]}" HEAD 2>/dev/null)"}; do
		FILES=(${(0)"$(git -C "$WT" diff-tree -r -z --root --no-commit-id --name-only --no-renames "$C" 2>/dev/null)"})
		for FILE in "${FILES[@]}"; do
			_COMMIT_ADDS_MARKERS "$WT" "$C" "$FILE" "$C^" ${PAIRED[$C]:+"${PAIRED[$C]}"} ${STOPPED:+"$STOPPED"} "$@" && \
				BAD+=("$(git -C "$WT" log -1 --format=%h "$C") $FILE")
		done
	done
	(( ${#BAD} )) || return 0
	_CLEANUP_HOOK=""
	# One still in progress takes no `rebase -i` over those commits
	if [ -d "$(git -C "$WT" rev-parse --path-format=absolute --git-path rebase-merge 2>/dev/null)" ]; then
		PRINT_ERR "The rebase continued by hand in $WT committed conflict markers – nothing was applied"
		printf '%s\n' "${BAD[@]}" | _CARET_LINES | LC_ALL=C sed "s/^/${_RED}  /;s/\$/${_OFF}/" >&2
		ECHO_E "\e[0;31m  Cancel with 'git edit --abort', then run it again.\e[0m" >&2
		exit 1
	fi
	PRINT_ERR "The rebase finished by hand in $WT committed conflict markers – nothing was applied"
	printf '%s\n' "${BAD[@]}" | _CARET_LINES | LC_ALL=C sed "s/^/${_RED}  /;s/\$/${_OFF}/" >&2
	ECHO_E "\e[0;31m  Strip them from those commits ('git -C $(_LIT "$(_SHQ "$WT")") rebase -i ${STOP_TIP:0:12}'), then 'git edit --continue' – or cancel with 'git edit --abort'.\e[0m" >&2
	exit 1
}

# Refuses to resume while a staged file still carries conflict markers – the failure mode is
# a resolver dying silently, a blanket `git add` staging the file markers and all, and
# `rebase --continue` accepting that, so read the staged blob, which is what gets committed
_GUARD_RESOLUTION_CLEAN () {
	# Args: <worktree> [<rev a side came from>...]
	local WT=$1 STOP_TIP=${STATE_STOP_HEAD%% *} HEAD_NOW FILE
	local -a BAD FILES
	_MARKED_PATHS "$@"
	BAD=("${MARKED[@]}")
	# Commits made by hand at the stop carry their markers past the staged check – read at the tip
	# against what the stop began with and what its commit brought
	HEAD_NOW=$(git -C "$WT" rev-parse -q --verify HEAD 2>/dev/null)
	if [ -n "$STOP_TIP" ] && [ "$HEAD_NOW" != "$STOP_TIP" ] && \
	   [ "${STATE_STOP_HEAD#* }" = "$(git -C "$WT" rev-parse -q --verify REBASE_HEAD 2>/dev/null)" ] && \
	   git -C "$WT" merge-base --is-ancestor "$STOP_TIP" "$HEAD_NOW" 2>/dev/null; then
		FILES=(${(0)"$(git -C "$WT" diff -z --name-only --no-renames "$STOP_TIP" "$HEAD_NOW" 2>/dev/null)"})
		for FILE in "${FILES[@]}"; do
			_COMMIT_ADDS_MARKERS "$WT" "$HEAD_NOW" "$FILE" "$STOP_TIP" REBASE_HEAD && \
				(( ! ${BAD[(Ie)$FILE]} )) && BAD+=("$FILE")
		done
	fi
	if [ ${#BAD[@]} -gt 0 ]; then
		_CLEANUP_HOOK=""
		PRINT_ERR "The resolution still contains conflict markers – refusing to continue"
		printf '%s\n' "${BAD[@]}" | _CARET_LINES | LC_ALL=C sed "s/^/${_RED}  /;s/\$/${_OFF}/" >&2
		ECHO_E "\e[0;31m  Strip them in $(_LIT "$WT") – staged, or amended into a commit made there – then 'git edit --continue', or 'git edit --abort'.\e[0m" >&2
		EMIT_CONFLICT "$WT" "${(F)BAD}"
		_PAUSE_EXIT 2 conflict
	fi
}

# Records the tree a resolver staged at a stop, the one state in a replay that somebody wrote
# rather than git – so the gate's default tier can find the commit carrying it and check it too
_NOTE_RESOLVED_TREE () {
	local TREE=$(git -C "$1" write-tree 2>/dev/null)
	[ -z "$TREE" ] && return 0
	STATE_RESOLVED="${STATE_RESOLVED:+$STATE_RESOLVED }$TREE"
	_STATE_NOTE "resolved=$STATE_RESOLVED"
}

# Appends a key=value line to this run's own pause, never a parallel run's – the loader takes a
# key's last line, so a later value replaces an earlier one and an empty one clears it
# Checked and written under the journal's lock an abort ends a pause under, and onto a file there
# only – never one created anew, a stub holding no operation in a slot freed meanwhile – a pause
# gone refusing as one another run took over does
_STATE_NOTE () {
	# Args: <key=value>
	[ -n "$_STATE_OWNED" ] || return 0
	_SLOT_LOCK "$_STATE_OWNED" "nothing was applied"
	local JF=$REPLY
	_REQUIRE_OWN_PAUSE
	( setopt no_clobber no_append_create; print -r -- "$1" >> "$_STATE_OWNED" ) 2>/dev/null
	[ -n "$JF" ] && _JOURNAL_UNLOCK "$JF"
}

# Prints the ` mode change` lines of a diff, as the landing's mode note reads them – paths
# unquoted, so the commit search can look one up as it stands
_MODE_LINES () {
	# Args: <worktree> <from> <to>
	git -C "$1" -c core.quotePath=false diff --summary "$2" "$3" 2>/dev/null | LC_ALL=C grep -a '^ mode change'
	return 0
}

# Prints the mode git's own merge gives a path at a stop: the replayed commit's where that
# commit changed it, else the new parent's – and none where both changed it (the resolver's
# call) or where the commit removed the path
_MERGED_MODE () {
	# Args: <base> <theirs> <ours>
	[ -z "$2" ] && return 0
	if [ "$2" != "$1" ]; then
		[ -n "$3" ] && [ "$3" != "$1" ] && [ "$3" != "$2" ] && return 0
		echo "$2"
	else
		echo "${3:-$2}"
	fi
}

# Prints a tree's mode for each given path as "<path>\0<mode>\0" pairs, in one read – NUL-separated
# throughout, so a path with a space or an umlaut arrives unquoted
_TREE_MODES () {
	# Args: <worktree> <tree-ish> <path>...
	local E
	for E in ${(0)"$(git --literal-pathspecs -C "$1" ls-tree -r -z "$2" -- "${@:3}" 2>/dev/null)"}; do
		[ -n "$E" ] && printf '%s\0%s\0' "${E#*$'\t'}" "${E%% *}"
	done
}

# Refuses a stop's staged resolution that leaves a path at a mode neither the replayed commit
# nor its new parent carries – a file written anew into the worktree and staged comes back
# without its executable bit, which every commit above then inherits, surfacing only in the
# landing's mode note – `--allow-mode-change` on the continue keeps it, for the landing too
_GUARD_STOP_MODES () {
	local WT=$1
	local GITDIR=$(git -C "$WT" rev-parse --git-dir 2>/dev/null)
	local STOPPED=$(cat "$GITDIR/rebase-merge/stopped-sha" 2>/dev/null)
	[ -z "$STOPPED" ] && return 0
	local -a PATHS
	PATHS=( ${(0)"$(git -C "$WT" diff --cached --name-only -z 2>/dev/null)"} )
	[ ${#PATHS[@]} -eq 0 ] && return 0
	# One index read and three tree reads for every staged path – a large commit's stop stages
	# hundreds, and a read per path would take seconds
	local -A STAGED BASE THEIRS OURS
	local E MODES
	# Past what one command line holds, the whole index and trees are read – only `PATHS` are looked up
	local -a SPEC
	_ARGV_FITS "${PATHS[@]}" && SPEC=("${PATHS[@]}")
	for E in ${(0)"$(git --literal-pathspecs -C "$WT" ls-files -s -z -- "${SPEC[@]}" 2>/dev/null)"}; do
		# "<mode> <blob> <stage>\t<path>" – stage 0 only, an unmerged path holds no resolution yet
		[[ "${E%%$'\t'*}" == *" 0" ]] && STAGED[${E#*$'\t'}]=${E%% *}
	done
	MODES=$(_TREE_MODES "$WT" "$STOPPED^" "${SPEC[@]}"); [ -n "$MODES" ] && BASE=( ${(0)MODES} )
	MODES=$(_TREE_MODES "$WT" "$STOPPED" "${SPEC[@]}"); [ -n "$MODES" ] && THEIRS=( ${(0)MODES} )
	MODES=$(_TREE_MODES "$WT" HEAD "${SPEC[@]}"); [ -n "$MODES" ] && OURS=( ${(0)MODES} )
	local -a BAD BADPATHS FIX
	local P WANTED
	for P in "${PATHS[@]}"; do
		[ -z "${STAGED[$P]}" ] && continue
		WANTED=$(_MERGED_MODE "${BASE[$P]}" "${THEIRS[$P]}" "${OURS[$P]}")
		if [ -n "$WANTED" ] && [ "${STAGED[$P]}" != "$WANTED" ]; then
			BAD+=("$P: staged ${STAGED[$P]}, the replay carries $WANTED")
			BADPATHS+=("$P")
			# Worktree and index both – an index set on its own leaves an unstaged mode change,
			# which `git rebase --continue` reads as conflicts still to resolve, and `git add`'s
			# own `--chmod` holds where `core.fileMode` is off – `chmod`'s `--` ahead of the mode, as
			# BSD's reads one after it as a file
			case "$WANTED" in
				100755) FIX+=("chmod -- +x $(_SHQ "$WT/$P") && git -C $(_SHQ "$WT") add --chmod=+x -- $(_QUOTE_PATHS "$P")") ;;
				100644) FIX+=("chmod -- -x $(_SHQ "$WT/$P") && git -C $(_SHQ "$WT") add --chmod=-x -- $(_QUOTE_PATHS "$P")") ;;
				*) FIX+=("git -C $(_SHQ "$WT") update-index --cacheinfo $(_SHQ "$WANTED,$(git -C "$WT" rev-parse ":0:$P" 2>/dev/null),$P")") ;;
			esac
		fi
	done
	[ ${#BAD[@]} -eq 0 ] && return 0
	if [ ${#OPT_ALLOW_MODE_CHANGE} -gt 0 ]; then
		# The landing's guard must not refuse what this one let through
		STATE_ALLOW_MODE_CHANGE=1
		_STATE_NOTE "allow_mode_change=1"
		return 0
	fi
	_CLEANUP_HOOK=""
	PRINT_ERR "The staged resolution changes a file mode the replayed commit does not – a file written anew and staged without its executable bit?"
	printf '%s\n' "${BAD[@]}" | _CARET_LINES | LC_ALL=C sed "s/^/${_RED}  /;s/\$/${_OFF}/" >&2
	ECHO_E "\e[0;31m  Restore it, then 'git edit --continue' – or pass --allow-mode-change to keep it:\e[0m" >&2
	printf '%s\n' "${FIX[@]}" | _CARET_LINES | LC_ALL=C sed "s/^/${_RED}    /;s/\$/${_OFF}/" >&2
	EMIT_CONFLICT "$WT" "${(F)BADPATHS}"
	_PAUSE_EXIT 2 conflict
}

# The commit the tip guard last named, for the gate pause's trailer
_MODE_STRAY_AT=""

# Refuses a landing whose tip changed a file mode the operation never asked for – beyond a fold's
# staged flip, an edit's, or the ones a dropped commit undoes – naming the rebuilt commit that
# brought it in, since a resolution at a stop is where one enters unasked – `--allow-mode-change`
# on the continue applies it anyway, as it does for a stop it let through
_GUARD_TIP_MODES () {
	# Args: <worktree> <new_head> <orig_head> [<meant mode lines>]
	local WT=$1
	local NEW=$2
	local ORIG=$3
	local MEANT=$4
	_MODE_STRAY_AT=""
	if [ ${#OPT_ALLOW_MODE_CHANGE} -gt 0 ] || [ "$STATE_ALLOW_MODE_CHANGE" = "1" ]; then
		# Given on a continue, the flag carries to the next, so a verify
		# pause in between can't bring the refusal back
		if [ ${#OPT_CONTINUE} -gt 0 ] && [ "$STATE_ALLOW_MODE_CHANGE" != "1" ]; then
			STATE_ALLOW_MODE_CHANGE=1
			_STATE_NOTE "allow_mode_change=1"
		fi
		[ -n "$STATE_MODE_STRAY" ] && _STATE_NOTE "mode_stray="
		return 0
	fi
	local -a STRAY
	local LINE
	for LINE in ${(f)"$(_MODE_LINES "$WT" "$ORIG" "$NEW")"}; do
		[ -z "$LINE" ] && continue
		grep -qxF -- "$LINE" <<<"$MEANT" || STRAY+=("$LINE")
	done
	[ ${#STRAY[@]} -eq 0 ] && return 0
	PRINT_ERR "The rewrite changed a file mode nothing asked for – nothing was applied"
	local C TO P
	for LINE in "${STRAY[@]}"; do
		print -r -- "$LINE" | _CARET_LINES | LC_ALL=C sed "s/^ /${_RED}  /;s/\$/${_OFF}/" >&2
		# The first rebuilt commit carrying the path at the landed mode – the stop where a
		# resolution staged the file at it, or the rebuilt commit that introduced the file at it
		TO=${${LINE#* mode change * => }%% *}
		P=${LINE#* mode change * => * }
		for C in ${(f)"$(git -C "$WT" rev-list --reverse "$ORIG..$NEW" 2>/dev/null)"}; do
			[ -z "$C" ] && continue
			if [ "$(git -C "$WT" ls-tree "$C" -- ":(literal)$P" 2>/dev/null | cut -d' ' -f1)" = "$TO" ]; then
				_PRINT_COMMIT_LINE "$C" '    brought in by %h %s'
				[ -z "$_MODE_STRAY_AT" ] && _MODE_STRAY_AT=$C
				break
			fi
		done
	done
	[ -z "$_MODE_STRAY_AT" ] && _MODE_STRAY_AT=$NEW
	PRINT_TEXT "Apply it anyway with %s, then fix that commit with %s – or 'git edit --abort'." 33 "--allow-mode-change --continue" "git edit ${_MODE_STRAY_AT:0:7}"
	return 1
}

# Records the gate a `--no-verify` run bypassed, for the note `EMIT_STATUS` prints – the command
# is resolved here only to name it, so the multi-line refusal the gate itself makes stays out of
# a path where nothing ever runs it, hence the first line alone
# With nothing configured it records nothing: no gate existed, so none was skipped
_VERIFY_NOTE_BYPASS () {
	[ ${#OPT_NO_VERIFY} -gt 0 ] || return 0
	local CMD=$VERIFY_VALUE
	[ -z "$CMD" ] && CMD=$STATE_VERIFY_CMD
	[ -z "$CMD" ] && CMD=$(git config --get edit.verifyCmd 2>/dev/null)
	[ -n "$CMD" ] && _VERIFY_BYPASSED=${CMD%%$'\n'*}
	return 0
}

# Answers whether a gate is in force for this run, putting its command into `REPLY`
_VERIFY_CONFIGURED () {
	REPLY=""
	[ ${#OPT_NO_VERIFY} -gt 0 ] && return 1
	REPLY=$VERIFY_VALUE
	[ -z "$REPLY" ] && REPLY=$STATE_VERIFY_CMD
	[ -z "$REPLY" ] && REPLY=$(git config --get edit.verifyCmd 2>/dev/null)
	[ -n "$REPLY" ]
}

# Answers whether the span tier is in force – the flag, the tier a pause recorded, or the standing
# `edit.verifySpan`, whose config is only read where the gate runs, so it stays exempt
# on the modes an explicit flag is refused on, and names a tier rather than a check
# `--no-verify-span` declines it for one run, and a pause records the declined tier as `0`,
# since a resume that fell back to the config would climb to the span the run stepped down from
_VERIFY_SPAN_ON () {
	[ ${#OPT_NO_VERIFY_SPAN} -gt 0 ] && return 1
	[ ${#OPT_VERIFY_SPAN} -gt 0 ] && return 0
	case "$STATE_VERIFY_SPAN" in 1) return 0 ;; 0) return 1 ;; esac
	[ "$(git config --type=bool --get edit.verifySpan 2>/dev/null)" = "true" ] || return 1
	_VERIFY_CONFIGURED
}

# Finds the pre-op commit a rebuilt one replaces – the tip's is known outright, and below it the
# subject carries across the rebuild where the SHA does not, equal spans pairing
# positionally, while an ambiguous match answers nothing, being worse than none
_VERIFY_COUNTERPART () {
	# Args: <commit> <orig_head> <new_head>
	local C=$1
	local ORIG=$2
	local NEW=$3
	if [ "$C" = "$NEW" ]; then
		print -r -- "$ORIG"
		return 0
	fi
	local BASE=$(git merge-base "$ORIG" "$NEW" 2>/dev/null)
	[ -z "$BASE" ] && return 1
	local SUBJECT=$(git log -1 --format=%s "$C" 2>/dev/null)
	local -a MATCHES
	local LINE
	if [ -n "$SUBJECT" ]; then
		for LINE in ${(f)"$(git log --format="%H%x00%s" "$BASE..$ORIG" 2>/dev/null)"}; do
			[ "${LINE#*$'\0'}" = "$SUBJECT" ] && MATCHES+=("${LINE%%$'\0'*}")
		done
	fi
	if [ ${#MATCHES[@]} -eq 1 ]; then
		print -r -- "${MATCHES[1]}"
		return 0
	fi
	local -a OLD_SPAN NEW_SPAN
	OLD_SPAN=("${(@f)$(git rev-list --reverse "$BASE..$ORIG" 2>/dev/null)}")
	NEW_SPAN=("${(@f)$(git rev-list --reverse "$BASE..$NEW" 2>/dev/null)}")
	[ ${#OLD_SPAN[@]} -ne ${#NEW_SPAN[@]} ] && return 1
	local -i I
	for I in {1..${#NEW_SPAN[@]}}; do
		if [ "${NEW_SPAN[$I]}" = "$C" ]; then
			# Position alone would pair a reorder's commits with whatever now
			# sits where they used to – the subject has to agree there too
			[ "$(git log -1 --format=%s "${OLD_SPAN[$I]}" 2>/dev/null)" = "$SUBJECT" ] || return 1
			print -r -- "${OLD_SPAN[$I]}"
			return 0
		fi
	done
	return 1
}

# Removes what a check left untracked in <worktree>, so the next one – at another commit, in the
# walk, or a resume's – sees that commit and the ignored files alone, as `--exec`'s gate does,
# `clean` without `-x` sparing the links
_VERIFY_CLEAN () {
	# Args: <worktree>
	local P
	for P in ${(f)"$(LC_ALL=C git -C "$1" -c core.quotePath=false clean -fd 2>/dev/null | LC_ALL=C sed -n 's/^Removing //p')"}; do
		(( ${_VERIFY_LITTER[(Ie)$P]} )) || _VERIFY_LITTER+=("$P")
	done
}

# Names what the gate's runs left untracked, once for the whole gate
_VERIFY_NOTE_LITTER () {
	[ ${#_VERIFY_LITTER} -gt 0 ] && PRINT_TEXT "Removed what the check left untracked, so no run saw another's: %s" 90 "$(_JOIN_PATHS "${(F)_VERIFY_LITTER}")"
	return 0
}

# Says who broke the check and where it heals, the two questions a failure raises – the
# counterpart run attributes it, since a check already failing at the commit this one
# replaces was failing before the rewrite, and otherwise the walk climbs the span
_VERIFY_DIAGNOSE () {
	# Args: <worktree> <cmd> <failed> <orig_head> <new_head> <secs> `--` [<path>...]
	local WT=$1
	local CMD=$2
	local FAILED=$3
	local ORIG=$4
	local NEW=$5
	local SECS=$6
	shift 6
	[ "$1" = "--" ] && shift
	local -a PATHS=("$@")

	local CP=$(_VERIFY_COUNTERPART "$FAILED" "$ORIG" "$NEW")
	local P
	# A counterpart lacking a path the command names fails on that alone – the walk then answers
	for P in "${PATHS[@]}"; do
		git -C "$WT" cat-file -e "$CP:$P" 2>/dev/null || CP=""
	done
	if [ -n "$CP" ] && git -C "$WT" checkout -qf --detach "$CP" 2>/dev/null; then
		(cd "$WT" && export GIT_EDIT_VERIFY_COMMIT=$CP && _CALLER_ENV_BACK && eval "$CMD" </dev/null) >/dev/null 2>&1
		local CP_RC=$?
		_VERIFY_CLEAN "$WT"
		if [ $CP_RC -ne 0 ]; then
			PRINT_TEXT "The commit it replaces fails the same check – not this operation's doing (pre-existing, or the check cannot run in this worktree):" 33
			_PRINT_COMMIT_LINE "$CP" '  counterpart: %h %s'
			# Naming the cause without the remedy leaves the reader to find it in the page – the
			# commonest one is what a fresh worktree does not have, said only where nothing is
			# linked at all, so a repo that configured it hears nothing
			if [ -z "$(git config --get-all edit.worktreeLink 2>/dev/null)" ] && [ -z "$GIT_EDIT_WORKTREE_LINK" ]; then
				PRINT_TEXT "Nothing is linked into the isolated worktree – a check needing gitignored files fails there on that alone: %s" 33 "git config --add edit.worktreeLink node_modules"
			fi
			return 0
		fi
	fi

	# An explicit zero (or less) turns the climb off – unset, it is five times
	# the failing run's own duration, floored so a fast check still walks
	local BUDGET_CFG=$(git config --type=int --get edit.verifyBudget 2>/dev/null)
	local -i BUDGET
	if [ -n "$BUDGET_CFG" ]; then
		BUDGET=$BUDGET_CFG
		[ $BUDGET -le 0 ] && return 0
	else
		BUDGET=$(( SECS * 5 ))
		[ $BUDGET -lt 30 ] && BUDGET=30
	fi
	local -a SPAN
	SPAN=("${(@f)$(git rev-list --reverse "$ORIG..$NEW" 2>/dev/null)}")
	# Spent against the wall clock, not summed per run – whole-second deltas
	# round a sub-second check down to nothing, and the budget would never bind
	local -i WALK_T0=$SECONDS CHECKED=0 ABOVE=0
	local X FOUND="" PAST=false SKIP
	for X in "${SPAN[@]}"; do
		if [ "$X" = "$FAILED" ]; then
			PAST=true
			continue
		fi
		[ "$PAST" = "true" ] || continue
		ABOVE+=1
		[ -n "$FOUND" ] && continue
		[ $(( SECONDS - WALK_T0 )) -ge $BUDGET ] && continue
		SKIP=false
		for P in "${PATHS[@]}"; do
			git -C "$WT" cat-file -e "$X:$P" 2>/dev/null || SKIP=true
		done
		[ "$SKIP" = "true" ] && continue
		git -C "$WT" checkout -qf --detach "$X" 2>/dev/null || continue
		CHECKED+=1
		(cd "$WT" && export GIT_EDIT_VERIFY_COMMIT=$X && _CALLER_ENV_BACK && eval "$CMD" </dev/null) >/dev/null 2>&1 && FOUND=$X
		_VERIFY_CLEAN "$WT"
	done
	if [ -n "$FOUND" ]; then
		PRINT_TEXT "The check passes again above it – that commit carries what the failing one now needs:" 33
		_PRINT_COMMIT_LINE "$FOUND" '  first green: %h %s'
	elif [ $CHECKED -gt 0 ]; then
		PRINT_TEXT "No commit above it passes either – %s of %s checked within the walk budget" 33 "$CHECKED" "$ABOVE"
	fi
	return 0
}

# Runs the caller's verification over what a rewrite built, before the CAS applies it – the
# gate for a result that landed semantically wrong yet green, taking `--verify=<cmd>` or a
# standing `edit.verifyCmd`, at the commits a mode names, first rebuilt and resolved ones, the tip
_VERIFY_REWRITE () {
	# Args: <worktree> <new_head> <orig_head> [<commits the mode names, space-separated>]
	#       [<base a replant replayed onto>]
	local WT=$1
	local NEW_HEAD=$2
	local ORIG_HEAD=$3
	local PRIMARY=$4
	# A replant's new base brings the commits its upstream gained, which this run never built –
	# the range the gate reads leaves them out
	local -a BUILT_RANGE=("$NEW_HEAD" --not "$ORIG_HEAD" ${5:+"$5"})
	[ -z "$WT" ] && return 0
	# A worktree gone missing reads as no pass where a check is configured
	if [ ! -d "$WT" ]; then
		[ ${#OPT_NO_VERIFY} -eq 0 ] && _VERIFY_CONFIGURED && { PRINT_ERR "No worktree at $WT to verify in – not applied"; return 1; }
		return 0
	fi
	# Below the worktree guard, so the note marks a gate this run declined rather than one the
	# mode never had – `--abort`, `--undo` and `--status` never reach here at all
	[ ${#OPT_NO_VERIFY} -gt 0 ] && { _VERIFY_NOTE_BYPASS; return 0; }
	# Flag first, then what the pause recorded – a resume re-verifies what the
	# original run asked for – then the standing config
	local VERIFY_CMD=$VERIFY_VALUE
	[ -z "$VERIFY_CMD" ] && VERIFY_CMD=$STATE_VERIFY_CMD
	[ -z "$VERIFY_CMD" ] && VERIFY_CMD=$(git config --get edit.verifyCmd 2>/dev/null)
	# A pause persists the command as one `key=value` line, and a resume would
	# read back only its first line – a truncated check that can still exit 0
	if [ "$VERIFY_CMD" != "${VERIFY_CMD%%$'\n'*}" ]; then
		PRINT_ERR "The verify command spans multiple lines – a pause could only carry its first"
		ECHO_E "\e[0;31m  Put it in a script and name that instead.\e[0m" >&2
		exit 1
	fi
	if [ -z "$VERIFY_CMD" ]; then
		# Only an explicit ask is an error here – a standing `edit.verifySpan`
		# names a tier, not a check, so with no command it stays inert rather
		# than refusing every operation in the repo that set it
		if [ ${#OPT_VERIFY_SPAN} -gt 0 ] || [ "$STATE_VERIFY_SPAN" = "1" ]; then
			PRINT_ERR "--verify-span needs a command – pass --verify=<cmd> or set edit.verifyCmd"
			exit 1
		fi
		return 0
	fi
	local -a COMMITS
	local SPANNED=false
	# Unquoted, so an empty span yields no element – the quoted form yields one blank
	local -a REBUILT=(${(f)"$(git rev-list --reverse "${BUILT_RANGE[@]}" 2>/dev/null)"})
	if _VERIFY_SPAN_ON; then
		COMMITS=("${REBUILT[@]}")
		[ ${#COMMITS[@]} -gt 0 ] && SPANNED=true
	fi
	# The commits the mode names, and the first one it rebuilt, which a commit moved up or
	# dropped leaves without what sat below it
	local -a PRIMARIES=(${=PRIMARY} ${REBUILT[1]})
	# Every rebuilt commit carrying a tree a resolver staged – git replayed the rest, and a later
	# commit can heal a wrong resolution before the tip ever shows it
	local -a RESOLVED_TREES=(${=STATE_RESOLVED}) RESOLVED_HITS=()
	local LINE H
	if [ ${#RESOLVED_TREES[@]} -gt 0 ]; then
		for LINE in ${(f)"$(git log --reverse --topo-order --format='%H %T' "${BUILT_RANGE[@]}" 2>/dev/null)"}; do
			H=${LINE%% *}
			[ "$H" = "$NEW_HEAD" ] && continue
			(( ${RESOLVED_TREES[(Ie)${LINE#* }]} )) && RESOLVED_HITS+=("$H")
		done
	fi
	# What the default tier runs – those, the resolved ones and the tip, in history order so the
	# oldest failure is the one it stops at – so the span tier can state what it ran beyond that
	local -a DEFAULT_SET=()
	for H in "${REBUILT[@]}"; do
		[ "$H" != "$NEW_HEAD" ] && (( ${PRIMARIES[(Ie)$H]} || ${RESOLVED_HITS[(Ie)$H]} )) && DEFAULT_SET+=("$H")
	done
	# A primary the replay didn't rebuild still runs, first as it always did
	for H in "${PRIMARIES[@]}"; do
		[ "$H" = "$NEW_HEAD" ] || (( ${DEFAULT_SET[(Ie)$H]} )) || DEFAULT_SET=("$H" "${DEFAULT_SET[@]}")
	done
	DEFAULT_SET+=("$NEW_HEAD")
	local -i DEFAULT_N=${#DEFAULT_SET[@]}
	# A span is empty where the result is a commit the branch already had – a dropped tip
	# rebuilds nothing – and the tip it lands is still checked, as on the default tier
	local -i RESOLVED_N=0
	if [ ${#COMMITS[@]} -eq 0 ]; then
		COMMITS=("${DEFAULT_SET[@]}")
		RESOLVED_N=${#RESOLVED_HITS[@]}
	fi
	# Repo files the command references – each token, a leading `-flag=` or `./` stripped, that
	# names a path at the result tip, since a verified commit missing one can only die on it
	# spuriously, so it skips with a note and the tip itself always runs
	local -a CMD_PATHS=()
	local TOK
	local P
	for TOK in ${(z)VERIFY_CMD}; do
		P=${(Q)TOK}
		P=${P#-*=}
		P=${P#./}
		[ -n "$P" ] && git -C "$WT" cat-file -e "$NEW_HEAD:$P" 2>/dev/null && CMD_PATHS+=("$P")
	done
	PRINT_CMD "$VERIFY_CMD # verify ${#COMMITS[@]} commit(s)" 90
	local C
	local OUT
	local OUT_FILE
	local ABSENT
	local RUN_T0
	_VERIFY_LITTER=()
	local -i SKIPPED=0
	local -i RC=0 RUN_SECS=0
	local -i POSITION=0
	# The whole gate's clock – the price a caller learns from this run and spends on the next
	local -i VERIFY_T0=$SECONDS
	# A resume reads the worktree's `HEAD` as the result, which each check below moves – so a pause
	# this run holds records the result first, for the resume after a run cut off midway – never a
	# gate with no pause to resume, as a split's checks in a throwaway worktree
	if [ "$STATE_VERIFY_RESULT" != "$NEW_HEAD" ] && [ "$_VERIFY_NO_RESUME" != true ]; then
		_STATE_NOTE "verify_result=$NEW_HEAD"
		[ -n "$_STATE_OWNED" ] && STATE_VERIFY_RESULT=$NEW_HEAD
	fi
	for C in "${COMMITS[@]}"; do
		POSITION+=1
		ABSENT=""
		for P in "${CMD_PATHS[@]}"; do
			if ! git -C "$WT" cat-file -e "$C:$P" 2>/dev/null; then
				ABSENT=$P
				break
			fi
		done
		if [ -n "$ABSENT" ]; then
			PRINT_TEXT "Verify skipped at %s – \`%s\` doesn't exist at this commit" 90 "${C:0:7}" "$ABSENT"
			SKIPPED+=1
			continue
		fi
		if ! git -C "$WT" checkout -qf --detach "$C" 2>/dev/null; then
			PRINT_ERR "Cannot check out ${C:0:7} for verification"
			_VERIFY_FAILED=$C
			return 1
		fi
		# Named as its check starts, since the span tier can run for minutes – on a terminal, or
		# where a caller showing progress sets `GIT_EDIT_PROGRESS`, as a captured run would carry a
		# line per commit that nobody watches live
		if [ -t 1 ] || [ -n "$GIT_EDIT_PROGRESS" ]; then
			# Through `git log`, as `ECHO_E` would read escapes in the subject, and not as "Verif…",
			# which the documented `^(Verif|Tip tree|Trees|git-edit:)` grep keeps to the outcome
			_PRINT_COMMIT_LINE "$C" "Checking $POSITION of ${#COMMITS[@]} – %h %s"
		fi
		# The subshell contains both the cd and the export naming the commit – exported, since a
		# prefix assignment on the `eval` builtin never reaches the child it forks
		# Into a file, as `$(…)` would wait on every process holding its pipe –
		# a server the check left running included
		OUT_FILE=$(MKTEMP_FILE git-edit-verify-out) || exit 1
		_TEMP_FILES+=("$OUT_FILE")
		RUN_T0=$SECONDS
		(cd "$WT" && export GIT_EDIT_VERIFY_COMMIT=$C && _CALLER_ENV_BACK && eval "$VERIFY_CMD" </dev/null) >"$OUT_FILE" 2>&1
		RC=$?
		OUT=$(<"$OUT_FILE")
		rm -f "$OUT_FILE"
		_VERIFY_CLEAN "$WT"
		# Taken here rather than at the diagnosis below, which the printing in
		# between would pad – the walk budget is the failing run's own duration
		RUN_SECS=$(( SECONDS - RUN_T0 ))
		if [ $RC -ne 0 ]; then
			PRINT_ERR "Verification failed at ${C:0:7} – nothing was applied"
			_PRINT_COMMIT_LINE "$C" '  failing: %h %s'
			[ -n "$OUT" ] && print -r -- "$OUT" | tail -15 | _CARET_LINES --crlf | LC_ALL=C sed "s/^/${_DIM}  | /;s/\$/${_OFF}/" >&2
			PRINT_TEXT "Command: %s (exit %s, %ss)" 33 "$VERIFY_CMD" "$RC" "$RUN_SECS"
			_VERIFY_SAVE_LOG "$C" "$VERIFY_CMD" "$RC" "$RUN_SECS" "$OUT"
			# Attribution and the healing point, run in the worktree the gate already owns – then back
			# to the result tip, since every resume path reads the worktree's `HEAD` as the result,
			# and one left at a walked commit would land that commit as the new tip
			_VERIFY_DIAGNOSE "$WT" "$VERIFY_CMD" "$C" "$ORIG_HEAD" "$NEW_HEAD" "$RUN_SECS" -- "${CMD_PATHS[@]}"
			_VERIFY_NOTE_LITTER
			git -C "$WT" checkout -qf --detach "$NEW_HEAD" 2>/dev/null
			# A mode with no pause keeps neither the worktree nor a resume, so both hints
			# would point at what its exit is about to remove – it names its own recourse
			if [ "$_VERIFY_NO_RESUME" != true ]; then
				PRINT_TEXT "Inspect the failing state: %s" 33 "git -C $(_SHQ "$WT") checkout ${C:0:7}"
				# The content-edit pause invites exactly the opposite instinct, so say
				# which one this is: the result is built, and a resume checks out over
				# anything authored here
				PRINT_TEXT "Editing there is not the repair – a resume refuses rather than fold it in. Apply with %s, then fix that commit with %s" 33 \
					"--no-verify --continue" "git edit ${C:0:7}"
			fi
			_VERIFY_FAILED=$C
			return 1
		fi
	done
	local -i VERIFY_SECS=$(( SECONDS - VERIFY_T0 ))
	_VERIFY_NOTE_LITTER
	# End at the tip, so the worktree a later step or reader sees is the result
	git -C "$WT" checkout -qf --detach "$NEW_HEAD" 2>/dev/null
	# One line for the whole outcome, since that is the line a caller greps: a bare "Verified 2
	# commit(s)" over a span of seven reads as verified when it was sampled, and a second line
	# carrying the shortfall is a second line to miss
	# So the denominator is what the rewrite built, and every commit short of it is named with its
	# reason – the tier that closes the gap included, which helps nobody who never learns it exists
	# A dropped tip rebuilds nothing yet verifies where it lands, so its built count can be lower
	local RAN=$(( ${#COMMITS[@]} - SKIPPED ))
	local BUILT=$(git rev-list --count "${BUILT_RANGE[@]}" 2>/dev/null)
	local -i TOTAL=${#COMMITS[@]}
	if [ -n "$BUILT" ] && [ $BUILT -gt $TOTAL ]; then
		TOTAL=$BUILT
	fi
	local -a SHORT=()
	[ $RESOLVED_N -gt 0 ] && SHORT+=("$RESOLVED_N of them resolved at a stop")
	[ $SKIPPED -gt 0 ] && SHORT+=("$SKIPPED skipped where a path the command names is absent")
	[ $(( TOTAL - ${#COMMITS[@]} )) -gt 0 ] && SHORT+=("$(( TOTAL - ${#COMMITS[@]} )) unchecked in between, \`--verify-span\` covers them (also: edit.verifySpan)")
	# The span tier's mirror of that note: what it ran beyond the default tier, with the lever
	# that steps one run back down – only where the standing config raised the tier, since a
	# run that passed the flag chose the cost
	# The elapsed rides on every line, both tiers: a caller picks its flags before running, so
	# the price that reaches it in time is the previous run's
	local -i BEYOND=$(( ${#COMMITS[@]} - DEFAULT_N ))
	if [ "$SPANNED" = true ] && [ $BEYOND -gt 0 ] && [ ${#OPT_VERIFY_SPAN} -eq 0 ] \
		&& [ "$(git config --type=bool --get edit.verifySpan 2>/dev/null)" = "true" ]; then
		SHORT+=("$BEYOND beyond the default tier, \`--no-verify-span\` runs only its $DEFAULT_N (set by edit.verifySpan)")
	fi
	local FMT="Verified %s commit(s) with \`%s\` in %ss"
	local -a ARGS=("$RAN" "$VERIFY_CMD" "$VERIFY_SECS")
	if [ $RAN -lt $TOTAL ]; then
		FMT="Verified %s of %s commit(s) with \`%s\` in %ss"
		ARGS=("$RAN" "$TOTAL" "$VERIFY_CMD" "$VERIFY_SECS")
	fi
	if [ ${#SHORT[@]} -gt 0 ]; then
		FMT+=" – %s"
		ARGS+=("${(j:, :)SHORT}")
	fi
	PRINT_TEXT "$FMT" 90 "${ARGS[@]}"
	return 0
}

# `--continue` and `--abort` often run from inside the operation's own worktree, where
# `HEAD` is a detached commit rather than the branch – so the trailer's "before" comes
# from the branch the operation will move, and it is a no-op from the main checkout
_REANCHOR_INITIAL_HEAD () {
	local TIP
	TIP=$(git rev-parse "${STATE_BRANCH:-HEAD}" 2>/dev/null)
	[ -n "$TIP" ] && SCRIPT_INITIAL_HEAD=$TIP
}

# Resumes an in-flight `--amend-into` once the conflicts are resolved – the caller edits
# the files in `$STATE_WORKTREE` and stages them before calling this
_CONTINUE_AMEND_INTO () {
	# The reword happens before the replay starts, so the commits being
	# resolved already carry the message – accepting one here would silently
	# do nothing
	if [ -n "$TEXT_VALUE" ]; then
		PRINT_ERR "--amend-into takes --text up front, not on --continue – the replay already carries the message"
		ECHO_E "\e[0;31m  Finish this fold, then reword: git edit -M --text=\"…\" <sha>\e[0m" >&2
		exit 1
	fi

	if [ ! -d "$STATE_WORKTREE" ]; then
		PRINT_ERR "Worktree no longer exists: $STATE_WORKTREE"
		_CLEAR_STATE
		exit 1
	fi

	cd "$STATE_WORKTREE" || exit 1

	# Once we successfully complete, the worktree should be cleaned up
	_CLEANUP_HOOK="git worktree remove --force ${(q-)STATE_WORKTREE} 2>/dev/null; rm -rf ${(q-)STATE_WORKTREE}"

	PRINT_ACTION "Continuing amend-into of %s..." "${STATE_TARGET:0:7}"

	# If no rebase is in progress but `HEAD` has moved on, the resolution was
	# completed manually (e.g. `git rebase --continue` run in the worktree
	# directly) – skip straight to applying the result instead of stranding it
	local GITDIR=$(git rev-parse --git-dir 2>/dev/null)
	if [ ! -d "$GITDIR/rebase-merge" ] && [ ! -d "$GITDIR/rebase-apply" ]; then
		_REQUIRE_REPLAY_DONE "$STATE_WORKTREE"
		if [ "$(git rev-parse HEAD)" = "$STATE_ORIG_HEAD" ]; then
			# Finished with nothing folded – the fixup skipped by hand, every remaining pick
			# fast-forwarded – refused as a resolution taking the target's side is below, the staging kept
			_CLEANUP_HOOK=""
			PRINT_ERR "The fold left history unchanged – its fixup was skipped in the worktree, so nothing was applied"
			PRINT_TEXT "Cancel with %s, which leaves your staging as it is, then fold again." 33 "git edit --abort"
			_PAUSE_EXIT 1 retry
		fi
		# Back on the fold's own fixup – a `git rebase --abort` in the worktree – nothing was folded
		[ -n "$STATE_FIXUP" ] && [ "$(git rev-parse HEAD)" = "$STATE_FIXUP" ] && _REFUSE_HAND_ABORT
		_GUARD_HAND_FINISH "$STATE_WORKTREE" ${STATE_FIXUP:+"$STATE_FIXUP"}
		_NOTE_STOPS_PASSED "$STATE_WORKTREE"
		PRINT_TEXT "%s – applying its result." 33 "Rebase already completed in worktree"
	else
		# The rebase in progress is the run's own, started from the fold's fixup – one begun there by
		# hand would land whatever it built
		if [ -n "$STATE_FIXUP" ] && { [ ! -d "$GITDIR/rebase-merge" ] || [ "$(<"$GITDIR/rebase-merge/orig-head")" != "$STATE_FIXUP" ]; }; then
			_CLEANUP_HOOK=""
			PRINT_ERR "The rebase in progress in $STATE_WORKTREE is not this fold's – nothing was applied"
			ECHO_E "\e[0;31m  Finish or abort it there ('git -C $(_LIT "$(_SHQ "$STATE_WORKTREE")") rebase --abort'), or cancel with 'git edit --abort'.\e[0m" >&2
			_PAUSE_EXIT 1 retry
		fi
		_NOTE_STOPS_PASSED "$STATE_WORKTREE" ${STATE_FIXUP:+"$STATE_FIXUP"}
		_REQUIRE_PICKS_KEPT "$STATE_WORKTREE"
		_STAGE_MARKS_GONE "$STATE_WORKTREE"
		_GUARD_RESOLUTION_CLEAN "$STATE_WORKTREE"
		_GUARD_STOP_MODES "$STATE_WORKTREE"
		_NOTE_RESOLVED_TREE "$STATE_WORKTREE"
		_NOTE_LET_GO "$STATE_WORKTREE"
		_CLEAR_RESCHEDULED_PICK "$STATE_WORKTREE"
		_RESUME_EDITOR "$STATE_WORKTREE"
		local CMD="GIT_SEQUENCE_EDITOR=true GIT_EDITOR=${(q)$(_SH_WORD "$REPLY")} git -c commit.cleanup=verbatim -c rerere.enabled=true -c rerere.autoUpdate=false -c rebase.updateRefs=false -c advice.mergeConflict=false -c advice.resolveConflict=false $_CAPTURE_PINS rebase --continue"
		PRINT_CMD "$CMD"
		local CONTINUE_OUTPUT
		if ! CONTINUE_OUTPUT=$(_RENORM_EVAL "$STATE_WORKTREE" "$CMD" "$CMD") && \
		   ! { _AUTO_RESOLVE_FINAL_STEP "$STATE_WORKTREE" "$STATE_STAGEDTREE" guard-empty && _FINISH_AUTO_RESOLVED_STEP "$STATE_WORKTREE" "staged" }; then
			# Another conflict downstream – keep state, keep worktree, exit
			_CLEANUP_HOOK=""
			REBASE_OUT=$CONTINUE_OUTPUT
			_REBASE_RESOLVABLE "$STATE_WORKTREE" "$REBASE_OUT" || _REFUSE_REBASE_FAILED resume
			_PRINT_RESUME_REFUSED "$STATE_WORKTREE" "$REBASE_OUT"
			PRINT_TEXT "Worktree: %s" 33 "$STATE_WORKTREE"
			local UNMERGED_LIST=$(_PRINT_CONFLICT_DETAIL "$STATE_WORKTREE" "" "$CONTINUE_OUTPUT")
			PRINT_TEXT "Or abort the operation: %s" 33 "git edit --abort"
			EMIT_CONFLICT "$STATE_WORKTREE" "$UNMERGED_LIST"
			_PAUSE_EXIT 2 conflict
		fi
	fi

	local NEW_HEAD=$(git rev-parse HEAD)
	_GUARD_ABSORBED "$STATE_WORKTREE" "$NEW_HEAD"
	_REQUIRE_PICKS_KEPT "$STATE_WORKTREE"

	# A resolution taking the target's side folds nothing, as a first run finding that refuses –
	# landing it would journal a move that isn't one and re-sync the staging away – every commit
	# then holds the tree it held, where a fold a later commit overrides changes the target's
	local SPAN_FROM=${STATE_REBASEBASE:#--root}
	if [ "$(git log --format=%T ${SPAN_FROM:+"$SPAN_FROM.."}"$NEW_HEAD" 2>/dev/null)" = "$(git log --format=%T ${SPAN_FROM:+"$SPAN_FROM.."}"$STATE_ORIG_HEAD" 2>/dev/null)" ]; then
		_CLEANUP_HOOK=""
		PRINT_ERR "The fold left history unchanged – ${STATE_TARGET:0:7} already carries that content, so nothing was applied"
		PRINT_TEXT "Cancel with %s, which leaves your staging as it is, then fold again resolving to your side." 33 "git edit --abort"
		_PAUSE_EXIT 1 retry
	fi

	local VERIFY_PRIMARY=""
	if [ "$STATE_REBASEBASE" = "--root" ]; then
		VERIFY_PRIMARY=$(git rev-list --reverse "$NEW_HEAD" 2>/dev/null | head -1)
	elif [ -n "$STATE_REBASEBASE" ]; then
		VERIFY_PRIMARY=$(git rev-list --reverse "$STATE_REBASEBASE..$NEW_HEAD" 2>/dev/null | head -1)
	fi
	# Bar a branch holding this result already, which a run cut off after landing it left there
	_VERIFY_CONFIGURED && [ "$(git rev-parse -q --verify "$STATE_BRANCH" 2>/dev/null)" != "$NEW_HEAD" ] && \
		_REQUIRE_CURRENT "$STATE_BRANCH" "${STATE_HEAD_WITH_FIXUP:-$STATE_ORIG_HEAD}"
	if ! _GUARD_TIP_MODES "$STATE_WORKTREE" "$NEW_HEAD" "$STATE_ORIG_HEAD" "$(_MODE_LINES "$STATE_WORKTREE" "$STATE_ORIG_HEAD" "$STATE_STAGEDTREE")" || ! _VERIFY_REWRITE "$STATE_WORKTREE" "$NEW_HEAD" "$STATE_ORIG_HEAD" "$VERIFY_PRIMARY"; then
		_CLEANUP_HOOK=""
		EMIT_GATE_PAUSED "$STATE_WORKTREE" "$NEW_HEAD"
		_PAUSE_EXIT 2 gate
	fi

	# Atomic CAS-update of the branch ref – new-format states guard on the pre-op tip, the
	# branch never having moved, while legacy states guard on the fixup tip
	local GUARD=$STATE_ORIG_HEAD
	[ -n "$STATE_HEAD_WITH_FIXUP" ] && GUARD=$STATE_HEAD_WITH_FIXUP
	local UPDATE_CMD="git update-ref -m ${(q-)${:-git edit: amend-into ${STATE_TARGET:0:7}$_REFLOG_TAG}} ${(q-)STATE_BRANCH} ${(q-)NEW_HEAD} ${(q-)GUARD}"
	# A run cut off after its landing left the branch at this very result –
	# it landed, and only the record of it is missing
	if [ "$(git rev-parse "$STATE_BRANCH" 2>/dev/null)" = "$NEW_HEAD" ]; then
		PRINT_TEXT "%s – completing what it left." 33 "The branch holds this result already, a run landing it cut off"
		# Checked and recorded in one hold of the journal's lock, as a landing is
		_SLOT_LOCK "$_STATE_OWNED" "nothing was applied"
		local JF=${REPLY:-$_JOURNAL_HELD}
		_REQUIRE_OWN_PAUSE
		if command grep -qF " $STATE_BRANCH $GUARD $NEW_HEAD " "$JF" 2>/dev/null; then
			_JOURNAL_UNLOCK "$JF"
		else
			_RECORD_REF_MOVE "$STATE_BRANCH" "$GUARD" "$NEW_HEAD" "amend-into ${STATE_TARGET:0:7}"
		fi
	else
		PRINT_CMD "$UPDATE_CMD" 90
		if ! _MOVE_REF "$UPDATE_CMD"; then
			_REFUSE_MOVED_BRANCH "$STATE_BRANCH" "$STATE_WORKTREE"
		fi
		_RECORD_REF_MOVE "$STATE_BRANCH" "$GUARD" "$NEW_HEAD" "amend-into ${STATE_TARGET:0:7}"
	fi

	# Re-sync the folded paths' index entries to the new `HEAD`, those staged changes being
	# history now – path-scoped so a parallel session's staged work survives, and legacy
	# states without a file list fall back to a full reset – a `--tree` fold staged nothing, so
	# the summary reconciles its entries like any other rewrite's instead
	AMEND_TREE=$STATE_TREE
	if [ -n "$STATE_MAINDIR" ] && [ -z "$AMEND_TREE" ]; then
		if [ -n "$STATE_FILES" ]; then
			local -a SYNC_PATHS
			SYNC_PATHS=("${(@Q)${(z)STATE_FILES}}")
			_RESYNC_FOLDED "$STATE_MAINDIR" "$STATE_STAGEDTREE" "${SYNC_PATHS[@]}"
		else
			_LANDED_RUN git -C "$STATE_MAINDIR" read-tree --reset "$NEW_HEAD" 2>/dev/null
		fi
	fi

	# The fold's scope decides how the leftover index reads – restore it, or a
	# scoped fold that conflicted would report its intended leftovers as an anomaly
	[ -n "$STATE_PATHSPECS" ] && AMEND_PATHSPECS=("${(@Q)${(z)STATE_PATHSPECS}}")
	[ -n "$STATE_DEPTH" ] && _PRINT_AMENDED_SUMMARY "$NEW_HEAD" "$STATE_DEPTH" "" "$STATE_MAINDIR" "$STATE_REBASEBASE" "$STATE_ORIG_HEAD" "$STATE_STAGEDTREE" resolved

	_CLEAR_STATE
	PRINT_COMPLETED "$NEW_HEAD" "$STATE_BRANCH" true
}

# Aborts an in-flight `--amend-into` – abort the paused rebase and remove the worktree, with
# nothing to roll back since the branch never moved and the staging was never consumed
# Legacy pre-invisible-fixup states carry a `head_with_fixup` tip and get the old rollback
_ABORT_AMEND_INTO () {
	PRINT_ACTION "Aborting amend-into of %s..." "${STATE_TARGET:0:7}"
	# A run cut off after its landing left the branch at the worktree's result – there is nothing
	# to take back, only the pause to clear
	local LANDED=""
	_ABORT_TAKE_PAUSE "amend-into ${STATE_TARGET:0:7}"

	# Cleanup the worktree (which is in a paused rebase state)
	if _PAUSE_WT_HERE; then
		_LANDED_RUN git -C "$STATE_WORKTREE" rebase --abort 2>/dev/null
		local CMD="git worktree remove --force ${(q-)STATE_WORKTREE} 2>/dev/null; rm -rf ${(q-)STATE_WORKTREE}"
		PRINT_CMD "$CMD" 90
		_LANDED_RUN eval "$CMD"
	fi

	# Legacy-format state only: roll back the fixup commit on the branch, if
	# the ref is still where that old flow left it
	if [ -n "$STATE_HEAD_WITH_FIXUP" ]; then
		local CURRENT=$(git rev-parse "$STATE_BRANCH" 2>/dev/null)
		if [ "$CURRENT" = "$STATE_HEAD_WITH_FIXUP" ]; then
			local UPDATE_CMD="git update-ref -m ${(q-)${:-git edit: abort amend-into$_REFLOG_TAG}} ${(q-)STATE_BRANCH} ${(q-)STATE_ORIG_HEAD} ${(q-)STATE_HEAD_WITH_FIXUP}"
			PRINT_CMD "$UPDATE_CMD" 90
			_MOVE_REF "$UPDATE_CMD"
			git read-tree "$STATE_HEAD_WITH_FIXUP" 2>/dev/null
		else
			PRINT_TEXT "%s – branch moved since fixup; leaving as-is to avoid clobbering other commits." 33 "Note"
		fi
	elif [ -n "$LANDED" ]; then
		PRINT_TEXT "The fold had landed already, before its run cleared the pause – nothing to take back." 33
	else
		if [ -n "$STATE_TREE" ]; then
			PRINT_TEXT "Branch was never touched – the tree is intact, ready to retry." 32
		else
			PRINT_TEXT "Branch was never touched – %s still in place, ready to retry." 32 "$(_FOLD_SOURCE)"
		fi
	fi

	_UNREGISTER_GONE_WORKTREE "$STATE_WORKTREE"
	PRINT_TEXT "%s" 32 "Amend-into aborted, state cleared."
	EMIT_STATUS "$STATE_ORIG_HEAD" "$STATE_BRANCH" false
}

# Detects non-interactive execution – an agent, CI or a scripted run – which gets no prompt,
# confirm or editor, and leaves a sync's conflicting merge to whoever owns the edits: no terminal
# on stdin or stdout, as output piped away hides a prompt, or `$CLAUDECODE`, `$CI` or a
# `GIT_EDIT_ACTOR` label set, backstops for a PTY-allocating agent
_IS_NON_INTERACTIVE () {
	# A landing step holding its output back leaves a terminal's run one
	if [ ! -t 0 ] || { [ ! -t 1 ] && [ -z "$_STEP_TTY" ]; }; then return 0; fi
	if [ -n "$CLAUDECODE" ] || [ -n "$CI" ] || [ -n "$GIT_EDIT_ACTOR" ]; then return 0; fi
	return 1
}

# Resolves a usable editor command, matching git's own cascade – `GIT_EDITOR`, `core.editor`,
# `VISUAL` unless the terminal is dumb, `EDITOR`, then vi – skipping the `true` no-op that
# automation commonly sets, which the plumbing modes that need typing could not work with
_RESOLVE_EDITOR () {
	local CAND
	local -a CANDS=("$GIT_EDITOR" "$(git config core.editor 2>/dev/null)")
	[ "$TERM" = dumb ] || CANDS+=("$VISUAL")
	CANDS+=("$EDITOR")
	for CAND in "${CANDS[@]}"; do
		[ -z "$CAND" ] && continue
		[ "$CAND" = "true" ] && continue
		print -r -- "$CAND"
		return 0
	done
	# A dumb terminal gets no vi fallback, as git refuses there too
	[ "$TERM" = dumb ] && return 1
	print -r -- vi
}

# Bails out before opening an editor in a non-TTY context, where it would either no-op
# silently, hang waiting for input as vi or nano do, or open a GUI editor with `-w` and
# never return, or where none resolves – call this right before any path that would open `$EDITOR`
_REQUIRE_TTY_FOR_EDITOR () {
	if _IS_NON_INTERACTIVE; then
		PRINT_ERR "Cannot open editor in non-interactive context (no TTY / agent run)"
		ECHO_E "\e[0;31m  Pass --text \"<msg>\" for an inline message, or --text - to read from stdin.\e[0m" >&2
		exit 1
	fi
	if ! _RESOLVE_EDITOR >/dev/null; then
		PRINT_ERR "Terminal is dumb, but EDITOR unset"
		ECHO_E "\e[0;31m  Set EDITOR, or pass --text \"<msg>\" for an inline message.\e[0m" >&2
		exit 1
	fi
}

# Puts into `REPLY` the comment string `stripspace` strips – the last one configured, either key,
# and `#` for `auto`, as only `git commit` picks another
_COMMENT_STRING () {
	# Asked of git, as git before 2.45 knows no `core.commentString` and strips `#` lines under one
	REPLY=$(print -r -- x | git stripspace -c 2>/dev/null)
	REPLY=${REPLY% x}
	[[ -z "$REPLY" || "$REPLY" == *$'\n'* ]] && REPLY='#'
	return 0
}

# Puts into `_MSG_CC`, `_MSG_CLEANUP` and `_MSG_PIN` how an editor seeded with <text> comments and
# cleans up, as `git commit` would – `commit.cleanup`'s mode, strip where none or `default`, and
# under `core.commentChar=auto` the first of git's candidates no line of the text starts with,
# pinned for every git reading it, since `stripspace` and the sequencer read `auto` as `#`
_MSG_STYLE () {
	# Args: <the message(s) the editor is seeded with>
	local T=$1 V C
	_MSG_PIN=()
	_MSG_CLEANUP=$(git config commit.cleanup 2>/dev/null)
	[[ "$_MSG_CLEANUP" == (whitespace|verbatim|scissors) ]] || _MSG_CLEANUP=strip
	_COMMENT_STRING
	_MSG_CC=$REPLY
	# The last of either key wins, as git reads them
	V=$(git config --get-regexp '^core\.comment(char|string)$' 2>/dev/null | tail -1)
	[[ "${(L)V#* }" == auto ]] || return 0
	if [[ "$T" == *'#'* ]]; then
		_MSG_CC=""
		for C in '#' ';' '@' '!' '$' '%' '^' '&' '|' ':'; do
			[[ "${T[1]}" == "$C" || "$T" == *[$'\n\r']"$C"* ]] && continue
			_MSG_CC=$C
			break
		done
		if [ -z "$_MSG_CC" ]; then
			PRINT_ERR "core.commentChar=auto finds no comment character the message leaves unused – nothing was changed"
			ECHO_E "\e[0;31m  Set core.commentChar to one, or pass --text \"<msg>\" instead of the editor.\e[0m" >&2
			return 1
		fi
	fi
	_MSG_PIN=(-c "core.commentChar=$_MSG_CC")
}

# Prints the help an editor seeded under `_MSG_STYLE` ends on, worded as `git commit` words it for
# that mode – a scissors line first where everything below it goes
_MSG_HELP () {
	# Args: <lead line>
	local CC=$_MSG_CC
	case $_MSG_CLEANUP in
		scissors)
			print -r -- "$CC ------------------------ >8 ------------------------"
			print -r -- "$CC Do not modify or remove the line above."
			print -r -- "$CC Everything below it will be ignored."
			print -r -- "$CC $1" ;;
		strip)
			print -r -- "$CC $1"
			print -r -- "$CC Lines starting with '$CC' will be ignored."
			print -r -- "$CC An empty message aborts the operation." ;;
		*)
			print -r -- "$CC $1"
			print -r -- "$CC Lines starting with '$CC' will be kept; you may remove them yourself if you want to."
			print -r -- "$CC An empty message aborts the operation." ;;
	esac
}

# Puts into `REPLY` the `sh` command cleaning up the message file `$1` in place under `_MSG_STYLE`'s
# mode – comments stripped, whitespace alone, nothing, or everything from the scissors line on cut
_MSG_CLEANUP_SH () {
	local CMD
	case $_MSG_CLEANUP in
		verbatim) REPLY=":"; return 0 ;;
		whitespace) CMD='git stripspace < "$1"' ;;
		# The cut line as an argument, which `awk` takes as it stands where `-v` reads escapes
		scissors) CMD="awk 'BEGIN { c = ARGV[2]; ARGV[2] = \"\" } \$0 == c { exit } { print }' \"\$1\" ${(qq):-$_MSG_CC ------------------------ >8 ------------------------} | git stripspace" ;;
		*)
			CMD="git stripspace --strip-comments < \"\$1\""
			(( ${#_MSG_PIN} )) && CMD="git ${(j: :)${(qq)_MSG_PIN[@]}} stripspace --strip-comments < \"\$1\"" ;;
	esac
	REPLY="$CMD > \"\$1.ge-msg\" && mv -f \"\$1.ge-msg\" \"\$1\""
}

# Runs `_MSG_STYLE` for `-m`'s editor on a squash, over the messages of the <commit>s it combines,
# and makes `_MSG_TYPED`, the file the editor's stand-in leaves what was typed in
_SQUASH_MSG_STYLE () {
	local C T=""
	if [ -z "$_MSG_TYPED" ]; then
		_MSG_TYPED=$(MKTEMP_FILE git-edit-typed) || return 1
		_TEMP_FILES+=("$_MSG_TYPED")
	fi
	for C in "$@"; do
		T+=$(git log -1 --format=%B "$C" 2>/dev/null)$'\n'
	done
	_MSG_STYLE "$T"
}

# Puts the editor a person types a message in into `_REAL_EDITOR`, once a run – a stand-in running
# it in the caller's own environment, as git starts it in git-edit's, pins and all
_RESOLVE_REAL_EDITOR () {
	[ -n "$_REAL_EDITOR" ] && return 0
	local ED
	ED=$(_RESOLVE_EDITOR) || return 1
	_REAL_EDITOR=$(MKTEMP_FILE git-edit-editor) || return 1
	_TEMP_FILES+=("$_REAL_EDITOR")
	{ print -r -- '#!/bin/sh'; _CALLER_ENV_SH; print -r -- "$ED \"\$@\"" } > "$_REAL_EDITOR"
	chmod +x "$_REAL_EDITOR"
}

# Opens the resolved editor on the given temp file, through `sh` as git runs one, and prints the
# contents cleaned up under `_MSG_STYLE`'s mode – user-facing output on stderr, so it cannot leak
# into the captured value
_READ_MESSAGE_FROM_EDITOR () {
	local MSG_FILE=$1
	_RESOLVE_REAL_EDITOR || return 1
	PRINT_CMD "$(_RESOLVE_EDITOR) $MSG_FILE" >&2
	"$_REAL_EDITOR" "$MSG_FILE" >&2 || return 1
	_MSG_CLEANUP_SH
	sh -c "$REPLY" sh "$MSG_FILE" || return 1
	cat -- "$MSG_FILE"
}

# Whether `git replay` can rebuild a span, probed once per run – absent before git 2.44,
# and from 2.53 it updates refs by default, where `--ref-action=print` keeps it a pure
# computation, the flag traveling in `_REPLAY_FLAGS`
_REPLAY_PROBED=""
_REPLAY_FLAGS=()
_REBUILT_VIA_REPLAY=false
_REPLAY_AVAILABLE () {
	if [ -z "$_REPLAY_PROBED" ]; then
		_REPLAY_PROBED=no
		local USAGE=$( export LC_ALL=C; git replay -h 2>&1 )
		if [[ "$USAGE" == *"--advance"* ]]; then
			[[ "$USAGE" == *"--ref-action"* ]] && _REPLAY_FLAGS=(--ref-action=print)
			_REPLAY_PROBED=yes
		fi
	fi
	[ "$_REPLAY_PROBED" = yes ]
}

# Rebuilds a linear `$1..HEAD` in one `git replay` pass where the walk below spawns two
# gits per commit – a 250-deep reword drops from ~3s to ~0.3s, and the result is taken
# only once every replayed commit carries its original's tree, author and message
_REPLAY_REBUILD () {
	local FROM=$1
	[ -n "$GIT_EDIT_NO_REPLAY" ] && return 1
	# The span with each commit's parents – a second parent anywhere is a merge
	# Under five commits the walk's two spawns each undercut this path's probe
	# and proof
	local -a OLD FIELDS
	OLD=("${(@f)$(git rev-list --reverse --parents "$FROM..${2:-HEAD}" 2>/dev/null)}")
	[ ${#OLD[@]} -lt 5 ] && return 1
	local LINE BASE=""
	for LINE in "${OLD[@]}"; do
		FIELDS=(${=LINE})
		[ ${#FIELDS[@]} -ne 2 ] && return 1
		[ -z "$BASE" ] && BASE=${FIELDS[2]}
	done
	OLD=("${OLD[@]%% *}")
	# The walk seeds its map at PREV_OLD, so the span has to rise from there
	[ "$BASE" = "$(git rev-parse "$PREV_OLD" 2>/dev/null)" ] || return 1
	_REPLAY_AVAILABLE || return 1
	# Replayed onto a transient ref of its own, so the branch is never named to a command that
	# could move it, whatever a later git makes the default – a ref an interrupted run left
	# behind is swept once its process is gone
	_GC_KILLED_RUN_REFS
	local TMPREF="refs/git-edit/replay-$$"
	git update-ref "$TMPREF" "$PREV_NEW" 2>/dev/null || return 1
	_TEMP_REFS+=("$TMPREF")
	local OUT
	OUT=$( export LC_ALL=C; git replay "${_REPLAY_FLAGS[@]}" --advance "$TMPREF" "$FROM..${2:-HEAD}" 2>/dev/null )
	git update-ref -d "$TMPREF" 2>/dev/null
	_TEMP_REFS=("${(@)_TEMP_REFS:#$TMPREF}")
	# "update <ref> <new> <old>" – the third field is the rebuilt tip
	local FIRST=${OUT%%$'\n'*}
	FIELDS=(${=FIRST})
	local NEW_TIP=${FIELDS[3]}
	[ -z "$NEW_TIP" ] && return 1
	# The proof: both spans dump identical, commit for commit
	local FMT='%T%x00%an%x00%ae%x00%aI%x00%B%x00'
	cmp -s <(git log --reverse --format="$FMT" "$FROM..${2:-HEAD}" 2>/dev/null) \
	       <(git log --reverse --format="$FMT" "$PREV_NEW..$NEW_TIP" 2>/dev/null) || return 1
	local -a NEW
	NEW=("${(@f)$(git rev-list --reverse "$PREV_NEW..$NEW_TIP" 2>/dev/null)}")
	[ ${#NEW[@]} -ne ${#OLD[@]} ] && return 1
	PRINT_CMD "git replay --advance ${TMPREF#refs/git-edit/} ${FROM:0:7}..HEAD -> ${NEW_TIP:0:7} # replayed ${#OLD[@]} commit(s) in one pass"
	local i
	for (( i=1; i<=${#OLD[@]}; i++ )); do
		_RECORD_REWRITE "${OLD[$i]}" "${NEW[$i]}"
	done
	PREV_OLD=${OLD[-1]}
	PREV_NEW=$NEW_TIP
	_REBUILT_VIA_REPLAY=true
	return 0
}

# Rebuilds each commit in `$1..HEAD` with every rewritten parent substituted, carrying an
# old->new map across the walk, since a single `PREV_OLD`/`PREV_NEW` chain breaks on merge
# topologies – `--topo-order` guards the parents-before-children walk against clock skew
_REBUILD_DESCENDANTS () {
	# Args: <from> <tip the run read> – never the live `HEAD`, where a peer's commit landed and taken
	# back would be rebuilt on top, and land again through a compare-and-swap on that same tip
	local FROM=$1 UPTO=$2
	if [ -z "$UPTO" ]; then
		PRINT_ERR "Internal: no tip to rebuild ${FROM:0:7}'s descendants up to – nothing was applied"
		exit 1
	fi
	# One replay where the span is linear and its result proves out – else the walk
	_REPLAY_REBUILD "$FROM" "$UPTO" && return 0
	local DESC P D_NEW D_TOUCHED
	local -a D_PARENTS_ARGS NF
	local -A REWRITTEN
	REWRITTEN[$(git rev-parse "$PREV_OLD")]=$PREV_NEW
	for DESC in $(git rev-list --reverse --topo-order "$FROM..$UPTO"); do
		# One git-log per commit packs tree, parents, author and message, NUL-separated with the
		# message ending on one too, so `$()` keeps its trailing newlines, and `(@0)` keeps an empty
		# parents field so a root commit does not shift the author
		NF=("${(@0)$(git log -1 --format='%T%x00%P%x00%an%x00%ae%x00%ad%x00%B%x00' --date=raw "$DESC")}")
		D_PARENTS_ARGS=()
		D_TOUCHED=false
		for P in ${=NF[2]}; do
			if [ -n "${REWRITTEN[$P]}" ]; then
				D_PARENTS_ARGS+=(-p "${REWRITTEN[$P]}")
				D_TOUCHED=true
			else
				D_PARENTS_ARGS+=(-p "$P")
			fi
		done
		if [ "$D_TOUCHED" = "false" ]; then
			continue
		fi

		_MSG_FILE "${NF[6]}" || _REBUILD_FAILED "$DESC"
		D_NEW=$(_COMMIT_TREE_AS "$DESC" "${NF[3]}" "${NF[4]}" "${NF[5]}" "${NF[1]}" "${D_PARENTS_ARGS[@]}" -F "$REPLY") || _REBUILD_FAILED "$DESC"

		PRINT_CMD "git commit-tree ${NF[1]:0:7} ... -> ${D_NEW:0:7} # rebuilt ${DESC:0:7}"

		REWRITTEN[$DESC]=$D_NEW
		_RECORD_REWRITE "$DESC" "$D_NEW"
		PREV_OLD=$DESC
		PREV_NEW=$D_NEW
	done
}

# Rewords commit `$1` to message `$2` and rebuilds everything above it up to the tip `$3` the run
# read, leaving the rewritten commit in `$_REWORDED_TARGET` and the new tip in `$_REWORDED_TIP`,
# moving no ref – so `--amend-into` folds and rewords under one ref update rather than two
_REWORD_AND_REBUILD () {
	local AT=$1
	local MSG=$2
	local UPTO=$3
	local TREE=$(git rev-parse "$AT^{tree}")
	local PARENTS_ARGS=()
	local P
	for P in $(git log -1 --format='%P' "$AT"); do
		PARENTS_ARGS+=(-p "$P")
	done

	local -a AA=("${(@0)$(git log -1 --format='%an%x00%ae%x00%ad' --date=raw "$AT")}")
	PREV_NEW=$(_COMMIT_TREE_AS "$AT" "${AA[1]}" "${AA[2]}" "${AA[3]}" "$TREE" "${PARENTS_ARGS[@]}" -m "$MSG") || _REBUILD_FAILED "$AT"
	PRINT_CMD "git commit-tree ${TREE:0:7} ... -> ${PREV_NEW:0:7} # reworded ${AT:0:7}"
	_REWORDED_TARGET=$PREV_NEW
	_RECORD_REWRITE "$AT" "$PREV_NEW"

	PREV_OLD=$AT
	_REBUILD_DESCENDANTS "$AT" "$UPTO"
	_REWORDED_TIP=$PREV_NEW
}

# Rewrites just `$COMMIT`'s message and rebuilds any descendants on top, plumbing only –
# no checkout, no stash, no rebase, so the working tree is never touched, and atomic
# from the caller's view: a single ref update at the end, only if the branch has not moved
GIT_REWORD () {
	local TARGET=$COMMIT

	# Capture the ref to update (branch if attached, `HEAD` if detached)
	local ORIG_HEAD=$(git rev-parse HEAD)
	_REQUIRE_IN_TIP "$ORIG_HEAD" "$TARGET"
	local BRANCH=${$(git symbolic-ref -q HEAD 2>/dev/null)#refs/heads/}
	local REF
	if [ -n "$BRANCH" ]; then
		REF="refs/heads/$BRANCH"
	else
		REF="HEAD"
	fi

	# Refuse if the target isn't reachable from `HEAD`
	if ! git merge-base --is-ancestor "$TARGET" "$ORIG_HEAD" 2>/dev/null; then
		PRINT_ERR "Commit ${TARGET:0:7} is not reachable from HEAD"
		exit 1
	fi

	_GUARD_UNPUSHED "$TARGET"

	local NEW_MSG ORIG_MSG
	local -a MSG_ARGS
	if [ -n "$SUBJECT_VALUE" ]; then
		# --subject supplied: the body as it stands, its bytes compared and committed as they are
		_SUBJECT_REPLACED "$TARGET" "$SUBJECT_VALUE" || _REBUILD_FAILED "$TARGET"
		NEW_MSG=$REPLY
		ORIG_MSG=$(git log -1 --format='%B%x00' "$TARGET")
		ORIG_MSG=${ORIG_MSG%$'\0'}
	elif [ -n "$TEXT_VALUE" ]; then
		# --text supplied: use directly, no editor
		NEW_MSG="$TEXT_VALUE"
	else
		_REQUIRE_TTY_FOR_EDITOR
		# Open the caller's editor on a temp file seeded with the current message – named
		# `COMMIT_EDITMSG`, git's convention, inside a temp dir, so editors apply commit-message
		# syntax highlighting from the recognized filename
		local TMP_DIR
		TMP_DIR=$(MKTEMP_DIR git-edit-reword) || exit 1
		local MSG_FILE="$TMP_DIR/COMMIT_EDITMSG"
		git log -1 --format='%B' "$TARGET" > "$MSG_FILE"
		_MSG_STYLE "$(<"$MSG_FILE")" || exit 1
		_RESOLVE_REAL_EDITOR || exit 1
		{
			print -r -- ""
			_MSG_HELP "Please enter the new commit message for ${TARGET:0:7}."
		} >> "$MSG_FILE"

		NEW_MSG=$(_READ_MESSAGE_FROM_EDITOR "$MSG_FILE")
		rm -rf "$TMP_DIR"

		if [ -z "$NEW_MSG" ]; then
			PRINT_ERR "Empty message – aborting"
			exit 1
		fi
	fi

	[ -n "$SUBJECT_VALUE" ] || ORIG_MSG=$(git log -1 --format='%B' "$TARGET" | git stripspace)
	if [ "$NEW_MSG" = "$ORIG_MSG" ]; then
		ECHO_E "${_PAD}\e[0;33mMessage unchanged – nothing to do.\e[0m"
		EMIT_STATUS "$ORIG_HEAD" "$REF" false
		exit 0
	fi

	# Build the new target commit: same tree + parents + author, new message
	local TREE=$(git rev-parse "$TARGET^{tree}")
	local PARENTS_ARGS=()
	local P
	for P in $(git log -1 --format='%P' "$TARGET"); do
		PARENTS_ARGS+=(-p "$P")
	done

	local -a TA=("${(@0)$(git log -1 --format='%an%x00%ae%x00%ad' --date=raw "$TARGET")}")
	local NEW_TARGET
	# `-m` ends a message in a newline, where a kept body may lack one
	MSG_ARGS=(-m "$NEW_MSG")
	if [ -n "$SUBJECT_VALUE" ]; then
		_MSG_FILE "$NEW_MSG" || _REBUILD_FAILED "$TARGET"
		MSG_ARGS=(-F "$REPLY")
	fi
	NEW_TARGET=$(_COMMIT_TREE_AS "$TARGET" "${TA[1]}" "${TA[2]}" "${TA[3]}" "$TREE" "${PARENTS_ARGS[@]}" "${MSG_ARGS[@]}") || _REBUILD_FAILED "$TARGET"

	PRINT_CMD "git commit-tree ${TREE:0:7} ... -> ${NEW_TARGET:0:7}"

	_RECORD_REWRITE "$TARGET" "$NEW_TARGET"

	# Walk every descendant of `$TARGET` up to the tip read above, rebuild with new parent
	PREV_OLD=$TARGET
	PREV_NEW=$NEW_TARGET
	_REBUILD_DESCENDANTS "$TARGET" "$ORIG_HEAD"

	# Atomic compare-and-swap on the ref – refuse where the branch moved under us, such as a
	# concurrent commit landing from another tool
	local CMD="git update-ref -m ${(q-)${:-git edit: reword ${TARGET:0:7}$_REFLOG_TAG}} ${(q-)REF} ${(q-)PREV_NEW} ${(q-)ORIG_HEAD}"
	PRINT_CMD "$CMD"
	# A message typed in the editor is kept for the rerun
	local TYPED=""
	[ -z "$TEXT_VALUE$SUBJECT_VALUE" ] && TYPED=$NEW_MSG
	_TYPED_KEEP=("$TYPED" "git edit -M ${TARGET:0:12}")
	_MOVE_REF "$CMD" || _REFUSE_MOVED_DURING "$REF" "$ORIG_HEAD" reword "$TYPED" "git edit -M ${TARGET:0:12}"
	_RECORD_REF_MOVE "$REF" "$ORIG_HEAD" "$PREV_NEW" "reword ${TARGET:0:7}"
	# The walk reuses every commit's tree object verbatim, so this holds by construction, and a
	# replay's result was proven against the originals before it was taken – stated so callers
	# do not re-verify with a diff, and claiming nothing beyond the tree
	if [ "$_REBUILT_VIA_REPLAY" = "true" ]; then
		PRINT_TEXT "%s – proven commit for commit, rebuilt in one replay as new objects." 32 "Trees unchanged ✓"
	else
		PRINT_TEXT "%s – no file content changed, though the affected commits are rebuilt as new objects." 32 "Trees unchanged by construction ✓"
	fi
	# The message is the entire point of the mode, so show the one that landed, or the caller
	# reads it back with `git log` to be sure it took – `$NEW_TARGET` is the rebuilt commit
	# itself, since deriving it by offset walks first parents and a merge names the wrong one
	if [ -n "$NEW_TARGET" ]; then
		_PRINT_COMMIT_LINE "$NEW_TARGET" '  %h %s'
		local BODY_LINES=$(git log -1 --format='%b' "$NEW_TARGET" | grep -c .)
		if [ "$BODY_LINES" -gt 0 ]; then
			git log -1 --format='%b' "$NEW_TARGET" | LC_ALL=C grep -a . | _CARET_LINES | LC_ALL=C sed "s/^/${_DIM}    /;s/\$/${_OFF}/"
		fi
		# Name the subject that was replaced – a symbolic target resolves once at invocation, so a
		# commit landing between the caller's read and this call is silently reworded instead,
		# which the CAS cannot catch, and the old subject puts that in the output they read back
		local OLD_SUBJECT=$(git log -1 --format='%s' "$TARGET" 2>/dev/null)
		if [ -n "$OLD_SUBJECT" ]; then
			_PRINT_COMMIT_LINE "$TARGET" '  replaced: %s'
		fi
		# `--text` replaces the whole message, not just the subject, so a body
		# line the caller did not restate is gone – both lines above are
		# subjects, so a caller comparing those reads the reword as clean
		_PRINT_LOST_BODY "The replaced message" "$TARGET" "$(git log -1 --format='%B' "$NEW_TARGET")" "$NEW_TARGET"
		if [ -n "$SUBJECT_VALUE" ]; then
			_PRINT_SUBJECT_LINES "$TARGET" "git edit -M --text=\"…\" ${NEW_TARGET:0:12}"
		fi
	fi
}


# Answers whether `--text` or stdin carries `--- <commit>` records rather than one message – a
# `--- ` line at column 0 with a token after it is the batch reword's record header, and
# its absence leaves the ordinary single-message form
_LOOKS_LIKE_RECORDS () {
	# A here-string, as every `grep -q` on a variable here takes – piped, a text past the pipe
	# buffer lost its writer to SIGPIPE at grep's early match, and `pipefail` made that a miss
	grep -q '^--- .' <<<"$1"
}

# Reads the `--- <commit>` records `RAW_TEXT_VALUE` holds, against <tip>, into the caller's
# `REC_SHAS` – each header's commit as it now stands, in order – and `TARGETS` and `MSG_MAP`,
# the commits whose message a record changes and that message, refusing the whole batch on a miss
_READ_RECORDS () {
	# Args: <tip>
	local ORIG_HEAD=$1

	# Parse records – lines before the first header are ignored, a blank line inside a message
	# is kept, and only the header token's trailing whitespace is trimmed, since its body may
	# carry spaces itself, as `:/some subject` does
	local -a REC_LINES=("${(@f)RAW_TEXT_VALUE}")
	local -a REC_REFS=() REC_MSGS=()
	local L cur_ref="" cur_msg="" have=0
	for L in "${REC_LINES[@]}"; do
		if [[ "$L" == '--- '* ]]; then
			[ "$have" -eq 1 ] && { REC_REFS+=("$cur_ref"); REC_MSGS+=("$cur_msg"); }
			cur_ref=$(print -r -- "${L#--- }" | LC_ALL=C sed 's/[[:space:]]*$//')
			cur_msg=""
			have=1
		elif [ "$have" -eq 1 ]; then
			if [ -z "$cur_msg" ]; then
				cur_msg="$L"
			else
				cur_msg="$cur_msg"$'\n'"$L"
			fi
		fi
	done
	[ "$have" -eq 1 ] && { REC_REFS+=("$cur_ref"); REC_MSGS+=("$cur_msg"); }

	if [ ${#REC_REFS[@]} -eq 0 ]; then
		PRINT_ERR "No records on stdin – expected '--- <commit>' headers"
		exit 1
	fi

	# Resolve, guard and de-duplicate every target before writing anything – `_GUARD_REACHABLE`
	# maps a stale SHA to its current identity and exits on a miss, while the pushed and empty
	# checks reject the whole batch, and a record matching its commit is dropped unrebuilt
	local -A SEEN
	MSG_MAP=() TARGETS=() REC_SHAS=()
	local i n=${#REC_REFS[@]}
	local ref raw msg sha cur
	# Resolve pushed-ness once for the whole batch – commits reachable from `HEAD` but not from
	# any remote-tracking ref are exactly the unpushed run, so membership answers each target
	# locally, and a target that misses the set falls back to `_GUARD_UNPUSHED`
	local -A UNPUSHED
	local _check_pushed=false _u
	if [ ${#OPT_ALLOW_PUSHED} -eq 0 ] && [ -n "$(git for-each-ref --count=1 refs/remotes 2>/dev/null)" ]; then
		_check_pushed=true
		for _u in ${(f)"$(git rev-list "$ORIG_HEAD" --not --remotes 2>/dev/null)"}; do
			UNPUSHED[$_u]=1
		done
	fi
	for ((i = 1; i <= n; i++)); do
		raw="${REC_REFS[i]}"
		# Resolve to a commit object first, as the positional path does – a `:/subject` or short ref
		# becomes a full SHA, while a stale one is left for `_GUARD_REACHABLE` to map or refuse
		# A header resolving to nothing is refused outright rather than skipping its commit
		ref=$(git rev-parse --verify --quiet "$raw" 2>/dev/null)
		[ -z "$ref" ] && ref="$raw"
		_GUARD_REACHABLE "$ref"
		sha="$_RESOLVED_SHA"
		if ! git rev-parse --verify --quiet "${sha}^{commit}" >/dev/null 2>&1; then
			PRINT_ERR "Record header '${raw}' did not resolve to a commit"
			exit 1
		fi
		REC_SHAS+=("$sha")
		if [ "$_check_pushed" = true ] && [ -z "${UNPUSHED[$sha]+x}" ]; then
			_GUARD_UNPUSHED "$sha"
		fi
		msg=$(print -r -- "${REC_MSGS[i]}" | git stripspace)
		if [ -z "$msg" ]; then
			PRINT_ERR "Record for ${raw} has an empty message"
			exit 1
		fi
		if [ -n "${SEEN[$sha]+x}" ]; then
			PRINT_ERR "Commit ${sha:0:7} is named by two records"
			exit 1
		fi
		SEEN[$sha]=1
		cur=$(git log -1 --format='%B' "$sha" | git stripspace)
		# The `--- ` line is this format's record separator, so a commit whose own message carries
		# one cannot be represented – its dump would split mid-body and mis-attribute the
		# remainder, so refuse it here – a record left out, or the single form, has no separator
		if grep -q '^--- ' <<<"$cur"; then
			PRINT_ERR "Commit ${sha:0:7}'s message has a '--- ' line, which the record format reserves"
			ECHO_E "\e[0;31m  Nothing was reworded – leave its record out of the batch where it keeps its message, or reword it on its own: git edit -M ${sha:0:9}\e[0m" >&2
			exit 1
		fi
		if [ "$msg" = "$cur" ]; then
			continue
		fi
		MSG_MAP[$sha]="$msg"
		TARGETS+=("$sha")
	done
}

# Rewords many commits in one plumbing pass, reading `--- <commit>` records from `--text`
# in place of a positional target – each record is a header then that commit's new
# message, exactly what `git log --format='--- %h%n%B'` emits, all-or-nothing on a miss
GIT_REWORD_BATCH () {
	local ORIG_HEAD=$(git rev-parse HEAD)
	local REF=$(_CURRENT_REF)
	local -A MSG_MAP
	local -a TARGETS REC_SHAS
	_READ_RECORDS "$ORIG_HEAD"

	if [ ${#TARGETS[@]} -eq 0 ]; then
		ECHO_E "${_PAD}\e[0;33mAll messages already match – nothing to do.\e[0m"
		EMIT_STATUS "$ORIG_HEAD" "$REF" false
		exit 0
	fi

	# The records were resolved against the live `HEAD` – one a peer moved meanwhile can name a
	# commit the tip read never had
	[ "$(git rev-parse -q --verify HEAD 2>/dev/null)" = "$ORIG_HEAD" ] || _REFUSE_MOVED_DURING "$REF" "$ORIG_HEAD" reword

	# Walk from just below the oldest target up to the tip read above, rebuilding a commit where it
	# is a target or has a rewritten parent – carrying the old->new map across the walk is what
	# lets a merge topology rebuild, and the tree is always reused verbatim
	local OLDEST=$(git rev-list --reverse --topo-order "$ORIG_HEAD" 2>/dev/null \
		| grep -Fx -f <(printf '%s\n' "${TARGETS[@]}") | head -1)
	local WALK
	if git rev-parse -q --verify "${OLDEST}^" >/dev/null 2>&1; then
		WALK=$(git rev-list --reverse --topo-order "${OLDEST}^..$ORIG_HEAD")
	else
		WALK=$(git rev-list --reverse --topo-order "$ORIG_HEAD")
	fi

	local -A REWRITTEN
	local DESC P D_NEW touched
	local -a PARENTS_ARGS NF D_MSG
	for DESC in ${(f)WALK}; do
		# One git-log per commit (see _REBUILD_DESCENDANTS): tree, parents,
		# author and body in a single NUL-separated capture, `(@0)`-split
		NF=("${(@0)$(git log -1 --format='%T%x00%P%x00%an%x00%ae%x00%ad%x00%B%x00' --date=raw "$DESC")}")
		PARENTS_ARGS=()
		touched=false
		for P in ${=NF[2]}; do
			if [ -n "${REWRITTEN[$P]}" ]; then
				PARENTS_ARGS+=(-p "${REWRITTEN[$P]}")
				touched=true
			else
				PARENTS_ARGS+=(-p "$P")
			fi
		done
		if [ "$touched" = false ] && [ -z "${MSG_MAP[$DESC]+x}" ]; then
			continue
		fi
		# A record's message, or the commit's own as its bytes stand
		if [ -n "${MSG_MAP[$DESC]+x}" ]; then
			D_MSG=(-m "${MSG_MAP[$DESC]}")
		else
			_MSG_FILE "${NF[6]}" || _REBUILD_FAILED "$DESC"
			D_MSG=(-F "$REPLY")
		fi
		D_NEW=$(_COMMIT_TREE_AS "$DESC" "${NF[3]}" "${NF[4]}" "${NF[5]}" "${NF[1]}" "${PARENTS_ARGS[@]}" "${D_MSG[@]}") || _REBUILD_FAILED "$DESC"
		PRINT_CMD "git commit-tree ${NF[1]:0:7} ... -> ${D_NEW:0:7} # rebuilt ${DESC:0:7}"
		REWRITTEN[$DESC]=$D_NEW
		_RECORD_REWRITE "$DESC" "$D_NEW"
	done

	# Every target must have been reached by the walk, and the tip with them – the range runs from
	# the topologically-earliest target up to the tip read, so only a target resolved against a
	# `HEAD` a peer moved and moved back can miss it
	local T
	for T in "${TARGETS[@]}" "$ORIG_HEAD"; do
		[ -z "${REWRITTEN[$T]+x}" ] && _REFUSE_MOVED_DURING "$REF" "$ORIG_HEAD" reword
	done
	local NEW_HEAD="${REWRITTEN[$ORIG_HEAD]}"

	# Single atomic compare-and-swap – refuse if the branch moved meanwhile
	# (a concurrent commit or rewrite), exactly as the single reword does
	local CMD="git update-ref -m ${(q-)${:-git edit: reword ${#TARGETS[@]} commits$_REFLOG_TAG}} ${(q-)REF} ${(q-)NEW_HEAD} ${(q-)ORIG_HEAD}"
	PRINT_CMD "$CMD"
	_MOVE_REF "$CMD" || _REFUSE_MOVED_DURING "$REF" "$ORIG_HEAD" reword
	_RECORD_REF_MOVE "$REF" "$ORIG_HEAD" "$NEW_HEAD" "reword ${#TARGETS[@]} commits"
	PRINT_TEXT "%s – no file content changed, though the affected commits are rebuilt as new objects." 32 "Trees unchanged by construction ✓"
	PRINT_TEXT "Reworded %s commits:" 32 "${#TARGETS[@]}"
	local sha
	for sha in "${TARGETS[@]}"; do
		_PRINT_COMMIT_LINE "${REWRITTEN[$sha]}" '  %h %s'
	done
	# A record replaces its commit's message whole, as the single form's `--text` does
	for sha in "${TARGETS[@]}"; do
		_PRINT_LOST_BODY "A replaced message" "$sha" "${MSG_MAP[$sha]}"
	done
}

# Names the body lines of <commit> that <new message> no longer carries, and prints them – every
# summary line is a subject, so a caller comparing those reads a replacing `--text` as clean
# whether it dropped the body whole or restated only part, and a count would not say which went
# Lines compare trimmed, and one moved into the subject counts as kept
_PRINT_LOST_BODY () {
	# Args: <noun for the old message> <commit> <new message> [<commit that message landed as>]
	local NOUN=$1 C=$2 NEW=$3 LANDED=$4
	local TRIM='s/^[[:space:]]*//;s/[[:space:]]*$//'
	local OLD_BODY=$(git log -1 --format='%b' "$C" 2>/dev/null | LC_ALL=C sed "$TRIM" | LC_ALL=C grep -a .)
	[ -n "$OLD_BODY" ] || return 0
	local LOST=$(print -r -- "$OLD_BODY" | LC_ALL=C grep -aFxv -f <(print -r -- "$NEW" | LC_ALL=C sed "$TRIM" | LC_ALL=C grep -a .))
	[ -n "$LOST" ] || return 0
	local OLD_LINES=$(print -r -- "$OLD_BODY" | grep -c .)
	local LOST_LINES=$(print -r -- "$LOST" | grep -c .)
	if [ "$LOST_LINES" -eq "$OLD_LINES" ]; then
		PRINT_TEXT "%s carried a %s-line body the new one drops – it is still readable at %s" 33 "$NOUN" "$OLD_LINES" "${C:0:12}"
	else
		PRINT_TEXT "%s carried a %s-line body – the new one lacks %s of its lines, still readable at %s" 33 "$NOUN" "$OLD_LINES" "$LOST_LINES" "${C:0:12}"
	fi
	print -r -- "$LOST" | head -8 | _CARET_LINES | LC_ALL=C sed "s/^/${_DIM}    /;s/\$/${_OFF}/"
	if [ "$LOST_LINES" -gt 8 ]; then
		print -r -- "${_DIM}    … and $((LOST_LINES - 8)) more${_OFF}"
	fi
	# A body dropped whole most likely went with a subject-only change, which need not restate it –
	# the way back gives the landed commit its new subject over the old body, each read from its
	# commit as it runs, so no byte of either passes through the printed line, where a shell could
	# expand a `!` – offered only where the new message has no body of its own, which it would drop
	if [ -n "$LANDED" ] && [ "$LOST_LINES" -eq "$OLD_LINES" ] && \
		[ -z "$(git log -1 --format=%b "$LANDED" 2>/dev/null | LC_ALL=C grep -a '[^[:space:]]')" ]; then
		PRINT_TEXT "To put the body back under the new subject: %s" 33 \
			"git edit -M --text=\"\$(git log -1 --format=%s ${LANDED:0:12}; echo; git log -1 --format=%b ${C:0:12})\" ${LANDED:0:12}"
	fi
	return 0
}

# Names the lines of <commit>'s first paragraph where `--subject` replaced one of several – git
# reads them all as the subject, so the `replaced:` line shows them joined, as though one line went
_PRINT_SUBJECT_LINES () {
	# Args: <commit> <command keeping its later lines>
	local L SEEN=false
	local -a KEPT=()
	for L in "${(@f)$(git log -1 --format='%B' "$1" 2>/dev/null)}"; do
		if [ -z "${L//[[:space:]]/}" ]; then
			[ "$SEEN" = true ] && break
			continue
		fi
		SEEN=true
		KEPT+=("$L")
	done
	(( ${#KEPT} > 1 )) || return 0
	PRINT_TEXT "--subject replaced a first paragraph of %s lines, all of it git's subject – still readable at %s:" 33 "${#KEPT}" "${1:0:12}"
	print -rl -- "${(@)KEPT[1,8]}" | _CARET_LINES | LC_ALL=C sed "s/^/${_DIM}    /;s/\$/${_OFF}/"
	(( ${#KEPT} > 8 )) && print -r -- "${_DIM}    … and $(( ${#KEPT} - 8 )) more${_OFF}"
	PRINT_TEXT "To keep its later lines, give the whole message instead: %s" 33 "$2"
	return 0
}

# Names the bodies a squash's `--text` drops, as a reword names its own
_PRINT_DROPPED_BODIES () {
	# Args: <squashed commit>...
	[ ${#OPT_TEXT} -gt 0 ] || return 0
	local C
	local -aU SQUASHED
	for C in "$@"; do
		SQUASHED+=("$(git rev-parse "$C^{commit}" 2>/dev/null)")
	done
	for C in "${SQUASHED[@]}"; do
		[ -z "$C" ] && continue
		_PRINT_LOST_BODY "A squashed message" "$C" "$TEXT_VALUE"
	done
}

# Squashes a contiguous range into one commit, plumbing only – like `GIT_REWORD`, no
# checkout, no stash, no rebase, one atomic ref update, and it refuses non-contiguous
# selections and merge-holding ranges, which need real 3-way merges and can conflict
GIT_RESQUASH () {
	local OLDEST=${COMMITS[1]}
	local NEWEST=${COMMITS[-1]}

	# Capture the ref to update
	local ORIG_HEAD=$(git rev-parse HEAD)
	_REQUIRE_IN_TIP "$ORIG_HEAD" "${COMMITS[@]}"
	local BRANCH=${$(git symbolic-ref -q HEAD 2>/dev/null)#refs/heads/}
	local REF
	if [ -n "$BRANCH" ]; then
		REF="refs/heads/$BRANCH"
	else
		REF="HEAD"
	fi

	# Refuse if either endpoint isn't reachable from `HEAD`
	if ! git merge-base --is-ancestor "$NEWEST" "$ORIG_HEAD" 2>/dev/null; then
		PRINT_ERR "Commit ${NEWEST:0:7} is not reachable from HEAD"
		exit 1
	fi

	_GUARD_UNPUSHED "$OLDEST"

	# Verify contiguity: rev-list of the inclusive `OLDEST..NEWEST` range must
	# match the selected commits exactly (same count, same order)
	local EXPECTED
	if git rev-parse --verify "$OLDEST^" >/dev/null 2>&1; then
		EXPECTED=($(git rev-list --reverse "$OLDEST^..$NEWEST"))
	else
		# `OLDEST` is the root commit – range is just everything up to `NEWEST`
		EXPECTED=($(git rev-list --reverse "$NEWEST"))
	fi

	if [ ${#EXPECTED[@]} -ne ${#COMMITS[@]} ]; then
		PRINT_ERR "-S/--resquash requires contiguous commits"
		ECHO_E "\e[0;31m  Selected ${#COMMITS[@]}; range ${OLDEST:0:7}..${NEWEST:0:7} contains ${#EXPECTED[@]}.\e[0m" >&2
		ECHO_E "\e[0;31m  For non-contiguous squashes, use -s (combine with -C for safety).\e[0m" >&2
		exit 1
	fi
	local i
	for (( i=1; i<=${#COMMITS[@]}; i++ )); do
		if [ "${COMMITS[$i]}" != "${EXPECTED[$i]}" ]; then
			PRINT_ERR "-S/--resquash requires contiguous commits in order"
			exit 1
		fi
	done

	# Refuse merge commits in the range (they'd need a real 3-way merge)
	local C P_LIST
	for C in "${COMMITS[@]}"; do
		P_LIST=$(git log -1 --format='%P' "$C")
		if [[ "$P_LIST" == *" "* ]]; then
			PRINT_ERR "-S/--resquash cannot handle merge commit ${C:0:7}"
			ECHO_E "\e[0;31m  Use -s (combine with -C for safety) instead.\e[0m" >&2
			exit 1
		fi
	done
	if _SQUASH_LEAVES_REACHABLE "$NEWEST" "${(@)COMMITS[1,-2]}"; then
		PRINT_ERR "-S/--resquash cannot squash ${OLDEST:0:7}..${NEWEST:0:7} – a merge above it takes one of them as a parent, which would stay reachable"
		exit 1
	fi

	# Determine new parent (parent of `OLDEST`, or none for root)
	local NEW_PARENT_ARGS=()
	if git rev-parse --verify "$OLDEST^" >/dev/null 2>&1; then
		NEW_PARENT_ARGS=(-p "$(git rev-parse "$OLDEST^")")
	fi

	# Build the squashed commit's message
	local NEW_MSG
	if [ -n "$TEXT_VALUE" ]; then
		# --text supplied: use directly (auto-implies -m semantics)
		NEW_MSG="$TEXT_VALUE"
	elif [ ${#OPT_MESSAGE} -gt 0 ]; then
		_REQUIRE_TTY_FOR_EDITOR
		# With -m: combine all messages and open editor for review
		# File is named `COMMIT_EDITMSG` so editors apply commit-message syntax
		local TMP_DIR
		TMP_DIR=$(MKTEMP_DIR git-edit-resquash) || exit 1
		local MSG_FILE="$TMP_DIR/COMMIT_EDITMSG"
		local FIRST=1
		for C in "${COMMITS[@]}"; do
			if [ $FIRST -eq 0 ]; then echo ""; fi
			FIRST=0
			git log -1 --format='%B' "$C"
		done > "$MSG_FILE"
		# The help goes last, as git's does, so a scissors line cuts it alone
		_MSG_STYLE "$(<"$MSG_FILE")" || exit 1
		_RESOLVE_REAL_EDITOR || exit 1
		_MSG_HELP "Combined message from ${#COMMITS[@]} squashed commits – edit as desired." >> "$MSG_FILE"

		NEW_MSG=$(_READ_MESSAGE_FROM_EDITOR "$MSG_FILE")
		rm -rf "$TMP_DIR"

		if [ -z "$NEW_MSG" ]; then
			PRINT_ERR "Empty message – aborting"
			exit 1
		fi
	fi
	local -a MSG_ARGS=(-m "$NEW_MSG")

	# Build the new squashed commit (newest tree + `OLDEST`'s author + new parent + message)
	local NEW_TREE=$(git rev-parse "$NEWEST^{tree}")

	local -a OA=("${(@0)$(git log -1 --format='%an%x00%ae%x00%ad%x00%B%x00' --date=raw "$OLDEST")}")
	if [ -z "$NEW_MSG" ]; then
		# Fixup style: `OLDEST`'s message kept as its bytes stand, the rest dropped
		_MSG_FILE "${OA[4]}" || _REBUILD_FAILED "$OLDEST"
		MSG_ARGS=(-F "$REPLY")
	fi
	local NEW_SQUASHED
	NEW_SQUASHED=$(_COMMIT_TREE_AS "$OLDEST" "${OA[1]}" "${OA[2]}" "${OA[3]}" "$NEW_TREE" "${NEW_PARENT_ARGS[@]}" "${MSG_ARGS[@]}") || _REBUILD_FAILED "$OLDEST"

	PRINT_CMD "git commit-tree ${NEW_TREE:0:7} ${NEW_PARENT_ARGS[*]} -> ${NEW_SQUASHED:0:7} # squashed ${#COMMITS[@]} commits"

	# Every member maps to the one commit that absorbed it – `notes copy` folds
	# their notes together or takes the first, per `notes.rewriteMode`
	local MEMBER
	for MEMBER in "${COMMITS[@]}"; do
		_RECORD_REWRITE "$MEMBER" "$NEW_SQUASHED"
		[ "$MEMBER" = "$OLDEST" ] || _RUN_FATES[$MEMBER]="squashed $NEW_SQUASHED"
	done

	# Rebuild any descendants of `NEWEST` up to the tip read above with the new squashed commit as
	# their parent
	PREV_OLD=$NEWEST
	PREV_NEW=$NEW_SQUASHED
	_REBUILD_DESCENDANTS "$NEWEST" "$ORIG_HEAD"

	# Atomic ref update
	local CMD="git update-ref -m ${(q-)${:-git edit: squash ${#COMMITS[@]} into ${OLDEST:0:7}$_REFLOG_TAG}} ${(q-)REF} ${(q-)PREV_NEW} ${(q-)ORIG_HEAD}"
	PRINT_CMD "$CMD"
	local TYPED=""
	[ -z "$TEXT_VALUE" ] && [ ${#OPT_MESSAGE} -gt 0 ] && TYPED=$NEW_MSG
	_TYPED_KEEP=("$TYPED" "git edit -S ${(j: :)COMMITS}")
	_MOVE_REF "$CMD" || _REFUSE_MOVED_DURING "$REF" "$ORIG_HEAD" squash "$TYPED" "git edit -S ${(j: :)COMMITS}"
	_RECORD_REF_MOVE "$REF" "$ORIG_HEAD" "$PREV_NEW" "squash ${#COMMITS[@]} into ${OLDEST:0:7}"
	# The squashed commit takes the newest member's tree and descendants keep
	# theirs, so the tip tree is identical by construction – stated so callers
	# don't re-verify with a diff
	PRINT_TEXT "%s" 32 "Tip tree identical ✓ – unchanged by construction."
	git show --no-color --stat --format='' "$NEW_SQUASHED" | head -12 | _CARET_LINES | LC_ALL=C sed "/./!d;s/^/${_DIM}/;s/\$/${_OFF}/"
	_PRINT_DROPPED_BODIES "${COMMITS[@]}"
	# Identity below the stat block, for the same reason the fold's is
	_PRINT_COMMIT_LINE "$NEW_SQUASHED" '  squashed: %h %s'
}

# Writes the editor stand-in a rebase runs in place of a real editor, and echoes its path –
# a resume commits the conflicted step as well as the fold, so the fold is recognized by
# the last step logged as done and every other gets its own message written back
_FOLD_EDITOR_CMD () {
	# Args: <command taking the message path>, [worktree holding the rebase],
	# [strip: the fold's message comes from a template git seeded with comments], [tty: the command
	# is the editor a person types in, its help and cleanup set by `_MSG_STYLE`]
	local RUN=$1
	local GITDIR=$(git -C "${2:-.}" rev-parse --absolute-git-dir 2>/dev/null)
	if [ -z "$GITDIR" ]; then
		# Unresolved, the guard matches nothing and the message goes silently –
		# the very loss it exists to prevent, so refuse instead
		PRINT_ERR "Cannot resolve the git dir for ${2:-the current directory} – 'rev-parse --absolute-git-dir' failed"
		ECHO_E "\e[0;31m  The fold's message can't be applied without it. Reword afterwards: git edit -M --text=\"…\" <sha>\e[0m" >&2
		exit 1
	fi
	local DONE=$GITDIR/rebase-merge/done
	local STRIP=":" TTY="" HELP=":"
	if [ "$4" = tty ]; then
		# An editor a person types into gets the terminal, as the rebase's own output is captured,
		# and the help `git commit` gives under the caller's cleanup – the rebase runs with
		# `commit.status` off, as git's own would name the cleanup the rebase is pinned to
		TTY=" </dev/tty >/dev/tty"
		[ -n "$_MSG_CLEANUP" ] || _MSG_STYLE "" || exit 1
		local -a HELP_LINES=("${(@f)$(_MSG_HELP "Please enter the squashed commit's message.")}")
		HELP="{ echo; printf '%s\\n' ${(j: :)${(qq)HELP_LINES[@]}}; } >> \"\$1\""
		_MSG_CLEANUP_SH
		STRIP=$REPLY
		# What was typed, for a landing refused after it
		[ -n "$_MSG_TYPED" ] && STRIP+=" && cp \"\$1\" ${(qq)_MSG_TYPED}"
	elif [ -n "$3" ]; then
		# A chain of fixups alone combined no message, so it keeps its first commit's as git wrote it
		# out – stripping git's template would take that message's own `#` lines along
		local FIXUP_MSG=$GITDIR/rebase-merge/message-fixup
		STRIP="if [ -f ${(qq)FIXUP_MSG} ]; then cp ${(qq)FIXUP_MSG} \"\$1\"; else git stripspace --strip-comments < \"\$1\" > \"\$1.ge-msg\" && mv -f \"\$1.ge-msg\" \"\$1\"; fi"
	fi
	# Callers register the path for cleanup themselves – this runs inside a
	# command substitution, so anything appended to _TEMP_FILES here is a
	# subshell's copy and the file would outlive the run
	local SCRIPT=$(MKTEMP_FILE git-edit-fold-editor)
	# Paths go in single-quoted – a repo living under an apostrophe would
	# otherwise close the quote and leave a syntax error, which git reports
	# only as a failed editor and abandons the commit over
	cat > "$SCRIPT" <<-SH
		#!/bin/sh
		# Written by git-edit for one rebase – \$1 is the message file git opened
		STEP=\$(tail -1 ${(qq)DONE} 2>/dev/null)
		case "\$STEP" in
			squash*|fixup*)
				$HELP
				# An editor quit with an error abandons the commit, as git's own does
				$RUN "\$1"$TTY || exit \$?
				$STRIP
				;;
			*)
				SHA=\${STEP#* }
				SHA=\${SHA%% *}
				# Byte for byte, as format: ends on no newline of its own and the rebase keeps it verbatim
				if git log -1 --no-show-signature --format=format:%B "\$SHA" > "\$1.ge-msg" 2>/dev/null; then
					mv -f "\$1.ge-msg" "\$1"
				else
					rm -f "\$1.ge-msg"
					git stripspace --strip-comments < "\$1" > "\$1.ge-msg" && mv -f "\$1.ge-msg" "\$1"
				fi
				;;
		esac
		exit 0
	SH
	chmod +x "$SCRIPT"
	print -r -- "$SCRIPT"
}

# Puts into `REPLY` the editor a resumed rebase commits with, under `commit.cleanup=verbatim` – a
# stand-in writing a conflicted step's own message back over git's `# Conflicts:` and help lines,
# while a fold of fixups alone keeps its first commit's and a squash git's, comments stripped
_RESUME_EDITOR () {
	# Args: <worktree holding the rebase>
	REPLY=$(_FOLD_EDITOR_CMD true "$1" strip)
	[ -n "$REPLY" ] || exit 1
	_TEMP_FILES+=("$REPLY")
}

# Reads one key press from the terminal into `REPLY` – enter, space, quit, escape, interrupt, eof or
# other – taking the sequence an arrow or a function key sends as one other key, never as Escape
_READ_KEY () {
	local K N
	local -i I
	if ! IFS= read -rs -k1 K; then
		REPLY=eof
		return 0
	fi
	case $K in
		''|$'\r'|$'\n') REPLY=enter ;;
		' ')            REPLY=space ;;
		q|Q)            REPLY=quit ;;
		$'\003')        REPLY=interrupt ;;
		$'\004')        REPLY=eof ;;
		$'\e')
			REPLY=escape
			# A key's sequence arrives at once, so a byte within 50 ms belongs to it – CSI (`[`) runs
			# to a byte in @–~, SS3 (`O`) takes one more, and an Alt chord is the pair
			if IFS= read -rs -t 0.05 -k1 N; then
				REPLY=other
				if [[ "$N" == '[' ]]; then
					for (( I = 0; I < 16; I++ )); do
						IFS= read -rs -t 0.05 -k1 N || break
						[[ "$N" == [@-~] ]] && break
					done
				elif [[ "$N" == O ]]; then
					IFS= read -rs -t 0.05 -k1 N
				fi
			fi
			;;
		*) REPLY=other ;;
	esac
	return 0
}

# Finds a known GUI editor in git's editor sources, to open a worktree in at a pause – every source
# is read, as tooling often sets `GIT_EDITOR=true`, a no-op that would mask one below
_DETECT_GUI_EDITOR () {
	local CMD BASE
	local -a W
	OPEN_EDITOR_CMD=""
	OPEN_EDITOR_NAME=""
	for CMD in "$GIT_EDITOR" "$(git config core.editor 2>/dev/null)" "$VISUAL" "$EDITOR"; do
		[ -z "$CMD" ] && continue
		# The command's first word as the shell reads it, a quoted or escaped path with spaces whole
		W=(${(z)CMD})
		BASE=${${(Q)W[1]}##*/}
		case "$BASE" in
			subl|sublime_text|sublime) OPEN_EDITOR_NAME="Sublime Text" ;;
			code)                      OPEN_EDITOR_NAME="VS Code" ;;
			code-insiders)             OPEN_EDITOR_NAME="VS Code Insiders" ;;
			cursor)                    OPEN_EDITOR_NAME="Cursor" ;;
			zed)                       OPEN_EDITOR_NAME="Zed" ;;
			mate)                      OPEN_EDITOR_NAME="TextMate" ;;
			atom)                      OPEN_EDITOR_NAME="Atom" ;;
			nova)                      OPEN_EDITOR_NAME="Nova" ;;
			bbedit)                    OPEN_EDITOR_NAME="BBEdit" ;;
			idea*)                     OPEN_EDITOR_NAME="IntelliJ IDEA" ;;
			pycharm*)                  OPEN_EDITOR_NAME="PyCharm" ;;
			webstorm*)                 OPEN_EDITOR_NAME="WebStorm" ;;
			phpstorm*)                 OPEN_EDITOR_NAME="PhpStorm" ;;
			rubymine*)                 OPEN_EDITOR_NAME="RubyMine" ;;
			goland*)                   OPEN_EDITOR_NAME="GoLand" ;;
			clion*)                    OPEN_EDITOR_NAME="CLion" ;;
			rider*)                    OPEN_EDITOR_NAME="Rider" ;;
			datagrip*)                 OPEN_EDITOR_NAME="DataGrip" ;;
			fleet)                     OPEN_EDITOR_NAME="Fleet" ;;
			xed)                       OPEN_EDITOR_NAME="Xed" ;;
		esac
		if [ -n "$OPEN_EDITOR_NAME" ]; then
			OPEN_EDITOR_CMD=$CMD
			return 0
		fi
	done
	return 1
}

# Launches the detected GUI editor on a worktree in the background, so the run keeps waiting at
# its prompt – a no-op where none was detected
_OPEN_WORKTREE_IN_EDITOR () {
	# Args: <worktree>
	[ -z "$OPEN_EDITOR_CMD" ] && return 0
	local DIR=$1
	( _CALLER_ENV_FULL; eval "$OPEN_EDITOR_CMD \"\$DIR\" >/dev/null 2>&1 &"; disown 2>/dev/null )
}

# Resumes or cancels this run's pause as a caller's own `--continue` or `--abort` would – in a run
# of its own, as every pause resumes, back in the caller's directory and environment
_RESUME_EXEC () {
	# Args: --continue | --abort, <the pause's identity, which the resumed run must find>
	# What the exit trap would clear – an exec skips it, and the pause keeps the rest
	[ ${#_TEMP_FILES} -gt 0 ] && rm -f "${_TEMP_FILES[@]}" 2>/dev/null
	[ -n "$_JOURNAL_HELD" ] && _JOURNAL_UNLOCK "$_JOURNAL_HELD"
	[ -n "$_SYNC_HELD" ] && _SYNC_HOLD_RELEASE
	[ -n "$_RUN_LOCK_HELD" ] && _RUN_WORKTREE_UNLOCK
	local W
	for W in "${_TEMP_WORKTREES[@]}"; do
		git worktree remove --force "$W" >/dev/null 2>&1
		rm -rf "$W"
	done
	cd "$_START_DIR" 2>/dev/null || cd "${$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null):h}"
	local -a ENV=(-u GIT_CONFIG_PARAMETERS "GIT_EDIT_EXPECT_PAUSE=$2") RUN=("$_SELF")
	[ -n "$_CALLER_GCP_SET" ] && ENV+=("GIT_CONFIG_PARAMETERS=$_CALLER_GCP")
	# A copy run as `zsh git-edit` need not be executable itself
	[ -x "$_SELF" ] || RUN=("${commands[zsh]:-zsh}" "$_SELF")
	trap - EXIT
	exec env "${ENV[@]}" "${_CALLER_ENV[@]}" "${RUN[@]}" "$1"
}

# Ends a run at the pause it recorded – a caller resumes with `--continue`, so the run exits with
# <code>, while a person at a terminal answers a prompt: Enter resumes it there and then, Escape
# cancels, q leaves the pause for later, and a hangup leaves it too
_PAUSE_EXIT () {
	# Args: <exit code> <conflict|edit|gate|retry> – what the pause waits for
	# A pause another run ended meanwhile is none to leave
	_REQUIRE_OWN_PAUSE
	# Its worktree's files read as modified only through their attributes settled, which the caller
	# would otherwise take for changes, and a blanket `git add` stage
	[ -n "$_STATE_OWNED" ] && [ -f "$_STATE_OWNED" ] && _RENORM_SETTLE "$(LC_ALL=C sed -n 's/^worktree=//p' "$_STATE_OWNED" | tail -1)"
	if [ "$2" = conflict ] && [ -n "$_STATE_OWNED" ] && [ -f "$_STATE_OWNED" ]; then
		_NOTE_STOP "$(LC_ALL=C sed -n 's/^worktree=//p' "$_STATE_OWNED" | tail -1)"
	fi
	_IS_NON_INTERACTIVE && exit $1
	{ [ -n "$_STATE_OWNED" ] && [ -f "$_STATE_OWNED" ]; } || exit $1
	# A pause awaiting a person holds no worktree lock, so an abort from elsewhere ends it as any
	# other – the resume Enter runs takes the worktree up again
	[ -n "$_RUN_LOCK_HELD" ] && _RUN_WORKTREE_UNLOCK
	local WT=$(LC_ALL=C sed -n 's/^worktree=//p' "$_STATE_OWNED" | tail -1)
	local PAUSE_ID=$(_PAUSE_IDENTITY "$_STATE_OWNED")
	local LEAD="" OPENED="" F PENDING=""
	local -a UNTOLD
	# What each conflicted file held as the prompt came up – markers git wrote tell a resolution by
	# their absence, while a file given none (a binary's, a side's deletion, a rerere prefill) only by
	# a change since, or a second Enter
	local -A PAUSE_MARKED PAUSE_HASH
	local PAUSE_STOP=""
	if [ "$2" = conflict ]; then
		PAUSE_STOP=$(git -C "$WT" rev-parse -q --verify REBASE_HEAD 2>/dev/null)
		for F in ${(0)"$(_UNMERGED_IN "$WT")"}; do
			_HAS_NEW_MARKERS "$WT" "$F" && PAUSE_MARKED[$F]=1
			PAUSE_HASH[$F]=$(_WORKTREE_HASH "$WT" "$F" 2>/dev/null || print -r -- -)
		done
	fi
	case $2 in
		conflict) LEAD="Resolve the conflicts in %s" ;;
		edit)     LEAD="Make your changes in %s" ;;
	esac
	_DETECT_GUI_EDITOR
	if [ -n "$LEAD" ] && [ -n "$OPEN_EDITOR_CMD" ] && [ -z "$GIT_EDIT_NO_AUTO_OPEN" ]; then
		_OPEN_WORKTREE_IN_EDITOR "$WT"
		OPENED=" (opened in $OPEN_EDITOR_NAME)"
	fi
	local KEYS="press %s to continue, %s to cancel, or %s to leave it paused"
	local -a ARGS=(Enter Escape q)
	[ -n "$OPEN_EDITOR_CMD" ] && { KEYS+=" – %s opens it in $OPEN_EDITOR_NAME"; ARGS+=(Space); }
	# Keys typed before a prompt showed answer nothing – each prompt drops them first
	_DRAIN_KEYS
	if [ -n "$LEAD" ]; then
		PRINT_TEXT "$LEAD$OPENED – then $KEYS." 35 "$WT" "${ARGS[@]}"
	else
		PRINT_TEXT "${(C)KEYS[1]}${KEYS[2,-1]}." 35 "${ARGS[@]}"
	fi
	# The pause's exit code, for a signal leaving it as q does
	_AT_PROMPT=$1
	# The refusal it follows is told – whatever ends the prompt names its own outcome
	_LAST_ERROR=""
	while true; do
		_READ_KEY
		# The slot may hold another run's pause by now – one this run's prompt must not resume or cancel
		if [[ "$REPLY" == (enter|escape|space) ]] && [ "$(_PAUSE_IDENTITY "$_STATE_OWNED")" != "$PAUSE_ID" ]; then
			_AT_PROMPT=""
			PRINT_ERR "This pause is no longer pending – another run ended it, resumed it to another stop, or took the slot – so nothing was done"
			exit 1
		fi
		case $REPLY in
			enter)
				# A conflict's files staged as resolved where their markers are gone, as a person
				# resolving one expects of Enter – the resume refuses markers still staged
				if [ "$2" = conflict ]; then
					if ! _STAGE_RESOLVED "$WT" "$PENDING"; then
						_AT_PROMPT=""
						PRINT_ERR "This pause is no longer pending – another run ended it, resumed it to another stop, or took the slot – so nothing was done"
						exit 1
					fi
					if (( ${#UNTOLD} )); then
						PENDING=${(pj:\0:)UNTOLD}
						_DRAIN_KEYS
						PRINT_TEXT "Nothing tells a resolution of %s – no markers, and unchanged since the pause. Press %s again to take it as it stands, or resolve it first." 33 "${(j:, :)UNTOLD}" Enter
						continue
					fi
				fi
				_RESUME_EXEC --continue "$PAUSE_ID" ;;
			escape)
				_DRAIN_KEYS
				PRINT_TEXT "Press %s again to cancel – what this run did in %s goes with it – or any other key to go back." 33 "Escape" "$WT"
				_READ_KEY
				if [ "$REPLY" = escape ]; then
					[ "$(_PAUSE_IDENTITY "$_STATE_OWNED")" = "$PAUSE_ID" ] && _RESUME_EXEC --abort "$PAUSE_ID"
					_AT_PROMPT=""
					PRINT_ERR "This pause is no longer pending – another run ended it, resumed it to another stop, or took the slot – so nothing was done"
					exit 1
				fi
				PRINT_TEXT "Not cancelled – ${KEYS}." 90 "${ARGS[@]}" ;;
			space)
				if [ -n "$OPEN_EDITOR_CMD" ]; then
					_OPEN_WORKTREE_IN_EDITOR "$WT"
				else
					PRINT_TEXT "${(C)KEYS[1]}${KEYS[2,-1]}." 90 "${ARGS[@]}"
				fi ;;
			quit|interrupt|eof)
				_LEAVE_PAUSED $1 ;;
			*)
				PRINT_TEXT "${(C)KEYS[1]}${KEYS[2,-1]}." 90 "${ARGS[@]}" ;;
		esac
	done
}

# Prints the commits the todo of <worktree>'s rebase still picks, full SHAs on one line
_TODO_PICKS () {
	# Args: <worktree>
	local TODO=$(git -C "$1" rev-parse --path-format=absolute --git-path rebase-merge/git-rebase-todo 2>/dev/null) LINE C
	local -a W PICKS
	[ -f "$TODO" ] || return 0
	while IFS= read -r LINE; do
		W=(${=LINE})
		[[ "${W[1]}" == (p|pick|r|reword|e|edit) ]] || continue
		C=$(git -C "$1" rev-parse -q --verify "${W[2]}^{commit}" 2>/dev/null) && PICKS+=("$C")
	done < "$TODO"
	print -r -- "${PICKS[*]}"
}

# Adds a step to the rebase paused in <worktree>, run once every pick is done, that saves git's own
# record of what each pick became, `rewritten-list`, beside the worktree – the rebase takes its
# state dir along as it ends, a hand-typed `git rebase --continue` running the step too – placed
# before the hold-back's trailing step, which must come last to tell who delivers
_RECORD_REPLAY_PAIRS () {
	# Args: <worktree>
	local TODO=$(git -C "$1" rev-parse --path-format=absolute --git-path rebase-merge/git-rebase-todo 2>/dev/null)
	local REC=$(git -C "$1" rev-parse --path-format=absolute --git-path git-edit-replayed 2>/dev/null) STEP LINE
	local -a STEPS
	local -i I AT
	STEP='exec cat "$(git rev-parse --git-path rebase-merge/rewritten-list)" >"$(git rev-parse --git-path git-edit-replayed)" 2>/dev/null; :'
	[ -f "$TODO" ] && [ -n "$REC" ] || return 0
	STEPS=("${(@f)$(<"$TODO")}")
	(( ${STEPS[(Ie)$STEP]} )) && return 0
	# One a run before left in a `-C` worktree is never this replay's
	rm -f "$REC"
	AT=$(( ${#STEPS} + 1 ))
	for (( I = ${#STEPS}; I >= 1; I-- )); do
		LINE=${STEPS[I]}
		[[ -z "$LINE" || "$LINE" == '#'* ]] && continue
		[[ "$LINE" == *git-edit-capture.*step.sh* ]] || break
		AT=$I
	done
	STEPS[AT,AT-1]=("$STEP")
	print -rl -- "${STEPS[@]}" > "$TODO.git-edit-replayed" && mv -f "$TODO.git-edit-replayed" "$TODO"
}

# Prints the commit the stop of <worktree>'s rebase builds, full SHA – the one its pick, reword or
# edit names, or for a fold's or a squash's step the pick its chain amends, as `done` lists them –
# none where the stop is no such step
_STOP_BUILDS () {
	# Args: <worktree>
	local DONE=$(git -C "$1" rev-parse --path-format=absolute --git-path rebase-merge/done 2>/dev/null)
	local -a W STEPS
	[ -f "$DONE" ] || return 0
	STEPS=(${(f)"$(LC_ALL=C grep -v '^#' "$DONE")"})
	local -i I=${#STEPS}
	while (( I > 0 )); do
		W=(${=STEPS[I]})
		case ${W[1]} in
			p|pick|r|reword|e|edit) git -C "$1" rev-parse -q --verify "${W[2]}^{commit}" 2>/dev/null; return 0 ;;
			f|fixup|s|squash) (( I-- )) ;;
			*) return 0 ;;
		esac
	done
	return 0
}

# Notes the stop <worktree>'s rebase is at, where it is not the one noted last: its pre-stop tip,
# kept across the re-pauses of one stop, so a resume finds the commits made by hand there, which
# the staged-marker guard never reads – and the commit it builds and its files, which a resolution
# may have filled with what a later commit changes – the landing checks what each later commit lost
# there – and at the first, the picks from it on in replay order, while a last step saves git's own
# record of what each pick became, which pairs each commit the replay rebuilds with its original
_NOTE_STOP () {
	# Args: <worktree> [<file>...] – files beside those it holds unmerged, as a resolved one holds none
	local SWT=$1 STOP SHEAD BUILDS DONE LAST F
	local -a SFILES SMARK
	shift
	STOP=$(git -C "$SWT" rev-parse -q --verify REBASE_HEAD 2>/dev/null)
	[ -n "$STOP" ] && [ "${STATE_STOP_HEAD#* }" != "$STOP" ] || return 0
	SHEAD=$(git -C "$SWT" rev-parse -q --verify HEAD 2>/dev/null) BUILDS=$(_STOP_BUILDS "$SWT")
	STATE_STOP_HEAD="$SHEAD $STOP"
	_STATE_NOTE "stop_head=$STATE_STOP_HEAD"
	# The files git gave markers here, which a resume stages once they are gone, as Enter does
	for F in ${(0)"$(_UNMERGED_IN "$SWT")"}; do _HAS_NEW_MARKERS "$SWT" "$F" && SMARK+=("$F"); done
	STATE_MARKED="$STOP${SMARK:+ ${(j: :)${(@qqqq)SMARK}}}"
	_STATE_NOTE "marked=$STATE_MARKED"
	if [ -z "$STATE_STOPS" ]; then
		STATE_REPLAY="${BUILDS:+$BUILDS }$(_TODO_PICKS "$SWT")"
		_STATE_NOTE "replay=$STATE_REPLAY"
	fi
	_RECORD_REPLAY_PAIRS "$SWT"
	SFILES=(${(0)"$(_UNMERGED_IN "$SWT")"} "$@")
	SFILES=("${(@u)SFILES:#}")
	STATE_STOPS="${STATE_STOPS:+$STATE_STOPS }$SHEAD:$BUILDS"
	(( ${#SFILES} )) && STATE_STOPS+=" ${(j: :)${(@qqqq)SFILES}}"
	_STATE_NOTE "stops=$STATE_STOPS"
	# And the picks still to come, which a rebase quit there never makes – the stopped one first
	# where it is a pick, a fixup's own commit going into the one before it, and a replant's or a
	# land's being one `--skip` may step over
	DONE=$(git -C "$SWT" rev-parse --path-format=absolute --git-path rebase-merge/done 2>/dev/null)
	[ -f "$DONE" ] && LAST=$(LC_ALL=C grep -v '^#' "$DONE" | tail -1)
	[[ "${LAST%% *}" == (p|pick|r|reword|e|edit) ]] || STOP=
	LC_ALL=C grep -qxE 'operation=(onto|land)' "$_STATE_OWNED" 2>/dev/null && STOP=
	STATE_TODO_LEFT="${STOP:+$STOP }$(_TODO_PICKS "$SWT")"
	_STATE_NOTE "todo_left=$STATE_TODO_LEFT"
}

# Notes the stops a hand `git rebase --continue` in <worktree> passed since the stop noted last,
# which no pause saw: each commit the replay rebuilt past that stop's own, and the stop the rebase
# is at now – each with the files its pick and its result change, as a resolved stop names no
# conflicted file – read by the absorption guard as stops it saw, a clean pick taking in nothing
# Checks the commits a rebase still in progress made past it for markers first, as a hand finish's
_NOTE_STOPS_PASSED () {
	# Args: <worktree> [<rev a side came from>...]
	local WT=$1 STOP=${${STATE_STOP_HEAD#* }:#$STATE_STOP_HEAD} GD NOW LAST R C T
	local -a W SEEN FILES REBUILT LEFT_OUT
	local -A PAIRED CHAIN
	shift
	[ -n "$STOP" ] && [ -n "$STATE_REPLAY" ] || return 0
	GD=$(git -C "$WT" rev-parse --path-format=absolute --git-dir 2>/dev/null)
	if [ -d "$GD/rebase-merge" ]; then
		# Still at that stop where the last step git did is its own
		LAST=$(LC_ALL=C grep -v '^#' "$GD/rebase-merge/done" 2>/dev/null | tail -1)
		W=(${=LAST})
		[ "$(git -C "$WT" rev-parse -q --verify "${W[2]}^{commit}" 2>/dev/null)" = "$STOP" ] && return 0
		NOW=$(git -C "$WT" rev-parse -q --verify REBASE_HEAD 2>/dev/null)
		_GUARD_HAND_FINISH "$WT" "$@" ${NOW:+"$NOW"}
	fi
	for T in ${(z)STATE_STOPS}; do [[ "$T" == \$\'* ]] || SEEN+=("${T#*:}"); done
	_SPAN_ABOVE_STOP "$WT" "${STATE_STOP_HEAD%% *}" HEAD && _PAIR_REPLAYED "$WT" "$REPLY" HEAD
	for R in "${REBUILT[@]}"; do
		[ -n "${PAIRED[$R]}" ] && (( ! ${SEEN[(Ie)${PAIRED[$R]}]} )) || continue
		FILES=()
		for C in ${=CHAIN[$R]} "$R"; do
			FILES+=(${(0)"$(git -C "$WT" diff-tree -r -z --root --no-commit-id --name-only --no-renames "$C" 2>/dev/null)"})
		done
		FILES=("${(@u)FILES}")
		STATE_STOPS+=" $(git -C "$WT" rev-parse -q --verify "$R^" 2>/dev/null):${PAIRED[$R]}"
		(( ${#FILES} )) && STATE_STOPS+=" ${(j: :)${(@qqqq)FILES}}"
	done
	_STATE_NOTE "stops=$STATE_STOPS"
	[ -n "$NOW" ] || return 0
	FILES=(${(0)"$(git -C "$WT" diff-tree -r -z --root --no-commit-id --name-only --no-renames "$NOW" 2>/dev/null)"}
		${(0)"$(git -C "$WT" diff --cached -z --name-only --no-renames HEAD 2>/dev/null)"})
	_NOTE_STOP "$WT" "${FILES[@]}"
}

# Notes the stop the pause's worktree stands at where the pause recorded no stops – one an older
# version wrote – as a pause there would have, so the guards reading them run as for one
# Its files those its pick and the resolution change, as a resolved stop names no conflicted file –
# its pre-stop tip the one such a pause kept, else the tip now, a commit made there by hand unseen
_NOTE_UNRECORDED_STOP () {
	local WT=$STATE_WORKTREE GD STOP TIP=""
	local -a FILES
	[ -z "$STATE_STOPS" ] && [ -n "$WT" ] && [ -d "$WT" ] || return 0
	GD=$(git -C "$WT" rev-parse --absolute-git-dir 2>/dev/null)
	[ -n "$GD" ] && [ -d "$GD/rebase-merge" ] || return 0
	STOP=$(git -C "$WT" rev-parse -q --verify REBASE_HEAD 2>/dev/null) || return 0
	FILES=(${(0)"$(git -C "$WT" diff-tree -r -z --root --no-commit-id --name-only --no-renames "$STOP" 2>/dev/null)"}
		${(0)"$(git -C "$WT" diff --cached -z --name-only --no-renames HEAD 2>/dev/null)"})
	[ "${STATE_STOP_HEAD#* }" = "$STOP" ] && TIP=${STATE_STOP_HEAD%% *}
	STATE_STOP_HEAD=""
	_NOTE_STOP "$WT" "${FILES[@]}"
	[ -n "$TIP" ] && [ -n "$STATE_STOPS" ] && [ "$TIP" != "${STATE_STOP_HEAD%% *}" ] || return 0
	STATE_STOP_HEAD="$TIP $STOP" STATE_STOPS="$TIP:${STATE_STOPS#*:}"
	_STATE_NOTE "stop_head=$STATE_STOP_HEAD"
	_STATE_NOTE "stops=$STATE_STOPS"
}

# Refuses a resume landing a rebase that stopped short – quit by hand, files left unmerged –
# where none is in progress: each pick left at the last stop is in git's own record of what each
# pick became, which the replay's last step saved, one git left out as emptied too – a quit never
# runs that step – and without that record, matched by author, date and subject as a replay keeps
# them, a missing one passing where a later one made it, a missing tail being a quit's
# Offers no landing of the worktree as it stands, which would pass by the guards judging each pick
_REQUIRE_REPLAY_DONE () {
	# Args: <worktree>
	local WT=$1 C KEY FROM=${STATE_STOP_HEAD%% *} REC NEW LINE
	local -a MISSING RECS
	local -A HAVE
	if [ -n "$(_UNMERGED_IN "$WT")" ]; then
		_CLEANUP_HOOK=""
		PRINT_ERR "The rebase in $WT ended with files still unmerged – quit by hand, say – so nothing was applied"
		ECHO_E "\e[0;31m  Cancel with 'git edit --abort', then run it again.\e[0m" >&2
		exit 1
	fi
	[ -n "$STATE_TODO_LEFT" ] || return 0
	REC=$(git -C "$WT" rev-parse --path-format=absolute --git-path git-edit-replayed 2>/dev/null)
	[ -n "$REC" ] && [ -s "$REC" ] && RECS=(${(f)"$(<"$REC")"})
	# This replay's where it ends on a commit built on the stop that the worktree's tip holds
	(( ${#RECS} )) && NEW=${${RECS[-1]#* }%% *}
	if [ -n "$NEW" ] && git -C "$WT" merge-base --is-ancestor "$NEW" HEAD 2>/dev/null && \
	   { [ -z "$FROM" ] || _SPAN_ABOVE_STOP "$WT" "$FROM" "$NEW"; }; then
		for LINE in "${RECS[@]}"; do HAVE[${LINE%% *}]=1; done
		for C in ${=STATE_TODO_LEFT}; do
			(( ${+HAVE[$C]} )) || MISSING+=("$C")
		done
		(( ${#MISSING} )) || return 0
		_CLEANUP_HOOK=""
		PRINT_ERR "The rebase in $WT finished without ${#MISSING} of its commit(s) – taken out of its todo by hand, say – so nothing was applied"
	else
		for KEY in "${(@f)$(git -C "$WT" log --format='%an%x1f%ae%x1f%at%x1f%s' ${FROM:+"$FROM..HEAD"} 2>/dev/null)}"; do
			HAVE[$KEY]=1
		done
		for C in ${=STATE_TODO_LEFT}; do
			KEY=$(git -C "$WT" log -1 --format='%an%x1f%ae%x1f%at%x1f%s' "$C" 2>/dev/null)
			if (( ${+HAVE[$KEY]} )); then MISSING=(); else MISSING+=("$C"); fi
		done
		(( ${#MISSING} )) || return 0
		_CLEANUP_HOOK=""
		PRINT_ERR "The rebase in $WT stopped short of its last ${#MISSING} commit(s) – quit by hand, say – so nothing was applied"
	fi
	git -C "$WT" log --no-walk=unsorted --format='%h %s' "${MISSING[@]}" 2>/dev/null | _CARET_LINES | LC_ALL=C sed "s/^/${_RED}  /;s/\$/${_OFF}/" >&2
	ECHO_E "\e[0;31m  Cancel with 'git edit --abort', then run it again.\e[0m" >&2
	exit 1
}

# Prints the tree replaying <pick> onto <onto> in <worktree> makes, merged as a rebase merges it –
# failing (1) where that conflicts, and (2) where it can't tell: a root pick
_PICK_ONTO_TREE () {
	# Args: <worktree> <pick> <onto>
	local B OUT
	B=$(git -C "$1" rev-parse -q --verify "$2^" 2>/dev/null) || return 2
	if ! _MERGE_TREE_TAKES_BASE; then
		_PICK_PATHS_ONTO "$@" "$B"
		return
	fi
	OUT=$(git -C "$1" merge-tree --write-tree --merge-base="$B" "$3" "$2" 2>/dev/null) || return 1
	print -r -- "${OUT%%$'\n'*}"
}

# `_PICK_ONTO_TREE` where `merge-tree` takes no merge base (before 2.40) – each path the pick
# changes merged on its own, following no rename, failing (1) where one conflicts, a link, a binary
# or a deletion changed on both sides counting as one, so the caller refuses rather than passes it
_PICK_PATHS_ONTO () {
	# Args: <worktree> <pick> <onto> <pick's parent>
	local WT=$1 P B O T BM OM TM M ID IDX O_F B_F T_F TREE NULL=${(l:${#4}::0:)}
	local -i I
	local -a F W INFO
	local -A BASE THEIRS OURS
	# `:<old mode> <new mode> <old id> <new id> <status>` and the path, an entry "<mode> <id>" or
	# empty where the side has none
	F=(${(0)"$(git -C "$WT" diff-tree -r --no-renames -z "$4" "$2" 2>/dev/null)"})
	for (( I = 1; I + 1 <= ${#F}; I += 2 )); do
		W=(${=F[I]#:})
		BASE[${F[I + 1]}]=${${W[1]:#000000}:+${W[1]} ${W[3]}}
		THEIRS[${F[I + 1]}]=${${W[2]:#000000}:+${W[2]} ${W[4]}}
	done
	F=(${(0)"$(git -C "$WT" diff-tree -r --no-renames -z "$4" "$3" 2>/dev/null)"})
	for (( I = 1; I + 1 <= ${#F}; I += 2 )); do
		(( ${+BASE[${F[I + 1]}]} )) || continue
		W=(${=F[I]#:})
		OURS[${F[I + 1]}]=${${W[2]:#000000}:+${W[2]} ${W[4]}}
	done
	{
		for P in "${(@k)THEIRS}"; do
			B=${BASE[$P]} T=${THEIRS[$P]}
			if (( ${+OURS[$P]} )); then O=${OURS[$P]}; else O=$B; fi
			[ "$O" = "$T" ] && continue
			if [ "$O" = "$B" ]; then
				INFO+=("${T:-0 $NULL}"$'\t'"$P")
				continue
			fi
			# Changed on both sides, each a file still, its mode changed on one side at most
			BM=${B% *} OM=${O% *} TM=${T% *}
			[[ "$BM" == 100(644|755) && "$OM" == 100(644|755) && "$TM" == 100(644|755) ]] || return 1
			[ "$OM" = "$BM" ] || [ "$TM" = "$BM" ] || [ "$OM" = "$TM" ] || return 1
			if [ "$OM" = "$BM" ]; then M=$TM; else M=$OM; fi
			if [ "${O#* }" = "${B#* }" ]; then ID=${T#* }
			elif [ "${T#* }" = "${B#* }" ]; then ID=${O#* }
			else
				[ -n "$O_F" ] || { O_F=$(MKTEMP_FILE git-edit-ours) B_F=$(MKTEMP_FILE git-edit-base) T_F=$(MKTEMP_FILE git-edit-theirs); _TEMP_FILES+=("$O_F" "$B_F" "$T_F"); }
				git -C "$WT" cat-file blob "${O#* }" > "$O_F" && git -C "$WT" cat-file blob "${B#* }" > "$B_F" && \
					git -C "$WT" cat-file blob "${T#* }" > "$T_F" && git merge-file -q "$O_F" "$B_F" "$T_F" 2>/dev/null && \
					ID=$(git -C "$WT" hash-object -w --no-filters -- "$O_F" 2>/dev/null) || return 1
			fi
			INFO+=("$M $ID"$'\t'"$P")
		done
		IDX=$(MKTEMP_FILE git-edit-pick-index)
		_TEMP_FILES+=("$IDX")
		rm -f "$IDX"
		GIT_INDEX_FILE=$IDX git -C "$WT" read-tree "$3" 2>/dev/null && \
			{ (( ! ${#INFO} )) || print -rN -- "${INFO[@]}" | GIT_INDEX_FILE=$IDX git -C "$WT" update-index -z --index-info 2>/dev/null; } && \
			TREE=$(GIT_INDEX_FILE=$IDX git -C "$WT" write-tree 2>/dev/null) || return 1
		print -r -- "$TREE"
	} always {
		rm -f -- ${IDX:+"$IDX"} ${O_F:+"$O_F"} ${B_F:+"$B_F"} ${T_F:+"$T_F"}
	}
}

# Refuses a resume where a pick the replay had still to make at its first stop is lost – taken out
# of its todo by hand, or left out where its change is not already there, as a hand
# `git rebase --skip` leaves one – unless git-edit let it go: a replant's or a land's own `--skip`,
# or a stop's resolution staged empty and continued through it
# • Read mid-rebase against its done and todo steps and git's record of what each pick became – a
#   left-out pick is one recorded against a commit an earlier pick claimed, or the first stop's tip
# • A fold's left-out pick passes where it ends on the tree it staged
_REQUIRE_PICKS_KEPT () {
	# Args: <worktree>
	local WT=$1 GD REC LINE OLD NEW C TREE FIRST=${${STATE_STOPS%% *}%%:*} INPROGRESS="" FOLDED=""
	local -a PICKS W NAMES RECS LOST
	local -A LISTED CLAIMED KEPT LEFT
	[ -n "$STATE_REPLAY" ] || return 0
	PICKS=(${=STATE_REPLAY})
	GD=$(git -C "$WT" rev-parse --path-format=absolute --git-dir 2>/dev/null) || return 0
	if [ -d "$GD/rebase-merge" ]; then
		INPROGRESS=1
		# Each pick still one of its steps, done or to come, a hand-edited todo naming it short
		for LINE in "${(@f)$(LC_ALL=C cat -- "$GD/rebase-merge/done" "$GD/rebase-merge/git-rebase-todo" 2>/dev/null)}"; do
			W=(${=LINE})
			[[ "${W[1]}" == (p|pick|r|reword|e|edit|f|fixup|s|squash) && -n "${W[2]}" ]] && NAMES+=("${W[2]}")
		done
		(( ${#NAMES} )) && for LINE in ${(f)"$(print -rl -- "${NAMES[@]}" | git -C "$WT" cat-file --batch-check='%(objectname)' 2>/dev/null)"}; do
			LISTED[${LINE%% *}]=1
		done
		for C in "${PICKS[@]}"; do
			(( ${+LISTED[$C]} )) || LOST+=("$C taken out of its todo by hand")
		done
		REC=$GD/rebase-merge/rewritten-list
	else
		REC=$(git -C "$WT" rev-parse --path-format=absolute --git-path git-edit-replayed 2>/dev/null)
	fi
	[ -n "$REC" ] && [ -s "$REC" ] && RECS=(${(f)"$(<"$REC")"})
	# A finished replay's record is this one's only where it ends on a commit the tip holds
	if [ -z "$INPROGRESS" ]; then
		(( ${#RECS} )) && git -C "$WT" merge-base --is-ancestor "${${RECS[-1]#* }%% *}" HEAD 2>/dev/null || return 0
	fi
	for LINE in "${RECS[@]}"; do
		OLD=${LINE%% *} NEW=${${LINE#* }%% *}
		if (( ${+CLAIMED[$NEW]} )) || [ "$NEW" = "$FIRST" ]; then
			(( ${+KEPT[$OLD]} )) || LEFT[$OLD]=$NEW
		else
			CLAIMED[$NEW]=1 KEPT[$OLD]=1
		fi
	done
	# A fold ending on the tree it staged lost nothing a later commit made – one gone empty where the
	# fold overrides its lines is the fold's doing, by a hand continue too – so judged once finished
	if [ "$STATE_OPERATION" = amend-into ] && [ -n "$STATE_STAGEDTREE" ]; then
		[ -n "$INPROGRESS" ] || _SAME_TREE "$(git -C "$WT" rev-parse -q --verify HEAD 2>/dev/null)" "$STATE_STAGEDTREE" && FOLDED=1
	fi
	for C in "${PICKS[@]}"; do
		if (( ${+LEFT[$C]} )); then
			[[ -n "$FOLDED" || " $STATE_SKIPPED " == *" $C "* ]] && continue
			# Left out as emptied where its change is already on the commit it was recorded against
			TREE=$(_PICK_ONTO_TREE "$WT" "$C" "${LEFT[$C]}")
			case $? in
				0) [ "$TREE" = "$(git -C "$WT" rev-parse -q --verify "${LEFT[$C]}^{tree}" 2>/dev/null)" ] && continue ;;
				2) continue ;;
			esac
			LOST+=("$C left out by hand, its change not already there – a 'git rebase --skip' run there, say")
		elif [ -z "$INPROGRESS" ] && (( ! ${+KEPT[$C]} )); then
			LOST+=("$C taken out of its todo by hand")
		fi
	done
	(( ${#LOST} )) || return 0
	_CLEANUP_HOOK=""
	PRINT_ERR "The rebase in $WT lost ${#LOST} of its commit(s), their changes missing from what it builds – so nothing was applied"
	for LINE in "${LOST[@]}"; do
		print -r -- "$(git -C "$WT" log -1 --format='%h %s' "${LINE%% *}" 2>/dev/null) – ${LINE#* }"
	done | _CARET_LINES | LC_ALL=C sed "s/^/${_RED}  /;s/\$/${_OFF}/" >&2
	if [[ "$STATE_OPERATION" == (onto|land) ]]; then
		ECHO_E "\e[0;31m  Cancel with 'git edit --abort', then run it again – 'git edit --skip' at a commit's stop is how to leave it out.\e[0m" >&2
	else
		ECHO_E "\e[0;31m  Cancel with 'git edit --abort', then run it again – a stop resolved to empty goes with 'git edit --continue'.\e[0m" >&2
	fi
	exit 1
}

# Notes the pick <worktree>'s rebase stopped at as one this resume lets go – a replant's or a land's
# `--skip`, or a resolution staged empty, which the continue leaves out as git's own skip would –
# for `_REQUIRE_PICKS_KEPT` to read as the caller's call, which a hand skip never is
_NOTE_LET_GO () {
	# Args: <worktree>
	local STOP=$(git -C "$1" rev-parse -q --verify REBASE_HEAD 2>/dev/null)
	[ -n "$STOP" ] || return 0
	if [ ${#OPT_SKIP} -eq 0 ]; then
		[ -z "$(_UNMERGED_IN "$1")" ] || return 0
		git -C "$1" diff-index --cached --quiet --ignore-submodules=none HEAD -- 2>/dev/null || return 0
	fi
	# Apart, the stops `--skip` left, where git records the pick against whatever HEAD holds
	if [ ${#OPT_SKIP} -gt 0 ] && [[ " $STATE_FLAG_SKIPS " != *" $STOP "* ]]; then
		STATE_FLAG_SKIPS="${STATE_FLAG_SKIPS:+$STATE_FLAG_SKIPS }$STOP"
		_STATE_NOTE "flag_skips=$STATE_FLAG_SKIPS"
	fi
	[[ " $STATE_SKIPPED " == *" $STOP "* ]] && return 0
	STATE_SKIPPED="${STATE_SKIPPED:+$STATE_SKIPPED }$STOP"
	_STATE_NOTE "skipped=$STATE_SKIPPED"
}

# Clears what a pick left staged where its commit failed – a signature not made, say – and git put
# the pick back first in the todo: no continue gets past staged changes with no message pending,
# and the pick, run again, makes them anew – so only where they are just that, nothing else changed
_CLEAR_RESCHEDULED_PICK () {
	# Args: <worktree>
	local WT=$1 GD PICK TREE
	local -a W
	GD=$(git -C "$WT" rev-parse --path-format=absolute --git-dir 2>/dev/null)
	[ -d "$GD/rebase-merge" ] && [ ! -e "$GD/rebase-merge/message" ] || return 0
	PICK=$(git -C "$WT" rev-parse -q --verify REBASE_HEAD 2>/dev/null) || return 0
	[ -z "$(_UNMERGED_IN "$WT")" ] || return 0
	git -C "$WT" diff-files --quiet --ignore-submodules=none 2>/dev/null || return 0
	git -C "$WT" diff-index --cached --quiet --ignore-submodules=none HEAD -- 2>/dev/null && return 0
	# The pick git ran last, and put back to run next
	W=(${=$(LC_ALL=C grep -v '^#' "$GD/rebase-merge/done" 2>/dev/null | tail -1)})
	[[ "${W[1]}" == (p|pick|r|reword) ]] && [ "$(git -C "$WT" rev-parse -q --verify "${W[2]}^{commit}" 2>/dev/null)" = "$PICK" ] || return 0
	W=(${=$(_REBASE_TODO_LEFT "$GD" | head -1)})
	[[ "${W[1]}" == (p|pick|r|reword) ]] && [ "$(git -C "$WT" rev-parse -q --verify "${W[2]}^{commit}" 2>/dev/null)" = "$PICK" ] || return 0
	TREE=$(_PICK_ONTO_TREE "$WT" "$PICK" HEAD)
	case $? in
		0) [ "$TREE" = "$(git -C "$WT" write-tree 2>/dev/null)" ] || return 0 ;;
		1) return 0 ;;
		# Where the merge can't tell, the staged change is the pick's own patch
		*)
			TREE=$(git -C "$WT" diff-index --cached -p --no-renames --ignore-submodules=none HEAD -- 2>/dev/null | git -C "$WT" patch-id --stable 2>/dev/null)
			[ -n "$TREE" ] && [ "${TREE%% *}" = "${$(git -C "$WT" diff-tree -p --no-renames --ignore-submodules=none "$PICK" 2>/dev/null | git -C "$WT" patch-id --stable 2>/dev/null)%% *}" ] || return 0 ;;
	esac
	git -C "$WT" read-tree -u --reset HEAD 2>/dev/null || return 0
	PRINT_TEXT "%s left its change staged as its commit failed – cleared, so the rebase makes it again" 90 "$(git -C "$WT" log -1 --format='%h %s' "$PICK" 2>/dev/null | _CARET_LINES)"
}

# Refuses a resume where the rebase was aborted by hand, back on the tip it began from – a drop,
# squash, reorder or replant is never a no-op, so nothing was applied
_REFUSE_HAND_ABORT () {
	_CLEANUP_HOOK=""
	PRINT_ERR "The rebase in $STATE_WORKTREE was aborted by hand – nothing was applied"
	ECHO_E "\e[0;31m  Clear the pause with 'git edit --abort'.\e[0m" >&2
	exit 1
}

# Tells whether the loaded pause's worktree, its rebase gone, is back on the commit that rebase
# began from – as each mode's resume reads it, refusing it as aborted by hand
_PAUSE_HAND_ABORTED () {
	local BEGAN
	case "$STATE_OPERATION" in
		rebase|onto) BEGAN=$STATE_ORIG_HEAD ;;
		land) BEGAN=$STATE_TARGET ;;
		reorder) BEGAN=${STATE_PLACED:-$STATE_ORIG_HEAD} ;;
		amend-into) BEGAN=$STATE_FIXUP ;;
		# Past the amend, the replay checked out the tip it read – where that was the target, nothing ran
		edit) [ -n "$STATE_AMENDED" ] && [ "$STATE_REPLAY_TIP" != "$STATE_TARGET" ] && BEGAN=$STATE_REPLAY_TIP ;;
	esac
	[ -n "$BEGAN" ] && [ "$(git -C "$STATE_WORKTREE" rev-parse -q --verify HEAD 2>/dev/null)" = "$BEGAN" ]
}

# Names the commands that take up a pause left for later
_PRINT_LEFT_PAUSED () {
	PRINT_TEXT "Left paused – resume with %s, or cancel with %s." 33 "git edit --continue" "git edit --abort"
}

# Ends a run at its prompt with the pause left for later – q's way, a signal's too – a refusal the
# prompt followed ending as the pause it left, rather than as that error
_LEAVE_PAUSED () {
	# Args: <the pause's exit code>
	local F
	_AT_PROMPT=""
	_PRINT_LEFT_PAUSED
	if [ "$_STATUS_EMITTED" != true ]; then
		F=$(LC_ALL=C sed -n 's/^action=//p' "$_STATE_OWNED" | tail -1)
		EMIT_PAUSED "${F:-$(LC_ALL=C sed -n 's/^operation=//p' "$_STATE_OWNED" | tail -1)}" "$(LC_ALL=C sed -n 's/^target=//p' "$_STATE_OWNED" | tail -1)" "$(LC_ALL=C sed -n 's/^worktree=//p' "$_STATE_OWNED" | tail -1)"
		exit 2
	fi
	exit $1
}

# Names the pause a state file holds, and the stop it is at, by what no other note to it changes –
# asked again after each key, as another run may have ended it and taken the slot meanwhile, or
# resumed it on to a stop the prompt never showed
_PAUSE_IDENTITY () {
	# Args: <state file>
	LC_ALL=C grep -aE '^(operation|worktree|branch|orig_head|target|nonce|stop_head)=' "$1" 2>/dev/null
}

# Names the pause a state file holds whatever stop it is at – what a run that wrote or took it up
# checks the slot against before writing, landing or clearing anything of it
_PAUSE_KEYS () {
	# Args: <state file>
	LC_ALL=C grep -aE '^(operation|worktree|branch|orig_head|target|nonce)=' "$1" 2>/dev/null
}

# Refuses to go on with a pause another run ended while this one resumed it – an abort, say, after
# which the slot may hold a new run's pause, one nothing here may note into, land over or clear
_REQUIRE_OWN_PAUSE () {
	# Args: [<what was not done>, "nothing was applied" by default]
	[ -n "$_STATE_OWNED" ] && [ -n "$_STATE_ID" ] || return 0
	[ "$(_PAUSE_KEYS "$_STATE_OWNED")" = "$_STATE_ID" ] && return 0
	_CLEANUP_HOOK=""
	_STATE_OWNED="" _STATE_ID=""
	PRINT_ERR "The pause this run took up was ended by another run meanwhile – ${1:-nothing was applied}"
	ECHO_E "\e[0;31m  'git edit --status' names what is paused now, if anything.\e[0m" >&2
	exit 1
}

# Refuses a resume whose pause another run took on while this one waited to hold its worktree –
# resumed to a later stop or noted into, so what this run read no longer tells where it stands, and
# its notes would overwrite that run's
_REQUIRE_PAUSE_AS_READ () {
	_REQUIRE_OWN_PAUSE
	{ [ -z "$_STATE_OWNED" ] || [ "$(<"$_STATE_OWNED")" = "$_STATE_READ" ]; } 2>/dev/null && return 0
	_CLEANUP_HOOK=""
	_STATE_OWNED="" _STATE_ID=""
	PRINT_ERR "Another run resumed this pause while this one waited to take it up – nothing was applied"
	ECHO_E "\e[0;31m  'git edit --status' names where it stands now – resolve what is left there, then 'git edit --continue' again.\e[0m" >&2
	exit 1
}

# Ends the pause an abort took up before anything of it goes – under the journal's lock a resume
# lands under, refused where another run ended it meanwhile, its state cleared there so no resume
# lands it after, and where one landed it first, `LANDED` set, as its journal entry tells
_ABORT_TAKE_PAUSE () {
	# Args: [<label the landing journals, as `edit <sha>`>]
	# Refused where the lock can't be had, a resume's slow landing waited out up to 60 s – going on
	# without it, an abort would end a pause landing under it
	local JF="" RC
	if [ -z "$_JOURNAL_HELD" ] && JF=$(_JOURNAL_FILE_PATH); then
		_JOURNAL_LOCK "$JF"
		RC=$?
		if (( RC )); then
			_REFUSE_JOURNAL_LOCK "$JF" "nothing was cancelled" $RC
			exit 1
		fi
	fi
	if [ -n "$1" ]; then
		# A resume landing it meanwhile ended it with its journal entry –
		# named as that, rather than as a pause some other run ended
		if [ "$(_PAUSE_KEYS "$_STATE_OWNED")" != "$_STATE_ID" ] && _PAUSE_LANDED "$1" gone; then
			_STATE_OWNED="" _STATE_ID=""
			PRINT_ERR "The paused operation had landed already ($1), its resume ending the pause this run took up – nothing was cancelled"
			ECHO_E "\e[0;31m  It stands as the branch's last move – 'git edit --undo' takes it back, should it not.\e[0m" >&2
			exit 1
		fi
		_PAUSE_LANDED "$1" && LANDED=1
	fi
	# The check right before the clear, nothing between
	_REQUIRE_OWN_PAUSE "nothing was cancelled"
	# From the clear on, a first signal lets the abort finish as one lets a landing – stopped there,
	# its worktree would outlive the pause, which no later abort could name – and a second one
	# leaves it to the exit trap: the rebase aborted, a worktree of git-edit's own removed
	_CANCELLED_PAUSE=${1:-${STATE_OPERATION:-pause}}
	_LANDING=true
	if [ -n "$STATE_WORKTREE" ] && { [ ! -d "$STATE_WORKTREE" ] || _PAUSE_WT_HERE quiet; }; then
		_CLEANUP_HOOK+="${_CLEANUP_HOOK:+; }git -C ${(q-)STATE_WORKTREE} rebase --abort >/dev/null 2>&1"
		_STATE_WT_OURS && _CLEANUP_HOOK+="; git worktree remove --force ${(q-)STATE_WORKTREE} 2>/dev/null; rm -rf ${(q-)STATE_WORKTREE}; _UNREGISTER_GONE_WORKTREE ${(q-)STATE_WORKTREE}"
	fi
	_CLEAR_STATE
	[ -n "$JF" ] && _JOURNAL_UNLOCK "$JF"
	return 0
}

# Drops whatever keys wait unread, so none typed ahead answers a prompt not yet shown
_DRAIN_KEYS () {
	local K
	while IFS= read -rs -t 0 -k1 K 2>/dev/null; do :; done
	return 0
}

# Tells whether <worktree>'s <file> holds conflict-marker lines no side brought, at the file's own
# `conflict-marker-size` – as `_MARKED_PATHS` reads a staged blob – a link never
_HAS_NEW_MARKERS () {
	# Args: <worktree> <file, from the top>
	local N RE HAVE OWN="" SIDE
	[ -L "$1/$2" ] && return 1
	N=$(git -C "$1" check-attr conflict-marker-size -- "$2" 2>/dev/null)
	N=${N##*: }
	[[ "$N" == <1-> ]] || N=7
	_MARKER_RE "$N"; RE=$REPLY
	HAVE=$(LC_ALL=C grep -aE "$RE" -- "$1/$2" 2>/dev/null)
	[ -n "$HAVE" ] || return 1
	for SIDE in HEAD REBASE_HEAD; do
		OWN+=$(git -C "$1" show "$SIDE:$2" 2>/dev/null | LC_ALL=C grep -aE "$RE")$'\n'
	done
	[ -n "$(LC_ALL=C comm -23 <(print -r -- "$HAVE" | LC_ALL=C sort -u) <(print -r -- "$OWN" | LC_ALL=C sort -u))" ]
}

# Stages each conflicted file of <worktree> its resolution shows in – the markers it was given gone,
# a deletion too, or one given none changed since the pause or confirmed – and names what it staged,
# leaving the rest named in `UNTOLD` – failing, with nothing more staged, once the rebase there is
# past the stop the prompt showed, which another run resuming it meanwhile moved on
_STAGE_RESOLVED () {
	# Args: <worktree> <files confirmed as they stand, NUL-joined>
	# Reads the prompt's `PAUSE_MARKED`, `PAUSE_HASH` and `PAUSE_STOP`
	local F
	local -a DONE CONFIRMED
	local -x GIT_LITERAL_PATHSPECS=1
	CONFIRMED=("${(@0)2}")
	UNTOLD=()
	for F in ${(0)"$(_UNMERGED_IN "$1")"}; do
		# Only the prompt's own stop's files – one conflicted since is a later stop's
		(( ${+PAUSE_HASH[$F]} )) || continue
		[ "$(git -C "$1" rev-parse -q --verify REBASE_HEAD 2>/dev/null)" = "$PAUSE_STOP" ] || return 1
		if (( ${+PAUSE_MARKED[$F]} )); then
			{ [ -e "$1/$F" ] || [ -L "$1/$F" ]; } && _HAS_NEW_MARKERS "$1" "$F" && continue
		elif (( ! ${CONFIRMED[(Ie)$F]} )) && [ "$(_WORKTREE_HASH "$1" "$F" 2>/dev/null || print -r -- -)" = "${PAUSE_HASH[$F]--}" ]; then
			UNTOLD+=("$F")
			continue
		fi
		git -C "$1" add -A -- "$F" 2>/dev/null && DONE+=("$F")
	done
	(( ${#DONE} )) && PRINT_TEXT "Staged as resolved: %s" 90 "${(j:, :)DONE}"
	return 0
}

# Stages each conflicted file of <worktree>'s stop whose markers git gave it are gone, a deletion
# too, as Enter at the prompt does – one given none, or at a stop the pause noted none for, stays
# as it is, as nothing tells its resolution
_STAGE_MARKS_GONE () {
	# Args: <worktree> – reads the pause's `STATE_MARKED`
	local F
	local -a W DONE
	local -A GIVEN
	local -x GIT_LITERAL_PATHSPECS=1
	W=("${(@Q)${(z)STATE_MARKED}}")
	(( ${#W} > 1 )) && [ "${W[1]}" = "$(git -C "$1" rev-parse -q --verify REBASE_HEAD 2>/dev/null)" ] || return 0
	for F in "${(@)W[2,-1]}"; do GIVEN[$F]=1; done
	for F in ${(0)"$(_UNMERGED_IN "$1")"}; do
		(( ${+GIVEN[$F]} )) || continue
		{ [ -e "$1/$F" ] || [ -L "$1/$F" ]; } && _HAS_NEW_MARKERS "$1" "$F" && continue
		git -C "$1" add -A -- "$F" 2>/dev/null && DONE+=("$F")
	done
	(( ${#DONE} )) && PRINT_TEXT "Staged as resolved, their markers gone: %s" 90 "$(_SOME_PATHS "${DONE[@]}")"
	return 0
}

# Confirms a drop or squash before anything is rewritten, on either squash route alike – `-y`
# answers it up front, and a run with no terminal has nobody to ask, so it proceeds
_CONFIRM_REWRITE () {
	_IS_NON_INTERACTIVE && return 0
	if [ ${#OPT_YES} -gt 0 ]; then
		ECHO_E "\e[0;90m(-y / --yes: auto-confirmed)\e[0m"
		return 0
	fi
	_DRAIN_KEYS
	PRINT_TEXT "Press %s to confirm, or cancel with %s." 35 "Enter" "Escape"
	while true; do
		_READ_KEY
		case $REPLY in
			enter) return 0 ;;
			escape|quit|interrupt|eof)
				PRINT_ERR "Cancelled – nothing was changed"
				exit 1 ;;
			*) PRINT_TEXT "Press %s to confirm, or cancel with %s." 90 "Enter" "Escape" ;;
		esac
	done
}

# Creates a detached worktree at <commit>, reclaiming a path a removed one left registered – this
# path alone, as a prune drops every vanished worktree's records, a parallel session's reflog with
# them – and keeping one a failing `post-checkout` hook failed the add of, complete as it is
_WORKTREE_ADD () {
	# Args: <dir> <commit> [quiet – git's own lines left out]
	local CMD="git worktree add --detach ${(q-)1} ${(q-)2}" OUT
	PRINT_CMD "$CMD"
	# C locale – the retry below matches git's English wording
	if OUT=$( export LC_ALL=C; eval "$CMD" 2>&1 ); then
		[ -n "$OUT" ] && [ -z "$3" ] && print -r -- "$OUT" | _CARET_LINES --crlf
		_MARK_WORKTREE_OWNER "$1"
		return 0
	fi
	if [[ "$OUT" == *"missing but already registered"* ]]; then
		ECHO_E "\e[0;90m(stale worktree registration – reclaiming its path and retrying)\e[0m"
		CMD="git worktree add -f --detach ${(q-)1} ${(q-)2}"
		PRINT_CMD "$CMD"
		if OUT=$( export LC_ALL=C; eval "$CMD" 2>&1 ); then
			[ -n "$OUT" ] && [ -z "$3" ] && print -r -- "$OUT" | _CARET_LINES --crlf
			_MARK_WORKTREE_OWNER "$1"
			return 0
		fi
	fi
	if [ "$(git -C "$1" rev-parse HEAD 2>/dev/null)" = "$(git rev-parse "$2^{commit}" 2>/dev/null)" ] && \
	   _RENORM_SETTLE "$1" && [ -z "$(git -C "$1" status --porcelain --untracked-files=no 2>/dev/null)" ]; then
		PRINT_TEXT "The post-checkout hook failed in the new worktree – carrying on, as the run needs only the commit: %s" 33 "${OUT##*$'\n'}"
		_MARK_WORKTREE_OWNER "$1"
		return 0
	fi
	print -r -- "$OUT" >&2
	PRINT_ERR "Could not create the worktree at $1"
	return 1
}

# Holds the `-C` worktree for the whole run, or a pause's for its resume or abort – the default path
# is every session's, and a second run there would abort this one's rebase and reset its tree under
# its gate – a holder gone gave it up
_HOLD_RUN_WORKTREE () {
	# Args: [<worktree, `WORKTREE_DIR` by default> <"applied" or "cancelled" – a resume or abort of
	# the pause there, which a live holder is already resuming or cancelling>]
	local DIR=${1:-$WORKTREE_DIR} GD HOLDER
	local -i N=0
	GD=$(git -C "$DIR" rev-parse --absolute-git-dir 2>/dev/null) || return 0
	local LOCK="$GD/git-edit-run.lock"
	_LOCK_MARK_SET
	# Let go of however the run ends – named before the create, so a signal right after it finds it,
	# as the release takes only a lock naming this run
	_RUN_LOCK_HELD=$LOCK
	until ( setopt noclobber; print -r -- "$_LOCK_MARK" > "$LOCK" ) 2>/dev/null; do
		HOLDER=""
		{ HOLDER=$(<"$LOCK") } 2>/dev/null
		# One naming this very process is its own, from before the exec a terminal's resume runs in
		[ "$HOLDER" = "$_LOCK_MARK" ] && return 0
		HOLDER=${HOLDER%% *}
		_LOCK_BREAK "$LOCK"
		case $? in
			# Broken or gone, taken again at once – where another run is breaking it, or died doing so, its
			# second name waited out, as the journal's lock waits it out, until it goes once 10 s old
			0)
				if (( ++N < 150 )); then
					[ -e "$LOCK.break" ] && sleep 0.1
					continue
				fi ;;
			2)
				PRINT_ERR "${${2:+The pause's worktree}:--C/--dir} lock $LOCK names a holder${HOLDER:+ (pid $HOLDER)} that is gone, but it could not be linked to break it – ${${2:+nothing was $2}:-nothing ran}"
				ECHO_E "\e[0;31m  Deleting that file is safe once no run is live in '$DIR': $(_LIT "rm -f -- $(_SHQ "$LOCK")"), then run this again.\e[0m" >&2
				exit 1 ;;
		esac
		# A holder gone that the wait never got past is no live run
		if [ -e "$LOCK" ] && _LOCK_STALE "$LOCK"; then
			PRINT_ERR "${${2:+The pause's worktree}:--C/--dir} lock $LOCK names a holder${HOLDER:+ (pid $HOLDER)} that is gone, but a break of it never finished – ${${2:+nothing was $2}:-nothing ran}"
			ECHO_E "\e[0;31m  Deleting both is safe once no run is live in '$DIR': $(_LIT "rm -f -- $(_SHQ "$LOCK") $(_SHQ "$LOCK.break")"), then run this again.\e[0m" >&2
			exit 1
		fi
		# A holder this run runs under – a resume whose landing's hook runs it – lets go only once this
		# one ends, so no wait gets past it, named as the journal's lock names one
		local UP=$PPID UNDER=""
		local -i K=0
		while [ -n "$HOLDER" ] && [[ "$UP" == <2-> ]] && (( ++K < 64 )); do
			[ "$UP" = "$HOLDER" ] && { UNDER=1; break; }
			_PID_PARENT "$UP"
			UP=$REPLY
		done
		if [ -n "$UNDER" ]; then
			PRINT_ERR "${${2:+The pause's worktree}:--C/--dir path} '$DIR' is held by the run this one runs under (pid $HOLDER) – a hook its landing ran, say – which holds it until this one ends – ${${2:+nothing was $2}:-nothing ran}"
			ECHO_E "\e[0;31m  Run it once that run has finished, never from inside its hooks.\e[0m" >&2
		elif [ -n "$2" ]; then
			PRINT_ERR "The pause's worktree '$DIR' is in use by a run in flight${HOLDER:+ (pid $HOLDER)}, resuming or cancelling it – nothing was $2"
			ECHO_E "\e[0;31m  Wait for that run to finish, then 'git edit --status' names what is paused, if anything.\e[0m" >&2
		else
			PRINT_ERR "-C/--dir path '$DIR' is in use by another run${HOLDER:+ (pid $HOLDER)} – wait for it, or name another path"
		fi
		exit 1
	done
}

# Holds a pause's worktree, a `-C` path or a temporary one, for the run resuming or cancelling it,
# as a run working in one does – a second resume, an abort or a new run there refusing while this
# one lives, rather than reset, rebase or remove it – a temporary worktree's lock removed with it
_HOLD_PAUSE_WORKTREE () {
	# Args: <"applied" or "cancelled" – what a refusal says was not>
	[ -d "$STATE_WORKTREE" ] || return 0
	[ "$(git -C "$STATE_WORKTREE" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" = "$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" ] || return 0
	_HOLD_RUN_WORKTREE "$STATE_WORKTREE" "$1"
}

# Tells whether the pause's worktree is there for an abort to take down – still a checkout of this
# repository, as anything else at its path, another repository's checkout say, is left and named
_PAUSE_WT_HERE () {
	# Args: [quiet – naming nothing]
	[ -n "$STATE_WORKTREE" ] && [ -d "$STATE_WORKTREE" ] || return 1
	[ "$(git -C "$STATE_WORKTREE" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" = "$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" ] && return 0
	[ -n "$1" ] || PRINT_TEXT "%s is no longer a checkout of this repository – left as it is." 33 "$STATE_WORKTREE"
	return 1
}

# Lets go of the worktree lock where it is still this run's – a run that broke it as stale holds it
# now, which this run removing it would hand to a third
_RUN_WORKTREE_UNLOCK () {
	[ -n "$_LOCK_MARK" ] && { [ "$(<"$_RUN_LOCK_HELD")" = "$_LOCK_MARK" ]; } 2>/dev/null && rm -f "$_RUN_LOCK_HELD"
	_RUN_LOCK_HELD=""
}

# Refuses a `-C` path the pause slot names, asked again once the run holds it – a pause recorded
# there since the run's first look holds no lock once its run exited, nor while its prompt waits,
# and the reset below would take what was done there, its commits too
_REQUIRE_PATH_UNPAUSED () {
	# Args: <the path's git dir>
	local SF WT
	[ -n "$1" ] && SF=$(_STATE_FILE_PATH) && [ -f "$SF" ] || return 0
	WT=$(LC_ALL=C sed -n 's/^worktree=//p' "$SF" 2>/dev/null | tail -1)
	[ -n "$WT" ] && [ "$(git -C "$WT" rev-parse --absolute-git-dir 2>/dev/null)" = "$1" ] || return 0
	_PAUSE_OWNER "$SF"
	PRINT_ERR "Another git-edit operation is in flight in -C/--dir path '$WORKTREE_DIR', paused there as this run started${REPLY:+ – $REPLY} – nothing ran"
	_ECHO_INFLIGHT_STEP "$SF" "or name another path"
	exit 1
}

# Removes the new `-C` <worktree> a run made at <commit> and refused before working in – kept where
# a pause there differs from what was made, a peer's that took the path while this run waited
_REMOVE_FRESH_WORKTREE () {
	# Args: <worktree> <commit>
	local GD SF WT
	GD=$(git -C "$1" rev-parse --absolute-git-dir 2>/dev/null) || return 0
	if SF=$(_STATE_FILE_PATH) && [ -f "$SF" ]; then
		WT=$(LC_ALL=C sed -n 's/^worktree=//p' "$SF" 2>/dev/null | tail -1)
		if [ -n "$WT" ] && [ "$(git -C "$WT" rev-parse --absolute-git-dir 2>/dev/null)" = "$GD" ]; then
			[ "$(git -C "$1" rev-parse HEAD 2>/dev/null)" = "$(git rev-parse -q --verify "$2^{commit}" 2>/dev/null)" ] && \
				[ ! -e "$GD/rebase-merge" ] && [ ! -e "$GD/rebase-apply" ] && \
				[ -z "$(git -C "$1" status --porcelain --ignore-submodules=none 2>/dev/null)" ] || return 0
		fi
	fi
	git worktree remove --force "$1" 2>/dev/null
	rm -rf "$1"
}

# Sets up the worktree a drop, edit or squash runs in, at <commit> – the `-C` path, checked and
# reused, else a temp one that goes with the run unless a pause keeps it – into `WORKTREE_DIR`,
# with `WT_OURS` set for the temp one
_PREPARE_RUN_WORKTREE () {
	# Args: <commit> <temp dir prefix>
	local AT=$1 TOP THEIRS ABS STRAY GD
	TOP=$(git rev-parse --show-toplevel 2>/dev/null)
	if [ ${#OPT_DIR} -eq 0 ]; then
		# Asked again past the prompt – a landing strands a pause recorded since the first look
		_REQUIRE_NO_INFLIGHT
		WORKTREE_DIR=$(MKTEMP_DIR "$2") || exit 1
		rmdir "$WORKTREE_DIR"  # `git worktree add` wants to create the dir itself
		WT_OURS=1
		_CLEANUP_HOOK="git worktree remove --force ${(q-)WORKTREE_DIR} 2>/dev/null; rm -rf ${(q-)WORKTREE_DIR}"
		_WORKTREE_ADD "$WORKTREE_DIR" "$AT" || exit 1
		_LINK_WORKTREE_EXTRAS "$WORKTREE_DIR"
		return 0
	fi
	WT_OURS=0
	# Default path: <repo-root>.git-edit, a sibling of the checkout
	if [ -z "$WORKTREE_DIR" ]; then
		WORKTREE_DIR="${TOP}.git-edit"
		WT_DEFAULT=1
	fi
	if [ ! -d "$WORKTREE_DIR" ]; then
		# Nor a new one inside a working tree of this repository, unless git ignores it there – its `.git`
		# file makes it an embedded repository there, which the next `git add -A` stages as a gitlink
		local UP=$WORKTREE_DIR HOST
		while [ ! -d "$UP" ] && [ "$UP" != / ]; do UP=${UP:h}; done
		HOST=$(git -C "$UP" rev-parse --show-toplevel 2>/dev/null)
		if [ -n "$HOST" ] && [ "${$(git -C "$UP" rev-parse --path-format=absolute --git-common-dir 2>/dev/null):A}" = "${$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null):A}" ] \
			&& ! git -C "$UP" check-ignore -q -- "${WORKTREE_DIR#"$UP"/}/" 2>/dev/null; then
			PRINT_ERR "-C/--dir path '$WORKTREE_DIR' is new and inside the working tree $HOST – a worktree made there is an embedded repository its next 'git add -A' stages"
			ECHO_E "\e[0;31m  Name a path outside it, one its .gitignore covers, or none for a temp one.\e[0m" >&2
			exit 1
		fi
		_WORKTREE_ADD "$WORKTREE_DIR" "$AT" || exit 1
		# Made by this run with nothing authored there yet, so a refusal below takes it back out
		local HOOK_BEFORE=$_CLEANUP_HOOK
		_CLEANUP_HOOK="_REMOVE_FRESH_WORKTREE ${(q-)WORKTREE_DIR} ${(q-)AT}"
		_HOLD_RUN_WORKTREE
		_REQUIRE_PATH_UNPAUSED "$(git -C "$WORKTREE_DIR" rev-parse --absolute-git-dir 2>/dev/null)"
		_REQUIRE_NO_INFLIGHT
		_CLEANUP_HOOK=$HOOK_BEFORE
		_LINK_WORKTREE_EXTRAS "$WORKTREE_DIR"
		return 0
	fi
	THEIRS=$(git -C "$WORKTREE_DIR" rev-parse --show-toplevel 2>/dev/null)
	if [ -z "$THEIRS" ]; then
		PRINT_ERR "Path '$WORKTREE_DIR' exists but is not a git working tree – nothing ran"
		ECHO_E "\e[0;31m  Name a path that does not exist yet, which git-edit makes the worktree at, or a worktree of this repository – or none for a temp one.\e[0m" >&2
		exit 1
	fi
	THEIRS=$(cd "$THEIRS" && pwd -P)
	ABS=$(cd "$WORKTREE_DIR" && pwd -P)
	# The root of a worktree of this repository, not a directory inside one, nor the checkout itself
	if [ "$THEIRS" != "$ABS" ]; then
		PRINT_ERR "Path '$WORKTREE_DIR' is inside a working tree but is not its root"
		exit 1
	fi
	if [ "$THEIRS" = "$(cd "$TOP" && pwd -P)" ]; then
		PRINT_ERR "-C/--dir cannot point to the current working tree"
		exit 1
	fi
	# Another repository's would take the whole run there – its branch rewritten, its journal written
	local CD_THEIRS=$(git -C "$WORKTREE_DIR" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
	local CD_OURS=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
	if [ -z "$CD_THEIRS" ] || [ "${CD_THEIRS:A}" != "${CD_OURS:A}" ]; then
		PRINT_ERR "-C/--dir path '$WORKTREE_DIR' is a working tree of another repository – name a scratch path, or none for a temp one"
		exit 1
	fi
	_HOLD_RUN_WORKTREE
	GD=$(git -C "$WORKTREE_DIR" rev-parse --absolute-git-dir 2>/dev/null)
	_REQUIRE_PATH_UNPAUSED "$GD"
	# And any pause on the repository recorded while the run took the path, which its landing strands
	_REQUIRE_NO_INFLIGHT
	# A rebase, merge or pick in progress in a named path is someone's work – in the default one,
	# which only this tool uses, a killed run's, cleared below
	local OPG=""
	if [ -z "$WT_DEFAULT" ]; then
		if [ -e "$GD/rebase-merge" ]; then OPG=rebase-merge
		elif [ -e "$GD/rebase-apply" ]; then OPG=rebase-apply
		elif _PICK_IN_PROGRESS "$WORKTREE_DIR" "$GD"; then OPG=$REPLY
		fi
		if [ -n "$OPG" ]; then
			PRINT_ERR "-C/--dir path '$WORKTREE_DIR' has $OPG in progress – finish it there, or name a scratch path"
			exit 1
		fi
	fi
	# Nor one holding a branch or work – the reset below would move that branch and wipe the work
	if git -C "$WORKTREE_DIR" symbolic-ref -q HEAD >/dev/null 2>&1; then
		PRINT_ERR "-C/--dir path '$WORKTREE_DIR' has $(git -C "$WORKTREE_DIR" symbolic-ref --short -q HEAD) checked out – name a scratch path, or detach it there first"
		exit 1
	fi
	# A file read as modified only through its attributes is no change of anyone's
	_RENORM_SETTLE "$WORKTREE_DIR"
	if [ -n "$(git -C "$WORKTREE_DIR" status --porcelain --untracked-files=no 2>/dev/null)" ]; then
		PRINT_ERR "-C/--dir path '$WORKTREE_DIR' holds uncommitted changes – name a scratch path instead"
		exit 1
	fi
	# Untracked files would feed the gate's run yet never land – an earlier check's own output in the
	# default path, which this tool manages, so removed there and refused in a named one
	if _VERIFY_CONFIGURED; then
		STRAY=$(git -C "$WORKTREE_DIR" -c core.quotePath=false ls-files -o --exclude-standard --directory --no-empty-directory 2>/dev/null)
		if [ -n "$STRAY" ] && [ -n "$WT_DEFAULT" ]; then
			git -C "$WORKTREE_DIR" clean -fdq 2>/dev/null
			PRINT_TEXT "Removed what an earlier run left untracked in %s: %s" 90 "$WORKTREE_DIR" "$(_JOIN_PATHS "$STRAY")"
		elif [ -n "$STRAY" ]; then
			PRINT_ERR "-C/--dir path '$WORKTREE_DIR' holds untracked files the verify check would run over – name a scratch path instead"
			exit 1
		fi
	fi
	# A previous killed run's rebase, cleared – removed outright where `rebase --abort` chokes on it
	git -C "$WORKTREE_DIR" rebase --abort 2>/dev/null
	[ -n "$GD" ] && rm -rf "$GD/rebase-merge" "$GD/rebase-apply"
	local CMD="git -C ${(q-)WORKTREE_DIR} reset --hard ${(q-)AT}"
	PRINT_CMD "$CMD"
	eval "$CMD" >/dev/null || { PRINT_ERR "Could not reset $WORKTREE_DIR to ${AT:0:7}"; exit 1; }
	_LINK_WORKTREE_EXTRAS "$WORKTREE_DIR"
}

# Decides what a run naming commits does – `ACTION` on `COMMITS`, oldest first, with `COMMIT` and
# `TARGET` – each commit taken at its current identity, and refuses what the commits and flags
# cannot carry, deciding again after waiting out a pause, on the SHAs pinned before it
_RESOLVE_ACTION () {
	# Args: <`-s` target, or empty> <commit>...
	TARGET=$1
	shift
	COMMITS=("$@")
	# Validate before sorting, while the SHAs are still as the caller gave them – the sort's
	# fallback below drops anything git cannot resolve, and each commit comes back as its
	# current identity, so a SHA staled by an earlier rewrite is carried forward
	COMMITS_RESOLVED=()
	for COMMIT in "${COMMITS[@]}"; do
		_GUARD_REACHABLE "$COMMIT"
		COMMITS_RESOLVED+=("$_RESOLVED_SHA")
	done
	COMMITS=("${COMMITS_RESOLVED[@]}")
	# A commit named twice – outright, inside a range, or stale beside its live SHA – counts once, as
	# the sort below matches each only once and falls back to timestamps on a count it can't meet
	if (( ${#${(u)COMMITS[@]}} < ${#COMMITS} )); then
		if [ ${#OPT_REORDER} -gt 0 ]; then
			PRINT_ERR "--reorder names a commit more than once – give each once, in the new order"
			exit 1
		fi
		COMMITS=("${(u)COMMITS[@]}")
	fi
	# `--reorder`'s payload is the positional order – taken resolved, ahead of the sort below
	if [ ${#OPT_REORDER} -gt 0 ]; then
		COMMITS_DESIRED=("${COMMITS[@]}")
	fi

	# Sort selected commits topologically, oldest first – `rev-list --no-walk` only sorts by
	# timestamp, which ties and comes back input-reversed on rapid-fire same-second commits,
	# silently inverting the selection, so derive the order from `HEAD`'s own history
	COMMITS_TOPO=($(git rev-list --reverse HEAD 2>/dev/null | grep -Fx -f <(printf '%s\n' "${COMMITS[@]}") 2>/dev/null))
	if [ ${#COMMITS_TOPO[@]} -eq ${#COMMITS[@]} ]; then
		COMMITS=("${COMMITS_TOPO[@]}")
	else
		COMMITS=($(git rev-list --no-walk --reverse "${COMMITS[@]}"))
	fi

	# Determine Action
	if [ ${#OPT_REORDER} -gt 0 ]; then
		# Reorder (`--reorder`) – contiguous span, args give the new order
		ACTION="reorder"
		COMMIT=${COMMITS[-1]}

	elif [ ${#OPT_REWORD} -gt 0 ]; then
		# Reword (`-M` / `--reword`) – message-only edit via plumbing, no working-tree touch
		ACTION="reword"
		if [ ${#COMMITS[@]} -gt 1 ]; then
			PRINT_ERR "-M/--reword takes exactly one <commit>"
			exit 1
		fi
		COMMIT=${COMMITS[1]}

	elif [ ${#OPT_RESQUASH} -gt 0 ]; then
		# Resquash (`-S` / `--resquash`) – plumbing-only contiguous squash, no working-tree touch
		ACTION="resquash"
		# Single commit: squash into its parent (mirrors -s semantics)
		if [ ${#COMMITS[@]} -eq 1 ]; then
			if git cat-file -e "${COMMITS[1]}^" 2>/dev/null; then
				local PARENT=$(git rev-parse "${COMMITS[1]}^")
				COMMITS=($PARENT ${COMMITS[1]})
			else
				PRINT_ERR "Cannot squash <commit> as it has no parent"
				exit 1
			fi
		fi
		COMMIT=${COMMITS[-1]}

	elif [ ${#OPT_DROP} -gt 0 ]; then
		# Drop/Delete (`-d` / `--drop`)
		ACTION="drop"
		COMMIT=${COMMITS[1]}

	elif [ ${#OPT_SQUASH} -gt 0 ]; then
		# Explicit Squash (-s)
		ACTION="squash"

		# `TARGET` is the value the pre-processing block extracted, pinned – set if the user
		# used `-s=<target>`, or if `-sX`/`-s X` was used and the value wasn't
		# re-injected by the heuristic (i.e., it's not a recognizable ref/range)

		# If an explicit target was found, verify it and add to `COMMITS` array
		if [ -n "$TARGET" ]; then
			# Resolved as every other commit is – a stale or foreign one gave its squashed commits'
			# fixups no `pick` to follow, which dropped them
			if ! _PEEL_SHA "$TARGET" commit >/dev/null; then
				PRINT_ERR "Unknown <target>: $TARGET"
				exit 1
			fi
			_GUARD_REACHABLE "$TARGET"
			TARGET=$_RESOLVED_SHA
			# Add explicit target to list, re-sorted from `HEAD`'s own history –
			# `--no-walk --reverse` timestamp-sorts, which ties (and inverts the
			# input) on same-second commits, scrambling the span – once, where it is among them already
			(( ${COMMITS[(Ie)$TARGET]} )) || COMMITS+=("$TARGET")
			COMMITS_TOPO=($(git rev-list --reverse HEAD 2>/dev/null | grep -Fx -f <(printf '%s\n' "${COMMITS[@]}") 2>/dev/null))
			if [ ${#COMMITS_TOPO[@]} -eq ${#COMMITS[@]} ]; then
				COMMITS=("${COMMITS_TOPO[@]}")
			else
				COMMITS=($(git rev-list --no-walk --reverse "${COMMITS[@]}"))
			fi
		fi

		# Default target to oldest if not set
		if [ -z "$TARGET" ]; then
			TARGET=${COMMITS[1]}

			# If squashing just 1 commit (e.g. `git edit -s HEAD`), target is parent
			if [ ${#COMMITS[@]} -eq 1 ]; then
				if git cat-file -e "${TARGET}^" 2>/dev/null; then
					local PARENT=$(git rev-parse "${TARGET}^")
					TARGET=$PARENT
					COMMITS=($TARGET ${COMMITS[1]})
				else
					PRINT_ERR "Cannot squash <commit> as it has no parent"
					exit 1
				fi
			fi
		fi
		# Use newest commit for logs if needed, but logic uses `COMMITS` array
		COMMIT=${COMMITS[-1]}

	elif [ ${#OPT_EDIT} -gt 0 ]; then
		# Edit (`-e` / `--edit`) – the default mode named outright, so a second <commit> is refused
		# rather than read as the implicit squash below
		ACTION="edit"
		if [ ${#COMMITS[@]} -gt 1 ]; then
			PRINT_ERR "-e/--edit takes exactly one <commit> – to squash them, pass -s"
			exit 1
		fi
		COMMIT=${COMMITS[1]}

	elif [ ${#COMMITS[@]} -gt 1 ]; then
		# Implicit Squash (no flags, but multiple commits provided)
		ACTION="squash"
		TARGET=${COMMITS[1]}
		COMMIT=${COMMITS[-1]}

	else
		# Edit (single commit, no flags)
		ACTION="edit"
		COMMIT=${COMMITS[1]}
	fi

	# Pushed guard for every mode, before any wait – the plumbing and isolated modes guard again
	# inside their own functions – the oldest selected commit already covering the whole span a
	# rewrite reaches, and a reorder keeping the order rewriting nothing
	if [[ "$ACTION" == (drop|squash|edit|reword|resquash) ]] || \
	   { [ "$ACTION" = reorder ] && [ "${(j: :)COMMITS}" != "${(j: :)COMMITS_DESIRED}" ]; }; then
		_GUARD_UNPUSHED "${COMMITS[1]}"
	fi

	# Auto-route a plain squash to the plumbing path where eligible – contiguous range, target
	# the oldest, no merge commits – for the same observable outcome with no working-tree
	# touch, while `-S` and `-C` are unaffected and the rest falls through to the rebase
	if [[ "$ACTION" == "squash" ]] && [ ${#OPT_DIR} -eq 0 ] && _RESQUASH_ELIGIBLE; then
		ACTION="resquash"
		# The refusal `-S` gets up front, once the route is known
		if [ ${#OPT_VERIFY} -gt 0 -o ${#OPT_VERIFY_SPAN} -gt 0 ]; then
			PRINT_ERR "--verify cannot gate this squash"
			ECHO_E "\e[0;31m  A contiguous squash into the oldest commit preserves every tree by construction.\e[0m" >&2
			exit 1
		fi
	fi

	# Merge-span guard for the modes still rebase-based after auto-routing – a
	# squash re-routed to plumbing rebuilds merges above it faithfully and needs
	# no refusal, so this must come after the route decision
	if [[ "$ACTION" == "drop" || "$ACTION" == "squash" || "$ACTION" == "edit" ]]; then
		_GUARD_NO_MERGE_SPAN "${COMMITS[1]}"
	fi

	# Final `--text` validation, only valid for message-producing modes – deferred until after
	# action determination so implicit squash and auto-routing are both accounted for
	if [ -n "$TEXT_VALUE" ] && [[ "$ACTION" != "reword" && "$ACTION" != "resquash" && "$ACTION" != "squash" ]]; then
		if [ "$ACTION" = edit ]; then
			PRINT_ERR "Pass --text with 'git edit --continue' – the message is applied at the amend"
		else
			PRINT_ERR "Option --text only applies to message-producing modes (-M, -s, -S, or implicit squash); got action: $ACTION"
		fi
		exit 1
	fi
	if [ -n "$SUBJECT_VALUE" ] && [ "$ACTION" != reword ]; then
		if [ "$ACTION" = edit ]; then
			PRINT_ERR "Pass --subject with 'git edit --continue' – the message is applied at the amend"
		else
			PRINT_ERR "--subject only applies to -M/--reword and an edit pause's --continue – a ${ACTION/resquash/squash} writes a new message, which takes it whole as --text \"…\""
		fi
		exit 1
	fi
	# `-m` opens an editor on the message at the amend, which a run with no terminal has none for
	if [ "$ACTION" = edit ] && [ ${#OPT_MESSAGE} -gt 0 ] && _IS_NON_INTERACTIVE; then
		PRINT_ERR "-m opens an editor on the message, which this run has no terminal for"
		ECHO_E "\e[0;31m  Leave out -m, then pass the message to the continue: git edit --continue --text \"…\"\e[0m" >&2
		exit 1
	fi
}

# Plans a `--move` – the moved commits in `MOVE_SET`, history order, and the reorder of `COMMITS`
# into `COMMITS_DESIRED` that places them at the anchor – or ends the run where they sit there
# already, planning again after waiting out a pause, on the SHAs pinned before it
_PLAN_MOVE () {
	# Args: <anchor> <`--move` value>...
	MOVE_ANCHOR=$1
	shift
	MOVE_ARGS=("$@")
	# Each value a commit or a run, read inclusive as every range here is – either way round, an
	# open end being `HEAD` – and each end resolved like any other target where a rewrite staled it
	MOVE_SET=()
	for MOVE_ARG in "${MOVE_ARGS[@]}"; do
		if [[ "$MOVE_ARG" == *".."* && "$MOVE_ARG" != *"..."* ]]; then
			MOVE_FROM="${${MOVE_ARG%%..*}:-HEAD}"
			MOVE_TO="${${MOVE_ARG#*..}:-HEAD}"
		else
			MOVE_FROM=$MOVE_ARG
			MOVE_TO=$MOVE_ARG
		fi
		for MOVE_END in "$MOVE_FROM" "$MOVE_TO"; do
			if ! _PEEL_SHA "$MOVE_END" commit >/dev/null; then
				PRINT_ERR "Unknown <sha>: $MOVE_END"
				exit 1
			fi
		done
		# One end a rewrite staled resolves as a single commit does – with both stale, the run is taken
		# as named and each commit in it resolved alone below, as a positional range is, since the span
		# between their current identities can hold a commit a peer moved in since
		MOVE_STALE=""
		if [ "$MOVE_TO" != "$MOVE_FROM" ] && ! git merge-base --is-ancestor "$MOVE_FROM" HEAD 2>/dev/null && \
		   ! git merge-base --is-ancestor "$MOVE_TO" HEAD 2>/dev/null; then
			MOVE_STALE=1
			MOVE_FROM=$(_PEEL_SHA "$MOVE_FROM" commit)
			MOVE_TO=$(_PEEL_SHA "$MOVE_TO" commit)
		else
			_GUARD_REACHABLE "$MOVE_FROM"
			MOVE_FROM_RESOLVED=$(git rev-parse "$_RESOLVED_SHA^{commit}")
			if [ "$MOVE_TO" = "$MOVE_FROM" ]; then
				MOVE_TO=$MOVE_FROM_RESOLVED
			else
				_GUARD_REACHABLE "$MOVE_TO"
				MOVE_TO=$(git rev-parse "$_RESOLVED_SHA^{commit}")
			fi
			MOVE_FROM=$MOVE_FROM_RESOLVED
		fi
		if [ "$MOVE_FROM" != "$MOVE_TO" ] && git merge-base --is-ancestor "$MOVE_TO" "$MOVE_FROM" 2>/dev/null; then
			MOVE_END=$MOVE_FROM
			MOVE_FROM=$MOVE_TO
			MOVE_TO=$MOVE_END
		fi
		if [ "$MOVE_FROM" = "$MOVE_TO" ]; then
			MOVE_PART=("$MOVE_FROM")
		elif ! git merge-base --is-ancestor "$MOVE_FROM" "$MOVE_TO" 2>/dev/null; then
			PRINT_ERR "Commits ${MOVE_FROM:0:7} and ${MOVE_TO:0:7} are not on one line of history"
			exit 1
		elif git rev-parse --verify -q "$MOVE_FROM^" >/dev/null 2>&1; then
			MOVE_PART=($(git rev-list --reverse "$MOVE_FROM^..$MOVE_TO"))
		else
			MOVE_PART=($(git rev-list --reverse "$MOVE_TO"))
		fi
		for MOVE_STEP in "${MOVE_PART[@]}"; do
			if [ -n "$MOVE_STALE" ]; then
				_GUARD_REACHABLE "$MOVE_STEP"
				MOVE_STEP=$_RESOLVED_SHA
			fi
			(( ${MOVE_SET[(Ie)$MOVE_STEP]} )) || MOVE_SET+=("$MOVE_STEP")
		done
	done
	_GUARD_REACHABLE "$MOVE_ANCHOR"
	MOVE_ANCHOR=$(git rev-parse "$_RESOLVED_SHA^{commit}")
	# In history order, whatever order they were named in
	MOVE_SORTED=($(git rev-list --reverse HEAD 2>/dev/null | grep -Fx -f <(printf '%s\n' "${MOVE_SET[@]}") 2>/dev/null))
	if [ ${#MOVE_SORTED[@]} -ne ${#MOVE_SET[@]} ]; then
		PRINT_ERR "--move names a commit HEAD does not reach"
		exit 1
	fi
	MOVE_SET=("${MOVE_SORTED[@]}")
	MOVE_FIRST=${MOVE_SET[1]}
	MOVE_LAST=${MOVE_SET[-1]}
	if (( ${MOVE_SET[(Ie)$MOVE_ANCHOR]} )); then
		if [ ${#MOVE_SET[@]} -eq 1 ]; then
			PRINT_ERR "--move commit and its --$MOVE_KIND anchor are the same commit"
		elif [ ${#MOVE_ARGS[@]} -eq 1 ]; then
			PRINT_ERR "--$MOVE_KIND anchor ${MOVE_ANCHOR:0:7} lies inside the moved run ${MOVE_FIRST:0:7}..${MOVE_LAST:0:7}"
		else
			PRINT_ERR "--$MOVE_KIND anchor ${MOVE_ANCHOR:0:7} is one of the commits being moved"
		fi
		exit 1
	fi
	# Minimal span: the moved commits and the anchor inclusive, oldest-first – contiguous by
	# construction, so the reorder pre-flight checks pass or refuse cleanly (merge in span,
	# pushed base), the anchor below them, above them, or between them
	if git merge-base --is-ancestor "$MOVE_LAST" "$MOVE_ANCHOR" 2>/dev/null; then
		MOVE_SPAN_OLD=$MOVE_FIRST
		MOVE_SPAN_NEW=$MOVE_ANCHOR
	elif git merge-base --is-ancestor "$MOVE_ANCHOR" "$MOVE_FIRST" 2>/dev/null; then
		MOVE_SPAN_OLD=$MOVE_ANCHOR
		MOVE_SPAN_NEW=$MOVE_LAST
	elif git merge-base --is-ancestor "$MOVE_FIRST" "$MOVE_ANCHOR" 2>/dev/null && \
	     git merge-base --is-ancestor "$MOVE_ANCHOR" "$MOVE_LAST" 2>/dev/null; then
		MOVE_SPAN_OLD=$MOVE_FIRST
		MOVE_SPAN_NEW=$MOVE_LAST
	else
		PRINT_ERR "Commits ${MOVE_FIRST:0:7} and ${MOVE_ANCHOR:0:7} are not on one line of history"
		exit 1
	fi
	if git rev-parse --verify -q "$MOVE_SPAN_OLD^" >/dev/null 2>&1; then
		MOVE_SPAN=($(git rev-list --reverse "$MOVE_SPAN_OLD^..$MOVE_SPAN_NEW"))
	else
		MOVE_SPAN=($(git rev-list --reverse "$MOVE_SPAN_NEW"))
	fi
	# Desired order: the span minus the moved commits, which go back in
	# together, in their own order, at the anchor
	COMMITS_DESIRED=()
	for MOVE_STEP in "${MOVE_SPAN[@]}"; do
		if (( ${MOVE_SET[(Ie)$MOVE_STEP]} )); then
			continue
		fi
		if [ "$MOVE_STEP" = "$MOVE_ANCHOR" ] && [ "$MOVE_KIND" = "before" ]; then
			COMMITS_DESIRED+=("${MOVE_SET[@]}")
		fi
		COMMITS_DESIRED+=("$MOVE_STEP")
		if [ "$MOVE_STEP" = "$MOVE_ANCHOR" ] && [ "$MOVE_KIND" = "after" ]; then
			COMMITS_DESIRED+=("${MOVE_SET[@]}")
		fi
	done
	# A commit the span does not hold – on a merge's side leg, say – would come back short or
	# doubled, so it refuses here rather than reorder something else
	if [ ${#COMMITS_DESIRED[@]} -ne ${#MOVE_SPAN[@]} ]; then
		PRINT_ERR "--move cannot place its commits as one block – not all of them lie on the line ${MOVE_SPAN_OLD:0:7}..${MOVE_SPAN_NEW:0:7}"
		exit 1
	fi
	# Named as a run where they are one, each by itself where something lies between them
	MOVE_RUN=$(( ${MOVE_SPAN[(Ie)$MOVE_LAST]} - ${MOVE_SPAN[(Ie)$MOVE_FIRST]} + 1 == ${#MOVE_SET[@]} ))
	# Already in position – an honest no-op instead of an empty rebase
	if [ "${(j: :)COMMITS_DESIRED}" = "${(j: :)MOVE_SPAN}" ]; then
		if [ ${#MOVE_SET[@]} -eq 1 ]; then
			PRINT_TEXT "Commit %s already sits directly $MOVE_KIND %s – nothing to move" 36 "${MOVE_FIRST:0:7}" "${MOVE_ANCHOR:0:7}"
		else
			PRINT_TEXT "Commits %s..%s already sit directly $MOVE_KIND %s – nothing to move" 36 "${MOVE_FIRST:0:7}" "${MOVE_LAST:0:7}" "${MOVE_ANCHOR:0:7}"
		fi
		PRINT_COMPLETED "$(git rev-parse HEAD)" "$(_CURRENT_REF)" false
		exit 0
	fi
	# Commits at the old end of the span that keep their place are never rebuilt, so they leave
	# the span, whose oldest commit the pushed guard reads – kept in, they would refuse a move to
	# just above the last pushed commit as rewriting the anchor it lands after
	while [ ${#MOVE_SPAN[@]} -gt 0 ] && [ "${MOVE_SPAN[1]}" = "${COMMITS_DESIRED[1]}" ]; do
		MOVE_SPAN=("${(@)MOVE_SPAN[2,-1]}")
		COMMITS_DESIRED=("${(@)COMMITS_DESIRED[2,-1]}")
	done
	COMMITS=("${MOVE_SPAN[@]}")
	# Before any wait, as the reorder guards it again
	_GUARD_UNPUSHED "${COMMITS[1]}"
}

# Names each record's commit by the SHA its header resolves to now, as a run naming commits pins
# them before a wait – the records read as the batch reads them, so whatever they earn refuses
# here, before any wait
_PIN_RECORDS () {
	local -a TEXT=("${(@f)RAW_TEXT_VALUE}") TARGETS REC_SHAS
	local -A MSG_MAP
	local I K=0
	_READ_RECORDS "$(git rev-parse HEAD)"
	for (( I = 1; I <= ${#TEXT}; I++ )); do
		[[ "${TEXT[I]}" == '--- '* ]] || continue
		TEXT[I]="--- ${REC_SHAS[++K]}"
	done
	RAW_TEXT_VALUE=${(F)TEXT}
}

# Picks the scenarios `--selftest=<pick>` names from the suite dir, a file `<id>-<name>.zsh` each,
# for runs during development – the full suite stays the gate
# Scenarios share one scratch repo, so one starting from an earlier one's state says so with
# `# needs <ids>` on its `_ST_SCENARIO` line, and those come along
_SELFTEST_PICK () {
	# Args: <suite dir> <pick> – sets `SELFTEST_FILES` to the files picked, in suite order, and
	# `SELFTEST_SCOPE` to what they hold, or refuses
	setopt local_options extended_glob
	local -a IDS RUNS CONTENT BANNER
	local -A AT NEEDS WANT FILE_OF KEY_OF SIZE_OF
	local I F ID ITEM FROM TO N KEY RUN_FROM="" RUN_TO=""
	# Every other file there is a scenario, so a misnamed one refuses rather than drop out unrun
	for F in "$1"/*.zsh(N); do
		[ "${F:t}" = lib.zsh ] && continue
		if ! [[ "${F:t}" =~ '^0*([0-9]+)([a-z]?)-[a-z0-9-]+\.zsh$' ]]; then
			PRINT_ERR "Selftest scenario file ${F:t} is not named <id>-<name>.zsh"
			return 1
		fi
		ID=${match[1]}${match[2]}
		if (( ${+FILE_OF[$ID]} )); then
			PRINT_ERR "Selftest scenario $ID is declared twice"
			return 1
		fi
		FILE_OF[$ID]=$F
		# Number and letter apart, as a collation that skips the `-` sorts `60b-` before `60-`
		KEY_OF[$(printf '%06d%s' "${match[1]}" "${match[2]}")]=$ID
		# Its one banner names the id its file does, `# needs` riding on the same line
		CONTENT=("${(@f)$(<"$F")}")
		SIZE_OF[$ID]=${#CONTENT}
		BANNER=(${(M)CONTENT:#_ST_SCENARIO \"*})
		if [ ${#BANNER} -ne 1 ] || ! [[ "${BANNER[1]}" =~ '^_ST_SCENARIO "\\e\[1;96m\[([0-9]+[a-z]?)\]' ]] || [ "${match[1]}" != "$ID" ]; then
			PRINT_ERR "Selftest scenario file ${F:t} must open one _ST_SCENARIO line for [$ID]"
			return 1
		fi
		[[ "${BANNER[1]}" =~ '# needs ([0-9a-z, ]+)$' ]] && NEEDS[$ID]=${(j:,:)${(s:,:)${match[1]// /}}##0##}
	done
	for KEY in ${(o)${(k)KEY_OF}}; do
		IDS+=("${KEY_OF[$KEY]}")
		AT[${KEY_OF[$KEY]}]=${#IDS}
	done
	if [ ${#IDS} -eq 0 ]; then
		PRINT_ERR "The selftest suite has no scenarios in $1"
		return 1
	fi
	# Needs point back, since files run in suite order – checked on every run, so a wrong one
	# refuses the next run instead of waiting for the scenario that carries it
	for ID in "${IDS[@]}"; do
		for N in ${(s:,:)NEEDS[$ID]}; do
			if (( ! ${+AT[$N]} )) || (( ${AT[$N]} >= ${AT[$ID]} )); then
				PRINT_ERR "Selftest scenario $ID needs $N, which is no scenario before it"
				return 1
			fi
		done
	done
	# An open end runs to the suite's own, as a commit range's empty side means `HEAD`
	for ITEM in ${(s:,:)2}; do
		FROM=${ITEM%%-*}
		TO=${ITEM#*-}
		[ -z "$FROM" ] && FROM=${IDS[1]}
		[ -z "$TO" ] && TO=${IDS[-1]}
		# Ids as their files spell them, zeros and all
		[[ "$FROM" =~ '^0+([0-9]+[a-z]?)$' ]] && FROM=${match[1]}
		[[ "$TO" =~ '^0+([0-9]+[a-z]?)$' ]] && TO=${match[1]}
		for N in "$FROM" "$TO"; do
			if (( ! ${+AT[$N]} )); then
				PRINT_ERR "--selftest names scenario '$N', which the suite does not have"
				return 1
			fi
		done
		if (( ${AT[$FROM]} > ${AT[$TO]} )); then
			PRINT_ERR "--selftest=$ITEM runs backwards – name the earlier scenario first"
			return 1
		fi
		for ID in "${IDS[@]}"; do
			(( ${AT[$ID]} >= ${AT[$FROM]} && ${AT[$ID]} <= ${AT[$TO]} )) && WANT[$ID]=1
		done
	done
	if [ ${#WANT} -eq 0 ]; then
		PRINT_ERR "--selftest= names no scenario – leave the value off for the full suite"
		return 1
	fi
	# One pass from the end closes over needs of needs, each pointing further back
	for (( I = ${#IDS}; I >= 1; I-- )); do
		(( ${+WANT[${IDS[I]}]} )) || continue
		for N in ${(s:,:)NEEDS[${IDS[I]}]}; do
			WANT[$N]=1
		done
	done
	# What `--jobs` splits the pick by – its scenarios in suite order, what each needs, its length
	typeset -ga SELFTEST_FILES SELFTEST_IDS
	typeset -gA SELFTEST_NEEDS SELFTEST_SIZE
	SELFTEST_FILES=() SELFTEST_IDS=() SELFTEST_NEEDS=() SELFTEST_SIZE=()
	for (( I = 1; I <= ${#IDS}; I++ )); do
		ID=${IDS[I]}
		if (( ${+WANT[$ID]} )); then
			SELFTEST_FILES+=("${FILE_OF[$ID]}")
			SELFTEST_IDS+=("$ID")
			SELFTEST_NEEDS[$ID]=${NEEDS[$ID]}
			SELFTEST_SIZE[$ID]=${SIZE_OF[$ID]}
			[ -z "$RUN_FROM" ] && RUN_FROM=$ID
			RUN_TO=$ID
		fi
		# A run of kept scenarios closes at the first one left out, or at the end
		if [ -n "$RUN_FROM" ] && { (( ! ${+WANT[$ID]} )) || (( I == ${#IDS} )) }; then
			RUNS+=("$RUN_FROM${${RUN_TO:#$RUN_FROM}:+-$RUN_TO}")
			RUN_FROM=""
		fi
	done
	SELFTEST_SCOPE="scenario${${${#WANT}:#1}:+s} ${(j:, :)RUNS} (${#WANT} of ${#IDS})"
}

# Runs a pick of the suite – all of it by default – <jobs> processes at once, each one a
# `--selftest=<ids>` of a scenario with the ones it needs, in a temp dir of its own, the longest
# first, then prints their output in suite order under one count and trailer, as a serial run would
_SELFTEST_JOBS () {
	# Args: <script> <suite dir> <the `--selftest` option as given> <jobs>
	local SELF=$1 DIR=$2 PICK=${${3#--selftest}#=} ID N A B R LINE JT
	local -i JOBS=$4 RUNNING=0 NEXT=1 DONE=0 TOTAL=0 FAILED=0 P T
	local -a ORDER QUEUE
	local -A ROOT MEMBERS WEIGHT PID_OF
	# A bare `--selftest` is the whole suite, an empty pick refused as a run alone refuses it
	[ "$3" = --selftest ] && PICK=-
	_SELFTEST_PICK "$DIR" "$PICK" || return 1
	# The whole suite says nothing of what ran, as a serial run of it doesn't
	[ "$3" = --selftest ] && SELFTEST_SCOPE=""
	# One unit per set of scenarios the needs tie together, so each runs once and its needs with it
	for ID in "${SELFTEST_IDS[@]}"; do ROOT[$ID]=$ID; done
	for ID in "${SELFTEST_IDS[@]}"; do
		for N in ${(s:,:)SELFTEST_NEEDS[$ID]}; do
			A=$ID; while [ "${ROOT[$A]}" != "$A" ]; do A=${ROOT[$A]}; done
			B=$N; while [ "${ROOT[$B]}" != "$B" ]; do B=${ROOT[$B]}; done
			[ "$A" != "$B" ] && ROOT[$A]=$B
		done
	done
	for ID in "${SELFTEST_IDS[@]}"; do
		R=$ID; while [ "${ROOT[$R]}" != "$R" ]; do R=${ROOT[$R]}; done
		(( ${+MEMBERS[$R]} )) || ORDER+=("$R")
		MEMBERS[$R]+="${MEMBERS[$R]:+,}$ID"
		WEIGHT[$R]=$(( ${WEIGHT[$R]:-0} + ${SELFTEST_SIZE[$ID]} ))
	done
	# The longest first, so the slowest never starts last – its line count standing in for its time
	QUEUE=(${(f)"$(for R in "${ORDER[@]}"; do print -r -- "${WEIGHT[$R]} $R"; done | sort -rn | awk '{print $2}')"})
	JT=$(MKTEMP_DIR git-edit-jobs) || return 1
	PRINT_TEXT "Running %s in %s units, %s at a time" 33 "${SELFTEST_SCOPE:-the suite}" "${#QUEUE}" "$JOBS"
	# An interrupt takes the running units along, and their temp dirs – each by the pid its subshell
	# noted or as that subshell's child, since a kill of the subshell alone leaves it running
	# Exiting as any run stopped by a signal does, 128 plus its number and named in the trailer
	local SIG
	for SIG in INT TERM HUP; do
		trap "for R in \${(k)PID_OF}; do [ -s \"\$JT/\$R.pid\" ] && kill -TERM \"\$(<\"\$JT/\$R.pid\")\"; pkill -TERM -P \"\${PID_OF[\$R]}\"; kill -TERM \"\${PID_OF[\$R]}\"; done 2>/dev/null; rm -rf -- \"\$JT\"; _LAST_ERROR='stopped by SIG$SIG'; exit $(( 128 + ${signals[(Ie)$SIG]} - 1 ))" $SIG
	done
	while (( DONE < ${#QUEUE} )); do
		while (( RUNNING < JOBS && NEXT <= ${#QUEUE} )); do
			R=${QUEUE[NEXT]}
			# At the depth this run started at, as a pick alone runs – the suite keeps its temp files apart
			( GIT_EDIT_SELFTEST_DEPTH=${GIT_EDIT_SELFTEST_DEPTH:-0} \
				"$SELF" --selftest="${MEMBERS[$R]}" </dev/null >"$JT/$R.out" 2>&1 &
				print -r -- $! > "$JT/$R.pid"
				wait $!
				print -r -- $? > "$JT/$R.rc.part" && mv "$JT/$R.rc.part" "$JT/$R.rc" ) &
			# Quoted, as zsh stores a bare `$!` in an element as those two characters
			PID_OF[$R]="$!"
			RUNNING+=1 NEXT+=1
		done
		for R in ${(k)PID_OF}; do
			[ -f "$JT/$R.rc" ] || continue
			unset "PID_OF[$R]"
			RUNNING+=-1 DONE+=1
		done
		(( DONE < ${#QUEUE} )) && sleep 0.2
	done
	wait 2>/dev/null
	# The script's own handlers back, so a signal during the report still runs its exit
	_TRAP_TERMINATION
	local -a DIED
	local -A TEXT_OF
	for R in "${ORDER[@]}"; do
		# A unit's lines filed under the scenario header opening them, as one unit can hold two the
		# suite runs apart – its banner, summary and trailer dropped, a failed one's hint at a need kept
		ID=${MEMBERS[$R]%%,*}
		for LINE in "${(@f)$(LC_ALL=C sed -E '/^(git edit – |Selftest scratch repo: |Running scenario|Selftest: |git-edit: |$)/d' "$JT/$R.out")}"; do
			[ -n "$LINE" ] || continue
			[[ "$LINE" =~ '^\[([0-9]+[a-z]?)\] ' && ",${MEMBERS[$R]}," == *",${match[1]},"* ]] && ID=${match[1]}
			TEXT_OF[$ID]+=$LINE$'\n'
		done
		LINE=$(LC_ALL=C grep -a '^git-edit: ' "$JT/$R.out" | tail -1)
		if [[ "$LINE" =~ ' selftest ([0-9]+)/([0-9]+) (passed|failed)' ]]; then
			P=${match[1]} T=${match[2]}
			TOTAL+=$T
			[ "${match[3]}" = failed ] && FAILED+=$P
		else
			# No trailer is no verdict – the unit died, and counts as a failure
			FAILED+=1 TOTAL+=1
			DIED+=("$R")
		fi
	done
	# A unit writes to a file, so a terminal gets its colors back here
	local -a TINT=(-e '')
	[ "$_COLOR" = true ] && TINT=(-e $'s/^\\[[0-9]+[a-z]?\\] .*/\e[1;96m&\e[0m/' \
		-e $'s/^  PASS /  \e[0;32mPASS\e[0m /' -e $'s/^  FAIL /  \e[1;31mFAIL\e[0m /')
	for ID in "${SELFTEST_IDS[@]}"; do print -rn -- "${TEXT_OF[$ID]}"; done | LC_ALL=C sed -E "${TINT[@]}"
	for R in "${DIED[@]}"; do
		PRINT_TEXT "Scenarios %s ended without a result – exit %s:" 31 "${MEMBERS[$R]}" "$(<"$JT/$R.rc")"
		tail -5 "$JT/$R.out" | _CARET_LINES | LC_ALL=C sed 's/^/  | /'
	done
	echo ""
	if (( FAILED == 0 )); then
		PRINT_TEXT "%s" 32 "Selftest: all $TOTAL checks passed."
		rm -rf "$JT"
		echo "git-edit: ok – selftest $TOTAL/$TOTAL passed – ${SELFTEST_SCOPE:+$SELFTEST_SCOPE, }$JOBS jobs"
		_STATUS_EMITTED=true
		return 0
	fi
	PRINT_TEXT "%s" 31 "Selftest: $FAILED of $TOTAL checks FAILED."
	PRINT_TEXT "Every unit's output kept in %s" 33 "$JT"
	echo "git-edit: error – selftest $FAILED/$TOTAL failed – ${SELFTEST_SCOPE:+$SELFTEST_SCOPE, }$JOBS jobs"
	_STATUS_EMITTED=true
	return 1
}


# ---------------------------------------- ARGUMENT PARSING ----------------------------------------

# Only `--text=`, `--subject=`, `--verify=` and the inputs' glued forms leave the `=` zparseopts
# keeps – a value given apart keeps its own – and no value, nor a word past `--`, is a flag
TEXT_APART=false
SUBJECT_APART=false
VERIFY_APART=false
# Per input flag, `a` or `g` for each value in order – given apart or glued on
typeset -A INPUT_FORMS
ARG_SCAN=flags
for ARG in "$@"; do
	# A value given apart that is itself a flag means the value went missing – zparseopts would take
	# the flag as the value, and the run then misread what is left
	if [ "$ARG_SCAN" = value ] && [[ "$ARG" == (--(abort|after|dir|resquash|reword|allow-mode-change|allow-new-path|allow-other-actor|allow-pushed|amend-into|base|before|carry|chmod|commit|continue|drop|dry-run|edit|edits|exec|help|jobs|land|message|move|no-verify|no-verify-span|onto|patch|put|reorder|rm|selftest|skip|snapshot|split|squash|status|subject|text|tree|undo|verify|verify-span|version|wait|whole|yes)(|=*)|-[CdehMmSsy]) ]]; then
		PRINT_ERR "$VALUE_FLAG takes a value, and got the flag $ARG – give it one, or glue one that starts with - on as $VALUE_FLAG=<value>"
		exit 1
	fi
	# The `--` closing the flags, as an empty variable leaves it – `--text $MSG -- <path>`
	if [ "$ARG_SCAN" = value ] && [ "$ARG" = "--" ]; then
		PRINT_ERR "$VALUE_FLAG takes a value, and got the -- that ends the options – give it one, or glue it on as $VALUE_FLAG=-- where -- is the value"
		exit 1
	fi
	if [ "$ARG_SCAN" = value ]; then ARG_SCAN=flags; continue; fi
	[ "$ARG_SCAN" = flags ] || continue
	case "$ARG" in
		--)         ARG_SCAN=done ;;
		--text)     TEXT_APART=true ARG_SCAN=value VALUE_FLAG=$ARG ;;
		--text=*)   TEXT_APART=false ;;
		--subject)  SUBJECT_APART=true ARG_SCAN=value VALUE_FLAG=$ARG ;;
		--subject=*) SUBJECT_APART=false ;;
		--verify)   VERIFY_APART=true ARG_SCAN=value VALUE_FLAG=$ARG ;;
		--verify=*) VERIFY_APART=false ;;
		--patch|--put|--edits|--chmod|--rm) INPUT_FORMS[$ARG]+=a ARG_SCAN=value VALUE_FLAG=$ARG ;;
		--base|--tree|--after|--before|--move|--amend-into|--split|--onto|--land|--wait) ARG_SCAN=value VALUE_FLAG=$ARG ;;
		--patch=*|--put=*|--edits=*|--chmod=*|--rm=*) INPUT_FORMS[${ARG%%=*}]+=g ;;
		--verify-span) ;;
		# A word opening with a value flag's name reads to zparseopts as that flag, the rest its value –
		# a made-up `--text-file=…` would land as a message, `--verify-span=true` gate on `-span=true`
		--(after|amend-into|base|before|carry|chmod|dir|edits|jobs|land|move|onto|patch|put|rm|selftest|split|squash|subject|text|tree|verify|wait)[^=]*)
			_USAGE_POINT=1
			PRINT_ERR "Unknown option: $ARG"
			exit 1
			;;
	esac
done

zmodload zsh/zutil
# Parses the flags with `zparseopts`:
# • `-D` pulls parsed flags out of `$@`
# • `-E` allows flags, args and positionals to be mixed
# • `-F` fails on a flag that was not defined
# The first dash is handled automatically, so long options are `-opt`, not `--opt`

# `-h <topic>...`, the manual's entries for flags or sections, ahead of the parser, which would read
# a topic spelled as a flag as that flag
if [[ $1 == (-h|help) && $# -ge 2 ]]; then
	_HELP_TOPICS "${@:2}"
	exit 0
fi

# Its message names the argument it refused, which `-D` has already moved out of `$1` – lost
# where no temp file can be made, so a missing `TMPDIR` still lets `--version` and `--abort` answer
PARSE_ERR=$(MKTEMP_FILE git-edit-parse 2>/dev/null) && _TEMP_FILES+=("$PARSE_ERR")
if ! zparseopts -D -E -F -- {e,-edit}=OPT_EDIT {m,-message}=OPT_MESSAGE {M,-reword}=OPT_REWORD {d,-drop}=OPT_DROP {s,-squash}+::=OPT_SQUASH {S,-resquash}=OPT_RESQUASH {C,-dir}+::=OPT_DIR -exec=OPT_EXEC -commit=OPT_COMMIT -whole=OPT_WHOLE -base+:=OPT_BASE -dry-run=OPT_DRY_RUN -amend-into+:=OPT_AMEND_INTO -split+:=OPT_SPLIT -reorder=OPT_REORDER -onto+:=OPT_ONTO -land+:=OPT_LAND -skip=OPT_SKIP -move+:=OPT_MOVE -after+:=OPT_AFTER -before+:=OPT_BEFORE -continue=OPT_CONTINUE -abort=OPT_ABORT -undo=OPT_UNDO -status=OPT_STATUS -selftest+::=OPT_SELFTEST -jobs+::=OPT_JOBS -carry+::=OPT_CARRY -allow-pushed=OPT_ALLOW_PUSHED -allow-new-path=OPT_ALLOW_NEW_PATH -allow-mode-change=OPT_ALLOW_MODE_CHANGE -allow-other-actor=OPT_ALLOW_OTHER_ACTOR -tree+:=OPT_TREE -patch+:=OPT_PATCH -put+:=OPT_PUT -edits+:=OPT_EDITS -rm+:=OPT_RM -chmod+:=OPT_CHMOD -snapshot=OPT_SNAPSHOT -verify+:=OPT_VERIFY -no-verify=OPT_NO_VERIFY -verify-span=OPT_VERIFY_SPAN -no-verify-span=OPT_NO_VERIFY_SPAN -text+:=OPT_TEXT -subject+:=OPT_SUBJECT -wait+:=OPT_WAIT {y,-yes}=OPT_YES {h,-help}=OPT_HELP -version=OPT_VERSION 2>"${PARSE_ERR:-/dev/null}"; then
	_USAGE_POINT=1
	PARSE_MSG=""
	[ -n "$PARSE_ERR" ] && PARSE_MSG=$(<"$PARSE_ERR")
	PARSE_MSG=${PARSE_MSG#*zparseopts:*: }
	case "$PARSE_MSG" in
		"bad option: "*)                   PRINT_ERR "Unknown option: ${PARSE_MSG#bad option: }" ;;
		"missing argument for option: "*)  PRINT_ERR "Option ${PARSE_MSG#missing argument for option: } needs a value" ;;
		*)                                 PRINT_ERR "Cannot parse the options: ${PARSE_MSG:-$*}" ;;
	esac
	exit 1
fi
[ -n "$PARSE_ERR" ] && rm -f "$PARSE_ERR"

# -h/--help/help
if [[ ${#OPT_HELP} -gt 0 || $1 == "help" ]]; then
	USAGE
	exit 0
fi

# --version – answers outside a repo too, since the banner is all that ran before it
if [ ${#OPT_VERSION} -gt 0 ]; then
	ECHO_E "\e[0;94mgit-edit ${GIT_EDIT_VERSION}\e[0m"
	exit 0
fi

# An option taking one value, given twice, kept one alone – a fold landing on the wrong
# commit or folding the wrong tree, a message or a check dropped with nothing said – so a repeat
# refuses, `--move` alone repeating by design
# `-s`, `-C`, `--selftest` and `--carry` hold their value in the element they
# name, the others take it as a second one
for REPEAT_OPT REPEAT_ARR REPEAT_MAX REPEAT_WHAT in --amend-into OPT_AMEND_INTO 2 'names one commit' \
		--split OPT_SPLIT 2 'names one commit' --onto OPT_ONTO 2 'names one commit' --land OPT_LAND 2 'names one branch' \
		-s/--squash OPT_SQUASH 1 'names one commit' --after OPT_AFTER 2 'names one commit' \
		--before OPT_BEFORE 2 'names one commit' --base OPT_BASE 2 'names one commit' --tree OPT_TREE 2 'names one tree' \
		--text OPT_TEXT 2 'takes one message' --subject OPT_SUBJECT 2 'takes one subject' \
		--verify OPT_VERIFY 2 'runs one command' --edits OPT_EDITS 2 'takes one list of edits' \
		-C/--dir OPT_DIR 1 'takes one directory' --selftest OPT_SELFTEST 1 'takes one list of scenarios' \
		--jobs OPT_JOBS 1 'takes one count' --wait OPT_WAIT 2 'takes one bound' \
		--carry OPT_CARRY 1 'names one old tip'; do
	if (( ${#${(P)REPEAT_ARR}} > REPEAT_MAX )); then
		PRINT_ERR "$REPEAT_OPT given twice – it $REPEAT_WHAT, and only the last would count"
		exit 1
	fi
done

# An empty commit or branch is a lookup that found nothing – `--amend-into=$(git log …)` – said as
# such, not as a usage screen or an unknown commit
for REPEAT_OPT REPEAT_ARR REPEAT_WHAT REPEAT_MAX in --amend-into OPT_AMEND_INTO 'a commit' '<sha>' \
		--split OPT_SPLIT 'a commit' '<sha>' --move OPT_MOVE 'a commit' '<sha>' --after OPT_AFTER 'a commit' '<sha>' \
		--before OPT_BEFORE 'a commit' '<sha>' --base OPT_BASE 'a commit' '<sha>' \
		--onto OPT_ONTO 'an upstream' '<upstream>' --land OPT_LAND 'a branch' '<branch>'; do
	for (( I = 2; I <= ${#${(P)REPEAT_ARR}}; I += 2 )); do
		[ -z "${${(P)REPEAT_ARR}[I]#=}" ] || continue
		PRINT_ERR "$REPEAT_OPT's value is empty – it names $REPEAT_WHAT, and nothing was done"
		ECHO_E "\e[0;31m  Give it one as $REPEAT_OPT=$REPEAT_MAX – a lookup feeding it, like \$(git log …), found nothing.\e[0m" >&2
		exit 1
	done
done

# Past the usage and version answers, which an outdated git should still get
_REQUIRE_GIT_VERSION
_REQUIRE_PLAIN_GIT_ENV
# The suite makes repositories of its own
[ ${#OPT_SELFTEST} -gt 0 ] || _REQUIRE_REPOSITORY

# Capture `HEAD` before any change, for the status trailer's `old_head` – empty in an empty repo,
# where the script fails later on commit resolution, so the trailer is never reached
SCRIPT_INITIAL_HEAD=$(git rev-parse HEAD 2>/dev/null)
# And the pause standing then, one the run got past – a pause begun since wins over its landing
[ ${#OPT_SELFTEST} -gt 0 ] || _PAUSE_AT_START=$(_PAUSE_KEYS "$(_STATE_FILE_PATH)")

# Resolves the `--text` value into `TEXT_VALUE` – `--text "msg"` as a separate arg or after
# an `=`, and `--text -` to read stdin, multi-line included
# `zparseopts` splits both into [--text, value], the `=value` form keeping its leading `=`
if [ ${#OPT_TEXT} -gt 0 ]; then
	if [[ ${#OPT_TEXT} -gt 1 ]]; then
		TEXT_VALUE=${OPT_TEXT[2]}
		[ "$TEXT_APART" = true ] || TEXT_VALUE=${TEXT_VALUE#=}
	fi
	if [ "$TEXT_VALUE" = "-" ]; then
		TEXT_VALUE=$(cat)
	fi
	# Keep the un-normalized text so a records batch can split on its own
	# `--- ` headers – the single-message stripspace below would still leave those
	# intact, but records parse from the raw form for clarity
	RAW_TEXT_VALUE=$TEXT_VALUE
	# Normalize whitespace the way the editor flow does, but not its comment stripping, which
	# exists to drop the instructions git seeds a template with – nothing seeds this one, so
	# a `#` line here is the caller's own content
	TEXT_VALUE=$(print -r -- "$TEXT_VALUE" | git stripspace)
	if [ -z "$TEXT_VALUE" ]; then
		PRINT_ERR "--text produced an empty message after stripping"
		exit 1
	fi
fi
# Resolves `--subject` into `SUBJECT_VALUE` – one line, trimmed as git trims a message's, that
# replaces the first paragraph of a message there already, the rest kept byte for byte
if [ ${#OPT_SUBJECT} -gt 0 ]; then
	SUBJECT_VALUE=${OPT_SUBJECT[2]}
	[ "$SUBJECT_APART" = true ] || SUBJECT_VALUE=${SUBJECT_VALUE#=}
	if [[ "$SUBJECT_VALUE" == *$'\n'* ]]; then
		PRINT_ERR "--subject takes one line, and got several – a subject is the message's first line, which leaves its body alone"
		ECHO_E "\e[0;31m  To write the body too, pass the whole message as --text \"…\".\e[0m" >&2
		exit 1
	fi
	SUBJECT_VALUE=$(print -r -- "$SUBJECT_VALUE" | LC_ALL=C sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
	# A carriage return inside it reads as a line break wherever the message is shown
	if [[ "$SUBJECT_VALUE" == *$'\r'* ]]; then
		PRINT_ERR "--subject takes one line, and got a carriage return inside it"
		exit 1
	fi
	if [ -z "$SUBJECT_VALUE" ]; then
		PRINT_ERR "--subject needs a subject (--subject=\"…\")"
		exit 1
	fi
	if [ ${#OPT_TEXT} -gt 0 ]; then
		PRINT_ERR "--subject and --text cannot be combined – --subject keeps the body, --text replaces the whole message, so pass one"
		exit 1
	fi
	# A mode writing a new message, or none, has no subject to replace – an edit or an implicit
	# squash, named by no flag here, refuses once its action is known
	SUBJECT_GOT=()
	if [ ${#OPT_REWORD} -eq 0 ] && [ ${#OPT_CONTINUE} -eq 0 ] && [ ${#OPT_SKIP} -eq 0 ] && [ ${#OPT_ABORT} -eq 0 ]; then
		for STRAY_OPT STRAY_ARR in -d OPT_DROP -s OPT_SQUASH -S OPT_RESQUASH --exec OPT_EXEC --commit OPT_COMMIT \
				--amend-into OPT_AMEND_INTO --split OPT_SPLIT --reorder OPT_REORDER --onto OPT_ONTO --land OPT_LAND \
				--move OPT_MOVE --undo OPT_UNDO --status OPT_STATUS --carry OPT_CARRY --selftest OPT_SELFTEST; do
			(( ${#${(P)STRAY_ARR}} )) && SUBJECT_GOT+=("$STRAY_OPT")
		done
	fi
	if [ ${#SUBJECT_GOT} -gt 0 ]; then
		PRINT_ERR "--subject only applies to -M/--reword and an edit pause's --continue, not ${(j: and :)SUBJECT_GOT} – nothing was done"
		ECHO_E "\e[0;31m  It replaces the subject of a message there already – a mode writing a new message takes it whole as --text \"…\".\e[0m" >&2
		exit 1
	fi
fi

# Resolve --verify's command – both `--verify=<cmd>` and `--verify <cmd>` forms
if [ ${#OPT_VERIFY} -gt 0 ]; then
	if [[ ${#OPT_VERIFY} -gt 1 ]]; then
		VERIFY_VALUE=${OPT_VERIFY[2]}
		[ "$VERIFY_APART" = true ] || VERIFY_VALUE=${VERIFY_VALUE#=}
	fi
	if [ -z "$VERIFY_VALUE" ]; then
		PRINT_ERR "--verify needs a command (--verify=<cmd>)"
		exit 1
	fi
	# Refused here rather than only where the gate runs: a pause persists the command as one
	# `key=value` line, and a conflict pause comes before any gate – a resume would then read
	# back the first line alone, a truncated check that can still exit 0
	if [ "$VERIFY_VALUE" != "${VERIFY_VALUE%%$'\n'*}" ]; then
		PRINT_ERR "The verify command spans multiple lines – a pause could only carry its first"
		ECHO_E "\e[0;31m  Put it in a script and name that instead.\e[0m" >&2
		exit 1
	fi
fi
# Resolves `--wait`'s bound into `WAIT_SECS` – how long a run waits for another caller's pause to
# clear before it refuses – 90 s by default, none under the suite, whose checks expect the refusal
WAIT_SECS=90
(( ${GIT_EDIT_SELFTEST_DEPTH:-0} > 0 )) && WAIT_SECS=0
if [ ${#OPT_WAIT} -gt 0 ]; then
	WAIT_SECS=${OPT_WAIT[2]#=}
	# Nine digits at most, decades already – a much longer one would overflow the arithmetic
	if [[ "$WAIT_SECS" != <-> ]] || (( ${#WAIT_SECS} > 9 )); then
		PRINT_ERR "--wait takes a whole number of seconds (--wait=<secs>, 0 refusing at once), and got: ${${OPT_WAIT[2]#=}:-nothing}"
		exit 1
	fi
	WAIT_SECS=$(( 10#$WAIT_SECS ))
fi
# Resolve --tree's value – both `--tree=<tree-ish>` and `--tree <tree-ish>` forms
AMEND_TREE=""
if [ ${#OPT_TREE} -gt 0 ]; then
	if [[ ${#OPT_TREE} -gt 1 ]]; then
		AMEND_TREE=${OPT_TREE[2]#=}
	fi
	if [ -z "$AMEND_TREE" ]; then
		PRINT_ERR "--tree needs a tree-ish (--tree=<sha>)"
		exit 1
	fi
	if [ ${#OPT_AMEND_INTO} -eq 0 ] && [ ${#OPT_COMMIT} -eq 0 ]; then
		_USAGE_POINT=1
		PRINT_ERR "--tree only applies to --amend-into and --commit"
		exit 1
	fi
fi
if [ ${#OPT_SNAPSHOT} -gt 0 ] && [ ${#OPT_AMEND_INTO} -eq 0 ]; then
	_USAGE_POINT=1
	PRINT_ERR "--snapshot only applies to --amend-into"
	exit 1
fi
if [ ${#OPT_ALLOW_OTHER_ACTOR} -gt 0 ] && [ ${#OPT_CONTINUE} -eq 0 ] && [ ${#OPT_ABORT} -eq 0 ] && [ ${#OPT_SKIP} -eq 0 ] && [ ${#OPT_UNDO} -eq 0 ]; then
	_USAGE_POINT=1
	PRINT_ERR "--allow-other-actor only applies to --continue, --skip, --abort and --undo"
	exit 1
fi
if [ ${#OPT_WHOLE} -gt 0 ]; then
	if [ ${#OPT_AMEND_INTO} -eq 0 ]; then
		_USAGE_POINT=1
		PRINT_ERR "--whole only applies to --amend-into – a new commit of whole files takes --commit"
		exit 1
	fi
	if [ ${#OPT_TREE} -gt 0 ]; then
		PRINT_ERR "--whole and --tree cannot be combined – --whole composes the tree from the files itself"
		exit 1
	fi
fi
# The inputs compose a change from the caller's own edits – for a new commit or a fold alone, files
# taken whole beside them, and instead of a tree, which composes it otherwise
if _INPUTS_GIVEN; then
	if [ ${#OPT_COMMIT} -eq 0 ] && [ ${#OPT_AMEND_INTO} -eq 0 ]; then
		_USAGE_POINT=1
		PRINT_ERR "--patch, --put, --edits, --rm and --chmod only apply to --commit and --amend-into"
		exit 1
	fi
	if [ ${#OPT_TREE} -gt 0 ]; then
		PRINT_ERR "--patch, --put, --edits, --rm and --chmod compose the change themselves – no --tree beside them"
		exit 1
	fi
fi
# Resolve `--base`'s value – the tip an `--exec` result was built on, or the commit whole files
# rest on, both `--base=<sha>` and `--base <sha>` forms
# Hex only – a name like `HEAD` resolves to wherever the branch is now, the very tip the flag
# exists to check the build against
EXEC_BASE=""
# Set by `--commit` alone – one in the caller's environment would rename every exec run
EXEC_LABEL=""
if [ ${#OPT_BASE} -gt 0 ]; then
	if [ ${#OPT_EXEC} -eq 0 ] && [ ${#OPT_COMMIT} -eq 0 ] && [ ${#OPT_AMEND_INTO} -eq 0 ] && [ ${#OPT_LAND} -eq 0 ]; then
		_USAGE_POINT=1
		PRINT_ERR "--base only applies to --exec, --commit, --amend-into and --land"
		exit 1
	fi
	# A tree composed on the tip applies to the tip itself – a base would check nothing, where a bare
	# tree's fold has no tip of its own to pin, so takes one, as every input takes the commit the
	# files it was built from rest on
	if [ ${#OPT_EXEC} -eq 0 ] && [ ${#OPT_TREE} -gt 0 ] && { [ ${#OPT_COMMIT} -gt 0 ] || _PEEL_SHA "${OPT_TREE[2]#=}" commit >/dev/null; }; then
		PRINT_ERR "--base checks what a run composes from files – a --tree commit composed on the tip applies to the tip itself, so drop it"
		exit 1
	fi
	if [[ ${#OPT_BASE} -gt 1 ]]; then
		EXEC_BASE=${OPT_BASE[2]#=}
	fi
	if [[ ! "$EXEC_BASE" =~ '^[0-9a-fA-F]{7,64}$' ]] && [ ${#OPT_LAND} -gt 0 ]; then
		PRINT_ERR "--base takes the SHA of the commit the landed branch forked from (--land=<branch> --base=<sha>)"
		ECHO_E "\e[0;31m  A name resolves to wherever that branch is now, which may have moved past the fork – 'git rev-parse <name>' prints its SHA.\e[0m" >&2
		exit 1
	fi
	if [[ ! "$EXEC_BASE" =~ '^[0-9a-fA-F]{7,64}$' ]]; then
		PRINT_ERR "--base takes the SHA of the tip your history was built on (--base=<sha>)"
		ECHO_E "\e[0;31m  A name like HEAD resolves to wherever the branch is now – the tip the flag checks against.\e[0m" >&2
		exit 1
	fi
	if ! EXEC_BASE=$(git rev-parse --verify --quiet "$EXEC_BASE^{commit}" 2>/dev/null); then
		PRINT_ERR "--base ${OPT_BASE[2]#=} names no commit here"
		exit 1
	fi
fi
# A dry run builds and reports – it never verifies, the landing run does, so an explicit gate
# here would be a promise the run never keeps, and an opt-out one its landing line drops
# Which checks to skip is also best settled once the result has been inspected
if [ ${#OPT_DRY_RUN} -gt 0 ]; then
	if [ ${#OPT_EXEC} -eq 0 ] && [ ${#OPT_LAND} -eq 0 ]; then
		_USAGE_POINT=1
		PRINT_ERR "--dry-run only applies to --exec and --land"
		exit 1
	fi
	if [ ${#OPT_VERIFY} -gt 0 -o ${#OPT_VERIFY_SPAN} -gt 0 -o ${#OPT_NO_VERIFY} -gt 0 -o ${#OPT_NO_VERIFY_SPAN} -gt 0 ]; then
		PRINT_ERR "--dry-run never verifies – the run that lands its result does, so pass verify flags there"
		exit 1
	fi
fi
# An explicit `--verify` on a mode with no gate would be silently ignored, a promise the run
# never keeps, so refuse it up front – `-M`/`-S` preserve every tree by construction
if [ ${#OPT_VERIFY} -gt 0 -o ${#OPT_VERIFY_SPAN} -gt 0 ] && [ ${#OPT_REWORD} -gt 0 -o ${#OPT_RESQUASH} -gt 0 ]; then
	PRINT_ERR "--verify cannot gate this mode"
	ECHO_E "\e[0;31m  A reword or -S preserves every tree by construction.\e[0m" >&2
	exit 1
fi
if [ ${#OPT_VERIFY_SPAN} -gt 0 ] && [ ${#OPT_NO_VERIFY_SPAN} -gt 0 ]; then
	PRINT_ERR "--verify-span and --no-verify-span cannot be combined"
	exit 1
fi

# Takes the pause's label for the resume – a labeled caller's run is its own to resume or cancel,
# so another label refuses, as `--undo` does, while a person at a terminal may finish an agent's
_ADOPT_PAUSE_ACTOR () {
	# Args: <continue|skip|abort>
	# A terminal's prompt resumes the pause it showed – another run may have ended that one and taken
	# the slot in the moment between
	if [ -n "$_EXPECT_PAUSE" ] && [ "$(_PAUSE_IDENTITY "$_STATE_PATH")" != "$_EXPECT_PAUSE" ]; then
		_STATE_OWNED=""
		PRINT_ERR "The pause the prompt showed is no longer pending – another run ended it, resumed it to another stop, or took the slot – so nothing was done"
		exit 1
	fi
	if [ ${#OPT_ALLOW_OTHER_ACTOR} -eq 0 ] && _PAUSE_FOREIGN; then
		_STATE_OWNED=""
		if [ "$REPLY" = cut ]; then
			PRINT_ERR "The pause's state file names neither its caller nor its operation – cut short, say – so refusing to $1 it as $_ACTOR_ID"
			ECHO_E "\e[0;31m  Leave it to whoever paused it – or clear it with 'git edit --abort --allow-other-actor', as no run resumes a pause with no operation on record.\e[0m" >&2
		else
			_PAUSE_NAME
			PRINT_ERR "The paused $REPLY is ${${STATE_ACTOR_ID:+$STATE_ACTOR_ID's}:-an unlabeled caller's} – refusing to $1 it as $_ACTOR_ID"
			ECHO_E "\e[0;31m  Leave it to that caller – or pass --allow-other-actor to $1 it anyway.\e[0m" >&2
		fi
		exit 1
	fi
	if [ -n "$STATE_ACTOR" ]; then
		_ACTOR=$STATE_ACTOR
		_ACTOR_ID=$STATE_ACTOR_ID
		_REFLOG_TAG=" [$_ACTOR]"
	fi
}

# `--continue` and `--abort` dispatch – resume or cancel an in-flight operation, mirroring
# `git rebase --continue` and `--abort`, and short-circuiting before any of the normal
# argument validation gets a chance to run
if [ ${#OPT_CONTINUE} -gt 0 ] && [ ${#OPT_ABORT} -gt 0 ]; then
	PRINT_ERR "--continue and --abort cannot be combined"
	exit 1
fi
# --skip resumes too, just past the current commit rather than through it
if [ ${#OPT_SKIP} -gt 0 ]; then
	if [ ${#OPT_ABORT} -gt 0 ]; then
		PRINT_ERR "--skip and --abort cannot be combined"
		exit 1
	fi
	OPT_CONTINUE=(--continue)
fi
# A resume or cancel acts on the pause alone, so a commit or mode beside it would go unheard – the
# run reporting `ok` for the pause while the drop or move asked alongside never happened
# Kept: what a resume reads (`--text`, the verify flags, the allow flags, `-y`) – beside `--abort`
# too, the escape hatch a harmless extra must not block
if [ ${#OPT_CONTINUE} -gt 0 ] || [ ${#OPT_ABORT} -gt 0 ]; then
	RESUME_FLAG=--continue
	[ ${#OPT_SKIP} -gt 0 ] && RESUME_FLAG=--skip
	[ ${#OPT_ABORT} -gt 0 ] && RESUME_FLAG=--abort
	if [ ${#OPT_WAIT} -gt 0 ]; then
		PRINT_ERR "--wait waits for another caller's pause to clear before a run – $RESUME_FLAG acts on the pause itself, so nothing was done"
		ECHO_E "\e[0;31m  Run 'git edit $RESUME_FLAG' without it – 'git edit --status' names whose pause it is.\e[0m" >&2
		exit 1
	fi
	RESUME_GOT=()
	for STRAY_OPT STRAY_ARR in -e OPT_EDIT -m OPT_MESSAGE -M OPT_REWORD -d OPT_DROP -s OPT_SQUASH -S OPT_RESQUASH \
			-C OPT_DIR --exec OPT_EXEC --commit OPT_COMMIT --amend-into OPT_AMEND_INTO --split OPT_SPLIT \
			--reorder OPT_REORDER --onto OPT_ONTO --land OPT_LAND --move OPT_MOVE --after OPT_AFTER --before OPT_BEFORE \
			--tree OPT_TREE --base OPT_BASE --whole OPT_WHOLE --snapshot OPT_SNAPSHOT --dry-run OPT_DRY_RUN \
			--patch OPT_PATCH --put OPT_PUT --edits OPT_EDITS --rm OPT_RM --chmod OPT_CHMOD \
			--undo OPT_UNDO --status OPT_STATUS --carry OPT_CARRY --selftest OPT_SELFTEST --jobs OPT_JOBS; do
		(( ${#${(P)STRAY_ARR}} )) && RESUME_GOT+=("$STRAY_OPT")
	done
	RESUME_GOT+=("${(@)@:#--}")
	if [ ${#RESUME_GOT} -gt 0 ]; then
		PRINT_ERR "$RESUME_FLAG acts on the pause alone – it takes no <commit> or mode, and got: ${(j: :)RESUME_GOT}"
		ECHO_E "\e[0;31m  Nothing was done – run 'git edit $RESUME_FLAG' by itself, then the rest as a run of its own.\e[0m" >&2
		exit 1
	fi
fi
# A move a killed run made but never journaled, recorded before anything reads the journal
[ ${#OPT_SELFTEST} -gt 0 ] || _ADOPT_KILLED_MOVE
if [ ${#OPT_CONTINUE} -gt 0 ]; then
	_LOAD_STATE
	_ADOPT_PAUSE_ACTOR "${${OPT_SKIP:+skip}:-continue}"
	_REANCHOR_INITIAL_HEAD
	if [ -n "$STATE_CAPTURE" ]; then
		_CAPTURE_BEGIN resume "$STATE_CAPTURE"
	fi
	# Only a replant or a land has commits worth stepping over – elsewhere the paused
	# commit is the whole point, so skipping it would quietly discard the work
	if [ ${#OPT_SKIP} -gt 0 ] && [[ "$STATE_OPERATION" != (onto|land) ]]; then
		_PAUSE_NAME
		PRINT_ERR "--skip applies to --onto and --land only; '$REPLY' has no commit to step over"
		exit 1
	fi
	# A branch deleted or renamed meanwhile has no tip to land on, and a worktree git no longer
	# knows holds no rebase to resume – each named as itself rather than as a moved branch
	if [ -n "$STATE_BRANCH" ] && ! git rev-parse -q --verify "$STATE_BRANCH" >/dev/null 2>&1; then
		_STATE_OWNED=""
		PRINT_ERR "Branch ${STATE_BRANCH#refs/heads/} is gone – deleted or renamed during the pause – so nothing can land"
		ECHO_E "\e[0;31m  Cancel with 'git edit --abort', then run it again on the branch as it is now.\e[0m" >&2
		exit 1
	fi
	if [ -d "$STATE_WORKTREE" ] && [ "$(git -C "$STATE_WORKTREE" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" != "$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" ]; then
		_STATE_OWNED=""
		PRINT_ERR "The pause's worktree $STATE_WORKTREE is no longer a checkout of this repository – pruned, say – so nothing can resume there"
		ECHO_E "\e[0;31m  Cancel with 'git edit --abort', then run it again.\e[0m" >&2
		exit 1
	fi
	_HOLD_PAUSE_WORKTREE applied
	_REQUIRE_PAUSE_AS_READ
	# A resume landing on the tip its pause read refuses before it replays or gates anything
	# where the branch moved since – an edit or a split reads the branch again instead, and a
	# branch at what the worktree built is the pause's own landing, its run cut off before clearing
	if [[ "$STATE_OPERATION" == (amend-into|snapshot|reorder|onto|land|rebase) ]] && \
	   [ "$(git rev-parse -q --verify "$STATE_BRANCH" 2>/dev/null)" != "$(git -C "$STATE_WORKTREE" rev-parse -q --verify HEAD 2>/dev/null)" ]; then
		_REQUIRE_CURRENT "$STATE_BRANCH" "${STATE_HEAD_WITH_FIXUP:-$STATE_ORIG_HEAD}"
	fi
	_NOTE_UNRECORDED_STOP
	if [ -n "$STATE_WORKTREE" ] && [ -d "$STATE_WORKTREE" ]; then
		# Config added mid-pause reaches the existing worktree here – links are created only at
		# worktree setup and re-ensuring is idempotent, while a mode that saved no maindir falls
		# back to the worktree's own registration
		_LINK_WORKTREE_EXTRAS "$STATE_WORKTREE" "${STATE_MAINDIR:-$(git -C "$STATE_WORKTREE" worktree list --porcelain 2>/dev/null | LC_ALL=C sed -n '1s/^worktree //p')}"
		# A verify pause is not a content-edit pause – the result is already built, and both the
		# re-verify and the restore below check out with `-f`, so work authored here would vanish
		# Tracked files only, never a submodule pointer, or an unrelated dirty one refuses forever
		if { [ -n "$STATE_VERIFY_FAILED" ] || [ -n "$STATE_MODE_STRAY" ]; } && [ -n "$(git -C "$STATE_WORKTREE" status --porcelain --untracked-files=no --ignore-submodules=all 2>/dev/null)" ]; then
			PRINT_ERR "The pause worktree carries edits, but a gate pause has nothing to fold them into – the result is already built"
			ECHO_E "\e[0;31m  Save anything worth keeping, then discard them: $(_LIT "git -C $(_SHQ "$STATE_WORKTREE") checkout -- .")\e[0m" >&2
			if [ -n "$STATE_VERIFY_FAILED" ]; then
				ECHO_E "\e[0;31m  Repair the commit itself: 'git edit --no-verify --continue' applies the result, then 'git edit ${STATE_VERIFY_FAILED:0:7}'.\e[0m" >&2
			else
				ECHO_E "\e[0;31m  Repair the commit itself: 'git edit --allow-mode-change --continue' applies the result, then 'git edit ${STATE_MODE_STRAY:0:7}'.\e[0m" >&2
			fi
			exit 1
		fi
		# Untracked files feed the gate's run yet never land, so a resolution's new file left
		# unstaged passes a check its result fails – only an authoring stage absorbs them
		if _VERIFY_CONFIGURED; then
			RESUME_GD=$(git -C "$STATE_WORKTREE" rev-parse --absolute-git-dir 2>/dev/null)
			RESUME_ABSORBS=false
			if [ -z "$STATE_VERIFY_FAILED$STATE_MODE_STRAY" ] && [ ! -d "$RESUME_GD/rebase-merge" ] && [ ! -d "$RESUME_GD/rebase-apply" ]; then
				[ "$STATE_OPERATION" = split ] && RESUME_ABSORBS=true
				[ "$STATE_OPERATION" = edit ] && [ "$(git -C "$STATE_WORKTREE" rev-parse HEAD 2>/dev/null)" = "$STATE_TARGET" ] && RESUME_ABSORBS=true
			fi
			RESUME_STRAY=$(git -C "$STATE_WORKTREE" -c core.quotePath=false ls-files -o --exclude-standard --directory --no-empty-directory 2>/dev/null)
			if [ "$RESUME_ABSORBS" = false ] && [ -n "$RESUME_STRAY" ]; then
				PRINT_ERR "Untracked files in the pause worktree would feed the verify check but never land: $(_ALL_PATHS "${(@f)RESUME_STRAY}")"
				if [ -n "$STATE_VERIFY_FAILED$STATE_MODE_STRAY" ]; then
					ECHO_E "\e[0;31m  Remove them – the result is already built, so one it needs is a fix to the commit itself.\e[0m" >&2
				# An edit past its authoring holds no resolution – commits made at its stop take one in, an
				# amend made already none
				elif [ "$STATE_OPERATION" = edit ] && [ ! -d "$RESUME_GD/rebase-merge" ] && [ ! -d "$RESUME_GD/rebase-apply" ]; then
					if [ -z "$STATE_AMENDED" ]; then
						ECHO_E "\e[0;31m  Commit the ones the edit needs beside the commits made at the stop and remove the rest, then 'git edit --continue'.\e[0m" >&2
					else
						ECHO_E "\e[0;31m  Remove them, then 'git edit --continue' – the amend is made, so one the edit needs takes 'git edit --abort' and an edit anew.\e[0m" >&2
					fi
				else
					ECHO_E "\e[0;31m  Stage the ones the resolution needs and remove the rest, then 'git edit --continue'.\e[0m" >&2
				fi
				exit 1
			fi
		fi
		RESUME_WT_GD=$(git -C "$STATE_WORKTREE" rev-parse --absolute-git-dir 2>/dev/null)
		# After a verify pause the built result is recorded – put the worktree back on it before any
		# handler reads its `HEAD` as the result to apply, since the inspect hint checks out the
		# failing commit and a continue from there would land it as the tip
		# A rebase in progress there is a later stop's, which the result predates
		if [ -n "$STATE_VERIFY_RESULT" ] && [ ! -d "$RESUME_WT_GD/rebase-merge" ] && [ ! -d "$RESUME_WT_GD/rebase-apply" ]; then
			if git -C "$STATE_WORKTREE" rev-parse -q --verify "$STATE_VERIFY_RESULT^{commit}" >/dev/null 2>&1; then
				RESUME_HEAD=$(git -C "$STATE_WORKTREE" rev-parse HEAD 2>/dev/null)
				if [ "$RESUME_HEAD" != "$STATE_VERIFY_RESULT" ]; then
					# Commits made on the result, or edits, would go with the restore – refused, never discarded
					if git -C "$STATE_WORKTREE" merge-base --is-ancestor "$STATE_VERIFY_RESULT" "$RESUME_HEAD" 2>/dev/null; then
						PRINT_ERR "Commits were made on the built result ${STATE_VERIFY_RESULT:0:7}, which a gate pause lands as it was built – nothing was applied"
						git -C "$STATE_WORKTREE" log --reverse --format='%h %s' "$STATE_VERIFY_RESULT..$RESUME_HEAD" 2>/dev/null | _CARET_LINES | LC_ALL=C sed "s/^/${_RED}  /;s/\$/${_OFF}/" >&2
						ECHO_E "\e[0;31m  Save them, then 'git -C $(_LIT "$(_SHQ "$STATE_WORKTREE")") reset --hard ${STATE_VERIFY_RESULT:0:12}' and 'git edit --continue' – fold them in after it lands.\e[0m" >&2
						exit 1
					fi
					# Only a commit the result holds is an inspect checkout – any other, an amend of it say,
					# is work the restore would drop
					if ! git -C "$STATE_WORKTREE" merge-base --is-ancestor "$RESUME_HEAD" "$STATE_VERIFY_RESULT" 2>/dev/null; then
						PRINT_ERR "The pause worktree is on a commit the built result ${STATE_VERIFY_RESULT:0:7} does not hold, which a gate pause lands as it was built – nothing was applied"
						git -C "$STATE_WORKTREE" log -1 --format='%h %s' "$RESUME_HEAD" 2>/dev/null | _CARET_LINES | LC_ALL=C sed "s/^/${_RED}  /;s/\$/${_OFF}/" >&2
						ECHO_E "\e[0;31m  Save it, then 'git -C $(_LIT "$(_SHQ "$STATE_WORKTREE")") reset --hard ${STATE_VERIFY_RESULT:0:12}' and 'git edit --continue' – fold it in after it lands.\e[0m" >&2
						exit 1
					fi
					if [ -n "$(git -C "$STATE_WORKTREE" status --porcelain --untracked-files=no --ignore-submodules=all 2>/dev/null)" ]; then
						PRINT_ERR "The pause worktree is off the built result ${STATE_VERIFY_RESULT:0:7}, with edits a restore would discard – nothing was applied"
						ECHO_E "\e[0;31m  Save anything worth keeping, then discard them: $(_LIT "git -C $(_SHQ "$STATE_WORKTREE") checkout -- .")\e[0m" >&2
						exit 1
					fi
					PRINT_TEXT "Worktree HEAD is off the built result (an inspect checkout, say) – restoring %s" 33 "${STATE_VERIFY_RESULT:0:7}"
					if ! git -C "$STATE_WORKTREE" checkout -q --detach "$STATE_VERIFY_RESULT" 2>/dev/null; then
						PRINT_ERR "Could not put the pause worktree back on the built result ${STATE_VERIFY_RESULT:0:7} – nothing was applied"
						ECHO_E "\e[0;31m  Check it out there by hand ('git -C $(_LIT "$(_SHQ "$STATE_WORKTREE")") checkout --detach ${STATE_VERIFY_RESULT:0:12}'), then 'git edit --continue'.\e[0m" >&2
						exit 1
					fi
				fi
			else
				# Falling back to worktree `HEAD` would reopen the truncation trap
				# this marker exists to close – refuse instead
				PRINT_ERR "Recorded result ${STATE_VERIFY_RESULT:0:7} no longer resolves – the pause likely outlived the reflog"
				ECHO_E "\e[0;31m  Nothing can apply it now – 'git edit --abort' cancels with nothing consumed.\e[0m" >&2
				exit 1
			fi
		fi
	fi
	# A drop, squash, reorder, replant or land has no message left to take – refused, not dropped
	if [ -n "$TEXT_VALUE" ] && [[ "$STATE_OPERATION" == (rebase|reorder|onto|land) ]]; then
		_PAUSE_NAME
		PRINT_ERR "--text has no message to set on this $REPLY's continue – finish it, then reword: git edit -M --text=\"…\" <sha>"
		exit 1
	fi
	# Only an edit's amend sets the paused commit's own message – a split's continue writes a new one
	if [ -n "$SUBJECT_VALUE" ] && [ "$STATE_OPERATION" != edit ]; then
		if [ "$STATE_OPERATION" = split ]; then
			PRINT_ERR "--subject applies to an edit's continue alone – a split's continue writes the extracted commit's message whole, as --text \"…\""
		else
			_PAUSE_NAME
			PRINT_ERR "--subject has no message to set on this $REPLY's continue – finish it, then reword: git edit -M --subject=\"…\" <sha>"
		fi
		exit 1
	fi
	# Past every refusal above, so a resume refused leaves the pause's gate as it was
	_NOTE_RESUME_VERIFY
	case "$STATE_OPERATION" in
		amend-into) _CONTINUE_AMEND_INTO ;;
		snapshot)   _CONTINUE_SNAPSHOT ;;
		reorder)    _CONTINUE_REORDER ;;
		onto|land)  _CONTINUE_ONTO ;;
		rebase)     _CONTINUE_REBASE ;;
		edit)       _CONTINUE_EDIT ;;
		split)      _CONTINUE_SPLIT ;;
		*)
			PRINT_ERR "The pause records no operation this version knows${STATE_OPERATION:+ ('$STATE_OPERATION')} – its state file cut short, or written by a newer git-edit – so nothing can resume it"
			ECHO_E "\e[0;31m  Clear it with 'git edit --abort', then run it again.\e[0m" >&2
			exit 1 ;;
	esac
	exit 0
fi
if [ ${#OPT_ABORT} -gt 0 ]; then
	_LOAD_STATE
	_ADOPT_PAUSE_ACTOR abort
	_REANCHOR_INITIAL_HEAD
	_HOLD_PAUSE_WORKTREE cancelled
	case "$STATE_OPERATION" in
		amend-into) _ABORT_AMEND_INTO ;;
		snapshot)   _ABORT_SNAPSHOT ;;
		reorder)    _ABORT_REORDER ;;
		onto|land)  _ABORT_ONTO ;;
		rebase)     _ABORT_REBASE ;;
		edit)       _ABORT_EDIT ;;
		split)      _ABORT_SPLIT ;;
		*)
			# An unreadable pause, or one a newer version wrote – cleared, its
			# worktree removed only where this tool made it
			PRINT_TEXT "%s – clearing it." 33 "The pause records no operation this version knows${STATE_OPERATION:+ ('$STATE_OPERATION')}"
			_ABORT_TAKE_PAUSE
			if [[ "${STATE_WORKTREE:t}" == git-edit-* ]] && _PAUSE_WT_HERE; then
				git worktree remove --force "$STATE_WORKTREE" 2>/dev/null
				rm -rf "$STATE_WORKTREE"
			fi
			_UNREGISTER_GONE_WORKTREE "$STATE_WORKTREE"
			EMIT_STATUS "$(git rev-parse HEAD 2>/dev/null)" "$(_CURRENT_REF)" false
			;;
	esac
	exit 0
fi

# `--undo`, `--status`, `--carry` and `--selftest` are standalone commands – no positionals, no
# mode flags, dispatched before any commit parsing, and stray arguments are refused rather than
# ignored, since `--undo <sha>` would otherwise undo whatever happens to be last
if [ ${#OPT_JOBS} -gt 0 ] && [ ${#OPT_SELFTEST} -eq 0 ]; then
	PRINT_ERR "--jobs only applies to --selftest"
	exit 1
fi
if [ ${#OPT_UNDO} -gt 0 ] || [ ${#OPT_STATUS} -gt 0 ] || [ ${#OPT_CARRY} -gt 0 ] || [ ${#OPT_SELFTEST} -gt 0 ]; then
	if [ $# -gt 0 ]; then
		_USAGE_POINT=1
		PRINT_ERR "--undo/--status/--carry/--selftest take no arguments (got: $*)"
		exit 1
	fi
	# A mode beside one would go unheard – `--land=x --undo` taking back the last run, `ok`, with
	# nothing landed – and so would a second of them
	STANDALONE_GOT=()
	for STRAY_OPT STRAY_ARR in -e OPT_EDIT -m OPT_MESSAGE -M OPT_REWORD -d OPT_DROP -s OPT_SQUASH -S OPT_RESQUASH \
			-C OPT_DIR --exec OPT_EXEC --commit OPT_COMMIT --amend-into OPT_AMEND_INTO --split OPT_SPLIT \
			--reorder OPT_REORDER --onto OPT_ONTO --land OPT_LAND --move OPT_MOVE --text OPT_TEXT \
			--undo OPT_UNDO --status OPT_STATUS --carry OPT_CARRY --selftest OPT_SELFTEST; do
		(( ${#${(P)STRAY_ARR}} )) && STANDALONE_GOT+=("$STRAY_OPT")
	done
	if [ ${#STANDALONE_GOT} -gt 1 ]; then
		_USAGE_POINT=1
		PRINT_ERR "${(j: and :)STANDALONE_GOT} cannot be combined – each is a run of its own, so nothing was done"
		ECHO_E "\e[0;31m  Run them one at a time, each by itself.\e[0m" >&2
		exit 1
	fi
	# None of them waits for a pause – the bound would go unheard
	if [ ${#OPT_WAIT} -gt 0 ]; then
		if [ ${#OPT_UNDO} -gt 0 ]; then
			PRINT_ERR "--undo never waits for a pause – it refuses at once while one stands on the branch it would move, so --wait has nothing to bound and nothing was done"
		else
			PRINT_ERR "${STANDALONE_GOT[1]} never waits for a pause, so --wait has nothing to bound – nothing was done"
		fi
		exit 1
	fi
fi
if [ ${#OPT_UNDO} -gt 0 ]; then
	GIT_UNDO
	exit 0
fi
if [ ${#OPT_STATUS} -gt 0 ]; then
	GIT_STATUS_REPORT
	exit 0
fi
if [ ${#OPT_CARRY} -gt 0 ]; then
	GIT_CARRY "${${OPT_CARRY[1]#--carry}#=}"
	exit 0
fi
if [ ${#OPT_SELFTEST} -gt 0 ]; then
	# The suite is a sibling dir, sourced only here: its scaffolding in the middle of the tool made
	# both harder to read, and every other run should not pay to parse it
	SELFTEST_DIR="${0:A:h}/selftest"
	if [ ! -f "$SELFTEST_DIR/lib.zsh" ]; then
		PRINT_ERR "Selftest suite not found: $SELFTEST_DIR"
		ECHO_E "\e[0;31m  It ships alongside this script – copy it from the repository.\e[0m" >&2
		exit 1
	fi
	# Scenario 88 runs picks of the suite from inside it, one level down – a pick reaching 88 itself
	# would nest without end, each level starting three more
	if (( ${GIT_EDIT_SELFTEST_DEPTH:-0} >= 2 )); then
		PRINT_ERR "A selftest two levels inside another – a pick reached the scenario that runs picks"
		exit 1
	fi
	# `--jobs` hands the suite to units run side by side, ahead of the depth count each of them
	# keeps for itself – `=<n>` at a time, else one a core
	if [ ${#OPT_JOBS} -gt 0 ]; then
		SELFTEST_JOBS=${${OPT_JOBS[1]#--jobs}#=}
		if [ -z "$SELFTEST_JOBS" ]; then
			SELFTEST_JOBS=$(getconf _NPROCESSORS_ONLN 2>/dev/null)
			[[ "$SELFTEST_JOBS" == <1-> ]] || SELFTEST_JOBS=4
		fi
		if [[ "$SELFTEST_JOBS" != <1-> ]]; then
			PRINT_ERR "--jobs takes a count of 1 or more (got: $SELFTEST_JOBS)"
			exit 1
		fi
		_SELFTEST_JOBS "${0:A}" "$SELFTEST_DIR" "${OPT_SELFTEST[1]}" "$SELFTEST_JOBS"
		exit $?
	fi
	export GIT_EDIT_SELFTEST_DEPTH=$(( ${GIT_EDIT_SELFTEST_DEPTH:-0} + 1 ))
	# `--selftest=<pick>` runs those scenarios alone, `--selftest 83` arriving glued as
	# `--selftest83` – the whole suite, a pick of every one, says nothing of what ran
	if [ "${OPT_SELFTEST[1]}" = "--selftest" ]; then
		_SELFTEST_PICK "$SELFTEST_DIR" - || exit 1
		SELFTEST_SCOPE=""
	else
		_SELFTEST_PICK "$SELFTEST_DIR" "${${OPT_SELFTEST[1]#--selftest}#=}" || exit 1
		PRINT_TEXT "Running %s – a commit or a release takes the full suite" 33 "$SELFTEST_SCOPE"
	fi
	source "$SELFTEST_DIR/lib.zsh"
	# ${0:A} resolves the running script's absolute path at top level (inside
	# functions zsh rebinds $0 to the function name)
	GIT_SELFTEST "${0:A}"
	exit $?
fi

# Past this point every path mutates history, and the standalone commands that
# resolve a pause (--continue/--abort/--undo/--status) have already exited –
# which also keeps the sweep off the read-only reporting paths
_GC_ORPHANED_WORKTREES
_GC_KILLED_RUN_WORKTREES
_GC_KILLED_RUN_REFS

# Extract the `-C`/`--dir` value – `zparseopts` with `::` greedily consumes the next word
# unless it starts with `-`, so `git edit -C HEAD~1` would take `HEAD~1` as the path, and
# without an `=` a value parsing as a git ref is re-injected as a positional instead
# Only an `=` right after the flag separates – a path given apart may hold one of its own
if [ ${#OPT_DIR} -gt 0 ]; then
	DIR_HAS_EQUALS=false
	if [[ "${OPT_DIR[1]}" == (-C|--dir)=* ]]; then
		DIR_HAS_EQUALS=true
		WORKTREE_DIR=${OPT_DIR[1]#*=}
	elif [[ "${OPT_DIR[1]}" == "-C"?* ]]; then
		WORKTREE_DIR=${OPT_DIR[1]#-C}
	elif [[ "${OPT_DIR[1]}" == "--dir"?* ]]; then
		WORKTREE_DIR=${OPT_DIR[1]#--dir}
	fi

	if [ "$DIR_HAS_EQUALS" = false ] && [ -n "$WORKTREE_DIR" ]; then
		IS_REF=false
		if [[ "$WORKTREE_DIR" == *".."* && "$WORKTREE_DIR" != *"..."* ]]; then
			git rev-list "$WORKTREE_DIR" >/dev/null 2>&1 && IS_REF=true
		elif git rev-parse --quiet --verify "$WORKTREE_DIR" >/dev/null 2>&1; then
			IS_REF=true
		fi
		if [ "$IS_REF" = true ]; then
			set -- "$WORKTREE_DIR" "$@"
			WORKTREE_DIR=""
		fi
	fi
	# Absolute – the run enters the worktree, where a relative path named something else, and the
	# gate given it found nothing to run in
	[ -n "$WORKTREE_DIR" ] && WORKTREE_DIR=${WORKTREE_DIR:a}
fi

# Extract the `-s`/`--squash` value, applying the same re-injection heuristic as `-C` – its
# argument was once required and greedily consumed the next word, so `-s HEAD~2..HEAD`
# read as a target and errored, where now `-s=<target>` is the only explicit form
if [ ${#OPT_SQUASH} -gt 0 ]; then
	SQUASH_HAS_EQUALS=false
	if [[ "${OPT_SQUASH[1]}" == (-s|--squash)=* ]]; then
		SQUASH_HAS_EQUALS=true
		TARGET=${OPT_SQUASH[1]#*=}
	elif [[ "${OPT_SQUASH[1]}" == "-s"?* ]]; then
		TARGET=${OPT_SQUASH[1]#-s}
	elif [[ "${OPT_SQUASH[1]}" == "--squash"?* ]]; then
		TARGET=${OPT_SQUASH[1]#--squash}
	fi

	if [ "$SQUASH_HAS_EQUALS" = false ] && [ -n "$TARGET" ]; then
		IS_REF=false
		if [[ "$TARGET" == *".."* && "$TARGET" != *"..."* ]]; then
			git rev-list "$TARGET" >/dev/null 2>&1 && IS_REF=true
		elif git rev-parse --quiet --verify "$TARGET" >/dev/null 2>&1; then
			IS_REF=true
		fi
		if [ "$IS_REF" = true ]; then
			set -- "$TARGET" "$@"
			TARGET=""
		fi
	fi
fi

# Conflict checks
if [ ${#OPT_MESSAGE} -gt 0 -a ${#OPT_DROP} -gt 0 ]; then
	_USAGE_POINT=1
	PRINT_ERR "Options -m/--message and -d/--drop cannot be combined"
	exit 1
fi
if [ ${#OPT_DROP} -gt 0 -a ${#OPT_SQUASH} -gt 0 ]; then
	_USAGE_POINT=1
	PRINT_ERR "Options -d/--drop and -s/--squash cannot be combined"
	exit 1
fi
if [ ${#OPT_REWORD} -gt 0 ] && [ ${#OPT_MESSAGE} -gt 0 -o ${#OPT_DROP} -gt 0 -o ${#OPT_SQUASH} -gt 0 -o ${#OPT_DIR} -gt 0 -o ${#OPT_RESQUASH} -gt 0 ]; then
	_USAGE_POINT=1
	PRINT_ERR "Option -M/--reword cannot be combined with -m/-d/-s/-S/-C (reword is message-only and works without touching the working tree)"
	exit 1
fi
if [ ${#OPT_RESQUASH} -gt 0 ] && [ ${#OPT_DROP} -gt 0 -o ${#OPT_SQUASH} -gt 0 -o ${#OPT_DIR} -gt 0 ]; then
	_USAGE_POINT=1
	PRINT_ERR "Option -S/--resquash cannot be combined with -d/-s/-C (resquash uses plumbing only; for non-contiguous squashes use -s with -C)"
	exit 1
fi
if [ ${#OPT_EXEC} -gt 0 ] && [ ${#OPT_MESSAGE} -gt 0 -o ${#OPT_REWORD} -gt 0 -o ${#OPT_DROP} -gt 0 -o ${#OPT_SQUASH} -gt 0 -o ${#OPT_RESQUASH} -gt 0 -o ${#OPT_DIR} -gt 0 -o ${#OPT_AMEND_INTO} -gt 0 -o ${#OPT_SPLIT} -gt 0 -o ${#OPT_REORDER} -gt 0 -o ${#OPT_MOVE} -gt 0 ]; then
	_USAGE_POINT=1
	PRINT_ERR "Option --exec cannot be combined with other modes (--exec is its own mode and manages its own isolated worktree)"
	exit 1
fi
if [ ${#OPT_AMEND_INTO} -gt 0 ] && [ ${#OPT_MESSAGE} -gt 0 -o ${#OPT_REWORD} -gt 0 -o ${#OPT_DROP} -gt 0 -o ${#OPT_SQUASH} -gt 0 -o ${#OPT_RESQUASH} -gt 0 -o ${#OPT_DIR} -gt 0 -o ${#OPT_EXEC} -gt 0 -o ${#OPT_SPLIT} -gt 0 -o ${#OPT_MOVE} -gt 0 ]; then
	_USAGE_POINT=1
	PRINT_ERR "Option --amend-into cannot be combined with -m, -M, -d, -s, -S, -C, --exec, --split or --move (it folds staged changes into <sha> on its own)"
	if [ ${#OPT_REWORD} -gt 0 ]; then
		ECHO_E "\e[0;31m  To fold and reword at once: git edit --amend-into=<sha> --text=\"…\"\e[0m" >&2
		ECHO_E "\e[0;31m  To reword only: git edit -M --text=\"…\" <sha>\e[0m" >&2
	fi
	exit 1
fi
if [ ${#OPT_REORDER} -gt 0 ] && [ ${#OPT_MESSAGE} -gt 0 -o ${#OPT_REWORD} -gt 0 -o ${#OPT_DROP} -gt 0 -o ${#OPT_SQUASH} -gt 0 -o ${#OPT_RESQUASH} -gt 0 -o ${#OPT_DIR} -gt 0 -o ${#OPT_EXEC} -gt 0 -o ${#OPT_AMEND_INTO} -gt 0 -o ${#OPT_SPLIT} -gt 0 -o ${#OPT_MOVE} -gt 0 ]; then
	_USAGE_POINT=1
	PRINT_ERR "Option --reorder cannot be combined with other modes (it manages its own isolated worktree)"
	exit 1
fi
if [ ${#OPT_ONTO} -gt 0 ] && [ ${#OPT_MESSAGE} -gt 0 -o ${#OPT_REWORD} -gt 0 -o ${#OPT_DROP} -gt 0 -o ${#OPT_SQUASH} -gt 0 -o ${#OPT_RESQUASH} -gt 0 -o ${#OPT_DIR} -gt 0 -o ${#OPT_EXEC} -gt 0 -o ${#OPT_AMEND_INTO} -gt 0 -o ${#OPT_SPLIT} -gt 0 -o ${#OPT_REORDER} -gt 0 -o ${#OPT_MOVE} -gt 0 -o -n "$TEXT_VALUE" ]; then
	_USAGE_POINT=1
	PRINT_ERR "Option --onto cannot be combined with other modes (it replays the whole branch, not a named commit)"
	exit 1
fi
# Ahead of every dispatch, as `--exec` and `--commit` dispatch before it would run with it unheard
if [ ${#OPT_LAND} -gt 0 ] && [ ${#OPT_EDIT} -gt 0 -o ${#OPT_MESSAGE} -gt 0 -o ${#OPT_REWORD} -gt 0 -o ${#OPT_DROP} -gt 0 -o ${#OPT_SQUASH} -gt 0 -o ${#OPT_RESQUASH} -gt 0 -o ${#OPT_EXEC} -gt 0 -o ${#OPT_COMMIT} -gt 0 -o ${#OPT_AMEND_INTO} -gt 0 -o ${#OPT_SPLIT} -gt 0 -o ${#OPT_REORDER} -gt 0 -o ${#OPT_MOVE} -gt 0 -o ${#OPT_ONTO} -gt 0 -o ${#OPT_TEXT} -gt 0 ]; then
	_USAGE_POINT=1
	PRINT_ERR "Option --land cannot be combined with other modes or --text (it lands the commits of the branch it names, as they are)"
	exit 1
fi
if [ ${#OPT_MOVE} -eq 0 ] && [ ${#OPT_COMMIT} -eq 0 ] && [ ${#OPT_EXEC} -eq 0 ] && [ ${#OPT_AFTER} -gt 0 -o ${#OPT_BEFORE} -gt 0 ]; then
	_USAGE_POINT=1
	PRINT_ERR "--after/--before only apply to --move, --commit and --exec"
	exit 1
fi
# `-e` names the default mode rather than adding one, so it pairs with `-m` and `-C` as the
# bare form does – every other mode contradicts it
if [ ${#OPT_EDIT} -gt 0 ] && [ ${#OPT_REWORD} -gt 0 -o ${#OPT_DROP} -gt 0 -o ${#OPT_SQUASH} -gt 0 -o ${#OPT_RESQUASH} -gt 0 -o ${#OPT_EXEC} -gt 0 -o ${#OPT_AMEND_INTO} -gt 0 -o ${#OPT_SPLIT} -gt 0 -o ${#OPT_REORDER} -gt 0 -o ${#OPT_MOVE} -gt 0 -o ${#OPT_ONTO} -gt 0 ]; then
	_USAGE_POINT=1
	PRINT_ERR "Option -e/--edit cannot be combined with another mode (it names the default one: edit a single commit's content)"
	exit 1
fi
# `--text` is incompatible with `-d` and `--exec` – the full check against the resolved
# action, implicit squash included, happens after action determination, so it also
# catches `--text` with edit mode
if [ ${#OPT_TEXT} -gt 0 ] && [ ${#OPT_DROP} -gt 0 ]; then
	_USAGE_POINT=1
	PRINT_ERR "Option --text doesn't apply to -d/--drop"
	exit 1
fi
if [ ${#OPT_TEXT} -gt 0 ] && [ ${#OPT_EXEC} -gt 0 ]; then
	_USAGE_POINT=1
	PRINT_ERR "Option --text doesn't apply to --exec"
	exit 1
fi

# `--commit` dispatches ahead of `--exec`, which lands what it composes – its positional args
# being the files to take whole rather than commits
if [ ${#OPT_COMMIT} -gt 0 ]; then
	# The `git commit` habit, where `-m` here asks to edit a past commit's message
	if [ ${#OPT_MESSAGE} -gt 0 ]; then
		PRINT_ERR "--commit takes its message as --text \"…\" – -m is git edit's --message, for a past commit"
		exit 1
	fi
	# Named as given – the fold remedy fits only the `--amend-into` mix-up
	COMMIT_GOT=()
	for STRAY_OPT STRAY_ARR in -e OPT_EDIT -M OPT_REWORD -d OPT_DROP -s OPT_SQUASH -S OPT_RESQUASH -C OPT_DIR \
			--exec OPT_EXEC --amend-into OPT_AMEND_INTO --split OPT_SPLIT --reorder OPT_REORDER --move OPT_MOVE --onto OPT_ONTO; do
		(( ${#${(P)STRAY_ARR}} )) && COMMIT_GOT+=("$STRAY_OPT")
	done
	if [ ${#COMMIT_GOT} -gt 0 ]; then
		_USAGE_POINT=1
		if [ ${#OPT_AMEND_INTO} -gt 0 ]; then
			PRINT_ERR "Option --commit cannot be combined with other modes (got: ${(j: :)COMMIT_GOT}) – folding whole files into a past commit takes --amend-into=<sha> --whole"
		else
			PRINT_ERR "Option --commit cannot be combined with ${(j: :)COMMIT_GOT} – it commits on the checked-out branch's tip, a run of its own"
			ECHO_E "\e[0;31m  Nothing was done – drop ${(j: and :)COMMIT_GOT} to commit, or run the other mode by itself.\e[0m" >&2
		fi
		exit 1
	fi
	if [ "$1" = "--" ]; then
		shift
	fi
	# Files taken whole go beside the inputs, never beside a tree, which is the whole commit
	if [ -n "$AMEND_TREE" ]; then
		if [ $# -gt 0 ]; then
			PRINT_ERR "--commit --tree commits that tree alone – no paths beside it"
			ECHO_E "\e[0;31m  Nothing landed – drop the paths, or drop --tree and take them whole, alone or beside the inputs: git edit --commit --text \"…\" [<input>...] -- <path>...\e[0m" >&2
			exit 1
		fi
	elif ! _INPUTS_GIVEN && [ $# -eq 0 ]; then
		_USAGE_POINT=1
		PRINT_ERR "--commit needs the files to take: git edit --commit --text \"…\" -- <path>..."
		exit 1
	fi
	if [ -z "$TEXT_VALUE" ]; then
		PRINT_ERR "--commit needs a message: --text \"…\", or --text - to read it from stdin"
		exit 1
	fi
	_RESOLVE_PLACE
	[ -n "$AMEND_TREE" ] || [ $# -eq 0 ] || _GUARD_NAMED_PATHS whole "$@"
	_AWAIT_PAUSE _RESOLVE_PLACE "$EXEC_PLACE_ANCHOR"
	GIT_COMMIT_WHOLE "$@"
	PRINT_COMPLETED "$EXEC_NEW_HEAD" "$EXEC_REF" "$EXEC_CHANGED"
	exit 0
fi


# `--exec` short-circuits everything below, its positional args being the wrapped command
# rather than commits – set up an isolated temp worktree, run the command there, and
# update the original branch ref atomically where `HEAD` changed, the raw-git escape hatch
if [ ${#OPT_EXEC} -gt 0 ]; then
	# `zparseopts` does not consume the `--` separator, it just stops parsing at it – strip it
	# so `$@` holds only the wrapped command
	if [ "$1" = "--" ]; then
		shift
	fi
	if [ $# -eq 0 ]; then
		_USAGE_POINT=1
		PRINT_ERR "--exec requires a command (use -- to separate it from flags)"
		exit 1
	fi
	# Two shapes seen in the wild that run something other than what was meant: one quoted
	# shell line, which `"$@"` runs as a program of that name, and a commit ahead of the
	# command, which runs the SHA – neither exists as a program, so name the shape, not a bare 127
	if ! command -v -- "$1" >/dev/null 2>&1; then
		if [ $# -eq 1 ] && [[ "$1" == *[[:space:]]* ]]; then
			PRINT_ERR "'$1' is one argument, run as a program of that name – a shell line goes through the shell: --exec -- sh -c '…'"
			exit 1
		fi
		if _PEEL_SHA "$1" commit >/dev/null; then
			PRINT_ERR "--exec takes no commit – it runs at the tip; to run at ${1:0:7}, add a worktree there (git worktree add --detach <dir> ${1:0:7})"
			exit 1
		fi
	fi
	_RESOLVE_PLACE
	_AWAIT_PAUSE _RESOLVE_PLACE "$EXEC_PLACE_ANCHOR"
	GIT_EXEC "$@"
	if [ -n "$EXEC_DRY_BUILT" ]; then
		EMIT_DRY_RUN "$EXEC_DRY_BUILT" "$EXEC_DRY_BASE" "$EXEC_REF"
		exit 0
	fi
	PRINT_COMPLETED "$EXEC_NEW_HEAD" "$EXEC_REF" "$EXEC_CHANGED" "$EXEC_PEER_MOVE"
	exit 0
fi

# `--move` dispatches early – repositions commits directly after or before an anchor by computing
# the minimal span and desired order, then delegating to the reorder machinery, so span derivation,
# the error-prone part of hand-rolled calls, is owned here
# Each `--move` names a commit or an inclusive run, and several move together as one block in
# their history order, whatever lies between them staying put – in one replay, where a commit at
# a time would replay the span, and verify it under a standing `edit.verifySpan`, once each
if [ ${#OPT_MOVE} -gt 0 ]; then
	MOVE_ARGS=()
	for (( MOVE_I = 2; MOVE_I <= ${#OPT_MOVE}; MOVE_I += 2 )); do
		MOVE_ARGS+=("${OPT_MOVE[$MOVE_I]#=}")
	done
	MOVE_EMPTY=$(( ${#MOVE_ARGS[@]} == 0 ))
	for MOVE_ARG in "${MOVE_ARGS[@]}"; do
		[ -z "$MOVE_ARG" ] && MOVE_EMPTY=1
	done
	if [ $MOVE_EMPTY -eq 1 ]; then
		_USAGE_POINT=1
		PRINT_ERR "--move requires a <sha> value (e.g., --move=abc123)"
		exit 1
	fi
	if [ ${#OPT_MESSAGE} -gt 0 -o ${#OPT_REWORD} -gt 0 -o ${#OPT_DROP} -gt 0 -o ${#OPT_SQUASH} -gt 0 -o ${#OPT_RESQUASH} -gt 0 -o ${#OPT_DIR} -gt 0 -o ${#OPT_EXEC} -gt 0 -o ${#OPT_AMEND_INTO} -gt 0 -o ${#OPT_SPLIT} -gt 0 -o ${#OPT_REORDER} -gt 0 -o -n "$TEXT_VALUE" ]; then
		_USAGE_POINT=1
		PRINT_ERR "Option --move cannot be combined with other modes"
		exit 1
	fi
	if [ ${#OPT_AFTER} -gt 0 ] && [ ${#OPT_BEFORE} -gt 0 ]; then
		PRINT_ERR "--move takes exactly one of --after=<sha> or --before=<sha>, not both"
		exit 1
	fi
	MOVE_ANCHOR=""
	MOVE_KIND=""
	if [ ${#OPT_AFTER} -gt 0 ]; then
		MOVE_ANCHOR="${OPT_AFTER[2]#=}"
		MOVE_KIND="after"
	elif [ ${#OPT_BEFORE} -gt 0 ]; then
		MOVE_ANCHOR="${OPT_BEFORE[2]#=}"
		MOVE_KIND="before"
	fi
	if [ -z "$MOVE_ANCHOR" ]; then
		_USAGE_POINT=1
		PRINT_ERR "--move requires a destination: --after=<sha> or --before=<sha>"
		exit 1
	fi
	if [ $# -gt 0 ]; then
		_USAGE_POINT=1
		PRINT_ERR "--move takes no positional arguments (commits and destination are flag values – several commits go as --move=<a> --move=<b>, a run of commits as --move=<oldest>..<newest>)"
		exit 1
	fi
	if ! _PEEL_SHA "$MOVE_ANCHOR" commit >/dev/null; then
		PRINT_ERR "Unknown <sha>: $MOVE_ANCHOR"
		exit 1
	fi
	PINNED=("$(_PINNED_REV "$MOVE_ANCHOR")")
	for MOVE_ARG in "${MOVE_ARGS[@]}"; do
		PINNED+=("$(_PINNED_REV "$MOVE_ARG")")
	done
	_PLAN_MOVE "$MOVE_ANCHOR" "${MOVE_ARGS[@]}"
	_AWAIT_PAUSE _PLAN_MOVE "${PINNED[@]}"
	if [ ${#MOVE_SET[@]} -eq 1 ]; then
		PRINT_ACTION "Moving %s $MOVE_KIND %s..." "$MOVE_FIRST" "$MOVE_ANCHOR"
	elif [ $MOVE_RUN -eq 1 ]; then
		PRINT_ACTION "Moving ${#MOVE_SET[@]} commits, %s through %s, $MOVE_KIND %s..." "$MOVE_FIRST" "$MOVE_LAST" "$MOVE_ANCHOR"
	else
		PRINT_ACTION "Moving ${#MOVE_SET[@]} commits – ${(j:, :)${(@)MOVE_SET//*/%s}} – $MOVE_KIND %s..." "${MOVE_SET[@]}" "$MOVE_ANCHOR"
	fi
	GIT_REORDER
	PRINT_COMPLETED "$REORDER_NEW_HEAD" "$REORDER_REF" true
	exit 0
fi

# `--land` dispatches here – it lands the commits of the branch its value names on the checked-out
# one, so positional commits would have nothing to name
if [ ${#OPT_LAND} -gt 0 ]; then
	LAND_BRANCH="${OPT_LAND[2]#=}"
	if [ -z "$LAND_BRANCH" ]; then
		_USAGE_POINT=1
		PRINT_ERR "--land requires a branch (e.g., --land=feature)"
		exit 1
	fi
	if [ $# -gt 0 ]; then
		_USAGE_POINT=1
		PRINT_ERR "--land takes no <commit> arguments – it lands the branch its value names (got: $*)"
		exit 1
	fi
	# A name naming nothing refuses before any wait, as the land would after it
	if ! git show-ref --verify -q "refs/heads/$LAND_BRANCH" 2>/dev/null && \
	   ! { PEELED=$(git rev-parse -q --verify --end-of-options "$LAND_BRANCH" 2>/dev/null) && _PEEL_SHA "$PEELED" commit >/dev/null; }; then
		PRINT_ERR "Unknown branch: $LAND_BRANCH – nothing landed"
		ECHO_E "\e[0;31m  Name one this repository has – 'git branch --list' shows them.\e[0m" >&2
		exit 1
	fi
	_AWAIT_PAUSE
	GIT_LAND
	PRINT_COMPLETED "$LAND_NEW_HEAD" "$LAND_REF" true "nothing landed"
	exit 0
fi

# --onto dispatches immediately: it acts on the current branch as a whole, so
# positional commits would have nothing to name
if [ ${#OPT_ONTO} -gt 0 ]; then
	if [[ ${#OPT_ONTO} -gt 1 && -n "${OPT_ONTO[2]}" ]]; then
		ONTO_UPSTREAM="${OPT_ONTO[2]#=}"
	fi
	if [ -z "$ONTO_UPSTREAM" ]; then
		_USAGE_POINT=1
		PRINT_ERR "--onto requires an upstream (e.g., --onto=main)"
		exit 1
	fi
	if [ $# -gt 0 ]; then
		_USAGE_POINT=1
		PRINT_ERR "--onto takes no <commit> arguments – it replants the current branch"
		exit 1
	fi
	# A name naming nothing refuses before any wait, as the replant would after it
	if ! ONTO_PINNED=$(_PEEL_SHA "$ONTO_UPSTREAM" commit); then
		PRINT_ERR "Unknown upstream: $ONTO_UPSTREAM"
		exit 1
	fi
	# A branch is taken as it stands once the wait is over – any other name, as `HEAD~3` or
	# `main@{1}`, as it stood when the run began, by its SHA where a landing moved what it names
	[[ "$(git rev-parse --symbolic-full-name "$ONTO_UPSTREAM" 2>/dev/null)" == refs/(heads|remotes)/* ]] && ONTO_PINNED=""
	# One on the branch's own line that a landing then rewrote resolves as any stale SHA does, or
	# refuses – replanted onto the orphan, the branch would drop the rewrite as already upstream
	ONTO_ON_LINE=""
	[ -n "$ONTO_PINNED" ] && git merge-base --is-ancestor "$ONTO_PINNED" HEAD 2>/dev/null && ONTO_ON_LINE=1
	_AWAIT_PAUSE
	if [ -n "$ONTO_ON_LINE" ] && ! git merge-base --is-ancestor "$ONTO_PINNED" HEAD 2>/dev/null; then
		_GUARD_REACHABLE "$ONTO_PINNED" Upstream
		ONTO_PINNED=$_RESOLVED_SHA
	fi
	[ -n "$ONTO_PINNED" ] && [ "$(_PEEL_SHA "$ONTO_UPSTREAM" commit)" != "$ONTO_PINNED" ] && ONTO_UPSTREAM=$ONTO_PINNED
	GIT_ONTO
	PRINT_COMPLETED "$ONTO_NEW_HEAD" "$ONTO_REF" true
	exit 0
fi

# `--amend-into` dispatches immediately too – the target SHA came from the flag's value
# rather than positional args, which this mode leaves unused since the content comes
# from the staged index in main
if [ ${#OPT_AMEND_INTO} -gt 0 ]; then
	if [[ ${#OPT_AMEND_INTO} -gt 1 && -n "${OPT_AMEND_INTO[2]}" ]]; then
		AMEND_INTO_TARGET="${OPT_AMEND_INTO[2]#=}"
	fi
	if [ -z "$AMEND_INTO_TARGET" ]; then
		_USAGE_POINT=1
		PRINT_ERR "--amend-into requires a <sha> value (e.g., --amend-into=abc123)"
		exit 1
	fi
	# Positional args narrow which staged paths get folded, the rest staying staged – without
	# them the whole index folds, as before
	if [ "$1" = "--" ]; then
		shift
	fi
	AMEND_PATHSPECS=("$@")
	if [ ${#OPT_WHOLE} -gt 0 ] && [ ${#AMEND_PATHSPECS[@]} -eq 0 ]; then
		_USAGE_POINT=1
		PRINT_ERR "--whole needs the files to take: git edit --amend-into=<sha> --whole -- <path>..."
		exit 1
	fi
	# Paths alone name staged changes – beside the inputs only --whole says to take them from the
	# checkout
	if [ ${#OPT_WHOLE} -eq 0 ] && _INPUTS_GIVEN && [ ${#AMEND_PATHSPECS[@]} -gt 0 ]; then
		PRINT_ERR "--amend-into takes staged paths or the inputs – the inputs name their own paths, and files folded whole beside them take --whole"
		ECHO_E "\e[0;31m  Nothing landed – drop the paths to fold the inputs alone, or add --whole to fold those files whole from the checkout beside them: git edit --amend-into=<sha> --whole <input>... -- <path>...\e[0m" >&2
		exit 1
	fi
	# The target pinned by SHA before any wait – `auto` picks its
	# commit once the run goes on, from the tip it runs on
	if [ "$AMEND_INTO_TARGET" != auto ]; then
		if ! PEELED=$(_PEEL_SHA "$AMEND_INTO_TARGET" commit); then
			PRINT_ERR "Unknown <sha>: $AMEND_INTO_TARGET"
			exit 1
		fi
		_GUARD_REACHABLE "$PEELED"
		AMEND_INTO_TARGET=$_RESOLVED_SHA
		_GUARD_UNPUSHED "$AMEND_INTO_TARGET"
	fi
	if [ ${#OPT_WHOLE} -gt 0 ]; then
		_GUARD_NAMED_PATHS whole "${AMEND_PATHSPECS[@]}"
	elif ! _INPUTS_GIVEN && [ -z "$AMEND_TREE" ] && [ ${#AMEND_PATHSPECS[@]} -gt 0 ]; then
		_GUARD_NAMED_PATHS staged "${AMEND_PATHSPECS[@]}"
	fi
	_AWAIT_PAUSE
	# Whole files compose the `--tree` themselves, from the checkout – pinned to the tip they read
	if [ ${#OPT_WHOLE} -gt 0 ] && ! _INPUTS_GIVEN; then
		_COMPOSE_WHOLE "${AMEND_PATHSPECS[@]}"
		_WHOLE_WHAT="Folded whole"
		_GUARD_WHOLE_MARKERS
		_GUARD_WHOLE
		AMEND_TREE=$(git commit-tree "$WHOLE_TREE" -p "$WHOLE_HEAD" -m "git edit: whole files composed on ${WHOLE_HEAD:0:7}" </dev/null)
		AMEND_PATHSPECS=()
		for WHOLE_PATH in "${WHOLE_PATHS[@]}"; do
			AMEND_PATHSPECS+=(":(top,literal)$WHOLE_PATH")
		done
	# The inputs compose it too, on the tip, as a new commit's are, files taken whole beside them –
	# a flip `--chmod` named is meant
	elif _INPUTS_GIVEN; then
		_COMPOSE_INPUTS fold "${AMEND_PATHSPECS[@]}"
		_GUARD_WHOLE_MARKERS "from the inputs"
		AMEND_TREE=$(git commit-tree "$WHOLE_TREE" -p "$WHOLE_HEAD" -m "git edit: inputs composed on ${WHOLE_HEAD:0:7}" </dev/null)
		AMEND_PATHSPECS=()
		for WHOLE_PATH in "${WHOLE_PATHS[@]}"; do
			AMEND_PATHSPECS+=(":(top,literal)$WHOLE_PATH")
		done
		(( _INPUT_FLIPS )) && OPT_ALLOW_MODE_CHANGE=(--allow-mode-change)
	fi
	# The fold's source, as `git diff` reads it – the staged index, or a `--tree` composed apart
	# from it against `HEAD`, where a commit given pins the tip it was composed on, so a tip
	# that moved since is refused rather than have the diff carry a newer commit's reversal
	AMEND_SOURCE=(--cached --ignore-submodules=none)
	if [ -n "$AMEND_TREE" ]; then
		# Messages name the value as given – a full SHA shortened, anything else verbatim – where
		# the plumbing takes the resolved tree, whose SHA the caller never typed
		AMEND_TREE_GIVEN=$AMEND_TREE
		[[ "$AMEND_TREE_GIVEN" =~ '^[0-9a-f]{40,64}$' ]] && AMEND_TREE_GIVEN=${AMEND_TREE_GIVEN:0:7}
		TREE_BASE=$(git rev-parse --quiet --verify "$(_PEEL_SHA "$AMEND_TREE" commit)^" 2>/dev/null)
		TREE_SHA=$(_PEEL_SHA "$AMEND_TREE" tree)
		if [ -z "$TREE_SHA" ]; then
			PRINT_ERR "Unknown <tree-ish>: $AMEND_TREE"
			exit 1
		fi
		if [ -n "$TREE_BASE" ] && [ "$TREE_BASE" != "$(git rev-parse HEAD)" ]; then
			_TREE_MOVED "$(git rev-parse HEAD)"
		fi
		AMEND_TREE=$TREE_SHA
		AMEND_SOURCE=(--ignore-submodules=none HEAD "$AMEND_TREE")
	fi
	# A path named with pattern characters is that path, not a pattern taking a peer's staging – read
	# against the `--tree` where one is given, by its SHA, as a `:/<text>` would join the path
	if [ ${#OPT_WHOLE} -eq 0 ] && ! _INPUTS_GIVEN && [ ${#AMEND_PATHSPECS[@]} -gt 0 ]; then
		_LITERAL_FIRST "${${AMEND_TREE:+tree:$AMEND_TREE}:-index}" "${AMEND_PATHSPECS[@]}"
		AMEND_PATHSPECS=("${reply[@]}")
	fi
	# `auto` resolves to the newest unpushed commit touching the folded paths
	if [ "$AMEND_INTO_TARGET" = "auto" ]; then
		_RESOLVE_AMEND_TARGET
	fi
	# Verify target is a valid commit ref
	if ! PEELED=$(_PEEL_SHA "$AMEND_INTO_TARGET" commit); then
		PRINT_ERR "Unknown <sha>: $AMEND_INTO_TARGET"
		exit 1
	fi
	AMEND_INTO_TARGET=$PEELED
	if (( _INPUT_WHOLE )); then
		PRINT_ACTION "Amending ${#WHOLE_PATHS} file(s), $_INPUT_WHOLE of them whole, into %s..." "$AMEND_INTO_TARGET"
	elif [ ${#OPT_WHOLE} -gt 0 ]; then
		PRINT_ACTION "Amending ${#WHOLE_PATHS} whole file(s) into %s..." "$AMEND_INTO_TARGET"
	elif _INPUTS_GIVEN; then
		PRINT_ACTION "Amending ${#WHOLE_PATHS} file(s) into %s..." "$AMEND_INTO_TARGET"
	elif [ -n "$AMEND_TREE" ]; then
		PRINT_ACTION "Amending --tree $AMEND_TREE_GIVEN into %s..." "$AMEND_INTO_TARGET"
	else
		PRINT_ACTION "Amending staged changes into %s..." "$AMEND_INTO_TARGET"
	fi
	GIT_AMEND_INTO
	PRINT_COMPLETED "$AMEND_NEW_HEAD" "$AMEND_REF" true
	exit 0
fi

# --split dispatches early as well: positional args are pathspecs, not commits
if [ ${#OPT_SPLIT} -gt 0 ]; then
	if [[ ${#OPT_SPLIT} -gt 1 && -n "${OPT_SPLIT[2]}" ]]; then
		SPLIT_TARGET="${OPT_SPLIT[2]#=}"
	fi
	if [ -z "$SPLIT_TARGET" ]; then
		_USAGE_POINT=1
		PRINT_ERR "--split requires a <sha> value (e.g., --split=abc123)"
		exit 1
	fi
	if [ ${#OPT_MESSAGE} -gt 0 -o ${#OPT_REWORD} -gt 0 -o ${#OPT_DROP} -gt 0 -o ${#OPT_SQUASH} -gt 0 -o ${#OPT_RESQUASH} -gt 0 -o ${#OPT_DIR} -gt 0 -o ${#OPT_EXEC} -gt 0 -o ${#OPT_AMEND_INTO} -gt 0 -o ${#OPT_REORDER} -gt 0 ]; then
		_USAGE_POINT=1
		PRINT_ERR "Option --split cannot be combined with other modes"
		exit 1
	fi
	if [ "$1" = "--" ]; then
		shift
	fi
	if ! PEELED=$(_PEEL_SHA "$SPLIT_TARGET" commit); then
		PRINT_ERR "Unknown <sha>: $SPLIT_TARGET"
		exit 1
	fi
	SPLIT_TARGET=$PEELED
	if [ $# -gt 0 ] && [ -z "$TEXT_VALUE" ]; then
		PRINT_ERR "--split requires --text for the extracted commit's message"
		exit 1
	fi
	_SPLIT_GUARDS "$SPLIT_TARGET"
	SPLIT_TARGET=$_RESOLVED_SHA
	[ $# -gt 0 ] && _GUARD_NAMED_PATHS "split=$SPLIT_TARGET" "$@"
	_AWAIT_PAUSE
	# No pathspec means the halves aren't separable by path – pause and let the
	# caller author the split point instead of demanding one that can't exist
	if [ $# -eq 0 ]; then
		GIT_SPLIT_PAUSE
	fi
	PRINT_ACTION "Splitting %s..." "$SPLIT_TARGET"
	GIT_SPLIT "$@"
	PRINT_COMPLETED "$SPLIT_NEW_HEAD" "$SPLIT_REF" true
	exit 0
fi

COMMITS=()

if [ $# -eq 0 ]; then
	# Records-mode reword – `--- <commit>` messages on stdin or `--text`, targets named inline
	# rather than positionally, detected before the missing-target error since this is the
	# one action carrying its commits in the text
	if [ ${#OPT_REWORD} -gt 0 ] && _LOOKS_LIKE_RECORDS "$RAW_TEXT_VALUE"; then
		_PIN_RECORDS
		_AWAIT_PAUSE
		PRINT_ACTION "Rewording commits from records..."
		GIT_REWORD_BATCH
		PRINT_COMPLETED "$(git rev-parse HEAD)" "$(_CURRENT_REF)" true
		exit 0
	fi

	# A bare `git edit` is a request for help, and the usage block already makes the required
	# `<commit>` obvious – but with a mode flag given the caller meant to do something and
	# only left the target off, so name that rather than printing a screen of usage
	if [ ${#OPT_REWORD} -gt 0 -o ${#OPT_DROP} -gt 0 -o ${#OPT_SQUASH} -gt 0 -o ${#OPT_RESQUASH} -gt 0 -o -n "$TEXT_VALUE" -o -n "$SUBJECT_VALUE" ]; then
		# The records form's one shape mistake seen in the wild: two-dash headers, which read
		# as records to their author and as nothing to the detector above
		if [ ${#OPT_REWORD} -gt 0 ] && grep -q -E '^-- [0-9a-f]{7,}' <<<"$RAW_TEXT_VALUE"; then
			PRINT_ERR "Records start with '--- <commit>' – three dashes, and these headers carry two"
			exit 1
		fi
		# A drop or squash names no example commit, as the tip is rarely the one meant there
		if [ ${#OPT_REWORD} -eq 0 ] && [ ${#OPT_DROP} -gt 0 -o ${#OPT_SQUASH} -gt 0 -o ${#OPT_RESQUASH} -gt 0 ]; then
			local MODE_FLAG=-d
			[ ${#OPT_SQUASH} -gt 0 ] && MODE_FLAG=${OPT_SQUASH[1]}
			[ ${#OPT_RESQUASH} -gt 0 ] && MODE_FLAG=-S
			PRINT_ERR "Missing <commit> – name the commit to act on (e.g. 'git edit $MODE_FLAG <sha>'), and nothing was done"
			exit 1
		fi
		# The retry for this is always the tip, so name it by SHA – a parallel session's commit
		# landing in the gap is exactly how a reword reaches the wrong one, and the CAS covers
		# the ref moving mid-run, not the wrong commit being named
		local HEAD_LINE=$(git log -1 --format='%h %s' 2>/dev/null)
		local MSG_FLAG=--text
		[ -n "$SUBJECT_VALUE" ] && MSG_FLAG=--subject
		PRINT_ERR "Missing <commit> – name the commit to act on (e.g. 'git edit -M $MSG_FLAG=\"…\" ${${HEAD_LINE%% *}:-HEAD}')"
		if [ -n "$HEAD_LINE" ]; then
			ECHO_E "\e[0;31m  HEAD is currently ${HEAD_LINE//\\/$_LITB}\e[0m" >&2
		fi
		exit 1
	fi
	USAGE
	PRINT_ERR "Missing <commit> or mode – the usage above lists both, and nothing was done"
	exit 1
fi

if [ ${#OPT_REORDER} -gt 0 ] && (( ${#${(M)@:#*..*}} )); then
	PRINT_ERR "--reorder takes single commits in the desired order (no ranges)"
	exit 1
fi

# Parse/expand arguments (commits or ranges)
for ARG in "$@"; do
	# A `--` ahead of the commits only marks where the flags end
	[ "$ARG" = "--" ] && continue
	# Check if the argument is a standard ".." range (excluding "..." symmetric diff)
	if [[ "$ARG" == *".."* && "$ARG" != *"..."* ]]; then
		local S="${${ARG%%..*}:-HEAD}"
		local E="${${ARG#*..}:-HEAD}"

		# Both ends name commits – an unknown start read like the root commit's missing parent below,
		# the range then taking all history up to its end
		_GUARD_RANGE_END "$ARG" start "$S"
		S=$_RESOLVED_SHA
		_GUARD_RANGE_END "$ARG" end "$E"
		E=$_RESOLVED_SHA
		# One end a rewrite staled resolves as a single commit does – with both stale, the range is
		# taken as named and each commit in it resolved alone below, as the span between their current
		# identities can hold a commit a peer moved in since, which the run would then take too
		if git merge-base --is-ancestor "$S" HEAD 2>/dev/null || git merge-base --is-ancestor "$E" HEAD 2>/dev/null; then
			_GUARD_REACHABLE "$S" "Invalid commit range: $ARG – its start"
			S=$_RESOLVED_SHA
			_GUARD_REACHABLE "$E" "Invalid commit range: $ARG – its end"
			E=$_RESOLVED_SHA
		fi
		# Swap if reversed (newer..older)
		git merge-base --is-ancestor "$E" "$S" 2>/dev/null && { local T="$S"; S="$E"; E="$T"; }
		if ! git merge-base --is-ancestor "$S" "$E" 2>/dev/null; then
			PRINT_ERR "Invalid commit range: $ARG – its ends ${S:0:7} and ${E:0:7} are not on one line of history"
			exit 1
		fi

		# Determine range string (inclusive)
		local RANGE="$E"
		git rev-parse -q --verify "$S^" >/dev/null && RANGE="$S^..$E"

		# Validate and append
		if ! git rev-list "$RANGE" >/dev/null 2>&1; then
			PRINT_ERR "Invalid commit range: $ARG"
			exit 1
		fi
		COMMITS+=($(git rev-list "$RANGE"))
	else
		# Handle single commits
		if ! git rev-parse --quiet --verify "$ARG" >/dev/null 2>&1; then
			PRINT_ERR "Unknown <commit>: $ARG"
			# A message passed where the commit goes – the mistake every mode
			# that takes both invites, and nothing about "unknown commit" hints
			# at the real fix
			if [[ "$ARG" == *" "* ]]; then
				ECHO_E "\e[0;31m  That looks like a message – pass it as --text \"…\" and give the commit separately.\e[0m" >&2
			fi
			exit 1
		fi
		# Peeled by SHA – a `^{commit}` after a `:/<text>` search would join its text – where an object
		# exists, as a full SHA passes for one that doesn't
		ARG_SHA=$(git rev-parse --quiet --verify "$ARG")
		ARG_KIND=$(git cat-file -t "$ARG_SHA" 2>/dev/null)
		if [ -n "$ARG_KIND" ] && ! git rev-parse --quiet --verify "$ARG_SHA^{commit}" >/dev/null 2>&1; then
			PRINT_ERR "<commit> $ARG names a $ARG_KIND, not a commit"
			exit 1
		fi
		COMMITS+=("$ARG_SHA")
	fi
done

# Abort if no commits were found
if [ ${#COMMITS[@]} -eq 0 ]; then
	PRINT_ERR "No valid commits found."
	exit 1
fi

# Decided on the commits as named, then again on their SHAs where a wait for another caller's pause
# moved the tip – every refusal an argument earns comes before that wait
PINNED=("$(_PINNED_REV "$TARGET")" "${COMMITS[@]}")
_RESOLVE_ACTION "${PINNED[@]}"
_AWAIT_PAUSE _RESOLVE_ACTION "${PINNED[@]}"


# ------------------------------------------- CORE LOGIC -------------------------------------------

# Reword and resquash take a plumbing-only path that never touches the working tree, the
# index or any other worktree state – the affected commits and their descendants are
# rebuilt via `git commit-tree` and applied with a single atomic `git update-ref`
if [[ "$ACTION" == "reword" ]]; then
	PRINT_ACTION "Rewording %s..." "$COMMIT"
	GIT_REWORD
	PRINT_COMPLETED "$(git rev-parse HEAD)" "$(_CURRENT_REF)" true
	exit 0
fi
if [[ "$ACTION" == "resquash" ]]; then
	PRINT_ACTION "Resquashing %s into %t" "${COMMITS[1]}" "${COMMITS[@]:#${COMMITS[1]}}"
	_CONFIRM_REWRITE
	GIT_RESQUASH
	PRINT_COMPLETED "$(git rev-parse HEAD)" "$(_CURRENT_REF)" true
	exit 0
fi
if [[ "$ACTION" == "reorder" ]]; then
	PRINT_ACTION "Reordering to %s" "${COMMITS_DESIRED[@]}"
	GIT_REORDER
	PRINT_COMPLETED "$REORDER_NEW_HEAD" "$REORDER_REF" true
	exit 0
fi

# A drop, edit or squash runs in its own worktree, so a session sharing the checkout never finds
# files moving or a rebase halfway, and lands on a branch, which a detached `HEAD` lacks
ORIG_BRANCH=${$(git symbolic-ref -q HEAD 2>/dev/null)#refs/heads/}
if [ -z "$ORIG_BRANCH" ]; then
	PRINT_ERR "$ACTION requires being on a branch (got detached HEAD)"
	ECHO_E "\e[0;31m  Make one where you are first: git switch -c <name>\e[0m" >&2
	exit 1
fi
ORIG_HEAD=$(git rev-parse HEAD)
_REQUIRE_IN_TIP "$ORIG_HEAD" "${COMMITS[@]}" "$TARGET"

# An edit pauses with a worktree at the commit – the caller edits its content there, and
# `--continue` amends, replays and lands it, while a person at a terminal answers its prompt
if [[ "$ACTION" == "edit" ]]; then
	EDIT_TARGET=$(git rev-parse "$COMMIT^{commit}")
	PRINT_ACTION "Editing %s..." "$EDIT_TARGET"
	_PREPARE_RUN_WORKTREE "$EDIT_TARGET" git-edit-edit
	# The cleanup hook holds the worktree until the pause is recorded,
	# as a parallel run's may take the slot first
	_SAVE_STATE "operation=edit" "worktree=$WORKTREE_DIR" "wt_ours=$WT_OURS" "branch=refs/heads/$ORIG_BRANCH" \
		"orig_head=$ORIG_HEAD" "target=$EDIT_TARGET" "maindir=$(git rev-parse --show-toplevel)" \
		"message=${OPT_MESSAGE:+editor}"
	_CLEANUP_HOOK=""
	PRINT_TEXT "Worktree at the commit: %s" 33 "$WORKTREE_DIR"
	_IS_NON_INTERACTIVE && PRINT_TEXT "Make your changes there, then %s (add %s to also reword, or %s for the subject alone) – or cancel via %s." 33 "git edit --continue" '--text "…"' '--subject "…"' "git edit --abort"
	EMIT_PAUSED edit "$EDIT_TARGET" "$WORKTREE_DIR"
	_PAUSE_EXIT 2 edit
fi

# Every commit dropped leaves nothing to land – git's rebase would put a placeholder there
if [[ "$ACTION" == "drop" ]] && (( $(print -rl -- "${COMMITS[@]}" | sort -u | wc -l) >= $(git rev-list --count "$ORIG_HEAD") )); then
	PRINT_ERR "Dropping every commit of $ORIG_BRANCH leaves it none – nothing was changed"
	ECHO_E "\e[0;31m  To start it over, check out another branch and delete this one.\e[0m" >&2
	exit 1
fi

if [[ "$ACTION" == "drop" ]]; then
	PRINT_ACTION "Dropping %s" "${COMMITS[@]}"
else
	PRINT_ACTION "Merging %s -> %t" "$TARGET" "${COMMITS[@]:#$TARGET}"
fi
_CONFIRM_REWRITE
_PREPARE_RUN_WORKTREE "$ORIG_HEAD" git-edit-auto-iso
cd "$WORKTREE_DIR" || { PRINT_ERR "Cannot enter $WORKTREE_DIR"; exit 1; }
if [[ "$ACTION" == "drop" ]]; then
	GIT_REBASE_DROP
else
	GIT_REBASE_SQUASH
fi
_LAND_REBASE "$WORKTREE_DIR" "refs/heads/$ORIG_BRANCH" "$ORIG_HEAD" "$ACTION" "$COMMIT" "$TARGET" "${COMMITS[@]}"
PRINT_COMPLETED "$(git rev-parse "refs/heads/$ORIG_BRANCH")" "refs/heads/$ORIG_BRANCH" true
