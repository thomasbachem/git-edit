# A switch set to 0, false, no or off is off, as most tools read one
for _V in GIT_EDIT_NO_AUTO_OPEN GIT_EDIT_NO_RESOLVE GIT_EDIT_NO_REPLAY GIT_EDIT_PROGRESS; do
	[[ "${(P)_V:l}" == (0|false|no|off) ]] && unset $_V
done
unset _V

# Released version – bumped together with the `v<version>` tag it ships under
GIT_EDIT_VERSION="1.8.0"

# Suspend background maintenance for this process and every git it spawns – from git 2.54
# `rerere gc` runs detached per commit, and its `MERGE_RR.lock` kills a rebase reaching its
# next conflict, wedging every later continue on "you have staged changes" – and keep what the
# script parses as it reads it, a non-ASCII path as itself (its quoted form names no file), no
# signature lines in a `git log`, a full `pick <7 hex>` in todo lines, paths from the top, and
# messages and names in the encoding a rebuilt commit is written in, the repo's commit encoding
# Appended to what `git -c` passes, which outranks every other source – a caller's own `-c` and
# `GIT_CONFIG_COUNT` included, so a pin there would lose to both
# Its own rebases add `--no-autosquash` and an empty `rebase.instructionFormat` instead, as a
# caller's autosquash folds another's `fixup!` into the span and a pin reaches `--exec` commands
# The caller's own value is kept for the run a terminal pause resumes in
# Each entry single-quoted as git reads that list, a quote in the repo's encoding closed and
# reopened, so a value holding one stays one entry
_CALLER_GCP=$GIT_CONFIG_PARAMETERS _CALLER_GCP_SET=${GIT_CONFIG_PARAMETERS+1}
_V=$(git config --get i18n.commitEncoding 2>/dev/null)
for _K _V in maintenance.auto false gc.auto 0 core.quotePath false log.showSignature false \
		rebase.abbreviateCommands false core.abbrev 7 diff.relative false i18n.logOutputEncoding "${_V:-UTF-8}"; do
	GIT_CONFIG_PARAMETERS+="${GIT_CONFIG_PARAMETERS:+ }'$_K=${_V//\'/'\\''}'"
done
export GIT_CONFIG_PARAMETERS
unset _K _V
# Pathspec semantics are git-edit's own – a caller's glob setting refuses the `:(literal)` names
# it passes, a literal one reads them as file names – and so are its diffs and greps, which
# `GIT_DIFF_OPTS` widens past `-U0` and `GREP_OPTIONS` colors on BSD, kept for the caller's commands
for _V in GIT_GLOB_PATHSPECS GIT_NOGLOB_PATHSPECS GIT_ICASE_PATHSPECS GIT_LITERAL_PATHSPECS GIT_DIFF_OPTS GREP_OPTIONS; do
	[ -n "${(P)_V+set}" ] && _CALLER_ENV+=("$_V=${(P)_V}")
done
unset _V GIT_GLOB_PATHSPECS GIT_NOGLOB_PATHSPECS GIT_ICASE_PATHSPECS GIT_LITERAL_PATHSPECS GIT_DIFF_OPTS GREP_OPTIONS

# Exports the caller's own settings again, in the subshell of a command run on their behalf – an
# `--exec` command or a verify check – and drops `pipefail`, which a check's `| head` would trip
_CALLER_ENV_BACK () {
	set +o pipefail
	[ ${#_CALLER_ENV} -eq 0 ] || export "${_CALLER_ENV[@]}"
}

# As `_CALLER_ENV_BACK`, git-edit's config pins out too – for an editor, which an app started cold
# keeps for every git it later runs
_CALLER_ENV_FULL () {
	unset GIT_CONFIG_PARAMETERS
	[ -n "$_CALLER_GCP_SET" ] && export GIT_CONFIG_PARAMETERS=$_CALLER_GCP
	_CALLER_ENV_BACK
}

# Prints `_CALLER_ENV_FULL` as `sh` lines, for an editor git starts in a stand-in
_CALLER_ENV_SH () {
	local KV
	print -r -- "unset GIT_CONFIG_PARAMETERS"
	[ -n "$_CALLER_GCP_SET" ] && print -r -- "GIT_CONFIG_PARAMETERS=${(qq)_CALLER_GCP}; export GIT_CONFIG_PARAMETERS"
	for KV in "${_CALLER_ENV[@]}"; do print -r -- "${KV%%=*}=${(qq)${KV#*=}}; export ${KV%%=*}"; done
}

# The script itself, for the run a terminal pause resumes in – resolved now, as `$0` names the
# function inside one – and the pause such a resume is for, which reaches nothing it runs
_SELF=${0:A}
_EXPECT_PAUSE=$GIT_EDIT_EXPECT_PAUSE
unset GIT_EDIT_EXPECT_PAUSE

# A relative `TMPDIR` taken from where the run starts – a worktree's git would resolve it in there,
# an editor stand-in's path naming nothing, and one opening with `-` reads to `mktemp` as an option
if [[ -n "$TMPDIR" && "$TMPDIR" != /* ]]; then
	TMPDIR=${TMPDIR:A}
fi

# Cap on the commits a stale SHA's resolution computes a patch id for – the author date
# filter ahead of it normally leaves a handful, so this only bites on imported or scripted
# history sharing one second, where a match stops being unique and degrades to a suggestion
RESOLVE_SCAN_MAX=100

# Blank-line padding reads well in a terminal, but a caller piping through `| tail -N` – how
# most agent runs consume this – loses a line of summary to each, so pad only for a terminal
_PAD=""
[ -t 1 ] && _PAD=$'\n'

# Same reasoning for color: escapes read as emphasis in a terminal but as noise in a
# captured run, where they also split literal text a caller greps for – honors `NO_COLOR`
# and `TERM=dumb` alongside the pipe check
_COLOR=true
if [ ! -t 1 ] || [ -n "$NO_COLOR" ] || [ "$TERM" = "dumb" ]; then
	_COLOR=false
fi

# Gutter colors for the excerpt streams (`git show`/`git log` output piped
# through `sed`, which can't route through `ECHO_E`) – empty when color is off,
# so one `sed` script serves both cases
_DIM=$'\e[0;90m'
_RED=$'\e[0;31m'
_OFF=$'\e[0m'
if [ "$_COLOR" != "true" ]; then
	_DIM=""
	_RED=""
	_OFF=""
fi

# Puts <text> into `REPLY` with each raw control byte in caret notation, tabs and newlines kept – a
# subject's or path's, never a template's, so a crafted one can't clear the screen or set a title
_CARET () {
	# Args: <text> [<backslash>] – what `^\` takes for its backslash, `ECHO_E` passing its data mark
	# so the caret starts no escape there
	# Bytes, whatever the locale – a C1 control is a 2-byte UTF-8 pair there
	local LC_ALL=C
	REPLY=$1
	[[ "$REPLY" == *[$'\001'-$'\010'$'\013'-$'\037'$'\177']* || "$REPLY" == *$'\302'* ]] || return 0
	# A substitution per byte present, as a pass per character slows to seconds on a long line
	local -i c
	local K
	for (( c = 1; c <= 31; c++ )); do
		(( c == 9 || c == 10 )) && continue
		[[ "$REPLY" == *${(#)c}* ]] || continue
		K=${(#)$(( c + 64 ))}
		REPLY=${REPLY//${(#)c}/^${K/\\/${2:-\\}}}
	done
	REPLY=${REPLY//$'\177'/^?}
	# C1 controls, U+0080–U+009F, which a terminal may run as much – as `cat -v` shows their bytes
	# Gated on the lead byte alone – a byte range past ASCII matches nothing in Linux's zsh
	[[ "$REPLY" == *$'\302'* ]] || return 0
	for (( c = 128; c <= 159; c++ )); do
		[[ "$REPLY" == *$'\302'${(#)c}* ]] || continue
		K=${(#)$(( c - 64 ))}
		REPLY=${REPLY//$'\302'${(#)c}/M-BM-^${K/\\/${2:-\\}}}
	done
}

# Prints the closing status line verbatim and on one line, whatever a name or message in it holds
_EMIT_TRAILER () {
	# Args: <line>
	# A pause another run ended under this one is no pause to name
	[[ "$1" == "git-edit: "(conflict|paused)* ]] && _REQUIRE_OWN_PAUSE
	# A run that landed and ends well has re-synced what its move stranded
	[[ "$1" == "git-edit: ok"* ]] && (( ${#${=_JOURNALED_MOVE}} == 3 )) && _RESYNC_MARK_DONE ${=_JOURNALED_MOVE}
	# Its checkout's sync done by now, whatever is left to say
	[ -n "$_SYNC_HELD" ] && _SYNC_HOLD_RELEASE
	# Rerere's notes first, so the trailer stays last – only where no pause keeps the scope open
	if [ -n "$_RERERE_SCOPE_OWNED" ] && [ ! -f "$_RERERE_STATE_FILE" ]; then
		[[ "$1" == "git-edit: ok"* ]]
		_RERERE_SCOPE_END $?
		_RERERE_SCOPE_OWNED=""
	fi
	_CARET "${1//$'\n'/ }"
	print -r -- "$REPLY"
	# The status a signal from here on exits with, so the code still says what the trailer does
	case $1 in
		"git-edit: ok"*)                 _TRAILER_CODE=0 ;;
		"git-edit: "(conflict|paused)*) _TRAILER_CODE=2 ;;
		*)                               _TRAILER_CODE=1 ;;
	esac
	# `--status` names a pause, ending 0 all the same
	[ ${#OPT_STATUS} -gt 0 ] && _TRAILER_CODE=0
	return 0
}

# The byte a data backslash is held as on its way through `ECHO_E` – a NUL, which no name, subject
# or template holds, in a name since `$'…'` quoting does not reach inside double quotes
_LITB=$'\0'

# Prints <text> marked as data for `ECHO_E` – its backslashes held as `_LITB`, so a `\e[0m` in a
# name prints as itself and never hides part of a printed command
_LIT () {
	# Args: <text>
	print -r -- "${1//\\/$_LITB}"
}

# Prints the unmerged paths in <worktree> NUL-terminated, to be read back with `(0)` – the line form
# C-quotes a name with a quote or backslash, and a line read splits one holding a newline
_UNMERGED_IN () {
	# Args: <worktree>
	local -a U
	U=(${(0)"$(git -C "$1" diff -z --name-only --diff-filter=U --ignore-submodules=none 2>/dev/null)"})
	(( ${#U} )) && print -rN -- "${U[@]}"
	return 0
}

# Passes stdin on with each raw control byte in caret notation, as `_CARET` takes a string – the
# `sed` after it under `LC_ALL=C`, as BSD sed in a UTF-8 locale dies on a byte no UTF-8 holds
_CARET_LINES () {
	# Args: [--crlf] – a command's output, whose CRLF line endings are no control the text carries,
	# nor the CR a progress line redraws itself with, of which the last state shows
	local L
	while IFS= read -r L || [ -n "$L" ]; do
		[ "$1" = --crlf ] && { L=${L%$'\r'}; L=${L##*$'\r'}; }
		_CARET "$L"
		print -r -- "$REPLY"
	done
}

# Emits one colorized line, its escapes stripped in-shell when color is off
ECHO_E () {
	setopt local_options extended_glob
	# Renders only the colors the templates use – `\e[0m`, `\e[22m`, a `0;` or `1;` 3x or 9x one – so
	# a `\e[2J`, a title-setting sequence, a conceal or a `\n` that a ref name, path or subject
	# carried stays literal – git-edit's own newlines are real ones in the template
	_CARET "$*" "$_LITB"
	# Split once at each `\e[`, as stripping up to the next one costs the rest of the line each time
	local out code piece
	local -a PIECES=("${(@s:\e[:)REPLY}")
	out=${PIECES[1]}
	for piece in "${(@)PIECES[2,-1]}"; do
		# `code` is what precedes the first `m`, a color only where the templates use it – any other
		# sequence stays the literal `\e[`, the rest read as text rather than run
		code="${piece%%m*}"
		if [[ "$piece" == *m* && "$code" == (0|22|[01]';'[39][0-7]) ]]; then
			out+=$'\e'"[${code}m${piece#${code}m}"
		else
			out+='\e['"$piece"
		fi
	done
	# Data's backslashes back, past the rendering `_LIT` kept them out of
	out=${out//$_LITB/\\}
	if [ "$_COLOR" = "true" ]; then
		print -r -- "$out"
	else
		print -r -- "${out//$'\e'\[[0-9;]#m/}"
	fi
}

# Name the repo every run acts on – it is the cwd's, never an argument, so a caller working
# across repos has no other signal that a rewrite is aimed where they meant
_BANNER_REPO=$(git rev-parse --show-toplevel 2>/dev/null)
ECHO_E "\e[1;94mgit edit – Edit, reword, drop, squash, reorder, split, or fold past commits\e[0m${_BANNER_REPO:+\e[0;90m  ${_BANNER_REPO//\\/$_LITB}\e[0m}"

# Global cleanup hook – a shell command any sub-operation can set, run once on script exit
# before the error trailer, by `GIT_EXEC` for temp worktrees and by auto-isolation for its own
_CLEANUP_HOOK=""

# Set by the modes whose verification has no pause behind it – `--exec` and a split – so the
# gate prints no hint pointing at a worktree its exit removes, or at a resume there is none of
_VERIFY_NO_RESUME=false

# The gate command a `--no-verify` run bypassed, printed once above the trailer – a repo with no
# `edit.verifyCmd` prints nothing either, so without this the two read alike from outside: the
# run that had a check and declined it looks like the one that never had one
_VERIFY_BYPASSED=""

# What the gate's check runs left untracked, removed after each one and named once per gate
typeset -a _VERIFY_LITTER

# Where the run started – an isolated run reports from its temp worktree, so a command it prints
# for the branch's checkout names that checkout only where it is not the caller's own
_START_DIR=$PWD

# The caller's own label – an agent session's id, a CI job – closing every reflog message and
# journal line, for a history viewer to name who moved the branch and `--undo` whose run it takes
# back – any other character mapped to `_`, as one could break the quoted command it rides in
# Whose run it is goes by `_ACTOR_ID`, the label as given – two mapping alike stay apart – spelled
# as `$'…'` where it was mapped, on one line and never a mapped label's spelling
_ACTOR=""
_ACTOR_ID=""
_ACTOR_MAPPED=""
_REFLOG_TAG=""
if [ -n "$GIT_EDIT_ACTOR" ]; then
	_ACTOR=${GIT_EDIT_ACTOR//[^A-Za-z0-9_-]/_}
	_ACTOR_ID=$_ACTOR
	_REFLOG_TAG=" [$_ACTOR]"
	[ "$_ACTOR" = "$GIT_EDIT_ACTOR" ] || { _ACTOR_MAPPED=true; _ACTOR_ID=${(qqqq)GIT_EDIT_ACTOR}; }
fi

# Temp files to remove however the run ends – a conflict exits straight from the handler,
# past whatever `rm` followed the call that made them, and the pause clears the hook above
# to keep its worktree, so these need a list of their own
_TEMP_FILES=()
# Throwaway worktrees likewise – a gate's, which no pause ever keeps
_TEMP_WORKTREES=()
# And transient refs – a one-pass replay's, whose throwaway commit `git log --all` and a mirror
# push would show
_TEMP_REFS=()
# Each file taken whole, with the index entry it had then – a re-sync resets only an entry still so
typeset -A WHOLE_IDX
# The checkout a commit or fold composed from, then each path it put, took whole or folded as staged
# – the caller's own content, whose further edits there no sync of its landing offers to merge –
# and of those, each it put, edited or patched, its own only where the file holds what landed – a
# put's own too where its lines there conflict, changed further
typeset -a _LANDED_OWN _LANDED_INPUTS _LANDED_PUTS
# The checkout a fold of staged content re-synced, the tree it read and each path it folded
typeset -a _FOLD_READ

# Tracks whether a status trailer was emitted, so the global trap doesn't put an `error …`
# line on top of an explicit `ok …` or `conflict …` one
_STATUS_EMITTED=false

# Last message passed to `PRINT_ERR`, so the exit trap can name the actual reason in the
# trailer rather than leaving agents to scrape stderr
_LAST_ERROR=""

# The ref move the run landed, so a signal stopping it afterwards reports the move in its
# trailer rather than reading like a run that changed nothing
_LANDED_MOVE=""

# Set as the run starts moving its branch – zsh holds a signal until the `update-ref` it arrived
# during returns, so `_LANDED_MOVE` alone would still read the moved branch as untouched
_LANDING=false

# The first HUP, INT or TERM a landing run finished through rather than stop halfway
_DEFERRED_SIGNAL=""

# Set while the journal line is written, and the signal that arrived meanwhile, as `<signal> <code>`
# – its trap runs inside that write, stdio's lock held, where a fork's child would wait on it forever
_IN_WRITE=""
_HELD_SIGNAL=""

# The move under way – ref, old tip, new tip, journal label – for a second signal to journal
typeset -ga _MOVING_REF
_MOVING_REF=()
# The journal that move goes into, resolved before it – a git call after it may die with the signal
_MOVE_JOURNAL=""
# And the re-sync mark of the checkout it strands index entries in, likewise
_MOVE_MARK=""

# The pause an abort cleared, from where it finishes as a landing does – a stop names it
_CANCELLED_PAUSE=""

# The status the trailer printed stands for, which a signal after it exits with
_TRAILER_CODE=""

# A landing step's output held back – its two files and the descriptors it would have gone to
typeset -ga _STEP_HELD
_STEP_HELD=()
# The two files every landing step holds its output in
typeset -ga _STEP_FILES
_STEP_FILES=()

# The worktree and paths `_RENORM_SETTLE` flags assume-unchanged, unflagged however the run ends
typeset -ga _RENORM_FLAGGED
_RENORM_FLAGGED=()

# The journal whose lock this run holds, let go of however the run ends
_JOURNAL_HELD=""
# The worktree lock this run holds, likewise – a `-C` path's, or that of a pause it resumes
_RUN_LOCK_HELD=""
# What each lock this run takes holds, its pid and start time – set as it takes the first
_LOCK_MARK=""

# The move whose other checkouts were re-synced, so a run names them once
_OTHERS_RESYNCED=""

# Why the checkout sync can't run, as `_SYNCS_CHECKOUT` found it
_SYNC_WHY=""
# The hold on a checkout's sync this run took before its ref move, let go of once the sync is done
_SYNC_HELD=""
# Set once the checkout is brought along, or its carry named – a second signal stopping the run
# before that names the carry instead
_SYNC_DONE=""

# What a run leaves to do – a carry, a conflict's merge – printed last, above the trailer, and the
# pointer line that names it there where commit lines printed in between
typeset -ga _TODO
_TODO=()
_TODO_POINTER=""

# The move the journal holds, so a second signal journals none twice, and the line an undo takes out
_JOURNALED_MOVE=""
_UNDONE_LINE=""

# The state file holding a pause this run recorded or resumed – the repo has one slot, and a pause
# another run recorded there meanwhile is that run's to keep, not this one's
_STATE_OWNED=""
# The keys of the pause standing as the run started, if any – one with other keys began since
_PAUSE_AT_START=""
# The ref and journal of a race this run lost, for the busy-branch hint above its trailer
typeset -ga _RACE_LOST
_RACE_LOST=()
# Set where a refusal is over the flags given, for the pointer at `-h` above its trailer
_USAGE_POINT=""
# A message typed in an editor and the command rerunning with it, kept where a landing refuses
typeset -ga _TYPED_KEEP
_TYPED_KEEP=()
# A `-C` path a first run's replay stands halfway in, taken back where that run refuses
_UNWIND_PATH=""

# Runs the cleanup hook, then emits a machine-readable error trailer matching the success
# form (`git-edit: ok …`), so a `^git-edit:` grep dispatches either outcome on one rule
_GLOBAL_EXIT_TRAP () {
	local CODE=$?
	# The run is ending, so a further signal stops nothing – ignored here and by what the cleanup
	# runs, as one sent to the whole process group would end the `worktree remove` it waits on
	trap '' HUP INT TERM
	# A landing step's held-back output goes out where it would have, ahead of the trailer
	if (( ${#_STEP_HELD} == 4 )); then
		exec 1>&${_STEP_HELD[3]} 2>&${_STEP_HELD[4]}
		_STEP_FLUSH "${_STEP_HELD[1]}" "${_STEP_HELD[2]}"
		_STEP_HELD=()
	fi
	(( ${#_RENORM_FLAGGED} )) && _RENORM_UNFLAG "${_RENORM_FLAGGED[@]}"
	# A resumable operation keeps its worktree: an interrupt mid-verification would otherwise
	# remove the one the saved state still points at – completions clear their state first, and
	# a failed run keeps it only for a pause of its own, never for one a parallel run recorded
	local SF=$(_STATE_FILE_PATH)
	# A resume that landed is resumable no more, so one stopped by a second signal once its move was
	# journaled clears the pause here, under the journal's lock it still holds, sparing `--abort` a
	# pause it would call untouched, and its worktree goes below – the pause it took up only, keys
	# and nonce alike, as one another run wrote holds that run's work
	if [ -n "$_LANDED_MOVE" ] && [ -n "$_STATE_OWNED" ]; then
		_CLEAR_STATE
	fi
	if [ -n "$_CLEANUP_HOOK" ] && { [ $CODE -eq 0 ] || [ -z "$_STATE_OWNED" ] || [ ! -f "$_STATE_OWNED" ]; }; then
		eval "$_CLEANUP_HOOK" 2>/dev/null
		_CLEANUP_HOOK=""
	fi
	if [ ${#_TEMP_FILES[@]} -gt 0 ]; then
		rm -f "${_TEMP_FILES[@]}" 2>/dev/null
		_TEMP_FILES=()
	fi
	local R
	for R in "${_TEMP_REFS[@]}"; do
		git update-ref -d "$R" >/dev/null 2>&1
	done
	_TEMP_REFS=()
	[ -n "$_JOURNAL_HELD" ] && _JOURNAL_UNLOCK "$_JOURNAL_HELD"
	[ -n "$_SYNC_HELD" ] && _SYNC_HOLD_RELEASE
	[ -n "$_RUN_LOCK_HELD" ] && _RUN_WORKTREE_UNLOCK
	local W
	for W in "${_TEMP_WORKTREES[@]}"; do
		git worktree remove --force "$W" >/dev/null 2>&1
		rm -rf "$W"
	done
	_TEMP_WORKTREES=()
	if [ -n "$_RERERE_SCOPE_OWNED" ] && [ ! -f "$_RERERE_STATE_FILE" ]; then
		_RERERE_SCOPE_END $CODE
		_RERERE_SCOPE_OWNED=""
	fi
	# A held-back rewrite delivery outlives the run only with the pause it belongs to
	if [ -n "$_CAPTURE_DIR" ] && ! grep -qxF "capture=$_CAPTURE_DIR" "$SF" 2>/dev/null; then
		_CAPTURE_REMOVE "$_CAPTURE_DIR"
	fi
	if [ $CODE -ne 0 ] && [ "$_STATUS_EMITTED" != "true" ]; then
		# A line pointing at the flags rather than the whole usage, which buried the refusal
		[ -n "$_USAGE_POINT" ] && ECHO_E "\e[0;31m  'git edit -h' lists every flag – 'git edit -h <flag>...' gives each in full.\e[0m" >&2
		(( ${#_RACE_LOST} )) && _PRINT_BUSY_HINT "${_RACE_LOST[@]}"
		_PRINT_TODO
		if [ -n "$_LAST_ERROR" ]; then
			_EMIT_TRAILER "git-edit: error – $_LAST_ERROR"
		else
			_EMIT_TRAILER "git-edit: error – exit code $CODE"
		fi
	fi
}
trap '_GLOBAL_EXIT_TRAP' EXIT

# Routes a termination signal through the exit trap, as a failed run leaves – untrapped, zsh
# dies without running it and the operation's worktree stays registered – and absorbs `PIPE`, so
# a reader gone mid-run, a GUI quitting or a `| head`, costs the output alone
_TRAP_TERMINATION () {
	trap '_ON_TERMINATION HUP 129' HUP
	trap '_ON_TERMINATION INT 130' INT
	trap '_ON_TERMINATION TERM 143' TERM
	trap '_ON_TERMINATION PIPE 141' PIPE
}

# Stops the run, unless its branch is already moving – stopping then would only strand what the
# move still owes: journal entry `--undo` reads, rewrite delivery, index re-sync
_ON_TERMINATION () {
	# Args: <signal> <exit code>
	# A closed reader is no request to stop, so a run takes each SIGPIPE in stride and
	# finishes, landing or refusing as it would – each, since a descriptor a caller's
	# `>&2` saved comes back pointing at the dead pipe
	if [ "$1" = PIPE ]; then
		exec >/dev/null 2>&1
		return
	# Held until the journal write it arrived in returns, as nothing here may fork inside it
	elif [ -n "$_IN_WRITE" ]; then
		[ -n "$_HELD_SIGNAL" ] || _HELD_SIGNAL="$1 $2"
		return
	# At a pause's prompt one leaves the pause as q does, and ends as q does
	elif [ -n "$_AT_PROMPT" ]; then
		_LEAVE_PAUSED "$_AT_PROMPT"
	# Once the trailer is out, the code it stands for – the run has said how it ended
	elif [ -n "$_TRAILER_CODE" ]; then
		exit $_TRAILER_CODE
	elif [ "$_LANDING" = true ] && [ -z "$_DEFERRED_SIGNAL" ]; then
		_DEFERRED_SIGNAL=$1
		return
	fi
	# A second one mid-move stops the run all the same – the move journaled first where the ref
	# took it, so `--undo` and the trailer still know of it, unless the journal holds it already,
	# a signal landing between the run's own write and its note of it
	local RESYNC=""
	if [ "$_LANDING" = true ] && (( ${#_MOVING_REF} == 4 )) && \
	   [ "$(git rev-parse -q --verify "${_MOVING_REF[1]}" 2>/dev/null)" = "${_MOVING_REF[3]}" ]; then
		if [ -z "$_JOURNALED_MOVE" ]; then
			local JF=${_MOVE_JOURNAL:-$(_JOURNAL_FILE_PATH)} TAB=$'\t'
			local ENTRY="$EPOCHSECONDS ${_MOVING_REF[1]} ${_MOVING_REF[2]} ${_MOVING_REF[3]} ${_MOVING_REF[4]}${_ACTOR_ID:+$TAB$_ACTOR_ID}"
			_LANDED_MOVE="${_MOVING_REF[1]} moved ${_MOVING_REF[2]} → ${_MOVING_REF[3]}"
			if [ -n "$JF" ] && LC_ALL=C grep -qF -- " ${_MOVING_REF[1]} ${_MOVING_REF[2]} ${_MOVING_REF[3]} " "$JF" 2>/dev/null; then
				:
			elif [ -n "$JF" ] && [ -n "$_UNDONE_LINE" ]; then
				_JOURNAL_REPLACE "$JF" "$_UNDONE_LINE" "$ENTRY"
			elif [ -n "$JF" ]; then
				print -r -- "$ENTRY" >> "$JF"
			fi
		fi
		# And the index entries it stranded re-synced, as its landing would have, the index alone –
		# left as they are, they read as a staged revert of the move a peer's plain commit takes in
		# A further signal is ignored from here, as the exit trap ignores one
		trap '' HUP INT TERM
		# The index lock its own sync held goes first – stopped there, it writes nothing more
		[ -n "$_INDEX_LOCK_OWN" ] && rm -f "$_INDEX_LOCK_OWN.lock" && _INDEX_LOCK_OWN=""
		_RESYNC_STRANDED_NOTE "${_MOVING_REF[1]}" "${_MOVING_REF[2]}" "${_MOVING_REF[3]}"
		RESYNC=$REPLY
		_RESYNC_MARK_DONE "${_MOVING_REF[1]}" "${_MOVING_REF[2]}" "${_MOVING_REF[3]}"
		# The checkout its sync had yet to bring along, named with the carry that does it
		if [ -z "$_SYNC_DONE" ]; then
			_STOPPED_CARRY "${_MOVING_REF[@]}"
			[ -n "$REPLY" ] && _TODO_ADD "$REPLY" "The checkout was not brought along before the stop – bring it along with: %s" 33 "$REPLY"
		fi
	fi
	# A pause this run wrote or took up and has not landed stays, its worktree kept by the exit trap
	local KEPT=""
	[ -n "$_STATE_OWNED" ] && [ -f "$_STATE_OWNED" ] && [ -z "$_LANDED_MOVE" ] && \
		KEPT=" – its pause stays, 'git edit --status' shows it"
	_LAST_ERROR="stopped by SIG$1${_LANDED_MOVE:+ after $_LANDED_MOVE}$RESYNC${_CANCELLED_PAUSE:+ after cancelling the pause ($_CANCELLED_PAUSE)}${_WAITING:+ while waiting for $_WAITING pause to clear – nothing ran}$KEPT"
	[ -n "$_NAP_PID" ] && kill "$_NAP_PID" 2>/dev/null
	exit $2
}

# Stops the run by the signal a landing deferred, where the move never happened after all – the
# signal ended its `update-ref`, which reads as git refusing the move
_STOP_DEFERRED () {
	local S=$_DEFERRED_SIGNAL
	[ -n "$S" ] || return 0
	_LANDING=false _DEFERRED_SIGNAL=""
	_ON_TERMINATION "$S" $(( 128 + ${signals[(Ie)$S]} - 1 ))
}

# Runs post-landing step <function> with its output held back, and runs it again unheld where the
# signal the landing defers arrived meanwhile – one sent to the whole process group ends the git
# call the step waited on too, and its cut-short answer reads as "nothing changed"
# A step's re-run finds what its first run did done, so it says only what is left
_LANDED_STEP () {
	# Args: <function> <arg>...
	local _IN_LANDED_STEP=1 _STEP_TTY="" OUT ERRF WAS_OTHERS=$_OTHERS_RESYNCED WAS_VERDICT=$_SYNC_VERDICT FD1 FD2 RC
	local -i WAS_TODO=${#_TODO}
	local WAS_POINTER=$_TODO_POINTER
	if [ "$_LANDING" != true ] || [ -n "$_DEFERRED_SIGNAL" ] || (( ${#_STEP_HELD} )); then
		"$@"
		return
	fi
	# One pair a run, each step's redirection truncating it – made again where the cleanup took it
	if [ -f "${_STEP_FILES[1]}" ] && [ -f "${_STEP_FILES[2]}" ]; then
		OUT=${_STEP_FILES[1]} ERRF=${_STEP_FILES[2]}
	else
		OUT=$(MKTEMP_FILE git-edit-step) && ERRF=$(MKTEMP_FILE git-edit-step) || { "$@"; return; }
		_TEMP_FILES+=("$OUT" "$ERRF")
		_STEP_FILES=("$OUT" "$ERRF")
	fi
	# Arrived while those were made, it cut nothing the step reads
	[ -z "$_DEFERRED_SIGNAL" ] || { "$@"; return; }
	# Its terminal still a person's, as the checkout sync asks
	[ -t 1 ] && _STEP_TTY=1
	exec {FD1}>&1 {FD2}>&2
	_STEP_HELD=("$OUT" "$ERRF" "$FD1" "$FD2")
	{ "$@" } >"$OUT" 2>"$ERRF"
	RC=$?
	_STEP_HELD=()
	if [ -n "$_DEFERRED_SIGNAL" ]; then
		# What it left to do named again by the re-run, never twice
		_OTHERS_RESYNCED=$WAS_OTHERS _SYNC_VERDICT=$WAS_VERDICT _TODO=("${(@)_TODO[1,WAS_TODO]}") _TODO_POINTER=$WAS_POINTER
		"$@"
		RC=$?
	else
		_STEP_FLUSH "$OUT" "$ERRF"
	fi
	exec {FD1}>&- {FD2}>&-
	return $RC
}

# Prints a landing step's held-back output, each stream to its own
_STEP_FLUSH () {
	# Args: <stdout file> <stderr file>
	local C=""
	IFS= read -rd '' C <"$1" 2>/dev/null
	print -rn -- "$C"
	C=""
	IFS= read -rd '' C <"$2" 2>/dev/null
	print -rn -- "$C" >&2
}

# Adds a line to what the run leaves to do, rendered as `PRINT_TEXT` renders it, and <what> to the
# pointer naming it above the trailer where commit lines print between them
_TODO_ADD () {
	# Args: <what to run, in a few words> <printf message> <color> <arg>...
	_TODO_POINTER+="${_TODO_POINTER:+ – }$1"
	shift
	_TODO+=("$(PRINT_TEXT "$@")")
}

# Adds a command to what the run leaves to do, indented under the line naming it
_TODO_CMD () {
	# Args: <command>
	_TODO+=("$(ECHO_E "\e[0;33m  $(_LIT "$1")\e[0m")")
}

# Prints what the run leaves to do – with `early`, above the commit lines the output contract keeps
# last, its pointer then left for the line right above the trailer, else there itself
_PRINT_TODO () {
	# Args: [early]
	if (( ${#_TODO} )); then
		print -r -- "${(F)_TODO}"
		_TODO=()
		[ "$1" = early ] || _TODO_POINTER=""
	elif [ -n "$_TODO_POINTER" ] && [ "$1" != early ]; then
		PRINT_TEXT "Still to do, as named above: %s" 33 "$_TODO_POINTER"
		_TODO_POINTER=""
	fi
	return 0
}

# Puts <command>'s output into `REPLY`, run again where the signal the landing defers arrived
# meanwhile, as one sent to the whole process group ends the command too
_LANDED_OUT () {
	# Args: <command> <arg>...
	local SIG=$_DEFERRED_SIGNAL RC
	REPLY=$("$@")
	RC=$?
	[ "$_DEFERRED_SIGNAL" = "$SIG" ] && return $RC
	REPLY=$("$@")
}

# Runs <command>, again where the signal the landing defers arrived meanwhile, as `_LANDED_OUT` does
_LANDED_RUN () {
	# Args: <command> <arg>...
	local SIG=$_DEFERRED_SIGNAL RC
	"$@"
	RC=$?
	[ "$_DEFERRED_SIGNAL" = "$SIG" ] && return $RC
	"$@"
}
_TRAP_TERMINATION


