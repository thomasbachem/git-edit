	ECHO_E "\e[0;94m       --snapshot                      With --amend-into: merge the fold into each commit from its target up (git 2.40+)\e[0m"
	ECHO_E "\e[0;94m       --dry-run                       With --exec or --land: say what would land, applying nothing\e[0m"
	ECHO_E "\e[0;94m       --verify=<cmd>                  Gate the rewrite on <cmd> before it lands (also: edit.verifyCmd)\e[0m"
