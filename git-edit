#!/bin/zsh

# git edit – Easily edit commits via interactive rebase
#
# usage: `git-edit [-m | --message] <commit>`
#    or: `git-edit [-d | --drop | -s | --squash] <commit>...`
#
# This Git command script allows you to edit/modify/merge
# previous Git commits easily. It essentially is a more
# convenient version of using `git rebase --interactive`
# for that use case.
#
# It will stash any local changes, then reset your local copy
# to the state of the commit you want to edit via `git rebase`,
# then pause to let you make changes. After resuming the script,
# all changes will be added to the commit, and the rebase will
# continue. The script also pauses in case any conflicts arise,
# so you can manually resolve them before continuing with the
# merge/rebase. After completion, your previous local changes
# will be unstashed/reapplied.
#
# If you want to alter the commit message as well, add the
# `-m` switch. You can also delete (drop) one or more commits
# (or ranges) by using `-d`, or merge (fixup/squash) one or
# more commits into another one (defaulting to the oldest
# commit in the selection) using `-s`/`--squash`. Whenever
# multiple commit hashes are supplied, `-s`/`--squash` is
# assumed as the default mode and the oldest commit becomes
# the `<target>`.
#
# Use it as "git edit" by adding its parent folder to your `PATH`,
# e.g. by adding this line to ~/.zshrc:
# export PATH=$PATH:/your/path/to/git-custom-commands
#
# WARNING: Note that this will change the SHA1 of the commit
# as well as of all later commits – it rewrites the history
# from that point forward. This is unproblematic as long as
# you either didn't push these commits yet, or are a single
# developer. If not, it can cause other maintainers, branches,
# or forks quite the hassle. So please know what you're doing
# when using `git push --force`!
#
# Released by Thomas Bachem <mail@thomasbachem.com>
# under the MIT License


# Make a pipeline fail if any element fails
# (required for `$?` to work in conjunction with `tee` below)
set -o pipefail

# Most commits a stale SHA's resolution will compute a patch id for. The author
# date filter ahead of it normally leaves a handful, so this only bites where a
# batch shares one second – imported or scripted history. Past it a match can no
# longer be called unique, and resolution degrades to a suggestion.
RESOLVE_SCAN_MAX=100

# Blank-line padding between narrative lines reads well in a terminal, but a
# caller piping through `| tail -N` – how most agent invocations consume this
# – loses a line of summary to every one of them. Pad only for a real
# terminal; a pipe or a captured run gets the same lines, tight.
_PAD=""
[ -t 1 ] && _PAD="\n"

# Same reasoning for color: escapes read as emphasis in a terminal but as
# noise in a captured run, where they also split literal text a caller greps
# for. Honors NO_COLOR and TERM=dumb alongside the pipe check.
_COLOR=true
if [ ! -t 1 ] || [ -n "$NO_COLOR" ] || [ "$TERM" = "dumb" ]; then
	_COLOR=false
fi

# Gutter colors for the excerpt streams (`git show`/`git log` output piped
# through `sed`, which can't route through ECHO_E) – empty when color is off,
# so one `sed` script serves both cases
_DIM=$'\e[0;90m'
_RED=$'\e[0;31m'
_OFF=$'\e[0m'
if [ "$_COLOR" != "true" ]; then
	_DIM=""
	_RED=""
	_OFF=""
fi

# Emits one colorized line, stripping the escapes in-shell when color is off so no call
# site has to know – `print -v` over a command substitution: it expands them without
# forking, the path agents take, and keeps trailing newlines that `$(…)` would have eaten
ECHO_E () {
	if [ "$_COLOR" = "true" ]; then
		echo -e "$@"
	else
		setopt local_options extended_glob
		local OUT
		print -v OUT -- "$@"
		print -r -- "${OUT//$'\e'\[[0-9;]#m/}"
	fi
}

ECHO_E "\e[1;94mgit edit – Edit, reword, drop, or squash git commits\e[0m"

# Global cleanup hook (any sub-operation that needs cleanup on exit can set
# this to a shell command). Runs once on script exit, before the error
# trailer. Used by GIT_EXEC for temp-worktree cleanup, and by auto-isolation
# for the per-invocation tmp worktree.
_CLEANUP_HOOK=""

# Tracks whether a status trailer was emitted (success, abort, conflict) so
# the global trap doesn't double-emit an `error …` line on top of an
# explicit `ok …` or `conflict …` trailer.
_STATUS_EMITTED=false

# Captures the last message passed to PRINT_ERR, so the global exit trap can
# include the actual error reason in the trailer line — saving agents from
# having to scrape stderr for context when the operation failed.
_LAST_ERROR=""

# Global EXIT trap. Runs the cleanup hook (if any), then emits a stable
# machine-readable error trailer (matching the format of the success trailer
# `git-edit: ok …`) so agents can grep `^git-edit:` for either outcome with
# a single parse rule.
_GLOBAL_EXIT_TRAP () {
	local CODE=$?
	if [ -n "$_CLEANUP_HOOK" ]; then
		eval "$_CLEANUP_HOOK" 2>/dev/null
		_CLEANUP_HOOK=""
	fi
	if [ $CODE -ne 0 ] && [ "$_STATUS_EMITTED" != "true" ]; then
		if [ -n "$_LAST_ERROR" ]; then
			echo "git-edit: error — $_LAST_ERROR"
		else
			echo "git-edit: error — exit code $CODE"
		fi
	fi
}
trap '_GLOBAL_EXIT_TRAP' EXIT


