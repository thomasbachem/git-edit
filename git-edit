PRINT_TEXT () {
	local MSG=$1; shift
	local COLOR=$1; shift
	# Arguments are data, a `\e[0m` in a name held literal – bar `PRINT_ACTION`'s, which carry its
	# own `\e[22m` and mark their subjects themselves
	local ARGS=("$@")
	[ -n "$_PT_RAW" ] || ARGS=("${(@)ARGS//\\/$_LITB}")

	local BASE=$COLOR
	local BRIGHT=$(( COLOR <= 37 ? COLOR + 60 : COLOR ))

	local TEXT="$MSG"
	local OUTPUT="${_PAD}\e[0;${COLOR}m"
	local ARG
	for ARG in "${ARGS[@]}"; do
		OUTPUT+="${TEXT%%%s*}"
		OUTPUT+="\e[1;${BRIGHT}m${ARG}\e[0;${BASE}m"
		TEXT="${TEXT#*%s}"
	done
	OUTPUT+="$TEXT\e[0m"
	ECHO_E "$OUTPUT"
}

PRINT_ACTION () {
	local MSG=$1; shift

	# A trailing `%t` names a squash or merge target – render it from its own commit, so its
	# subject stays out of the format string, where a `%` would miscount `%s` or an `->` misroute
	# – the target is the first positional then, the `%s` commits the rest
	local TARGET_RENDER=""
	if [[ "$MSG" == *%t ]]; then
		local TGT=$1; shift
		local TSUB=$(git log -1 --pretty=format:'%s' "$TGT")
		TSUB=${TSUB//\\/$_LITB}
		TARGET_RENDER="${TGT:0:7}\e[22m (${TSUB})"
		MSG="${MSG%\%t}"
	fi

	local COMMITS=("$@")
	local ARGS=()
	local COMMIT
	for COMMIT in "${COMMITS[@]}"; do
		local SUBJECT=$(git log -1 --pretty=format:'%s' "$COMMIT")
		# `ECHO_E` renders the `\e[22m` here, the subject's backslashes marked as data
		ARGS+=("${COMMIT:0:7}\e[22m (${SUBJECT//\\/$_LITB})")
	done

	local _PT_RAW=1
	# Count placeholders (assumes %s is the only placeholder type used) – the target is gone, so
	# only git-edit's own `%s` remain, whatever a subject carried
	local PLACEHOLDERS="${MSG//[^%]}"

	# Use list mode if multiple commits or if it's a merge (contains "->")
	if [[ ${#COMMITS[@]} -gt 1 || "$MSG" == *"->"* ]] && [[ ${#PLACEHOLDERS} -eq 1 ]]; then
		local PREFIX="${MSG%%%s*}" # e.g. "Dropping "
		local SUFFIX="${MSG#*%s}"  # e.g. "..." or " -> " or " into "

		# Transform "Dropping " -> "Dropping:"
		local NEW_MSG="${PREFIX% }:"

		# Append a newline and indented placeholder for every commit
		# We use a C-style loop for robust iteration in Zsh
		for (( i=0; i<${#COMMITS[@]}; i++ )); do
			NEW_MSG+=$'\n'" - %s"
		done

		# Put merge arrow on a new line and bold it, otherwise keep suffix attached – the rendered
		# target, when there is one, trails whichever
		if [[ "$SUFFIX" == *"->"* ]]; then
			NEW_MSG+=$'\n'"\e[1;96m${SUFFIX# }${TARGET_RENDER}"
		else
			NEW_MSG+="${SUFFIX}${TARGET_RENDER}"
		fi

		PRINT_TEXT "$NEW_MSG" 36 "${ARGS[@]}"
	else
		# Default behavior for single commits or specific pairs (squash A -> B)
		PRINT_TEXT "${MSG}${TARGET_RENDER}" 36 "${ARGS[@]}"
	fi
}

# Prints one dim line naming <commit> via <format> – formatted by git and piped rather than
# routed through `PRINT_TEXT`, which would read a `%s` in the subject as a placeholder
# Silent on a missing object, where a `fatal:` would read as the operation having failed
_PRINT_COMMIT_LINE () {
	_CARET "$(git log -1 --format="$2" "$1" 2>/dev/null)"
	print -r -- "$REPLY" | LC_ALL=C sed "/./!d;s/^/${_DIM}/;s/\$/${_OFF}/"
}

PRINT_CMD () {
	# Args: <command string> [<color – default 90 gray, matching the command's own output>]
	local CMD="$1"
	local COLOR="${2:-90}"

	# Filter `--no-autostash` arg when printing commands
	local CMD_FILTERED=$(print -r -- "$CMD" | LC_ALL=C sed -E 's/ --no-autostash( |$)/\1/g')

	ECHO_E "${_PAD}\e[0;${COLOR}m${CMD_FILTERED//\\/$_LITB}\e[0;90m"
}

PRINT_ERR () {
	local MSG="$1"
	# Remember the message for the status trailer in _GLOBAL_EXIT_TRAP
	_LAST_ERROR="$MSG"

	# Split at the first `: ` alone – a bare colon is a name's, as in `:x.txt`, or ends a lead-in
	MSG=${MSG//\\/$_LITB}
	if [[ "$MSG" == *": "* ]]; then
		local PREFIX="${MSG%%: *}"
		local REST="${MSG#*: }"
		ECHO_E $'\n'"\e[1;91m${PREFIX}:\e[0m\e[0;31m ${REST}\e[0m" >&2
	else
		ECHO_E $'\n'"\e[1;91m${MSG}\e[0m" >&2
	fi
}

# Gives every git this run spawns, once a run, the config the branch's checkout reads and a detached
# worktree misses – an `onbranch` include's identity or signing key, a relative `core.hooksPath`
# whose untracked hooks (husky's) only the checkout has – through an `includeIf` last in what
# `git -c` passes, so no other repository a command touches reads it, and no caller's `-c` wins
_ADOPT_CHECKOUT_CONFIG () {
	# Args: <worktree> <checkout>
	[ -n "$_CONFIG_ADOPTED" ] && return 0
	_CONFIG_ADOPTED=true
	local WT=$1 CO=$2 K HP GCD INC GPAT Q="'\\''"
	local -i I N=0
	local -a CL WL
	local -A CO_LAST WT_LAST
	# Scope and entry in turn, an entry a key and its value a newline apart – the worktree's own
	# scope differs by design, sparse settings say, and an entry with no value has no form to pin
	CL=("${(@0)$(git -C "$CO" config -l -z --show-scope 2>/dev/null)}")
	WL=("${(@0)$(git -C "$WT" config -l -z --show-scope 2>/dev/null)}")
	for (( I = 1; I + 1 <= ${#CL}; I += 2 )); do
		[ "${CL[I]}" != worktree ] && [[ "${CL[I + 1]}" == *$'\n'* ]] && CO_LAST[${CL[I + 1]%%$'\n'*}]=${CL[I + 1]#*$'\n'}
	done
	for (( I = 1; I + 1 <= ${#WL}; I += 2 )); do
		[[ "${WL[I + 1]}" == *$'\n'* ]] && WT_LAST[${WL[I + 1]%%$'\n'*}]=${WL[I + 1]#*$'\n'}
	done
	INC=$(MKTEMP_FILE git-edit-config)
	_TEMP_FILES+=("$INC")
	for K in "${(@k)CO_LAST}"; do
		[[ "$K" == (include|includeif).* ]] && continue
		(( ${+WT_LAST[$K]} )) && [ "${WT_LAST[$K]}" = "${CO_LAST[$K]}" ] && continue
		git config -f "$INC" "$K" "${CO_LAST[$K]}" 2>/dev/null && N+=1
	done
	HP=${CO_LAST[core.hookspath]}
	if [ -n "$HP" ] && [[ "$HP" != (/*|"~"*) ]] && [ -d "$CO/$HP" ]; then
		git config -f "$INC" core.hooksPath "${${:-$CO/$HP}:A}" && N+=1
	fi
	(( N )) || return 0
	GCD=$(git -C "$CO" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
	[ -n "$GCD" ] || return 0
	# A glob, so the path's own `[`, `*`, `?` or `\` escaped – and the worktrees one level deep, as
	# a submodule's git dir sits below a linked worktree's – single-quoted as git reads that list,
	# a quote inside closed and reopened
	GPAT=${${GCD:A}//\\/\\\\}
	GPAT=${${${${GPAT//\[/\\[}//\]/\\]}//\*/\\*}//\?/\\?}
	export GIT_CONFIG_PARAMETERS="$GIT_CONFIG_PARAMETERS '${${:-includeif.gitdir:${GPAT}.path=$INC}//\'/$Q}' '${${:-includeif.gitdir:${GPAT}/worktrees/*.path=$INC}//\'/$Q}'"
}

# Symlinks gitignored paths named by `edit.worktreeLink` into a fresh worktree – a pause
# verifies the commit in isolation, but the project's own checks need what the checkout
# does not track, and links over copies keep a run from diverging from what is installed
_LINK_WORKTREE_EXTRAS () {
	local WT=$1
	local FROM=$2
	[ -z "$WT" ] || [ ! -d "$WT" ] && return 0
	[ -z "$FROM" ] && FROM=$(git rev-parse --show-toplevel 2>/dev/null)
	[ -z "$FROM" ] || [ ! -d "$FROM" ] && return 0
	_ADOPT_CHECKOUT_CONFIG "$WT" "$FROM"

	local -a EXTRAS
	EXTRAS=("${(@f)$(git config --get-all edit.worktreeLink 2>/dev/null)}")
	[ -n "$GIT_EDIT_WORKTREE_LINK" ] && EXTRAS+=("${(@s.:.)GIT_EDIT_WORKTREE_LINK}")

	local -a LINKED SKIPPED FAILED MISSING
	local P
	for P in "${EXTRAS[@]}"; do
		[ -z "$P" ] && continue
		# Only what the origin actually has, and never over a tracked path the
		# commit itself carries – the worktree's own content wins
		[ -e "$FROM/$P" ] || { MISSING+=("$P"); continue; }
		[ -e "$WT/$P" ] && continue
		# An ignore pattern written for a directory (`node_modules/`) misses the symlink standing
		# in for it, so the link lands untracked where the directory was ignored – and
		# `--continue` stages the worktree wholesale, so skipping the link is the whole remedy
		if ! git -C "$WT" check-ignore -q "$P" 2>/dev/null; then
			SKIPPED+=("$P")
			continue
		fi
		# A nested path needs its parent to exist, or `ln` fails and the caller
		# gets silence where they configured something
		[[ "$P" == */* ]] && mkdir -p "$WT/${P:h}" 2>/dev/null
		if ! ln -sfn "$FROM/$P" "$WT/$P" 2>/dev/null; then
			FAILED+=("$P")
			continue
		fi
		LINKED+=("$P")
	done
	if [ ${#LINKED[@]} -gt 0 ]; then
		PRINT_TEXT "Linked into the worktree: %s" 90 "${(j:, :)LINKED}"
	fi
	if [ ${#SKIPPED[@]} -gt 0 ]; then
		PRINT_TEXT "Not linking %s – its ignore pattern doesn't cover a symlink, so the amend would commit it." 33 \
			"${(j:, :)SKIPPED}"
		PRINT_TEXT "Drop the trailing slash in %s to have it linked." 33 ".gitignore"
	fi
	if [ ${#FAILED[@]} -gt 0 ]; then
		PRINT_TEXT "Could not link %s into the worktree – check the path." 33 "${(j:, :)FAILED}"
	fi
	# Said, since a check needing one fails on that alone, which reads as the rewrite's doing
	if [ ${#MISSING[@]} -gt 0 ]; then
		PRINT_TEXT "Not linking %s – %s has none to link." 33 "${(j:, :)MISSING}" "$FROM"
	fi
}

# Creates a temp dir or file from a full `$TMPDIR` path template – BSD/macOS `mktemp -t`
# takes its arg as a literal prefix and appends its own suffix, leaving the inner `XXXXXX`
# verbatim, while a full template has its trailing `X`s replaced on both GNU and BSD
MKTEMP_DIR () {
	local BASE="${TMPDIR:-/tmp}"
	mktemp -d "${BASE%/}/$1.XXXXXX"
}

MKTEMP_FILE () {
	local BASE="${TMPDIR:-/tmp}"
	mktemp "${BASE%/}/$1.XXXXXX"
}

# Emits the single-line status trailer in natural-language form, anchored by `git-edit:` for
# dispatch – agents `grep -E '^git-edit: (ok|error|conflict|paused)'`, and the forms are:
#   "git-edit: ok – refs/heads/main moved <old-sha> → <new-sha>"
#   "git-edit: ok – refs/heads/main unchanged"
#   "git-edit: error – exit code <N>"
#   "git-edit: conflict – resolve in <worktree> (<files>); then 'git edit --continue' or '… --abort'"
#   "git-edit: paused – edit|split <sha> in <worktree>; then 'git edit --continue' or '… --abort'"
EMIT_STATUS () {
	# Args: <new_head_sha> <ref> <changed:true|false> [<note on "unchanged">]
	# Directly above the trailer, where a reader after what checked the result already looks, and
	# named so one `^Verif` reaches it alongside the gate's own lines – only a run that declined a
	# gate says anything, an unconfigured repo staying as quiet as it always was
	if [ -n "$_VERIFY_BYPASSED" ]; then
		PRINT_TEXT "Verify skipped – %s was passed, so \`%s\` never ran" 90 "--no-verify" "$_VERIFY_BYPASSED"
		_VERIFY_BYPASSED=""
	fi
	_PRINT_DEFERRED_SIGNAL
	# The SHAs are the authority, not the flag – some callers pass a hardcoded `true` where a
	# no-op rebase leaves `HEAD` put, and reporting a move there is a false success on `ok`
	if [ "$3" = "true" ] && [ "$1" != "$SCRIPT_INITIAL_HEAD" ]; then
		_EMIT_TRAILER "git-edit: ok – $2 moved $SCRIPT_INITIAL_HEAD → $1"
	else
		_EMIT_TRAILER "git-edit: ok – $2 unchanged${4:+, $4}"
	fi
	_STATUS_EMITTED=true
}

# Names the signal a landing run finished through, directly above the trailer – a caller that
# sent it would otherwise read the run as one that finished before it came
_PRINT_DEFERRED_SIGNAL () {
	[ -n "$_DEFERRED_SIGNAL" ] || return 0
	PRINT_TEXT "SIG%s arrived once the branch had moved – finished the run rather than stop it halfway" 90 "$_DEFERRED_SIGNAL"
}

# Emits an `--exec --dry-run`'s outcome – nothing moved, and the SHA it built is what the caller
# came for, so it rides in the one line a `tail -1` or a `^git-edit:` grep is sure to reach
EMIT_DRY_RUN () {
	# Args: <built_sha> <base_sha> <ref>
	_EMIT_TRAILER "git-edit: ok – dry run built $1 on $2, $3 unchanged"
	_STATUS_EMITTED=true
}

EMIT_CONFLICT () {
	# Args: <worktree-path> [<unmerged files, one per line>]
	local FILES_PART=""
	if [ -n "$2" ]; then
		FILES_PART=" (${(j:, :)${(f)2}})"
	fi
	_EMIT_TRAILER "git-edit: conflict – resolve in $1$FILES_PART; then 'git edit --continue' or 'git edit --abort'"
	_STATUS_EMITTED=true
}

# Emits the pause a mode takes by design, an edit or content split, rather than on a
# conflict – nothing is unmerged, there is just authoring left to do
EMIT_PAUSED () {
	# Args: <operation> <sha> <worktree-path>
	_EMIT_TRAILER "git-edit: paused – $1 ${2:0:7} in $3; then 'git edit --continue' or 'git edit --abort'"
	_STATUS_EMITTED=true
}

# Emits the pause a completed rewrite takes when its verification fails – the result
# is built but not applied, and the state stays, so the resolution work
# survives the verdict whichever way the caller decides
EMIT_VERIFY_PAUSED () {
	# Args: <failing-sha> <worktree-path> [<result-tip>]
	# Also marks the state file – `verify_failed` tells a later `--status` this pause from a
	# conflict, and `verify_result` records what a resume applies, the worktree's `HEAD` being
	[ "$STATE_VERIFY_FAILED" != "$1" ] && _STATE_NOTE "verify_failed=$1"
	[ -n "$3" ] && [ "$STATE_VERIFY_RESULT" != "$3" ] && _STATE_NOTE "verify_result=$3"
	# A driver greps the trailer, commonly through a `| tail -N` that cuts off
	# the run's own output printed above it – so the trailer carries the path
	local VLOG=$(_VERIFY_LOG_PATH)
	local LOGNOTE=""
	[ -n "$VLOG" ] && [ -f "$VLOG" ] && LOGNOTE="; output in $VLOG"
	_EMIT_TRAILER "git-edit: paused – verify failed at ${1:0:7} in $2$LOGNOTE; then 'git edit --continue' (re-verify), '--no-verify --continue' (apply anyway), or 'git edit --abort'"
	_STATUS_EMITTED=true
}

# Emits the pause a completed rewrite takes when its tip carries a file mode nothing asked for –
# built, not applied, the state kept, as a verify pause is; `mode_stray` marks it for `--status`
EMIT_MODE_PAUSED () {
	# Args: <commit-sha> <worktree-path> [<result-tip>]
	[ "$STATE_MODE_STRAY" != "$1" ] && _STATE_NOTE "mode_stray=$1"
	[ -n "$3" ] && [ "$STATE_VERIFY_RESULT" != "$3" ] && _STATE_NOTE "verify_result=$3"
	_EMIT_TRAILER "git-edit: paused – mode change at ${1:0:7} in $2; then 'git edit --continue' (re-check), '--allow-mode-change --continue' (apply anyway), or 'git edit --abort'"
	_STATUS_EMITTED=true
}

# Emits whichever gate refused a built result – the mode guard's pause, else the verify's
EMIT_GATE_PAUSED () {
	# Args: <worktree-path> [<result-tip>]
	if [ -n "$_MODE_STRAY_AT" ]; then
		EMIT_MODE_PAUSED "$_MODE_STRAY_AT" "$1" "$2"
	else
		EMIT_VERIFY_PAUSED "$_VERIFY_FAILED" "$1" "$2"
	fi
}

# Prints the conflict context – unmerged files, the step we paused on, and what remains, so
# the resolver can tell a single resolution from a likely cascade
# Echoes the unmerged files comma-separated to stdout for the trailer, the rest to stderr
_PRINT_CONFLICT_DETAIL () {
	local WT=$1
	# Pre-op tip, passed by the reorder paths only – see the final-step hint below
	local PREOP=$2
	# The failed continue's captured output, passed by the resume paths – shown
	# where no unmerged file explains the failure
	local CONTINUE_OUTPUT=$3
	local GITDIR=$(git -C "$WT" rev-parse --git-dir 2>/dev/null)

	# Unmerged paths (files with conflict markers)
	local UNMERGED
	UNMERGED=$(_UNMERGED_IN "$WT")
	if [ -n "$UNMERGED" ]; then
		PRINT_TEXT "Conflicted files:" 33 >&2
		local FILE
		local -a MARKERLESS
		while IFS= read -r FILE; do
			ECHO_E "\e[0;33m  - ${FILE//\\/$_LITB}\e[0m" >&2
			# A marker grep is how drivers decide "resolved" – but four states
			# arrive marker-free, and only one of them is a finished resolution
			_HAS_NEW_MARKERS "$WT" "$FILE" || MARKERLESS+=("$FILE")
		done <<< "$UNMERGED"
		if [ ${#MARKERLESS[@]} -gt 0 ]; then
			PRINT_TEXT "No conflict markers in %s – an add/add, a modify/delete, a rerere prefill, or a resolution left unstaged all read as finished. Validate the content, then stage it to resolve." 33 "${(j:, :)MARKERLESS}" >&2
		fi
	fi

	# Currently-failing rebase step (last line of the done log)
	if [ -f "$GITDIR/rebase-merge/done" ]; then
		local LAST_STEP
		LAST_STEP=$(tail -1 "$GITDIR/rebase-merge/done" 2>/dev/null)
		if [ -n "$LAST_STEP" ]; then
			PRINT_TEXT "Currently failing on:" 33 >&2
			ECHO_E "\e[0;33m  ${LAST_STEP//\\/$_LITB}\e[0m" >&2
		fi
	fi

	# Remaining rebase steps (after the conflict resolves)
	local REMAINING=""
	if [ -f "$GITDIR/rebase-merge/git-rebase-todo" ]; then
		REMAINING=$(_REBASE_TODO_LEFT "$GITDIR")
		if [ -n "$REMAINING" ]; then
			PRINT_TEXT "Remaining steps (after resolution):" 33 >&2
			local STEP
			while IFS= read -r STEP; do
				ECHO_E "\e[0;33m  ${STEP//\\/$_LITB}\e[0m" >&2
			done <<< "$REMAINING"
		fi
	fi

	# Which remaining steps touch a conflicted file – each reapplies its own change on top, so
	# the resolution is the content before they replay, never their result folded in early
	# Todo commands are read textually and walked in one `git log`, so replay length is free
	if [ -n "$UNMERGED" ] && [ -n "$REMAINING" ]; then
		local -a TODO_SHAS TODO_WORDS
		local TODO WORD
		for TODO in ${(f)REMAINING}; do
			TODO_WORDS=(${(z)TODO})
			case ${TODO_WORDS[1]} in
				pick|p|reword|r|edit|e|fixup|f|squash|s) ;;
				*) continue ;;
			esac
			# The object is not always the second word – `amend!` autosquashes
			# into `fixup -C <sha>`, and one bad rev would take the whole walk
			# down with it
			for WORD in "${TODO_WORDS[@]:1}"; do
				if [[ "$WORD" =~ '^[0-9a-f]{7,}$' ]]; then
					TODO_SHAS+=("$WORD")
					break
				fi
			done
		done
		if [ ${#TODO_SHAS[@]} -gt 0 ]; then
			# `%h %s` records are marked with a byte no path can start with, so the walk's own output
			# separates the headers from the names – read NUL-separated, as the line form C-quotes a
			# name with a quote or backslash, and the first after a header leads with a newline
			local -a WALKED
			WALKED=("${(@0)$(git -C "$WT" log -z --no-walk=unsorted --root --ignore-missing --format=$'\1%h %s' --name-only "${TODO_SHAS[@]}" 2>/dev/null)}")
			local -A TOUCHED_BY
			local SUBJECT="" LINE
			for LINE in "${WALKED[@]}"; do
				LINE=${LINE#$'\n'}
				if [[ "$LINE" == $'\1'* ]]; then
					SUBJECT=${LINE#$'\1'}
				elif [ -n "$LINE" ] && [[ $'\n'"$UNMERGED"$'\n' == *$'\n'"$LINE"$'\n'* ]]; then
					TOUCHED_BY[$LINE]+="$SUBJECT"$'\n'
				fi
			done
			if [ ${#TOUCHED_BY[@]} -gt 0 ]; then
				PRINT_TEXT "Remaining steps also touch a conflicted file – resolve to the state before they replay:" 33 >&2
				local FILE_KEY TOUCHER
				while IFS= read -r FILE_KEY; do
					[ -z "${TOUCHED_BY[$FILE_KEY]}" ] && continue
					ECHO_E "\e[0;33m  ${FILE_KEY//\\/$_LITB}\e[0m" >&2
					for TOUCHER in ${(f)TOUCHED_BY[$FILE_KEY]}; do
						ECHO_E "\e[0;33m    ${TOUCHER//\\/$_LITB}\e[0m" >&2
					done
				done <<< "$UNMERGED"
			fi
		fi
	fi

	# Reordering preserves the tree, so its final step has one determined result – the pre-op
	# content – while earlier steps rebuild an intermediate that never existed, so their
	# content is authored rather than derived
	if [ -n "$PREOP" ] && [ -n "$UNMERGED" ] && [ -s "$GITDIR/rebase-merge/end" ]; then
		local -a STEPS=(${=$(_REBASE_STEP "$GITDIR")})
		local STEP_NOW=${STEPS[1]}
		local STEP_END=${STEPS[2]}
		if [ "$STEP_NOW" = "$STEP_END" ]; then
			PRINT_TEXT "Final step – a reorder preserves the tree, so the resolution is exactly the pre-op content:" 33 >&2
			ECHO_E "\e[0;33m  $(_LIT "git -C $(_SHQ "$WT") checkout ${PREOP:0:12} -- $(_QUOTE_PATHS "${(@f)UNMERGED}")")\e[0m" >&2
			ECHO_E "\e[0;33m  git edit --continue\e[0m" >&2
		else
			PRINT_TEXT "Step %s rebuilds a state that never existed – author its content rather than deriving it:" 33 "$STEP_NOW/$STEP_END" >&2
			ECHO_E "\e[0;33m  'git apply --3way' cannot work here at all (mid-rebase the paths sit at conflicted stages, not stage 0),\e[0m" >&2
			ECHO_E "\e[0;33m  and reverse-applying the other commit's diff tends to fail once its context has shifted.\e[0m" >&2
		fi
	fi

	# No conflicted files under a paused rebase means nothing left to resolve – a staged tree
	# matching `HEAD` proves the step went empty, where staged content instead means the
	# continue failed some other way and the skip hint would throw it away
	if [ -z "$UNMERGED" ] && [ -d "$GITDIR/rebase-merge" ]; then
		if git -C "$WT" diff --cached --quiet HEAD 2>/dev/null; then
			PRINT_TEXT "No conflicted files – the current step became empty: its changes are already upstream, or a resolution replayed within this run produced them. Skipping drops that commit. Then continue:" 33 >&2
			ECHO_E "\e[0;33m  $(_LIT "git -C $(_SHQ "$WT") rebase --skip")\e[0m" >&2
			ECHO_E "\e[0;33m  git edit --continue\e[0m" >&2
		else
			PRINT_TEXT "No conflicted files, yet staged changes remain – the continue failed without leaving a conflict. Retry: git edit --continue" 33 >&2
			# Which bookkeeping files the paused rebase holds – a continue that
			# refuses over staged changes means `message` went missing at the
			# stop, and the present-vs-absent pattern names where that failed
			PRINT_TEXT "Rebase bookkeeping present: %s" 33 "$(ls "$GITDIR/rebase-merge" 2>/dev/null | tr '\n' ' ')" >&2
		fi
		if [ -n "$CONTINUE_OUTPUT" ]; then
			# -15: git's refusals put the error above a multi-paragraph advice
			# block, which a short tail would show instead of the cause
			PRINT_TEXT "The continue itself said:" 33 >&2
			print -r -- "$CONTINUE_OUTPUT" | tail -15 | _CARET_LINES --crlf | LC_ALL=C sed 's/^/  /' >&2
		fi
	fi

	# The unmerged list on stdout for the trailer
	print -r -- "$UNMERGED"
}

# Names the file-mode changes a rewrite landed, tip vs pre-op tip – a diffstat shows line
# counts only, so a changed executable bit rides invisibly and resurfaces as a phantom
# mode-only diff, and `--onto` is exempt since its tip diff carries the upstream's changes
_PRINT_MODE_CHANGES () {
	# Args: <old-tip> <new-tip>
	# Not `LINES` – that name is zsh's tied terminal-height integer, which
	# rejects the assignment as a math error
	local MODE_LINES
	MODE_LINES=$(git diff --summary "$1" "$2" 2>/dev/null | LC_ALL=C grep -a '^ mode change')
	[ -z "$MODE_LINES" ] && return 0
	PRINT_TEXT "Mode changes landed:" 33
	print -r -- "$MODE_LINES" | _CARET_LINES | LC_ALL=C sed "s/^ /  /;s/^/${_DIM}/;s/\$/${_OFF}/"
}

# Resolves the canonical ref name to report – `$ORIG_BRANCH` when set, since `-C` mode
# captures it before entering a detached worktree, else the symbolic ref, else "HEAD"
_CURRENT_REF () {
	if [ -n "$ORIG_BRANCH" ]; then
		echo "refs/heads/$ORIG_BRANCH"
		return
	fi
	local B=${$(git symbolic-ref -q HEAD 2>/dev/null)#refs/heads/}
	if [ -n "$B" ]; then
		echo "refs/heads/$B"
	else
		echo "HEAD"
	fi
}

# Prints the success banner and status trailer together
PRINT_COMPLETED () {
	# Args: <new_head_sha> <ref> <changed:true|false> [<note on "unchanged">]
	[ -n "$_PAD" ] && ECHO_E "${_PAD}\e[1;92mgit edit completed.\e[0m"
	EMIT_STATUS "$1" "$2" "$3" "$4"
}

# Reports whether a commit already exists on a remote – unlike `_GUARD_UNPUSHED` it only says so,
# and ignores `--allow-pushed` so callers can still tell shared history apart after consent
_IS_PUSHED () {
	[ -n "$(_REMOTES_CONTAINING "$1")" ]
}

# Lists the remote-tracking branches holding <commit>, one a line, their `origin/HEAD` aliases left
# out – through `for-each-ref`, as `git branch` lays its list out in a caller's columns and colors
_REMOTES_CONTAINING () {
	git for-each-ref --contains "$1" --format='%(if)%(symref)%(then)%(else)%(refname:short)%(end)' refs/remotes 2>/dev/null | LC_ALL=C grep -a .
}

# Refuses a commit that already exists on a remote – guarding the oldest commit an operation
# touches covers the whole span, since every descendant of an unpushed commit is unpushed too
# Override with `--allow-pushed`
_GUARD_UNPUSHED () {
	[ ${#OPT_ALLOW_PUSHED} -gt 0 ] && return 0
	local C=$1
	local CONTAINING=$(_REMOTES_CONTAINING "$C" | head -3 | tr '\n' ' ' | LC_ALL=C sed 's/ $//')
	if [ -n "$CONTAINING" ]; then
		PRINT_ERR "Commit ${C:0:7} is already pushed (on: $CONTAINING)"
		ECHO_E "\e[0;31m  Rewriting pushed history disrupts collaborators – pass --allow-pushed to override.\e[0m" >&2
		exit 1
	fi
}

# Computes the stable patch id of a commit's own diff – the same change keeps it across a rewrite,
# the SHA and tree move, and `--root` gets the initial commit one instead of an empty diff
_PATCH_ID () {
	git diff-tree -p --root "$1" 2>/dev/null | git patch-id --stable 2>/dev/null | awk '{print $1}'
}

# Finds the current identity of a rewritten commit, echoing "<sha> <how>" – an identical patch
# id proves the same change and is acted on, while a fold keeps only the subject and is merely
# suggested, both needing a unique match, with a pushed hit left to the pushed guard
_RESOLVE_STALE () {
	# Args: <commit> [<tip>] – the history searched is `HEAD`'s unless a tip is named
	local C=$1
	local TIP=${2:-HEAD}
	local -a MATCHES
	local HIT

	# Every rewrite preserves the author date, so it prunes the patch-id scan to a handful and
	# can only narrow the field – a candidate dropped here could only have been a false match
	# One past the ceiling notices a view too large to call unique, so it falls back to suggesting
	local WHEN=$(git log -1 --format='%aI' "$C" 2>/dev/null)
	local WANT=$(_PATCH_ID "$C")
	if [ -n "$WHEN" ] && [ -n "$WANT" ]; then
		local -a POOL
		POOL=($(git log --format='%H %aI' "$TIP" 2>/dev/null \
			| awk -v w="$WHEN" '$2 == w { print $1 }' | head -$((RESOLVE_SCAN_MAX + 1))))
		if [ ${#POOL[@]} -gt 0 ] && [ ${#POOL[@]} -le $RESOLVE_SCAN_MAX ]; then
			MATCHES=()
			for HIT in "${POOL[@]}"; do
				[ "$(_PATCH_ID "$HIT")" = "$WANT" ] && MATCHES+=("$HIT")
			done
			if [ ${#MATCHES[@]} -eq 1 ]; then
				echo "${MATCHES[1]} patch-id"
				return 0
			fi
		fi
	fi

	# One `git log` pass, so no ceiling is needed here – the SHA is stripped by field rather
	# than by splitting on tabs, so a subject containing one still compares whole, and it
	# arrives through the environment, as `-v` would read its backslashes as escapes
	local SUBJECT=$(git log -1 --format='%s' "$C" 2>/dev/null)
	if [ -n "$SUBJECT" ]; then
		MATCHES=($(git log --format='%H%x09%s' "$TIP" 2>/dev/null \
			| S=$SUBJECT awk '{ sha = $1; sub(/^[^\t]*\t/, ""); if ($0 == ENVIRON["S"]) print sha }'))
		if [ ${#MATCHES[@]} -eq 1 ]; then
			echo "${MATCHES[1]} subject"
			return 0
		fi
	fi
	return 1
}

# Resolves a commit to its current identity in `_RESOLVED_SHA`, or refuses – a miss is usually
# a stale SHA an earlier rewrite orphaned, so a proven match is substituted outright and a
# merely likely one only named, and the global lets `exit` abort with the trailer intact
_GUARD_REACHABLE () {
	local C=$1
	_RESOLVED_SHA=$C
	if git merge-base --is-ancestor "$C" HEAD 2>/dev/null; then
		# Normalize short SHAs/refs to the full SHA – downstream exact-match
		# steps (topo sort's `grep -Fx`, rebuild maps) silently miss otherwise,
		# falling back to the tie-prone timestamp sort
		_RESOLVED_SHA=$(git rev-parse "$C^{commit}" 2>/dev/null)
		return 0
	fi

	local SUBJECT=$(git log -1 --format='%s' "$C" 2>/dev/null)
	if [ -z "$SUBJECT" ]; then
		PRINT_ERR "Commit ${C:0:7} does not exist in this repository"
		exit 1
	fi

	local -a RESOLVED
	[ ${#GIT_EDIT_NO_RESOLVE} -eq 0 ] && RESOLVED=($(_RESOLVE_STALE "$C"))

	# An inferred target never reaches pushed history, even under `--allow-pushed` – that flag
	# consents to the commit the caller named, not to one resolved on its behalf, so where a
	# guess would compound with a shared-history rewrite, name the match and let them ask
	if [ "${RESOLVED[2]}" = "patch-id" ] && _IS_PUSHED "${RESOLVED[1]}"; then
		PRINT_ERR "Commit ${C:0:7} ($SUBJECT) is not in HEAD's history – it was likely rewritten"
		ECHO_E "\e[0;31m  Its only match ${RESOLVED[1]:0:12} is already pushed – name it explicitly to rewrite it.\e[0m" >&2
		exit 1
	fi

	if [ "${RESOLVED[2]}" = "patch-id" ]; then
		PRINT_TEXT "Commit %s was rewritten – using its current identity %s (identical diff)" 33 \
			"${C:0:7}" "${RESOLVED[1]:0:12}"
		_RESOLVED_SHA=${RESOLVED[1]}
		return 0
	fi

	PRINT_ERR "Commit ${C:0:7} ($SUBJECT) is not in HEAD's history – it was likely rewritten"
	if [ "${RESOLVED[2]}" = "subject" ]; then
		ECHO_E "\e[0;31m  Its counterpart on HEAD is ${RESOLVED[1]:0:12} (same subject, changed content) – retry with that.\e[0m" >&2
	else
		ECHO_E "\e[0;31m  Re-read the current SHAs with 'git log' before retrying.\e[0m" >&2
	fi
	exit 1
}

# Refuses a merge in the span, since rebase-based modes replay every commit up to `HEAD` and
# drops merge commits without a word – so refuse, since the plumbing modes rebuild them whole
_GUARD_NO_MERGE_SPAN () {
	local BASE=$1
	local SPAN="HEAD"
	git rev-parse --verify -q "$BASE^" >/dev/null 2>&1 && SPAN="$BASE^..HEAD"
	local MERGES=$(git rev-list --merges --count "$SPAN" 2>/dev/null)
	if [ "${MERGES:-0}" -gt 0 ]; then
		PRINT_ERR "Span ${BASE:0:7}..HEAD contains a merge commit – this rebase-based mode would silently flatten it"
		ECHO_E "\e[0;31m  Merge-preserving alternatives: -M / -S / --split (plumbing), or --exec with 'git rebase --rebase-merges ...' deliberately.\e[0m" >&2
		exit 1
	fi
}

# Names the journal of completed ref moves, one line each ("<epoch> <ref> <old> <new> <label>", a
# tab and the caller's label closing a labeled run's), in the common git dir so worktrees share
# it – powers `--undo` and `--status`'s last-operation report
_JOURNAL_FILE_PATH () {
	local DIR=$(git rev-parse --git-common-dir 2>/dev/null)
	[ -z "$DIR" ] && return 1
	case "$DIR" in
		/*) ;;
		*) DIR="$(pwd)/$DIR" ;;
	esac
	print -r -- "$DIR/git-edit-journal"
}

# Takes the journal's lock, as git takes the index's – every append and an undo's rewrite hold it, so
# none lands between an undo's read and its write – breaking one a killed run left past 10 s
_JOURNAL_LOCK () {
	# Args: <journal>
	local -i W=0
	local -a STALE
	until ( setopt noclobber; print -r -- $$ > "$1.lock" ) 2>/dev/null; do
		if (( ++W <= 50 )); then
			sleep 0.1
			continue
		fi
		# Moved aside and checked again there before it goes – a waiter losing that race to another
		# moved a fresh lock, which goes back
		STALE=("$1".lock(Nms+10))
		(( ${#STALE} )) && mv -f "$1.lock" "$1.lock.$$" 2>/dev/null || return 1
		STALE=("$1".lock.$$(Nms+10))
		(( ${#STALE} )) || { ln "$1.lock.$$" "$1.lock" 2>/dev/null; rm -f "$1.lock.$$"; return 1; }
		rm -f "$1.lock.$$"
	done
	# Let go of however the run ends
	_TEMP_FILES+=("$1.lock")
	return 0
}

_JOURNAL_UNLOCK () {
	# Args: <journal>
	rm -f "$1.lock"
	_TEMP_FILES=("${(@)_TEMP_FILES:#${(b)1}.lock}")
}

# Runs a branch's CAS `update-ref`, the run landing from here on unless it is refused
_MOVE_REF () {
	# Args: <update-ref command, its last three words the ref, the new tip and the old>
	local ERR
	local -a W
	_LANDING=true
	ERR=$( { eval "$1" } 2>&1 >/dev/null ) && return 0
	local RC=$?
	_LANDING=false
	# A hook vetoing the transaction leaves the ref where the run read it – refused, not moved, as
	# the caller's message would have it
	W=("${(@Q)${(z)1}}")
	if [ "$(git rev-parse -q --verify "${W[-3]}" 2>/dev/null)" = "${W[-1]}" ]; then
		PRINT_ERR "git refused to move ${W[-3]#refs/heads/}, still at the tip this run read – nothing was applied${ERR:+: ${ERR%%$'\n'*}}"
		_PAUSE_EXIT 1 retry
	fi
	return $RC
}

# Names the push that publishes a rewrite of pushed history – its lease pinned to the upstream as
# the rewrite found it, since a background fetch moving the remote-tracking ref turns a bare
# `--force-with-lease` into a plain force
_PRINT_FORCE_PUSH () {
	# Args: <ref> <old> <new>
	[[ "$1" == refs/heads/* ]] || return 0
	local B=${1#refs/heads/} UP REMOTE MERGE
	UP=$(git rev-parse -q --verify "$B@{upstream}" 2>/dev/null) || return 0
	# Only where this run took the upstream's commits off the branch – behind it, a push needed a
	# force before, and ahead of it, none
	git merge-base --is-ancestor "$UP" "$2" 2>/dev/null || return 0
	git merge-base --is-ancestor "$UP" "$3" 2>/dev/null && return 0
	REMOTE=$(git config --get "branch.$B.remote")
	MERGE=$(git config --get "branch.$B.merge")
	[ -n "$REMOTE" ] && [ "$REMOTE" != . ] && [[ "$MERGE" == refs/heads/* ]] || return 0
	local DST=${MERGE#refs/heads/} SPEC=$B
	[ "$DST" = "$B" ] || SPEC="$B:$DST"
	PRINT_TEXT "Pushed history rewritten – publish it with: %s" 33 "git push --force-with-lease=$(_SHQ "$DST"):$UP $(_SHQ "$REMOTE") $(_SHQ "$SPEC")"
}

# Records a completed CAS ref move – appends a journal entry and prints the inverse command,
# so recovery is plain git rather than knowledge of this script, also via `git edit --undo`
# Warns about tags left pointing into the rewritten span, which surface only at release time,
# and names the branches left there, which it never moves
_RECORD_REF_MOVE () {
	# Args: <ref> <old> <new> <label>
	_LANDED_MOVE="$1 moved $2 → $3"
	# The trailer names the move made, from the tip it swapped – a resume's differs from the one paused
	SCRIPT_INITIAL_HEAD=$2
	local JF=$(_JOURNAL_FILE_PATH)
	local TAB=$'\t'
	# An append is whole without the lock too – held past ~5 s, it goes in all the same, as only an
	# undo rewriting the journal that moment could lose it
	if [ -n "$JF" ]; then
		if _JOURNAL_LOCK "$JF"; then
			print -r -- "$(date +%s) $1 $2 $3 $4${_ACTOR:+$TAB$_ACTOR}" >> "$JF"
			_JOURNAL_UNLOCK "$JF"
		else
			print -r -- "$(date +%s) $1 $2 $3 $4${_ACTOR:+$TAB$_ACTOR}" >> "$JF"
			PRINT_TEXT "Journaled without its lock, held past 5 s: %s" 33 "$JF.lock"
		fi
	fi
	[ -n "$_ACTOR_MAPPED" ] && PRINT_TEXT "Labeled %s – GIT_EDIT_ACTOR keeps letters, digits, _ and - alone, the rest mapped to _" 33 "$_ACTOR"
	ECHO_E "\e[0;90mUndo: git edit --undo  (or: git update-ref $(_LIT "$(_SHQ "$1")") $2 $3)\e[0m"
	_PRINT_FORCE_PUSH "$1" "$2" "$3"
	_CAPTURE_COLLECT "$2" "$3"

	# A tag is orphaned where the old tip reached it and the new one doesn't, its counterpart named
	# where one commit in the span shares its subject – two `--merged` walks, as tags on pushed
	# history reach both tips, through `for-each-ref`, as `git tag` lists in a caller's columns
	local ORPHANED_TAGS=$(comm -23 <(git for-each-ref refs/tags --merged "$2" --format='%(refname)' 2>/dev/null | sort) <(git for-each-ref refs/tags --merged "$3" --format='%(refname)' 2>/dev/null | sort))
	local TAGREF TAG TAGSHA TSUBJ CAND RETAG TNOTE
	for TAGREF in ${(f)ORPHANED_TAGS}; do
		TAG=${TAGREF#refs/tags/}
		TAGSHA=$(git rev-parse "$TAGREF^{commit}" 2>/dev/null)
		[ -z "$TAGSHA" ] && continue
		TSUBJ=$(git log -1 --format='%s' "$TAGSHA")
		# Compared whole, as the stale-SHA resolver compares one – a `|` or backslash in it included
		CAND=$(git log --format='%H%x09%s' "$2..$3" 2>/dev/null | S=$TSUBJ awk '{ sha = $1; sub(/^[^\t]*\t/, ""); if ($0 == ENVIRON["S"]) print sha }')
		# The subject goes above the command, never after it – pasted into a shell that reads no `#`
		# comments, an interactive zsh's default, it would run
		# An annotated tag re-made keeps its message, which a plain `git tag -f` would drop with the
		# tag object – a signature it can only make anew
		RETAG="git tag -f $(_SHQ "$TAG")" TNOTE=""
		if [ "$(git cat-file -t "$TAGREF" 2>/dev/null)" = tag ]; then
			RETAG="git for-each-ref --format='%(contents:subject)%0a%0a%(contents:body)' $(_SHQ "$TAGREF") | git tag -f -a -F - $(_SHQ "$TAG")"
			TNOTE="An annotated tag – the command keeps its message"
			[ -n "$(git for-each-ref --format='%(contents:signature)' "$TAGREF" 2>/dev/null)" ] && TNOTE+=", though not its signature: add -s to sign it anew"
		fi
		if [ -n "$CAND" ] && [ "$(print -r -- "$CAND" | wc -l | tr -d ' ')" = "1" ]; then
			PRINT_TEXT "Tag %s points into the rewritten span – re-point it to its counterpart, the same subject: %s" 33 "$TAG" "$TSUBJ"
			ECHO_E "\e[0;33m  $(_LIT "$RETAG") ${CAND:0:12}\e[0m"
		else
			PRINT_TEXT "Tag %s points into the rewritten span – re-point it or it stays on pre-rewrite history:" 33 "$TAG"
			ECHO_E "\e[0;33m  $(_LIT "$RETAG") <its counterpart in the new span>\e[0m"
		fi
		[ -n "$TNOTE" ] && PRINT_TEXT "%s" 90 "$TNOTE"
	done

	# A branch left in the span is named the same way rather than moved – git's `rebase.updateRefs`
	# moves one as its rebase completes, ahead of the verify and the CAS, so every rebase here pins
	# it off, or an abort or a refused CAS would leave that branch rewritten
	local STRANDED=$(comm -23 <(git for-each-ref refs/heads --merged "$2" --format='%(refname) %(worktreepath)' 2>/dev/null | sort) <(git for-each-ref refs/heads --merged "$3" --format='%(refname) %(worktreepath)' 2>/dev/null | sort))
	local ENTRY BREF BSHA HIT PAIR NAMED=false
	for ENTRY in ${(f)STRANDED}; do
		BREF=${ENTRY%% *}
		BSHA=$(git rev-parse "$BREF")
		# The rebuild's own record is exact – where a rebase kept none, the stale-SHA rule decides
		HIT=""
		for PAIR in "${_REWRITE_PAIRS[@]}"; do
			if [ "${PAIR%% *}" = "$BSHA" ]; then
				HIT="${PAIR#* } patch-id"
				break
			fi
		done
		[ -z "$HIT" ] && HIT=$(_RESOLVE_STALE "$BSHA" "$3")
		# A branch checked out in a worktree is that worktree's to move, as git's own update leaves
		# it – but skipping it silently reads exactly like no stranded branch at all, while it sits
		# on pre-rewrite history either way. So name it and its counterpart and stop there: the move
		# is that checkout's to make, over whatever work is sitting in it, and a command prescribed
		# from here would be one aimed at someone else's worktree
		if [ -n "${ENTRY#* }" ]; then
			PRINT_TEXT "Branch %s points into the rewritten span, checked out in %s – that checkout's to move:" 33 "${BREF#refs/heads/}" "${ENTRY#* }"
			if [ "${HIT#* }" = "patch-id" ]; then
				ECHO_E "\e[0;33m  its counterpart here is ${HIT:0:12} – the same change: $(_LIT "$(git log -1 --format=%s "$BSHA")")\e[0m"
			elif [ -n "$HIT" ]; then
				ECHO_E "\e[0;33m  its counterpart here is ${HIT:0:12} – the same subject: $(_LIT "$(git log -1 --format=%s "$BSHA")")\e[0m"
			else
				ECHO_E "\e[0;33m  its counterpart in the new span is unresolved\e[0m"
			fi
			NAMED=true
			continue
		fi
		if [ "${HIT#* }" = "patch-id" ]; then
			PRINT_TEXT "Branch %s points into the rewritten span – if it should follow the rewrite, to its counterpart, the same change: %s" 33 "${BREF#refs/heads/}" "$(git log -1 --format=%s "$BSHA")"
			ECHO_E "\e[0;33m  git branch -f $(_LIT "$(_SHQ "${BREF#refs/heads/}")") ${HIT:0:12}\e[0m"
		elif [ -n "$HIT" ]; then
			PRINT_TEXT "Branch %s points into the rewritten span – if it should follow the rewrite, to its counterpart, the same subject: %s" 33 "${BREF#refs/heads/}" "$(git log -1 --format=%s "$BSHA")"
			ECHO_E "\e[0;33m  git branch -f $(_LIT "$(_SHQ "${BREF#refs/heads/}")") ${HIT:0:12}\e[0m"
		else
			PRINT_TEXT "Branch %s points into the rewritten span – if it should follow the rewrite:" 33 "${BREF#refs/heads/}"
			ECHO_E "\e[0;33m  git branch -f $(_LIT "$(_SHQ "${BREF#refs/heads/}")") <its counterpart in the new span>\e[0m"
		fi
		NAMED=true
	done
	if [ "$NAMED" = "true" ] && [ "$(git config --type=bool --get rebase.updateRefs 2>/dev/null)" = "true" ]; then
		ECHO_E "\e[0;90m  rebase.updateRefs is set, but git edit moves only the branch it rewrites\e[0m"
	fi

	_EMIT_REWRITES
	# Both run after the copy above, so they report only what the rewrite
	# actually failed to carry rather than everything it touched – and here
	# rather than per-mode, since every landing passes through this call
	_PRINT_LEFT_NOTES "$2" "$3"
	_PRINT_LOST_SIGNATURES "$2" "$3"
}

# The plumbing modes compose commits with `commit-tree`, which runs none of a rebase's
# machinery, so anything keyed to a SHA is orphaned by them while surviving `-d` or `--move`
# Every rebuild records its old->new pair here for the CAS to hand git's own two interfaces
_REWRITE_PAIRS=()

_RECORD_REWRITE () {
	_REWRITE_PAIRS+=("$1 $2")
}

_EMIT_REWRITES () {
	# A held-back list that a hand-typed `git rebase --continue` let git deliver is not delivered twice
	if [ ${#_REWRITE_PAIRS[@]} -eq 0 ] || [ "$_REWRITES_GIT_DELIVERED" = "true" ]; then
		_REWRITE_PAIRS=()
		_CAPTURE_DISCARD
		return 0
	fi
	local MAP=${(F)_REWRITE_PAIRS}
	print -r -- "$MAP" | git notes copy --for-rewrite=rebase 2>/dev/null
	# `git hook run` reaches hooks defined in config as well as the file, as git's own run does –
	# from 2.40, which gave it `--to-stdin`, while a release that old knows only the file
	if _HOOK_RUN_AVAILABLE; then
		local IN=$(MKTEMP_FILE git-edit-rewrites)
		_TEMP_FILES+=("$IN")
		print -r -- "$MAP" > "$IN"
		git hook run --ignore-missing --to-stdin="$IN" post-rewrite -- rebase
		rm -f "$IN"
	else
		# To stderr, as git runs every hook – its output stays out of the stdout a caller parses
		local HOOK=$(git rev-parse --git-path hooks/post-rewrite 2>/dev/null)
		if [ -n "$HOOK" ] && [ -x "$HOOK" ]; then
			print -r -- "$MAP" | "$HOOK" rebase >&2
		fi
	fi
	# One ref move reports one rewrite – a mode that moves twice must not replay
	# the first move's pairs into the second
	_REWRITE_PAIRS=()
	_CAPTURE_DISCARD
}

# Whether `git hook run` takes `--to-stdin` (git 2.40), probed once per run
_HOOK_RUN_PROBED=""
_HOOK_RUN_AVAILABLE () {
	if [ -z "$_HOOK_RUN_PROBED" ]; then
		_HOOK_RUN_PROBED=no
		[[ "$( export LC_ALL=C; git hook run -h 2>&1 )" == *"--to-stdin"* ]] && _HOOK_RUN_PROBED=yes
	fi
	[ "$_HOOK_RUN_PROBED" = yes ]
}

# A rebase route's rewrite delivery, held back for the landing to make – git copies notes and
# runs `post-rewrite` as its rebase finishes, ahead of the verify and the CAS, so an aborted or
# refused rewrite used to be announced as one (see `_CAPTURE_BEGIN`)
_CAPTURE_REWRITES=false
_CAPTURE_DIR=""
_CAPTURE_PIN_ARGS=()
_CAPTURE_PINS=""
_CAPTURE_EXEC_ARGS=()
_CAPTURE_EXEC=""
_REWRITES_GIT_DELIVERED=false

# Whether anything consumes a rewrite's old->new list – a `post-rewrite` hook, a file or one
# defined in config, or notes told to follow rewrites – since only then is there one to hold back
_REWRITE_CONSUMED () {
	[ -n "$GIT_NOTES_REWRITE_REF" ] && return 0
	[ -n "$(git config --get-all notes.rewriteRef 2>/dev/null)" ] && return 0
	local HOOK=$(git rev-parse --path-format=absolute --git-path hooks/post-rewrite 2>/dev/null)
	[ -n "$HOOK" ] && [ -x "$HOOK" ] && return 0
	git config --get-regexp '^hook\..*\.event$' 2>/dev/null | awk '$2 == "post-rewrite" { found = 1 } END { exit !found }'
}

# Arms the hold-back for a rebase in an isolated worktree – git's notes copy and `post-rewrite` run
# are pinned off, and an `--exec` step after every pick saves the list git would have handed them,
# for `_CAPTURE_COLLECT` to deliver once the CAS has landed
_CAPTURE_BEGIN () {
	# Args: [resume <dir>] – a paused run re-arms around the list its dir has already saved
	local SF
	SF=$(_STATE_FILE_PATH) || return 0
	if [ "$1" = "resume" ]; then
		[[ "$2" == */git-edit-capture.?* ]] || return 0
		_CAPTURE_DIR=$2
		mkdir -p "$_CAPTURE_DIR" || return 0
	else
		_REWRITE_CONSUMED || return 0
		# A dir of its own per run – runs overlap in a shared checkout, and under one fixed name a
		# second run discarded the list the first had saved, which then landed unannounced
		_CAPTURE_DIR=$(mktemp -d "${SF:h}/git-edit-capture.XXXXXX" 2>/dev/null) || return 0
	fi
	_CAPTURE_REWRITES=true
	# Only the rebase's last step can tell who delivers – run without these pins (a `git rebase
	# --continue` typed into the pause worktree), git delivers the list itself as that run finishes,
	# while an earlier step typed in by hand leaves the delivery to whichever run takes the last
	local LIST=$_CAPTURE_DIR/rewrites
	local MARK=$_CAPTURE_DIR/delivered
	local SCRIPT=$_CAPTURE_DIR/step.sh
	{
		print -r -- '#!/bin/sh'
		print -r -- 'D=$(git rev-parse --git-path rebase-merge 2>/dev/null)'
		print -r -- "[ -f \"\$D/rewritten-list\" ] && cp \"\$D/rewritten-list\" ${(qq)LIST}"
		print -r -- "if ! grep -qvE '^(#|\$)' \"\$D/git-rebase-todo\" 2>/dev/null; then"
		print -r -- "	if [ \"\$(git config --get edit.captureRewrites)\" = 1 ]; then rm -f ${(qq)MARK}; else : > ${(qq)MARK}; fi"
		print -r -- 'fi'
		print -r -- 'exit 0'
	} > "$SCRIPT"
	_CAPTURE_PIN_ARGS=(-c notes.rewrite.rebase=false -c notes.rewrite.amend=false -c hook.post-rewrite.enabled=false -c edit.captureRewrites=1)
	# That switch holds back hooks defined in config but never a hook file, so a file is held back by
	# a hooks dir running every other hook from its own path – symlinks followed, as managers link them
	local HOOKS=$(git rev-parse --path-format=absolute --git-path hooks 2>/dev/null)
	local WRAPPERS=$_CAPTURE_DIR/hooks
	rm -rf "$WRAPPERS"
	if [ -n "$HOOKS" ] && [ -x "$HOOKS/post-rewrite" ]; then
		mkdir -p "$WRAPPERS"
		local H
		for H in "$HOOKS"/*(N-.x); do
			[ "${H:t}" = "post-rewrite" ] && continue
			printf '#!/bin/sh\nexec %s "$@"\n' "${(qq)H}" > "$WRAPPERS/${H:t}"
			chmod +x "$WRAPPERS/${H:t}"
		done
		_CAPTURE_PIN_ARGS+=(-c "core.hooksPath=$WRAPPERS")
	fi
	# Both forms – the arrays for a command run as is, the quoted strings for one built up and `eval`d
	_CAPTURE_PINS=${(j: :)${(q)_CAPTURE_PIN_ARGS[@]}}
	_CAPTURE_EXEC_ARGS=(--exec "sh ${(qq)SCRIPT}")
	_CAPTURE_EXEC=${(j: :)${(q)_CAPTURE_EXEC_ARGS[@]}}
}

# Arms the hold-back for the shared rebase modes, isolated runs only – in the main checkout the
# rebase moves the branch itself, so git's own delivery there comes exactly at the landing
_CAPTURE_BEGIN_ISOLATED () {
	[ -n "$WORKTREE_DIR" ] && _CAPTURE_BEGIN
	return 0
}

# Removes a capture dir, and only one named the way `_CAPTURE_BEGIN` names them – the path is
# read back from the state file too
_CAPTURE_REMOVE () {
	# Args: <dir>
	[[ "$1" == */git-edit-capture.?* ]] && rm -rf "$1"
	return 0
}

# Adds a rewrite the run makes outside any rebase – an edit's amend – to the held-back list
_CAPTURE_RECORD () {
	# Args: <old> <new>
	[ "$_CAPTURE_REWRITES" = "true" ] || return 0
	print -r -- "$1 $2" >> "$_CAPTURE_DIR/extra"
}

# Moves pairs a plumbing step recorded ahead of the rebase into the held-back list, which persists –
# a pause in between would lose them from memory, and the landing follows them on through the rebase
_CAPTURE_HOLD_PAIRS () {
	if [ ${#_REWRITE_PAIRS[@]} -gt 0 ]; then
		print -r -- "${(F)_REWRITE_PAIRS}" >> "$_CAPTURE_DIR/extra"
	fi
	_REWRITE_PAIRS=()
}

# Turns the held-back list into the pairs the landing delivers – git's list runs through the run's
# own steps, so each replaced commit is followed to where it finally landed, and one the run made
# along the way (a fold's `fixup!`) is left out, as the plumbing routes never list one either
_CAPTURE_COLLECT () {
	# Args: <old tip> <new tip>
	[ "$_CAPTURE_REWRITES" = "true" ] || return 0
	_REWRITES_GIT_DELIVERED=false
	[ -f "$_CAPTURE_DIR/delivered" ] && _REWRITES_GIT_DELIVERED=true
	local -A NEXT
	local LINE
	for LINE in "${_REWRITE_PAIRS[@]}" ${(f)"$(cat "$_CAPTURE_DIR/rewrites" "$_CAPTURE_DIR/extra" 2>/dev/null)"}; do
		[ -n "$LINE" ] && NEXT[${LINE%% *}]=${${LINE#* }%% *}
	done
	_REWRITE_PAIRS=()
	local OLD NEW HOPS
	for OLD in ${(f)"$(git rev-list --reverse "$1" --not "$2" 2>/dev/null)"}; do
		NEW=${NEXT[$OLD]}
		[ -z "$NEW" ] && continue
		HOPS=0
		while [ -n "${NEXT[$NEW]}" ] && [ $HOPS -lt 1000 ]; do
			NEW=${NEXT[$NEW]}
			HOPS=$((HOPS + 1))
		done
		_REWRITE_PAIRS+=("$OLD $NEW")
	done
}

# Drops a delivered (or discarded) list, so a later landing in the same run starts clean
_CAPTURE_DISCARD () {
	[ "$_CAPTURE_REWRITES" = "true" ] || return 0
	rm -f "$_CAPTURE_DIR/rewrites" "$_CAPTURE_DIR/extra" "$_CAPTURE_DIR/delivered"
}

# Prints a stopped rebase's remaining todo, bar comments and the hold-back's capture steps –
# git-edit's own, run after every pick, and no step a resolver has to reason about
_REBASE_TODO_LEFT () {
	# Args: <git dir holding the rebase>
	LC_ALL=C grep -avE '^(#|$)' "$1/rebase-merge/git-rebase-todo" 2>/dev/null | LC_ALL=C sed '/git-edit-capture\..*step\.sh/d'
}

# Numbers a stopped rebase's current step and its total as `msgnum` and `end` do, but without the
# capture steps, which would double both and keep the last pick from ever reading as final
_REBASE_STEP () {
	# Args: <git dir holding the rebase> – prints "<now> <end>"
	local NOW=$(LC_ALL=C sed '/git-edit-capture\..*step\.sh/d' "$1/rebase-merge/done" 2>/dev/null | LC_ALL=C grep -ac .)
	local LEFT=$(_REBASE_TODO_LEFT "$1" | grep -c .)
	print -r -- "$NOW $((NOW + LEFT))"
}

# Reverts the last journaled ref move, CAS-guarded – refuses where the branch has moved
# since, whose later commit or rewrite would otherwise be discarded, and a run made under another
# label than the caller's, as every session and worktree appends to the one journal
GIT_UNDO () {
	local JF=$(_JOURNAL_FILE_PATH)
	if [ -z "$JF" ] || [ ! -s "$JF" ]; then
		PRINT_ERR "Nothing to undo (no completed git-edit operation on record)"
		exit 1
	fi
	local LINE="" CAND
	local -i I
	local -a ALL F
	ALL=("${(@f)$(<"$JF")}")
	# An undo's own record is passed over, so a further undo takes back the run before
	for (( I = ${#ALL}; I >= 1; I-- )); do
		CAND=${ALL[I]}
		F=(${=${CAND%%$'\t'*}})
		[ "${F[5]}" = undo ] && continue
		LINE=$CAND
		break
	done
	if [ -z "$LINE" ]; then
		PRINT_ERR "Nothing to undo (no completed git-edit operation on record)"
		exit 1
	fi
	local LAST=$LINE
	local RUN_ACTOR=""
	if [[ "$LAST" == *$'\t'* ]]; then
		RUN_ACTOR=${LAST##*$'\t'}
		LAST=${LAST%$'\t'*}
	fi
	local REF=$(print -r -- "$LAST" | awk '{print $2}')
	local OLD=$(print -r -- "$LAST" | awk '{print $3}')
	local NEW=$(print -r -- "$LAST" | awk '{print $4}')
	local LABEL=$(print -r -- "$LAST" | cut -d' ' -f5-)

	# Only a pause on the branch it would move is in the way, whose landing the undo would strand
	if _STATE_EXISTS; then
		local SB=$(LC_ALL=C sed -n 's/^branch=//p' "$(_STATE_FILE_PATH)" 2>/dev/null | head -1)
		if [ -z "$SB" ] || [ "$SB" = "$REF" ]; then
			PRINT_ERR "An operation is in flight${SB:+ on ${SB#refs/heads/}} – finish it with --continue or --abort before undoing"
			exit 1
		fi
	fi

	# An unlabeled caller, a person at a terminal, has no label to tell its own run by
	if [ -n "$_ACTOR" ] && [ "$RUN_ACTOR" != "$_ACTOR" ] && [ ${#OPT_ALLOW_OTHER_ACTOR} -eq 0 ]; then
		PRINT_ERR "The last operation ($LABEL) is another caller's – refusing to take it back"
		ECHO_E "\e[0;31m  It ran as ${RUN_ACTOR:-an unlabeled caller}, this undo as $_ACTOR. A run of your own before it reverts with the 'git update-ref' its output printed – or pass --allow-other-actor to take this one back anyway.\e[0m" >&2
		exit 1
	fi

	PRINT_ACTION "Undoing last operation (%s)..." "${NEW}"

	# Held across the move, so the journal never names a run the branch no longer carries
	if ! _JOURNAL_LOCK "$JF"; then
		PRINT_ERR "The journal is locked by another run – nothing was undone"
		ECHO_E "\e[0;31m  Run it again once that run is done$( [ -e "$JF.lock" ] && print -r -- " – or, where none is running, remove $(_LIT "$(_SHQ "$JF.lock")")").\e[0m" >&2
		exit 1
	fi
	local CMD="git update-ref -m ${(q-)${:-git edit: undo $LABEL$_REFLOG_TAG}} ${(q-)REF} ${(q-)OLD} ${(q-)NEW}"
	PRINT_CMD "$CMD"
	if ! _MOVE_REF "$CMD"; then
		_JOURNAL_UNLOCK "$JF"
		PRINT_ERR "Ref '$REF' has moved since that operation – refusing to rewind over newer work"
		ECHO_E "\e[0;31m  Expected $(_LIT "$REF") at ${NEW:0:7}, found $(git rev-parse --short "$REF" 2>/dev/null).\e[0m" >&2
		exit 1
	fi
	# The undone entry leaves the journal – that line itself, as one appended since by another run
	# sits after it – and the undo goes in as a move of its own, which `--carry` and the landing
	# guards read, while a further `--undo` passes over it to the run before
	local TAB=$'\t'
	local -a JLINES
	JLINES=("${(@f)$(<"$JF")}")
	for (( I = ${#JLINES}; I >= 1; I-- )); do
		[ "${JLINES[I]}" = "$LINE" ] || continue
		JLINES[I]=()
		break
	done
	JLINES+=("$(date +%s) $REF $NEW $OLD undo $LABEL${_ACTOR:+$TAB$_ACTOR}")
	{ print -rl -- "${JLINES[@]}" > "$JF.$$" && mv "$JF.$$" "$JF"; } 2>/dev/null
	_JOURNAL_UNLOCK "$JF"
	SCRIPT_INITIAL_HEAD=$NEW
	PRINT_TEXT "%s" 32 "Undid: $LABEL"
	# The checkout's index and files follow, as after any landing – a terminal's brought along
	_PRINT_REWRITE_APPLY_HINT "${REF#refs/heads/}" "$NEW" "$OLD" undo
	_PRINT_DEFERRED_SIGNAL
	_EMIT_TRAILER "git-edit: ok – $REF moved $NEW → $OLD"
	_STATUS_EMITTED=true
}

# Lists a change's removed and added lines, sorted, to tell that a merge kept the edits whole
_CHANGED_LINES () {
	# Args: <from file> <to file>
	git diff --no-index --no-color --no-ext-diff --no-textconv -U0 -- "$1" "$2" 2>/dev/null | awk 'f && /^[-+]/; /^@@/ {f = 1}' | LC_ALL=C sort
}

# Lists the spans of <from file> a change touches, in half-lines – `2s 2e` for lines s to e it
# rewrites or removes, the point `2s+1` for an insertion after line s – as where an edit sits
# tells it from one beside it, which matching text (a blank line, a `}`) cannot
_CHANGED_SPANS () {
	# Args: <from file> <to file>
	git diff --no-index --no-color --no-ext-diff --no-textconv -U0 --inter-hunk-context=0 -- "$1" "$2" 2>/dev/null | \
		LC_ALL=C sed -nE 's/^@@ -([0-9]+)(,([0-9]+))? .*/\1 \3/p' | \
		awk 'NF { c = (NF < 2) ? 1 : $2; if (c == 0) print 2 * $1 + 1, 2 * $1 + 1; else print 2 * $1, 2 * ($1 + c - 1) }'
}

# Answers whether a rename's destination can take the carry – absent from the checkout, or holding
# byte for byte what checking the rewrite out writes there, as a clean filter can hash an edit away
_CARRY_DEST_FREE () {
	# Args: <checkout> <new tip> <path>
	[ ! -e "$1/$3" ] && [ ! -L "$1/$3" ] && return 0
	[ ! -L "$1/$3" ] && [ -f "$1/$3" ] && git -C "$1" cat-file --filters "${2}:$3" 2>/dev/null | cmp -s - "$1/$3"
}

# Merges the checkout's uncommitted edits onto what a rewrite landed – each path it changed whose
# file holds edits on the pre-rewrite content, a renamed file's moved to its new path – writing
# only a clean merge that keeps the edits' own lines whole, and only over the file as it was read
GIT_CARRY () {
	# Args: [<old tip>] – by default, the last journaled rewrite of the checkout's branch
	local CO REF OLD NEW P SRC LINE MERGE_RC OURS_HASH TMPF LINK
	local -i I
	local -a J CARRIED LEFT
	# Every path here is a name, never a pattern
	local -x GIT_LITERAL_PATHSPECS=1
	CO=$(git rev-parse --show-toplevel 2>/dev/null)
	if ! REF=$(git symbolic-ref -q HEAD); then
		PRINT_ERR "--carry needs a checked-out branch – HEAD is detached"
		exit 1
	fi
	if [ -n "$1" ]; then
		if ! OLD=$(git rev-parse --verify --quiet "$1^{commit}"); then
			PRINT_ERR "--carry=$1 names no commit here"
			exit 1
		fi
		NEW=$(git rev-parse HEAD)
	else
		local JF=$(_JOURNAL_FILE_PATH)
		if [ -n "$JF" ] && [ -s "$JF" ]; then
			# Newest first – every branch's runs share the journal
			for LINE in "${(@Oaf)$(<"$JF")}"; do
				J=(${=${LINE%$'\t'*}})
				# A `--commit` took the checkout's own files – nothing there to carry
				if [ "${J[2]}" = "$REF" ] && [ "${J[5]}" != commit ]; then
					OLD=${J[3]}
					NEW=${J[4]}
					break
				fi
			done
		fi
		if [ -z "$OLD" ]; then
			PRINT_ERR "No rewrite of ${REF#refs/heads/} on record – name the tip your edits were made on: --carry=<sha>"
			exit 1
		fi
	fi
	PRINT_ACTION "Carrying uncommitted edits from %s onto %s..." "$OLD" "$NEW"

	local -A RENAMED_FROM RENAMED_TO
	local -a RENAME_FIELDS
	# NUL-separated, status, source and destination each – a quote, backslash or tab in a name
	# comes back C-quoted in the line form
	RENAME_FIELDS=(${(0)"$(git diff --ignore-submodules=dirty -z -M --name-status --diff-filter=R "$OLD" "$NEW" 2>/dev/null)"})
	for (( I = 1; I + 2 <= ${#RENAME_FIELDS[@]}; I += 3 )); do
		RENAMED_FROM[${RENAME_FIELDS[I + 2]}]=${RENAME_FIELDS[I + 1]}
		RENAMED_TO[${RENAME_FIELDS[I + 1]}]=${RENAME_FIELDS[I + 2]}
	done
	local BASE=$(MKTEMP_FILE git-edit-base) THEIRS=$(MKTEMP_FILE git-edit-theirs) MERGED=$(MKTEMP_FILE git-edit-merged)
	_TEMP_FILES+=("$BASE" "$THEIRS" "$MERGED")
	for P in ${(0)"$(git diff --ignore-submodules=dirty -z --name-only --no-renames "$OLD" "$NEW" 2>/dev/null)"}; do
		[ -z "$P" ] && continue
		# A submodule's worktree is a repository of its own
		[ -d "$CO/$P" ] && [ ! -L "$CO/$P" ] && continue
		SRC=$P
		if ! git cat-file -e "$NEW:$P" 2>/dev/null; then
			# A rename's source goes with its new path, unless that path is in the checkout already –
			# as anything but what the rewrite landed there, which a rename this checkout landed leaves
			[ -e "$CO/$P" ] || [ -L "$CO/$P" ] || continue
			[ "$(_WORKTREE_HASH "$CO" "$P")" = "$(git rev-parse "${OLD}:${P}" 2>/dev/null)" ] && continue
			[ -n "${RENAMED_TO[$P]}" ] && _CARRY_DEST_FREE "$CO" "$NEW" "${RENAMED_TO[$P]}" && continue
			if [ -n "${RENAMED_TO[$P]}" ]; then
				LEFT+=("$P – renamed to ${RENAMED_TO[$P]}, which the checkout holds already")
			else
				LEFT+=("$P – removed by the rewrite")
			fi
			continue
		fi
		[ -n "${RENAMED_FROM[$P]}" ] && { [ -e "$CO/${RENAMED_FROM[$P]}" ] || [ -L "$CO/${RENAMED_FROM[$P]}" ]; } \
			&& _CARRY_DEST_FREE "$CO" "$NEW" "$P" && SRC=${RENAMED_FROM[$P]}
		[ -e "$CO/$SRC" ] || [ -L "$CO/$SRC" ] || continue
		# Edits need a pre-rewrite blob to have been made on, and a stale or current file has none
		git cat-file -e "$OLD:$SRC" 2>/dev/null || continue
		OURS_HASH=$(_WORKTREE_HASH "$CO" "$SRC")
		[ "$OURS_HASH" = "$(git rev-parse "${OLD}:${SRC}")" ] && continue
		[ "$OURS_HASH" = "$(git rev-parse "${NEW}:${P}")" ] && continue
		# A retargeted symlink has no lines to merge, and writing through it would replace it
		if [ -L "$CO/$SRC" ]; then
			LEFT+=("$P – a symlink")
			continue
		fi
		# A commit since the rewrite brought content of its own, which the merge would take back
		if [ "$(git rev-parse "HEAD:$P" 2>/dev/null)" != "$(git rev-parse "${NEW}:${P}")" ]; then
			LEFT+=("$P – changed again since the rewrite")
			continue
		fi
		git cat-file blob "$OLD:$SRC" > "$BASE" && git cat-file blob "$NEW:$P" > "$THEIRS"
		git merge-file -p -q "$CO/$SRC" "$BASE" "$THEIRS" > "$MERGED" 2>/dev/null
		MERGE_RC=$?
		if [ $MERGE_RC -gt 127 ]; then
			LEFT+=("$P – no text merge")
			continue
		elif [ $MERGE_RC -gt 0 ]; then
			LEFT+=("$P – $MERGE_RC conflict(s)")
			continue
		fi
		# Carried before – the edits sit on the new content already
		[ "$SRC" = "$P" ] && cmp -s "$MERGED" "$CO/$SRC" && continue
		if [ "$(_CHANGED_LINES "$BASE" "$CO/$SRC")" != "$(_CHANGED_LINES "$THEIRS" "$MERGED")" ]; then
			LEFT+=("$P – the merge would alter the edits")
			continue
		fi
		# Written beside the file and moved into place, keeping its mode – a renamed one takes the new
		# path's – unless the file changed since it was read, a parallel edit the merge never saw
		TMPF="$CO/$P.git-edit-carry.$$"
		_TEMP_FILES+=("$TMPF")
		# A rename into a new directory finds none in the checkout yet
		[ "$SRC" = "$P" ] || mkdir -p "$CO/${P:h}"
		cp -p "$CO/$SRC" "$TMPF" && cat "$MERGED" > "$TMPF" || { rm -f "$TMPF"; LEFT+=("$P – not writable"); continue; }
		if [ "$SRC" != "$P" ]; then
			if [ "$(git ls-tree --full-tree "$NEW" -- "$P" | awk '{print $1}')" = 100755 ]; then
				chmod +x "$TMPF"
			else
				chmod -x "$TMPF"
			fi
		fi
		if [ "$(_WORKTREE_HASH "$CO" "$SRC")" != "$OURS_HASH" ] || { [ "$SRC" != "$P" ] && ! _CARRY_DEST_FREE "$CO" "$NEW" "$P"; }; then
			rm -f "$TMPF"
			LEFT+=("$P – changed while carrying")
			continue
		fi
		mv -f "$TMPF" "$CO/$P"
		if [ "$SRC" != "$P" ]; then
			rm -f "$CO/$SRC"
			CARRIED+=("$SRC → $P")
		else
			CARRIED+=("$P")
		fi
	done
	rm -f "$BASE" "$THEIRS" "$MERGED"

	[ ${#CARRIED[@]} -gt 0 ] && PRINT_TEXT "Carried onto the new content: %s" 32 "${(j:, :)CARRIED}"
	if [ ${#LEFT[@]} -gt 0 ]; then
		PRINT_ERR "Left as they were, to merge by hand: ${(j:, :)LEFT}"
		exit 1
	fi
	[ ${#CARRIED[@]} -eq 0 ] && PRINT_TEXT "%s" 32 "Nothing to carry – no path the rewrite changed holds edits on its pre-rewrite content."
	_PRINT_DEFERRED_SIGNAL
	_EMIT_TRAILER "git-edit: ok – carried ${#CARRIED[@]} path(s) across ${OLD:0:7}..${NEW:0:7}"
	_STATUS_EMITTED=true
}

# Reports the in-flight operation in the same format as the original pause, so a caller
# landing mid-operation – after a context reset or from another session – can re-enter
# without reading state files, falling back to the journal's last completed operation
GIT_STATUS_REPORT () {
	if _STATE_EXISTS; then
		_LOAD_STATE
		PRINT_TEXT "In-flight operation: %s (target %s, branch %s)" 33 "$STATE_OPERATION" "${STATE_TARGET:0:7}" "$STATE_BRANCH"
		if [ -d "$STATE_WORKTREE" ]; then
			PRINT_TEXT "Worktree: %s" 33 "$STATE_WORKTREE"
			# Hand the pre-op tip over for a reorder so the step-kind guidance matches the
			# original pause – the other operations change the tree by design, so no
			# resolution is determined for them
			local STATUS_PREOP=""
			[ "$STATE_OPERATION" = "reorder" ] && STATUS_PREOP=$STATE_ORIG_HEAD
			local UNMERGED_LIST=$(_PRINT_CONFLICT_DETAIL "$STATE_WORKTREE" "$STATUS_PREOP")
			# A paused edit or split with no rebase running is authoring, not resolving, so
			# it reports as the pause it is rather than as a conflict
			local STATUS_GITDIR=$(git -C "$STATE_WORKTREE" rev-parse --git-dir 2>/dev/null)
			local STATUS_AUTHORING=false
			local STATUS_VERIFY=false
			local STATUS_MODE=false
			# A gate pause holds a finished rebuild it refused – with no rebase running and
			# nothing unmerged, the conflict report would show no files
			if [ -n "$STATE_MODE_STRAY" ] && [ ! -d "$STATUS_GITDIR/rebase-merge" ] && [ ! -d "$STATUS_GITDIR/rebase-apply" ]; then
				STATUS_MODE=true
				PRINT_TEXT "A file mode changed at %s that nothing asked for – the result is built in the worktree, not applied." 33 "${STATE_MODE_STRAY:0:7}"
			elif [ -n "$STATE_VERIFY_FAILED" ] && [ ! -d "$STATUS_GITDIR/rebase-merge" ] && [ ! -d "$STATUS_GITDIR/rebase-apply" ]; then
				STATUS_VERIFY=true
				PRINT_TEXT "Verification failed at %s – the result is built in the worktree, not applied." 33 "${STATE_VERIFY_FAILED:0:7}"
			elif [ "$STATE_OPERATION" = "split" ]; then
				STATUS_AUTHORING=true
				PRINT_TEXT "Authoring phase – edit the worktree back to what the %s commit should leave behind." 33 "first"
				_PRINT_SPLIT_KEEPS "$STATE_TARGET"
			elif [ "$STATE_OPERATION" = "edit" ] && [ ! -d "$STATUS_GITDIR/rebase-merge" ] && [ ! -d "$STATUS_GITDIR/rebase-apply" ]; then
				STATUS_AUTHORING=true
				# Past the amend, the worktree holds what the replay built – a gate cut off, say
				if [ "$(git -C "$STATE_WORKTREE" rev-parse HEAD 2>/dev/null)" = "$STATE_TARGET" ]; then
					PRINT_TEXT "Authoring phase – edit files in the worktree (add %s to also reword)." 33 '--text "…"'
				else
					PRINT_TEXT "Past the amend – the result is built in the worktree, not applied; edits made there now land nowhere." 33
				fi
			fi
			if [ "$STATUS_MODE" = "true" ]; then
				EMIT_MODE_PAUSED "$STATE_MODE_STRAY" "$STATE_WORKTREE"
			elif [ "$STATUS_VERIFY" = "true" ]; then
				EMIT_VERIFY_PAUSED "$STATE_VERIFY_FAILED" "$STATE_WORKTREE"
			elif [ "$STATUS_AUTHORING" = "true" ]; then
				PRINT_TEXT "Then %s – or cancel via %s." 33 "git edit --continue" "git edit --abort"
				EMIT_PAUSED "$STATE_OPERATION" "$STATE_TARGET" "$STATE_WORKTREE"
			else
				PRINT_TEXT "Resolve there, then %s – or cancel via %s." 33 "git edit --continue" "git edit --abort"
				EMIT_CONFLICT "$STATE_WORKTREE" "$UNMERGED_LIST"
			fi
		else
			PRINT_ERR "State exists but its worktree is gone – run 'git edit --abort' to clear"
			exit 1
		fi
	else
		local JF=$(_JOURNAL_FILE_PATH)
		if [ -n "$JF" ] && [ -s "$JF" ]; then
			local LAST=$(tail -1 "$JF")
			LAST=${LAST%$'\t'*}
			PRINT_TEXT "No operation in flight. Last completed: %s (%s → %s)" 32 "$(print -r -- "$LAST" | cut -d' ' -f5-)" "$(print -r -- "$LAST" | awk '{print substr($3,1,7)}')" "$(print -r -- "$LAST" | awk '{print substr($4,1,7)}')"
		else
			PRINT_TEXT "%s" 32 "No operation in flight."
		fi
		_EMIT_TRAILER "git-edit: ok – no operation in flight"
		_STATUS_EMITTED=true
	fi
}

# Names the checkout that has <ref> checked out – an isolated run reports from its temp
# worktree, and the index that needs reconciling is the branch's own, wherever that sits
_BRANCH_CHECKOUT () {
	# Args: <refname>
	local LINE WT="" HERE=$(cd "$_START_DIR" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null)
	local -a FOUND
	for LINE in "${(@f)$(git worktree list --porcelain 2>/dev/null)}"; do
		case $LINE in
			"worktree "*) WT=${LINE#worktree } ;;
			"branch $1") FOUND+=("$WT") ;;
		esac
	done
	(( ${#FOUND} )) || return 1
	# A branch checked out twice, as `git worktree add -f` allows, is the caller's own copy where it
	# stands in one
	[ -n "$HERE" ] && (( ${FOUND[(Ie)$HERE]} )) && { print -r -- "$HERE"; return 0; }
	print -r -- "${FOUND[1]}"
}

# Fills `DIFF_PATHS` with what changed from <old> to <new>, and `DIFF_O`/`DIFF_N` with the
# "<mode> <blob>" each side holds – one raw diff, as a git call a path took a minute on thousands
_DIFF_ENTRIES () {
	# Args: <old> <new> – the caller declares `DIFF_PATHS`, and `DIFF_O`/`DIFF_N` associative
	local P
	local -a RAW META
	local -i K
	DIFF_PATHS=(); DIFF_O=(); DIFF_N=()
	RAW=("${(@0)$(git diff-tree -r -z --no-renames "$1" "$2" 2>/dev/null)}")
	for (( K = 1; K + 1 <= ${#RAW}; K += 2 )); do
		META=(${=${RAW[K]#:}})
		P=${RAW[K + 1]}
		[ -n "$P" ] || continue
		DIFF_PATHS+=("$P")
		[ "${META[1]}" = 000000 ] || DIFF_O[$P]="${META[1]} ${META[3]}"
		[ "${META[2]}" = 000000 ] || DIFF_N[$P]="${META[2]} ${META[4]}"
	done
}

# Fills `IDX_ENT` with the "<mode> <blob>" an index holds at stage 0 for each <path>, `conflict`
# where it holds stages – one `ls-files`, narrowed to the paths where they are few
_INDEX_ENTRIES () {
	# Args: <checkout> <index file, empty for its own> <path>... – the caller declares `IDX_ENT`
	local CO=$1 IDX=$2 E P META
	local -x GIT_LITERAL_PATHSPECS=1
	local -a SPEC
	shift 2
	IDX_ENT=()
	(( $# )) || return 0
	(( $# <= 1000 )) && SPEC=(-- "$@")
	for E in ${(0)"$(if [ -n "$IDX" ]; then GIT_INDEX_FILE=$IDX git -C "$CO" ls-files -s -z "${SPEC[@]}"; else git -C "$CO" ls-files -s -z "${SPEC[@]}"; fi 2>/dev/null)"}; do
		META=${E%%$'\t'*}
		P=${E#*$'\t'}
		if [ "${META##* }" != 0 ]; then IDX_ENT[$P]=conflict
		elif [ "${IDX_ENT[$P]}" != conflict ]; then IDX_ENT[$P]=${META% *}
		fi
	done
}

# Resets each path's index entry to the checkout's `HEAD` where it still holds the entry this run
# expects – checked and written under git's own index lock, so a peer staging one meanwhile keeps it
_RESET_IF_STAGED_AS () {
	# Args: <checkout> (<path> <expected "mode blob", empty for none>)...
	# Fills `RESET_DONE`, `RESET_KEPT` and `RESET_LOCKED`
	local CO=$1 IDX TMP P HAVE
	local -i I
	local -a PAIRS CAND
	local -x GIT_LITERAL_PATHSPECS=1
	shift
	PAIRS=("$@")
	RESET_DONE=(); RESET_KEPT=(); RESET_LOCKED=()
	(( ${#PAIRS} )) || return 0
	IDX=$(git -C "$CO" rev-parse --path-format=absolute --git-path index 2>/dev/null) || return 1
	TMP="$IDX.git-edit.$$"
	_TEMP_FILES+=("$TMP")
	# Whoever creates `index.lock` owns the index until letting go – a peer mid-`add` holds it, and a
	# `git status` refreshing it for a moment, waited out for ~5 s – created exclusively as git does,
	# `noclobber` opening it `O_EXCL`
	local -i W=0
	until ( setopt noclobber; : > "$IDX.lock" ) 2>/dev/null; do
		if (( ++W > 50 )); then
			for (( I = 1; I <= ${#PAIRS}; I += 2 )); do RESET_LOCKED+=("${PAIRS[I]}"); done
			return 0
		fi
		sleep 0.1
	done
	{
		# A copy that failed would leave `reset` building an index of these paths alone
		if [ -e "$IDX" ] && ! cp -p "$IDX" "$TMP" 2>/dev/null; then
			for (( I = 1; I <= ${#PAIRS}; I += 2 )); do RESET_LOCKED+=("${PAIRS[I]}"); done
			return 0
		fi
		local -A IDX_ENT
		local -a PP
		for (( I = 1; I <= ${#PAIRS}; I += 2 )); do PP+=("${PAIRS[I]}"); done
		_INDEX_ENTRIES "$CO" "$TMP" "${PP[@]}"
		for (( I = 1; I <= ${#PAIRS}; I += 2 )); do
			P=${PAIRS[I]}
			if [ "${IDX_ENT[$P]}" = "${PAIRS[I + 1]}" ]; then CAND+=("$P"); else RESET_KEPT+=("$P"); fi
		done
		if (( ${#CAND} )); then
			if GIT_INDEX_FILE=$TMP git -C "$CO" reset -q -- "${CAND[@]}" 2>/dev/null && mv -f "$TMP" "$IDX"; then
				RESET_DONE=("${CAND[@]}")
			else
				RESET_LOCKED+=("${CAND[@]}")
			fi
		fi
	} always {
		rm -f "$TMP" "$IDX.lock"
	}
}

# Re-syncs a fold's paths to the new tip where their entries still hold what the fold read, and
# names any staged anew meanwhile, which keep their staging
_RESYNC_FOLDED () {
	# Args: <checkout> <tree the fold read> <path>...
	local CO=$1 TREE=$2 P
	local -a PAIRS
	shift 2
	for P in "$@"; do
		PAIRS+=("$P" "$(git ls-tree --full-tree "$TREE" -- ":(literal)$P" 2>/dev/null | awk '{print $1" "$3}')")
	done
	_RESET_IF_STAGED_AS "$CO" "${PAIRS[@]}"
	(( ${#RESET_KEPT} )) && PRINT_TEXT "Left staged, changed since the fold read it: %s" 33 "${(j:, :)RESET_KEPT}"
	if (( ${#RESET_LOCKED} )); then
		_AT_TOP "$CO"
		PRINT_TEXT "Not re-synced, the index was locked: %s – run %s" 33 "${(j:, :)RESET_LOCKED}" "${REPLY}git reset -- $(_QUOTE_PATHS "${RESET_LOCKED[@]}")"
	fi
	return 0
}

# Re-syncs the index entries a ref move stranded in <checkout> – an entry still holding the
# pre-rewrite tip's blob reads as a staged revert of the rewrite, the foreign staging a peer's
# plain commit sweeps in – guarded per path on exactly that equality, so a peer's staging (or
# the caller's own) on a changed path stays put and is named instead
_RESYNC_STRANDED_ENTRIES () {
	# Args: <checkout> <old tip> <new tip> – fills the caller's RESYNCED, LEFT_ALONE and LOCKED
	local CO=$1 OLD=$2 NEW=$3 P IDXENT
	local -a PAIRS DIFF_PATHS
	local -A DIFF_O DIFF_N IDX_ENT
	RESYNCED=(); LEFT_ALONE=(); LOCKED=()
	_DIFF_ENTRIES "$OLD" "$NEW"
	_INDEX_ENTRIES "$CO" "" "${DIFF_PATHS[@]}"
	for P in "${DIFF_PATHS[@]}"; do
		IDXENT=${IDX_ENT[$P]}
		# A conflicted path is mid-merge – a reset would discard its stages
		if [ "$IDXENT" = conflict ]; then
			LEFT_ALONE+=("$P")
		elif [ "${DIFF_O[$P]}" = "$IDXENT" ]; then
			PAIRS+=("$P" "$IDXENT")
		# One staged as the new tip has it is in sync already
		elif [ "$IDXENT" = "${DIFF_N[$P]}" ]; then
			:
		# A file this run took whole supersedes what was staged of it, an intent-to-add entry too,
		# as `git commit -- <paths>` has it – left as it was, a plain commit takes the file back –
		# though not what a peer staged since the file was read
		elif (( ${WHOLE_PATHS[(Ie)$P]} )) && [ "$IDXENT" = "${WHOLE_IDX[$P]}" ]; then
			PAIRS+=("$P" "$IDXENT")
		else
			LEFT_ALONE+=("$P")
		fi
	done
	# A peer mid-`add` holds the index lock – its entries stay stranded, named as such rather
	# than as differing, since they do not
	_RESET_IF_STAGED_AS "$CO" "${PAIRS[@]}"
	RESYNCED=("${RESET_DONE[@]}"); LOCKED=("${RESET_LOCKED[@]}"); LEFT_ALONE+=("${RESET_KEPT[@]}")
}

# Hashes a worktree path as git would stage it – a symlink by the name it points at, which
# `git hash-object` reads through to the file instead
_WORKTREE_HASH () {
	# Args: <checkout> <path>
	if [ -L "$1/$2" ]; then
		printf '%s' "$(readlink "$1/$2")" | git hash-object --stdin
	else
		git -C "$1" hash-object -- "$2"
	fi
}

# Tells whether a worktree file's edits sit on the pre-rewrite content – merging the rewrite in
# would change it, so committing it whole takes the rewrite back there – where edits made on the
# new content, a change landed through the checkout first, merge to themselves
_EDITS_LACK_REWRITE () {
	# Args: <worktree file> <old blob> <new blob> – false where it cannot tell, a binary say
	local BASE=$(MKTEMP_FILE git-edit-base) THEIRS=$(MKTEMP_FILE git-edit-theirs) MERGED=$(MKTEMP_FILE git-edit-merged)
	_TEMP_FILES+=("$BASE" "$THEIRS" "$MERGED")
	local RC=255
	if git cat-file blob "$2" > "$BASE" 2>/dev/null && git cat-file blob "$3" > "$THEIRS" 2>/dev/null; then
		git merge-file -p -q "$1" "$BASE" "$THEIRS" > "$MERGED" 2>/dev/null
		RC=$?
	fi
	if [ $RC -eq 0 ]; then
		! cmp -s "$MERGED" "$1"
	elif [ $RC -le 127 ]; then
		# Edits beside the rewrite's own lines conflict too, made on the new content as much as on
		# the old – the file holds the rewrite where its changed lines take in all of the rewrite's
		[ -n "$(LC_ALL=C comm -23 <(_CHANGED_LINES "$BASE" "$THEIRS") <(_CHANGED_LINES "$BASE" "$1"))" ]
	else
		false
	fi
	RC=$?
	rm -f "$BASE" "$THEIRS" "$MERGED"
	return $RC
}

# Tells whether a terminal run brings <checkout> along itself – the caller's own, so not a checkout
# another session works in, and with no merge, rebase or cherry-pick halfway there
_SYNCS_CHECKOUT () {
	# Args: <checkout>
	# Asked once a run – the reconcile paths ask in turn
	[[ "$_SYNC_VERDICT" == *:"$1" ]] && { [[ "$_SYNC_VERDICT" == yes:* ]]; return; }
	_SYNC_VERDICT="no:$1"
	_IS_NON_INTERACTIVE && return 1
	local HERE=$(cd "$_START_DIR" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null)
	[ -n "$HERE" ] && [ "${HERE:A}" = "${1:A}" ] || return 1
	local GD=$(git -C "$1" rev-parse --absolute-git-dir 2>/dev/null) WHAT=""
	if [ -f "$GD/MERGE_HEAD" ]; then WHAT="a merge"
	elif [ -d "$GD/rebase-merge" ] || [ -d "$GD/rebase-apply" ]; then WHAT="a rebase"
	elif [ -f "$GD/CHERRY_PICK_HEAD" ]; then WHAT="a cherry-pick"
	elif [ -f "$GD/REVERT_HEAD" ]; then WHAT="a revert"
	elif [ -n "$(git -C "$1" ls-files -u 2>/dev/null | head -1)" ]; then WHAT="a conflict"
	fi
	if [ -n "$WHAT" ]; then
		PRINT_TEXT "Your checkout is halfway through %s, so it stays as it was – reconcile it by hand:" 33 "$WHAT"
		return 1
	fi
	_SYNC_VERDICT="yes:$1"
}

# Prints the "<mode> <blob>" an index holds for <path> at stage 0, `conflict` where it holds stages,
# nothing where it holds none
_INDEX_ENTRY () {
	# Args: <checkout> <path>
	local -x GIT_LITERAL_PATHSPECS=1
	git -C "$1" ls-files -s -- "$2" 2>/dev/null | awk '{ if ($3 != 0) c = 1; else e = $1" "$2 } END { print (c ? "conflict" : e) }'
}

# Prints the "<mode> <blob>" <tree-ish> holds for <path>, nothing where it has none
_TREE_ENTRY () {
	# Args: <tree-ish> <path>
	local -x GIT_LITERAL_PATHSPECS=1
	git ls-tree --full-tree "$1" -- "$2" 2>/dev/null | awk 'NR == 1 { print $1" "$3 }'
}

# Merges the edits a checkout file holds on <old blob> onto <new blob>, in the form a checkout writes
# – filters applied – into <out>, returning `git merge-file`'s status: 0 clean, a conflict count, or
# above 127 where it can't merge, a binary say
_SYNC_MERGE () {
	# Args: <checkout> <file> <old rev:path> <new rev:path> <out>
	local BASE=$(MKTEMP_FILE git-edit-base) THEIRS=$(MKTEMP_FILE git-edit-theirs) RC
	_TEMP_FILES+=("$BASE" "$THEIRS")
	git -C "$1" cat-file --filters "$3" > "$BASE" 2>/dev/null && git -C "$1" cat-file --filters "$4" > "$THEIRS" 2>/dev/null || { rm -f "$BASE" "$THEIRS"; return 255; }
	# What landed first, as git's own conflicts show `HEAD` – a clean merge is the same either way
	git merge-file -p -L "landed (HEAD)" -L "before the rewrite" -L "your edits" "$THEIRS" "$BASE" "$1/$2" > "$5" 2>/dev/null
	RC=$?
	rm -f "$BASE" "$THEIRS"
	return $RC
}

# Brings a terminal caller's checkout from <old> to the tip <new> its branch just moved to – a file
# still as <old> had it takes what landed, edits merge onto it where they merge cleanly, a conflict
# writing nothing, as they may be a peer's, and a file standing where one lands is kept – each named
_SYNC_CHECKOUT () {
	# Args: <checkout> <old tip> <new tip>
	local CO=$1 OLD=$2 NEW=$3 P SRC O N I MODE TMPF OURS ERR DST WHY
	local -i RC
	local -x GIT_LITERAL_PATHSPECS=1
	local -a CHANGED CLEAN CARRIED CONFLICTED MERGE_CMDS KEPT KEPT_EDITS GONE_EDITED LEFT DELETED FAILED STALE LOCKED DIFF_PATHS
	local -A UNSTAGED STAGED RENAMED_FROM RENAMED_TO IS_DIRTY DIFF_O DIFF_N IDX_ENT CARRY
	_DIFF_ENTRIES "$OLD" "$NEW"
	CHANGED=("${DIFF_PATHS[@]}")
	(( ${#CHANGED} )) || return 0
	# Where the checkout differs from <old>: its files from its index, its index from <old>
	for P in ${(0)"$(git -C "$CO" diff --ignore-submodules=dirty -z --name-only --no-renames 2>/dev/null)"}; do UNSTAGED[$P]=1; done
	for P in ${(0)"$(git -C "$CO" diff --cached --ignore-submodules=dirty -z --name-only --no-renames "$OLD" 2>/dev/null)"}; do STAGED[$P]=1; done
	local -a RF
	RF=(${(0)"$(git diff --ignore-submodules=dirty -z -M --name-status --diff-filter=R "$OLD" "$NEW" 2>/dev/null)"})
	for (( RC = 1; RC + 2 <= ${#RF}; RC += 3 )); do
		RENAMED_FROM[${RF[RC + 2]}]=${RF[RC + 1]}
		RENAMED_TO[${RF[RC + 1]}]=${RF[RC + 2]}
	done
	for P in "${CHANGED[@]}"; do
		if (( ${+UNSTAGED[$P]} || ${+STAGED[$P]} )); then
			IS_DIRTY[$P]=1
		# One the rewrite adds needs its place free – an untracked or ignored file there, or a
		# directory, is the caller's
		elif [ -z "${DIFF_O[$P]}" ] && { [ -e "$CO/$P" ] || [ -L "$CO/$P" ]; }; then
			IS_DIRTY[$P]=1
		fi
	done
	# A path the clean set adds where a kept one needs its directory, or the reverse, waits with it
	for P in "${CHANGED[@]}"; do
		(( ${+IS_DIRTY[$P]} )) && continue
		for SRC in "${(@k)IS_DIRTY}"; do
			if [[ "$SRC" == "$P"/* || "$P" == "$SRC"/* ]]; then
				IS_DIRTY[$P]=1
				break
			fi
		done
	done
	# A renamed file's edits go along to its new path, which they hold up the same way
	for P in "${(@k)RENAMED_TO}"; do
		(( ${+IS_DIRTY[$P]} )) && IS_DIRTY[${RENAMED_TO[$P]}]=1
	done
	for P in "${CHANGED[@]}"; do
		(( ${+IS_DIRTY[$P]} )) || CLEAN+=("$P")
	done

	# The clean ones in one two-tree merge from <old> to <old> with just them taken from <new> – git
	# checks each is as <old> had it before writing anything, and keeps the rest of the index as is
	if (( ${#CLEAN} )) && ! ERR=$(_SYNC_TWO_TREE "$CO" "$OLD" "$NEW" "${CLEAN[@]}"); then
		# Path by path where git refused them together – an entry flagged assume-unchanged or
		# skip-worktree hides edits git then won't overwrite, which go to the merge below instead
		for P in "${CLEAN[@]}"; do
			_SYNC_TWO_TREE "$CO" "$OLD" "$NEW" "$P" >/dev/null && continue
			FAILED+=("$P")
			if [ -n "${DIFF_O[$P]}" ] && { [ -e "$CO/$P" ] || [ -L "$CO/$P" ]; } && \
			   [ "$(_WORKTREE_HASH "$CO" "$P" 2>/dev/null)" != "${DIFF_O[$P]#* }" ]; then
				IS_DIRTY[$P]=1
				UNSTAGED[$P]=1
			fi
		done
		CLEAN=("${(@)CLEAN:|FAILED}")
		ERR=${ERR%%$'\n'*}
	fi
	# Each index entry read once, after the merge above wrote its own
	_INDEX_ENTRIES "$CO" "" "${CHANGED[@]}"
	# A path git refused that holds no edits stays as <old> had it – its entry taken from what landed
	# where git takes one, so it reads as a file to bring along, never as a staged revert
	for P in "${FAILED[@]}"; do
		(( ${+IS_DIRTY[$P]} )) && continue
		if [ "${IDX_ENT[$P]}" = "${DIFF_O[$P]}" ] && _SYNC_SET_ENTRY "$CO" "$P" "${DIFF_N[$P]}"; then
			STALE+=("$P")
		else
			LOCKED+=("$P")
		fi
	done

	local NOUN=rewrite
	local -a SUBMODULES
	for P in "${CLEAN[@]}"; do
		[ "${DIFF_N[$P]% *}" = 160000 ] && \
			[ "$(git -C "$CO/$P" rev-parse -q --verify HEAD 2>/dev/null)" != "${DIFF_N[$P]#* }" ] && SUBMODULES+=("$P")
	done
	# A rename carries the edits at its old path to its new one where the file is still as the
	# index has it from before, and the new path is free – else each goes its own way below
	for P in "${(@k)RENAMED_TO}"; do
		(( ${+IS_DIRTY[$P]} )) || continue
		DST=${RENAMED_TO[$P]}
		[ -z "${DIFF_N[$P]}" ] && [ "${IDX_ENT[$P]}" = "${DIFF_O[$P]}" ] && [ -f "$CO/$P" ] && [ ! -L "$CO/$P" ] && \
			[ ! -e "$CO/$DST" ] && [ ! -L "$CO/$DST" ] && [ -z "${IDX_ENT[$DST]}" ] && CARRY[$P]=$DST
	done
	local OUTF=$(MKTEMP_FILE git-edit-sync)
	_TEMP_FILES+=("$OUTF")
	for P in "${CHANGED[@]}"; do
		(( ${+IS_DIRTY[$P]} )) || continue
		# A carried rename's destination is handled from its source
		[ -n "${RENAMED_FROM[$P]}" ] && [ "${CARRY[${RENAMED_FROM[$P]}]}" = "$P" ] && continue
		O=${DIFF_O[$P]}
		N=${DIFF_N[$P]}
		I=${IDX_ENT[$P]}
		SRC=$P
		if [ -n "${CARRY[$P]}" ]; then
			P=${CARRY[$P]}
			N=${DIFF_N[$P]}
		fi
		if [ "$I" = conflict ]; then
			LEFT+=("$P – mid-merge in your index")
			continue
		fi
		if [ -z "$N" ]; then
			# Removed by the rewrite: a file still as before goes, with its entry, edits stay untracked
			if [ "$I" != "$O" ]; then
				LEFT+=("$P – staged changes on a file the rewrite removed")
			elif [ ! -e "$CO/$P" ] && [ ! -L "$CO/$P" ]; then
				git -C "$CO" update-index --force-remove -- "$P" 2>/dev/null
			else
				git -C "$CO" update-index --force-remove -- "$P" 2>/dev/null && GONE_EDITED+=("$P")
			fi
			continue
		fi
		if [ -z "$O" ] && [ "$SRC" = "$P" ]; then
			# Added by the rewrite where the checkout had a file of its own – kept, the index taking what
			# landed, so it shows as a change to that and a commit can't take the addition back – and a
			# free place takes the file, a rename's destination its source's edits could not reach
			if [ -n "$I" ] && [ "$I" != "$N" ]; then
				LEFT+=("$P – you staged your own version where the rewrite landed one")
				continue
			fi
			if ! _SYNC_SET_ENTRY "$CO" "$P" "$N"; then
				LOCKED+=("$P")
				continue
			fi
			# Never forced – a file of the caller's where a directory of it has to go stays
			if [ ! -e "$CO/$P" ] && [ ! -L "$CO/$P" ]; then
				git -C "$CO" checkout-index -- "$P" 2>/dev/null && { CLEAN+=("$P"); continue; }
				if { [ -e "$CO/${P:h}" ] || [ -L "$CO/${P:h}" ]; } && [ ! -d "$CO/${P:h}" ]; then
					LEFT+=("$P – your file ${P:h} stands where its directory goes")
					continue
				fi
			fi
			if [ -f "$CO/$P" ] && [ ! -L "$CO/$P" ] && git -C "$CO" cat-file --filters "$NEW:$P" 2>/dev/null | cmp -s - "$CO/$P"; then
				continue
			fi
			KEPT+=("$P")
			continue
		fi
		# Changed by the rewrite, the checkout holding edits on it
		if [ ! -e "$CO/$SRC" ] && [ ! -L "$CO/$SRC" ]; then
			# Deleted in the checkout – it stays deleted, the index taking what landed
			[ "$I" = "$O" ] && _SYNC_SET_ENTRY "$CO" "$P" "$N"
			[ "$I" = "$O" ] || [ "$I" = "$N" ] || { LEFT+=("$P – staged changes, deleted in your checkout"); continue; }
			DELETED+=("$P")
			continue
		fi
		# Its removal staged by hand, the file kept untracked – as it stays
		if [ -z "$I" ]; then
			LEFT+=("$P – its removal staged, the file untracked")
			continue
		fi
		if [ "$I" != "$O" ] && [ "$I" != "$N" ] && (( ${+UNSTAGED[$SRC]} )); then
			LEFT+=("$P – staged and unstaged edits both, made before the $NOUN – committed as staged, they take it back")
			continue
		fi
		if [ "$I" = "$N" ] && [ "$SRC" = "$P" ]; then
			# Staged as it landed already, edits on top of that or none
			continue
		fi
		# What no text merge takes stays as yours – an entry still as before takes what landed, so the
		# edits read as changes to that, never as a staged revert
		WHY=""
		if [ -L "$CO/$SRC" ] || [ -d "$CO/$SRC" ] || [[ "${O% *} ${N% *}" == *(120000|160000)* ]]; then
			WHY="a symlink or submodule"
		else
			OURS=$(_WORKTREE_HASH "$CO" "$SRC")
			_SYNC_MERGE "$CO" "$SRC" "$OLD:$SRC" "$NEW:$P" "$OUTF"
			RC=$?
			(( RC > 127 )) && WHY="no text merge"
		fi
		if [ -n "$WHY" ]; then
			if [ "$SRC" = "$P" ] && [ "$I" = "$O" ] && _SYNC_SET_ENTRY "$CO" "$P" "$N"; then
				KEPT_EDITS+=("$P ($WHY)")
			else
				LEFT+=("$P – $WHY")
			fi
			continue
		fi
		# A conflict writes nothing – no markers in a file a peer session may be editing, no unmerged
		# entry in an index it shares – the edits staying as changes to what landed, with the command
		# that merges them, markers and all, once someone means to resolve it
		if (( RC > 0 )); then
			if [ "$SRC" = "$P" ]; then
				[ "$I" = "$O" ] && _SYNC_SET_ENTRY "$CO" "$P" "$N"
				MERGE_CMDS+=("git cat-file --filters $(_SHQ "${OLD:0:12}:$P") > $(_SHQ "$P").git-edit-base && git cat-file --filters $(_SHQ "${NEW:0:12}:$P") > $(_SHQ "$P").git-edit-landed && git merge-file -- $(_SHQ "$P") $(_SHQ "$P").git-edit-base $(_SHQ "$P").git-edit-landed; rm -f $(_SHQ "$P").git-edit-base $(_SHQ "$P").git-edit-landed")
			else
				# A rename's new path takes what landed, the edits staying untracked at the old one, which
				# the merge leaves for whoever resolves it to remove
				_SYNC_SET_ENTRY "$CO" "$P" "$N" && git -C "$CO" checkout-index -- "$P" 2>/dev/null
				git -C "$CO" update-index --force-remove -- "$SRC" 2>/dev/null
				MERGE_CMDS+=("git cat-file --filters $(_SHQ "${OLD:0:12}:$SRC") > $(_SHQ "$P").git-edit-base && git merge-file -- $(_SHQ "$P") $(_SHQ "$P").git-edit-base $(_SHQ "$SRC"); rm -f $(_SHQ "$P").git-edit-base")
			fi
			CONFLICTED+=("${${SRC:#$P}:+$SRC → }$P")
			continue
		fi
		# Written beside the file and moved into place, keeping the mode – what landed, unless the
		# checkout's own differed from before – and only over the file as it was read
		MODE=${N% *}
		[ -x "$CO/$SRC" ] && [ "${O% *}" = 100644 ] && MODE=100755
		[ ! -x "$CO/$SRC" ] && [ "${O% *}" = 100755 ] && MODE=100644
		[ "$SRC" = "$P" ] || mkdir -p "$CO/${P:h}"
		TMPF="$CO/$P.git-edit-sync.$$"
		_TEMP_FILES+=("$TMPF")
		if ! cat "$OUTF" > "$TMPF" 2>/dev/null; then
			rm -f "$TMPF"
			LEFT+=("$P – not writable")
			continue
		fi
		if [ "$MODE" = 100755 ]; then chmod 755 "$TMPF"; else chmod 644 "$TMPF"; fi
		if [ "$(_WORKTREE_HASH "$CO" "$SRC")" != "$OURS" ]; then
			rm -f "$TMPF"
			LEFT+=("$P – changed while it ran")
			continue
		fi
		mv -f "$TMPF" "$CO/$P"
		[ "$SRC" = "$P" ] || { rm -f "$CO/$SRC"; git -C "$CO" update-index --force-remove -- "$SRC" 2>/dev/null; }
		# Staged where it was staged whole before, else the index takes what landed
		if [ "$I" != "$O" ] && [ "$SRC" = "$P" ]; then
			git -C "$CO" add -- "$P" 2>/dev/null
		else
			_SYNC_SET_ENTRY "$CO" "$P" "$N"
		fi || LEFT+=("$P – merged, but the index was locked: its entry still holds the old content")
		CARRIED+=("${${SRC:#$P}:+$SRC → }$P")
	done
	rm -f "$OUTF"

	if (( ${#CLEAN} )); then
		PRINT_TEXT "Your checkout came along – now as they landed: %s" 32 "${(j:, :)CLEAN[1,10]}${CLEAN[11]:+ … and $(( ${#CLEAN} - 10 )) more}"
	fi
	(( ${#CARRIED} )) && PRINT_TEXT "Your uncommitted edits merged onto what landed: %s" 32 "${(j:, :)CARRIED}"
	if (( ${#CONFLICTED} )); then
		PRINT_TEXT "Your uncommitted edits conflict with what landed – left as they were, as changes to it: %s" 33 "${(j:, :)CONFLICTED}"
		_AT_TOP "$CO"
		local AT=$REPLY
		PRINT_TEXT "%s" 33 "Merge them, markers and all, once you mean to resolve them:"
		for P in "${MERGE_CMDS[@]}"; do ECHO_E "\e[0;33m  $(_LIT "$AT$P")\e[0m"; done
	fi
	if (( ${#KEPT} )); then
		PRINT_TEXT "Files of yours stood where the rewrite landed its own – yours stay, as changes to them: %s" 33 "${(j:, :)KEPT}"
		_AT_TOP "$CO"
		PRINT_TEXT "Take what landed with: %s" 33 "${REPLY}git restore -- $(_QUOTE_PATHS "${KEPT[@]}")"
	fi
	(( ${#KEPT_EDITS} )) && PRINT_TEXT "Your edits stay as they were, now changes to what landed, which no merge could take them onto: %s" 33 "${(j:, :)KEPT_EDITS}"
	if (( ${#STALE} )); then
		PRINT_TEXT "Not brought along – git refused%s: %s" 33 "${ERR:+ ($ERR)}" "${(j:, :)STALE}"
		_AT_TOP "$CO"
		PRINT_TEXT "Their entries hold what landed – take the files with: %s" 33 "${REPLY}git restore -- $(_QUOTE_PATHS "${STALE[@]}")"
	fi
	if (( ${#LOCKED} )); then
		PRINT_TEXT "Not brought along – git refused%s, the index still on the pre-rewrite content: %s" 33 "${ERR:+ ($ERR)}" "${(j:, :)LOCKED}"
		_AT_TOP "$CO"
		PRINT_TEXT "Take what landed once it is free: %s" 33 "${REPLY}git restore --source=HEAD --staged --worktree -- $(_QUOTE_PATHS "${LOCKED[@]}")"
	fi
	(( ${#GONE_EDITED} )) && PRINT_TEXT "Removed by the rewrite – your edits to them stay, untracked: %s" 33 "${(j:, :)GONE_EDITED}"
	(( ${#DELETED} )) && PRINT_TEXT "Deleted in your checkout – they stay deleted: %s" 33 "${(j:, :)DELETED}"
	(( ${#LEFT} )) && PRINT_TEXT "Left as they were, for you to reconcile: %s" 33 "${(j:, :)LEFT}"
	_PRINT_SUBMODULES_MOVED "$CO" "${SUBMODULES[@]}"
	return 0
}

# Brings <paths>, each still as <old> has it in <checkout>, to <new> in one two-tree merge – from
# <old> to <old> with just them taken from <new>, so git checks each before writing anything and
# keeps the rest of the index as is – printing git's own refusal where it fails
_SYNC_TWO_TREE () {
	# Args: <checkout> <old tip> <new tip> <path>... – reads the caller's `DIFF_N`
	local CO=$1 OLD=$2 NEW=$3 IDX MID OUT P
	local -x GIT_LITERAL_PATHSPECS=1
	shift 3
	IDX=$(MKTEMP_FILE git-edit-sync-index)
	_TEMP_FILES+=("$IDX")
	rm -f "$IDX"
	if GIT_INDEX_FILE=$IDX git read-tree "$OLD" 2>/dev/null && \
	   { for P in "$@"; do
	       if [ -n "${DIFF_N[$P]}" ]; then printf '%s %s\t%s\0' "${DIFF_N[$P]% *}" "${DIFF_N[$P]#* }" "$P"
	       else printf '0 %s\t%s\0' "${(l:${#OLD}::0:)}" "$P"
	       fi
	     done
	     # Whatever the last path was – `pipefail` reads this block's own status
	     :
	   } | GIT_INDEX_FILE=$IDX git update-index -z --index-info 2>/dev/null && \
	   MID=$(GIT_INDEX_FILE=$IDX git write-tree 2>/dev/null) && \
	   OUT=$(git -C "$CO" read-tree -m -u "$OLD" "$MID" 2>&1); then
		rm -f "$IDX"
		return 0
	fi
	rm -f "$IDX"
	print -r -- "${${OUT##(error|fatal): }:-the two-tree merge failed}"
	return 1
}

# Sets <path>'s index entry in <checkout> to "<mode> <blob>"
_SYNC_SET_ENTRY () {
	# Args: <checkout> <path> <entry>
	git -C "$1" update-index --add --cacheinfo "${3% *},${3#* },$2" 2>/dev/null
}

# Names the submodules a rewrite moved whose checkouts are where they were, with the command that
# brings them along – git updates the pointer, never the submodule's own checkout
_PRINT_SUBMODULES_MOVED () {
	# Args: <checkout> <path>...
	local CO=$1
	shift
	(( $# )) || return 0
	_AT_TOP "$CO"
	PRINT_TEXT "Submodules the $NOUN moved, still checked out as before: %s – bring them along with %s" 33 "${(j:, :)@}" "${REPLY}git submodule update -- $(_QUOTE_PATHS "$@")"
}

# Reconciles the branch's checkout after a tree-changing rewrite: re-syncs the index entries
# the ref move stranded, then names the paths whose worktree still holds the pre-rewrite blob
# exactly – one carrying edits on top is named as left alone instead, since reconciling it would
# discard a peer's lines or your own, and the restore never names `--staged` either. Even for a
# stale path it stays an offer, never an instruction: a rewrite that takes content out of history
# hands it back through exactly that path, so the blob it discards is often the point of the run
_RECONCILE_CHECKOUT () {
	# Args: <checkout> <old tip> <new tip> <headline when stale> [<headline when current>] [<restore's lead>]
	local CO=$1 OLD=$2 NEW=$3 STALE_HEADLINE=$4 CURRENT_HEADLINE=$5 RESTORE_LEAD=$6 P SRC
	local -a RESYNCED LEFT_ALONE LOCKED STALE MODIFIED REVERTING RENAMED GONE MODE_ONLY HOOKED SUBMODULES
	# A person at a terminal gets the checkout brought along instead
	if _SYNCS_CHECKOUT "$CO"; then
		_SYNC_CHECKOUT "$CO" "$OLD" "$NEW"
		return 0
	fi
	# Every path here is a name, never a pattern – `[id].tsx` would match `i.tsx` beside it
	local -x GIT_LITERAL_PATHSPECS=1
	# Commits only added on top rewrote nothing, so a landing takes nothing out of history
	local FORMER=pre-rewrite NOUN=rewrite TOOK=", which takes out again what the rewrite took out of history,"
	if git merge-base --is-ancestor "$OLD" "$NEW" 2>/dev/null; then
		FORMER=previous NOUN=landing TOOK=""
	fi
	# A rename leaves its new path missing from the checkout, which reads as stale there, while
	# edits on the old path sit untracked once the re-sync moved the entry – a restore of the new
	# path would strand them, so the two are named together instead
	local -A RENAMED_FROM RENAMED_TO
	local -i I
	local -a RENAME_FIELDS
	# NUL-separated, status, source and destination each – a quote, backslash or tab in a name
	# comes back C-quoted in the line form
	RENAME_FIELDS=(${(0)"$(git diff --ignore-submodules=dirty -z -M --name-status --diff-filter=R "$OLD" "$NEW" 2>/dev/null)"})
	for (( I = 1; I + 2 <= ${#RENAME_FIELDS[@]}; I += 3 )); do
		RENAMED_FROM[${RENAME_FIELDS[I + 2]}]=${RENAME_FIELDS[I + 1]}
		RENAMED_TO[${RENAME_FIELDS[I + 1]}]=${RENAME_FIELDS[I + 2]}
	done
	_RESYNC_STRANDED_ENTRIES "$CO" "$OLD" "$NEW"
	if [ ${#RESYNCED[@]} -gt 0 ]; then
		PRINT_TEXT "Index entries re-synced to the new tip: %s" 32 "$(_SHQ "${RESYNCED[@]}")"
	fi
	if [ ${#LOCKED[@]} -gt 0 ]; then
		_AT_TOP "$CO"
		PRINT_TEXT "Index locked – entries still on the $FORMER tip, re-sync them once it is free (%s): %s" 33 "${REPLY}git restore --staged -- <paths>" "$(_QUOTE_PATHS "${LOCKED[@]}")"
	fi
	if [ ${#LEFT_ALONE[@]} -gt 0 ]; then
		PRINT_TEXT "Index entries left alone – they differ from the $FORMER tip (a peer's staging, or your own): %s" 33 "$(_SHQ "${LEFT_ALONE[@]}")"
	fi
	# Each side's entries, and where the checkout differs from the new tip – by content and mode, by
	# content alone – and from the old one, read once for the lot
	local -a DIFF_PATHS GONE_AT
	local -A DIFF_O DIFF_N VS_HEAD VS_CONTENT VS_OLD GONE_HASH
	_DIFF_ENTRIES "$OLD" "$NEW"
	for P in ${(0)"$(git -C "$CO" diff --ignore-submodules=dirty -z --name-only HEAD 2>/dev/null)"}; do VS_HEAD[$P]=1; done
	for P in ${(0)"$(git -C "$CO" -c core.fileMode=false diff --ignore-submodules=dirty -z --name-only HEAD 2>/dev/null)"}; do VS_CONTENT[$P]=1; done
	for P in ${(0)"$(git -C "$CO" diff --ignore-submodules=dirty -z --name-only "$OLD" 2>/dev/null)"}; do VS_OLD[$P]=1; done
	# A removed path's file, hashed as git stages it, in one go – a link by its target, and a name
	# holding a newline, which `--stdin-paths` can't take, alone
	for P in "${DIFF_PATHS[@]}"; do
		[ -z "${DIFF_N[$P]}" ] && [ -f "$CO/$P" ] && [ ! -L "$CO/$P" ] && [[ "$P" != *$'\n'* ]] && GONE_AT+=("$P")
	done
	if (( ${#GONE_AT} )); then
		local -a GONE_SHA
		GONE_SHA=("${(@f)$(print -rl -- "${GONE_AT[@]}" | git -C "$CO" hash-object --stdin-paths 2>/dev/null)}")
		(( ${#GONE_SHA} == ${#GONE_AT} )) && for (( I = 1; I <= ${#GONE_AT}; I++ )); do GONE_HASH[${GONE_AT[I]}]=${GONE_SHA[I]}; done
	fi
	# A path the rewrite removed lingers untracked once its entry is gone, so it takes a
	# `clean` where the others take a restore
	for P in "${DIFF_PATHS[@]}"; do
		if [ -n "${DIFF_N[$P]}" ]; then
			# A submodule's checkout is a repository of its own, which the rewrite moved the commit of
			if [ "${DIFF_N[$P]% *}" = 160000 ]; then
				[ "$(git -C "$CO/$P" rev-parse -q --verify HEAD 2>/dev/null)" = "${DIFF_N[$P]#* }" ] || SUBMODULES+=("$P")
				continue
			fi
			if (( ${+VS_HEAD[$P]} )); then
				# Only the pre-rewrite blob itself is stale content a restore reclaims – a
				# worktree matching neither tip carries edits on top, a peer's or your own,
				# and naming those for reconciling would prescribe discarding them. The new
				# tip's content under another mode is neither: no edit, just a bit a file moved
				# into place lost, a chmod not committed, or one the rewrite made and the
				# checkout never got – told apart, since "uncommitted edits" on a file just
				# committed whole invites committing "the rest"
				SRC=${RENAMED_FROM[$P]}
				if (( ! ${+VS_CONTENT[$P]} )); then
					MODE_ONLY+=("$P")
				elif [ -n "$SRC" ] && [ ! -e "$CO/$P" ] && [ ! -L "$CO/$P" ] && { [ -e "$CO/$SRC" ] || [ -L "$CO/$SRC" ]; } && \
				     [ "$(_WORKTREE_HASH "$CO" "$SRC" 2>/dev/null)" != "${DIFF_O[$SRC]#* }" ]; then
					RENAMED+=("$SRC → $P")
				# A file `--commit` took whole, still as it was read – the commit's hooks changed it there,
				# where a fold's tip differs by what later commits replayed onto it
				elif [ ${#OPT_COMMIT} -gt 0 ] && [ -n "$WHOLE_TREE" ] && (( ${WHOLE_PATHS[(Ie)$P]} )) && \
				     [ "$(_WORKTREE_HASH "$CO" "$P" 2>/dev/null)" = "$(git rev-parse -q --verify "${WHOLE_TREE}:${P}" 2>/dev/null)" ]; then
					HOOKED+=("$P")
				elif (( ! ${+VS_OLD[$P]} )); then
					STALE+=("$P")
				elif [ ! -L "$CO/$P" ] && [ -n "${DIFF_O[$P]}" ] && \
				     _EDITS_LACK_REWRITE "$CO/$P" "${DIFF_O[$P]#* }" "${DIFF_N[$P]#* }"; then
					REVERTING+=("$P")
				else
					MODIFIED+=("$P")
				fi
			fi
		elif [ -e "$CO/$P" ]; then
			# Same test for a path the rewrite removed, but the re-sync took its index entry
			# with it – the file is untracked now, so only its hash tells the blob the rewrite
			# left from work someone put there, and a `clean` on the latter leaves nothing
			if [ "${GONE_HASH[$P]:-$(_WORKTREE_HASH "$CO" "$P" 2>/dev/null)}" = "${DIFF_O[$P]#* }" ]; then
				GONE+=("$P")
			elif [ -z "${RENAMED_TO[$P]}" ] || [ -e "$CO/${RENAMED_TO[$P]}" ]; then
				MODIFIED+=("$P")
			fi
		fi
	done
	_PRINT_SUBMODULES_MOVED "$CO" "${SUBMODULES[@]}"
	if [ ${#MODIFIED[@]} -gt 0 ]; then
		PRINT_TEXT "Worktree files left alone – uncommitted edits there, not the $FORMER content (a peer's, or your own): %s" 33 "$(_SHQ "${MODIFIED[@]}")"
	fi
	if [ ${#HOOKED[@]} -gt 0 ]; then
		PRINT_TEXT "Worktree files still as the commit read them, which its hooks then changed: %s" 33 "$(_SHQ "${HOOKED[@]}")"
		_AT_TOP "$CO"
		PRINT_TEXT "Take the hooks' version with: %s" 33 "${REPLY}git restore --source=HEAD --worktree -- $(_QUOTE_PATHS "${HOOKED[@]}")"
	fi
	if [ ${#REVERTING[@]} -gt 0 ]; then
		PRINT_TEXT "Worktree files left alone with uncommitted edits on the $FORMER content – committed whole, they take the $NOUN back there: %s" 33 "$(_SHQ "${REVERTING[@]}")"
	fi
	if [ ${#RENAMED[@]} -gt 0 ]; then
		PRINT_TEXT "Renamed by the $NOUN, with uncommitted edits left untracked at the old path and the new one missing: %s" 33 "${(j:, :)RENAMED}"
	fi
	if [ $(( ${#REVERTING[@]} + ${#RENAMED[@]} )) -gt 0 ]; then
		# Pinned to this rewrite's old tip, which a later one would otherwise take the place of
		local CARRY_CMD="git edit --carry=${OLD:0:12}" HERE=$(cd "$_START_DIR" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null)
		[ -n "$HERE" ] && [ "${HERE:A}" = "${CO:A}" ] || CARRY_CMD="git -C $(_SHQ "$CO") edit --carry=${OLD:0:12}"
		PRINT_TEXT "Merge those edits onto the new content$TOOK with: %s" 33 "$CARRY_CMD"
	fi
	# Both modes named, and the chmod matching the committed one offered – it discards no content,
	# though a deliberate chmod not yet committed is undone by it all the same
	if [ ${#MODE_ONLY[@]} -gt 0 ]; then
		local -a MODE_NOTES TO_X TO_NOX
		local HERE THERE
		for P in "${MODE_ONLY[@]}"; do
			# `--full-tree`, as `$P` is the repo's path and a pathspec would read it from the cwd
			THERE=$(git ls-tree --full-tree "$NEW" -- "$P" 2>/dev/null | awk '{print $1}')
			HERE=100644
			[ -x "$CO/$P" ] && HERE=100755
			MODE_NOTES+=("$(_SHQ "$P") ($HERE here, $THERE committed)")
			if [ "$THERE" = 100755 ]; then
				TO_X+=("$P")
			else
				TO_NOX+=("$P")
			fi
		done
		PRINT_TEXT "Worktree files at the new tip's content, only their mode differing – no edits there: %s" 33 "${(j:, :)MODE_NOTES}"
		local CHMOD=""
		[ ${#TO_X[@]} -gt 0 ] && CHMOD="chmod +x -- $(_SHQ "${TO_X[@]}")"
		[ ${#TO_NOX[@]} -gt 0 ] && CHMOD="${CHMOD:+$CHMOD && }chmod -x -- $(_SHQ "${TO_NOX[@]}")"
		_AT_TOP "$CO"
		PRINT_TEXT "Match the committed mode: %s" 33 "$REPLY$CHMOD"
	fi
	if [ ${#STALE[@]} -eq 0 ] && [ ${#GONE[@]} -eq 0 ]; then
		# "Index re-synced" holds only where no entry was left alone or locked out
		[ -n "$CURRENT_HEADLINE" ] && [ $(( ${#MODIFIED[@]} + ${#REVERTING[@]} + ${#RENAMED[@]} + ${#MODE_ONLY[@]} + ${#LEFT_ALONE[@]} + ${#LOCKED[@]} + ${#HOOKED[@]} )) -eq 0 ] && PRINT_TEXT "%s" 32 "$CURRENT_HEADLINE"
		return 0
	fi
	PRINT_TEXT "%s" 33 "$STALE_HEADLINE"
	printf '%s\n' "${STALE[@]}" "${GONE[@]}" | head -10 | _CARET_LINES | LC_ALL=C sed "/./!d;s/^/${_DIM}  /;s/\$/${_OFF}/"
	if [ $(( ${#STALE[@]} + ${#GONE[@]} )) -gt 10 ]; then
		PRINT_TEXT "  … and %s more" 90 "$(( ${#STALE[@]} + ${#GONE[@]} - 10 ))"
	fi
	local CMD=""
	[ ${#STALE[@]} -gt 0 ] && CMD="git restore --source=HEAD --worktree -- $(_QUOTE_PATHS "${STALE[@]}")"
	[ ${#GONE[@]} -gt 0 ] && CMD="${CMD:+$CMD && }git clean -f -- $(_QUOTE_PATHS "${GONE[@]}")"
	_AT_TOP "$CO"
	PRINT_TEXT "${RESTORE_LEAD:-Reconcile those paths (discards what the $NOUN left there)}: %s" 33 "$REPLY$CMD"
}

# Reports what a worktree-isolated rewrite left behind in the branch's checkout – re-syncs the
# index entries it stranded and names the paths whose worktree content is now stale, with a
# targeted restore for exactly those
_PRINT_REWRITE_APPLY_HINT () {
	# Args: <branch-name> [<old-head> <new-head>] [<action>]
	local BRANCH="$1"
	local ACTION_NAME="$4"
	# Commits only added on top rewrote nothing – a `--commit`, or an `--exec` committing at the tip
	local MOVED=rewritten FORMER=pre-rewrite
	if [ -n "$2" ] && [ -n "$3" ] && git merge-base --is-ancestor "$2" "$3" 2>/dev/null; then
		MOVED=advanced FORMER=previous
	fi
	# A pure history rewrite leaves the tip tree byte-identical, so the checkout already
	# matches and a stash/reset dance would cycle unrelated WIP for nothing
	if [ -n "$2" ] && [ -n "$3" ] && \
	   [ "$(git rev-parse "$2^{tree}" 2>/dev/null)" = "$(git rev-parse "$3^{tree}" 2>/dev/null)" ]; then
		PRINT_TEXT "Branch %s $MOVED – tip tree unchanged, your checkout is already current." 32 "$BRANCH"
		return
	fi
	# Reconcile only what the rewrite touched – a blanket `reset --hard` discards unrelated
	# WIP and a stash dance cycles a checkout parallel sessions share, both risking work the
	# rewrite took care not to touch – and both sides of a rename, which `--name-only` would
	# otherwise fold into its destination
	local -a CHANGED
	if [ -n "$2" ] && [ -n "$3" ]; then
		# A gitlink by its commit, whatever `submodule.<name>.ignore` hides from a plain diff
		CHANGED=(${(0)"$(git diff --ignore-submodules=dirty -z --name-only --no-renames "$2" "$3" 2>/dev/null)"})
	fi
	if [ -n "${CHANGED[1]}" ]; then
		# A person at a terminal gets the checkout brought along, a drop's content leaving it as the
		# commit left the history
		local SYNC_CO=$(_BRANCH_CHECKOUT "refs/heads/$BRANCH")
		if [ -n "$SYNC_CO" ] && _SYNCS_CHECKOUT "$SYNC_CO"; then
			PRINT_TEXT "Branch %s $MOVED." 32 "$BRANCH"
			_SYNC_CHECKOUT "$SYNC_CO" "$2" "$3"
			return
		fi
		local CO=$(_BRANCH_CHECKOUT "refs/heads/$BRANCH")
		if [ -z "$CO" ]; then
			PRINT_TEXT "Branch %s $MOVED – checked out nowhere, nothing to reconcile." 32 "$BRANCH"
			return
		fi
		# A drop is the one rewrite whose leftover content is the point rather than staleness – it
		# stays in the checkout as uncommitted work, unstaged like any other, as staged a peer's fold
		# would land it again, and the discard is an opt-in that spares edits made on top of it
		if [ "$ACTION_NAME" = "drop" ]; then
			_RECONCILE_CHECKOUT "$CO" "$2" "$3" \
				"Branch $BRANCH rewritten – the dropped content stays in your checkout, unstaged:" "" \
				"Keep it, or discard it with"
			return
		fi
		# As does an undo's – the run it took back is work, which a restore would discard
		if [ "$ACTION_NAME" = "undo" ]; then
			_RECONCILE_CHECKOUT "$CO" "$2" "$3" \
				"Branch $BRANCH moved back – what the undone run landed stays in your checkout, unstaged:" "" \
				"Keep it, or discard it with"
			return
		fi
		_RECONCILE_CHECKOUT "$CO" "$2" "$3" \
			"Branch $BRANCH $MOVED – your checkout still holds the $FORMER content of:" \
			"Branch $BRANCH $MOVED – index re-synced, your checkout is current."
	else
		PRINT_TEXT "Branch %s $MOVED – your checkout was left as it was." 32 "$BRANCH"
	fi
}

# Names the untracked files a staging sweep absorbs – an amend takes them as readily as edits, so a
# scratch file left there joins the commit and reads as a tool bug in the summary – name
# them up front so the amend stays deliberate, and ignored paths never reach here anyway
_PRINT_UNTRACKED_ABSORB () {
	# Args: [<worktree>]
	local WT=${1:-.}
	local -a UNTRACKED
	UNTRACKED=("${(@f)$(git -C "$WT" ls-files --others --exclude-standard 2>/dev/null)}")
	if [ -z "${UNTRACKED[1]}" ]; then
		return 0
	fi
	PRINT_TEXT "Absorbing %s untracked file(s) that were not in the commit:" 33 "${#UNTRACKED[@]}"
	printf '%s\n' "${UNTRACKED[@]}" | head -10 | _CARET_LINES | LC_ALL=C sed "/./!d;s/^/${_DIM}  /;s/\$/${_OFF}/"
	if [ ${#UNTRACKED[@]} -gt 10 ]; then
		PRINT_TEXT "  … and %s more" 90 "$(( ${#UNTRACKED[@]} - 10 ))"
	fi
}

# Sweeps orphaned temp worktrees – ours go with the operation that made them, so debris
# from a killed process or a deleted repo – sweep only the provable case, a `.git` pointer
# whose gitdir is gone, since anything still registered may be a resolution someone wants
_GC_ORPHANED_WORKTREES () {
	setopt local_options null_glob
	local BASE=${TMPDIR:-/tmp}
	local -a REMOVED
	local DIR GITDIR
	for DIR in "${BASE%/}"/git-edit-*; do
		if [ ! -d "$DIR" ] || [ ! -f "$DIR/.git" ]; then
			continue
		fi
		GITDIR=$(LC_ALL=C sed -n 's/^gitdir: //p' "$DIR/.git" 2>/dev/null)
		# A relative pointer (`worktree.useRelativePaths`) runs from the worktree, not from here
		[[ -z "$GITDIR" || "$GITDIR" == /* ]] || GITDIR=$DIR/$GITDIR
		if [ -z "$GITDIR" ] || [ -e "$GITDIR" ]; then
			continue
		fi
		# A dangling pointer can also mean the repo's volume is merely
		# unmounted, so only sweep what has sat untouched for a day – `-mtime +1`
		# truncates to whole days and would mean two, so `-mmin` carries the 24h
		if [ -z "$(find "$DIR" -maxdepth 0 -mmin +1440 2>/dev/null)" ]; then
			continue
		fi
		if rm -rf "$DIR" 2>/dev/null; then
			REMOVED+=("${DIR:t}")
		fi
	done
	if [ -n "${REMOVED[1]}" ]; then
		PRINT_TEXT "Swept %s orphaned temp worktree(s) – their repo is gone" 90 "${#REMOVED[@]}"
	fi
}

# Refuses a git older than 2.31, the newest feature the script uses without a probe – below it
# some reads come back empty instead of failing (rerere scoping first, then `config --type` and
# `--exec`'s pushed guard), so the run would go on with them quietly off
_REQUIRE_GIT_VERSION () {
	local LINE=$(git --version 2>/dev/null)
	# Only a line that parses is judged (`2.50.1 (Apple Git-155)`, `2.39.5.windows.1`) – an
	# unfamiliar format says nothing about age
	[[ "$LINE" =~ '^git version ([0-9]+)\.([0-9]+)' ]] || return 0
	if (( match[1] < 2 || (match[1] == 2 && match[2] < 31) )); then
		PRINT_ERR "git 2.31 or later is required, found ${LINE#git version }"
		ECHO_E "\e[0;31m  Update git and re-run – below 2.31 some checks would read as off instead of failing.\e[0m" >&2
		exit 1
	fi
}

# Refuses where a commit the run validated is no longer in the tip it then read – a peer's rewrite
# landing between the two would have the run replay the old commits back
_REQUIRE_IN_TIP () {
	# Args: <tip> <commit>...
	local TIP=$1 C
	shift
	for C in "$@"; do
		[ -n "$C" ] || continue
		git merge-base --is-ancestor "$C" "$TIP" 2>/dev/null && continue
		PRINT_ERR "The branch moved while this run read it – ${C:0:7} is no longer in its history"
		ECHO_E "\e[0;31m  Nothing was applied – re-read the SHAs with 'git log' and run it again.\e[0m" >&2
		exit 1
	done
}

# Refuses a git dir, work tree or index named through the environment – a dotfiles alias's
# `--git-dir` – unless it names this directory's own, which it then drops – as every git a temp
# worktree runs would take it, and work on the caller's checkout
_REQUIRE_PLAIN_GIT_ENV () {
	[ -n "$GIT_DIR$GIT_WORK_TREE$GIT_INDEX_FILE$GIT_COMMON_DIR" ] || return 0
	local -a WITH WITHOUT
	WITH=("$(git rev-parse --absolute-git-dir 2>/dev/null)" "$(git rev-parse --show-toplevel 2>/dev/null)" "$(git rev-parse --path-format=absolute --git-path index 2>/dev/null)")
	WITHOUT=("$(unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR; git rev-parse --absolute-git-dir 2>/dev/null)" "$(unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR; git rev-parse --show-toplevel 2>/dev/null)" "$(unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR; git rev-parse --path-format=absolute --git-path index 2>/dev/null)")
	if [ -n "${WITH[1]}" ] && [ "${(j:|:)WITH}" = "${(j:|:)WITHOUT}" ]; then
		unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR
		return 0
	fi
	PRINT_ERR "GIT_DIR, GIT_WORK_TREE or GIT_INDEX_FILE names another repository, work tree or index than this directory's"
	ECHO_E "\e[0;31m  Run git edit from inside the checkout, without them – its temp worktrees would take them too.\e[0m" >&2
	exit 1
}

# Refuses every mutating mode while another operation is paused, the plumbing ones included –
# starting a second rewrite moves the branch under the paused one, whose CAS then refuses at
# apply time, which is safe but strands work that was resolvable a moment earlier
_REQUIRE_NO_INFLIGHT () {
	_STATE_EXISTS || return 0
	local SB=$(LC_ALL=C sed -n 's/^branch=//p' "$(_STATE_FILE_PATH)" 2>/dev/null | head -1) HERE=$(git symbolic-ref -q HEAD)
	SB=${SB#refs/heads/}
	# Neither mode pauses, so neither needs the slot – only a pause on its own branch is in the way,
	# whose landing it would strand
	if [ ${#OPT_COMMIT} -gt 0 -o ${#OPT_EXEC} -gt 0 ] && [ -n "$SB" ] && [ -n "$HERE" ] && [ "$SB" != "${HERE#refs/heads/}" ]; then
		return 0
	fi
	PRINT_ERR "Another git-edit operation is in flight${SB:+ on $SB}, paused for its resolution"
	ECHO_E "\e[0;31m  If it is yours, 'git edit --continue' or 'git edit --abort' it – if another session's, wait for it ('git edit --status' shows it).\e[0m" >&2
	exit 1
}

# Refuses a pause where a parallel run's took the state slot while this one ran – that check came
# too late, so the same error, which drivers already wait out, and the exit trap removes a worktree
# the run made, as a pause records itself before anything is authored there
_REFUSE_PEER_PAUSE () {
	PRINT_ERR "Another git-edit operation is in flight (paused for resolution)"
	ECHO_E "\e[0;31m  It paused while this one ran, so nothing was applied – retry once it is continued or aborted.\e[0m" >&2
	exit 1
}

# Refuses a branch that moved under a resolution – a parallel session landed a commit, so the
# rewrite cannot apply, but the resolution is finished and the worktree holds the only copy,
# so keep it and its state rather than letting the exit trap strand both
_REFUSE_MOVED_BRANCH () {
	# Args: <branch> <worktree>
	_CLEANUP_HOOK=""
	PRINT_ERR "Branch '$1' moved during resolution – refusing to overwrite"
	PRINT_TEXT "Your resolution is intact in %s" 33 "$2"
	PRINT_TEXT "It was built on the old tip, so it can't apply – %s, then redo it against the new tip." 33 "git edit --abort"
	exit 1
}

# Saves a drop's or squash's pause – at a conflict, or where a gate refused the result – for
# `--continue` to resume in its worktree, a squash's `--text` beside it, as a state line can't
# hold a multi-line message
_SAVE_REBASE_STATE () {
	_SAVE_STATE "operation=rebase" "action=$ACTION" "worktree=$WORKTREE_DIR" "wt_ours=${WT_OURS:-0}" \
		"branch=refs/heads/$ORIG_BRANCH" "orig_head=$ORIG_HEAD" "target=$COMMIT" "targets=${(j: :)COMMITS}" \
		"squash_target=$TARGET" "message=${OPT_MESSAGE:+editor}" || exit 1
	[ -n "$TEXT_VALUE" ] && print -r -- "$TEXT_VALUE" > "$(_TEXT_MSG_PATH)"
	_CLEANUP_HOOK=""
}

# Puts into `REPLY` the command resuming a drop's or squash's rebase. The override carrying a
# squash's message lasts one rebase invocation, so each resume re-establishes it, aimed at the
# fold, since a resume commits the conflicted step too – `--text` from <file>, else `-m`'s editor
_REBASE_CONTINUE_CMD () {
	# Args: <--continue|--skip> [<file holding --text>] [real – `-m` asked for the editor]
	local SUBCMD=$1 FOLD_EDITOR
	# A stand-in on every resume, as one commits the conflicted step too – the fold without a message
	# of its own keeps git's, its comments stripped
	if [ -n "$2" ] && [ -f "$2" ]; then
		FOLD_EDITOR=$(_FOLD_EDITOR_CMD "cp ${(qq)2}")
	elif [ "$3" = real ]; then
		_RESOLVE_REAL_EDITOR || exit 1
		FOLD_EDITOR=$(_FOLD_EDITOR_CMD "${(qq)_REAL_EDITOR}" "" strip tty)
	else
		FOLD_EDITOR=$(_FOLD_EDITOR_CMD true "" strip)
	fi
	[ -n "$FOLD_EDITOR" ] || exit 1
	_TEMP_FILES+=("$FOLD_EDITOR")
	# Safe because the stand-in writes every replayed message back itself
	REPLY="GIT_SEQUENCE_EDITOR=true GIT_EDITOR=${(q)FOLD_EDITOR} git -c commit.cleanup=whitespace -c rerere.enabled=true -c rerere.autoUpdate=false -c rebase.updateRefs=false $_CAPTURE_PINS rebase $SUBCMD"
}

# Keeps a squash whose commits cancel each other out as one empty commit – skipping it would bring
# back the change one took away – with the message the squash would have taken: `--text`, `-m`'s
# editor on the one git combined, else the target's, as its fixups keep
_AMEND_EMPTY_FOLD () {
	# Args: [<file holding --text>] [real – `-m` asked for the editor]
	# Under the capture's pins, its pair recorded – a rewrite announced only once it lands
	local OLD=$(git rev-parse HEAD) RC
	if [ -n "$1" ] && [ -f "$1" ]; then
		git -c commit.cleanup=whitespace "${_CAPTURE_PIN_ARGS[@]}" commit -q --amend --allow-empty -F "$1" </dev/null >/dev/null 2>&1
	elif [ "$2" = real ]; then
		_RESOLVE_REAL_EDITOR || return 1
		GIT_EDITOR=${(qq)_REAL_EDITOR} git "${_CAPTURE_PIN_ARGS[@]}" commit -q --amend --allow-empty --edit -F "$(git rev-parse --git-path rebase-merge/message)" </dev/tty >/dev/tty
	else
		git "${_CAPTURE_PIN_ARGS[@]}" commit -q --amend --allow-empty --no-edit </dev/null >/dev/null 2>&1
	fi
	RC=$?
	(( RC == 0 )) && _CAPTURE_RECORD "$OLD" "$(git rev-parse HEAD)"
	return $RC
}

# Runs a drop's or squash's rebase command in its worktree, then whatever its stops need short of a
# resolution – a squash cancelling out is kept, empty – returning 0 once the rebase is done, 2 at a
# conflict and 1 where it stopped any other way, its output in `REBASE_OUT`
_REBASE_DRIVE () {
	# Args: <command, eval'd> [<file holding --text>] [real – `-m` asked for the editor]
	local CMD=$1 STATUS GITDIR OUTF=$(MKTEMP_FILE git-edit-rebase-out)
	_TEMP_FILES+=("$OUTF")
	_RERERE_SCOPE_BEGIN
	while true; do
		# Pinned to C – the stops below are told apart by git's English wording, which homebrew git
		# localizes wherever the locale environment is empty – kept whole in a file for them, and
		# shown as it comes, a subject's control bytes inert
		( export LC_ALL=C; eval "$CMD" ) 2>&1 | tee "$OUTF" | _CARET_LINES --crlf >&2
		STATUS=${pipestatus[1]}
		REBASE_OUT=$(<"$OUTF")
		[ $STATUS -eq 0 ] && return 0
		GITDIR=$(git rev-parse --git-dir 2>/dev/null)
		[ -d "$GITDIR/rebase-merge" ] || [ -d "$GITDIR/rebase-apply" ] || return 1
		if [ -n "$(_UNMERGED_IN .)" ] || [[ "$REBASE_OUT" == *"CONFLICT ("* ]]; then
			return 2
		fi
		if [[ "$REBASE_OUT" == *"--allow-empty"* || "$REBASE_OUT" == *"No changes - did you forget to use"* ]] && \
		   [[ "$(tail -1 "$GITDIR/rebase-merge/done" 2>/dev/null)" == (fixup|squash|f|s)\ * ]]; then
			PRINT_TEXT "%s – the combined commit stays, empty." 33 "The squashed commits cancel each other out"
			_AMEND_EMPTY_FOLD "$2" "$3" || return 1
			_REBASE_CONTINUE_CMD --continue "$2" "$3"
			CMD=$REPLY
			continue
		fi
		return 1
	done
}

# Names how a rebase stopped where nothing was left to resolve – git's own first words, since
# no resume decides it
_REBASE_STOPPED () {
	local LINE
	for LINE in ${(f)REBASE_OUT}; do
		[[ "$LINE" == (error|fatal|hint):* ]] || continue
		print -r -- "${LINE#*: }"
		return 0
	done
	print -r -- "${REBASE_OUT##*$'\n'}"
}

# Pauses a drop or squash at a conflict, for the caller to resolve in its worktree
_REBASE_CONFLICT_PAUSE () {
	_SAVE_REBASE_STATE
	PRINT_ERR "Conflict during $ACTION – resolve in worktree, then 'git edit --continue'"
	PRINT_TEXT "Worktree: %s" 33 "$WORKTREE_DIR"
	local UNMERGED_LIST=$(_PRINT_CONFLICT_DETAIL "$WORKTREE_DIR")
	PRINT_TEXT "Or abort the operation: %s" 33 "git edit --abort"
	EMIT_CONFLICT "$WORKTREE_DIR" "$UNMERGED_LIST"
	_PAUSE_EXIT 2 conflict
}

# Runs a drop's or squash's own rebase from the start – a conflict pauses, and a rebase stopping
# any other way leaves the branch as it was, its worktree going with the run
_REBASE_FROM_START () {
	# Args: <sequence editor script> <file holding --text, or empty> <real, or empty – `-m` asked
	# for the editor> <rebase argument>...
	local SEQ=$1 TEXT_FILE=$2 EDITOR_MODE=$3
	shift 3
	local -a ARGS=("$@")
	# The fold's editor, where the squash brings a message of its own – a stand-in writing every
	# other step's message back, the editor itself on the terminal, as the run's output is captured
	local FOLD_EDITOR=true
	if [ -n "$TEXT_FILE" ]; then
		FOLD_EDITOR=$(_FOLD_EDITOR_CMD "cp ${(qq)TEXT_FILE}")
	elif [ "$EDITOR_MODE" = real ]; then
		_RESOLVE_REAL_EDITOR || exit 1
		FOLD_EDITOR=$(_FOLD_EDITOR_CMD "${(qq)_REAL_EDITOR}" "" strip tty)
	fi
	[ "$FOLD_EDITOR" != true ] && _TEMP_FILES+=("$FOLD_EDITOR")
	_REBASE_DRIVE "GIT_SEQUENCE_EDITOR=${(q)SEQ} GIT_EDITOR=${(q)FOLD_EDITOR} git ${ARGS[*]}" "$TEXT_FILE" "$EDITOR_MODE"
	case $? in
		0) return 0 ;;
		2) _REBASE_CONFLICT_PAUSE ;;
	esac
	PRINT_ERR "git rebase stopped without a conflict to resolve: $(_REBASE_STOPPED)"
	ECHO_E "\e[0;31m  Nothing was applied – the branch is as it was.\e[0m" >&2
	exit 1
}

# The rebase every drop and squash starts with, from the parent of its oldest commit – `--empty=drop`
# so a commit the rewrite leaves empty goes, as one rebuilt any other way does, and full SHAs in
# the todo, as two commits can share the 7 hex its edits would otherwise match
_REBASE_ARGS () {
	# Args: <oldest commit> – fills `reply`
	reply=(-c rerere.enabled=true -c rerere.autoUpdate=false -c rebase.updateRefs=false -c rebase.instructionFormat= -c core.abbrev=no $_CAPTURE_PINS rebase $_CAPTURE_EXEC --no-autosquash --no-autostash --empty=drop --interactive)
	[ "$1" = squash-text ] && { reply=(-c commit.cleanup=whitespace "${reply[@]}"); shift; }
	if git show -s --pretty=%P "$1" | grep -q .; then
		reply+=("$1~")
	else
		reply+=(--root)
	fi
}

GIT_REBASE_DROP () {
	_CAPTURE_BEGIN
	_REBASE_ARGS "$COMMIT"
	local -a CMD=("${reply[@]}")
	PRINT_CMD "git ${CMD[*]} # -> drop"
	local SED_SCRIPT="" C
	for C in "${COMMITS[@]}"; do
		SED_SCRIPT+=" -e 's/^pick $C/drop $C/'"
	done
	# `-i` with its suffix attached, the one in-place form BSD and GNU sed both read – the backup
	# goes with the rebase's state directory
	_REBASE_FROM_START "LC_ALL=C sed -i.git-edit$SED_SCRIPT" "" "" "${CMD[@]}"
}

GIT_REBASE_SQUASH () {
	_CAPTURE_BEGIN
	# `squash` opens `GIT_EDITOR` on the combined message where `fixup` does not, so it is used
	# where the caller supplies one (`--text`) or wants to edit it (`-m`)
	local OP=fixup
	[[ -n "$TEXT_VALUE" || -n "$OPT_MESSAGE" ]] && OP=squash
	# Without a message in hand, the editor opens partway through – refused up front where none can
	[[ "$OP" == squash && -z "$TEXT_VALUE" ]] && _REQUIRE_TTY_FOR_EDITOR
	# The initial run opens an editor only for the fold, never for a clean pick, so `--text`'s own
	# `#` lines just need git's cleanup out of the way – with `-m` the editor shows git's template,
	# whose comments still have to go
	if [ -n "$TEXT_VALUE" ]; then
		_REBASE_ARGS squash-text "${COMMITS[1]}"
	else
		_REBASE_ARGS "${COMMITS[1]}"
	fi
	local -a CMD=("${reply[@]}")
	PRINT_CMD "git ${CMD[*]} # -> reorder+$OP"
	local SED_SCRIPT="" APPEND="" C
	for C in "${COMMITS[@]}"; do
		[[ "$C" == "$TARGET" ]] && continue
		SED_SCRIPT+=" -e '/^pick $C/d'"
		APPEND+=$'\\\n'"$OP $C"
	done
	local TEXT_FILE=""
	if [ -n "$TEXT_VALUE" ]; then
		TEXT_FILE=$(MKTEMP_FILE git-edit-squash-msg)
		_TEMP_FILES+=("$TEXT_FILE")
		printf '%s\n' "$TEXT_VALUE" > "$TEXT_FILE"
	fi
	_REBASE_FROM_START "LC_ALL=C sed -i.git-edit$SED_SCRIPT -e '/^pick $TARGET/a$APPEND'" "$TEXT_FILE" "${OPT_MESSAGE:+real}" "${CMD[@]}"
}

# Names the commits a drop or squash left empty and its rebase dropped – the caller named the
# others, so only these go unasked, matched by subject as a rewrite changes every SHA
_PRINT_EMPTIED () {
	# Args: <old tip> <new tip> <squash target or empty> <commit the caller named>...
	local OLD=$1 NEW=$2 TGT=$3 LINE SUBJECT
	shift 3
	local MB=$(git merge-base "$OLD" "$NEW" 2>/dev/null)
	local -a BEFORE GONE
	local -A NAMED SURVIVING
	for LINE in "$@"; do NAMED[$LINE]=1; done
	for LINE in ${(f)"$(git log --format='%H %s' ${MB:+$MB..}$OLD 2>/dev/null)"}; do
		(( ${+NAMED[${LINE%% *}]} )) || BEFORE+=("$LINE")
	done
	local -i AFTER=$(git rev-list --count ${MB:+$MB..}$NEW 2>/dev/null)
	# The squash's target is the one named commit left standing
	[ -n "$TGT" ] && AFTER=$(( AFTER - 1 ))
	(( ${#BEFORE} > AFTER )) || return 0
	while IFS= read -r SUBJECT; do
		SURVIVING[s:$SUBJECT]=$(( ${SURVIVING[s:$SUBJECT]:-0} + 1 ))
	done <<< "$(git log --format=%s ${MB:+$MB..}$NEW 2>/dev/null)"
	for LINE in "${BEFORE[@]}"; do
		SUBJECT=${LINE#* }
		if (( ${SURVIVING[s:$SUBJECT]:-0} > 0 )); then
			SURVIVING[s:$SUBJECT]=$(( ${SURVIVING[s:$SUBJECT]} - 1 ))
		else
			GONE+=("${LINE:0:7} $SUBJECT")
		fi
	done
	PRINT_TEXT "%s commit(s) left empty by the %s were dropped:" 33 "$(( ${#BEFORE} - AFTER ))" "${ACTION:-$STATE_ACTION}"
	# Named only where the count agrees – a commit whose subject has no counterpart is not one
	(( ${#GONE} == ${#BEFORE} - AFTER )) || return 0
	printf '%s\n' "${GONE[@]}" | _CARET_LINES | LC_ALL=C sed "s/^/  emptied: /;s/^/${_DIM}/;s/\$/${_OFF}/"
}

# Lands what a drop's or squash's rebase built in its worktree – gated, compare-and-swapped onto the
# tip the run read, then reported – for the run that built it and for the resume finishing it
_LAND_REBASE () {
	# Args: <worktree> <branch ref> <old tip> <drop|squash> <commit naming the run> <squash target
	# or empty> <commit the caller named>...
	local WT=$1 REF=$2 OLD=$3 ACT=$4 LBL=$5 TGT=$6 NEW T
	shift 6
	local -a NAMED=("$@")
	NEW=$(git -C "$WT" rev-parse HEAD)
	# A drop undoes its commits' own mode changes at the tip, the one rebase action that means one
	local MEANT=""
	if [ "$ACT" = drop ]; then
		for T in "${NAMED[@]}"; do MEANT+="$(_MODE_LINES "$WT" "$T" "$T^")"$'\n'; done
	fi
	if ! _GUARD_TIP_MODES "$WT" "$NEW" "$OLD" "$MEANT" || ! _VERIFY_REWRITE "$WT" "$NEW" "$OLD" ""; then
		[ -n "$_STATE_OWNED" ] || _SAVE_REBASE_STATE
		_CLEANUP_HOOK=""
		EMIT_GATE_PAUSED "$WT" "$NEW"
		_PAUSE_EXIT 2 gate
	fi
	# A squash keeps the tip's content by construction – a replay that changed it, through a
	# resolution say, lands nothing
	if [ "$ACT" = squash ] && [ "$(git rev-parse "$NEW^{tree}")" != "$(git rev-parse "$OLD^{tree}")" ]; then
		PRINT_ERR "The squash would change the tip's content – not applied"
		if [ -n "$_STATE_OWNED" ]; then
			_CLEANUP_HOOK=""
			PRINT_TEXT "A resolution changed what the squashed commits add up to – %s, then squash again." 33 "git edit --abort"
			_PAUSE_EXIT 1 retry
		fi
		exit 1
	fi
	# Only where the ref still holds the tip the run read, so a concurrent commit, from an editor
	# working in the checkout say, is never overwritten
	local CMD="git update-ref -m ${(q-)${:-git edit: $ACT ${LBL:0:7}$_REFLOG_TAG}} ${(q-)REF} ${(q-)NEW} ${(q-)OLD}"
	PRINT_CMD "$CMD"
	if ! _MOVE_REF "$CMD"; then
		[ -n "$_STATE_OWNED" ] && _REFUSE_MOVED_BRANCH "${REF#refs/heads/}" "$WT"
		PRINT_ERR "Branch '${REF#refs/heads/}' moved during the $ACT – refusing to overwrite"
		ECHO_E "\e[0;31m  Nothing was applied – run the $ACT again on its new tip.\e[0m" >&2
		exit 1
	fi
	_RECORD_REF_MOVE "$REF" "$OLD" "$NEW" "$ACT ${LBL:0:7}"
	_PRINT_REWRITE_APPLY_HINT "${REF#refs/heads/}" "$OLD" "$NEW" "$ACT"
	_PRINT_MODE_CHANGES "$OLD" "$NEW"
	_PRINT_TREE_IDENTITY "$OLD" "$NEW"
	_PRINT_EMPTIED "$OLD" "$NEW" "$TGT" "${NAMED[@]}"
	# Named from what the caller selected, never located in the replayed range – a replay drops a
	# commit that went empty and a fold consumes commits from either side of its target
	if [ "$ACT" = squash ] && [ -n "$TGT" ]; then
		_PRINT_DROPPED_BODIES "$TGT" "${NAMED[@]}"
		_PRINT_COMMIT_LINE "$TGT" '  squashed into: %h %s'
	elif [ "$ACT" = drop ]; then
		# The hint above lists the restored paths, one per file – unbounded, so the commits' own
		# names follow it rather than precede it
		for T in "${NAMED[@]}"; do _PRINT_COMMIT_LINE "$T" '  dropped: %h %s'; done
	fi
}

# Answers whether the current squash could take the plumbing-only path, so `-s` can auto-route
# to `-S` safely:
# • The selected commits form a contiguous range
# • Target, where given, equals the oldest commit, so nothing reorders
# • No commit in the range is a merge
# Operates implicitly on the global `$COMMITS` array and optional `$TARGET`
_RESQUASH_ELIGIBLE () {
	local OLDEST=${COMMITS[1]}
	local NEWEST=${COMMITS[-1]}

	# Target must equal oldest – any other target requires reordering, which
	# the plumbing path can't do
	[ -n "$TARGET" ] && [ "$TARGET" != "$OLDEST" ] && return 1

	# Contiguity check: the inclusive range `OLDEST..NEWEST` must equal the
	# selected commits exactly, in the same order
	local EXPECTED
	if git rev-parse --verify "$OLDEST^" >/dev/null 2>&1; then
		EXPECTED=($(git rev-list --reverse "$OLDEST^..$NEWEST" 2>/dev/null))
	else
		EXPECTED=($(git rev-list --reverse "$NEWEST" 2>/dev/null))
	fi

	[ ${#EXPECTED[@]} -ne ${#COMMITS[@]} ] && return 1

	local i
	for (( i=1; i<=${#COMMITS[@]}; i++ )); do
		[ "${COMMITS[$i]}" != "${EXPECTED[$i]}" ] && return 1
	done

	# No merge commits in the range
	local C P_LIST
	for C in "${COMMITS[@]}"; do
		P_LIST=$(git log -1 --format='%P' "$C")
		[[ "$P_LIST" == *" "* ]] && return 1
	done

	_SQUASH_LEAVES_REACHABLE "$NEWEST" "${(@)COMMITS[1,-2]}" && return 1

	return 0
}

# Succeeds where a commit above <newest> takes one of <inner> as a parent – squashed away, that one
# would stay reachable through it, twice
_SQUASH_LEAVES_REACHABLE () {
	# Args: <newest> <inner commit>...
	local NEWEST=$1
	shift
	git rev-list --parents "$NEWEST..HEAD" 2>/dev/null | awk -v inner="$*" '
		BEGIN { n = split(inner, a, " "); for (i = 1; i <= n; i++) s[a[i]] = 1 }
		{ for (i = 2; i <= NF; i++) if ($i in s) found = 1 }
		END { exit !found }'
}

# Refuses an `--exec` result carrying commits made before the run that would take commits off
# the branch – built elsewhere, on a tip nothing names, so whatever reached the branch since
# would leave with the rest. The newest of those lead the list, being the likeliest someone else's
_REFUSE_EXEC_PREBUILT () {
	# Args: <orig-head> <new-head> <ref> <commits-made-before-the-run>
	local ORIG_HEAD=$1
	local NEW_HEAD=$2
	local BRANCH=${3#refs/heads/}
	local PRE_RUN=$4
	local -i LEAVING=$(git rev-list --count "$NEW_HEAD..$ORIG_HEAD" 2>/dev/null)
	# A rewind is the one shape with a mode of its own – a drop names its commits rather than
	# resetting past whatever the tip has become
	local REWIND=false
	git merge-base --is-ancestor "$NEW_HEAD" "$ORIG_HEAD" 2>/dev/null && REWIND=true
	if [ "$REWIND" = true ]; then
		PRINT_ERR "HEAD moved back to ${NEW_HEAD:0:7} – a reset past the tip drops whatever sits above it, a commit that reached $BRANCH meanwhile included"
	else
		PRINT_ERR "HEAD moved to ${NEW_HEAD:0:7}, carrying $PRE_RUN commit(s) made before this run – landing a history built elsewhere would drop whatever reached $BRANCH after it was built"
	fi
	ECHO_E "\e[0;31m  It takes $LEAVING commit(s) off $(_LIT "$BRANCH"), the newest first:\e[0m" >&2
	git log --format='%h %s' -5 "$NEW_HEAD..$ORIG_HEAD" 2>/dev/null | _CARET_LINES | LC_ALL=C sed "s/^/${_RED}    /;s/\$/${_OFF}/" >&2
	(( LEAVING > 5 )) && ECHO_E "\e[0;31m    … and $(( LEAVING - 5 )) more\e[0m" >&2
	if [ "$REWIND" = true ]; then
		ECHO_E "\e[0;31m  To drop commits, name them: git edit -d <sha>... – or pin the tip you expect with --base=<sha>.\e[0m" >&2
	else
		ECHO_E "\e[0;31m  Name the tip it was built on, refused again if $(_LIT "$BRANCH") has moved past it: git edit --exec --base=<sha> -- ...\e[0m" >&2
	fi
}

# Refuses an `--exec --base` whose tip the branch has moved past – naming what reached it since,
# and the rebase that carries those onto a history built on the base, inside the run itself
_REFUSE_EXEC_BASE_MOVED () {
	# Args: <base> <orig-head> <ref>
	local BASE=$1
	local ORIG_HEAD=$2
	local BRANCH=${3#refs/heads/}
	# `--commit` pins the tip it composed on, which the caller never named
	if [ ${#OPT_COMMIT} -gt 0 ]; then
		PRINT_ERR "$BRANCH moved to ${ORIG_HEAD:0:7} while the commit was composed on ${BASE:0:7} – nothing landed, so run it again"
		return 0
	fi
	if ! git merge-base --is-ancestor "$BASE" "$ORIG_HEAD" 2>/dev/null; then
		PRINT_ERR "$BRANCH was rewritten since --base ${BASE:0:7} – it is no longer an ancestor of the tip"
		ECHO_E "\e[0;31m  Rebuild on the current tip, ${ORIG_HEAD:0:12}.\e[0m" >&2
		return 0
	fi
	local -i SINCE=$(git rev-list --count "$BASE..$ORIG_HEAD" 2>/dev/null)
	PRINT_ERR "$BRANCH moved past --base ${BASE:0:7} – $SINCE commit(s) reached it since, which landing a history built on it would drop"
	git log --format='%h %s' -10 "$BASE..$ORIG_HEAD" 2>/dev/null | _CARET_LINES | LC_ALL=C sed "s/^/${_RED}    /;s/\$/${_OFF}/" >&2
	(( SINCE > 10 )) && ECHO_E "\e[0;31m    … and $(( SINCE - 10 )) more\e[0m" >&2
	ECHO_E "\e[0;31m  Rebuild on the tip, or carry them onto your history in the run:\e[0m" >&2
	ECHO_E "\e[0;31m    git edit --exec --base=${ORIG_HEAD:0:12} -- git rebase --onto <your history> ${BASE:0:12}\e[0m" >&2
}

# Lists each commit an `--exec` result brings in whose message ends in more blank lines than
# the one it replaces, as a line of SHA and subject. The one it replaces shares its subject or
# its author and author date, which a reword keeps – a commit matching neither came from
# elsewhere, a branch brought in, and carries its message as it was. Only a byte count sees
# them: `git log` and `git range-diff` both trim
_EXEC_GAINED_BLANK_LINES () {
	# Args: <orig-head> <new-head>
	setopt local_options extended_glob
	local -A LEFT
	local SIDE RAW ENTRY BODY KEY
	local -a F
	local -i EXTRA BEFORE
	for SIDE in leaving arriving; do
		# `-z` ends each entry in a NUL rather than a newline, so a body keeps its own trailing
		# ones, and the `x` keeps the last entry's whether or not git closes it with a NUL
		if [ $SIDE = leaving ]; then
			RAW=$(git log -z --format='%H%x01%s%x01%ae %at%x01%B' "$2..$1" 2>/dev/null; print -n x)
		else
			RAW=$(git log -z --format='%H%x01%s%x01%ae %at%x01%B' "$1..$2" 2>/dev/null; print -n x)
		fi
		for ENTRY in "${(@0)${RAW%x}}"; do
			[ -z "$ENTRY" ] && continue
			F=("${(@ps:\x01:)ENTRY}")
			BODY=${F[4]}
			EXTRA=$(( ${#BODY} - ${#${BODY%%[$'\n']##}} - 1 ))
			(( EXTRA < 0 )) && EXTRA=0
			if [ $SIDE = leaving ]; then
				for KEY in "s ${F[2]}" "a ${F[3]}"; do
					(( EXTRA > ${LEFT[$KEY]:--1} )) && LEFT[$KEY]=$EXTRA
				done
			else
				BEFORE=-1
				for KEY in "s ${F[2]}" "a ${F[3]}"; do
					(( ${LEFT[$KEY]:--1} > BEFORE )) && BEFORE=${LEFT[$KEY]}
				done
				(( BEFORE >= 0 && EXTRA > BEFORE )) && print -r -- "${F[1]:0:7} ${F[2]}"
			fi
		done
	done
}

# Refuses an `--exec` result whose messages gained trailing blank lines – the mark of a loop
# feeding `%B` raw to `commit-tree`, which adds one to every message it rebuilds, one more per
# pass, where nothing downstream shows it
_REFUSE_EXEC_BLANK_LINES () {
	# Args: <new-head> <gained, one `<sha> <subject>` a line>
	local -a GAINED=("${(@f)2}")
	PRINT_ERR "HEAD moved to ${1:0:7}, but ${#GAINED} message(s) it brings in end in more blank lines than before – a message read with %B and fed raw to commit-tree gains one each pass, which git log and git range-diff both hide"
	print -rl -- "${(@)GAINED[1,5]}" | _CARET_LINES | LC_ALL=C sed "s/^/${_RED}    /;s/\$/${_OFF}/" >&2
	(( ${#GAINED} > 5 )) && ECHO_E "\e[0;31m    … and $(( ${#GAINED} - 5 )) more\e[0m" >&2
	ECHO_E "\e[0;31m  Take each message from git cat-file commit, or trim its trailing newlines to one, and rebuild.\e[0m" >&2
}

# Runs an arbitrary command inside a fresh per-invocation worktree, detached at the branch
# tip – where the command rewrites `HEAD`, the original ref moves by atomic CAS, refusing
# if the branch moved, so raw rewriting commands never touch the main checkout
GIT_EXEC () {
	local ORIG_HEAD=$(git rev-parse HEAD)
	local BRANCH=${$(git symbolic-ref -q HEAD 2>/dev/null)#refs/heads/}
	# The CAS runs in the temp worktree, where `HEAD` names that worktree's own, never the checkout's
	if [ -z "$BRANCH" ]; then
		PRINT_ERR "--exec requires being on a branch (got detached HEAD)"
		exit 1
	fi
	local REF="refs/heads/$BRANCH"
	# Defaults for the status trailer, updated below if `HEAD` changes
	EXEC_NEW_HEAD=$ORIG_HEAD
	EXEC_REF=$REF
	EXEC_CHANGED=false
	EXEC_PEER_MOVE=""
	EXEC_DRY_BUILT=""
	EXEC_DRY_BASE=""

	# A pinned tip the branch has moved past refuses before the command runs – whatever it
	# builds on that base would drop what reached the branch since
	if [ -n "$EXEC_BASE" ] && [ "$EXEC_BASE" != "$ORIG_HEAD" ]; then
		_REFUSE_EXEC_BASE_MOVED "$EXEC_BASE" "$ORIG_HEAD" "$REF"
		exit 1
	fi

	# Unique per-invocation worktree so concurrent --exec calls never collide
	local WT
	WT=$(MKTEMP_DIR git-edit-exec) || exit 1
	rmdir "$WT"  # `git worktree add` wants to create the dir itself
	# Register cleanup via the global hook so the `EXIT` trap removes the worktree on any
	# exit path – success, failure or signal, a failed add's registration too
	_CLEANUP_HOOK="git worktree remove --force ${(q-)WT} 2>/dev/null; rm -rf ${(q-)WT}"
	_WORKTREE_ADD "$WT" "$ORIG_HEAD" || exit 1
	_LINK_WORKTREE_EXTRAS "$WT"

	cd "$WT" || exit 1

	# Run the caller's command – no `eval`, the array passes straight through so quoting
	# and special characters survive. The clock is read first: a result committed before it
	# was built somewhere else, on a tip nothing here can name
	local RUN_START=$(date +%s)
	# A labeled run is git-edit's own, already named by its action line
	[ -z "$EXEC_LABEL" ] && PRINT_CMD "$(_SHQ "$@") # (in $WT)"
	( _CALLER_ENV_BACK; "$@" )
	local STATUS=$?
	# The branch itself moved meanwhile – the command updating it, or a peer – which this run lands
	# nothing over, and reports rather than call it unchanged
	local NOW_TIP=$(git rev-parse -q --verify "$REF" 2>/dev/null)
	local MOVED_NOTE=""
	[ "$NOW_TIP" != "$ORIG_HEAD" ] && MOVED_NOTE="$BRANCH moved meanwhile, ${ORIG_HEAD:0:7} → ${NOW_TIP:0:7}, not by this run"

	if [ $STATUS -ne 0 ]; then
		if [ -n "$MOVED_NOTE" ]; then
			PRINT_ERR "Command exited with status $STATUS – this run applied nothing, though $MOVED_NOTE"
		elif [ -n "$EXEC_LABEL" ]; then
			# `--commit` runs no command of the caller's – its commit is what refused, a hook's doing
			PRINT_ERR "The commit was refused (exit $STATUS) – a hook of the repository's, most often – so nothing landed"
		else
			PRINT_ERR "Command exited with status $STATUS – leaving original branch unchanged"
		fi
		exit $STATUS
	fi

	# Did the command move `HEAD`? If so, apply the new tip to the original ref
	local NEW_HEAD=$(git rev-parse HEAD)
	if [ "$NEW_HEAD" = "$ORIG_HEAD" ]; then
		if [ -n "$MOVED_NOTE" ]; then
			PRINT_TEXT "HEAD unchanged in the worktree – nothing to apply, but %s." 33 "$MOVED_NOTE"
			# The trailer's move is this run's alone – a peer's is named beside "unchanged"
			EXEC_PEER_MOVE="moved meanwhile by another run, ${ORIG_HEAD:0:7} → ${NOW_TIP:0:7}"
		else
			PRINT_TEXT "HEAD unchanged – nothing to apply." 33
		fi
		return 0
	fi

	# Pushed guard – any remote ref that was an ancestor of the old tip must still be one of
	# the new tip, checked on the result since `--exec` cannot know its targets up front,
	# with two `--merged` walks in place of a per-ref `merge-base` loop
	if [ ${#OPT_ALLOW_PUSHED} -eq 0 ]; then
		local R=$(comm -23 <(git for-each-ref refs/remotes --format='%(refname)' --merged "$ORIG_HEAD" | sort) <(git for-each-ref refs/remotes --format='%(refname)' --merged "$NEW_HEAD" | sort) | head -1)
		if [ -n "$R" ]; then
			PRINT_ERR "Command rewrote pushed history ($R would be orphaned) – not applied"
			ECHO_E "\e[0;31m  Rewritten history is at $NEW_HEAD; pass --allow-pushed to override.\e[0m" >&2
			exit 1
		fi
	fi

	# Built-elsewhere guard – the CAS covers only the command's own run, so a history built before
	# it, landed as a rewrite, would drop whatever reached the branch after it was built, reporting
	# `ok`. Every commit the result brings in counts, not just its tip, which a commit made on top
	# in the run would date anew; and a reset to an ancestor predates the run by definition. A
	# descendant drops nothing, and `--base` names the tip the history was built on
	if [ -z "$EXEC_BASE" ] && ! git merge-base --is-ancestor "$ORIG_HEAD" "$NEW_HEAD" 2>/dev/null; then
		local -i PRE_RUN=0
		if ! git merge-base --is-ancestor "$NEW_HEAD" "$ORIG_HEAD" 2>/dev/null; then
			PRE_RUN=$(git log --format=%ct "$ORIG_HEAD..$NEW_HEAD" 2>/dev/null | awk -v t="$RUN_START" '$1 < t' | wc -l)
		fi
		if git merge-base --is-ancestor "$NEW_HEAD" "$ORIG_HEAD" 2>/dev/null || (( PRE_RUN > 0 )); then
			_REFUSE_EXEC_PREBUILT "$ORIG_HEAD" "$NEW_HEAD" "$REF" "$PRE_RUN"
			exit 1
		fi
	fi

	# Message guard – a hand-rolled rebuild loop is the one place a message gets retyped, and
	# its commonest slip is invisible, so the dry run refuses it too, before anyone inspects
	local GAINED=$(_EXEC_GAINED_BLANK_LINES "$ORIG_HEAD" "$NEW_HEAD")
	if [ -n "$GAINED" ]; then
		_REFUSE_EXEC_BLANK_LINES "$NEW_HEAD" "$GAINED"
		exit 1
	fi

	# A dry run stops at the result – no gate, no CAS – and hands over the landing, pinned to
	# the tip it built on, so running the command outside `--exec` never looks like the way to
	# inspect a rewrite first
	if [ ${#OPT_DRY_RUN} -gt 0 ]; then
		EXEC_DRY_BASE=$ORIG_HEAD
		local MB=$(git merge-base "$ORIG_HEAD" "$NEW_HEAD" 2>/dev/null)
		local PUSHED_FLAG=""
		[ ${#OPT_ALLOW_PUSHED} -gt 0 ] && PUSHED_FLAG=" --allow-pushed"
		PRINT_TEXT "Dry run – built %s on %s, neither verified nor applied." 33 "${NEW_HEAD:0:12}" "${ORIG_HEAD:0:12}"
		[ -n "$MB" ] && PRINT_TEXT "Compare: %s" 33 "git range-diff ${MB:0:12}..${ORIG_HEAD:0:12} ${MB:0:12}..${NEW_HEAD:0:12}"
		PRINT_TEXT "Land it: %s" 32 "git edit --exec --base=${ORIG_HEAD:0:12}$PUSHED_FLAG -- git reset -q --hard $NEW_HEAD"
		EXEC_DRY_BUILT=$NEW_HEAD
		return 0
	fi

	# What the command left untracked never lands, so the gate runs without it – `clean` without
	# `-x` spares the links, which only ever stand in for ignored paths
	if _VERIFY_CONFIGURED; then
		local CLEANED=$(LC_ALL=C git -C "$WT" -c core.quotePath=false clean -fd 2>/dev/null | LC_ALL=C sed -n 's/^Removing //p')
		[ -n "$CLEANED" ] && PRINT_TEXT "Removed what the command left untracked, which never lands: %s" 90 "$(_JOIN_PATHS "$CLEANED")"
	fi

	# The command authored this content rather than replaying a commit somebody already made,
	# so a standing gate is worth more here than anywhere else – and the worktree already sits
	# at the result. Having no pause to offer, a failure refuses outright: the built commits
	# stay in the object store, reachable by SHA, and `--no-verify` applies them
	_VERIFY_NO_RESUME=true
	if ! _VERIFY_REWRITE "$WT" "$NEW_HEAD" "$ORIG_HEAD" ""; then
		ECHO_E "\e[0;31m  Built history is at $NEW_HEAD – --no-verify runs the command again unchecked, or land that history as is: git edit --exec --no-verify --base=${ORIG_HEAD:0:12} -- git reset --hard ${NEW_HEAD:0:12}\e[0m" >&2
		exit 1
	fi
	_VERIFY_NO_RESUME=false

	# The reflog names the oldest commit a rewrite replaced, as most modes name their target –
	# a run that only added commits on top replaced none, and those commits say what it did
	local REPLACED=$(git rev-list --reverse --topo-order "$NEW_HEAD..$ORIG_HEAD" 2>/dev/null | head -1)
	local LABEL="${EXEC_LABEL:-exec}${REPLACED:+ ${REPLACED:0:7}}"

	# Atomic compare-and-swap – refuse where the branch moved during execution, such as a
	# concurrent commit from another session
	local UPDATE="git update-ref -m ${(q-)${:-git edit: $LABEL$_REFLOG_TAG}} ${(q-)REF} ${(q-)NEW_HEAD} ${(q-)ORIG_HEAD}"
	PRINT_CMD "$UPDATE"
	if ! _MOVE_REF "$UPDATE"; then
		PRINT_ERR "Ref '$REF' moved during exec – refusing to overwrite"
		# A `--commit` sits on the old tip, so landing it would take back what moved the branch
		if [ ${#OPT_COMMIT} -gt 0 ]; then
			PRINT_TEXT "Nothing landed – run it again to commit on the new tip." 33
		else
			PRINT_TEXT "Rewritten history is at %s (not applied)." 33 "$NEW_HEAD"
		fi
		exit 1
	fi
	_RECORD_REF_MOVE "$REF" "$ORIG_HEAD" "$NEW_HEAD" "$LABEL"

	_PRINT_REWRITE_APPLY_HINT "$BRANCH" "$ORIG_HEAD" "$NEW_HEAD"

	# Update status trailer outputs (head moved, CAS succeeded)
	EXEC_NEW_HEAD=$NEW_HEAD
	EXEC_CHANGED=true
}

# Quotes paths for a printed command – one git would read as a pattern marked literal, as
# `[id].tsx` would match `i.tsx` beside it
_QUOTE_PATHS () {
	# Args: <path>...
	local P
	local -a OUT
	for P in "$@"; do
		[[ "$P" == *[*?\[\\]* || "$P" == :* ]] && P=":(literal)$P"
		OUT+=("$P")
	done
	_SHQ "${OUT[@]}"
}

# Prints <word>s quoted for a shell a person pastes them into – as `(q-)` does, but single-quoting a
# `!` too, which an interactive bash or zsh expands from its history
_SHQ () {
	local W
	local -a OUT
	for W in "$@"; do
		if [[ "$W" == *'!'* ]]; then OUT+=("${(qq)W}"); else OUT+=("${(q-)W}"); fi
	done
	print -r -- "${(j: :)OUT}"
}

# Puts into `REPLY` the `cd` a printed command needs first, its paths running from <checkout>'s top
# – none where the caller stands there, a path pasted from a subdirectory naming another file
_AT_TOP () {
	# Args: <checkout>
	REPLY=""
	[ "${_START_DIR:A}" = "${1:A}" ] || REPLY="cd $(_SHQ "$1") && "
}

# Reads whole-file paths as `git commit -- <paths>` takes them, from where the caller stands –
# each a file or link in the checkout, or one the tip has and the checkout lost
_WHOLE_PATHS () {
	# Args: <path>... – fills the caller's WHOLE_PATHS, repo-relative and each once
	local TOP=$(git rev-parse --show-toplevel) PREFIX=$(git rev-parse --show-prefix) GIVEN P AT_TIP X C
	local ICASE=$(git config --type=bool core.ignorecase 2>/dev/null) LISTED="" OP
	local PRECOMPOSE=$(git config --type=bool core.precomposeUnicode 2>/dev/null)
	local -i I
	local -a TIP_NAMES TIP_LOWER
	local -A NEW_SPELT
	# Taking files whole mid-merge splits the merge, the partial commit `git commit` refuses too
	for OP in MERGE CHERRY_PICK REVERT; do
		if [ -e "$(git rev-parse --git-path "${OP}_HEAD")" ]; then
			PRINT_ERR "A ${${OP//_/-}:l} is in progress – finish it with git commit before taking files whole"
			exit 1
		fi
	done
	WHOLE_PATHS=()
	for GIVEN in "$@"; do
		if [[ "$GIVEN" == *$'\n'* ]]; then
			PRINT_ERR "$(_SHQ "$GIVEN") has a newline in its name – commit it with git commit"
			exit 1
		fi
		if [[ "$GIVEN" == /* ]]; then
			P=${GIVEN:h:A}/${GIVEN:t}
			[[ "$P" == "${TOP:A}/"?* ]] && P=${P#"${TOP:A}/"} || P=""
		else
			# Under a stand-in root, so a `..` past the top shows instead of normalizing away
			P=${${:-/@top@/$PREFIX$GIVEN}:a}
			[[ "$P" == /@top@/?* ]] && P=${P#/@top@/} || P=""
		fi
		if [ -z "$P" ]; then
			PRINT_ERR "$GIVEN names no file inside the repository"
			exit 1
		fi
		# Composed as git spells it – macOS hands a typed or pasted name over decomposed, which git
		# composes on the way in, so every name it hands back would read as another
		[ "$PRECOMPOSE" = true ] && [[ "$P" == *[^[:ascii:]]* ]] && P=$(print -rn -- "$P" | iconv -f UTF-8-MAC -t UTF-8 2>/dev/null || print -rn -- "$P")
		# An unmerged file holds a resolution still to stage, as `git commit` refuses it too
		if [ -n "$(git -C "$TOP" ls-files -u -- ":(literal)$P" 2>/dev/null)" ]; then
			PRINT_ERR "$GIVEN is unmerged – resolve it and git add it first"
			exit 1
		fi
		AT_TIP=$(git --literal-pathspecs ls-tree --full-tree HEAD -- "$P" 2>/dev/null | awk '{print $1}')
		if [ -d "$TOP/$P" ] && [ ! -L "$TOP/$P" ]; then
			if [ "$AT_TIP" = "160000" ]; then
				PRINT_ERR "$GIVEN is a submodule – commit inside it"
			else
				PRINT_ERR "$GIVEN is a directory – name its files"
			fi
			exit 1
		elif [ ! -e "$TOP/$P" ] && [ ! -L "$TOP/$P" ]; then
			if [ -z "$AT_TIP" ]; then
				PRINT_ERR "$GIVEN: no such file, in the checkout or at the tip"
				exit 1
			elif [ "$AT_TIP" = "040000" ]; then
				PRINT_ERR "$GIVEN is a directory at the tip – name its files"
				exit 1
			# Outside a sparse checkout a file is absent by design, as `git commit` reads it too
			elif [[ "$(git -C "$TOP" ls-files -t -- ":(literal)$P" 2>/dev/null)" == "S "* ]]; then
				PRINT_ERR "$GIVEN lies outside the sparse checkout – its absence there is no deletion"
				exit 1
			fi
		# As `git add` refuses one it does not track
		elif [ -z "$AT_TIP" ] && [ -n "$(git -C "$TOP" ls-files --others --ignored --exclude-standard -- ":(literal)$P" 2>/dev/null)" ]; then
			PRINT_ERR "$GIVEN is ignored, and the tip lacks it – git add would not take it either"
			exit 1
		fi
		# A name a case-insensitive filesystem reads as one the tip spells otherwise – or as another
		# one named here – would land both spellings, where `git commit` refuses it
		if [ -z "$AT_TIP" ] && [ "$ICASE" = true ]; then
			if [ -z "$LISTED" ]; then
				TIP_NAMES=("${(@0)$(git ls-tree -r -t -z --name-only --full-tree HEAD 2>/dev/null)}")
				TIP_LOWER=("${(@L)TIP_NAMES}")
				LISTED=true
			fi
			X=""
			for C in "${(@s:/:)P}"; do
				X+="${X:+/}$C"
				# The tip spelling it exactly settles it, whatever other spelling sits beside it there
				(( ${TIP_NAMES[(Ie)$X]} )) && continue
				I=${TIP_LOWER[(Ie)${(L)X}]}
				if (( I )); then
					PRINT_ERR "$X differs from the tip's ${TIP_NAMES[I]} only in case – one name to this filesystem, so spell it as the tip does"
					exit 1
				fi
				if [ -n "${NEW_SPELT[${(L)X}]}" ] && [ "${NEW_SPELT[${(L)X}]}" != "$X" ]; then
					PRINT_ERR "$X and ${NEW_SPELT[${(L)X}]} differ only in case – one name to this filesystem"
					exit 1
				fi
				NEW_SPELT[${(L)X}]=$X
			done
		fi
		(( ${WHOLE_PATHS[(Ie)$P]} )) || WHOLE_PATHS+=("$P")
	done
}

# Composes the tip's tree with whole files from the checkout, in a private index – read as
# `git add` reads them, filters, executable bit and links included, the shared index untouched
_COMPOSE_WHOLE () {
	# Args: <path>... – sets WHOLE_PATHS, WHOLE_HEAD and WHOLE_TREE
	_WHOLE_PATHS "$@"
	if ! WHOLE_HEAD=$(git rev-parse --verify -q HEAD); then
		PRINT_ERR "No commit to build on – the branch has none yet"
		exit 1
	fi
	local TOP=$(git rev-parse --show-toplevel) IDX=$(MKTEMP_FILE git-edit-index) ERR P
	_TEMP_FILES+=("$IDX")
	# Each index entry as it stands before the files are read – a peer staging one in between then
	# differs from it, keeping that staging through the re-sync
	WHOLE_IDX=()
	for P in "${WHOLE_PATHS[@]}"; do
		WHOLE_IDX[$P]=$(git -C "$TOP" --literal-pathspecs ls-files -s -- "$P" 2>/dev/null | awk '{ if ($3 != 0) c = 1; else e = $1" "$2 } END { print (c ? "conflict" : e) }')
	done
	# An empty file is no index – read-tree writes its own
	rm -f "$IDX"
	if ! ERR=$(cd "$TOP" && GIT_INDEX_FILE=$IDX git read-tree "$WHOLE_HEAD" 2>&1 && GIT_INDEX_FILE=$IDX git update-index --add --remove -- "${WHOLE_PATHS[@]}" 2>&1); then
		PRINT_ERR "Could not take those files: ${ERR//$'\n'/ }"
		exit 1
	fi
	WHOLE_TREE=$(GIT_INDEX_FILE=$IDX git write-tree)
	rm -f "$IDX"
	if [ "$WHOLE_TREE" = "$(git rev-parse "$WHOLE_HEAD^{tree}")" ]; then
		PRINT_ERR "Nothing to take – each of the ${#WHOLE_PATHS} file(s) named is as the tip has it"
		exit 1
	fi
}

# Merges a landing's change into <ours> – the result's blob on stdout, or a failure where it
# conflicts or cannot run, a binary say
_MERGE_LANDING () {
	# Args: <ours blob> <before blob> <after blob>
	local ID RC OURS BASE THEIRS
	# One spawn where git merges blobs by ID (2.43), its result mostly in the object store already –
	# a crash takes the files below instead, as 2.53 aborts there in a linked worktree
	if [ -n "$_MERGE_FILE_IDS" ]; then
		ID=$(git merge-file --object-id -q "$1" "$2" "$3" 2>/dev/null)
		RC=$?
		if (( RC <= 127 )); then
			[ $RC -eq 0 ] && print -r -- "$ID"
			return $RC
		fi
	fi
	OURS=$(MKTEMP_FILE git-edit-ours) BASE=$(MKTEMP_FILE git-edit-base) THEIRS=$(MKTEMP_FILE git-edit-theirs)
	_TEMP_FILES+=("$OURS" "$BASE" "$THEIRS")
	git cat-file blob "$1" > "$OURS" && git cat-file blob "$2" > "$BASE" && git cat-file blob "$3" > "$THEIRS" && \
		git merge-file -q "$OURS" "$BASE" "$THEIRS" 2>/dev/null
	RC=$?
	[ $RC -eq 0 ] && git hash-object --no-filters -- "$OURS"
	rm -f "$OURS" "$BASE" "$THEIRS"
	return $RC
}

# Succeeds where <ours> – a copy edited beside a landing – touches none of its changed lines, read
# against its before, which edits made on the landed lines would overlap
_EDITS_MISS_LANDING () {
	# Args: <ours blob> <before blob> <after blob>
	local O=$(MKTEMP_FILE git-edit-ours) B=$(MKTEMP_FILE git-edit-base) A=$(MKTEMP_FILE git-edit-theirs) SHARED
	local -x LANDED
	_TEMP_FILES+=("$O" "$B" "$A")
	if git cat-file blob "$1" > "$O" && git cat-file blob "$2" > "$B" && git cat-file blob "$3" > "$A"; then
		LANDED=$(_CHANGED_SPANS "$B" "$A")
		SHARED=$(_CHANGED_SPANS "$B" "$O" | awk '
			BEGIN { n = split(ENVIRON["LANDED"], F, /[ \n]+/); for (i = 1; i < n; i += 2) { S[++k] = F[i] + 0; E[k] = F[i + 1] + 0 } }
			NF { for (i = 1; i <= k; i++) if (S[i] <= $2 + 0 && $1 + 0 <= E[i]) { print "overlap"; exit } }')
	else
		SHARED=unknown
	fi
	rm -f "$O" "$B" "$A"
	[ -z "$SHARED" ]
}

# Renders seconds as their largest whole unit – 3d, 5h, 12m, 40s
_AGO () {
	# Args: <seconds>
	if (( $1 >= 86400 )); then
		print -r -- "$(( $1 / 86400 ))d"
	elif (( $1 >= 3600 )); then
		print -r -- "$(( $1 / 3600 ))h"
	elif (( $1 >= 60 )); then
		print -r -- "$(( $1 / 60 ))m"
	else
		print -r -- "${1}s"
	fi
}

# Refuses whole files taking back another caller's landing of the last 7 days – a file lacking one
# the tip still carries, one a landing removed, or the removal of one it added – where a conflict
# proves nothing, later edits on its lines conflicting too
_GUARD_WHOLE_LANDINGS () {
	local REF JF=$(_JOURNAL_FILE_PATH) LINE ACTOR MOVE P OURS TIP BEFORE AFTER MERGED WHO GONE MODE Q QOURS DST DSTBLOB O
	local TOPDIR=$(git rev-parse --show-toplevel)
	REF=$(git symbolic-ref -q HEAD) || return 0
	[ -n "$JF" ] && [ -s "$JF" ] || return 0
	local -i NOW=$(date +%s) K N I RI OLDEST_WHEN=0 MRC
	local OLDEST_OLD=""
	local -a J MOVES CHANGED QUERIES ANSWERS HITS HIT_PATHS M RESTORE REMOVED RF RENAMED
	local KIND
	local -A MODE_OF RENAMED_TO
	# Oldest first, as journaled – this caller's own landings are its to take back, an unlabeled
	# caller's being every unlabeled one, which nothing tells apart
	for LINE in "${(@f)$(<"$JF")}"; do
		J=(${=${LINE%%$'\t'*}})
		[[ "${J[1]}" == <-> ]] && (( J[1] >= NOW - 604800 )) && [ "${J[2]}" = "$REF" ] || continue
		ACTOR=""
		[[ "$LINE" == *$'\t'* ]] && ACTOR=${LINE##*$'\t'}
		[ "$ACTOR" = "$_ACTOR" ] && continue
		MOVES+=("${J[1]} ${J[3]} ${J[4]} ${J[5]:-run} ${ACTOR:--}")
	done
	[ ${#MOVES} -gt 0 ] || return 0
	# Only content this commit changes can take a landing back – a file, a link or a removal
	for P in "${(@0)$(git diff-tree -z -r --name-only --no-renames "$WHOLE_HEAD" "$WHOLE_TREE")}"; do
		[ -n "$P" ] || continue
		MODE=$(git --literal-pathspecs ls-tree --full-tree "$WHOLE_TREE" -- "$P" | awk '{print $1}')
		[ "$MODE" = 160000 ] && continue
		CHANGED+=("$P")
		MODE_OF[$P]=$MODE
	done
	[ ${#CHANGED} -gt 0 ] || return 0
	RF=("${(@0)$(git diff -z -M --name-status --diff-filter=R "$WHOLE_HEAD" "$WHOLE_TREE" 2>/dev/null)}")
	for (( RI = 1; RI + 2 <= ${#RF}; RI += 3 )); do
		RENAMED_TO[${RF[RI + 1]}]=${RF[RI + 2]}
	done
	# One batch, read back by position – a move's two tips, then each path at both
	for MOVE in "${MOVES[@]}"; do
		M=(${=MOVE})
		QUERIES+=("${M[2]}" "${M[3]}")
		for P in "${CHANGED[@]}"; do
			QUERIES+=("${M[2]}:$P" "${M[3]}:$P")
		done
	done
	ANSWERS=("${(@f)$(print -rl -- "${QUERIES[@]}" | git cat-file --batch-check='%(objectname)')}")
	if [ ${#ANSWERS} -ne ${#QUERIES} ]; then
		PRINT_ERR "git cat-file answered ${#ANSWERS} of ${#QUERIES} lookups – refusing rather than guess"
		exit 1
	fi
	for (( I = 1; I <= ${#ANSWERS}; I++ )); do
		[[ "${ANSWERS[I]}" =~ '^[0-9a-f]{40,64}$' ]] || ANSWERS[I]=""
	done
	local _MERGE_FILE_IDS=""
	[[ "$(LC_ALL=C git merge-file -h 2>&1)" == *object-id* ]] && _MERGE_FILE_IDS=yes
	N=$(( 2 + 2 * ${#CHANGED} ))
	for (( I = 1; I <= ${#CHANGED}; I++ )); do
		P=${CHANGED[I]}
		OURS=$(git rev-parse -q --verify "$WHOLE_TREE:$P" 2>/dev/null)
		TIP=$(git rev-parse -q --verify "$WHOLE_HEAD:$P" 2>/dev/null)
		DST=${RENAMED_TO[$P]}
		[ -z "$OURS" ] && [ -n "$DST" ] && DSTBLOB=$(git rev-parse -q --verify "$WHOLE_TREE:$DST" 2>/dev/null)
		# Oldest first, so the carry named takes in every later landing the file lacks as well
		for (( K = 1; K <= ${#MOVES}; K++ )); do
			M=(${=MOVES[K]})
			BEFORE=${ANSWERS[(K - 1) * N + 2 * I + 1]}
			AFTER=${ANSWERS[(K - 1) * N + 2 * I + 2]}
			# A pruned tip tells nothing
			[ -n "${ANSWERS[(K - 1) * N + 1]}" ] && [ -n "${ANSWERS[(K - 1) * N + 2]}" ] && [ "$BEFORE" != "$AFTER" ] || continue
			# Each kind takes its own remedy – a merge carries only edits made beside a landing (or
			# across its rename), while a file still as before it or one it added is restored whole
			KIND=carry GONE=""
			# A file this commit renames answers with its new name's content
			# where the landing changed it under the old one
			O=$OURS
			[ -z "$OURS" ] && [ -n "$DST" ] && [ -n "$BEFORE" ] && [ -n "$AFTER" ] && O=$DSTBLOB
			if [ -z "$O" ]; then
				# A removal takes back only a file such a run added, which the checkout never got
				[ -z "$BEFORE" ] && [ -n "$TIP" ] || continue
				KIND=restore GONE=", which added it"
			elif [ -z "$BEFORE" ]; then
				# A file the landing added has no before to merge from – edits on top keep most of what
				# it landed with, or of what the tip holds since, a file of the caller's own in its place
				# hardly any, and a tip that lost it no longer holds the landing
				[ -n "$AFTER" ] && [ -n "$TIP" ] && [ "$O" != "$AFTER" ] && [ "$O" != "$TIP" ] && [ "${MODE_OF[$P]}" != 120000 ] && \
					! _HOLDS_MOST_OF "$O" "$AFTER" && ! _HOLDS_MOST_OF "$O" "$TIP" || continue
				KIND=restore GONE=", which added it"
			elif [ -z "$AFTER" ]; then
				[ -z "$TIP" ] || continue
				KIND=leave GONE=", which removed it"
			elif [ -z "$TIP" ] || [ "$O" = "$AFTER" ]; then
				continue
			# The landing's own before, which no merge need read – a binary or a link as much as text,
			# and a later landing on top where the tip still carries this one, or where the merge
			# conflicts, as a copy holding no edits loses nothing to the restore
			elif [ "$O" = "$BEFORE" ] && { [ "$TIP" = "$AFTER" ] || ! MERGED=$(_MERGE_LANDING "$TIP" "$BEFORE" "$AFTER") || [ "$MERGED" = "$TIP" ]; }; then
				KIND=restore GONE=", the file still as before it"
			else
				[ "${MODE_OF[$P]}" != 120000 ] || continue
				MERGED=$(_MERGE_LANDING "$O" "$BEFORE" "$AFTER")
				MRC=$?
				# A conflict lacks the landing only where the file's edits share none of its changed
				# lines – edits on those lines, made after it, conflict as much
				if (( MRC == 0 )); then
					[ "$MERGED" != "$O" ] || continue
				elif (( MRC <= 127 )); then
					_EDITS_MISS_LANDING "$O" "$BEFORE" "$AFTER" || continue
				else
					continue
				fi
				[ "$(_MERGE_LANDING "$TIP" "$BEFORE" "$AFTER")" = "$TIP" ] || continue
			fi
			# A file this commit renames takes what landed under its old name, whatever its kind
			[ "$O" != "$OURS" ] && KIND=renamed GONE=", which this commit renames to $DST"
			# An addition or removal that is one side of a rename takes the carry, which follows it –
			# where the old side holds edits, as untouched the two sides restore and leave as they are
			if [ "$KIND" != carry ] && [ -z "$BEFORE$OURS" -o -z "$AFTER" ]; then
				RF=("${(@0)$(git diff -z -M --name-status --diff-filter=R "${M[2]}" "${M[3]}" 2>/dev/null)}")
				for (( RI = 1; RI + 2 <= ${#RF}; RI += 3 )); do
					if [ "${RF[RI + 1]}" = "$P" ]; then
						[ "$OURS" != "$BEFORE" ] && KIND=carry GONE=", which renamed it to ${RF[RI + 2]}"
					elif [ "${RF[RI + 2]}" = "$P" ]; then
						Q=${RF[RI + 1]}
						QOURS=$(git rev-parse -q --verify "$WHOLE_TREE:$Q" 2>/dev/null) || QOURS=$(_WORKTREE_HASH "$TOPDIR" "$Q" 2>/dev/null)
						[ -n "$QOURS" ] && [ "$QOURS" != "$(git rev-parse -q --verify "${M[2]}:$Q" 2>/dev/null)" ] && \
							KIND=carry GONE=", which renamed $Q to it"
					fi
				done
			fi
			WHO="${M[5]}'s"
			[ "${M[5]}" = "-" ] && WHO="an unlabeled caller's"
			HITS+=("$P – $WHO ${M[4]} run $(_AGO $(( NOW - M[1] ))) ago (${M[2]:0:7}..${M[3]:0:7})$GONE")
			HIT_PATHS+=("$P")
			case "$KIND" in
				restore) RESTORE+=("$P") ;;
				leave) REMOVED+=("$P") ;;
				# Through files – `merge-file` sizes its inputs by `stat`, which a pipe answers short
				renamed)
					Q=$(_SHQ "$DST")
					RENAMED+=("git show ${BEFORE:0:12} > $Q.git-edit-base && git show ${AFTER:0:12} > $Q.git-edit-landed && git merge-file -- $Q $Q.git-edit-base $Q.git-edit-landed; rm -f $Q.git-edit-base $Q.git-edit-landed")
					;;
				*)
					if [ -z "$OLDEST_OLD" ] || (( M[1] < OLDEST_WHEN )); then
						OLDEST_WHEN=${M[1]}
						OLDEST_OLD=${M[2]}
					fi
					;;
			esac
			break
		done
	done
	[ ${#HITS} -gt 0 ] || return 0
	PRINT_ERR "${_WHOLE_WHAT:-Committed whole}, ${#HITS} file(s) would take back what another caller landed: ${(j:, :)HIT_PATHS}"
	print -rl -- "${HITS[@]}" | _CARET_LINES | LC_ALL=C sed "s/^/${_RED}    /;s/\$/${_OFF}/" >&2
	# Staging and a tree hold no checkout file to restore or merge – the staging is taken from the tip
	# instead, and a tree composed again
	case "$_WHOLE_WHAT" in
		"Folded as staged")
			ECHO_E "\e[0;31m  The staging predates what landed – stage those files again from content that holds it, then run this again.\e[0m" >&2
			if [ ${#RESTORE} -gt 0 ]; then
				_AT_TOP "$(git rev-parse --show-toplevel)"
				ECHO_E "\e[0;31m  Take what landed, unstaging yours with: $(_LIT "${REPLY}git restore --staged -- $(_QUOTE_PATHS "${RESTORE[@]}")") – your files stay as they are.\e[0m" >&2
			fi
			RESTORE=() RENAMED=()
			;;
		"Folded from --tree")
			ECHO_E "\e[0;31m  The tree predates what landed – compose it again on the current tip, then run this again.\e[0m" >&2
			RESTORE=() RENAMED=()
			;;
		*)
			[ -n "$OLDEST_OLD" ] && ECHO_E "\e[0;31m  Merge your edits onto what landed with 'git edit --carry=${OLDEST_OLD:0:12}', then run this again.\e[0m" >&2
			;;
	esac
	if [ ${#RESTORE} -gt 0 ]; then
		_AT_TOP "$(git rev-parse --show-toplevel)"
		ECHO_E "\e[0;31m  Take what landed with: $(_LIT "${REPLY}git restore --source=HEAD --worktree -- $(_QUOTE_PATHS "${RESTORE[@]}")") – or leave it out.\e[0m" >&2
	fi
	[ ${#REMOVED} -gt 0 ] && ECHO_E "\e[0;31m  Leave out what was removed: $(_LIT "$(_QUOTE_PATHS "${REMOVED[@]}")")\e[0m" >&2
	if [ ${#RENAMED} -gt 0 ]; then
		_AT_TOP "$(git rev-parse --show-toplevel)"
		for Q in "${RENAMED[@]}"; do
			ECHO_E "\e[0;31m  Merge what landed into the new name with: $(_LIT "${REPLY}$Q")\e[0m" >&2
		done
	fi
	ECHO_E "\e[0;31m  Pass --base=${WHOLE_HEAD:0:12} where taking it back is the point.\e[0m" >&2
	exit 1
}

# Tells whether <blob> keeps at least half the lines of <landed blob>, each counted as often as it
# occurs – how edits made on top of a file look, where one written in its place keeps few
_HOLDS_MOST_OF () {
	# Args: <blob> <landed blob>
	local -i TOTAL KEPT
	TOTAL=$(git cat-file blob "$2" 2>/dev/null | LC_ALL=C grep -ac .)
	(( TOTAL > 0 )) || return 0
	KEPT=$(LC_ALL=C comm -12 <(git cat-file blob "$1" 2>/dev/null | LC_ALL=C grep -a . | LC_ALL=C sort) \
		<(git cat-file blob "$2" 2>/dev/null | LC_ALL=C grep -a . | LC_ALL=C sort) | LC_ALL=C grep -ac .)
	(( KEPT * 2 >= TOTAL ))
}

# Refuses whole files carrying a conflict the tip's version lacks – an opening and a closing marker
# line at the file's own `conflict-marker-size`, as a merge leaves them, whoever left them there
_GUARD_WHOLE_MARKERS () {
	local TOP=$(git rev-parse --show-toplevel) P N RE NEW
	local -a BAD
	for P in "${WHOLE_PATHS[@]}"; do
		[[ "$(git ls-tree --full-tree "$WHOLE_TREE" -- ":(literal)$P" 2>/dev/null)" == 100* ]] || continue
		N=$(git -C "$TOP" check-attr conflict-marker-size -- "$P" 2>/dev/null)
		N=${N##*: }
		[[ "$N" == <1-> ]] || N=7
		RE="^(<{$N}|>{$N})( |\$)"
		# Read whole – a pipe into `grep` would end the writer at a first match
		NEW=$(LC_ALL=C comm -23 <(git cat-file blob "$WHOLE_TREE:$P" 2>/dev/null | LC_ALL=C grep -aE "$RE" | LC_ALL=C sort -u) \
			<(git cat-file blob "$WHOLE_HEAD:$P" 2>/dev/null | LC_ALL=C grep -aE "$RE" | LC_ALL=C sort -u))
		[[ "$NEW" == *"${(l:$N::<:)}"* && "$NEW" == *"${(l:$N::>:)}"* ]] && BAD+=("$P")
	done
	(( ${#BAD} )) || return 0
	PRINT_ERR "Conflict markers in ${#BAD} file(s) taken whole – nothing landed: ${(j:, :)BAD}"
	ECHO_E "\e[0;31m  Resolve them first – or, where they are the file's content, give it a larger conflict-marker-size in .gitattributes, as 'git diff --check' reads it.\e[0m" >&2
	exit 1
}

# Guards whole files against the tip they were composed on – a `--base` names the commit they
# rest on, refusing a path changed between it and the tip, and without one the journal's
# landings of the last 7 days stand in for it
_GUARD_WHOLE () {
	if [ -z "$EXEC_BASE" ]; then
		_GUARD_WHOLE_LANDINGS
		return 0
	fi
	local P
	local -a MOVED
	for P in "${WHOLE_PATHS[@]}"; do
		[ "$(git rev-parse -q --verify "$EXEC_BASE:$P" 2>/dev/null)" = "$(git rev-parse -q --verify "$WHOLE_HEAD:$P" 2>/dev/null)" ] || MOVED+=("$P")
	done
	[ ${#MOVED} -eq 0 ] && return 0
	PRINT_ERR "Changed between --base ${EXEC_BASE:0:7} and the tip ${WHOLE_HEAD:0:7}, so ${${_WHOLE_WHAT:-Committed whole}:l} they would take that back: ${(j:, :)MOVED}"
	ECHO_E "\e[0;31m  See what landed with 'git log --oneline ${EXEC_BASE:0:12}..${WHOLE_HEAD:0:12} -- <path>' and merge your edits onto it – or pass --base=${WHOLE_HEAD:0:12} where taking it back is the point.\e[0m" >&2
	exit 1
}

# Names what a fold took its content from, for the lines saying it is left as it was
_FOLD_SOURCE () {
	if [ ${#OPT_WHOLE} -gt 0 ] || [ ${#WHOLE_PATHS} -gt 0 ]; then
		print -r -- "the files are"
	elif [ -n "$AMEND_TREE$STATE_TREE" ]; then
		print -r -- "the tree is"
	else
		print -r -- "your staged changes are"
	fi
}

# Refuses a fold whose tree was composed on a tip the branch has moved past – it would take back what
# landed since – named as the caller gave it, whole files or a `--tree`
_TREE_MOVED () {
	# Args: <the tip now>
	if [ ${#OPT_WHOLE} -gt 0 ]; then
		PRINT_ERR "The files were read on ${TREE_BASE:0:7}, but the branch moved to ${1:0:7} since – nothing was applied"
		ECHO_E "\e[0;31m  Run it again, reading them on the current tip.\e[0m" >&2
	else
		PRINT_ERR "--tree $AMEND_TREE_GIVEN was composed on ${TREE_BASE:0:7}, but HEAD is ${1:0:7} now – nothing was applied"
		ECHO_E "\e[0;31m  Compose it again on the current tip, then retry.\e[0m" >&2
	fi
	exit 1
}

# Names the remedy for a mode change a checkout file carries – a chmod for a bit, while a symlink
# turned file, or the reverse, is a file to put back as it was
_MODE_REMEDY () {
	# Args: <the ` mode change` lines>
	if [[ "$1" == *120000* ]]; then
		ECHO_E "\e[0;31m  Put a symlink back where one was (git restore --source=HEAD -- <path>, if its content is not the point), or pass --allow-mode-change where the change is meant.\e[0m" >&2
	else
		ECHO_E "\e[0;31m  Restore the mode with chmod, or pass --allow-mode-change where the change is meant.\e[0m" >&2
	fi
}

# Guards a fold of staged content, or of a bare `--tree`, as whole files are guarded – either read
# before another caller's landing takes it back, the fold rebuilding those files as they hold them
_GUARD_STAGED_FOLD () {
	# Args: <tip> <fold tree> <what, "Folded as staged" or "Folded from --tree"> <path>...
	local WHOLE_HEAD=$1 WHOLE_TREE=$2 _WHOLE_WHAT=$3
	shift 3
	local -a WHOLE_PATHS=("$@")
	_GUARD_WHOLE
}

# Commits the composed tree from the `--exec` worktree, so the repo's hooks run on it
_COMMIT_WHOLE_TREE () {
	# Args: <tree> <message file>
	git read-tree --reset -u "$1" && git commit -q --cleanup=whitespace -F "$2"
}

# Commits whole files at the tip – composed apart from the shared index and guarded, then landed
# through `--exec` with its hooks, gate, CAS, journal and reconcile, pinned to the tip they read
GIT_COMMIT_WHOLE () {
	# Args: <path>...
	if ! git symbolic-ref -q HEAD >/dev/null; then
		PRINT_ERR "--commit requires being on a branch (got detached HEAD)"
		exit 1
	fi
	_COMPOSE_WHOLE "$@"
	if [ ${#OPT_ALLOW_MODE_CHANGE} -eq 0 ]; then
		local FLIPS=$(git -c core.quotePath=false diff-tree -r --summary "$WHOLE_HEAD" "$WHOLE_TREE" | LC_ALL=C grep -a '^ mode change')
		if [ -n "$FLIPS" ]; then
			PRINT_ERR "A file-mode change rides along – a lost executable bit, most often – so nothing landed"
			print -r -- "$FLIPS" | _CARET_LINES | LC_ALL=C sed "s/^ /${_RED}    /;s/\$/${_OFF}/" >&2
			_MODE_REMEDY "$FLIPS"
			exit 1
		fi
	fi
	_GUARD_WHOLE_MARKERS
	_GUARD_WHOLE
	local MSG=$(MKTEMP_FILE git-edit-message)
	_TEMP_FILES+=("$MSG")
	print -r -- "$TEXT_VALUE" > "$MSG"
	PRINT_ACTION "Committing ${#WHOLE_PATHS} whole file(s) on %s..." "$WHOLE_HEAD"
	EXEC_BASE=$WHOLE_HEAD
	EXEC_LABEL=commit
	GIT_EXEC _COMMIT_WHOLE_TREE "$WHOLE_TREE" "$MSG"
	if [ "$EXEC_CHANGED" = true ]; then
		git --no-pager -c core.quotePath=false show --no-color --stat --summary --format= "$EXEC_NEW_HEAD" | LC_ALL=C sed '/./!d'
		_PRINT_COMMIT_LINE "$EXEC_NEW_HEAD" '  committed: %h %s'
	fi
}

# Builds the tree a scoped fold carries – the base commit's tree with only the
# pathspec-matched entries applied, composed from the source's exact blobs like the split
# path, so binary files and mode changes come along and nothing else leaks in – the source
# being the staged index, or the `--tree` a caller composed apart from it
_STAGED_TREE_FOR () {
	local BASE=$1
	# An unmerged entry reads as a deletion below – the caller refuses the empty tree instead
	[ -z "$AMEND_TREE" ] && [ -n "$(git ls-files -u -- "${AMEND_PATHSPECS[@]}" 2>/dev/null)" ] && return 1
	local TMPIDX=$(MKTEMP_FILE git-edit-amend-idx)
	rm -f "$TMPIDX"
	GIT_INDEX_FILE=$TMPIDX git read-tree "$BASE" || { rm -f "$TMPIDX"; return 1; }
	local META PATHNAME DSTMODE DSTSHA I
	local -a RAW
	# NUL-separated, so each path reaches the index as its own bytes – one with a quote, a
	# backslash or a control character arrives quoted otherwise, and that quoting became the name
	if [ -n "$AMEND_TREE" ]; then
		RAW=("${(@0)$(git diff-tree -z -r "$BASE" "$AMEND_TREE" -- "${AMEND_PATHSPECS[@]}")}")
	else
		RAW=("${(@0)$(git diff-index -z --cached -r "$BASE" -- "${AMEND_PATHSPECS[@]}")}")
	fi
	for (( I = 1; I < ${#RAW[@]}; I += 2 )); do
		META=${RAW[I]}
		PATHNAME=${RAW[I+1]}
		[ -z "$META" ] && continue
		DSTMODE=$(print -r -- "$META" | awk '{print $2}')
		DSTSHA=$(print -r -- "$META" | awk '{print $4}')
		if [ "$DSTMODE" = "000000" ]; then
			# From the top, as `update-index` reads a path from where it runs, unlike a `--cacheinfo`
			GIT_INDEX_FILE=$TMPIDX git -C "$(git rev-parse --show-toplevel)" update-index --force-remove -- "$PATHNAME" || { rm -f "$TMPIDX"; return 1; }
		else
			GIT_INDEX_FILE=$TMPIDX git update-index --add --cacheinfo "$DSTMODE,$DSTSHA,$PATHNAME" || { rm -f "$TMPIDX"; return 1; }
		fi
	done
	GIT_INDEX_FILE=$TMPIDX git write-tree
	rm -f "$TMPIDX"
}

# Folds currently-staged changes from the main index (or a `--tree` composed apart from it) into
# a target commit, leaving unstaged files alone – fixup plus autosquash in one operation,
# snapshotting the source as a fixup object, running the autosquash isolated, and CAS-updating
# the ref against the pre-op tip
GIT_AMEND_INTO () {
	local TARGET=$AMEND_INTO_TARGET

	# Pre-flight: must not be a stale in-flight operation
	_REQUIRE_NO_INFLIGHT

	# Pre-flight: must have changes to fold – within the pathspec if one narrows the fold,
	# since "something is staged" says nothing about the named paths
	if git diff "${AMEND_SOURCE[@]}" --quiet -- "${AMEND_PATHSPECS[@]}" 2>/dev/null; then
		if [ -n "$AMEND_TREE" ]; then
			PRINT_ERR "--tree $AMEND_TREE_GIVEN differs from HEAD in nothing${AMEND_PATHSPECS[1]:+ under ${AMEND_PATHSPECS[*]}} – nothing to fold"
			ECHO_E "\e[0;31m  Compose it on the current tip with the change in place, then retry.\e[0m" >&2
		elif [ ${#AMEND_PATHSPECS[@]} -gt 0 ]; then
			PRINT_ERR "No staged changes under ${AMEND_PATHSPECS[*]}"
			ECHO_E "\e[0;31m  Stage them with 'git add <files>', or drop the pathspec to fold everything staged.\e[0m" >&2
		else
			PRINT_ERR "No staged changes to amend"
			ECHO_E "\e[0;31m  Stage files with 'git add <files>' before running --amend-into.\e[0m" >&2
		fi
		exit 1
	fi

	# Pre-flight: target must be reachable from `HEAD` (or resolvable to it)
	_GUARD_REACHABLE "$TARGET"
	TARGET=$_RESOLVED_SHA

	# Pre-flight: must be on a branch
	local ORIG_BRANCH=${$(git symbolic-ref -q HEAD 2>/dev/null)#refs/heads/}
	if [ -z "$ORIG_BRANCH" ]; then
		PRINT_ERR "--amend-into requires being on a branch (got detached HEAD)"
		exit 1
	fi

	local TARGET_FULL=$(git rev-parse "$TARGET")
	_GUARD_UNPUSHED "$TARGET_FULL"
	_GUARD_NO_MERGE_SPAN "$TARGET_FULL"

	local REF="refs/heads/$ORIG_BRANCH"
	local ORIG_HEAD=$(git rev-parse HEAD)
	_REQUIRE_IN_TIP "$ORIG_HEAD" "$TARGET"
	# A tree composed on an earlier tip would take back what landed on the branch since – asked again
	# here, as the dispatch read the tip a moment before
	[ -n "$TREE_BASE" ] && [ "$TREE_BASE" != "$ORIG_HEAD" ] && _TREE_MOVED "$ORIG_HEAD"
	# Repo root, not `pwd` – pathspecs in the success sync below must resolve
	# from the root even when the script was invoked from a subdirectory
	local MAIN_DIR=$(git rev-parse --show-toplevel)
	# Commits above the target pre-op – locates the amended commit in the
	# rebased chain afterwards (`NEW_HEAD~DEPTH`), for the completion summary
	local DEPTH=$(git rev-list --count "$TARGET_FULL..HEAD")
	# What the fold carries, read once – every check below and the fold itself read this tree, so
	# staging changed meanwhile by a peer can't pass the checks as one tree and land as another
	local FOLD_SNAP=$(_FOLD_TREE "$ORIG_HEAD")
	if [ -z "$FOLD_SNAP" ]; then
		PRINT_ERR "Cannot snapshot index (unmerged entries?) – resolve conflicts first"
		exit 1
	fi
	# The folded paths (root-relative): shown in the completion summary, and
	# scoping the success sync to exactly these entries
	local -a STAGED_PATHS
	STAGED_PATHS=(${(0)"$(git diff --ignore-submodules=none --name-only -z "$ORIG_HEAD" "$FOLD_SNAP")"})
	if [ ${#STAGED_PATHS} -eq 0 ]; then
		PRINT_ERR "The staged changes were unstaged meanwhile – nothing to fold"
		exit 1
	fi
	local STAGED_FILES=$(printf '%s\n' "${STAGED_PATHS[@]}" | tr '\n' ',' | LC_ALL=C sed 's/,$//')
	# Staging read before another caller's landing would take it back, the fold rebuilding those files
	# as staged – checked as whole files are, or against the tip a `--base` names – as is a bare tree,
	# which names no tip it was composed on
	if [ -z "$AMEND_TREE" ]; then
		_GUARD_STAGED_FOLD "$ORIG_HEAD" "$FOLD_SNAP" "Folded as staged" "${STAGED_PATHS[@]}"
	elif [ -z "$TREE_BASE" ]; then
		_GUARD_STAGED_FOLD "$ORIG_HEAD" "$FOLD_SNAP" "Folded from --tree" "${STAGED_PATHS[@]}"
	fi

	# Pre-flight – a staged path the target predates is refused where a later commit introduces
	# it, since folding beneath that introduction replays it as an add/add conflict of the
	# whole file, and every descendant touching it re-conflicts in turn
	if [ ${#OPT_ALLOW_NEW_PATH} -eq 0 ]; then
		local ABSENT_PATH
		local ABSENT_INTRODUCER
		local ABSENT_FROM
		local ABSENT_RENAMES_READ
		local -i RI
		local -a RENAME_FIELDS
		local -A ABSENT_RENAMED
		local -a ABSENT_LINES
		for ABSENT_PATH in "${STAGED_PATHS[@]}"; do
			if ! git cat-file -e "$TARGET_FULL:$ABSENT_PATH" 2>/dev/null; then
				# A path renamed since arrives by no add – the fixup's replay merges against the tip, and
				# that merge's rename detection carries the change to the old name: asked the same way
				# here, under its settings, so a pairing it still misses stops on a conflict, never lands
				ABSENT_FROM=
				# Only a path the fold keeps – a deletion meets that merge as a rename/delete conflict
				if git cat-file -e "$FOLD_SNAP:$ABSENT_PATH" 2>/dev/null; then
					if [ -z "$ABSENT_RENAMES_READ" ]; then
						ABSENT_RENAMES_READ=1
						# NUL-separated, status, source and destination each – a quote, backslash or tab in a
						# name comes back C-quoted in the line form
						if _MERGE_DETECTS_RENAMES; then
							RENAME_FIELDS=(${(0)"$(git diff -z -M -l"$(git config --get merge.renameLimit || git config --get diff.renameLimit || echo 7000)" --name-status --diff-filter=R "$ORIG_HEAD" "$TARGET_FULL" 2>/dev/null)"})
							for (( RI = 1; RI + 2 <= ${#RENAME_FIELDS}; RI += 3 )); do
								ABSENT_RENAMED[${RENAME_FIELDS[RI + 1]}]=${RENAME_FIELDS[RI + 2]}
							done
						fi
					fi
					ABSENT_FROM=${ABSENT_RENAMED[$ABSENT_PATH]}
				fi
				if [ -n "$ABSENT_FROM" ]; then
					PRINT_TEXT "Note: %s is %s at %s – git's rename detection carries the fold there." 90 "$ABSENT_PATH" "$ABSENT_FROM" "${TARGET_FULL:0:7}"
					continue
				fi
				ABSENT_INTRODUCER=$(git -c log.follow=false log --diff-filter=A --format='%h (%s)' --reverse "$TARGET_FULL..HEAD" -- ":(literal)$ABSENT_PATH" | head -1)
				if [ -n "$ABSENT_INTRODUCER" ]; then
					ABSENT_LINES+=("$ABSENT_PATH – arrives in $ABSENT_INTRODUCER")
				else
					PRINT_TEXT "Note: %s does not exist at %s – the fold introduces it there, and every descendant inherits it." 90 "$ABSENT_PATH" "${TARGET_FULL:0:7}"
				fi
			fi
		done
		if [ ${#ABSENT_LINES[@]} -gt 0 ]; then
			PRINT_ERR "Staged path(s) do not exist at ${TARGET_FULL:0:7} – replaying the commit that introduces them would raise an add/add conflict"
			# Each names the commit a path arrives in, its subject shown inert
			_CARET "${(F)ABSENT_LINES}"
			print -r -- "$REPLY" | LC_ALL=C sed "s/^/${_RED}  /;s/\$/${_OFF}/" >&2
			ECHO_E "\e[0;31m  Fold into the introducing commit or later – or pass --allow-new-path to override.\e[0m" >&2
			exit 1
		fi
	fi

	# Pre-flight – a flipped file mode is refused, since a fold rarely means one: the usual
	# cause is a literal mode typed into `update-index --cacheinfo`, stripping an executable
	# bit, and it would ride into history invisibly, a diffstat counting lines only
	if [ ${#OPT_ALLOW_MODE_CHANGE} -eq 0 ]; then
		local MODE_FLIPS=$(git diff --ignore-submodules=none --summary "$ORIG_HEAD" "$FOLD_SNAP" 2>/dev/null | LC_ALL=C grep -a '^ mode change')
		if [ -n "$MODE_FLIPS" ]; then
			# Whole files take their mode from the checkout, where a chmod is the cause
			if [ ${#OPT_WHOLE} -gt 0 ]; then
				PRINT_ERR "A file-mode change rides along – a lost executable bit, most often – so nothing folded"
			else
				PRINT_ERR "The fold would change a file mode – a literal mode in 'git update-index --cacheinfo', taking the executable bit with it?"
			fi
			print -r -- "$MODE_FLIPS" | _CARET_LINES | LC_ALL=C sed "s/^ /${_RED}  /;s/\$/${_OFF}/" >&2
			if [ ${#OPT_WHOLE} -gt 0 ]; then
				_MODE_REMEDY "$MODE_FLIPS"
			else
				ECHO_E "\e[0;31m  Take the mode from 'git ls-tree HEAD -- <path>' instead – or pass --allow-mode-change to fold it anyway.\e[0m" >&2
			fi
			exit 1
		fi
	fi

	if [ ${#OPT_SNAPSHOT} -gt 0 ]; then
		_AMEND_INTO_SNAPSHOT
		return
	fi

	# Step 1 – snapshot the staged index as a commit object, `write-tree` plus `commit-tree`
	# building it without moving a ref or touching the index, so the staging survives to the CAS
	local TARGET_SUBJECT=$(git log -1 --format='%s' "$TARGET_FULL")

	# A message alongside the fold rewords the target in the same run, `git commit --amend -m`
	# semantics – done before the fixup exists, since rewording afterwards must find the
	# amended commit again, and a dropped empty replay makes any offset risk the wrong one
	local FIXUP_PARENT=$ORIG_HEAD
	# Armed ahead of the reword, whose map the hold-back then carries along with the rebase's
	_CAPTURE_BEGIN
	if [ -n "$TEXT_VALUE" ]; then
		AMEND_OLD_SHA=$TARGET_FULL
		_REWORD_AND_REBUILD "$TARGET_FULL" "$TEXT_VALUE"
		# The autosquash below rebuilds these commits again, so this step's map names intermediates
		# that never reach the branch – held back, the landing follows each on to its final commit,
		# and without the hold-back it goes out now, for the rebase's own copy to relay it onward
		if [ "$_CAPTURE_REWRITES" = "true" ]; then
			_CAPTURE_HOLD_PAIRS
		else
			_EMIT_REWRITES
		fi
		# The fixup rides on the rebuilt chain, and `fixup!` matches by subject,
		# so both must follow the reword
		FIXUP_PARENT=$_REWORDED_TIP
		TARGET_FULL=$_REWORDED_TARGET
		TARGET_SUBJECT=$(git log -1 --format='%s' "$TARGET_FULL")
	fi

	local STAGED_TREE=$FOLD_SNAP
	local FIXUP_COMMIT
	FIXUP_COMMIT=$(git commit-tree "$STAGED_TREE" -p "$FIXUP_PARENT" -m "fixup! $TARGET_SUBJECT" </dev/null) || exit 1
	PRINT_CMD "git write-tree + commit-tree -> ${FIXUP_COMMIT:0:7} # fixup! object, branch untouched"

	# Step 2: isolated worktree at the fixup commit object
	local WT
	WT=$(MKTEMP_DIR git-edit-amend-into) || exit 1
	rmdir "$WT"
	_CLEANUP_HOOK="git worktree remove --force ${(q-)WT} 2>/dev/null; rm -rf ${(q-)WT}"
	_WORKTREE_ADD "$WT" "$FIXUP_COMMIT" quiet || exit 1
	_LINK_WORKTREE_EXTRAS "$WT"

	cd "$WT" || exit 1

	# Determine rebase base (parent of target, or --root if target is initial commit)
	local REBASE_BASE
	if git rev-parse --verify "$TARGET_FULL^" >/dev/null 2>&1; then
		REBASE_BASE="$TARGET_FULL^"
	else
		REBASE_BASE="--root"
	fi

	# Step 3 – autosquash, where `GIT_SEQUENCE_EDITOR=true` accepts the auto-arranged todo and
	# `GIT_EDITOR=true` keeps any message editor shut, defensive under fixup semantics
	# `rerere` replays an already-resolved hunk, and `rr-cache` carries that across retries
	# The fold's own fixup alone goes beside its target – `--autosquash` moved every `fixup!` in the
	# span, another commit's included
	local SEQ=$(MKTEMP_FILE git-edit-fold-seq)
	_TEMP_FILES+=("$SEQ")
	cat > "$SEQ" <<'SEQEOF'
#!/bin/sh
awk -v fix="$GIT_EDIT_FOLD_FIXUP" -v tgt="$GIT_EDIT_FOLD_TARGET" '
	$1 == "pick" && length($2) >= 7 && index(fix, $2) == 1 { next }
	{ print }
	!done && $1 == "pick" && length($2) >= 7 && index(tgt, $2) == 1 { print "fixup " fix; done = 1 }
' "$1" > "$1.git-edit" && mv "$1.git-edit" "$1"
SEQEOF
	chmod +x "$SEQ"
	local REBASE_CMD="GIT_EDIT_FOLD_FIXUP=$FIXUP_COMMIT GIT_EDIT_FOLD_TARGET=$TARGET_FULL GIT_SEQUENCE_EDITOR=${(q-)SEQ} GIT_EDITOR=true git -c rerere.enabled=true -c rerere.autoUpdate=false -c rebase.updateRefs=false -c rebase.instructionFormat= $_CAPTURE_PINS rebase $_CAPTURE_EXEC --no-autosquash --no-autostash --interactive $REBASE_BASE"
	PRINT_CMD "$REBASE_CMD" 90
	_RERERE_SCOPE_BEGIN
	if ! eval "$REBASE_CMD" >/dev/null 2>&1 && \
	   ! { _AUTO_RESOLVE_FINAL_STEP "$WT" "$STAGED_TREE" guard-empty && _FINISH_AUTO_RESOLVED_STEP "$WT" "staged" }; then
		# Conflict during autosquash – save state and leave the worktree alive for `git edit
		# --continue`, or `git edit --abort` to cancel, since the branch never moved and the
		# staged changes are still staged in main
		_SAVE_STATE \
			"operation=amend-into" \
			"fixup=$FIXUP_COMMIT" \
			"worktree=$WT" \
			"branch=$REF" \
			"orig_head=$ORIG_HEAD" \
			"target=$TARGET_FULL" \
			"depth=$DEPTH" \
			"rebasebase=$REBASE_BASE" \
			"stagedtree=$STAGED_TREE" \
			"maindir=$MAIN_DIR" \
			"files=${(pj:\t:)STAGED_PATHS}"\
			"pathspecs=${(pj:\t:)AMEND_PATHSPECS}" \
			"tree=$AMEND_TREE"
		# Don't auto-cleanup the worktree – it holds the in-progress rebase
		_CLEANUP_HOOK=""

		PRINT_ERR "Conflict during autosquash – resolve in worktree, then 'git edit --continue'"
		PRINT_TEXT "Worktree: %s" 33 "$WT"
		local UNMERGED_LIST=$(_PRINT_CONFLICT_DETAIL "$WT")
		PRINT_TEXT "Or abort the operation: %s" 33 "git edit --abort"
		EMIT_CONFLICT "$WT" "$UNMERGED_LIST"
		_PAUSE_EXIT 2 conflict
	fi

	local NEW_HEAD=$(git rev-parse HEAD)

	# A tip tree identical to the pre-op tip means nothing folded – the target already carried
	# every staged hunk, a staged revert of a later change say, so the fixup dissolved and
	# each pick replayed itself, and landing it would report a fold that never happened
	if [ "$(git rev-parse 'HEAD^{tree}')" = "$(git rev-parse "$ORIG_HEAD^{tree}")" ]; then
		PRINT_ERR "The fold left history unchanged – ${TARGET_FULL:0:7} already carries that content"
		PRINT_TEXT "Nothing was applied; %s untouched." 33 "$(_FOLD_SOURCE)"
		exit 1
	fi

	# Verification gate – the fold is built but not applied, so a failure pauses with
	# everything in place and the resolution work survives
	local VERIFY_PRIMARY
	if [ "$REBASE_BASE" = "--root" ]; then
		VERIFY_PRIMARY=$(git rev-list --reverse "$NEW_HEAD" 2>/dev/null | head -1)
	else
		VERIFY_PRIMARY=$(git rev-list --reverse "$REBASE_BASE..$NEW_HEAD" 2>/dev/null | head -1)
	fi
	if ! _GUARD_TIP_MODES "$WT" "$NEW_HEAD" "$ORIG_HEAD" "$(_MODE_LINES "$WT" "$ORIG_HEAD" "$STAGED_TREE")" || ! _VERIFY_REWRITE "$WT" "$NEW_HEAD" "$ORIG_HEAD" "$VERIFY_PRIMARY"; then
		_SAVE_STATE \
			"operation=amend-into" \
			"fixup=$FIXUP_COMMIT" \
			"worktree=$WT" \
			"branch=$REF" \
			"orig_head=$ORIG_HEAD" \
			"target=$TARGET_FULL" \
			"depth=$DEPTH" \
			"rebasebase=$REBASE_BASE" \
			"stagedtree=$STAGED_TREE" \
			"maindir=$MAIN_DIR" \
			"files=${(pj:\t:)STAGED_PATHS}"\
			"pathspecs=${(pj:\t:)AMEND_PATHSPECS}" \
			"tree=$AMEND_TREE"
		_CLEANUP_HOOK=""
		EMIT_GATE_PAUSED "$WT" "$NEW_HEAD"
		_PAUSE_EXIT 2 gate
	fi

	# Step 4 – atomic CAS-update of the branch ref, guarded on the pre-op tip, refusing where
	# the branch moved during autosquash, since nothing was consumed and the staging stands
	local UPDATE_CMD="git update-ref -m ${(q-)${:-git edit: amend-into ${TARGET_FULL:0:7}$_REFLOG_TAG}} ${(q-)REF} ${(q-)NEW_HEAD} ${(q-)ORIG_HEAD}"
	PRINT_CMD "$UPDATE_CMD" 90
	if ! _MOVE_REF "$UPDATE_CMD"; then
		PRINT_ERR "Branch '$REF' moved during autosquash – refusing to overwrite"
		PRINT_TEXT "Nothing was applied; %s untouched – retry when ready." 33 "$(_FOLD_SOURCE)"
		exit 1
	fi
	_RECORD_REF_MOVE "$REF" "$ORIG_HEAD" "$NEW_HEAD" "amend-into ${TARGET_FULL:0:7}"

	# Re-sync exactly the folded paths' index entries to the new `HEAD`, those staged changes
	# being history now – path-scoped, so anything a parallel session staged meanwhile keeps
	# its staged state where a whole-index reset would wipe it. A `--tree` fold staged nothing,
	# so the summary reconciles its entries like any other rewrite's instead
	[ -z "$AMEND_TREE" ] && _RESYNC_FOLDED "$MAIN_DIR" "$STAGED_TREE" "${STAGED_PATHS[@]}"

	_PRINT_AMENDED_SUMMARY "$NEW_HEAD" "$DEPTH" "$STAGED_FILES" "$MAIN_DIR" "$REBASE_BASE" "$ORIG_HEAD" "$STAGED_TREE" ""

	# Export new `HEAD` + ref for the success trailer in the dispatch block
	AMEND_NEW_HEAD=$NEW_HEAD
	AMEND_REF=$REF
}

# Composes the tree a fold carries – a scoped fold takes the pre-op tip plus only the named staged
# entries, so whatever else sits in the shared index cannot ride along into a past commit, a
# parallel session's staging included, which can land in the turn between `git add` and the call
_FOLD_TREE () {
	# Args: <pre-op tip>
	if [ ${#AMEND_PATHSPECS[@]} -gt 0 ]; then
		_STAGED_TREE_FOR "$1"
	elif [ -n "$AMEND_TREE" ]; then
		print -r -- "$AMEND_TREE"
	else
		git write-tree 2>/dev/null
	fi
}

# Tells whether this git's `merge-tree` takes an explicit merge base, which 2.40 added – its usage
# spells the option `--[no-]merge-base` from 2.44 on
_MERGE_TREE_TAKES_BASE () {
	[[ "$( export LC_ALL=C; git merge-tree -h 2>&1 )" == *"merge-base"* ]]
}

# Folds by merging the fold into every commit from the target up instead of replaying the commits
# above it – where later commits rewrote the lines beside the fold, a replay stops at each of
# them, while a snapshot stops once per distinct content of the conflicted file
_AMEND_INTO_SNAPSHOT () {
	if [ -n "$TEXT_VALUE" ]; then
		PRINT_ERR "--snapshot takes no --text – fold first, then reword: git edit -M --text=\"…\" <sha>"
		exit 1
	fi
	if ! _MERGE_TREE_TAKES_BASE; then
		PRINT_ERR "--snapshot needs git 2.40 or later, whose merge-tree takes --merge-base"
		exit 1
	fi
	local STAGED_TREE=$FOLD_SNAP
	# The fold as a commit on the tip, the side every snapshot merges in
	STATE_FOLD=$(git commit-tree "$STAGED_TREE" -p "$ORIG_HEAD" -m "fold into ${TARGET_FULL:0:7}" </dev/null) || exit 1
	STATE_WORKTREE=$(MKTEMP_DIR git-edit-snapshot) || exit 1
	rmdir "$STATE_WORKTREE"
	_CLEANUP_HOOK="git worktree remove --force ${(q-)STATE_WORKTREE} 2>/dev/null; rm -rf ${(q-)STATE_WORKTREE}"
	_WORKTREE_ADD "$STATE_WORKTREE" "$ORIG_HEAD" quiet || exit 1
	_LINK_WORKTREE_EXTRAS "$STATE_WORKTREE"
	STATE_TARGET=$TARGET_FULL
	STATE_ORIG_HEAD=$ORIG_HEAD
	STATE_BRANCH=$REF
	STATE_MAINDIR=$MAIN_DIR
	STATE_DEPTH=$DEPTH
	STATE_STAGEDTREE=$STAGED_TREE
	STATE_FILES=${(pj:\t:)STAGED_PATHS}
	STATE_PATHSPECS=${(pj:\t:)AMEND_PATHSPECS}
	STATE_TREE=$AMEND_TREE
	STATE_REBASEBASE=--root
	git rev-parse -q --verify "$TARGET_FULL^" >/dev/null 2>&1 && STATE_REBASEBASE="$TARGET_FULL^"
	_RERERE_SCOPE_BEGIN
	_SNAPSHOT_RUN
}

# Rebuilds each first-parent commit from the target up with the fold merged in, author and
# message kept – `git merge-tree` against the pre-op tip as base carries a renamed path's fold to
# its old name, and a conflict takes the resolution recorded for that path and content, or stops
_SNAPSHOT_BUILD () {
	# Args: <resolution map>
	# • Reads `STATE_TARGET`, `STATE_ORIG_HEAD` and `STATE_FOLD`
	# • Sets `_SNAPSHOT_TIP`, or on a stop `_SNAPSHOT_ERA`, `_SNAPSHOT_TREE` and `_SNAPSHOT_STAGES`
	# • Returns 2 on a stop, 1 on a refusal it has printed
	local MAP=$1 C OUT RC TREE PARENT NEWC P BLOB LINE KEY IDX
	local -a ERAS MT_LINES STAGES PATHS PENDING SUBST NF
	local -A RES SEEN
	local FIRST_USE
	_REWRITE_PAIRS=()
	_SNAPSHOT_RESOLVED_TREES=()
	if [ -s "$MAP" ]; then
		# A tab through a variable – inside a subscript zsh keeps `$'\t'` as those four characters
		local TAB=$'\t' L
		# From the end, as a name may hold a tab
		while IFS= read -r L; do
			LINE=${L##*$TAB} L=${L%$TAB*}
			BLOB=${L##*$TAB} P=${L%$TAB*}
			RES[$P$TAB$BLOB]=$LINE
		done < "$MAP"
	fi
	PARENT=$(git rev-parse -q --verify "$STATE_TARGET^" 2>/dev/null)
	if [ -n "$PARENT" ]; then
		ERAS=(${(f)"$(git rev-list --reverse --first-parent "$PARENT..$STATE_ORIG_HEAD")"})
	else
		ERAS=(${(f)"$(git rev-list --reverse --first-parent "$STATE_ORIG_HEAD")"})
	fi
	PRINT_CMD "git merge-tree --write-tree --merge-base=${STATE_ORIG_HEAD:0:7} <commit> ${STATE_FOLD:0:7} # each of ${#ERAS[@]} commit(s)" 90
	for C in "${ERAS[@]}"; do
		# NUL-separated, as the line form quotes a name holding a quote, backslash or tab
		OUT=$(git merge-tree --write-tree -z --merge-base="$STATE_ORIG_HEAD" "$C" "$STATE_FOLD" 2>/dev/null)
		RC=$?
		MT_LINES=("${(@0)OUT}")
		TREE=${MT_LINES[1]}
		if [ $RC -eq 1 ]; then
			# The conflicted entries, a line per stage, run up to the blank line before git's messages
			STAGES=()
			for LINE in "${(@)MT_LINES[2,-1]}"; do
				[ -z "$LINE" ] && break
				STAGES+=("$LINE")
			done
			PATHS=(${(u)STAGES[@]#*$'\t'})
			# Only a conflict over content leaves all three stages at a path this commit has – a
			# deletion or a rename meeting the fold has no one text to resolve
			for P in "${PATHS[@]}"; do
				if [ ${#${(M)STAGES[@]:#*$'\t'${(b)P}}} -ne 3 ] || ! git cat-file -e "$C:$P" 2>/dev/null; then
					PRINT_ERR "Merging the fold into ${C:0:7} meets $P in a conflict that is not over its content"
					ECHO_E "\e[0;31m  --snapshot resolves content conflicts only – fold without it to replay instead.\e[0m" >&2
					return 1
				fi
			done
			PENDING=()
			SUBST=()
			FIRST_USE=false
			for P in "${PATHS[@]}"; do
				KEY=$P$'\t'$(git rev-parse "$C:$P")
				if [ -n "${RES[$KEY]}" ]; then
					SUBST+=("$P"$'\t'"${RES[$KEY]}")
					[ -z "${SEEN[$KEY]}" ] && FIRST_USE=true
					SEEN[$KEY]=1
				else
					PENDING+=("$P")
				fi
			done
			if [ ${#SUBST[@]} -gt 0 ]; then
				IDX=$(MKTEMP_FILE git-edit-snapshot-idx)
				_TEMP_FILES+=("$IDX")
				rm -f "$IDX"
				GIT_INDEX_FILE=$IDX git read-tree "$TREE" || { rm -f "$IDX"; return 1; }
				for LINE in "${SUBST[@]}"; do
					P=${LINE%%$'\t'*}
					LINE=${LINE#*$'\t'}
					if [ "$LINE" = "-" ]; then
						GIT_INDEX_FILE=$IDX git -C "$(git rev-parse --show-toplevel)" update-index --force-remove -- "$P" || { rm -f "$IDX"; return 1; }
					else
						GIT_INDEX_FILE=$IDX git update-index --add --cacheinfo "${LINE%% *},${LINE#* },$P" || { rm -f "$IDX"; return 1; }
					fi
				done
				TREE=$(GIT_INDEX_FILE=$IDX git write-tree) || { rm -f "$IDX"; return 1; }
				rm -f "$IDX"
			fi
			if [ ${#PENDING[@]} -gt 0 ]; then
				_SNAPSHOT_ERA=$C
				_SNAPSHOT_TREE=$TREE
				_SNAPSHOT_STAGES=()
				for P in "${PENDING[@]}"; do
					_SNAPSHOT_STAGES+=(${(M)STAGES[@]:#*$'\t'${(b)P}})
				done
				return 2
			fi
			# The first commit each resolution reaches, for the gate's default tier to check
			[ "$FIRST_USE" = "true" ] && _SNAPSHOT_RESOLVED_TREES+=("$TREE")
		elif [ $RC -ne 0 ]; then
			PRINT_ERR "git merge-tree could not merge the fold into ${C:0:7}"
			return 1
		fi
		NF=("${(@0)$(git log -1 --format='%an%x00%ae%x00%ad%x00%B' --date=raw "$C")}")
		if [ -n "$PARENT" ]; then
			NEWC=$(_COMMIT_TREE_AS "$C" "${NF[1]}" "${NF[2]}" "${NF[3]}" "$TREE" -p "$PARENT" -m "${NF[4]}") || return 1
		else
			NEWC=$(_COMMIT_TREE_AS "$C" "${NF[1]}" "${NF[2]}" "${NF[3]}" "$TREE" -m "${NF[4]}") || return 1
		fi
		_RECORD_REWRITE "$C" "$NEWC"
		PARENT=$NEWC
	done
	_SNAPSHOT_TIP=$PARENT
	return 0
}

# Lays the first conflict no resolution covers out in the worktree as any merge's – the commit
# checked out, the merge's result in place, its conflicted paths at their three stages – so `git
# status`, rerere and the resolution guard read it as usual, then pauses
_SNAPSHOT_PAUSE () {
	# Args: <worktree git dir>
	local WT=$STATE_WORKTREE P
	local -a PATHS=(${(u)_SNAPSHOT_STAGES[@]#*$'\t'})
	local NULL_OID=${(l:${#_SNAPSHOT_ERA}::0:)}
	git -C "$WT" checkout -qf --detach "$_SNAPSHOT_ERA" 2>/dev/null
	if ! git -C "$WT" read-tree --reset -u "$_SNAPSHOT_TREE" 2>/dev/null || \
	   ! { for P in "${PATHS[@]}"; do print -rn -- "0 $NULL_OID"$'\t'"$P"$'\0'; done; print -rn -- "${(pj:\0:)_SNAPSHOT_STAGES}"$'\0'; } | git -C "$WT" update-index -z --index-info; then
		PRINT_ERR "Could not lay the conflict at ${_SNAPSHOT_ERA:0:7} out in the worktree"
		exit 1
	fi
	: >| "$1/git-edit-snapshot-pending"
	print -r -- "$_SNAPSHOT_TREE" >| "$1/git-edit-snapshot-tree"
	for P in "${PATHS[@]}"; do
		print -r -- "$P"$'\t'"$(git rev-parse "$_SNAPSHOT_ERA:$P")" >> "$1/git-edit-snapshot-pending"
	done
	# A hunk resolved at an earlier stop arrives pre-filled – that stop's own record, recorded at
	# its continue, would otherwise count as this one's
	rm -f "$1/MERGE_RR"
	git -C "$WT" -c rerere.enabled=true -c rerere.autoUpdate=false rerere >/dev/null 2>&1
	_SNAPSHOT_SAVE_STATE
	_CLEANUP_HOOK=""
	PRINT_ERR "Conflict merging the fold into ${_SNAPSHOT_ERA:0:7} – resolve in the worktree, stage it, then 'git edit --continue'"
	_PRINT_COMMIT_LINE "$_SNAPSHOT_ERA" '  at: %h %s'
	PRINT_TEXT "%s" 33 "The resolution serves every later commit carrying the same content, so each stops once."
	PRINT_TEXT "Worktree: %s" 33 "$WT"
	local UNMERGED_LIST=$(_PRINT_CONFLICT_DETAIL "$WT")
	PRINT_TEXT "Or abort the operation: %s" 33 "git edit --abort"
	EMIT_CONFLICT "$WT" "$UNMERGED_LIST"
	_PAUSE_EXIT 2 conflict
}

_SNAPSHOT_SAVE_STATE () {
	_SAVE_STATE \
		"operation=snapshot" \
		"worktree=$STATE_WORKTREE" \
		"branch=$STATE_BRANCH" \
		"orig_head=$STATE_ORIG_HEAD" \
		"target=$STATE_TARGET" \
		"depth=$STATE_DEPTH" \
		"rebasebase=$STATE_REBASEBASE" \
		"stagedtree=$STATE_STAGEDTREE" \
		"fold=$STATE_FOLD" \
		"maindir=$STATE_MAINDIR" \
		"files=$STATE_FILES" \
		"pathspecs=$STATE_PATHSPECS" \
		"tree=$STATE_TREE"
}

# Builds the snapshot fold and lands it, or pauses at a conflict no resolution covers – the first
# run and every `--continue` alike, the build being quick and the map carrying what was resolved
_SNAPSHOT_RUN () {
	local WT=$STATE_WORKTREE LINE
	local GD=$(git -C "$WT" rev-parse --absolute-git-dir)
	local -a _SNAPSHOT_STAGES _SNAPSHOT_RESOLVED_TREES EMPTIED
	local _SNAPSHOT_TIP _SNAPSHOT_ERA _SNAPSHOT_TREE
	_SNAPSHOT_BUILD "$GD/git-edit-snapshot-map"
	case $? in
		0) ;;
		2) _SNAPSHOT_PAUSE "$GD" ;;
		*) exit 1 ;;
	esac
	local NEW_HEAD=$_SNAPSHOT_TIP
	# The last snapshot is the tip merged with its own fold, so it must carry the fold exactly
	if [ "$(git rev-parse "$NEW_HEAD^{tree}")" != "$(git rev-parse "$STATE_STAGEDTREE^{tree}")" ]; then
		PRINT_ERR "The rebuilt tip differs from the fold applied to the tip – refusing to land it"
		exit 1
	fi
	local RESOLUTIONS=0
	[ -s "$GD/git-edit-snapshot-map" ] && RESOLUTIONS=$(grep -c . "$GD/git-edit-snapshot-map")
	PRINT_TEXT "Merged the fold into %s commit(s) from %s up, with %s resolution(s)." 32 "${#_REWRITE_PAIRS[@]}" "${STATE_TARGET:0:7}" "$RESOLUTIONS"
	# A commit the fold emptied stays, as nothing here drops one – named, unless empty before too
	local -A TREE_OF PARENT_OF
	local -a SPAN=("$NEW_HEAD" "$STATE_ORIG_HEAD")
	local BELOW=$(git rev-parse -q --verify "$STATE_TARGET^" 2>/dev/null)
	if [ -n "$BELOW" ]; then
		SPAN+=(--not "$BELOW")
		TREE_OF[$BELOW]=$(git rev-parse "$BELOW^{tree}")
	fi
	for LINE in ${(f)"$(git log --format='%H %T %P' "${SPAN[@]}" 2>/dev/null)"}; do
		TREE_OF[${LINE%% *}]=${${LINE#* }%% *}
		PARENT_OF[${LINE%% *}]=${${LINE#* * }%% *}
	done
	for LINE in "${_REWRITE_PAIRS[@]}"; do
		[ "${TREE_OF[${LINE#* }]}" = "${TREE_OF[${PARENT_OF[${LINE#* }]}]}" ] && \
		[ "${TREE_OF[${LINE%% *}]}" != "${TREE_OF[${PARENT_OF[${LINE%% *}]}]}" ] && EMPTIED+=("${LINE#* }")
	done
	for LINE in "${EMPTIED[@]}"; do
		_PRINT_COMMIT_LINE "$LINE" '  left empty by the fold: %h %s'
	done
	git -C "$WT" checkout -qf --detach "$NEW_HEAD" 2>/dev/null
	STATE_RESOLVED="${_SNAPSHOT_RESOLVED_TREES[*]}"
	if ! _GUARD_TIP_MODES "$WT" "$NEW_HEAD" "$STATE_ORIG_HEAD" "$(_MODE_LINES "$WT" "$STATE_ORIG_HEAD" "$STATE_STAGEDTREE")" || ! _VERIFY_REWRITE "$WT" "$NEW_HEAD" "$STATE_ORIG_HEAD" ""; then
		_SNAPSHOT_SAVE_STATE
		_CLEANUP_HOOK=""
		EMIT_GATE_PAUSED "$WT" "$NEW_HEAD"
		_PAUSE_EXIT 2 gate
	fi
	local UPDATE_CMD="git update-ref -m ${(q-)${:-git edit: amend-into ${STATE_TARGET:0:7}$_REFLOG_TAG}} ${(q-)STATE_BRANCH} ${(q-)NEW_HEAD} ${(q-)STATE_ORIG_HEAD}"
	PRINT_CMD "$UPDATE_CMD" 90
	if ! _MOVE_REF "$UPDATE_CMD"; then
		[ -n "$_STATE_OWNED" ] && _REFUSE_MOVED_BRANCH "$STATE_BRANCH" "$WT"
		PRINT_ERR "Branch '$STATE_BRANCH' moved during the snapshot fold – refusing to overwrite"
		PRINT_TEXT "Nothing was applied; %s untouched – retry when ready." 33 "$(_FOLD_SOURCE)"
		exit 1
	fi
	_RECORD_REF_MOVE "$STATE_BRANCH" "$STATE_ORIG_HEAD" "$NEW_HEAD" "amend-into ${STATE_TARGET:0:7}"
	# The folded paths' index entries follow the new tip, as a replayed fold's do – a `--tree`
	# fold staged nothing, so the summary reconciles its entries like any other rewrite's
	AMEND_TREE=$STATE_TREE
	[ -z "$AMEND_TREE" ] && [ -n "$STATE_FILES" ] && _RESYNC_FOLDED "$STATE_MAINDIR" "$STATE_STAGEDTREE" "${(@ps:\t:)STATE_FILES}"
	[ -n "$STATE_PATHSPECS" ] && AMEND_PATHSPECS=("${(@ps:\t:)STATE_PATHSPECS}")
	_PRINT_AMENDED_SUMMARY "$NEW_HEAD" "$STATE_DEPTH" "${STATE_FILES//$'\t'/,}" "$STATE_MAINDIR" "$STATE_REBASEBASE" "$STATE_ORIG_HEAD" "$STATE_STAGEDTREE" "${_SNAPSHOT_RESOLVED_TREES:+resolved}"
	[ -n "$_STATE_OWNED" ] && _CLEAR_STATE
	AMEND_NEW_HEAD=$NEW_HEAD
	AMEND_REF=$STATE_BRANCH
}

# Records the resolution staged for each path that stopped, keyed by that path and the stopped
# commit's content so every commit carrying the same takes it, then builds again
_CONTINUE_SNAPSHOT () {
	if [ -n "$TEXT_VALUE" ]; then
		PRINT_ERR "--snapshot takes no --text – finish the fold, then reword: git edit -M --text=\"…\" <sha>"
		exit 1
	fi
	if [ ! -d "$STATE_WORKTREE" ]; then
		PRINT_ERR "Worktree no longer exists: $STATE_WORKTREE"
		_CLEAR_STATE
		exit 1
	fi
	_CLEANUP_HOOK="git worktree remove --force ${(q-)STATE_WORKTREE} 2>/dev/null; rm -rf ${(q-)STATE_WORKTREE}"
	PRINT_ACTION "Continuing the snapshot fold into %s..." "$STATE_TARGET"
	local WT=$STATE_WORKTREE P BLOB ENTRY
	local GD=$(git -C "$WT" rev-parse --absolute-git-dir)
	if [ -s "$GD/git-edit-snapshot-pending" ]; then
		local UNMERGED=$(_UNMERGED_IN "$WT")
		if [ -n "$UNMERGED" ]; then
			_CLEANUP_HOOK=""
			PRINT_ERR "Unresolved paths remain – resolve and stage them, then 'git edit --continue'"
			EMIT_CONFLICT "$WT" "$UNMERGED"
			_PAUSE_EXIT 2 conflict
		fi
		_GUARD_RESOLUTION_CLEAN "$WT" "$STATE_FOLD"
		# Staging beyond the stopped paths would never reach a commit – the snapshot takes their
		# resolutions alone – so it refuses rather than drop it
		local -a STOPPED EXTRA
		local SLINE
		while IFS= read -r SLINE; do STOPPED+=("${SLINE%$'\t'*}"); done < "$GD/git-edit-snapshot-pending"
		if [ -s "$GD/git-edit-snapshot-tree" ]; then
			for P in ${(0)"$(git -C "$WT" diff-index --cached -z --name-only "$(<"$GD/git-edit-snapshot-tree")" 2>/dev/null)"}; do
				(( ${STOPPED[(Ie)$P]} )) || EXTRA+=("$P")
			done
		fi
		if [ ${#EXTRA} -gt 0 ]; then
			_CLEANUP_HOOK=""
			PRINT_ERR "Staged beyond the stopped paths, which a snapshot fold would drop: ${(j:, :)EXTRA}"
			ECHO_E "\e[0;31m  Unstage them in $(_LIT "$WT") – fold them separately – then 'git edit --continue'.\e[0m" >&2
			exit 1
		fi
		# Recorded for rerere too, which pre-fills the same hunks at a later stop
		git -C "$WT" -c rerere.enabled=true -c rerere.autoUpdate=false rerere >/dev/null 2>&1
		while IFS= read -r SLINE; do
			# From the end, as a name may hold a tab
			P=${SLINE%$'\t'*} BLOB=${SLINE##*$'\t'}
			ENTRY=$(git -C "$WT" ls-files -s -- ":(literal)$P" 2>/dev/null)
			if [ -n "$ENTRY" ]; then
				ENTRY=${${ENTRY%%$'\t'*}% *}
			else
				ENTRY=-
			fi
			print -r -- "$P"$'\t'"$BLOB"$'\t'"$ENTRY" >> "$GD/git-edit-snapshot-map"
		done < "$GD/git-edit-snapshot-pending"
		rm -f "$GD/git-edit-snapshot-pending"
	fi
	_SNAPSHOT_RUN
	PRINT_COMPLETED "$AMEND_NEW_HEAD" "$AMEND_REF" true
}

# Aborts a paused snapshot fold – the branch never moved and nothing was consumed, so removing
# the worktree, its map with it, leaves the fold to retry
_ABORT_SNAPSHOT () {
	PRINT_ACTION "Aborting the snapshot fold into %s..." "$STATE_TARGET"
	if [ -d "$STATE_WORKTREE" ]; then
		local CMD="git worktree remove --force ${(q-)STATE_WORKTREE} 2>/dev/null; rm -rf ${(q-)STATE_WORKTREE}"
		PRINT_CMD "$CMD" 90
		eval "$CMD"
	fi
	if [ -n "$STATE_TREE" ]; then
		PRINT_TEXT "Branch was never touched – the tree is intact, ready to retry." 32
	else
		PRINT_TEXT "Branch was never touched – %s still in place, ready to retry." 32 "$(_FOLD_SOURCE)"
	fi
	_CLEAR_STATE
	PRINT_TEXT "%s" 32 "Snapshot fold aborted, state cleared."
	EMIT_STATUS "$STATE_ORIG_HEAD" "$STATE_BRANCH" false
}

# Commits that last touched the exact lines the staged diff rewrites, as a fix belongs to whoever
# wrote the line, not the newest commit to touch the file – pure additions carry none, and a
# failed blame prints the path and git's reason and returns 1, as no evidence is no guess
_BLAME_AMEND_TARGETS () {
	local TOPLEVEL=$(git rev-parse --show-toplevel)
	local P HUNK START COUNT OUT
	local -a LARGS FOUND
	for P in "$@"; do
		# A submodule's pointer has no lines to blame – the per-path guess finds who last moved it
		[ "$(git -C "$TOPLEVEL" cat-file -t "HEAD:$P" 2>/dev/null)" = commit ] && continue
		LARGS=()
		while IFS= read -r HUNK; do
			# "@@ -<start>[,<count>]" – an absent count means one line, 0 means
			# a pure insertion
			START=${${HUNK#@@ -}%%[, ]*}
			COUNT=$(print -r -- "$HUNK" | LC_ALL=C sed -nE 's/^@@ -[0-9]+,([0-9]+).*/\1/p')
			[ -z "$COUNT" ] && COUNT=1
			[ "$COUNT" = "0" ] && continue
			LARGS+=(-L "$START,+$COUNT")
		done < <(git -C "$TOPLEVEL" diff "${AMEND_SOURCE[@]}" -U0 --inter-hunk-context=0 --no-renames --no-color --no-ext-diff \
			--no-textconv -- ":(literal)$P" 2>/dev/null | LC_ALL=C grep -aE '^@@')
		[ ${#LARGS[@]} -eq 0 ] && continue
		# Every line to the commit that wrote it, whatever ignore-revs files skip – an empty
		# `--ignore-revs-file=` clears them, where an empty `-c` sorts first and clears nothing
		if ! OUT=$(git -C "$TOPLEVEL" blame --no-textconv --ignore-revs-file= "${LARGS[@]}" --porcelain HEAD -- "$P" 2>/dev/null); then
			# A missing one fails blame first, so this reads no user or system config – `HOME` too, for
			# a git before 2.32 – and trusts the repo as that config did
			if ! OUT=$(HOME=/nonexistent XDG_CONFIG_HOME=/nonexistent GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 \
					git -C "$TOPLEVEL" -c safe.directory="$TOPLEVEL" blame --no-textconv --ignore-revs-file= "${LARGS[@]}" --porcelain HEAD -- "$P" 2>&1); then
				print -r -- "$P – ${OUT%%$'\n'*}"
				return 1
			fi
		fi
		FOUND+=(${(f)"$(print -r -- "$OUT" | LC_ALL=C grep -aoE '^[0-9a-f]{40,64}')"})
	done
	(( ${#FOUND} )) && print -rl -- ${(u)FOUND}
	return 0
}

# Answers whether a merge here pairs renames – `merge.renames`, else `diff.renames`, read raw, as
# `--type=bool` refuses a `copies` in any config file, even one a later file overrides
_MERGE_DETECTS_RENAMES () {
	local K L V
	for K in merge.renames diff.renames; do
		# The last value, as git takes it – one with no value at all fails the merge, pairing nothing
		L=$(git config --get-regexp "^${K/./\\.}\$" 2>/dev/null | tail -1)
		[ -n "$L" ] || continue
		[ "$L" = "$K" ] && return 1
		V=${L#"$K "}
		[[ "${V:l}" == (copies|copy) ]] && return 0
		# Any other value is git's boolean, `0x0` and `00` included – one it can't read, the merge dies on
		V=$(git -c edit.renamesprobe="$V" config --type=bool --get edit.renamesprobe 2>/dev/null) || return 0
		[ "$V" = true ]
		return
	done
	return 0
}


# Resolves `--amend-into=auto` to the newest unpushed commit touching the staged paths –
# conservative, since every staged path with history must agree on one target and paths
# with none follow that consensus, and each refusal lists the per-path candidates
_RESOLVE_AMEND_TARGET () {
	local -a PATHS
	# Scoped to the same pathspec the fold will use – inferring a target from paths that will
	# not be folded answers a question nobody asked
	PATHS=(${(0)"$(git diff -z "${AMEND_SOURCE[@]}" --name-only -- "${AMEND_PATHSPECS[@]}")"})
	if [ -z "${PATHS[1]}" ]; then
		if [ -n "$AMEND_TREE" ]; then
			PRINT_ERR "--tree $AMEND_TREE_GIVEN differs from HEAD in nothing – nothing to fold"
		else
			PRINT_ERR "No staged changes to amend"
			ECHO_E "\e[0;31m  Stage files with 'git add <files>' before running --amend-into.\e[0m" >&2
		fi
		exit 1
	fi

	# Staged paths are root-relative, so anchor the per-path lookups at the repo root and they
	# resolve from a subdirectory too
	local TOPLEVEL=$(git rev-parse --show-toplevel)
	local P C

	# Line-level evidence wins where it exists – it is the difference between
	# folding into the commit that wrote the code and the commit that merely
	# touched the file last
	local -a BLAMED
	local BLAME_OUT
	if ! BLAME_OUT=$(_BLAME_AMEND_TARGETS "${PATHS[@]}"); then
		PRINT_ERR "Cannot auto-target: blame can't attribute the staged lines – ${BLAME_OUT}"
		ECHO_E "\e[0;31m  Pass an explicit --amend-into=<sha>.\e[0m" >&2
		exit 1
	fi
	BLAMED=(${${(@f)BLAME_OUT}:#})
	if [ ${#BLAMED[@]} -gt 1 ]; then
		PRINT_ERR "Cannot auto-target: the staged lines were last touched by different commits"
		for C in "${BLAMED[@]}"; do
			ECHO_E "\e[0;31m  ${C:0:7} ($(_LIT "$(git log -1 --format=%s "$C" 2>/dev/null)"))\e[0m" >&2
		done
		ECHO_E "\e[0;31m  Pass an explicit --amend-into=<sha>, or stage and fold per target.\e[0m" >&2
		exit 1
	fi
	if [ ${#BLAMED[@]} -eq 1 ]; then
		C=${BLAMED[1]}
		if [ -n "$(_REMOTES_CONTAINING "$C")" ]; then
			PRINT_ERR "Cannot auto-target: the staged lines were last touched by a pushed commit (${C:0:7})"
			ECHO_E "\e[0;31m  Its history lies beyond the rewrite horizon – pass an explicit --amend-into=<sha>, or commit separately.\e[0m" >&2
			exit 1
		fi
		ECHO_E "\e[0;90mauto-target: commit that last touched the staged lines\e[0m"
		AMEND_INTO_TARGET=$C
		return
	fi
	# No old lines anywhere – pure additions or new files, nothing to attribute, so fall back
	# to the file-level guess below
	local -a CAND_LINES
	local CANDIDATE=""
	local MULTIPLE=false
	for P in "${PATHS[@]}"; do
		C=$(git -C "$TOPLEVEL" -c log.follow=false log -1 --format=%H HEAD -- ":(literal)$P" 2>/dev/null)
		if [ -z "$C" ]; then
			# New file – follows the consensus of the paths with history
			continue
		fi
		if [ -n "$(_REMOTES_CONTAINING "$C")" ]; then
			PRINT_ERR "Cannot auto-target: '$P' was last touched by a pushed commit (${C:0:7})"
			ECHO_E "\e[0;31m  Its history lies beyond the rewrite horizon – pass an explicit --amend-into=<sha>, or commit separately.\e[0m" >&2
			exit 1
		fi
		CAND_LINES+=("  $P -> ${C:0:7} ($(git log -1 --format=%s "$C"))")
		if [ -z "$CANDIDATE" ]; then
			CANDIDATE=$C
		elif [ "$C" != "$CANDIDATE" ]; then
			MULTIPLE=true
		fi
	done

	if [ -z "$CANDIDATE" ]; then
		PRINT_ERR "Cannot auto-target: no staged path has unpushed history"
		ECHO_E "\e[0;31m  All staged paths are new files – pass an explicit --amend-into=<sha>.\e[0m" >&2
		exit 1
	fi
	if [ "$MULTIPLE" = "true" ]; then
		PRINT_ERR "Cannot auto-target: staged paths point at different commits"
		local LINE
		for LINE in "${CAND_LINES[@]}"; do
			ECHO_E "\e[0;31m${LINE//\\/$_LITB}\e[0m" >&2
		done
		ECHO_E "\e[0;31m  Pass an explicit --amend-into=<sha>, or stage and fold per target.\e[0m" >&2
		exit 1
	fi

	ECHO_E "\e[0;90mauto-target: newest unpushed commit touching ${#PATHS[@]} staged path(s)\e[0m"
	AMEND_INTO_TARGET=$CANDIDATE
}

# Prints the amended commit's stat after a completed `--amend-into`, so the caller needs no
# follow-up `git show` to see where the fold landed
_PRINT_AMENDED_SUMMARY () {
	# Args: <new_head> <depth> <folded-files-comma-separated> [<main-checkout>] [<rebase-base>]
	#       [<orig-head>] [<staged-tree>] [<resolved-flag>]
	# The autosquash replays the target first, so the commit above the base is the amended one
	local AMENDED
	if [ -n "$5" ]; then
		if [ "$5" = "--root" ]; then
			AMENDED=$(git rev-list --reverse "$1" 2>/dev/null | head -1)
		else
			AMENDED=$(git rev-list --reverse "$5..$1" 2>/dev/null | head -1)
		fi
	fi
	[ -z "$AMENDED" ] && AMENDED=$(git rev-parse "$1~$2" 2>/dev/null)
	[ -z "$AMENDED" ] && return 0
	if [ -n "$3" ]; then
		PRINT_TEXT "Folded %s" 32 "$(print -r -- "$3" | LC_ALL=C sed 's/,/, /g')"
	else
		PRINT_TEXT "%s" 32 "Amended commit"
	fi
	git show --no-color --stat --format='' "$AMENDED" | head -12 | _CARET_LINES | LC_ALL=C sed "/./!d;s/^/${_DIM}/;s/\$/${_OFF}/"
	if [ -n "$AMEND_TREE" ]; then
		# The fold's content never sat in the checkout's index, so its entries are stranded like
		# any other rewrite's – re-synced where they still hold the pre-op tip, named where not
		[ -n "$4" ] && [ -n "$6" ] && _RECONCILE_CHECKOUT "$4" "$6" "$1" "Your checkout still holds the pre-fold content of:" "Index re-synced, your checkout is current."
	else
		_PRINT_LEFTOVER_STATE "$4"
	fi
	[ -n "$6" ] && _PRINT_MODE_CHANGES "$6" "$1"
	[ -n "$6" ] && _PRINT_TREE_IDENTITY "$6" "$1"
	# Same count check as a reorder's summary – a resolution reproducing its predecessor's
	# content leaves that commit empty and the rebase drops it, which a clean diffstat and an
	# `ok` trailer would otherwise wave through
	[ -n "$6" ] && _PRINT_DROPPED_COMMITS "$6" "$1"
	# The fold's correct tip is knowable up front, the pre-op tip plus the staged changes, so a
	# tip that differs means content beyond the fold moved – a staged hunk dissolved against a
	# later commit's content, or a conflict resolution deliberately diverged
	if [ -n "$7" ] && [ "$(git rev-parse "$1^{tree}" 2>/dev/null)" != "$7" ]; then
		if [ -n "$8" ]; then
			PRINT_TEXT "Note: tip tree differs from the staged result – a resolution changed content beyond the fold (compare: %s)" 33 "git diff ${7:0:12} ${1:0:12}"
		else
			PRINT_TEXT "Note: tip tree differs from the staged result – part of the fold dissolved against a later commit's content (compare: %s)" 33 "git diff ${7:0:12} ${1:0:12}"
		fi
	fi

	# Names the commit that received the fold below every block that grows with the operation,
	# as the drop list and the notes above both do, so a caller reading back through a
	# `tail -3` still finds this line
	_PRINT_COMMIT_LINE "$AMENDED" '  amended: %h %s'
	# Same reasoning – a fold that also reworded replaced a subject, which a symbolic target can
	# resolve to the wrong one entirely
	if [ -n "$AMEND_OLD_SHA" ]; then
		_PRINT_COMMIT_LINE "$AMEND_OLD_SHA" '  replaced: %s'
	fi
}

# Joins newline-separated paths onto one line, capping the tail so a large leftover set
# cannot swamp the summary – the exact list is one `git diff --cached --name-only` away
_JOIN_PATHS () {
	local -a NAMES=(${(f)1})
	local MORE=$(( ${#NAMES[@]} - 4 ))
	if [ "$MORE" -gt 0 ]; then
		print -r -- "${(j:, :)NAMES[1,4]}, +$MORE more"
	else
		print -r -- "${(j:, :)NAMES}"
	fi
}

# States what the fold left behind in the main checkout – a fold consumes the staged changes
# and nothing else, but the caller cannot see that from here, and "did my WIP survive?"
# was the most common probe, so read their checkout by path rather than this worktree's
_PRINT_LEFTOVER_STATE () {
	local D=$1
	[ -z "$D" ] || [ ! -d "$D" ] && return 0
	local STAGED_PATHS=$(git -C "$D" diff --cached --name-only 2>/dev/null)
	local STAGED=$(print -r -- "$STAGED_PATHS" | grep -c .)
	local UNSTAGED=$(git -C "$D" diff --name-only 2>/dev/null | grep -c .)
	local UNTRACKED=$(git -C "$D" ls-files --others --exclude-standard 2>/dev/null | grep -c .)
	local PARTS=""
	[ "$UNSTAGED" -gt 0 ]  && PARTS="$UNSTAGED modified"
	[ "$UNTRACKED" -gt 0 ] && PARTS="${PARTS:+$PARTS, }$UNTRACKED untracked"
	if [ "$STAGED" -gt 0 ] && [ ${#AMEND_PATHSPECS[@]} -gt 0 ]; then
		# A scoped fold is meant to leave the rest staged – name the paths, since a count cannot say
		# whether they are the caller's own leftovers or another session's, which only they clear
		PRINT_TEXT "Left staged (outside the pathspec): %s" 32 "$(_JOIN_PATHS "$STAGED_PATHS")"
	elif [ "$STAGED" -gt 0 ]; then
		# Nothing should survive an unscoped fold – the caller expects an empty index, so anything
		# left over is worth flagging to them
		PRINT_TEXT "Left staged, not folded: %s" 33 "$(_JOIN_PATHS "$STAGED_PATHS")"
	else
		PRINT_TEXT "Index now empty; working tree keeps %s." 32 "${PARTS:-no changes}"
	fi
}

# Guards both split paths – resolves a <sha> an earlier rewrite staled, then
# refuses what neither can express: the initial commit, a merge, or pushed history
# Leaves the resolved SHA in `_RESOLVED_SHA` for the caller to adopt
_SPLIT_GUARDS () {
	local X=$1
	_GUARD_REACHABLE "$X"
	X=$_RESOLVED_SHA
	if ! git rev-parse --verify "$X^" >/dev/null 2>&1; then
		PRINT_ERR "Cannot split the initial commit"
		exit 1
	fi
	if [[ "$(git log -1 --format='%P' "$X")" == *" "* ]]; then
		PRINT_ERR "Cannot split merge commit ${X:0:7}"
		exit 1
	fi
	_GUARD_UNPUSHED "$X"
}

# Answers whether git would alter a name or email handed to it as an ident – refusing an empty
# one, trimming what `ident.c` calls crud off its ends, dropping an angle bracket or newline
_IDENT_ALTERED () {
	# Args: <name> <email>
	[[ -z "$1" || -z "$2" || "$1$2" == *[$'<>\n']* ]] && return 0
	local CH
	for CH in "${1[1]}" "${1[-1]}" "${2[1]}" "${2[-1]}"; do
		# A `.` was crud too before git 2.42
		[[ "$CH" == [[:cntrl:][:space:].,:\;\"\\\'] ]] && return 0
	done
	return 1
}
# Stops a run whose rebuild failed partway – every mode lands only at its end, so nothing moved
_REBUILD_FAILED () {
	# Args: <commit it was rebuilding>
	PRINT_ERR "Could not rebuild ${1:0:7} – nothing was applied"
	exit 1
}


# Commits as `commit-tree` does, the author line carried byte for byte from <source> – handed an
# ident, git trims a name's quotes and refuses an empty one, both of which `rebase` keeps
_COMMIT_TREE_AS () {
	# Args: <source commit> <author name> <email> <raw date> <commit-tree arg>... – prints the commit
	local SRC=$1 AN=$2 AE=$3 AD=$4 NEW OBJ WANT HDR BODY
	shift 4
	# Only an ident git would alter is read back – the common one commits as handed
	if ! _IDENT_ALTERED "$AN" "$AE"; then
		GIT_AUTHOR_NAME=$AN GIT_AUTHOR_EMAIL=$AE GIT_AUTHOR_DATE="@$AD" git commit-tree "$@" </dev/null
		return
	fi
	local STAND_IN=false
	# An empty name commits under a stand-in, replaced below
	if ! NEW=$(GIT_AUTHOR_NAME="$AN" GIT_AUTHOR_EMAIL="$AE" GIT_AUTHOR_DATE="@$AD" git commit-tree "$@" </dev/null 2>/dev/null); then
		NEW=$(GIT_AUTHOR_NAME=git-edit GIT_AUTHOR_EMAIL="$AE" GIT_AUTHOR_DATE="@$AD" git commit-tree "$@" </dev/null) || return 1
		STAND_IN=true
	fi
	WANT=$(git cat-file commit "$SRC" | LC_ALL=C sed -n '/^author /{p;q;}')
	OBJ=$(git cat-file commit "$NEW"; print -n x) || return 1
	OBJ=${OBJ%x}
	HDR=${OBJ%%$'\n\n'*}
	BODY=${OBJ#*$'\n\n'}
	local -a HDR_LINES=("${(@f)HDR}") HDR_OUT=()
	local L SIGNED=false
	for L in "${HDR_LINES[@]}"; do
		[[ "$L" == gpgsig* ]] && SIGNED=true
	done
	# A signature covers the line it would replace, so it stands – bar a stand-in's
	if [ -z "$WANT" ] || [ "${HDR_LINES[(r)author *]}" = "$WANT" ] || { [ "$SIGNED" = true ] && [ "$STAND_IN" = false ]; }; then
		print -r -- "$NEW"
		return 0
	fi
	local SKIP=false
	for L in "${HDR_LINES[@]}"; do
		# A signature header runs on through its space-led lines
		if [[ "$L" == gpgsig* ]]; then
			SKIP=true
			continue
		fi
		[ "$SKIP" = true ] && [[ "$L" == " "* ]] && continue
		SKIP=false
		[[ "$L" == "author "* ]] && L=$WANT
		HDR_OUT+=("$L")
	done
	print -rn -- "${(F)HDR_OUT}"$'\n\n'"$BODY" | git hash-object -t commit -w --stdin
}

# Turns an extracted tree into the two commits and applies them – the extracted commit rests
# on the target's parent, the remainder carries the target's own tree and message, and
# the target's tree ends the pair either way, so neither split path can conflict
_SPLIT_APPLY () {
	local X=$1
	local TREE1=$2
	local REF=$3
	local ORIG_HEAD=$4
	local MSG=$5

	# Both halves keep the original author + date
	local X_MSG=$(git log -1 --format='%B' "$X")

	local -a XA=("${(@0)$(git log -1 --format='%an%x00%ae%x00%ad' --date=raw "$X")}")
	local C1 C2
	C1=$(_COMMIT_TREE_AS "$X" "${XA[1]}" "${XA[2]}" "${XA[3]}" "$TREE1" -p "$X^" -m "$MSG") || _REBUILD_FAILED "$X"
	C2=$(_COMMIT_TREE_AS "$X" "${XA[1]}" "${XA[2]}" "${XA[3]}" "$X^{tree}" -p "$C1" -m "$X_MSG") || _REBUILD_FAILED "$X"
	PRINT_CMD "git commit-tree ... -> ${C1:0:7} + ${C2:0:7} # split ${X:0:7}"

	# The remainder carries the split commit's own message and full tree, so it
	# is where anything keyed to the original belongs – not the extracted half
	_RECORD_REWRITE "$X" "$C2"

	# Rebuild descendants on top of the remainder commit
	PREV_OLD=$X
	PREV_NEW=$C2
	# From the branch's own tip – a split resumed with the checkout on another branch walked that
	_REBUILD_DESCENDANTS "$X" "$ORIG_HEAD"

	# A split authors an intermediate tree no commit ever carried, so it earns the gate as much
	# as any replay, even with the tip tree unchanged by construction – always in a throwaway
	# worktree, since the gate's failure path checks out over whatever it was handed. A
	# `--no-verify` split authors that tree too, and the guard below is skipped on exactly that
	# flag – so record the bypass ahead of it, where every other mode records it from the gate
	_VERIFY_NOTE_BYPASS
	if _VERIFY_CONFIGURED; then
		local VWT
		VWT=$(MKTEMP_DIR git-edit-verify) || exit 1
		_TEMP_WORKTREES+=("$VWT")
		if _WORKTREE_ADD "$VWT" "$PREV_NEW" quiet >/dev/null 2>&1; then
			_LINK_WORKTREE_EXTRAS "$VWT"
			local VERIFY_OK=true
			# The gate's own hints name a worktree removed two lines below and a resume that
			# re-derives the halves rather than applying this result – the refusal below is the
			# recourse here
			_VERIFY_NO_RESUME=true
			_VERIFY_REWRITE "$VWT" "$PREV_NEW" "$ORIG_HEAD" "$C1" || VERIFY_OK=false
			_VERIFY_NO_RESUME=false
			git worktree remove --force "$VWT" >/dev/null 2>&1
			rm -rf "$VWT"
			_TEMP_WORKTREES=(${_TEMP_WORKTREES:#$VWT})
			if [ "$VERIFY_OK" != "true" ]; then
				# No pause – a split's halves re-derive from its own worktree, so a refusal leaves the
				# authoring in place for another `--continue`
				PRINT_ERR "Verification failed at ${_VERIFY_FAILED:0:7} – the split was not applied"
				[ -n "$STATE_WORKTREE" ] && PRINT_TEXT "Fix it in %s, then 'git edit --continue' – or 'git edit --abort'." 33 "$STATE_WORKTREE"
				exit 1
			fi
		else
			rm -rf "$VWT"
			_TEMP_WORKTREES=(${_TEMP_WORKTREES:#$VWT})
			# Fail closed – an unverifiable split landing under an `ok` trailer reads as gated when
			# in fact nothing ever ran at all
			PRINT_ERR "Could not open a worktree to verify the split – not applied"
			if [ -n "$STATE_WORKTREE" ]; then
				PRINT_TEXT "Retry with 'git edit --continue', or apply unverified: %s" 33 "git edit --no-verify --continue"
			else
				PRINT_TEXT "Retry, or apply unverified with %s" 33 "--no-verify"
			fi
			exit 1
		fi
	fi

	# The remainder keeps the commit's full tree and descendants keep theirs, so the tip tree is
	# identical by construction – checked, as a rebuild that walked another history breaks it
	if [ "$(git rev-parse "$PREV_NEW^{tree}")" != "$(git rev-parse "$ORIG_HEAD^{tree}")" ]; then
		PRINT_ERR "The split's tip would differ from ${ORIG_HEAD:0:7}'s – not applied"
		exit 1
	fi

	# Atomic CAS ref update
	local CMD="git update-ref -m ${(q-)${:-git edit: split ${X:0:7}$_REFLOG_TAG}} ${(q-)REF} ${(q-)PREV_NEW} ${(q-)ORIG_HEAD}"
	PRINT_CMD "$CMD"
	if ! _MOVE_REF "$CMD"; then
		PRINT_ERR "Ref '$REF' moved during split – refusing to overwrite"
		PRINT_TEXT "Split history is at %s (not applied)." 33 "$PREV_NEW"
		exit 1
	fi
	_RECORD_REF_MOVE "$REF" "$ORIG_HEAD" "$PREV_NEW" "split ${X:0:7}"

	# Stated, checked above, so callers don't re-verify with a diff
	PRINT_TEXT "%s – split into:" 32 "Tip tree identical ✓"
	git show --no-color --stat --format='  %h %s' "$C1" | head -8 | _CARET_LINES | LC_ALL=C sed "/./!d;s/^/${_DIM}/;s/\$/${_OFF}/"
	git show --no-color --stat --format='  %h %s' "$C2" | head -8 | _CARET_LINES | LC_ALL=C sed "/./!d;s/^/${_DIM}/;s/\$/${_OFF}/"
	# Each half's stat has to stay under its own subject to say which files went
	# where, so the pair can't move below the block the way a fold's name does –
	# one line naming the commit that was split carries that into the tail instead
	_PRINT_COMMIT_LINE "$X" "  split: %h %s -> ${C1:0:7} + ${C2:0:7}"

	SPLIT_NEW_HEAD=$PREV_NEW
	SPLIT_REF=$REF
}

# Splits a commit by pathspec into two, plumbing only – an extracted commit carrying the
# matched changes with its message from `--text`, then one with the original message
# carrying the rest, trees composed directly so no conflict is possible
GIT_SPLIT () {
	local -a PATHSPECS
	PATHSPECS=("$@")
	local X=$SPLIT_TARGET

	# Capture the ref to update
	local ORIG_HEAD=$(git rev-parse HEAD)
	_REQUIRE_IN_TIP "$ORIG_HEAD" "$X"
	local BRANCH=${$(git symbolic-ref -q HEAD 2>/dev/null)#refs/heads/}
	local REF
	if [ -n "$BRANCH" ]; then
		REF="refs/heads/$BRANCH"
	else
		REF="HEAD"
	fi

	_SPLIT_GUARDS "$X"
	X=$_RESOLVED_SHA

	# The pathspec must match a nonempty, proper subset of the commit's changes
	local -a ALL_FILES MATCHED
	ALL_FILES=("${(@f)$(git diff-tree -r --name-only --no-commit-id "$X^" "$X")}")
	MATCHED=("${(@f)$(git diff-tree -r --name-only --no-commit-id "$X^" "$X" -- "${PATHSPECS[@]}")}")
	if [ -z "${MATCHED[1]}" ]; then
		PRINT_ERR "Pathspec matches no changes in ${X:0:7}"
		exit 1
	fi
	if [ ${#MATCHED[@]} -eq ${#ALL_FILES[@]} ]; then
		PRINT_ERR "Pathspec covers every change in ${X:0:7} – nothing to split off"
		if [ ${#ALL_FILES[@]} -eq 1 ]; then
			# One file means no pathspec can separate the halves – send them to
			# the form that authors the split point instead
			ECHO_E "\e[0;31m  It touches one file, so drop the pathspec and split by content:\e[0m" >&2
			ECHO_E "\e[0;31m    git edit --split=${X:0:7} --text \"First subject\"\e[0m" >&2
		else
			ECHO_E "\e[0;31m  Narrow the pathspec to the subset you want extracted.\e[0m" >&2
		fi
		exit 1
	fi

	# Extracted tree: the parent's tree with the matched paths at the commit's
	# versions, composed in a temp index from `diff-tree`'s exact blobs (no
	# patch application, so binary files and mode changes come along natively)
	local TMPIDX=$(MKTEMP_FILE git-edit-split-idx)
	rm -f "$TMPIDX"
	GIT_INDEX_FILE=$TMPIDX git read-tree "$X^" || { rm -f "$TMPIDX"; exit 1; }
	local META PATHNAME DSTMODE DSTSHA
	local -a RAW
	local -i I
	# NUL-separated, as the line form quotes a name holding a quote, backslash or control byte –
	# and that quoting became the name
	RAW=("${(@0)$(git diff-tree -z -r "$X^" "$X" -- "${PATHSPECS[@]}")}")
	for (( I = 1; I < ${#RAW[@]}; I += 2 )); do
		META=${RAW[I]} PATHNAME=${RAW[I+1]}
		[ -z "$META" ] && continue
		DSTMODE=$(print -r -- "$META" | awk '{print $2}')
		DSTSHA=$(print -r -- "$META" | awk '{print $4}')
		if [ "$DSTMODE" = "000000" ]; then
			GIT_INDEX_FILE=$TMPIDX git -C "$(git rev-parse --show-toplevel)" update-index --force-remove -- "$PATHNAME" || { rm -f "$TMPIDX"; exit 1; }
		else
			GIT_INDEX_FILE=$TMPIDX git update-index --add --cacheinfo "$DSTMODE,$DSTSHA,$PATHNAME" || { rm -f "$TMPIDX"; exit 1; }
		fi
	done
	local TREE1=$(GIT_INDEX_FILE=$TMPIDX git write-tree)
	rm -f "$TMPIDX"
	[ -z "$TREE1" ] && { PRINT_ERR "Failed to compose the extracted tree"; exit 1; }

	_SPLIT_APPLY "$X" "$TREE1" "$REF" "$ORIG_HEAD" "$TEXT_VALUE"
}

# Splits a commit whose halves share a file, where no pathspec can name them apart – hands
# back an isolated worktree holding the commit's content for the caller to edit down to
# the first commit's, the one hunk-level split describable without `git add -p`
GIT_SPLIT_PAUSE () {
	_REQUIRE_NO_INFLIGHT

	local BRANCH=${$(git symbolic-ref -q HEAD 2>/dev/null)#refs/heads/}
	if [ -z "$BRANCH" ]; then
		PRINT_ERR "Splitting by content requires being on a branch (got detached HEAD)"
		exit 1
	fi

	_SPLIT_GUARDS "$SPLIT_TARGET"
	local X=$_RESOLVED_SHA

	local WT
	WT=$(MKTEMP_DIR git-edit-split) || exit 1
	rmdir "$WT"  # `git worktree add` wants to create the dir itself
	# Until the pause is recorded, as a parallel run's may take the slot first
	_CLEANUP_HOOK="git worktree remove --force ${(q-)WT} 2>/dev/null; rm -rf ${(q-)WT}"
	_WORKTREE_ADD "$WT" "$X" quiet >/dev/null || { PRINT_ERR "Cannot create split worktree at ${X:0:7}"; exit 1; }
	_LINK_WORKTREE_EXTRAS "$WT"

	_SAVE_STATE "operation=split" "worktree=$WT" "branch=refs/heads/$BRANCH" \
		"orig_head=$(git rev-parse HEAD)" "target=$X" "maindir=$(git rev-parse --show-toplevel)"
	_CLEANUP_HOOK=""
	# A message given up front survives the pause in the sidecar
	if [ -n "$TEXT_VALUE" ]; then
		print -r -- "$TEXT_VALUE" > "$(_TEXT_MSG_PATH)"
	fi

	PRINT_ACTION "Splitting %s..." "$X"
	PRINT_TEXT "Worktree at the commit's own content: %s" 33 "$WT"
	PRINT_TEXT "Edit it back to what the %s commit should leave behind – undo there whatever belongs in the second:" 33 "first"
	git show --no-color --stat --format='' "$X" | _CARET_LINES | LC_ALL=C sed "/./!d;s/^/${_DIM}  /;s/\$/${_OFF}/"
	if [ -n "$TEXT_VALUE" ]; then
		PRINT_TEXT "Then %s – or cancel via %s." 33 "git edit --continue" "git edit --abort"
	else
		PRINT_TEXT "Then %s – or cancel via %s." 33 'git edit --continue --text "First subject"' "git edit --abort"
	fi
	_PRINT_SPLIT_KEEPS "$X"
	EMIT_PAUSED split "$X" "$WT"
	_PAUSE_EXIT 2 edit
}

# Names what a content split's second commit keeps – the remainder inherits a subject written
# for the whole change, so it usually wants a reword the caller would otherwise only notice
# later, and `-M --text` replaces the body along with it, so a body is named here, while the
# caller still reads the pause as "--text is the first commit's subject"
_PRINT_SPLIT_KEEPS () {
	# Args: <target>
	local BODY_LINES=$(git log -1 --format='%b' "$1" 2>/dev/null | grep -c .)
	if [ "$BODY_LINES" -gt 0 ]; then
		PRINT_TEXT "The second commit keeps %s's message, its %s-line body included – reword it afterwards with %s, restating the body lines that still hold." 33 "${1:0:7}" "$BODY_LINES" "git edit -M"
	else
		PRINT_TEXT "The second commit keeps %s's message – reword it afterwards with %s." 33 "${1:0:7}" "git edit -M"
	fi
}

# Resumes a paused content split – snapshot the authored worktree as the extracted commit's
# tree, then apply the pair, running from the main checkout so the descendant rebuild
# reads the branch as it stands and carries a commit that landed during the pause
_CONTINUE_SPLIT () {
	if [ ! -d "$STATE_WORKTREE" ]; then
		PRINT_ERR "Worktree no longer exists: $STATE_WORKTREE"
		_CLEAR_STATE
		exit 1
	fi
	cd "${STATE_MAINDIR:-.}" || exit 1

	local X=$STATE_TARGET
	PRINT_ACTION "Continuing split of %s..." "$X"

	# The authored tree rests on the target's parent, so a rewrite of the target
	# mid-pause would silently re-seat it on content it was never derived from
	if ! git merge-base --is-ancestor "$X" "$STATE_BRANCH" 2>/dev/null; then
		PRINT_ERR "Commit ${X:0:7} left the branch during the pause – the authored tree no longer rests on its parent"
		ECHO_E "\e[0;31m  Run 'git edit --abort' and redo the split against the current history.\e[0m" >&2
		exit 1
	fi

	local MSG=$TEXT_VALUE
	local MSGFILE=$(_TEXT_MSG_PATH)
	if [ -z "$MSG" ] && [ -f "$MSGFILE" ]; then
		MSG=$(cat "$MSGFILE")
	fi
	if [ -z "$MSG" ]; then
		PRINT_ERR "Pass --text with 'git edit --continue' – the extracted commit needs a message"
		exit 1
	fi

	# Snapshot the authored working tree through a temp index seeded from the
	# target – the worktree's own index stays as the caller left it, so a
	# refused continue doesn't quietly stage their mistake for the next one
	local TMPIDX=$(MKTEMP_FILE git-edit-split-idx)
	rm -f "$TMPIDX"
	_PRINT_UNTRACKED_ABSORB "$STATE_WORKTREE"
	local TREE1=""
	if GIT_INDEX_FILE=$TMPIDX git -C "$STATE_WORKTREE" read-tree "$X" 2>/dev/null; then
		GIT_INDEX_FILE=$TMPIDX git -C "$STATE_WORKTREE" add -A >/dev/null 2>&1
		TREE1=$(GIT_INDEX_FILE=$TMPIDX git -C "$STATE_WORKTREE" write-tree)
	fi
	rm -f "$TMPIDX"
	if [ -z "$TREE1" ]; then
		PRINT_ERR "Failed to read the authored tree from $STATE_WORKTREE"
		exit 1
	fi

	if [ "$TREE1" = "$(git rev-parse "$X^^{tree}")" ]; then
		PRINT_ERR "Worktree matches ${X:0:7}'s parent – the extracted commit would be empty"
		ECHO_E "\e[0;31m  Edit $(_LIT "$STATE_WORKTREE") to the state the first commit should leave, then retry.\e[0m" >&2
		exit 1
	fi
	if [ "$TREE1" = "$(git rev-parse "$X^{tree}")" ]; then
		PRINT_ERR "Worktree is unchanged from ${X:0:7} – the remainder commit would be empty"
		ECHO_E "\e[0;31m  Undo the parts belonging to the second commit in $(_LIT "$STATE_WORKTREE"), then retry.\e[0m" >&2
		exit 1
	fi

	# The pair always ends at the target's tree, so a path the target never
	# touched can only be reverted again by the remainder – stray worktree
	# debris rather than anything the caller means to commit
	local STRAY=$(comm -23 \
		<(git diff-tree -r --name-only "$X^^{tree}" "$TREE1" | sort) \
		<(git diff-tree -r --name-only "$X^^{tree}" "$X^{tree}" | sort))
	if [ -n "$STRAY" ]; then
		PRINT_ERR "Worktree changes paths ${X:0:7} never touched – the remainder would just revert them"
		print -r -- "$STRAY" | _CARET_LINES | LC_ALL=C sed "s/^/${_RED}  /;s/\$/${_OFF}/" >&2
		ECHO_E "\e[0;31m  Undo them in $(_LIT "$STATE_WORKTREE") (git checkout -- <path>, or rm for ones it added), then retry.\e[0m" >&2
		exit 1
	fi

	# So is a mode neither the target nor its parent carries – a file written anew into the
	# worktree comes back without its executable bit, and the remainder would flip it straight
	# back, a stray pair no diffstat shows; `--allow-mode-change` keeps it
	if [ ${#OPT_ALLOW_MODE_CHANGE} -eq 0 ]; then
		local -a MODE_STRAYS
		local MP M1 MB MX
		for MP in ${(0)"$(git diff-tree -r -z --name-only "$X^^{tree}" "$TREE1")"}; do
			[ -z "$MP" ] && continue
			M1=$(git ls-tree --full-tree "$TREE1" -- ":(literal)$MP" 2>/dev/null | cut -d' ' -f1)
			MB=$(git ls-tree --full-tree "$X^" -- ":(literal)$MP" 2>/dev/null | cut -d' ' -f1)
			MX=$(git ls-tree --full-tree "$X" -- ":(literal)$MP" 2>/dev/null | cut -d' ' -f1)
			if [ -n "$M1" ] && [ "$M1" != "$MB" ] && [ "$M1" != "$MX" ]; then
				MODE_STRAYS+=("$MP: authored $M1, ${X:0:7} carries ${MX:-none}, its parent ${MB:-none}")
			fi
		done
		if [ ${#MODE_STRAYS[@]} -gt 0 ]; then
			PRINT_ERR "Worktree changes a file mode neither ${X:0:7} nor its parent carries – a file written anew, without its executable bit?"
			printf '%s\n' "${MODE_STRAYS[@]}" | _CARET_LINES | LC_ALL=C sed "s/^/${_RED}  /;s/\$/${_OFF}/" >&2
			ECHO_E "\e[0;31m  chmod it in $(_LIT "$STATE_WORKTREE") to the mode a half should carry, then retry – or pass --allow-mode-change to keep it.\e[0m" >&2
			exit 1
		fi
	fi

	_CLEANUP_HOOK="git worktree remove --force ${(q-)STATE_WORKTREE} 2>/dev/null; rm -rf ${(q-)STATE_WORKTREE}"

	_SPLIT_APPLY "$X" "$TREE1" "$STATE_BRANCH" "$(git rev-parse "$STATE_BRANCH")" "$MSG"
	_CLEAR_STATE
	PRINT_COMPLETED "$SPLIT_NEW_HEAD" "$SPLIT_REF" true
}

_ABORT_SPLIT () {
	PRINT_ACTION "Aborting split of %s..." "${STATE_TARGET:0:7}"

	if [ -d "$STATE_WORKTREE" ]; then
		local CMD="git worktree remove --force ${(q-)STATE_WORKTREE} 2>/dev/null; rm -rf ${(q-)STATE_WORKTREE}"
		PRINT_CMD "$CMD" 90
		eval "$CMD"
	fi

	_CLEAR_STATE
	PRINT_TEXT "Branch was never touched – nothing to roll back." 32
	PRINT_TEXT "%s" 32 "Split aborted, state cleared."
	EMIT_STATUS "$STATE_ORIG_HEAD" "$STATE_BRANCH" false
}

# Names the commits a reorder's gate checks – each it put directly below one that came before it
# in the old order, matched by author and subject, which a replay keeps – a commit that needed one
# moved up fails until it reappears, and every such run of failures holds one of these
_REORDER_CHECKS () {
	# Args: <orig_head> <new_head>
	local ORIG=$1 NEW=$2 LINE KEY
	local -a HASHES=() KEYS=() CHECKS=()
	for LINE in ${(f)"$(git log --reverse --format='%H%x1f%ae%x1f%at%x1f%s' "$ORIG..$NEW" 2>/dev/null)"}; do
		HASHES+=("${LINE%%$'\x1f'*}")
		KEYS+=("${LINE#*$'\x1f'}")
	done
	# Each original's place, oldest first – 0 where two share a key, which places neither
	local -A WAS=()
	local -i I=0
	for KEY in ${(f)"$(git log --reverse --format='%ae%x1f%at%x1f%s' "$NEW..$ORIG" 2>/dev/null)"}; do
		I+=1
		(( ${+WAS[$KEY]} )) && WAS[$KEY]=0 || WAS[$KEY]=$I
	done
	local -A NOW=()
	for KEY in "${KEYS[@]}"; do
		NOW[$KEY]=$(( ${NOW[$KEY]:-0} + 1 ))
	done
	local -a POS=()
	for KEY in "${KEYS[@]}"; do
		[ ${NOW[$KEY]} -eq 1 ] && POS+=(${WAS[$KEY]:-0}) || POS+=(0)
	done
	# One it cannot place counts as out of order, so it can only add a check
	for (( I = 1; I < ${#HASHES[@]}; I++ )); do
		(( POS[I] == 0 || POS[I+1] == 0 || POS[I] > POS[I+1] )) && CHECKS+=("${HASHES[$I]}")
	done
	print -r -- "${CHECKS[*]}"
}

# Reorders a contiguous span, the positional args giving the new order oldest-first – runs
# the rebase in an isolated temp worktree under a scripted `GIT_SEQUENCE_EDITOR`, reusing
# the conflict pause machinery, and the branch ref only moves at the end
GIT_REORDER () {
	# Pre-flight: must not be a stale in-flight operation
	_REQUIRE_NO_INFLIGHT

	# Pre-flight: must be on a branch
	local ORIG_BRANCH=${$(git symbolic-ref -q HEAD 2>/dev/null)#refs/heads/}
	if [ -z "$ORIG_BRANCH" ]; then
		PRINT_ERR "${${OPT_MOVE:+--move}:---reorder} requires being on a branch (got detached HEAD)"
		exit 1
	fi
	local REF="refs/heads/$ORIG_BRANCH"
	local ORIG_HEAD=$(git rev-parse HEAD)
	_REQUIRE_IN_TIP "$ORIG_HEAD" "${COMMITS[@]}"

	if [ ${#COMMITS_DESIRED[@]} -lt 2 ]; then
		PRINT_ERR "--reorder needs at least two commits (in the desired new order)"
		exit 1
	fi

	# All commits must be distinct
	local UNIQUE_COUNT=$(printf '%s\n' "${COMMITS[@]}" | sort -u | wc -l | tr -d ' ')
	if [ "$UNIQUE_COUNT" -ne ${#COMMITS[@]} ]; then
		PRINT_ERR "--reorder arguments must be distinct commits"
		exit 1
	fi

	# No-op if the desired order matches the current order
	local SAME=true
	local i
	for (( i=1; i<=${#COMMITS[@]}; i++ )); do
		[ "${COMMITS[$i]}" != "${COMMITS_DESIRED[$i]}" ] && SAME=false
	done
	if [ "$SAME" = "true" ]; then
		PRINT_TEXT "%s" 33 "Desired order matches the current order – nothing to do."
		EMIT_STATUS "$ORIG_HEAD" "$REF" false
		exit 0
	fi

	# Contiguity: the span oldest..newest must equal the selection exactly
	local OLDEST=${COMMITS[1]}
	local NEWEST=${COMMITS[-1]}
	if ! git merge-base --is-ancestor "$NEWEST" HEAD 2>/dev/null; then
		PRINT_ERR "Commit ${NEWEST:0:7} is not reachable from HEAD"
		exit 1
	fi
	local EXPECTED
	if git rev-parse --verify "$OLDEST^" >/dev/null 2>&1; then
		EXPECTED=($(git rev-list --reverse "$OLDEST^..$NEWEST"))
	else
		EXPECTED=($(git rev-list --reverse "$NEWEST"))
	fi
	if [ ${#EXPECTED[@]} -ne ${#COMMITS[@]} ]; then
		PRINT_ERR "--reorder requires a contiguous span of commits"
		ECHO_E "\e[0;31m  Selected ${#COMMITS[@]}; range ${OLDEST:0:7}..${NEWEST:0:7} contains ${#EXPECTED[@]}.\e[0m" >&2
		exit 1
	fi
	for (( i=1; i<=${#COMMITS[@]}; i++ )); do
		if [ "${COMMITS[$i]}" != "${EXPECTED[$i]}" ]; then
			PRINT_ERR "--reorder requires a contiguous span of commits"
			exit 1
		fi
	done

	# No merge commits in the span
	local C P_LIST
	for C in "${COMMITS[@]}"; do
		P_LIST=$(git log -1 --format='%P' "$C")
		if [[ "$P_LIST" == *" "* ]]; then
			PRINT_ERR "--reorder cannot handle merge commit ${C:0:7}"
			exit 1
		fi
	done

	_GUARD_UNPUSHED "$OLDEST"
	_GUARD_NO_MERGE_SPAN "$OLDEST"

	# Rebase base (parent of the oldest, or --root for the initial commit)
	local REBASE_BASE
	if git rev-parse --verify "$OLDEST^" >/dev/null 2>&1; then
		REBASE_BASE="$OLDEST^"
	else
		REBASE_BASE="--root"
	fi
	# Total todo length, for the completion summary's log span
	local TOTAL
	if [ "$REBASE_BASE" = "--root" ]; then
		TOTAL=$(git rev-list --count HEAD)
	else
		TOTAL=$(git rev-list --count "$REBASE_BASE..HEAD")
	fi

	# Isolated worktree at the current tip
	local WT
	WT=$(MKTEMP_DIR git-edit-reorder) || exit 1
	rmdir "$WT"
	_CLEANUP_HOOK="git worktree remove --force ${(q-)WT} 2>/dev/null; rm -rf ${(q-)WT}"
	_WORKTREE_ADD "$WT" "$ORIG_HEAD" quiet || exit 1
	_LINK_WORKTREE_EXTRAS "$WT"
	cd "$WT" || exit 1

	# Scripted sequence editor – drop the span's `pick` lines and re-emit them at the first
	# one's position in the desired order, matching the todo's abbreviated SHAs as prefixes
	# of our full ones, with the order traveling by env so the script needs no interpolation.
	# Under `sh`, like the other editors written for git – as a zsh script it would start a
	# zsh of its own, which reads the caller's `.zshenv` past the `emulate` at the top
	local SEQ=$(MKTEMP_FILE git-edit-reorder-seq)
	cat > "$SEQ" <<'SEQEOF'
#!/bin/sh
awk -v order="$GIT_EDIT_REORDER_ORDER" '
	BEGIN { n = split(order, O, " ") }
	/^pick / {
		member = 0
		for (i = 1; i <= n; i++) {
			if (index(O[i], $2) == 1) { member = 1; break }
		}
		if (member) {
			if (!done) {
				for (i = 1; i <= n; i++) print "pick", O[i]
				done = 1
			}
			next
		}
	}
	{ print }
' "$1" > "$1.new" && mv "$1.new" "$1"
SEQEOF
	chmod +x "$SEQ"

	_CAPTURE_BEGIN
	local REBASE_CMD="GIT_EDIT_REORDER_ORDER='${COMMITS_DESIRED[*]}' GIT_SEQUENCE_EDITOR=${(q-)SEQ} GIT_EDITOR=true git -c rerere.enabled=true -c rerere.autoUpdate=false -c rebase.updateRefs=false -c rebase.instructionFormat= $_CAPTURE_PINS rebase $_CAPTURE_EXEC --no-autosquash --no-autostash --interactive $REBASE_BASE"
	PRINT_CMD "GIT_SEQUENCE_EDITOR=<reorder script> git rebase --interactive $REBASE_BASE" 90
	_RERERE_SCOPE_BEGIN
	if ! eval "$REBASE_CMD" >/dev/null 2>&1 && \
	   ! { _AUTO_RESOLVE_FINAL_STEP "$WT" "$ORIG_HEAD" && _FINISH_AUTO_RESOLVED_STEP "$WT" "pre-op" }; then
		rm -f "$SEQ"
		# Conflict while replaying – persist state for --continue/--abort
		# The branch was never moved, so --abort has nothing to roll back
		_SAVE_STATE \
			"operation=reorder" \
			"worktree=$WT" \
			"branch=$REF" \
			"orig_head=$ORIG_HEAD" \
			"target=$OLDEST"
		_CLEANUP_HOOK=""

		PRINT_ERR "Conflict while reordering – resolve in worktree, then 'git edit --continue'"
		PRINT_TEXT "Worktree: %s" 33 "$WT"
		local UNMERGED_LIST=$(_PRINT_CONFLICT_DETAIL "$WT" "$ORIG_HEAD")
		PRINT_TEXT "Or abort the operation: %s" 33 "git edit --abort"
		EMIT_CONFLICT "$WT" "$UNMERGED_LIST"
		_PAUSE_EXIT 2 conflict
	fi
	rm -f "$SEQ"

	local NEW_HEAD=$(git rev-parse HEAD)

	if ! _GUARD_TIP_MODES "$WT" "$NEW_HEAD" "$ORIG_HEAD" || ! _VERIFY_REWRITE "$WT" "$NEW_HEAD" "$ORIG_HEAD" "$(_REORDER_CHECKS "$ORIG_HEAD" "$NEW_HEAD")"; then
		_SAVE_STATE \
			"operation=reorder" \
			"worktree=$WT" \
			"branch=$REF" \
			"orig_head=$ORIG_HEAD" \
			"target=$OLDEST"
		_CLEANUP_HOOK=""
		EMIT_GATE_PAUSED "$WT" "$NEW_HEAD"
		_PAUSE_EXIT 2 gate
	fi

	# Atomic CAS-update, guarded on the pre-op tip
	local UPDATE_CMD="git update-ref -m ${(q-)${:-git edit: reorder ${OLDEST:0:7}..${NEWEST:0:7}$_REFLOG_TAG}} ${(q-)REF} ${(q-)NEW_HEAD} ${(q-)ORIG_HEAD}"
	PRINT_CMD "$UPDATE_CMD" 90
	if ! _MOVE_REF "$UPDATE_CMD"; then
		PRINT_ERR "Branch '$REF' moved during reorder – refusing to overwrite"
		PRINT_TEXT "Reordered history is at %s (not applied)." 33 "$NEW_HEAD"
		exit 1
	fi
	_RECORD_REF_MOVE "$REF" "$ORIG_HEAD" "$NEW_HEAD" "reorder ${OLDEST:0:7}..${NEWEST:0:7}"

	# Completion summary – tree identity, which a clean reorder preserves and a resolution may
	# not, plus the rewritten span in its new order
	_PRINT_REORDER_SUMMARY "$ORIG_HEAD" "$NEW_HEAD"

	REORDER_NEW_HEAD=$NEW_HEAD
	REORDER_REF=$REF
}

# Resumes an in-flight `--reorder` after resolution, mirroring `_CONTINUE_AMEND_INTO` –
# continue the rebase in the preserved worktree, then CAS the branch from its pre-op tip
# A reorder's final step resolves to the pre-op tip's blobs, a fold's to the fixup's
_AUTO_RESOLVE_FINAL_STEP () {
	# Args: <worktree> <result tree-ish – pre-op head (reorder) or staged tree (fold)>
	#       [<guard-empty – decline when the resolution would empty the commit>]
	local WT=$1
	local SOURCE=$2
	local GUARD_EMPTY=$3
	local -x GIT_LITERAL_PATHSPECS=1
	[ -z "$SOURCE" ] && return 1
	local GITDIR=$(git -C "$WT" rev-parse --absolute-git-dir 2>/dev/null)
	[ -z "$GITDIR" ] && return 1
	local -a STEPS=(${=$(_REBASE_STEP "$GITDIR")})
	if [ "${STEPS[1]:-0}" -eq 0 ] || [ "${STEPS[1]}" != "${STEPS[2]}" ]; then
		return 1
	fi
	# A result tree matching the stopped rebase's `HEAD` leaves the final commit empty and the
	# rebase drops it – for a reorder that change was absorbed by the new order, tree identity
	# proving no loss, while for a fold it would be overwritten outright, so decline first
	if [ -n "$GUARD_EMPTY" ] && \
	   [ "$(git rev-parse "$SOURCE^{tree}" 2>/dev/null)" = "$(git -C "$WT" rev-parse 'HEAD^{tree}' 2>/dev/null)" ]; then
		return 1
	fi
	local -a UNMERGED
	UNMERGED=(${(0)"$(git -C "$WT" diff -z --name-only --diff-filter=U 2>/dev/null)"})
	[ -z "${UNMERGED[1]}" ] && return 1
	# Prove the identity on a scratch copy of the index first – staging the
	# restores before knowing left a declined pause spoofing an empty step
	# (conflict cleared, source blobs staged) with the real markers destroyed
	local PROBE=$GITDIR/git-edit-probe-index
	cp "$GITDIR/index" "$PROBE" 2>/dev/null || return 1
	local P ENTRY
	local -a FIELDS
	for P in "${UNMERGED[@]}"; do
		ENTRY=$(git -C "$WT" ls-tree "$SOURCE" -- "$P" 2>/dev/null)
		FIELDS=(${=ENTRY})
		# Absent in the result (e.g. resolved by deletion) – not reproducible here
		if [ "${FIELDS[2]}" != "blob" ] || \
		   ! GIT_INDEX_FILE=$PROBE git -C "$WT" update-index --cacheinfo "${FIELDS[1]}" "${FIELDS[3]}" "$P" >/dev/null 2>&1; then
			rm -f "$PROBE"
			return 1
		fi
	done
	local CANDIDATE_TREE=$(GIT_INDEX_FILE=$PROBE git -C "$WT" write-tree 2>/dev/null)
	rm -f "$PROBE"
	if [ -z "$CANDIDATE_TREE" ] || [ "$CANDIDATE_TREE" != "$(git rev-parse "$SOURCE^{tree}" 2>/dev/null)" ]; then
		return 1
	fi
	# Proven – stage for real
	for P in "${UNMERGED[@]}"; do
		git -C "$WT" checkout "$SOURCE" -- "$P" >/dev/null 2>&1 || return 1
		git -C "$WT" add -- "$P" >/dev/null 2>&1 || return 1
	done
	# The proof: on the last step the staged tree is the result
	local RESULT_TREE=$(git -C "$WT" write-tree 2>/dev/null)
	[ -n "$RESULT_TREE" ] && [ "$RESULT_TREE" = "$(git rev-parse "$SOURCE^{tree}" 2>/dev/null)" ]
}

# Finishes a rebase whose final step `_AUTO_RESOLVE_FINAL_STEP()` just staged
_FINISH_AUTO_RESOLVED_STEP () {
	# Args: <worktree> <blob source name – "pre-op" or "staged">
	local WT=$1
	local OUTPUT RC # Needs to be separate for `$?` to work properly
	# C locale – the captured evidence should read in English, not the
	# machine's language (homebrew git localizes on an empty locale env)
	_RESUME_EDITOR "$WT"
	OUTPUT=$( export LC_ALL=C; GIT_SEQUENCE_EDITOR=true GIT_EDITOR=$REPLY git -C "$WT" -c commit.cleanup=whitespace -c rerere.enabled=true -c rerere.autoUpdate=false -c rebase.updateRefs=false "${_CAPTURE_PIN_ARGS[@]}" rebase --continue 2>&1 )
	RC=$?
	if [ $RC -eq 0 ]; then
		PRINT_TEXT "%s – restored the %s blobs and continued." 32 "Final step auto-resolved (staged tree proven identical)" "$2"
	else
		# The success line waits for the continue – and a failure surfaces the
		# discarded evidence instead of masquerading as one more conflict
		PRINT_TEXT "%s – restored the %s blobs, yet its continue failed:" 31 "Final step auto-resolved (staged tree proven identical)" "$2"
		print -r -- "$OUTPUT" | tail -5 | _CARET_LINES --crlf | LC_ALL=C sed 's/^/  /' >&2
	fi
	return $RC
}

# Prints the completion summary for both reorder paths – tree identity, the span in its new order
# oldest-first as `--reorder` takes its arguments, and a count check that matters most
# after a hand-resolved conflict, since an emptied commit is dropped silently otherwise
_PRINT_REORDER_SUMMARY () {
	# Args: <orig-head> <new-head>
	local BASE=$(git merge-base "$1" "$2" 2>/dev/null)
	local BEFORE=$(git rev-list --count "$BASE..$1" 2>/dev/null)
	local AFTER=$(git rev-list --count "$BASE..$2" 2>/dev/null)
	if git diff --quiet "$1" "$2" 2>/dev/null; then
		PRINT_TEXT "%s – new order (oldest-first):" 32 "Tip tree identical ✓"
	else
		PRINT_TEXT "%s" 33 "Note: tip tree differs from before (conflict resolutions changed content) – new order (oldest-first):"
	fi
	_PRINT_MODE_CHANGES "$1" "$2"
	git log --reverse --format='  %h %s' -"${AFTER:-12}" "$2" | head -12 | _CARET_LINES | LC_ALL=C sed "/./!d;s/^/${_DIM}/;s/\$/${_OFF}/"
	_PRINT_DROPPED_COMMITS "$1" "$2"
}

# Resolves where `$1`, a branch tip, left `$2`, the upstream – a rewritten upstream orphans
# the fork commit and plain `merge-base` then answers a far older ancestor, so
# `--fork-point` reads the reflog, falling back where a fresh clone leaves it nothing
_ONTO_FORK_POINT () {
	local BRANCH_TIP=$1
	local UPSTREAM=$2
	# Returns through `$_ONTO_FORK` / `$_ONTO_FORK_GUESSED` rather than stdout:
	# a command substitution would run this in a subshell, and the caller needs
	# to know whether the reflog answered, not just what the answer was
	_ONTO_FORK_GUESSED=false
	_ONTO_FORK=$(git merge-base --fork-point "$UPSTREAM" "$BRANCH_TIP" 2>/dev/null)
	if [ -z "$_ONTO_FORK" ]; then
		_ONTO_FORK=$(git merge-base "$UPSTREAM" "$BRANCH_TIP" 2>/dev/null)
		_ONTO_FORK_GUESSED=true
	fi
}

# Replays the current branch onto `$ONTO_UPSTREAM`, deriving the fork point rather than
# taking it as an argument – automates the rebase-onto-a-rewritten-main sequence: find the
# fork, report what each side carries, replay in an isolated worktree, CAS the branch
GIT_ONTO () {
	_REQUIRE_NO_INFLIGHT

	local ORIG_BRANCH=${$(git symbolic-ref -q HEAD 2>/dev/null)#refs/heads/}
	if [ -z "$ORIG_BRANCH" ]; then
		PRINT_ERR "--onto requires being on a branch (got detached HEAD)"
		exit 1
	fi
	local REF="refs/heads/$ORIG_BRANCH"
	local ORIG_HEAD=$(git rev-parse HEAD)
	# Captured before the cd into the temp worktree – the replant changes what
	# this checkout should hold, so it has to be brought along afterwards
	local MAIN_DIR=$(git rev-parse --show-toplevel)

	if ! git rev-parse --quiet --verify "$ONTO_UPSTREAM^{commit}" >/dev/null 2>&1; then
		PRINT_ERR "Unknown upstream: $ONTO_UPSTREAM"
		exit 1
	fi
	local UPSTREAM_FULL=$(git rev-parse "$ONTO_UPSTREAM^{commit}")
	if [ "$UPSTREAM_FULL" = "$ORIG_HEAD" ]; then
		PRINT_ERR "--onto target is the branch itself – name the branch to replant onto"
		exit 1
	fi

	_ONTO_FORK_POINT "$ORIG_HEAD" "$ONTO_UPSTREAM"
	local FORK=$_ONTO_FORK
	if [ -z "$FORK" ]; then
		PRINT_ERR "No common ancestor between '$ORIG_BRANCH' and '$ONTO_UPSTREAM' – nothing to replay from"
		exit 1
	fi

	# Already replanted: the upstream tip is the fork, so there is nothing to move
	if [ "$(git rev-parse "$FORK")" = "$UPSTREAM_FULL" ]; then
		PRINT_TEXT "%s" 33 "Already on top of $ONTO_UPSTREAM – nothing to replay."
		EMIT_STATUS "$ORIG_HEAD" "$REF" false
		exit 0
	fi

	local -a SPAN
	SPAN=("${(@f)$(git rev-list --reverse "$FORK..$ORIG_HEAD" 2>/dev/null)}")
	if [ -z "${SPAN[1]}" ]; then
		PRINT_TEXT "%s" 33 "Branch '$ORIG_BRANCH' carries no commits past the fork – nothing to replay."
		EMIT_STATUS "$ORIG_HEAD" "$REF" false
		exit 0
	fi

	# The replay rewrites every commit in the span, so the same guards the
	# other rewriting modes apply hold here – anchored on the oldest, which
	# covers the rest since no descendant of an unpushed commit is pushed
	_GUARD_UNPUSHED "${SPAN[1]}"
	_GUARD_NO_MERGE_SPAN "${SPAN[1]}"
	_GUARD_ONTO_CHECKOUT_CLEAN "$MAIN_DIR" "$ORIG_HEAD" "$UPSTREAM_FULL" "$REF"

	PRINT_ACTION "Replanting %s onto %s..." "$ORIG_BRANCH" "$ONTO_UPSTREAM"
	# Whether the old base still sits on the upstream decides how surprising
	# this is – an orphaned one means the upstream was rewritten underneath
	if [ "$_ONTO_FORK_GUESSED" = "true" ]; then
		# The reflog is what makes the fork point exact – without it this is the last common
		# ancestor, which after a content-changing rewrite of the upstream sits well below the
		# real fork, so the span takes in commits the upstream has in a form patch ids miss
		PRINT_TEXT "%s could not answer from %s's reflog – using the merge base %s." 33 \
			"Fork point" "$ONTO_UPSTREAM" "$(git log -1 --format='%h %s' "$FORK")"
		PRINT_TEXT "If %s was rewritten, this span may be too wide – check the list below before continuing." 33 "$ONTO_UPSTREAM"
	elif git merge-base --is-ancestor "$FORK" "$UPSTREAM_FULL" 2>/dev/null; then
		PRINT_TEXT "Fork point %s is still on %s." 32 "$(git log -1 --format='%h %s' "$FORK")" "$ONTO_UPSTREAM"
	else
		PRINT_TEXT "Fork point %s was orphaned by a rewrite – recovered from the reflog." 33 \
			"$(git log -1 --format='%h %s' "$FORK")"
	fi
	local GAINED=$(git rev-list --count "$FORK..$UPSTREAM_FULL" 2>/dev/null)
	PRINT_TEXT "%s gained %s commit(s); replaying %s from '%s' on top:" 32 \
		"$ONTO_UPSTREAM" "${GAINED:-0}" "${#SPAN[@]}" "$ORIG_BRANCH"
	_PRINT_ONTO_TRIAGE "$UPSTREAM_FULL" "$ORIG_HEAD" "$FORK"

	local WT
	WT=$(MKTEMP_DIR git-edit-onto) || exit 1
	rmdir "$WT"
	_CLEANUP_HOOK="git worktree remove --force ${(q-)WT} 2>/dev/null; rm -rf ${(q-)WT}"
	_WORKTREE_ADD "$WT" "$ORIG_HEAD" quiet || exit 1
	_LINK_WORKTREE_EXTRAS "$WT"
	cd "$WT" || exit 1

	_CAPTURE_BEGIN
	# Detached, so the branch ref stays put until the CAS – and the branch can
	# stay checked out in whatever worktree the caller is using
	local REBASE_CMD="GIT_SEQUENCE_EDITOR=true GIT_EDITOR=true git -c rerere.enabled=true -c rerere.autoUpdate=false -c rebase.updateRefs=false -c rebase.instructionFormat= $_CAPTURE_PINS rebase $_CAPTURE_EXEC --no-autosquash --no-autostash --empty=drop --onto $UPSTREAM_FULL $FORK"
	PRINT_CMD "$REBASE_CMD" 90
	_RERERE_SCOPE_BEGIN
	if ! eval "$REBASE_CMD" >/dev/null 2>&1; then
		# The upstream's name and the span size are only known here – without
		# them the resumed run reports the replant against a bare SHA and a
		# count that trivially matches itself
		_SAVE_STATE \
			"operation=onto" \
			"worktree=$WT" \
			"branch=$REF" \
			"orig_head=$ORIG_HEAD" \
			"target=$UPSTREAM_FULL" \
			"upstream=$ONTO_UPSTREAM" \
			"span=${#SPAN[@]}" \
			"fork=$FORK" \
			"maindir=$MAIN_DIR"
		_CLEANUP_HOOK=""

		PRINT_ERR "Conflict while replanting – resolve in worktree, then 'git edit --continue'"
		PRINT_TEXT "Worktree: %s" 33 "$WT"
		local UNMERGED_LIST=$(_PRINT_CONFLICT_DETAIL "$WT")
		_PRINT_ONTO_SKIP_HINT "$WT" "$UPSTREAM_FULL"
		PRINT_TEXT "Or abort the operation: %s" 33 "git edit --abort"
		EMIT_CONFLICT "$WT" "$UNMERGED_LIST"
		_PAUSE_EXIT 2 conflict
	fi

	local NEW_HEAD=$(git rev-parse HEAD)

	if ! _VERIFY_REWRITE "$WT" "$NEW_HEAD" "$ORIG_HEAD" "" "$UPSTREAM_FULL"; then
		_SAVE_STATE \
			"operation=onto" \
			"worktree=$WT" \
			"branch=$REF" \
			"orig_head=$ORIG_HEAD" \
			"target=$UPSTREAM_FULL" \
			"upstream=$ONTO_UPSTREAM" \
			"span=${#SPAN[@]}" \
			"fork=$FORK" \
			"maindir=$MAIN_DIR"
		_CLEANUP_HOOK=""
		EMIT_VERIFY_PAUSED "$_VERIFY_FAILED" "$WT" "$NEW_HEAD"
		_PAUSE_EXIT 2 gate
	fi

	local UPDATE_CMD="git update-ref -m ${(q-)${:-git edit: onto ${UPSTREAM_FULL:0:7}$_REFLOG_TAG}} ${(q-)REF} ${(q-)NEW_HEAD} ${(q-)ORIG_HEAD}"
	PRINT_CMD "$UPDATE_CMD" 90
	if ! _MOVE_REF "$UPDATE_CMD"; then
		PRINT_ERR "Branch '$REF' moved during replant – refusing to overwrite"
		PRINT_TEXT "Replanted history is at %s (not applied)." 33 "$NEW_HEAD"
		exit 1
	fi
	_RECORD_REF_MOVE "$REF" "$ORIG_HEAD" "$NEW_HEAD" "onto ${UPSTREAM_FULL:0:7}"
	_SYNC_ONTO_CHECKOUT "$MAIN_DIR" "$ORIG_HEAD" "$NEW_HEAD" "$REF"

	_PRINT_ONTO_SUMMARY "$UPSTREAM_FULL" "$NEW_HEAD" "${#SPAN[@]}" "$ORIG_HEAD" "$FORK"

	ONTO_NEW_HEAD=$NEW_HEAD
	ONTO_REF=$REF
}

# Splits the span into what the upstream already carries and what is genuinely
# this branch's, using patch ids – the rebase drops the former silently, and a
# caller who doesn't know that reads the shorter result as lost work
_PRINT_ONTO_TRIAGE () {
	local UPSTREAM=$1
	local TIP=$2
	local FORK=$3
	local -a UNIQUE DUPLICATE
	local LINE
	while IFS= read -r LINE; do
		[ -z "$LINE" ] && continue
		if [[ "$LINE" == "+ "* ]]; then
			UNIQUE+=("${LINE#+ }")
		else
			DUPLICATE+=("${LINE#- }")
		fi
	done < <(git cherry "$UPSTREAM" "$TIP" "$FORK" 2>/dev/null)

	local C
	for C in "${UNIQUE[@]}"; do
		git log -1 --format='  %h %s' "$C" 2>/dev/null | _CARET_LINES | LC_ALL=C sed "/./!d;s/^/${_DIM}/;s/\$/${_OFF}/"
	done
	if [ ${#DUPLICATE[@]} -gt 0 ]; then
		PRINT_TEXT "%s commit(s) are already on %s and will be dropped:" 33 "${#DUPLICATE[@]}" "$ONTO_UPSTREAM"
		for C in "${DUPLICATE[@]}"; do
			git log -1 --format='  %h %s' "$C" 2>/dev/null | _CARET_LINES | LC_ALL=C sed "/./!d;s/^/${_DIM}/;s/\$/${_OFF}/"
		done
	fi
}

# Names the skip a replant wants – a conflict on a commit the upstream carries another way
# case where skipping is the answer rather than a merge – say so, since the
# generic "resolve it" advice produces a duplicate commit instead
_PRINT_ONTO_SKIP_HINT () {
	local WT=$1
	local UPSTREAM=$2
	local GITDIR=$(git -C "$WT" rev-parse --git-dir 2>/dev/null)
	local STOPPED=$(cat "$GITDIR/rebase-merge/stopped-sha" 2>/dev/null)
	[ -z "$STOPPED" ] && return 0
	# `git cherry` compares patch ids, so an upstream that took the same change
	# via a different commit still matches
	local VERDICT=$(git cherry "$UPSTREAM" "$STOPPED" "$STOPPED^" 2>/dev/null | head -1)
	if [[ "$VERDICT" == "- "* ]]; then
		PRINT_TEXT "%s is already on %s in another form – %s is likely right here." 33 \
			"$(git log -1 --format='%h %s' "$STOPPED" 2>/dev/null)" "$ONTO_UPSTREAM" "git edit --skip"
	fi
}

# Refuses before anything moves where the checkout holds uncommitted work on a path the
# replant would rewrite – the sync afterwards declines to overwrite it, correctly, but
# only once the branch had moved, leaving the ref and the files disagreeing
_GUARD_ONTO_CHECKOUT_CLEAN () {
	# Args: <checkout> <from> <upstream> [<branch ref>]
	local DIR=$1
	local FROM=$2
	local UPSTREAM=$3
	[ -z "$DIR" ] || [ ! -d "$DIR" ] && return 0
	# A checkout on another branch is not the replant's to update
	[ -n "$4" ] && [ "$(git -C "$DIR" symbolic-ref -q HEAD 2>/dev/null)" != "$4" ] && return 0

	local -a AFFECTED DIRTY BLOCKED
	AFFECTED=("${(@f)$(git -C "$DIR" diff --ignore-submodules=dirty --no-renames --name-only "$FROM" "$UPSTREAM" 2>/dev/null)}")
	[ -z "${AFFECTED[1]}" ] && return 0
	# Unstaged, staged, and untracked all block a two-way merge onto that path
	DIRTY=("${(@f)$(
		git -C "$DIR" diff --ignore-submodules=dirty --name-only 2>/dev/null
		git -C "$DIR" diff --ignore-submodules=dirty --cached --name-only 2>/dev/null
		git -C "$DIR" ls-files --others --exclude-standard 2>/dev/null
	)}")
	[ -z "${DIRTY[1]}" ] && return 0

	local A D
	for A in "${AFFECTED[@]}"; do
		[ -z "$A" ] && continue
		for D in "${DIRTY[@]}"; do
			[ "$A" = "$D" ] && BLOCKED+=("$A")
		done
	done
	[ ${#BLOCKED[@]} -eq 0 ] && return 0

	PRINT_ERR "Uncommitted work sits on ${#BLOCKED[@]} path(s) the replant rewrites – refusing to strand the checkout"
	printf '%s\n' "${(@u)BLOCKED}" | head -10 | _CARET_LINES | LC_ALL=C sed "/./!d;s/^/${_RED}  /;s/\$/${_OFF}/" >&2
	ECHO_E "\e[0;31m  Commit, stash, or move them, then retry – nothing was changed.\e[0m" >&2
	exit 1
}

# Brings the caller's checkout along after the branch it is on was replanted – the other
# isolated modes skip this since a reorder preserves the tree, and leaving a replant
# behind makes every commit the upstream gained read as a local deletion
_SYNC_ONTO_CHECKOUT () {
	# Args: <checkout> <from> <to> [<branch ref>]
	local DIR=$1
	local FROM=$2
	local TO=$3
	[ -z "$DIR" ] || [ ! -d "$DIR" ] && return 0
	if [ -n "$4" ] && [ "$(git -C "$DIR" symbolic-ref -q HEAD 2>/dev/null)" != "$4" ]; then
		PRINT_TEXT "%s – left as it is." 32 "The checkout holds another branch"
		return 0
	fi
	local ERR=$(git -C "$DIR" read-tree -u -m "$FROM" "$TO" 2>&1)
	if [ -z "$ERR" ]; then
		PRINT_TEXT "Checkout updated to the replanted branch." 32
	else
		# The branch has moved, so the checkout now disagrees with `HEAD` – but the paths that
		# blocked the update are the caller's uncommitted work, and naming them matters more than
		# a command, since the obvious `checkout -- .` discards what the refusal just protected
		local -a BLOCKED
		BLOCKED=("${(@f)$(printf '%s\n' "$ERR" | grep -o "'[^']*'" | tr -d "'" | sort -u)}")
		PRINT_TEXT "%s" 33 "Branch replanted, but the checkout could not follow – it still holds the pre-replant content."
		if [ -n "${BLOCKED[1]}" ]; then
			PRINT_TEXT "Blocked by uncommitted work in: %s" 33 "${(j:, :)BLOCKED}"
			PRINT_TEXT "Commit or move those, then: %s" 33 "git -C $(_SHQ "$DIR") read-tree -u -m ${FROM:0:12} ${TO:0:12}"
		else
			PRINT_TEXT "Reconcile once your uncommitted work is safe: %s" 33 "git -C $(_SHQ "$DIR") read-tree -u -m ${FROM:0:12} ${TO:0:12}"
		fi
	fi
}

# Prints what the replant produced, so the caller doesn't reach for `git log` next
_PRINT_ONTO_SUMMARY () {
	local UPSTREAM=$1
	local NEW_HEAD=$2
	local EXPECTED=$3
	local PREOP=$4
	local FORK=$5
	local LANDED=$(git rev-list --count "$UPSTREAM..$NEW_HEAD" 2>/dev/null)
	if [ -n "$EXPECTED" ]; then
		PRINT_TEXT "Replanted %s of %s commit(s) onto %s:" 32 "${LANDED:-0}" "$EXPECTED" "$ONTO_UPSTREAM"
	else
		PRINT_TEXT "Replanted %s commit(s) onto %s:" 32 "${LANDED:-0}" "$ONTO_UPSTREAM"
	fi
	git log --reverse --format='  %h %s' "$UPSTREAM..$NEW_HEAD" 2>/dev/null | head -12 | _CARET_LINES | \
		LC_ALL=C sed "/./!d;s/^/${_DIM}/;s/\$/${_OFF}/"

	# A shorter result reads as lost work unless the shortfall is accounted for, and its two
	# causes are not interchangeable – the rebase drops what the upstream already carries,
	# while a skip was the caller's call, so count duplicates from patch ids, not the gap
	[ -z "$LANDED" ] || [ -z "$EXPECTED" ] || [ "$LANDED" -ge "$EXPECTED" ] && return 0
	local DUPLICATES=0
	if [ -n "$PREOP" ] && [ -n "$FORK" ]; then
		DUPLICATES=$(git cherry "$UPSTREAM" "$PREOP" "$FORK" 2>/dev/null | grep -c '^-')
	fi
	local SKIPPED=$((EXPECTED - LANDED - DUPLICATES))
	if [ "$DUPLICATES" -gt 0 ]; then
		PRINT_TEXT "%s commit(s) were dropped as already upstream." 33 "$DUPLICATES"
	fi
	if [ "$SKIPPED" -gt 0 ]; then
		PRINT_TEXT "%s commit(s) were skipped." 33 "$SKIPPED"
	fi
}

_CONTINUE_ONTO () {
	if [ ! -d "$STATE_WORKTREE" ]; then
		PRINT_ERR "Worktree no longer exists: $STATE_WORKTREE"
		_CLEAR_STATE
		exit 1
	fi

	cd "$STATE_WORKTREE" || exit 1
	_CLEANUP_HOOK="git worktree remove --force ${(q-)STATE_WORKTREE} 2>/dev/null; rm -rf ${(q-)STATE_WORKTREE}"

	# Restore what the summary and the skip hint name the upstream by
	ONTO_UPSTREAM=${STATE_UPSTREAM:-${STATE_TARGET:0:7}}
	PRINT_ACTION "Continuing replant onto %s..." "$ONTO_UPSTREAM"

	local GITDIR=$(git rev-parse --git-dir 2>/dev/null)
	if [ ! -d "$GITDIR/rebase-merge" ] && [ ! -d "$GITDIR/rebase-apply" ]; then
		[ "$(git rev-parse HEAD)" = "$STATE_ORIG_HEAD" ] && _REFUSE_HAND_ABORT
		_REQUIRE_REPLAY_DONE "$STATE_WORKTREE"
		PRINT_TEXT "%s – applying its result." 33 "Replant already completed in worktree"
	else
		local CMD
		if [ ${#OPT_SKIP} -gt 0 ]; then
			CMD="GIT_SEQUENCE_EDITOR=true GIT_EDITOR=true git -c rerere.enabled=true -c rerere.autoUpdate=false -c rebase.updateRefs=false $_CAPTURE_PINS rebase --skip"
		else
			_GUARD_RESOLUTION_CLEAN "$STATE_WORKTREE"
			_GUARD_STOP_MODES "$STATE_WORKTREE"
			_NOTE_RESOLVED_TREE "$STATE_WORKTREE"
			_RESUME_EDITOR "$STATE_WORKTREE"
			CMD="GIT_SEQUENCE_EDITOR=true GIT_EDITOR=${(q)REPLY} git -c commit.cleanup=whitespace -c rerere.enabled=true -c rerere.autoUpdate=false -c rebase.updateRefs=false $_CAPTURE_PINS rebase --continue"
		fi
		PRINT_CMD "$CMD"
		local CONTINUE_OUTPUT
		if ! CONTINUE_OUTPUT=$( export LC_ALL=C; eval "$CMD" 2>&1 ); then
			_CLEANUP_HOOK=""
			PRINT_ERR "Conflict continues – resolve more files, then 'git edit --continue'"
			PRINT_TEXT "Worktree: %s" 33 "$STATE_WORKTREE"
			local UNMERGED_LIST=$(_PRINT_CONFLICT_DETAIL "$STATE_WORKTREE" "" "$CONTINUE_OUTPUT")
			_PRINT_ONTO_SKIP_HINT "$STATE_WORKTREE" "$STATE_TARGET"
			PRINT_TEXT "Or abort the operation: %s" 33 "git edit --abort"
			EMIT_CONFLICT "$STATE_WORKTREE" "$UNMERGED_LIST"
			_PAUSE_EXIT 2 conflict
		fi
	fi

	local NEW_HEAD=$(git rev-parse HEAD)

	if ! _VERIFY_REWRITE "$STATE_WORKTREE" "$NEW_HEAD" "$STATE_ORIG_HEAD" "" "$STATE_TARGET"; then
		_CLEANUP_HOOK=""
		EMIT_VERIFY_PAUSED "$_VERIFY_FAILED" "$STATE_WORKTREE" "$NEW_HEAD"
		_PAUSE_EXIT 2 gate
	fi

	local UPDATE_CMD="git update-ref -m ${(q-)${:-git edit: onto ${STATE_TARGET:0:7}$_REFLOG_TAG}} ${(q-)STATE_BRANCH} ${(q-)NEW_HEAD} ${(q-)STATE_ORIG_HEAD}"
	PRINT_CMD "$UPDATE_CMD" 90
	if ! _MOVE_REF "$UPDATE_CMD"; then
		_REFUSE_MOVED_BRANCH "$STATE_BRANCH" "$STATE_WORKTREE"
	fi
	_RECORD_REF_MOVE "$STATE_BRANCH" "$STATE_ORIG_HEAD" "$NEW_HEAD" "onto ${STATE_TARGET:0:7}"
	_SYNC_ONTO_CHECKOUT "$STATE_MAINDIR" "$STATE_ORIG_HEAD" "$NEW_HEAD" "$STATE_BRANCH"

	_PRINT_ONTO_SUMMARY "$STATE_TARGET" "$NEW_HEAD" "$STATE_SPAN" "$STATE_ORIG_HEAD" "$STATE_FORK"

	_CLEAR_STATE
	PRINT_COMPLETED "$NEW_HEAD" "$STATE_BRANCH" true
}

_ABORT_ONTO () {
	PRINT_ACTION "Aborting replant onto %s..." "${STATE_UPSTREAM:-${STATE_TARGET:0:7}}"

	if [ -d "$STATE_WORKTREE" ]; then
		git -C "$STATE_WORKTREE" rebase --abort 2>/dev/null
		local CMD="git worktree remove --force ${(q-)STATE_WORKTREE} 2>/dev/null; rm -rf ${(q-)STATE_WORKTREE}"
		PRINT_CMD "$CMD" 90
		eval "$CMD"
	fi

	_CLEAR_STATE
	PRINT_TEXT "Branch was never touched – nothing to roll back." 32
	PRINT_TEXT "%s" 32 "Replant aborted, state cleared."
	EMIT_STATUS "$STATE_ORIG_HEAD" "$STATE_BRANCH" false
}

_CONTINUE_REORDER () {
	if [ ! -d "$STATE_WORKTREE" ]; then
		PRINT_ERR "Worktree no longer exists: $STATE_WORKTREE"
		_CLEAR_STATE
		exit 1
	fi

	cd "$STATE_WORKTREE" || exit 1

	_CLEANUP_HOOK="git worktree remove --force ${(q-)STATE_WORKTREE} 2>/dev/null; rm -rf ${(q-)STATE_WORKTREE}"

	PRINT_ACTION "Continuing reorder around %s..." "${STATE_TARGET:0:7}"

	# If no rebase is in progress but `HEAD` has moved on, the resolution was
	# completed manually in the worktree – apply the result instead of
	# stranding it
	local GITDIR=$(git rev-parse --git-dir 2>/dev/null)
	if [ ! -d "$GITDIR/rebase-merge" ] && [ ! -d "$GITDIR/rebase-apply" ]; then
		# A same order refuses up front, so a reorder back on its tip was aborted by hand
		[ "$(git rev-parse HEAD)" = "$STATE_ORIG_HEAD" ] && _REFUSE_HAND_ABORT
		_REQUIRE_REPLAY_DONE "$STATE_WORKTREE"
		PRINT_TEXT "%s – applying its result." 33 "Rebase already completed in worktree"
	else
		_GUARD_RESOLUTION_CLEAN "$STATE_WORKTREE"
		_GUARD_STOP_MODES "$STATE_WORKTREE"
		_NOTE_RESOLVED_TREE "$STATE_WORKTREE"
		_RESUME_EDITOR "$STATE_WORKTREE"
		local CMD="GIT_SEQUENCE_EDITOR=true GIT_EDITOR=${(q)REPLY} git -c commit.cleanup=whitespace -c rerere.enabled=true -c rerere.autoUpdate=false -c rebase.updateRefs=false $_CAPTURE_PINS rebase --continue"
		PRINT_CMD "$CMD"
		local CONTINUE_OUTPUT
		if ! CONTINUE_OUTPUT=$( export LC_ALL=C; eval "$CMD" 2>&1 ) && \
		   ! { _AUTO_RESOLVE_FINAL_STEP "$STATE_WORKTREE" "$STATE_ORIG_HEAD" && _FINISH_AUTO_RESOLVED_STEP "$STATE_WORKTREE" "pre-op" }; then
			_CLEANUP_HOOK=""
			PRINT_ERR "Conflict continues – resolve more files, then 'git edit --continue'"
			PRINT_TEXT "Worktree: %s" 33 "$STATE_WORKTREE"
			local UNMERGED_LIST=$(_PRINT_CONFLICT_DETAIL "$STATE_WORKTREE" "$STATE_ORIG_HEAD" "$CONTINUE_OUTPUT")
			PRINT_TEXT "Or abort the operation: %s" 33 "git edit --abort"
			EMIT_CONFLICT "$STATE_WORKTREE" "$UNMERGED_LIST"
			_PAUSE_EXIT 2 conflict
		fi
	fi

	local NEW_HEAD=$(git rev-parse HEAD)

	if ! _GUARD_TIP_MODES "$STATE_WORKTREE" "$NEW_HEAD" "$STATE_ORIG_HEAD" || ! _VERIFY_REWRITE "$STATE_WORKTREE" "$NEW_HEAD" "$STATE_ORIG_HEAD" "$(_REORDER_CHECKS "$STATE_ORIG_HEAD" "$NEW_HEAD")"; then
		_CLEANUP_HOOK=""
		EMIT_GATE_PAUSED "$STATE_WORKTREE" "$NEW_HEAD"
		_PAUSE_EXIT 2 gate
	fi

	local UPDATE_CMD="git update-ref -m ${(q-)${:-git edit: reorder around ${STATE_TARGET:0:7}$_REFLOG_TAG}} ${(q-)STATE_BRANCH} ${(q-)NEW_HEAD} ${(q-)STATE_ORIG_HEAD}"
	PRINT_CMD "$UPDATE_CMD" 90
	if ! _MOVE_REF "$UPDATE_CMD"; then
		_REFUSE_MOVED_BRANCH "$STATE_BRANCH" "$STATE_WORKTREE"
	fi
	_RECORD_REF_MOVE "$STATE_BRANCH" "$STATE_ORIG_HEAD" "$NEW_HEAD" "reorder around ${STATE_TARGET:0:7}"

	_PRINT_REORDER_SUMMARY "$STATE_ORIG_HEAD" "$NEW_HEAD"

	_CLEAR_STATE
	PRINT_COMPLETED "$NEW_HEAD" "$STATE_BRANCH" true
}

# Resumes a paused drop or squash – same shape as `_CONTINUE_REORDER`, the rebase living in an
# isolated worktree with the branch moving only at the final CAS, so a pause costs nothing and can
# repeat
_CONTINUE_REBASE () {
	if [ ! -d "$STATE_WORKTREE" ]; then
		PRINT_ERR "Worktree no longer exists: $STATE_WORKTREE"
		_CLEAR_STATE
		exit 1
	fi

	cd "$STATE_WORKTREE" || exit 1

	# Only a worktree this tool made goes – a `-C` path the caller named is theirs
	_STATE_WT_OURS && _CLEANUP_HOOK="git worktree remove --force ${(q-)STATE_WORKTREE} 2>/dev/null; rm -rf ${(q-)STATE_WORKTREE}"

	PRINT_ACTION "Continuing $STATE_ACTION of %s..." "${STATE_TARGET:0:7}"

	local GITDIR=$(git rev-parse --git-dir 2>/dev/null)
	if [ ! -d "$GITDIR/rebase-merge" ] && [ ! -d "$GITDIR/rebase-apply" ]; then
		# A resolution finished by hand in the worktree leaves no rebase in progress – apply its
		# result rather than stranding it
		[ "$(git rev-parse HEAD)" = "$STATE_ORIG_HEAD" ] && _REFUSE_HAND_ABORT
		_REQUIRE_REPLAY_DONE "$STATE_WORKTREE"
		PRINT_TEXT "%s – applying its result." 33 "Rebase already completed in worktree"
	else
		# The rebase in progress is the run's own, started from the tip it read – one begun there by
		# hand would land whatever it built
		if [ ! -d "$GITDIR/rebase-merge" ] || [ "$(<"$GITDIR/rebase-merge/orig-head")" != "$STATE_ORIG_HEAD" ]; then
			_CLEANUP_HOOK=""
			PRINT_ERR "The rebase in progress in $STATE_WORKTREE is not this $STATE_ACTION's – nothing was applied"
			ECHO_E "\e[0;31m  Finish or abort it there ('git -C $(_LIT "$(_SHQ "$STATE_WORKTREE")") rebase --abort'), or cancel with 'git edit --abort'.\e[0m" >&2
			_PAUSE_EXIT 1 retry
		fi
		_GUARD_RESOLUTION_CLEAN "$STATE_WORKTREE"
		_GUARD_STOP_MODES "$STATE_WORKTREE"
		_NOTE_RESOLVED_TREE "$STATE_WORKTREE"
		# `-m`'s editor where there is a terminal for it – without one the fold takes the message git
		# combines, as a plain squash would
		local EDITOR_MODE=""
		if [ "$STATE_MESSAGE" = editor ]; then
			if _IS_NON_INTERACTIVE; then
				PRINT_TEXT "No terminal for -m's editor – the squash takes the message git combines; reword it after with %s" 33 "git edit -M"
			else
				EDITOR_MODE=real
			fi
		fi
		ACTION=$STATE_ACTION
		_REBASE_CONTINUE_CMD --continue "$(_TEXT_MSG_PATH)" "$EDITOR_MODE"
		# Taken before any print, which reuses `REPLY`
		local CONT=$REPLY
		PRINT_CMD "git rebase --continue"
		_REBASE_DRIVE "$CONT" "$(_TEXT_MSG_PATH)" "$EDITOR_MODE"
		case $? in
			0) ;;
			2)
				_CLEANUP_HOOK=""
				PRINT_ERR "Conflict continues – resolve more files, then 'git edit --continue'"
				PRINT_TEXT "Worktree: %s" 33 "$STATE_WORKTREE"
				local UNMERGED_LIST=$(_PRINT_CONFLICT_DETAIL "$STATE_WORKTREE" "" "$REBASE_OUT")
				PRINT_TEXT "Or abort the operation: %s" 33 "git edit --abort"
				EMIT_CONFLICT "$STATE_WORKTREE" "$UNMERGED_LIST"
				_PAUSE_EXIT 2 conflict ;;
			*)
				_CLEANUP_HOOK=""
				PRINT_ERR "The rebase stopped without a conflict to resolve: $(_REBASE_STOPPED)"
				_PRINT_CONFLICT_DETAIL "$STATE_WORKTREE" "" "$REBASE_OUT" >/dev/null
				PRINT_TEXT "Retry with %s, or abort the operation: %s" 33 "git edit --continue" "git edit --abort"
				_PAUSE_EXIT 1 retry ;;
		esac
	fi

	_LAND_REBASE "$STATE_WORKTREE" "$STATE_BRANCH" "$STATE_ORIG_HEAD" "$STATE_ACTION" "$STATE_TARGET" "$STATE_SQUASH_TARGET" ${=STATE_TARGETS}
	_CLEAR_STATE
	PRINT_COMPLETED "$(git rev-parse "$STATE_BRANCH")" "$STATE_BRANCH" true
}

_ABORT_REBASE () {
	PRINT_ACTION "Aborting $STATE_ACTION of %s..." "${STATE_TARGET:0:7}"
	local LANDED=""
	_PAUSE_LANDED && LANDED=1

	if [ -d "$STATE_WORKTREE" ]; then
		git -C "$STATE_WORKTREE" rebase --abort 2>/dev/null
		if _STATE_WT_OURS; then
			local CMD="git worktree remove --force ${(q-)STATE_WORKTREE} 2>/dev/null; rm -rf ${(q-)STATE_WORKTREE}"
			PRINT_CMD "$CMD" 90
			eval "$CMD"
		else
			PRINT_TEXT "%s, your -C path, stays." 33 "$STATE_WORKTREE"
		fi
	fi

	_CLEAR_STATE
	if [ -n "$LANDED" ]; then
		PRINT_TEXT "The %s had landed already, its run cut off before clearing the pause – nothing to take back." 33 "$STATE_ACTION"
	else
		PRINT_TEXT "Branch was never touched – nothing to roll back." 32
	fi
	PRINT_TEXT "%s" 32 "Operation aborted, state cleared."
	EMIT_STATUS "$STATE_ORIG_HEAD" "$STATE_BRANCH" false
}

# Reconciles what edit mode left behind – it authors in an isolated worktree, so an apply
# leaves the branch's checkout on the pre-edit content, its index holding that as a staged
# revert a later commit would carry – the index re-synced where nothing else touched it, the
# paths named either way, since a blanket reset takes unrelated WIP
_PRINT_EDIT_RECONCILE_HINT () {
	# Args: <main checkout> <base> <new head>
	local CO=$(_BRANCH_CHECKOUT "$STATE_BRANCH")
	[ -z "$CO" ] && CO=$1
	if [ -z "$CO" ] || [ ! -d "$CO" ]; then
		return 0
	fi
	_RECONCILE_CHECKOUT "$CO" "$2" "$3" "Your checkout still holds the pre-edit content of:" ""
}

# Replays the edited target's descendants onto the amended commit, from the branch's current
# tip – re-read here so commits that landed after the pause are carried, not dropped
# Pauses on conflict, returns on success with the worktree `HEAD` at the replayed tip
_EDIT_START_REPLAY () {
	local TIP=$(git rev-parse "$STATE_BRANCH")
	# A merge that landed meanwhile has no place in a linear replay, which would flatten it
	if [ -n "$(git rev-list --merges "$STATE_TARGET..$TIP" 2>/dev/null)" ]; then
		_CLEANUP_HOOK=""
		PRINT_ERR "A merge reached ${STATE_BRANCH#refs/heads/} during the edit – replaying would flatten it, so nothing was applied"
		ECHO_E "\e[0;31m  The edit stays in $(_LIT "$STATE_WORKTREE") – 'git edit --abort', then edit the commit again.\e[0m" >&2
		_PAUSE_EXIT 1 retry
	fi
	# Before the save, which carries the rerere baseline only once the scope holds one
	_RERERE_SCOPE_BEGIN
	_SAVE_STATE "operation=edit" "worktree=$STATE_WORKTREE" "wt_ours=$STATE_WT_OURS" "branch=$STATE_BRANCH" \
		"orig_head=$STATE_ORIG_HEAD" "target=$STATE_TARGET" "amended=$STATE_AMENDED" "replay_tip=$TIP" \
		"maindir=$STATE_MAINDIR" "message=$STATE_MESSAGE"
	STATE_REPLAY_TIP=$TIP
	if [ "$TIP" = "$STATE_TARGET" ]; then
		# Target is the tip itself – the amended commit is the whole result
		git checkout -q "$STATE_AMENDED" 2>/dev/null
		return 0
	fi
	# `--empty=drop`, as the run's `--exec` capture step makes the rebase interactive, whose own
	# default would stop at a commit the edit emptied
	local CMD="GIT_SEQUENCE_EDITOR=true GIT_EDITOR=true git -c rerere.enabled=true -c rerere.autoUpdate=false -c rebase.updateRefs=false -c rebase.instructionFormat= $_CAPTURE_PINS rebase $_CAPTURE_EXEC --empty=drop --onto $STATE_AMENDED $STATE_TARGET $TIP"
	PRINT_CMD "git rebase --onto ${STATE_AMENDED:0:7} ${STATE_TARGET:0:7} ${TIP:0:7}" 90
	if ! eval "$CMD" >/dev/null 2>&1; then
		_CLEANUP_HOOK=""
		PRINT_ERR "Conflict while replaying descendants – resolve in worktree, then 'git edit --continue'"
		PRINT_TEXT "Worktree: %s" 33 "$STATE_WORKTREE"
		local UNMERGED_LIST=$(_PRINT_CONFLICT_DETAIL "$STATE_WORKTREE")
		PRINT_TEXT "Or abort the operation: %s" 33 "git edit --abort"
		EMIT_CONFLICT "$STATE_WORKTREE" "$UNMERGED_LIST"
		_PAUSE_EXIT 2 conflict
	fi
}

# Tells a pause whose run landed it but was cut off before clearing it – the journal's newest move
# of the branch goes from a tip the pause read onto exactly what its worktree built, which a branch
# reset there by hand never shows
_PAUSE_LANDED () {
	[ -d "$STATE_WORKTREE" ] || return 1
	local TIP=$(git rev-parse -q --verify "$STATE_BRANCH" 2>/dev/null) JF=$(_JOURNAL_FILE_PATH) LINE
	local -a F
	[ -n "$TIP" ] && [ "$TIP" = "$(git -C "$STATE_WORKTREE" rev-parse HEAD 2>/dev/null)" ] || return 1
	[ -n "$JF" ] && [ -s "$JF" ] || return 1
	for LINE in "${(@Oaf)$(<"$JF")}"; do
		F=(${=${LINE%%$'\t'*}})
		[ "${F[2]}" = "$STATE_BRANCH" ] || continue
		[ "${F[4]}" = "$TIP" ] && [[ "${F[3]}" == ("$STATE_ORIG_HEAD"|"$STATE_REPLAY_TIP") ]]
		return
	done
	return 1
}

# Amends the paused commit with what the worktree holds, naming git's reason where it refuses – a
# hook, say – which leaves the pause as it was
_EDIT_AMEND () {
	local ERR
	_PRINT_UNTRACKED_ABSORB "$STATE_WORKTREE"
	git add -A >/dev/null 2>&1
	# The pause ran no rebase, so this is where the hold-back arms – never mid-replay, whose start
	# carried no `--exec` step to save the list the pins would then keep git from delivering
	[ "$_CAPTURE_REWRITES" = "true" ] || _CAPTURE_BEGIN
	if [ -n "$TEXT_VALUE" ]; then
		ERR=$(git "${_CAPTURE_PIN_ARGS[@]}" commit --amend -m "$TEXT_VALUE" </dev/null 2>&1 >/dev/null)
	elif [ "$STATE_MESSAGE" = editor ] && ! _IS_NON_INTERACTIVE; then
		_RESOLVE_REAL_EDITOR || exit 1
		GIT_EDITOR=${(qq)_REAL_EDITOR} git "${_CAPTURE_PIN_ARGS[@]}" commit --amend </dev/tty >/dev/tty 2>&1
	else
		[ "$STATE_MESSAGE" = editor ] && PRINT_TEXT "No terminal for -m's editor – the message stays; pass %s to replace it" 33 '--text "…"'
		ERR=$(git "${_CAPTURE_PIN_ARGS[@]}" commit --amend --no-edit </dev/null 2>&1 >/dev/null)
	fi
	if [ $? -ne 0 ]; then
		_CLEANUP_HOOK=""
		PRINT_ERR "Amend failed – nothing was applied${ERR:+: ${ERR%%$'\n'*}}"
		[ -n "$ERR" ] && print -r -- "$ERR" | tail -15 | _CARET_LINES --crlf | LC_ALL=C sed "s/^/${_RED}  /;s/\$/${_OFF}/" >&2
		ECHO_E "\e[0;31m  The edit stays in $(_LIT "$STATE_WORKTREE") – fix what refused it, then 'git edit --continue', or 'git edit --abort'.\e[0m" >&2
		_PAUSE_EXIT 1 edit
	fi
	STATE_AMENDED=$(git rev-parse HEAD)
	_CAPTURE_RECORD "$STATE_TARGET" "$STATE_AMENDED"
	PRINT_CMD "git commit --amend -> ${STATE_AMENDED:0:7}" 90
}

# Resumes a paused edit – the phase is re-derived from the worktree itself, authoring with `HEAD`
# still at the target, replaying with a rebase in progress, or applying with the replay done, so a
# crash or an extra `--continue` lands right
_CONTINUE_EDIT () {
	if [ ! -d "$STATE_WORKTREE" ]; then
		PRINT_ERR "Worktree no longer exists: $STATE_WORKTREE"
		_CLEAR_STATE
		exit 1
	fi

	if _PAUSE_LANDED; then
		PRINT_TEXT "The edit had landed already, its run cut off before clearing the pause – nothing left to do." 33
		if _STATE_WT_OURS; then
			git worktree remove --force "$STATE_WORKTREE" 2>/dev/null
			rm -rf "$STATE_WORKTREE"
		fi
		_CLEAR_STATE
		EMIT_STATUS "$(git rev-parse "$STATE_BRANCH")" "$STATE_BRANCH" false
		exit 0
	fi

	cd "$STATE_WORKTREE" || exit 1

	# A branch rewritten below the paused commit no longer holds it – a replay onto its tip would
	# carry the old commits back beside their new copies
	if ! git merge-base --is-ancestor "$STATE_TARGET" "$(git rev-parse "$STATE_BRANCH")" 2>/dev/null; then
		PRINT_ERR "${STATE_BRANCH#refs/heads/} was rewritten under this edit – ${STATE_TARGET:0:7} is no longer in its history"
		ECHO_E "\e[0;31m  Nothing was applied – 'git edit --abort', then edit its counterpart anew.\e[0m" >&2
		_PAUSE_EXIT 1 retry
	fi

	_STATE_WT_OURS && _CLEANUP_HOOK="git worktree remove --force ${(q-)STATE_WORKTREE} 2>/dev/null; rm -rf ${(q-)STATE_WORKTREE}"

	PRINT_ACTION "Continuing edit of %s..." "${STATE_TARGET:0:7}"

	local GITDIR=$(git rev-parse --git-dir 2>/dev/null)
	local HEAD_NOW=$(git rev-parse HEAD)

	# A message goes in with the amend – past it, the reword is a run of its own
	if [ -n "$TEXT_VALUE" ] && [ "$HEAD_NOW" != "$STATE_TARGET" ]; then
		_CLEANUP_HOOK=""
		PRINT_ERR "--text takes effect at the amend, which is past – finish the edit, then reword: git edit -M --text=\"…\" <sha>"
		exit 1
	fi

	if [ -d "$GITDIR/rebase-merge" ] || [ -d "$GITDIR/rebase-apply" ]; then
		# Mid-replay conflict – the run's own replay, onto the amend it recorded from the tip it read,
		# as a rebase begun there by hand would land whatever it built
		if [ -z "$STATE_AMENDED" ] || [ ! -d "$GITDIR/rebase-merge" ] || \
		   [ "$(<"$GITDIR/rebase-merge/onto")" != "$STATE_AMENDED" ] || [ "$(<"$GITDIR/rebase-merge/orig-head")" != "$STATE_REPLAY_TIP" ]; then
			_CLEANUP_HOOK=""
			PRINT_ERR "The rebase in progress in $STATE_WORKTREE is not this edit's replay – nothing was applied"
			ECHO_E "\e[0;31m  Finish or abort it there ('git -C $(_LIT "$(_SHQ "$STATE_WORKTREE")") rebase --abort'), then 'git edit --continue' – or 'git edit --abort'.\e[0m" >&2
			_PAUSE_EXIT 1 retry
		fi
		_GUARD_RESOLUTION_CLEAN "$STATE_WORKTREE"
		_GUARD_STOP_MODES "$STATE_WORKTREE"
		_NOTE_RESOLVED_TREE "$STATE_WORKTREE"
		_RESUME_EDITOR "$STATE_WORKTREE"
		local CMD="GIT_SEQUENCE_EDITOR=true GIT_EDITOR=${(q)REPLY} git -c commit.cleanup=whitespace -c rerere.enabled=true -c rerere.autoUpdate=false -c rebase.updateRefs=false $_CAPTURE_PINS rebase --continue"
		PRINT_CMD "$CMD"
		local CONTINUE_OUTPUT
		if ! CONTINUE_OUTPUT=$( export LC_ALL=C; eval "$CMD" 2>&1 ); then
			_CLEANUP_HOOK=""
			PRINT_ERR "Conflict continues – resolve more files, then 'git edit --continue'"
			PRINT_TEXT "Worktree: %s" 33 "$STATE_WORKTREE"
			local UNMERGED_LIST=$(_PRINT_CONFLICT_DETAIL "$STATE_WORKTREE" "" "$CONTINUE_OUTPUT")
			PRINT_TEXT "Or abort the operation: %s" 33 "git edit --abort"
			EMIT_CONFLICT "$STATE_WORKTREE" "$UNMERGED_LIST"
			_PAUSE_EXIT 2 conflict
		fi
	elif [ "$HEAD_NOW" = "$STATE_TARGET" ]; then
		# Authoring done – amend the target with whatever changed
		if [ -z "$(git status --porcelain --untracked-files=normal)" ] && [ -z "$TEXT_VALUE" ] && \
		   { [ "$STATE_MESSAGE" != editor ] || _IS_NON_INTERACTIVE; }; then
			_CLEANUP_HOOK=""
			PRINT_ERR "Nothing to amend – no changes in the worktree and no --text"
			ECHO_E "\e[0;31m  Edit files in $(_LIT "$STATE_WORKTREE") (or pass --text \"…\"), then 'git edit --continue' – or 'git edit --abort'.\e[0m" >&2
			_PAUSE_EXIT 1 edit
		fi
		_EDIT_AMEND
		_EDIT_START_REPLAY
	elif [ -n "$STATE_AMENDED" ] && [ "$HEAD_NOW" = "$STATE_AMENDED" ]; then
		# Amend landed but the replay never ran (crash between) – run it now
		[ "$_CAPTURE_REWRITES" = "true" ] || _CAPTURE_BEGIN
		_EDIT_START_REPLAY
	elif [ -n "$STATE_AMENDED" ] && git merge-base --is-ancestor "$STATE_AMENDED" HEAD 2>/dev/null; then
		# The replay finished, possibly by hand – apply what it built, all of it committed, as a
		# restore or a replay below would take the rest
		_REQUIRE_REPLAY_DONE "$STATE_WORKTREE"
		if [ -n "$(git status --porcelain --untracked-files=no --ignore-submodules=all)" ]; then
			_CLEANUP_HOOK=""
			PRINT_ERR "The worktree carries uncommitted edits past the finished replay, which would never land"
			ECHO_E "\e[0;31m  Commit or discard them in $(_LIT "$STATE_WORKTREE"), then 'git edit --continue' – or 'git edit --abort'.\e[0m" >&2
			_PAUSE_EXIT 1 edit
		fi
	elif [ -z "$STATE_AMENDED" ] && _EDIT_COMMITTED_AT_STOP "$HEAD_NOW"; then
		# Commits made by hand at the stop – an amend of the paused commit, or ones on top of it –
		# stand in for it, and what followed it replays onto them as for an amend of the tool's own
		if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
			_CLEANUP_HOOK=""
			PRINT_ERR "Commits were made at the stop, with changes beside them still uncommitted"
			ECHO_E "\e[0;31m  Commit or discard them in $(_LIT "$STATE_WORKTREE"), then 'git edit --continue'.\e[0m" >&2
			_PAUSE_EXIT 1 edit
		fi
		STATE_AMENDED=$HEAD_NOW
		[ "$_CAPTURE_REWRITES" = "true" ] || _CAPTURE_BEGIN
		_CAPTURE_RECORD "$STATE_TARGET" "$STATE_AMENDED"
		_EDIT_START_REPLAY
	else
		# Anything else – a reset elsewhere, the paused commit dropped – lands nothing; a replay
		# aborted by hand left the amend standing, which a reset to it resumes from
		_CLEANUP_HOOK=""
		PRINT_ERR "The edit's worktree no longer builds on ${STATE_TARGET:0:7} or its parent – nothing was applied"
		ECHO_E "\e[0;31m  Reset it there ('git -C $(_LIT "$(_SHQ "$STATE_WORKTREE")") reset --hard ${${STATE_AMENDED:-$STATE_TARGET}:0:12}') and edit again, or 'git edit --abort'.\e[0m" >&2
		_PAUSE_EXIT 1 edit
	fi

	local NEW_HEAD=$(git rev-parse HEAD)
	local BASE=${STATE_REPLAY_TIP:-$STATE_ORIG_HEAD}
	# A commit that landed on the branch during the replay would be dropped by
	# a blind apply – redo the replay onto the fresh tip instead
	if [ "$(git rev-parse "$STATE_BRANCH")" != "$BASE" ]; then
		# From the amend again, so commits made on the finished replay by hand would be lost there
		local -a EXTRA
		_EDIT_HAND_COMMITS "$NEW_HEAD"
		if (( ${#EXTRA} )); then
			_CLEANUP_HOOK=""
			PRINT_ERR "${STATE_BRANCH#refs/heads/} moved, and a replay onto it would drop the commits made on the edit by hand – nothing was applied"
			git log --no-walk=unsorted --format='%h %s' "${EXTRA[@]}" 2>/dev/null | _CARET_LINES | LC_ALL=C sed "s/^/${_RED}  /;s/\$/${_OFF}/" >&2
			ECHO_E "\e[0;31m  Land the edit without them ('git -C $(_LIT "$(_SHQ "$STATE_WORKTREE")") reset --hard <last replayed commit>', then 'git edit --continue'), and add them after – or 'git edit --abort'.\e[0m" >&2
			_PAUSE_EXIT 1 retry
		fi
		PRINT_TEXT "Branch moved during the edit – replaying onto its current tip." 33
		_EDIT_START_REPLAY
		NEW_HEAD=$(git rev-parse HEAD)
		BASE=$STATE_REPLAY_TIP
	fi

	# The pause's own flips are meant – the amended commit against the one it replaced
	if ! _GUARD_TIP_MODES "$STATE_WORKTREE" "$NEW_HEAD" "$BASE" "$(_MODE_LINES "$STATE_WORKTREE" "$STATE_TARGET" "$STATE_AMENDED")" || ! _VERIFY_REWRITE "$STATE_WORKTREE" "$NEW_HEAD" "$STATE_ORIG_HEAD" "$STATE_AMENDED"; then
		_CLEANUP_HOOK=""
		EMIT_GATE_PAUSED "$STATE_WORKTREE" "$NEW_HEAD"
		_PAUSE_EXIT 2 gate
	fi

	local UPDATE_CMD="git update-ref -m ${(q-)${:-git edit: edit ${STATE_TARGET:0:7}$_REFLOG_TAG}} ${(q-)STATE_BRANCH} ${(q-)NEW_HEAD} ${(q-)BASE}"
	PRINT_CMD "$UPDATE_CMD" 90
	if ! _MOVE_REF "$UPDATE_CMD"; then
		_CLEANUP_HOOK=""
		PRINT_ERR "Branch '$STATE_BRANCH' moved during apply – run 'git edit --continue' to replay onto the new tip"
		_PAUSE_EXIT 1 retry
	fi
	_RECORD_REF_MOVE "$STATE_BRANCH" "$BASE" "$NEW_HEAD" "edit ${STATE_TARGET:0:7}"

	# Net history change – pre-answers the "does the result differ by exactly
	# my edit?" verification the caller would otherwise run
	PRINT_TEXT "Net history change (%s -> %s):" 32 "${BASE:0:7}" "${NEW_HEAD:0:7}"
	git --no-pager diff --no-color --stat "$BASE" "$NEW_HEAD" 2>/dev/null | _CARET_LINES | LC_ALL=C sed 's/^/  /'
	_PRINT_MODE_CHANGES "$BASE" "$NEW_HEAD"
	_PRINT_TREE_IDENTITY "$BASE" "$NEW_HEAD"
	_PRINT_DROPPED_COMMITS "$BASE" "$NEW_HEAD"
	_PRINT_EDIT_RECONCILE_HINT "$STATE_MAINDIR" "$BASE" "$NEW_HEAD"
	# A `--text` on the continue replaced the whole message at the amend, so name the body
	# lines it did not restate, as a reword does – every line above is a path or a subject
	if [ -n "$STATE_AMENDED" ]; then
		_PRINT_LOST_BODY "The replaced message" "$STATE_TARGET" "$(git log -1 --format='%B' "$STATE_AMENDED" 2>/dev/null)"
	fi
	# A pause outlives the run that opened it, so the name in its trailer is long
	# gone by now – and both blocks above grow with the edit, which would bury a
	# line printed before them
	_PRINT_COMMIT_LINE "$STATE_TARGET" '  edited: %h %s'

	_CLEAR_STATE
	PRINT_COMPLETED "$NEW_HEAD" "$STATE_BRANCH" true
}

# Fills `EXTRA` with the commits on an edit's replay that it never built – made there by hand, by
# author, date and subject against what followed the paused commit
_EDIT_HAND_COMMITS () {
	# Args: <worktree HEAD>
	local KEY C
	local -A BUILT
	EXTRA=()
	[ -n "$STATE_AMENDED" ] || return 0
	for KEY in "${(@f)$(git log --format='%an%x1f%ae%x1f%at%x1f%s' "$STATE_TARGET..${STATE_REPLAY_TIP:-$STATE_ORIG_HEAD}" 2>/dev/null)}"; do
		BUILT[$KEY]=1
	done
	for C in ${(f)"$(git rev-list --reverse "$STATE_AMENDED..$1" 2>/dev/null)"}; do
		KEY=$(git log -1 --format='%an%x1f%ae%x1f%at%x1f%s' "$C" 2>/dev/null)
		(( ${+BUILT[$KEY]} )) || EXTRA+=("$C")
	done
}

# Tells whether commits made by hand at an edit's stop stand in for the paused commit – an amend of
# it, or ones on top of it, all on its parent; a root has none, so there the worktree's history must
# be a single line from one root of its own
_EDIT_COMMITTED_AT_STOP () {
	# Args: <worktree HEAD>
	if git rev-parse -q --verify "$STATE_TARGET^" >/dev/null; then
		[ "$1" != "$(git rev-parse "$STATE_TARGET^")" ] && git merge-base --is-ancestor "$STATE_TARGET^" "$1" 2>/dev/null
	else
		[ -z "$(git rev-list --merges "$1" 2>/dev/null)" ] && [ "$(git rev-list --max-parents=0 "$1" 2>/dev/null | wc -l | tr -d ' ')" = 1 ]
	fi
}

_ABORT_EDIT () {
	PRINT_ACTION "Aborting edit of %s..." "${STATE_TARGET:0:7}"
	local LANDED=""
	_PAUSE_LANDED && LANDED=1

	if [ -d "$STATE_WORKTREE" ]; then
		git -C "$STATE_WORKTREE" rebase --abort 2>/dev/null
		if _STATE_WT_OURS; then
			local CMD="git worktree remove --force ${(q-)STATE_WORKTREE} 2>/dev/null; rm -rf ${(q-)STATE_WORKTREE}"
			PRINT_CMD "$CMD" 90
			eval "$CMD"
		else
			PRINT_TEXT "%s, your -C path, stays." 33 "$STATE_WORKTREE"
		fi
	fi

	_CLEAR_STATE
	if [ -n "$LANDED" ]; then
		PRINT_TEXT "The edit had landed already, its run cut off before clearing the pause – nothing to take back." 33
	else
		PRINT_TEXT "Branch was never touched – nothing to roll back." 32
	fi
	PRINT_TEXT "%s" 32 "Edit aborted, state cleared."
	EMIT_STATUS "$STATE_ORIG_HEAD" "$STATE_BRANCH" false
}

# Aborts an in-flight `--reorder` – abort the paused rebase and remove the worktree, with
# nothing to roll back since the branch was never moved
_ABORT_REORDER () {
	PRINT_ACTION "Aborting reorder around %s..." "${STATE_TARGET:0:7}"

	if [ -d "$STATE_WORKTREE" ]; then
		git -C "$STATE_WORKTREE" rebase --abort 2>/dev/null
		local CMD="git worktree remove --force ${(q-)STATE_WORKTREE} 2>/dev/null; rm -rf ${(q-)STATE_WORKTREE}"
		PRINT_CMD "$CMD" 90
		eval "$CMD"
	fi

	_CLEAR_STATE
	PRINT_TEXT "Branch was never touched – nothing to roll back." 32
	PRINT_TEXT "%s" 32 "Reorder aborted, state cleared."
	EMIT_STATUS "$STATE_ORIG_HEAD" "$STATE_BRANCH" false
}

# Names the state file for in-flight operations, currently `--amend-into` when an autosquash
# hits a conflict the caller must resolve – the file lives in the common git dir, shared
_STATE_FILE_PATH () {
	local DIR=$(git rev-parse --git-common-dir 2>/dev/null)
	[ -z "$DIR" ] && return 1
	case "$DIR" in
		/*) ;;
		*) DIR="$(pwd)/$DIR" ;;
	esac
	print -r -- "$DIR/git-edit-state"
}

_SAVE_STATE () {
	# Args: key=value pairs to persist (one per arg)
	local SF
	SF=$(_STATE_FILE_PATH) || { PRINT_ERR "Not in a git repo"; return 1; }
	local KV
	local SAVE_VERIFY_CMD=${VERIFY_VALUE:-$STATE_VERIFY_CMD}
	# One key a line – a value holding a newline, a path's say, would read back as keys of its own
	for KV in "$@"; do
		if [[ "$KV" == *$'\n'* ]]; then
			PRINT_ERR "A name holding a newline can't be carried across a pause: ${KV%%=*}"
			exit 1
		fi
	done
	local SF_NEW="$SF.$$"
	_TEMP_FILES+=("$SF_NEW")
	{
		for KV in "$@"; do print -r -- "$KV"; done
		# The rerere scope's baseline rides along uninvited – every pause must
		# carry it for the resuming invocation to adopt (see _RERERE_SCOPE_BEGIN)
		if [ -n "$_RERERE_SCOPE_OWNED" ]; then echo "rrpre=$_RERERE_PRE"; fi
		# So do a --verify flag and the span tier – flags don't survive into the
		# resuming invocation, and a continue must re-verify what the original
		# run asked for, not silently less (or, with no standing config, nothing)
		if [ -n "$SAVE_VERIFY_CMD" ]; then print -r -- "verify_cmd=$SAVE_VERIFY_CMD"; fi
		if _VERIFY_SPAN_ON; then echo "verify_span=1"
		elif [ ${#OPT_NO_VERIFY_SPAN} -gt 0 ] || [ "$STATE_VERIFY_SPAN" = "0" ]; then echo "verify_span=0"; fi
		# And a mode change a continue let through – the landing must not refuse what a stop allowed
		if [ "$STATE_ALLOW_MODE_CHANGE" = "1" ]; then echo "allow_mode_change=1"; fi
		# And a gate the run declined, and the trees resolvers staged at earlier stops, which the gate
		# checks in the default tier
		if [ ${#OPT_NO_VERIFY} -gt 0 ] || [ "$STATE_NO_VERIFY" = 1 ]; then echo "no_verify=1"; fi
		if [ -n "$STATE_RESOLVED" ]; then print -r -- "resolved=$STATE_RESOLVED"; fi
		# And a held-back rewrite delivery, which the resuming run must re-arm around its saved list
		if [ "$_CAPTURE_REWRITES" = "true" ]; then print -r -- "capture=$_CAPTURE_DIR"; fi
		# And the files a run took whole, whose staging the landing re-syncs to what they folded
		if [ ${#WHOLE_PATHS} -gt 0 ]; then print -r -- "whole=${(j: :)${(q)WHOLE_PATHS[@]}}"; fi
		if [ ${#WHOLE_IDX} -gt 0 ]; then print -r -- "whole_idx=${(j: :)${(@qq)${(@kv)WHOLE_IDX}}}"; fi
		# And whose run it is, which the resume journals under and another caller's refuses
		if [ -n "$_ACTOR" ]; then print -r -- "actor=$_ACTOR"; fi
	} > "$SF_NEW"
	# Rewrites this run's own pause in place, and claims a free slot by a hard link – an exclusive
	# create where the filesystem has none – so a parallel run's pause taken meanwhile refuses this one
	if [ -n "$_STATE_OWNED" ]; then
		mv -f "$SF_NEW" "$SF"
	elif ln "$SF_NEW" "$SF" 2>/dev/null || { [ ! -e "$SF" ] && ( setopt noclobber; cat "$SF_NEW" > "$SF" ) 2>/dev/null; }; then
		rm -f "$SF_NEW"
	else
		rm -f "$SF_NEW"
		_REFUSE_PEER_PAUSE
	fi
	_STATE_OWNED=$SF
	# Notes the file held went with the rewrite – a later one is written again, not taken as there
	STATE_VERIFY_FAILED="" STATE_VERIFY_RESULT="" STATE_MODE_STRAY="" STATE_STOP_HEAD="" STATE_TODO_LEFT=""
}

_LOAD_STATE () {
	local SF=$(_STATE_FILE_PATH)
	# Kept for the clear, which a run removing its worktree first could no longer resolve
	_STATE_PATH=$SF
	if [ -z "$SF" ] || [ ! -f "$SF" ]; then
		PRINT_ERR "No in-flight git-edit operation to continue or abort"
		exit 1
	fi
	STATE_OPERATION=""
	STATE_ACTION=""
	STATE_WORKTREE=""
	STATE_BRANCH=""
	STATE_ORIG_HEAD=""
	STATE_TARGET=""
	STATE_HEAD_WITH_FIXUP=""
	STATE_FIXUP=""
	STATE_WT_OURS=""
	STATE_DEPTH=""
	STATE_REBASEBASE=""
	STATE_STAGEDTREE=""
	STATE_FOLD=""
	STATE_MAINDIR=""
	STATE_FILES=""
	STATE_PATHSPECS=""
	STATE_TREE=""
	STATE_AMENDED=""
	STATE_REPLAY_TIP=""
	STATE_UPSTREAM=""
	STATE_SPAN=""
	STATE_FORK=""
	STATE_RRPRE=""
	STATE_RRPRE_SET=""
	STATE_VERIFY_FAILED=""
	STATE_VERIFY_RESULT=""
	STATE_VERIFY_CMD=""
	STATE_VERIFY_SPAN=""
	STATE_CAPTURE=""
	STATE_TARGETS=""
	STATE_ALLOW_MODE_CHANGE=""
	STATE_MODE_STRAY=""
	STATE_RESOLVED=""
	STATE_SQUASH_TARGET=""
	STATE_MESSAGE=""
	STATE_NO_VERIFY=""
	STATE_ACTOR=""
	STATE_STOP_HEAD=""
	STATE_TODO_LEFT=""
	local KEY VAL
	while IFS='=' read -r KEY VAL; do
		case "$KEY" in
			operation)       STATE_OPERATION=$VAL ;;
			action)          STATE_ACTION=$VAL ;;
			worktree)        STATE_WORKTREE=$VAL ;;
			branch)          STATE_BRANCH=$VAL ;;
			orig_head)       STATE_ORIG_HEAD=$VAL ;;
			target)          STATE_TARGET=$VAL ;;
			head_with_fixup) STATE_HEAD_WITH_FIXUP=$VAL ;;
			fixup)           STATE_FIXUP=$VAL ;;
			wt_ours)         STATE_WT_OURS=$VAL ;;
			depth)           STATE_DEPTH=$VAL ;;
			rebasebase)      STATE_REBASEBASE=$VAL ;;
			stagedtree)      STATE_STAGEDTREE=$VAL ;;
			fold)            STATE_FOLD=$VAL ;;
			maindir)         STATE_MAINDIR=$VAL ;;
			files)           STATE_FILES=$VAL ;;
			whole)           WHOLE_PATHS=("${(@Q)${(z)VAL}}") ;;
			whole_idx)       WHOLE_IDX=("${(@Q)${(z)VAL}}") ;;
			pathspecs)       STATE_PATHSPECS=$VAL ;;
			tree)            STATE_TREE=$VAL ;;
			amended)         STATE_AMENDED=$VAL ;;
			replay_tip)      STATE_REPLAY_TIP=$VAL ;;
			upstream)        STATE_UPSTREAM=$VAL ;;
			span)            STATE_SPAN=$VAL ;;
			fork)            STATE_FORK=$VAL ;;
			rrpre)           STATE_RRPRE=$VAL; STATE_RRPRE_SET=1 ;;
			verify_failed)   STATE_VERIFY_FAILED=$VAL ;;
			verify_result)   STATE_VERIFY_RESULT=$VAL ;;
			verify_cmd)      STATE_VERIFY_CMD=$VAL ;;
			verify_span)     STATE_VERIFY_SPAN=$VAL ;;
			capture)         STATE_CAPTURE=$VAL ;;
			targets)         STATE_TARGETS=$VAL ;;
			allow_mode_change) STATE_ALLOW_MODE_CHANGE=$VAL ;;
			mode_stray)      STATE_MODE_STRAY=$VAL ;;
			resolved)        STATE_RESOLVED=$VAL ;;
			squash_target)   STATE_SQUASH_TARGET=$VAL ;;
			message)         STATE_MESSAGE=$VAL ;;
			no_verify)       STATE_NO_VERIFY=$VAL ;;
			actor)           STATE_ACTOR=$VAL ;;
			stop_head)       STATE_STOP_HEAD=$VAL ;;
			todo_left)       STATE_TODO_LEFT=$VAL ;;
		esac
	done < "$SF"
	# The resuming or aborting run takes the pause over – `--status` only reads it
	_STATE_OWNED=$SF
	# A gate the paused run declined stays declined for the run resuming it
	[ "$STATE_NO_VERIFY" = 1 ] && OPT_NO_VERIFY=(--no-verify)
	# Adopt the paused run's rerere scope, so the finalizer diffs against the
	# baseline from before the operation began – a state without one predates
	# the scope, and an unknown baseline must never forget anything
	if [ -n "$STATE_RRPRE_SET" ]; then
		_RERERE_SCOPE_BEGIN "$STATE_RRPRE"
	fi
	# A verify flag on a resume sticks to the operation, as it does on the first invocation –
	# noted here rather than at the next pause, since a re-pause of any kind (a verify failure,
	# a further conflict) keeps the state file as it stands rather than rewriting it. The command
	# first, so the tier can see it, and a span tier with no command in hand refuses here, before
	# anything is rebuilt: recorded, it would refuse every plain resume for want of one, and the
	# pause would be a dead end
	if [ ${#OPT_CONTINUE} -gt 0 ] || [ ${#OPT_SKIP} -gt 0 ]; then
		if [ -n "$VERIFY_VALUE" ] && [ "$VERIFY_VALUE" != "$STATE_VERIFY_CMD" ]; then
			_STATE_NOTE "verify_cmd=$VERIFY_VALUE"
			STATE_VERIFY_CMD=$VERIFY_VALUE
		fi
		if [ ${#OPT_NO_VERIFY_SPAN} -gt 0 ] && [ "$STATE_VERIFY_SPAN" != "0" ]; then
			_STATE_NOTE "verify_span=0"
			STATE_VERIFY_SPAN=0
		elif [ ${#OPT_VERIFY_SPAN} -gt 0 ] && [ "$STATE_VERIFY_SPAN" != "1" ]; then
			if [ -z "$STATE_VERIFY_CMD" ] && [ -z "$(git config --get edit.verifyCmd 2>/dev/null)" ]; then
				PRINT_ERR "--verify-span needs a command – pass --verify=<cmd> or set edit.verifyCmd"
				exit 1
			fi
			_STATE_NOTE "verify_span=1"
			STATE_VERIFY_SPAN=1
		fi
	fi
}

# Names the sidecar carrying a paused `--text` across the exit, alongside the state file –
# the state file's own key=value lines can't hold a multi-line message
_TEXT_MSG_PATH () {
	local SF
	SF=$(_STATE_FILE_PATH) || return 1
	print -r -- "$SF-msg"
}

# Names the sidecar holding the failing verify run's output, alongside the state file – the pause
# prints only the last 15 lines and a driver reading the trailer through `| tail -N` cuts
# off even those, so the evidence has to outlive the invocation
_VERIFY_LOG_PATH () {
	local SF
	SF=$(_STATE_FILE_PATH) || return 1
	print -r -- "$SF-verify"
}

# Writes that sidecar and names it, header first, so a truncated or huge output still
# answers what ran, how it ended and how long it took – the check's own text is what
# tells a timeout from a red run
_VERIFY_SAVE_LOG () {
	# Args: <commit> <cmd> <exit-status> <seconds> <output>
	local LF
	LF=$(_VERIFY_LOG_PATH) || return 0
	# A parallel run's pause owns the sidecar too – this run's record is the tail printed above
	if [ -z "$_STATE_OWNED" ] && _STATE_EXISTS; then
		return 0
	fi
	{
		print -r -- "commit: $1"
		print -r -- "command: $2"
		print -r -- "exit: $3"
		print -r -- "seconds: $4"
		print -r -- ""
		print -r -- "$5"
	} > "$LF" 2>/dev/null || return 0
	PRINT_TEXT "Full output: %s" 33 "$LF"
}

# Tells whether the pause's worktree is one this tool made – by its name
# for a pause from before the record was kept
_STATE_WT_OURS () {
	[ "$STATE_WT_OURS" = 1 ] || { [ -z "$STATE_WT_OURS" ] && [[ "${STATE_WORKTREE:t}" == git-edit-* ]]; }
}

_CLEAR_STATE () {
	local SF=${_STATE_PATH:-$(_STATE_FILE_PATH)}
	[ -n "$SF" ] || return 0
	# The capture dir a pause recorded goes with its state, as does this run's own
	_CAPTURE_REMOVE "$(LC_ALL=C sed -n 's/^capture=//p' "$SF" 2>/dev/null | head -1)"
	_CAPTURE_REMOVE "$_CAPTURE_DIR"
	rm -f "$SF" "$SF-msg" "$SF-verify"
	# The slot is free from here, so a pause a parallel run records next is not this one's
	_STATE_OWNED=""
}

_STATE_EXISTS () {
	local SF=$(_STATE_FILE_PATH)
	[ -n "$SF" ] && [ -f "$SF" ]
}

# Scopes rerere to the operation when the caller has explicitly opted out – every
# conflict-capable rebase force-enables it so a cascade or retry replays a resolution,
# but `rerere.enabled` false asks for no durable memory, so the run's records go
_RERERE_SCOPE_BEGIN () {
	# Args: [<baseline>] – with a baseline (even an empty one), adopt a paused
	# run's scope instead of snapshotting a fresh one
	[ -n "$_RERERE_SCOPE_OWNED" ] && return 0
	local DIR=$(git rev-parse --path-format=absolute --git-path rr-cache 2>/dev/null)
	[ -z "$DIR" ] && return 0
	_RERERE_DIR=$DIR
	_RERERE_STATE_FILE=$(_STATE_FILE_PATH)
	_RERERE_OPTOUT=false
	[ "$(git config --type=bool --get rerere.enabled 2>/dev/null)" = "false" ] && _RERERE_OPTOUT=true
	if [ $# -gt 0 ]; then
		_RERERE_PRE=$1
	else
		local -a PRE
		PRE=("$DIR"/*(N/:t))
		_RERERE_PRE="${PRE[*]}"
	fi
	_RERERE_SCOPE_OWNED=1
}

# Finalizes the rerere scope, called from the exit trap once no operation is in flight, using
# only the absolute paths captured at begin or adopt time – new entries are found by
# name, so nothing pre-existing is touched, and only a postimage counts as a resolution
_RERERE_SCOPE_END () {
	local CODE=$1
	[ -n "$_RERERE_DIR" ] && [ -d "$_RERERE_DIR" ] || return 0
	local -a NEW RESOLVED POSTIMAGES
	local E
	for E in "$_RERERE_DIR"/*(N/:t); do
		if [[ " $_RERERE_PRE " != *" $E "* ]]; then
			NEW+=("$E")
			POSTIMAGES=("$_RERERE_DIR/$E"/postimage*(N))
			[ ${#POSTIMAGES[@]} -gt 0 ] && RESOLVED+=("$E")
		fi
	done
	[ ${#NEW[@]} -eq 0 ] && return 0
	if [ "$_RERERE_OPTOUT" = "true" ]; then
		for E in "${NEW[@]}"; do rm -rf "$_RERERE_DIR/$E"; done
		if [ ${#RESOLVED[@]} -gt 0 ]; then
			PRINT_TEXT "Forgot %s resolution(s) rerere recorded during this run – it runs enabled so a cascade replays, and rerere.enabled=false keeps none of it." 90 "${#RESOLVED[@]}" >&2
		fi
	elif [ ${#RESOLVED[@]} -gt 0 ] && { [ ${#OPT_ABORT} -gt 0 ] || [ $CODE -ne 0 ]; }; then
		PRINT_TEXT "%s resolution(s) recorded by rerere outlive this run – a later conflict over the same lines arrives pre-filled, marker-free." 33 "${#RESOLVED[@]}" >&2
		PRINT_TEXT "If a resolution was wrong, remove: %s" 33 "${(j: :)${(@)RESOLVED/#/$_RERERE_DIR/}}" >&2
	fi
}

# Prints when a rewrite left the tip tree byte-identical to the pre-op tip – the strongest
# verification a content-preserving operation can get, free since both tips are at hand
# Reorders print their own variant beside the new order
_PRINT_TREE_IDENTITY () {
	# Args: <old-tip> <new-tip>
	[ "$1" = "$2" ] && return 0
	local OLD_TREE=$(git rev-parse "$1^{tree}" 2>/dev/null)
	[ -z "$OLD_TREE" ] && return 0
	if [ "$OLD_TREE" = "$(git rev-parse "$2^{tree}" 2>/dev/null)" ]; then
		PRINT_TEXT "%s – content byte-identical to the pre-op tip." 32 "Tip tree identical ✓"
	fi
}

# Names the notes a rewrite left behind on the pre-rewrite commits – whether they are copied
# is git's own policy, `notes copy` no-opping unless `notes.rewriteRef` is set, so this
# reports what that policy left, and a copy keeps the original, so both sides are counted
_PRINT_LEFT_NOTES () {
	# Args: <orig-tip> <new-tip>
	# Every notes ref, not just the default one – `notes.rewriteRef` is a glob,
	# so a repo carrying `refs/notes/review` is the case this exists for
	local NREF
	local ANNOTATED=$(
		for NREF in ${(f)"$(git for-each-ref --format='%(refname)' refs/notes 2>/dev/null)"}; do
			git notes --ref="$NREF" list 2>/dev/null
		done | awk '{ print $2 }' | sort -u
	)
	[ -z "$ANNOTATED" ] && return 0
	local OLD_N NEW_N
	OLD_N=$(git rev-list "$1" --not "$2" 2>/dev/null | grep -Fxc -f <(printf '%s\n' "$ANNOTATED") 2>/dev/null) || OLD_N=0
	NEW_N=$(git rev-list "$2" --not "$1" 2>/dev/null | grep -Fxc -f <(printf '%s\n' "$ANNOTATED") 2>/dev/null) || NEW_N=0
	[ "${OLD_N:-0}" -le "${NEW_N:-0}" ] && return 0
	# Annotated commits, not note blobs – several refs can annotate one commit,
	# and the count is of what was replaced
	PRINT_TEXT "Notes stayed on %s replaced commit(s) – git copies notes only with notes.rewriteRef set:" 33 "$((OLD_N - NEW_N))"
	ECHO_E "\e[0;33m  git config notes.rewriteRef 'refs/notes/*'  # then re-run, or carry one over with git notes copy <old> <new>\e[0m"
}

# Names the signatures a rebuild could not carry – a rewritten commit is a new object, so
# its signature is invalid by construction and never re-created, and the header is read
# raw rather than through `%G?`, which needs gpg present and answers 'N' without it
_PRINT_LOST_SIGNATURES () {
	# Args: <orig-tip> <new-tip> – the replaced commits are those the new tip no longer reaches
	# A shortfall proves nothing alone, since a rebase re-signs under `commit.gpgsign` and
	# `-d`/`-s` carry one off deliberately, so the line states what both sides hold
	local OLD_S NEW_S
	OLD_S=$(git rev-list "$1" --not "$2" 2>/dev/null | git cat-file --batch 2>/dev/null | grep -cE '^(gpgsig|gpgsig-sha256|mergetag) ') || OLD_S=0
	[ "${OLD_S:-0}" -eq 0 ] && return 0
	NEW_S=$(git rev-list "$2" --not "$1" 2>/dev/null | git cat-file --batch 2>/dev/null | grep -cE '^(gpgsig|gpgsig-sha256|mergetag) ') || NEW_S=0
	[ "${NEW_S:-0}" -gt 0 ] && return 0
	PRINT_TEXT "The replaced commit(s) carried %s signature(s), and the rewritten history carries none." 33 "$OLD_S"
}

# Prints the commits a replay dropped as empty – the count proves something vanished and the
# names say what, sparing the caller a log hunt, with subjects as the identity since a
# rewrite changes every SHA, and deliberate removals never route here
_PRINT_DROPPED_COMMITS () {
	# Args: <old-tip> <new-tip>
	local MB=$(git merge-base "$1" "$2" 2>/dev/null)
	local BEFORE
	local AFTER
	BEFORE=$(git rev-list --count ${MB:+$MB..}$1 2>/dev/null)
	AFTER=$(git rev-list --count ${MB:+$MB..}$2 2>/dev/null)
	if [ -z "$BEFORE" ] || [ -z "$AFTER" ] || [ "$AFTER" -ge "$BEFORE" ]; then
		return 0
	fi
	PRINT_TEXT "%s commit(s) resolved to empty and were dropped – %s before, %s after." 33 \
		"$((BEFORE - AFTER))" "$BEFORE" "$AFTER"
	# Which ones, by subject multiset – a rewrite changes every SHA, so subjects are the only
	# identity that survives, with an `s:` prefix since an empty subject is a legal message
	# Assignments, since `(( key++ ))` re-parses the subscript and would execute backticks
	local -A SURVIVING
	local SUBJECT
	while IFS= read -r SUBJECT; do
		SURVIVING[s:$SUBJECT]=$(( ${SURVIVING[s:$SUBJECT]:-0} + 1 ))
	done <<< "$(git log --format=%s ${MB:+$MB..}$2 2>/dev/null)"
	local -a DROPPED
	local LINE
	while IFS= read -r LINE; do
		SUBJECT=${LINE#* }
		if (( ${SURVIVING[s:$SUBJECT]:-0} > 0 )); then
			SURVIVING[s:$SUBJECT]=$(( ${SURVIVING[s:$SUBJECT]:-0} - 1 ))
		else
			DROPPED+=("$LINE")
		fi
	done <<< "$(git log --format='%h %s' ${MB:+$MB..}$1 2>/dev/null)"
	# Naming only where the arithmetic agrees: an op that also reworded left a
	# subject with no counterpart, and that commit is not a drop – the count
	# above stays authoritative either way
	[ ${#DROPPED[@]} -ne $((BEFORE - AFTER)) ] && return 0
	printf '%s\n' "${DROPPED[@]:0:12}" | _CARET_LINES | LC_ALL=C sed "s/^/  dropped: /;s/^/${_DIM}/;s/\$/${_OFF}/"
	[ ${#DROPPED[@]} -gt 12 ] && PRINT_TEXT "  +%s more" 90 "$(( ${#DROPPED[@]} - 12 ))"
	return 0
}

# Fills `MARKED` with the staged paths in <worktree> holding conflict markers none of its sides
# brought, each at its own `conflict-marker-size` – an underline a file holds of its own passes
_MARKED_PATHS () {
	# Args: <worktree> [<rev a side came from>...]
	local WT=$1 FILE N RE STAGED OWN SIDE A
	shift
	local -a FILES SIDES ATTRS
	local -A SIZE
	SIDES=(HEAD "$@")
	git -C "$WT" rev-parse -q --verify REBASE_HEAD >/dev/null 2>&1 && SIDES+=(REBASE_HEAD)
	MARKED=()
	# NUL-separated – the line form C-quotes a name holding a quote or
	# backslash, which then shows no markers and passes
	FILES=(${(0)"$(git -C "$WT" diff --cached -z --name-only 2>/dev/null)"})
	(( ${#FILES} )) || return 0
	ATTRS=("${(@0)$(print -rn -- "${(pj:\0:)FILES}" | git -C "$WT" check-attr -z --stdin conflict-marker-size 2>/dev/null)}")
	for (( A = 1; A + 2 <= ${#ATTRS}; A += 3 )); do SIZE[${ATTRS[A]}]=${ATTRS[A + 2]}; done
	for FILE in "${FILES[@]}"; do
		N=${SIZE[$FILE]}
		[[ "$N" == <1-> ]] || N=7
		RE="^(<{$N}|={$N}|>{$N})( |\$)"
		# Read whole – piped into `grep -q`, `git show` died at an early marker once the blob
		# outgrew the pipe buffer, and `pipefail` read that as a clean file
		STAGED=$(git -C "$WT" show ":0:$FILE" 2>/dev/null | LC_ALL=C grep -aE "$RE")
		[ -n "$STAGED" ] || continue
		OWN=""
		for SIDE in "${SIDES[@]}"; do
			OWN+=$(git -C "$WT" show "$SIDE:$FILE" 2>/dev/null | LC_ALL=C grep -aE "$RE")$'\n'
		done
		[ -n "$(LC_ALL=C comm -23 <(print -r -- "$STAGED" | LC_ALL=C sort -u) <(print -r -- "$OWN" | LC_ALL=C sort -u))" ] && MARKED+=("$FILE")
	done
	return 0
}

# Refuses to resume while a staged file still carries conflict markers – the failure mode is
# a resolver dying silently, a blanket `git add` staging the file markers and all, and
# `rebase --continue` accepting that, so read the staged blob, which is what gets committed
_GUARD_RESOLUTION_CLEAN () {
	# Args: <worktree> [<rev a side came from>...]
	local WT=$1 STOP_TIP=${STATE_STOP_HEAD%% *} HEAD_NOW FILE N RE HAVE OWN SIDE
	local -a BAD FILES
	_MARKED_PATHS "$@"
	BAD=("${MARKED[@]}")
	# Commits made by hand at the stop carry their markers past the staged check – read at the tip
	# against what the stop began with and what its commit brought
	HEAD_NOW=$(git -C "$WT" rev-parse -q --verify HEAD 2>/dev/null)
	if [ -n "$STOP_TIP" ] && [ "$HEAD_NOW" != "$STOP_TIP" ] && \
	   [ "${STATE_STOP_HEAD#* }" = "$(git -C "$WT" rev-parse -q --verify REBASE_HEAD 2>/dev/null)" ] && \
	   git -C "$WT" merge-base --is-ancestor "$STOP_TIP" "$HEAD_NOW" 2>/dev/null; then
		FILES=(${(0)"$(git -C "$WT" diff -z --name-only --no-renames "$STOP_TIP" "$HEAD_NOW" 2>/dev/null)"})
		for FILE in "${FILES[@]}"; do
			N=$(git -C "$WT" check-attr conflict-marker-size -- "$FILE" 2>/dev/null)
			N=${N##*: }
			[[ "$N" == <1-> ]] || N=7
			RE="^(<{$N}|={$N}|>{$N})( |\$)"
			HAVE=$(git -C "$WT" show "$HEAD_NOW:$FILE" 2>/dev/null | LC_ALL=C grep -aE "$RE")
			[ -n "$HAVE" ] || continue
			OWN=""
			for SIDE in "$STOP_TIP" REBASE_HEAD; do
				OWN+=$(git -C "$WT" show "$SIDE:$FILE" 2>/dev/null | LC_ALL=C grep -aE "$RE")$'\n'
			done
			[ -n "$(LC_ALL=C comm -23 <(print -r -- "$HAVE" | LC_ALL=C sort -u) <(print -r -- "$OWN" | LC_ALL=C sort -u))" ] && \
				(( ! ${BAD[(Ie)$FILE]} )) && BAD+=("$FILE")
		done
	fi
	if [ ${#BAD[@]} -gt 0 ]; then
		_CLEANUP_HOOK=""
		PRINT_ERR "The resolution still contains conflict markers – refusing to continue"
		printf '%s\n' "${BAD[@]}" | _CARET_LINES | LC_ALL=C sed "s/^/${_RED}  /;s/\$/${_OFF}/" >&2
		ECHO_E "\e[0;31m  Strip them in $(_LIT "$WT") – staged, or amended into a commit made there – then 'git edit --continue', or 'git edit --abort'.\e[0m" >&2
		EMIT_CONFLICT "$WT" "${(F)BAD}"
		_PAUSE_EXIT 2 conflict
	fi
}

# Records the tree a resolver staged at a stop, the one state in a replay that somebody wrote
# rather than git – so the gate's default tier can find the commit carrying it and check it too
_NOTE_RESOLVED_TREE () {
	local TREE=$(git -C "$1" write-tree 2>/dev/null)
	[ -z "$TREE" ] && return 0
	STATE_RESOLVED="${STATE_RESOLVED:+$STATE_RESOLVED }$TREE"
	_STATE_NOTE "resolved=$STATE_RESOLVED"
}

# Appends a key=value line to this run's own pause, never a parallel run's – the loader takes a
# key's last line, so a later value replaces an earlier one and an empty one clears it
_STATE_NOTE () {
	[ -n "$_STATE_OWNED" ] && [ -f "$_STATE_OWNED" ] && print -r -- "$1" >> "$_STATE_OWNED"
	return 0
}

# The ` mode change` lines of a diff, as the landing's mode note reads them – paths unquoted,
# so the commit search can look one up as it stands
_MODE_LINES () {
	# Args: <worktree> <from> <to>
	git -C "$1" -c core.quotePath=false diff --summary "$2" "$3" 2>/dev/null | LC_ALL=C grep -a '^ mode change'
	return 0
}

# The mode git's own merge gives a path at a stop: the replayed commit's where that commit
# changed it, else the new parent's – and none where both changed it (the resolver's call) or
# the commit removed the path
_MERGED_MODE () {
	# Args: <base> <theirs> <ours>
	[ -z "$2" ] && return 0
	if [ "$2" != "$1" ]; then
		[ -n "$3" ] && [ "$3" != "$1" ] && [ "$3" != "$2" ] && return 0
		echo "$2"
	else
		echo "${3:-$2}"
	fi
}

# Prints a tree's mode for each given path as "<path>\0<mode>\0" pairs, in one read – NUL-separated
# throughout, so a path with a space or an umlaut arrives unquoted
_TREE_MODES () {
	# Args: <worktree> <tree-ish> <path>...
	local E
	for E in ${(0)"$(git --literal-pathspecs -C "$1" ls-tree -r -z "$2" -- "${@:3}" 2>/dev/null)"}; do
		[ -n "$E" ] && printf '%s\0%s\0' "${E#*$'\t'}" "${E%% *}"
	done
}

# Refuses a stop's staged resolution that leaves a path at a mode neither the replayed commit
# nor its new parent carries – a file written anew into the worktree and staged comes back
# without its executable bit, which every commit above then inherits, surfacing only in the
# landing's mode note; `--allow-mode-change` on the continue keeps it, for the landing too
_GUARD_STOP_MODES () {
	local WT=$1
	local GITDIR=$(git -C "$WT" rev-parse --git-dir 2>/dev/null)
	local STOPPED=$(cat "$GITDIR/rebase-merge/stopped-sha" 2>/dev/null)
	[ -z "$STOPPED" ] && return 0
	local -a PATHS
	PATHS=( ${(0)"$(git -C "$WT" diff --cached --name-only -z 2>/dev/null)"} )
	[ ${#PATHS[@]} -eq 0 ] && return 0
	# One index read and three tree reads for every staged path – a large commit's stop stages
	# hundreds, and a read per path would take seconds
	local -A STAGED BASE THEIRS OURS
	local E MODES
	for E in ${(0)"$(git --literal-pathspecs -C "$WT" ls-files -s -z -- "${PATHS[@]}" 2>/dev/null)"}; do
		# "<mode> <blob> <stage>\t<path>" – stage 0 only, an unmerged path holds no resolution yet
		[[ "${E%%$'\t'*}" == *" 0" ]] && STAGED[${E#*$'\t'}]=${E%% *}
	done
	MODES=$(_TREE_MODES "$WT" "$STOPPED^" "${PATHS[@]}"); [ -n "$MODES" ] && BASE=( ${(0)MODES} )
	MODES=$(_TREE_MODES "$WT" "$STOPPED" "${PATHS[@]}"); [ -n "$MODES" ] && THEIRS=( ${(0)MODES} )
	MODES=$(_TREE_MODES "$WT" HEAD "${PATHS[@]}"); [ -n "$MODES" ] && OURS=( ${(0)MODES} )
	local -a BAD BADPATHS FIX
	local P WANTED
	for P in "${PATHS[@]}"; do
		[ -z "${STAGED[$P]}" ] && continue
		WANTED=$(_MERGED_MODE "${BASE[$P]}" "${THEIRS[$P]}" "${OURS[$P]}")
		if [ -n "$WANTED" ] && [ "${STAGED[$P]}" != "$WANTED" ]; then
			BAD+=("$P: staged ${STAGED[$P]}, the replay carries $WANTED")
			BADPATHS+=("$P")
			# Worktree and index both – an index set on its own leaves an unstaged mode change,
			# which `git rebase --continue` reads as conflicts still to resolve, and `git add`'s
			# own `--chmod` holds where `core.fileMode` is off
			case "$WANTED" in
				100755) FIX+=("chmod +x -- $(_SHQ "$WT/$P") && git -C $(_SHQ "$WT") add --chmod=+x -- $(_QUOTE_PATHS "$P")") ;;
				100644) FIX+=("chmod -x -- $(_SHQ "$WT/$P") && git -C $(_SHQ "$WT") add --chmod=-x -- $(_QUOTE_PATHS "$P")") ;;
				*) FIX+=("git -C $(_SHQ "$WT") update-index --cacheinfo $(_SHQ "$WANTED,$(git -C "$WT" rev-parse ":0:$P" 2>/dev/null),$P")") ;;
			esac
		fi
	done
	[ ${#BAD[@]} -eq 0 ] && return 0
	if [ ${#OPT_ALLOW_MODE_CHANGE} -gt 0 ]; then
		# The landing's guard must not refuse what this one let through
		STATE_ALLOW_MODE_CHANGE=1
		_STATE_NOTE "allow_mode_change=1"
		return 0
	fi
	_CLEANUP_HOOK=""
	PRINT_ERR "The staged resolution changes a file mode the replayed commit does not – a file written anew and staged without its executable bit?"
	printf '%s\n' "${BAD[@]}" | _CARET_LINES | LC_ALL=C sed "s/^/${_RED}  /;s/\$/${_OFF}/" >&2
	ECHO_E "\e[0;31m  Restore it, then 'git edit --continue' – or pass --allow-mode-change to keep it:\e[0m" >&2
	printf '%s\n' "${FIX[@]}" | _CARET_LINES | LC_ALL=C sed "s/^/${_RED}    /;s/\$/${_OFF}/" >&2
	EMIT_CONFLICT "$WT" "${(F)BADPATHS}"
	_PAUSE_EXIT 2 conflict
}

# The commit the tip guard last named, for the gate pause's trailer
_MODE_STRAY_AT=""

# Refuses a landing whose tip changed a file mode the operation never asked for – beyond a fold's
# staged flip, an edit's, or the ones a dropped commit undoes – naming the rebuilt commit that
# brought it in, since a resolution at a stop is where one enters unasked; `--allow-mode-change`
# on the continue applies it anyway, as it does for a stop it let through
_GUARD_TIP_MODES () {
	# Args: <worktree> <new_head> <orig_head> [<meant mode lines>]
	local WT=$1
	local NEW=$2
	local ORIG=$3
	local MEANT=$4
	_MODE_STRAY_AT=""
	if [ ${#OPT_ALLOW_MODE_CHANGE} -gt 0 ] || [ "$STATE_ALLOW_MODE_CHANGE" = "1" ]; then
		# Given on a continue, the flag carries to the next – a verify pause in between must not
		# bring the refusal back
		if [ ${#OPT_CONTINUE} -gt 0 ] && [ "$STATE_ALLOW_MODE_CHANGE" != "1" ]; then
			STATE_ALLOW_MODE_CHANGE=1
			_STATE_NOTE "allow_mode_change=1"
		fi
		[ -n "$STATE_MODE_STRAY" ] && _STATE_NOTE "mode_stray="
		return 0
	fi
	local -a STRAY
	local LINE
	for LINE in ${(f)"$(_MODE_LINES "$WT" "$ORIG" "$NEW")"}; do
		[ -z "$LINE" ] && continue
		grep -qxF -- "$LINE" <<<"$MEANT" || STRAY+=("$LINE")
	done
	[ ${#STRAY[@]} -eq 0 ] && return 0
	PRINT_ERR "The rewrite changed a file mode nothing asked for – nothing was applied"
	local C TO P
	for LINE in "${STRAY[@]}"; do
		print -r -- "$LINE" | _CARET_LINES | LC_ALL=C sed "s/^ /${_RED}  /;s/\$/${_OFF}/" >&2
		# The first rebuilt commit carrying the path at the landed mode – the stop where a
		# resolution staged the file at it, or the rebuilt commit that introduced the file at it
		TO=${${LINE#* mode change * => }%% *}
		P=${LINE#* mode change * => * }
		for C in ${(f)"$(git -C "$WT" rev-list --reverse "$ORIG..$NEW" 2>/dev/null)"}; do
			[ -z "$C" ] && continue
			if [ "$(git -C "$WT" ls-tree "$C" -- ":(literal)$P" 2>/dev/null | cut -d' ' -f1)" = "$TO" ]; then
				_PRINT_COMMIT_LINE "$C" '    brought in by %h %s'
				[ -z "$_MODE_STRAY_AT" ] && _MODE_STRAY_AT=$C
				break
			fi
		done
	done
	[ -z "$_MODE_STRAY_AT" ] && _MODE_STRAY_AT=$NEW
	PRINT_TEXT "Apply it anyway with %s, then fix that commit with %s – or 'git edit --abort'." 33 "--allow-mode-change --continue" "git edit ${_MODE_STRAY_AT:0:7}"
	return 1
}

# Records the gate a `--no-verify` run bypassed, for the note `EMIT_STATUS` prints. The command
# is resolved here only to name it, so the multi-line refusal the gate itself makes stays out of
# a path where nothing ever runs it – hence the first line alone. With nothing configured it
# records nothing: no gate existed, so none was skipped, and a note there would invent one
_VERIFY_NOTE_BYPASS () {
	[ ${#OPT_NO_VERIFY} -gt 0 ] || return 0
	local CMD=$VERIFY_VALUE
	[ -z "$CMD" ] && CMD=$STATE_VERIFY_CMD
	[ -z "$CMD" ] && CMD=$(git config --get edit.verifyCmd 2>/dev/null)
	[ -n "$CMD" ] && _VERIFY_BYPASSED=${CMD%%$'\n'*}
	return 0
}

# Answers whether a gate is in force for this run, putting its command into `REPLY`
_VERIFY_CONFIGURED () {
	REPLY=""
	[ ${#OPT_NO_VERIFY} -gt 0 ] && return 1
	REPLY=$VERIFY_VALUE
	[ -z "$REPLY" ] && REPLY=$STATE_VERIFY_CMD
	[ -z "$REPLY" ] && REPLY=$(git config --get edit.verifyCmd 2>/dev/null)
	[ -n "$REPLY" ]
}

# Answers whether the span tier is in force – the flag, the tier a pause recorded, or the standing
# `edit.verifySpan`, whose config is only read where the gate runs, so it stays exempt
# on the modes an explicit flag is refused on, and names a tier rather than a check.
# `--no-verify-span` declines it for one run, and a pause records the declined tier as `0`,
# since a resume that fell back to the config would climb to the span the run stepped down from
_VERIFY_SPAN_ON () {
	[ ${#OPT_NO_VERIFY_SPAN} -gt 0 ] && return 1
	[ ${#OPT_VERIFY_SPAN} -gt 0 ] && return 0
	case "$STATE_VERIFY_SPAN" in 1) return 0 ;; 0) return 1 ;; esac
	[ "$(git config --type=bool --get edit.verifySpan 2>/dev/null)" = "true" ] || return 1
	_VERIFY_CONFIGURED
}

# Finds the pre-op commit a rebuilt one replaces – the tip's is known outright, and below it the
# subject carries across the rebuild where the SHA does not, equal spans pairing
# positionally, while an ambiguous match answers nothing, being worse than none
_VERIFY_COUNTERPART () {
	# Args: <commit> <orig_head> <new_head>
	local C=$1
	local ORIG=$2
	local NEW=$3
	if [ "$C" = "$NEW" ]; then
		print -r -- "$ORIG"
		return 0
	fi
	local BASE=$(git merge-base "$ORIG" "$NEW" 2>/dev/null)
	[ -z "$BASE" ] && return 1
	local SUBJECT=$(git log -1 --format=%s "$C" 2>/dev/null)
	local -a MATCHES
	local LINE
	if [ -n "$SUBJECT" ]; then
		for LINE in ${(f)"$(git log --format="%H%x00%s" "$BASE..$ORIG" 2>/dev/null)"}; do
			[ "${LINE#*$'\0'}" = "$SUBJECT" ] && MATCHES+=("${LINE%%$'\0'*}")
		done
	fi
	if [ ${#MATCHES[@]} -eq 1 ]; then
		print -r -- "${MATCHES[1]}"
		return 0
	fi
	local -a OLD_SPAN NEW_SPAN
	OLD_SPAN=("${(@f)$(git rev-list --reverse "$BASE..$ORIG" 2>/dev/null)}")
	NEW_SPAN=("${(@f)$(git rev-list --reverse "$BASE..$NEW" 2>/dev/null)}")
	[ ${#OLD_SPAN[@]} -ne ${#NEW_SPAN[@]} ] && return 1
	local -i I
	for I in {1..${#NEW_SPAN[@]}}; do
		if [ "${NEW_SPAN[$I]}" = "$C" ]; then
			# Position alone would pair a reorder's commits with whatever now
			# sits where they used to – the subject has to agree there too
			[ "$(git log -1 --format=%s "${OLD_SPAN[$I]}" 2>/dev/null)" = "$SUBJECT" ] || return 1
			print -r -- "${OLD_SPAN[$I]}"
			return 0
		fi
	done
	return 1
}

# Removes what a check left untracked in <worktree>, so the next one – at another commit, in the
# walk, or a resume's – sees that commit and the ignored files alone, as `--exec`'s gate does,
# `clean` without `-x` sparing the links
_VERIFY_CLEAN () {
	# Args: <worktree>
	local P
	for P in ${(f)"$(LC_ALL=C git -C "$1" -c core.quotePath=false clean -fd 2>/dev/null | LC_ALL=C sed -n 's/^Removing //p')"}; do
		(( ${_VERIFY_LITTER[(Ie)$P]} )) || _VERIFY_LITTER+=("$P")
	done
}

# Names what the gate's runs left untracked, once for the whole gate
_VERIFY_NOTE_LITTER () {
	[ ${#_VERIFY_LITTER} -gt 0 ] && PRINT_TEXT "Removed what the check left untracked, so no run saw another's: %s" 90 "$(_JOIN_PATHS "${(F)_VERIFY_LITTER}")"
	return 0
}

# Says who broke the check and where it heals, the two questions a failure raises – the
# counterpart run attributes it, since a check already failing at the commit this one
# replaces was failing before the rewrite, and otherwise the walk climbs the span
_VERIFY_DIAGNOSE () {
	# Args: <worktree> <cmd> <failed> <orig_head> <new_head> <secs> `--` [<path>...]
	local WT=$1
	local CMD=$2
	local FAILED=$3
	local ORIG=$4
	local NEW=$5
	local SECS=$6
	shift 6
	[ "$1" = "--" ] && shift
	local -a PATHS=("$@")

	local CP=$(_VERIFY_COUNTERPART "$FAILED" "$ORIG" "$NEW")
	local P
	# A counterpart lacking a path the command names fails on that alone – the walk then answers
	for P in "${PATHS[@]}"; do
		git -C "$WT" cat-file -e "$CP:$P" 2>/dev/null || CP=""
	done
	if [ -n "$CP" ] && git -C "$WT" checkout -qf --detach "$CP" 2>/dev/null; then
		(cd "$WT" && export GIT_EDIT_VERIFY_COMMIT=$CP && _CALLER_ENV_BACK && eval "$CMD" </dev/null) >/dev/null 2>&1
		local CP_RC=$?
		_VERIFY_CLEAN "$WT"
		if [ $CP_RC -ne 0 ]; then
			PRINT_TEXT "The commit it replaces fails the same check – not this operation's doing (pre-existing, or the check cannot run in this worktree):" 33
			_PRINT_COMMIT_LINE "$CP" '  counterpart: %h %s'
			# Naming the cause without the remedy leaves the reader to find it in the page. The
			# commonest one is what a fresh worktree does not have – said only where nothing is
			# linked at all, so a repo that configured it hears nothing
			if [ -z "$(git config --get-all edit.worktreeLink 2>/dev/null)" ] && [ -z "$GIT_EDIT_WORKTREE_LINK" ]; then
				PRINT_TEXT "Nothing is linked into the isolated worktree – a check needing gitignored files fails there on that alone: %s" 33 "git config --add edit.worktreeLink node_modules"
			fi
			return 0
		fi
	fi

	# An explicit zero (or less) turns the climb off – unset, it is five times
	# the failing run's own duration, floored so a fast check still walks
	local BUDGET_CFG=$(git config --type=int --get edit.verifyBudget 2>/dev/null)
	local -i BUDGET
	if [ -n "$BUDGET_CFG" ]; then
		BUDGET=$BUDGET_CFG
		[ $BUDGET -le 0 ] && return 0
	else
		BUDGET=$(( SECS * 5 ))
		[ $BUDGET -lt 30 ] && BUDGET=30
	fi
	local -a SPAN
	SPAN=("${(@f)$(git rev-list --reverse "$ORIG..$NEW" 2>/dev/null)}")
	# Spent against the wall clock, not summed per run – whole-second deltas
	# round a sub-second check down to nothing, and the budget would never bind
	local -i WALK_T0=$SECONDS CHECKED=0 ABOVE=0
	local X FOUND="" PAST=false SKIP
	for X in "${SPAN[@]}"; do
		if [ "$X" = "$FAILED" ]; then
			PAST=true
			continue
		fi
		[ "$PAST" = "true" ] || continue
		ABOVE+=1
		[ -n "$FOUND" ] && continue
		[ $(( SECONDS - WALK_T0 )) -ge $BUDGET ] && continue
		SKIP=false
		for P in "${PATHS[@]}"; do
			git -C "$WT" cat-file -e "$X:$P" 2>/dev/null || SKIP=true
		done
		[ "$SKIP" = "true" ] && continue
		git -C "$WT" checkout -qf --detach "$X" 2>/dev/null || continue
		CHECKED+=1
		(cd "$WT" && export GIT_EDIT_VERIFY_COMMIT=$X && _CALLER_ENV_BACK && eval "$CMD" </dev/null) >/dev/null 2>&1 && FOUND=$X
		_VERIFY_CLEAN "$WT"
	done
	if [ -n "$FOUND" ]; then
		PRINT_TEXT "The check passes again above it – that commit carries what the failing one now needs:" 33
		_PRINT_COMMIT_LINE "$FOUND" '  first green: %h %s'
	elif [ $CHECKED -gt 0 ]; then
		PRINT_TEXT "No commit above it passes either – %s of %s checked within the walk budget" 33 "$CHECKED" "$ABOVE"
	fi
	return 0
}

# Runs the caller's verification over what a rewrite built, before the CAS applies it – the
# gate for a result that landed semantically wrong yet green, taking `--verify=<cmd>` or a
# standing `edit.verifyCmd`, at the commits a mode names, first rebuilt and resolved ones, the tip
_VERIFY_REWRITE () {
	# Args: <worktree> <new_head> <orig_head> [<commits the mode names, space-separated>]
	#       [<base a replant replayed onto>]
	local WT=$1
	local NEW_HEAD=$2
	local ORIG_HEAD=$3
	local PRIMARY=$4
	# A replant's new base brings the commits its upstream gained, which this run never built –
	# the range the gate reads leaves them out
	local -a BUILT_RANGE=("$NEW_HEAD" --not "$ORIG_HEAD" ${5:+"$5"})
	[ -z "$WT" ] && return 0
	# A worktree gone missing reads as no pass where a check is configured
	if [ ! -d "$WT" ]; then
		[ ${#OPT_NO_VERIFY} -eq 0 ] && _VERIFY_CONFIGURED && { PRINT_ERR "No worktree at $WT to verify in – not applied"; return 1; }
		return 0
	fi
	# Below the worktree guard, so the note marks a gate this run declined rather than one the
	# mode never had – `--abort`, `--undo` and `--status` never reach here at all
	[ ${#OPT_NO_VERIFY} -gt 0 ] && { _VERIFY_NOTE_BYPASS; return 0; }
	# Flag first, then what the pause recorded – a resume re-verifies what the
	# original run asked for – then the standing config
	local VERIFY_CMD=$VERIFY_VALUE
	[ -z "$VERIFY_CMD" ] && VERIFY_CMD=$STATE_VERIFY_CMD
	[ -z "$VERIFY_CMD" ] && VERIFY_CMD=$(git config --get edit.verifyCmd 2>/dev/null)
	# A pause persists the command as one `key=value` line, and a resume would
	# read back only its first line – a truncated check that can still exit 0
	if [ "$VERIFY_CMD" != "${VERIFY_CMD%%$'\n'*}" ]; then
		PRINT_ERR "The verify command spans multiple lines – a pause could only carry its first"
		ECHO_E "\e[0;31m  Put it in a script and name that instead.\e[0m" >&2
		exit 1
	fi
	if [ -z "$VERIFY_CMD" ]; then
		# Only an explicit ask is an error here – a standing `edit.verifySpan`
		# names a tier, not a check, so with no command it stays inert rather
		# than refusing every operation in the repo that set it
		if [ ${#OPT_VERIFY_SPAN} -gt 0 ] || [ "$STATE_VERIFY_SPAN" = "1" ]; then
			PRINT_ERR "--verify-span needs a command – pass --verify=<cmd> or set edit.verifyCmd"
			exit 1
		fi
		return 0
	fi
	local -a COMMITS
	local SPANNED=false
	# Unquoted, so an empty span yields no element – the quoted form yields one blank
	local -a REBUILT=(${(f)"$(git rev-list --reverse "${BUILT_RANGE[@]}" 2>/dev/null)"})
	if _VERIFY_SPAN_ON; then
		COMMITS=("${REBUILT[@]}")
		[ ${#COMMITS[@]} -gt 0 ] && SPANNED=true
	fi
	# The commits the mode names, and the first one it rebuilt, which a commit moved up or
	# dropped leaves without what sat below it
	local -a PRIMARIES=(${=PRIMARY} ${REBUILT[1]})
	# Every rebuilt commit carrying a tree a resolver staged – git replayed the rest, and a later
	# commit can heal a wrong resolution before the tip ever shows it
	local -a RESOLVED_TREES=(${=STATE_RESOLVED}) RESOLVED_HITS=()
	local LINE H
	if [ ${#RESOLVED_TREES[@]} -gt 0 ]; then
		for LINE in ${(f)"$(git log --reverse --topo-order --format='%H %T' "${BUILT_RANGE[@]}" 2>/dev/null)"}; do
			H=${LINE%% *}
			[ "$H" = "$NEW_HEAD" ] && continue
			(( ${RESOLVED_TREES[(Ie)${LINE#* }]} )) && RESOLVED_HITS+=("$H")
		done
	fi
	# What the default tier runs – those, the resolved ones and the tip, in history order so the
	# oldest failure is the one it stops at – so the span tier can state what it ran beyond that
	local -a DEFAULT_SET=()
	for H in "${REBUILT[@]}"; do
		[ "$H" != "$NEW_HEAD" ] && (( ${PRIMARIES[(Ie)$H]} || ${RESOLVED_HITS[(Ie)$H]} )) && DEFAULT_SET+=("$H")
	done
	# A primary the replay didn't rebuild still runs, first as it always did
	for H in "${PRIMARIES[@]}"; do
		[ "$H" = "$NEW_HEAD" ] || (( ${DEFAULT_SET[(Ie)$H]} )) || DEFAULT_SET=("$H" "${DEFAULT_SET[@]}")
	done
	DEFAULT_SET+=("$NEW_HEAD")
	local -i DEFAULT_N=${#DEFAULT_SET[@]}
	# A span is empty where the result is a commit the branch already had – a dropped tip
	# rebuilds nothing – and the tip it lands is still checked, as on the default tier
	local -i RESOLVED_N=0
	if [ ${#COMMITS[@]} -eq 0 ]; then
		COMMITS=("${DEFAULT_SET[@]}")
		RESOLVED_N=${#RESOLVED_HITS[@]}
	fi
	# Repo files the command references – each token, a leading `-flag=` or `./` stripped, that
	# names a path at the result tip, since a verified commit missing one can only die on it
	# spuriously, so it skips with a note and the tip itself always runs
	local -a CMD_PATHS=()
	local TOK
	local P
	for TOK in ${(z)VERIFY_CMD}; do
		P=${(Q)TOK}
		P=${P#-*=}
		P=${P#./}
		[ -n "$P" ] && git -C "$WT" cat-file -e "$NEW_HEAD:$P" 2>/dev/null && CMD_PATHS+=("$P")
	done
	PRINT_CMD "$VERIFY_CMD # verify ${#COMMITS[@]} commit(s)" 90
	local C
	local OUT
	local OUT_FILE
	local ABSENT
	local RUN_T0
	_VERIFY_LITTER=()
	local -i SKIPPED=0
	local -i RC=0 RUN_SECS=0
	local -i POSITION=0
	# The whole gate's clock – the price a caller learns from this run and spends on the next
	local -i VERIFY_T0=$SECONDS
	# A resume reads the worktree's `HEAD` as the result, which each check below moves – so a pause
	# this run holds records the result first, for the resume after a run cut off midway – never a
	# gate with no pause to resume, as a split's checks in a throwaway worktree
	if [ "$STATE_VERIFY_RESULT" != "$NEW_HEAD" ] && [ "$_VERIFY_NO_RESUME" != true ]; then
		_STATE_NOTE "verify_result=$NEW_HEAD"
		[ -n "$_STATE_OWNED" ] && STATE_VERIFY_RESULT=$NEW_HEAD
	fi
	for C in "${COMMITS[@]}"; do
		POSITION+=1
		ABSENT=""
		for P in "${CMD_PATHS[@]}"; do
			if ! git -C "$WT" cat-file -e "$C:$P" 2>/dev/null; then
				ABSENT=$P
				break
			fi
		done
		if [ -n "$ABSENT" ]; then
			PRINT_TEXT "Verify skipped at %s – \`%s\` doesn't exist at this commit" 90 "${C:0:7}" "$ABSENT"
			SKIPPED+=1
			continue
		fi
		if ! git -C "$WT" checkout -qf --detach "$C" 2>/dev/null; then
			PRINT_ERR "Cannot check out ${C:0:7} for verification"
			_VERIFY_FAILED=$C
			return 1
		fi
		# Named as its check starts, since the span tier can run for minutes – on a terminal, or
		# where a caller showing progress sets `GIT_EDIT_PROGRESS`, as a captured run would carry a
		# line per commit that nobody watches live
		if [ -t 1 ] || [ -n "$GIT_EDIT_PROGRESS" ]; then
			# Through `git log`, as `ECHO_E` would read escapes in the subject, and not as "Verif…",
			# which the documented `^(Verif|git-edit:)` grep keeps to the outcome
			_PRINT_COMMIT_LINE "$C" "Checking $POSITION of ${#COMMITS[@]} – %h %s"
		fi
		# The subshell contains both the cd and the export naming the commit – exported, since a
		# prefix assignment on the `eval` builtin never reaches the child it forks
		# Into a file, as `$(…)` would wait on every process holding its pipe –
		# a server the check left running included
		OUT_FILE=$(MKTEMP_FILE git-edit-verify-out) || exit 1
		_TEMP_FILES+=("$OUT_FILE")
		RUN_T0=$SECONDS
		(cd "$WT" && export GIT_EDIT_VERIFY_COMMIT=$C && _CALLER_ENV_BACK && eval "$VERIFY_CMD" </dev/null) >"$OUT_FILE" 2>&1
		RC=$?
		OUT=$(<"$OUT_FILE")
		rm -f "$OUT_FILE"
		_VERIFY_CLEAN "$WT"
		# Taken here rather than at the diagnosis below, which the printing in
		# between would pad – the walk budget is the failing run's own duration
		RUN_SECS=$(( SECONDS - RUN_T0 ))
		if [ $RC -ne 0 ]; then
			PRINT_ERR "Verification failed at ${C:0:7} – nothing was applied"
			_PRINT_COMMIT_LINE "$C" '  failing: %h %s'
			[ -n "$OUT" ] && print -r -- "$OUT" | tail -15 | _CARET_LINES --crlf | LC_ALL=C sed "s/^/${_DIM}  | /;s/\$/${_OFF}/" >&2
			PRINT_TEXT "Command: %s (exit %s, %ss)" 33 "$VERIFY_CMD" "$RC" "$RUN_SECS"
			_VERIFY_SAVE_LOG "$C" "$VERIFY_CMD" "$RC" "$RUN_SECS" "$OUT"
			# Attribution and the healing point, run in the worktree the gate already owns – then back
			# to the result tip, since every resume path reads the worktree's `HEAD` as the result,
			# and one left at a walked commit would land that commit as the new tip
			_VERIFY_DIAGNOSE "$WT" "$VERIFY_CMD" "$C" "$ORIG_HEAD" "$NEW_HEAD" "$RUN_SECS" -- "${CMD_PATHS[@]}"
			_VERIFY_NOTE_LITTER
			git -C "$WT" checkout -qf --detach "$NEW_HEAD" 2>/dev/null
			# A mode with no pause keeps neither the worktree nor a resume, so both hints
			# would point at what its exit is about to remove – it names its own recourse
			if [ "$_VERIFY_NO_RESUME" != true ]; then
				PRINT_TEXT "Inspect the failing state: %s" 33 "git -C $WT checkout ${C:0:7}"
				# The content-edit pause invites exactly the opposite instinct, so say
				# which one this is: the result is built, and a resume checks out over
				# anything authored here
				PRINT_TEXT "Editing there is not the repair – a resume refuses rather than fold it in. Apply with %s, then fix that commit with %s" 33 \
					"--no-verify --continue" "git edit ${C:0:7}"
			fi
			_VERIFY_FAILED=$C
			return 1
		fi
	done
	local -i VERIFY_SECS=$(( SECONDS - VERIFY_T0 ))
	_VERIFY_NOTE_LITTER
	# End at the tip, so the worktree a later step or reader sees is the result
	git -C "$WT" checkout -qf --detach "$NEW_HEAD" 2>/dev/null
	# One line for the whole outcome, since that is the line a caller greps: a bare "Verified 2
	# commit(s)" over a span of seven reads as verified when it was sampled, and a second line
	# carrying the shortfall is a second line to miss. So the denominator is what the rewrite
	# built, and every commit short of it is named with its reason – the tier that closes the
	# gap included, which helps nobody who never learns it exists. A dropped tip rebuilds
	# nothing while still verifying where it lands, so the built count can be the lower one
	local RAN=$(( ${#COMMITS[@]} - SKIPPED ))
	local BUILT=$(git rev-list --count "${BUILT_RANGE[@]}" 2>/dev/null)
	local -i TOTAL=${#COMMITS[@]}
	if [ -n "$BUILT" ] && [ $BUILT -gt $TOTAL ]; then
		TOTAL=$BUILT
	fi
	local -a SHORT=()
	[ $RESOLVED_N -gt 0 ] && SHORT+=("$RESOLVED_N of them resolved at a stop")
	[ $SKIPPED -gt 0 ] && SHORT+=("$SKIPPED skipped where a path the command names is absent")
	[ $(( TOTAL - ${#COMMITS[@]} )) -gt 0 ] && SHORT+=("$(( TOTAL - ${#COMMITS[@]} )) unchecked in between, \`--verify-span\` covers them (also: edit.verifySpan)")
	# The span tier's mirror of that note: what it ran beyond the default tier, with the lever
	# that steps one run back down – only where the standing config raised the tier, since a
	# run that passed the flag chose the cost. The elapsed rides on every line, both tiers: a
	# caller picks its flags before running, so the price that reaches it in time is the
	# previous run's
	local -i BEYOND=$(( ${#COMMITS[@]} - DEFAULT_N ))
	if [ "$SPANNED" = true ] && [ $BEYOND -gt 0 ] && [ ${#OPT_VERIFY_SPAN} -eq 0 ] \
		&& [ "$(git config --type=bool --get edit.verifySpan 2>/dev/null)" = "true" ]; then
		SHORT+=("$BEYOND beyond the default tier, \`--no-verify-span\` runs only its $DEFAULT_N (set by edit.verifySpan)")
	fi
	local FMT="Verified %s commit(s) with \`%s\` in %ss"
	local -a ARGS=("$RAN" "$VERIFY_CMD" "$VERIFY_SECS")
	if [ $RAN -lt $TOTAL ]; then
		FMT="Verified %s of %s commit(s) with \`%s\` in %ss"
		ARGS=("$RAN" "$TOTAL" "$VERIFY_CMD" "$VERIFY_SECS")
	fi
	if [ ${#SHORT[@]} -gt 0 ]; then
		FMT+=" – %s"
		ARGS+=("${(j:, :)SHORT}")
	fi
	PRINT_TEXT "$FMT" 90 "${ARGS[@]}"
	return 0
}

# `--continue` and `--abort` often run from inside the operation's own worktree, where
# `HEAD` is a detached commit rather than the branch – so the trailer's "before" comes
# from the branch the operation will move, and it is a no-op from the main checkout
_REANCHOR_INITIAL_HEAD () {
	local TIP
	TIP=$(git rev-parse "${STATE_BRANCH:-HEAD}" 2>/dev/null)
	[ -n "$TIP" ] && SCRIPT_INITIAL_HEAD=$TIP
}

# Resumes an in-flight `--amend-into` once the conflicts are resolved – the caller edits
# the files in `$STATE_WORKTREE` and stages them before calling this
_CONTINUE_AMEND_INTO () {
	# The reword happens before the replay starts, so the commits being
	# resolved already carry the message – accepting one here would silently
	# do nothing
	if [ -n "$TEXT_VALUE" ]; then
		PRINT_ERR "--amend-into takes --text up front, not on --continue – the replay already carries the message"
		ECHO_E "\e[0;31m  Finish this fold, then reword: git edit -M --text=\"…\" <sha>\e[0m" >&2
		exit 1
	fi

	if [ ! -d "$STATE_WORKTREE" ]; then
		PRINT_ERR "Worktree no longer exists: $STATE_WORKTREE"
		_CLEAR_STATE
		exit 1
	fi

	cd "$STATE_WORKTREE" || exit 1

	# Once we successfully complete, the worktree should be cleaned up
	_CLEANUP_HOOK="git worktree remove --force ${(q-)STATE_WORKTREE} 2>/dev/null; rm -rf ${(q-)STATE_WORKTREE}"

	PRINT_ACTION "Continuing amend-into of %s..." "${STATE_TARGET:0:7}"

	# If no rebase is in progress but `HEAD` has moved on, the resolution was
	# completed manually (e.g. `git rebase --continue` run in the worktree
	# directly) – skip straight to applying the result instead of stranding it
	local GITDIR=$(git rev-parse --git-dir 2>/dev/null)
	if [ ! -d "$GITDIR/rebase-merge" ] && [ ! -d "$GITDIR/rebase-apply" ]; then
		_REQUIRE_REPLAY_DONE "$STATE_WORKTREE"
		if [ "$(git rev-parse HEAD)" = "$STATE_ORIG_HEAD" ]; then
			# Finished with nothing to apply – e.g. the fixup went empty, got
			# skipped, and every remaining pick fast-forwarded
			_CLEAR_STATE
			PRINT_TEXT "%s – branch unchanged." 33 "Rebase finished with nothing to apply"
			EMIT_STATUS "$STATE_ORIG_HEAD" "$STATE_BRANCH" false
			exit 0
		fi
		# Back on the fold's own fixup – a `git rebase --abort` in the worktree – nothing was folded
		[ -n "$STATE_FIXUP" ] && [ "$(git rev-parse HEAD)" = "$STATE_FIXUP" ] && _REFUSE_HAND_ABORT
		PRINT_TEXT "%s – applying its result." 33 "Rebase already completed in worktree"
	else
		_GUARD_RESOLUTION_CLEAN "$STATE_WORKTREE"
		_GUARD_STOP_MODES "$STATE_WORKTREE"
		_NOTE_RESOLVED_TREE "$STATE_WORKTREE"
		_RESUME_EDITOR "$STATE_WORKTREE"
		local CMD="GIT_SEQUENCE_EDITOR=true GIT_EDITOR=${(q)REPLY} git -c commit.cleanup=whitespace -c rerere.enabled=true -c rerere.autoUpdate=false -c rebase.updateRefs=false $_CAPTURE_PINS rebase --continue"
		PRINT_CMD "$CMD"
		local CONTINUE_OUTPUT
		if ! CONTINUE_OUTPUT=$( export LC_ALL=C; eval "$CMD" 2>&1 ) && \
		   ! { _AUTO_RESOLVE_FINAL_STEP "$STATE_WORKTREE" "$STATE_STAGEDTREE" guard-empty && _FINISH_AUTO_RESOLVED_STEP "$STATE_WORKTREE" "staged" }; then
			# Another conflict downstream – keep state, keep worktree, exit
			_CLEANUP_HOOK=""
			PRINT_ERR "Conflict continues – resolve more files, then 'git edit --continue'"
			PRINT_TEXT "Worktree: %s" 33 "$STATE_WORKTREE"
			local UNMERGED_LIST=$(_PRINT_CONFLICT_DETAIL "$STATE_WORKTREE" "" "$CONTINUE_OUTPUT")
			PRINT_TEXT "Or abort the operation: %s" 33 "git edit --abort"
			EMIT_CONFLICT "$STATE_WORKTREE" "$UNMERGED_LIST"
			_PAUSE_EXIT 2 conflict
		fi
	fi

	local NEW_HEAD=$(git rev-parse HEAD)

	local VERIFY_PRIMARY=""
	if [ "$STATE_REBASEBASE" = "--root" ]; then
		VERIFY_PRIMARY=$(git rev-list --reverse "$NEW_HEAD" 2>/dev/null | head -1)
	elif [ -n "$STATE_REBASEBASE" ]; then
		VERIFY_PRIMARY=$(git rev-list --reverse "$STATE_REBASEBASE..$NEW_HEAD" 2>/dev/null | head -1)
	fi
	if ! _GUARD_TIP_MODES "$STATE_WORKTREE" "$NEW_HEAD" "$STATE_ORIG_HEAD" "$(_MODE_LINES "$STATE_WORKTREE" "$STATE_ORIG_HEAD" "$STATE_STAGEDTREE")" || ! _VERIFY_REWRITE "$STATE_WORKTREE" "$NEW_HEAD" "$STATE_ORIG_HEAD" "$VERIFY_PRIMARY"; then
		_CLEANUP_HOOK=""
		EMIT_GATE_PAUSED "$STATE_WORKTREE" "$NEW_HEAD"
		_PAUSE_EXIT 2 gate
	fi

	# Atomic CAS-update of the branch ref – new-format states guard on the pre-op tip, the
	# branch never having moved, while legacy states guard on the fixup tip
	local GUARD=$STATE_ORIG_HEAD
	[ -n "$STATE_HEAD_WITH_FIXUP" ] && GUARD=$STATE_HEAD_WITH_FIXUP
	local UPDATE_CMD="git update-ref -m ${(q-)${:-git edit: amend-into ${STATE_TARGET:0:7}$_REFLOG_TAG}} ${(q-)STATE_BRANCH} ${(q-)NEW_HEAD} ${(q-)GUARD}"
	# A run cut off after its landing left the branch at this very result –
	# it landed, and only the record of it is missing
	if [ "$(git rev-parse "$STATE_BRANCH" 2>/dev/null)" = "$NEW_HEAD" ]; then
		PRINT_TEXT "%s – completing what it left." 33 "The branch holds this result already, a run landing it cut off"
		local JF=$(_JOURNAL_FILE_PATH)
		[ -n "$JF" ] && command grep -qF " $STATE_BRANCH $GUARD $NEW_HEAD " "$JF" 2>/dev/null || \
			_RECORD_REF_MOVE "$STATE_BRANCH" "$GUARD" "$NEW_HEAD" "amend-into ${STATE_TARGET:0:7}"
	else
		PRINT_CMD "$UPDATE_CMD" 90
		if ! _MOVE_REF "$UPDATE_CMD"; then
			_REFUSE_MOVED_BRANCH "$STATE_BRANCH" "$STATE_WORKTREE"
		fi
		_RECORD_REF_MOVE "$STATE_BRANCH" "$GUARD" "$NEW_HEAD" "amend-into ${STATE_TARGET:0:7}"
	fi

	# Re-sync the folded paths' index entries to the new `HEAD`, those staged changes being
	# history now – path-scoped so a parallel session's staged work survives, and legacy
	# states without a file list fall back to a full reset – a `--tree` fold staged nothing, so
	# the summary reconciles its entries like any other rewrite's instead
	AMEND_TREE=$STATE_TREE
	if [ -n "$STATE_MAINDIR" ] && [ -z "$AMEND_TREE" ]; then
		if [ -n "$STATE_FILES" ]; then
			local -a SYNC_PATHS
			SYNC_PATHS=("${(@ps:\t:)STATE_FILES}")
			_RESYNC_FOLDED "$STATE_MAINDIR" "$STATE_STAGEDTREE" "${SYNC_PATHS[@]}"
		else
			git -C "$STATE_MAINDIR" read-tree --reset "$NEW_HEAD" 2>/dev/null
		fi
	fi

	# The fold's scope decides how the leftover index reads – restore it, or a
	# scoped fold that conflicted would report its intended leftovers as an anomaly
	[ -n "$STATE_PATHSPECS" ] && AMEND_PATHSPECS=("${(@ps:\t:)STATE_PATHSPECS}")
	[ -n "$STATE_DEPTH" ] && _PRINT_AMENDED_SUMMARY "$NEW_HEAD" "$STATE_DEPTH" "" "$STATE_MAINDIR" "$STATE_REBASEBASE" "$STATE_ORIG_HEAD" "$STATE_STAGEDTREE" resolved

	_CLEAR_STATE
	PRINT_COMPLETED "$NEW_HEAD" "$STATE_BRANCH" true
}

# Aborts an in-flight `--amend-into` – abort the paused rebase and remove the worktree, with
# nothing to roll back since the branch never moved and the staging was never consumed
# Legacy pre-invisible-fixup states carry a `head_with_fixup` tip and get the old rollback
_ABORT_AMEND_INTO () {
	PRINT_ACTION "Aborting amend-into of %s..." "${STATE_TARGET:0:7}"
	# A run cut off after its landing left the branch at the worktree's result – there is nothing
	# to take back, only the pause to clear
	local LANDED=""
	_PAUSE_LANDED && LANDED=1

	# Cleanup the worktree (which is in a paused rebase state)
	if [ -d "$STATE_WORKTREE" ]; then
		git -C "$STATE_WORKTREE" rebase --abort 2>/dev/null
		local CMD="git worktree remove --force ${(q-)STATE_WORKTREE} 2>/dev/null; rm -rf ${(q-)STATE_WORKTREE}"
		PRINT_CMD "$CMD" 90
		eval "$CMD"
	fi

	# Legacy-format state only: roll back the fixup commit on the branch, if
	# the ref is still where that old flow left it
	if [ -n "$STATE_HEAD_WITH_FIXUP" ]; then
		local CURRENT=$(git rev-parse "$STATE_BRANCH" 2>/dev/null)
		if [ "$CURRENT" = "$STATE_HEAD_WITH_FIXUP" ]; then
			local UPDATE_CMD="git update-ref -m ${(q-)${:-git edit: abort amend-into$_REFLOG_TAG}} ${(q-)STATE_BRANCH} ${(q-)STATE_ORIG_HEAD} ${(q-)STATE_HEAD_WITH_FIXUP}"
			PRINT_CMD "$UPDATE_CMD" 90
			_MOVE_REF "$UPDATE_CMD"
			git read-tree "$STATE_HEAD_WITH_FIXUP" 2>/dev/null
		else
			PRINT_TEXT "%s – branch moved since fixup; leaving as-is to avoid clobbering other commits." 33 "Note"
		fi
	elif [ -n "$LANDED" ]; then
		PRINT_TEXT "The fold had landed already, its run cut off before clearing the pause – nothing to take back." 33
	else
		if [ -n "$STATE_TREE" ]; then
			PRINT_TEXT "Branch was never touched – the tree is intact, ready to retry." 32
		else
			PRINT_TEXT "Branch was never touched – %s still in place, ready to retry." 32 "$(_FOLD_SOURCE)"
		fi
	fi

	_CLEAR_STATE
	PRINT_TEXT "%s" 32 "Amend-into aborted, state cleared."
	EMIT_STATUS "$STATE_ORIG_HEAD" "$STATE_BRANCH" false
}

# Detects non-interactive execution – an agent, CI or a scripted run – which gets no prompt, sync,
# confirm or editor: no terminal on stdin or stdout, as output piped away hides a prompt, or
# `$CLAUDECODE`, `$CI` or a `GIT_EDIT_ACTOR` label set, backstops for a PTY-allocating agent
_IS_NON_INTERACTIVE () {
	if [ ! -t 0 ] || [ ! -t 1 ]; then return 0; fi
	if [ -n "$CLAUDECODE" ] || [ -n "$CI" ] || [ -n "$GIT_EDIT_ACTOR" ]; then return 0; fi
	return 1
}

# Resolves a usable editor command, matching git's own cascade – `GIT_EDITOR`, `core.editor`,
# `VISUAL` unless the terminal is dumb, `EDITOR`, then vi – skipping the `true` no-op that
# automation commonly sets, which the plumbing modes that need typing could not work with
_RESOLVE_EDITOR () {
	local CAND
	local -a CANDS=("$GIT_EDITOR" "$(git config core.editor 2>/dev/null)")
	[ "$TERM" = dumb ] || CANDS+=("$VISUAL")
	CANDS+=("$EDITOR")
	for CAND in "${CANDS[@]}"; do
		[ -z "$CAND" ] && continue
		[ "$CAND" = "true" ] && continue
		print -r -- "$CAND"
		return 0
	done
	# A dumb terminal gets no vi fallback, as git refuses there too
	[ "$TERM" = dumb ] && return 1
	print -r -- vi
}

# Bails out before opening an editor in a non-TTY context, where it would either no-op
# silently, hang waiting for input as vi or nano do, or open a GUI editor with `-w` and
# never return, or where none resolves – call this right before any path that would open `$EDITOR`
_REQUIRE_TTY_FOR_EDITOR () {
	if _IS_NON_INTERACTIVE; then
		PRINT_ERR "Cannot open editor in non-interactive context (no TTY / agent run)"
		ECHO_E "\e[0;31m  Pass --text \"<msg>\" for an inline message, or --text - to read from stdin.\e[0m" >&2
		exit 1
	fi
	if ! _RESOLVE_EDITOR >/dev/null; then
		PRINT_ERR "Terminal is dumb, but EDITOR unset"
		ECHO_E "\e[0;31m  Set EDITOR, or pass --text \"<msg>\" for an inline message.\e[0m" >&2
		exit 1
	fi
}

# Puts into `REPLY` the comment string `stripspace` strips – the last one configured, either key, and
# `#` for `auto`, as only `git commit` picks another
_COMMENT_STRING () {
	# Asked of git, as git before 2.45 knows no `core.commentString` and strips `#` lines under one
	REPLY=$(print -r -- x | git stripspace -c 2>/dev/null)
	REPLY=${REPLY% x}
	[[ -z "$REPLY" || "$REPLY" == *$'\n'* ]] && REPLY='#'
	return 0
}

# Puts the editor a person types a message in into `_REAL_EDITOR`, once a run – a stand-in running
# it in the caller's own environment, as git starts it in git-edit's, pins and all
_RESOLVE_REAL_EDITOR () {
	[ -n "$_REAL_EDITOR" ] && return 0
	local ED
	ED=$(_RESOLVE_EDITOR) || return 1
	_REAL_EDITOR=$(MKTEMP_FILE git-edit-editor) || return 1
	_TEMP_FILES+=("$_REAL_EDITOR")
	{ print -r -- '#!/bin/sh'; _CALLER_ENV_SH; print -r -- "$ED \"\$@\"" } > "$_REAL_EDITOR"
	chmod +x "$_REAL_EDITOR"
}

# Opens the resolved editor on the given temp file and returns the cleaned-up contents,
# comments stripped and blank lines trimmed – stdout is the result, with user-facing
# output on stderr so it cannot leak into the captured value
_READ_MESSAGE_FROM_EDITOR () {
	local MSG_FILE=$1
	local EDIT_CMD
	EDIT_CMD=$(_RESOLVE_EDITOR) || return 1

	PRINT_CMD "$EDIT_CMD $MSG_FILE" >&2
	( _CALLER_ENV_FULL; eval "$EDIT_CMD \"\$MSG_FILE\"" ) >&2 || return 1

	git stripspace --strip-comments < "$MSG_FILE"
}

# Whether `git replay` can rebuild a span, probed once per run – absent before git 2.44,
# and from 2.53 it updates refs by default, where `--ref-action=print` keeps it a pure
# computation, the flag traveling in `_REPLAY_FLAGS`
_REPLAY_PROBED=""
_REPLAY_FLAGS=()
_REBUILT_VIA_REPLAY=false
_REPLAY_AVAILABLE () {
	if [ -z "$_REPLAY_PROBED" ]; then
		_REPLAY_PROBED=no
		local USAGE=$( export LC_ALL=C; git replay -h 2>&1 )
		if [[ "$USAGE" == *"--advance"* ]]; then
			[[ "$USAGE" == *"--ref-action"* ]] && _REPLAY_FLAGS=(--ref-action=print)
			_REPLAY_PROBED=yes
		fi
	fi
	[ "$_REPLAY_PROBED" = yes ]
}

# Rebuilds a linear `$1..HEAD` in one `git replay` pass where the walk below spawns two
# gits per commit – a 250-deep reword drops from ~3s to ~0.3s, and the result is taken
# only once every replayed commit carries its original's tree, author and message
_REPLAY_REBUILD () {
	local FROM=$1
	[ -n "$GIT_EDIT_NO_REPLAY" ] && return 1
	# The span with each commit's parents – a second parent anywhere is a merge
	# Under five commits the walk's two spawns each undercut this path's probe
	# and proof
	local -a OLD FIELDS
	OLD=("${(@f)$(git rev-list --reverse --parents "$FROM..${2:-HEAD}" 2>/dev/null)}")
	[ ${#OLD[@]} -lt 5 ] && return 1
	local LINE BASE=""
	for LINE in "${OLD[@]}"; do
		FIELDS=(${=LINE})
		[ ${#FIELDS[@]} -ne 2 ] && return 1
		[ -z "$BASE" ] && BASE=${FIELDS[2]}
	done
	OLD=("${OLD[@]%% *}")
	# The walk seeds its map at PREV_OLD, so the span has to rise from there
	[ "$BASE" = "$(git rev-parse "$PREV_OLD" 2>/dev/null)" ] || return 1
	_REPLAY_AVAILABLE || return 1
	# Replayed onto a transient ref of its own, so the branch is never named to a command that
	# could move it, whatever a later git makes the default – a ref an interrupted run left
	# behind is swept once its process is gone
	local STALE
	for STALE in ${(f)"$(git for-each-ref --format='%(refname)' 'refs/git-edit/replay-*' 2>/dev/null)"}; do
		kill -0 "${STALE##*-}" 2>/dev/null || git update-ref -d "$STALE" 2>/dev/null
	done
	local TMPREF="refs/git-edit/replay-$$"
	git update-ref "$TMPREF" "$PREV_NEW" 2>/dev/null || return 1
	local OUT
	OUT=$( export LC_ALL=C; git replay "${_REPLAY_FLAGS[@]}" --advance "$TMPREF" "$FROM..${2:-HEAD}" 2>/dev/null )
	git update-ref -d "$TMPREF" 2>/dev/null
	# "update <ref> <new> <old>" – the third field is the rebuilt tip
	local FIRST=${OUT%%$'\n'*}
	FIELDS=(${=FIRST})
	local NEW_TIP=${FIELDS[3]}
	[ -z "$NEW_TIP" ] && return 1
	# The proof: both spans dump identical, commit for commit
	local FMT='%T%x00%an%x00%ae%x00%aI%x00%B%x00'
	cmp -s <(git log --reverse --format="$FMT" "$FROM..${2:-HEAD}" 2>/dev/null) \
	       <(git log --reverse --format="$FMT" "$PREV_NEW..$NEW_TIP" 2>/dev/null) || return 1
	local -a NEW
	NEW=("${(@f)$(git rev-list --reverse "$PREV_NEW..$NEW_TIP" 2>/dev/null)}")
	[ ${#NEW[@]} -ne ${#OLD[@]} ] && return 1
	PRINT_CMD "git replay --advance ${TMPREF#refs/git-edit/} ${FROM:0:7}..HEAD -> ${NEW_TIP:0:7} # replayed ${#OLD[@]} commit(s) in one pass"
	local i
	for (( i=1; i<=${#OLD[@]}; i++ )); do
		_RECORD_REWRITE "${OLD[$i]}" "${NEW[$i]}"
	done
	PREV_OLD=${OLD[-1]}
	PREV_NEW=$NEW_TIP
	_REBUILT_VIA_REPLAY=true
	return 0
}

# Rebuilds each commit in `$1..HEAD` with every rewritten parent substituted, carrying an
# old->new map across the walk, since a single `PREV_OLD`/`PREV_NEW` chain breaks on merge
# topologies – `--topo-order` guards the parents-before-children walk against clock skew
_REBUILD_DESCENDANTS () {
	# Args: <from> [<tip>] – the tip the walk ends at, `HEAD` unless named
	local FROM=$1 UPTO=${2:-HEAD}
	# One replay where the span is linear and its result proves out – else the walk
	_REPLAY_REBUILD "$FROM" "$UPTO" && return 0
	local DESC P D_NEW D_TOUCHED
	local -a D_PARENTS_ARGS NF
	local -A REWRITTEN
	REWRITTEN[$(git rev-parse "$PREV_OLD")]=$PREV_NEW
	for DESC in $(git rev-list --reverse --topo-order "$FROM..$UPTO"); do
		# One git-log per commit packs tree, parents, author and message, NUL-separated with the
		# message last so `$()` strips its trailing newlines as a bare `%B` capture would, and
		# `(@0)` keeps an empty parents field so a root commit does not shift the author
		NF=("${(@0)$(git log -1 --format='%T%x00%P%x00%an%x00%ae%x00%ad%x00%B' --date=raw "$DESC")}")
		D_PARENTS_ARGS=()
		D_TOUCHED=false
		for P in ${=NF[2]}; do
			if [ -n "${REWRITTEN[$P]}" ]; then
				D_PARENTS_ARGS+=(-p "${REWRITTEN[$P]}")
				D_TOUCHED=true
			else
				D_PARENTS_ARGS+=(-p "$P")
			fi
		done
		if [ "$D_TOUCHED" = "false" ]; then
			continue
		fi

		D_NEW=$(_COMMIT_TREE_AS "$DESC" "${NF[3]}" "${NF[4]}" "${NF[5]}" "${NF[1]}" "${D_PARENTS_ARGS[@]}" -m "${NF[6]}") || _REBUILD_FAILED "$DESC"

		PRINT_CMD "git commit-tree ${NF[1]:0:7} ... -> ${D_NEW:0:7} # rebuilt ${DESC:0:7}"

		REWRITTEN[$DESC]=$D_NEW
		_RECORD_REWRITE "$DESC" "$D_NEW"
		PREV_OLD=$DESC
		PREV_NEW=$D_NEW
	done
}

# Rewords commit `$1` to message `$2` and rebuilds everything above it, leaving the
# rewritten commit in `$_REWORDED_TARGET` and the new tip in `$_REWORDED_TIP`, moving no
# ref – so `--amend-into` folds and rewords under one ref update rather than two
_REWORD_AND_REBUILD () {
	local AT=$1
	local MSG=$2
	local TREE=$(git rev-parse "$AT^{tree}")
	local PARENTS_ARGS=()
	local P
	for P in $(git log -1 --format='%P' "$AT"); do
		PARENTS_ARGS+=(-p "$P")
	done

	local -a AA=("${(@0)$(git log -1 --format='%an%x00%ae%x00%ad' --date=raw "$AT")}")
	PREV_NEW=$(_COMMIT_TREE_AS "$AT" "${AA[1]}" "${AA[2]}" "${AA[3]}" "$TREE" "${PARENTS_ARGS[@]}" -m "$MSG") || _REBUILD_FAILED "$AT"
	PRINT_CMD "git commit-tree ${TREE:0:7} ... -> ${PREV_NEW:0:7} # reworded ${AT:0:7}"
	_REWORDED_TARGET=$PREV_NEW
	_RECORD_REWRITE "$AT" "$PREV_NEW"

	PREV_OLD=$AT
	_REBUILD_DESCENDANTS "$AT"
	_REWORDED_TIP=$PREV_NEW
}

# Rewrites just `$COMMIT`'s message and rebuilds any descendants on top, plumbing only –
# no checkout, no stash, no rebase, so the working tree is never touched, and atomic
# from the caller's view: a single ref update at the end, only if the branch has not moved
GIT_REWORD () {
	local TARGET=$COMMIT

	# Capture the ref to update (branch if attached, `HEAD` if detached)
	local ORIG_HEAD=$(git rev-parse HEAD)
	_REQUIRE_IN_TIP "$ORIG_HEAD" "$TARGET"
	local BRANCH=${$(git symbolic-ref -q HEAD 2>/dev/null)#refs/heads/}
	local REF
	if [ -n "$BRANCH" ]; then
		REF="refs/heads/$BRANCH"
	else
		REF="HEAD"
	fi

	# Refuse if the target isn't reachable from `HEAD`
	if ! git merge-base --is-ancestor "$TARGET" HEAD 2>/dev/null; then
		PRINT_ERR "Commit ${TARGET:0:7} is not reachable from HEAD"
		exit 1
	fi

	_GUARD_UNPUSHED "$TARGET"

	local NEW_MSG
	if [ -n "$TEXT_VALUE" ]; then
		# --text supplied: use directly, no editor
		NEW_MSG="$TEXT_VALUE"
	else
		_REQUIRE_TTY_FOR_EDITOR
		# Open the caller's editor on a temp file seeded with the current message – named
		# `COMMIT_EDITMSG`, git's convention, inside a temp dir, so editors apply commit-message
		# syntax highlighting from the recognized filename
		local TMP_DIR
		TMP_DIR=$(MKTEMP_DIR git-edit-reword) || exit 1
		local MSG_FILE="$TMP_DIR/COMMIT_EDITMSG"
		git log -1 --format='%B' "$TARGET" > "$MSG_FILE"
		_COMMENT_STRING
		local CC=$REPLY
		{
			print -r -- ""
			print -r -- "$CC Please enter the new commit message for ${TARGET:0:7}."
			print -r -- "$CC Lines starting with '$CC' will be ignored."
			print -r -- "$CC An empty message aborts the operation."
		} >> "$MSG_FILE"

		NEW_MSG=$(_READ_MESSAGE_FROM_EDITOR "$MSG_FILE")
		rm -rf "$TMP_DIR"

		if [ -z "$NEW_MSG" ]; then
			PRINT_ERR "Empty message – aborting"
			exit 1
		fi
	fi

	local ORIG_MSG=$(git log -1 --format='%B' "$TARGET" | git stripspace)
	if [ "$NEW_MSG" = "$ORIG_MSG" ]; then
		ECHO_E "${_PAD}\e[0;33mMessage unchanged – nothing to do.\e[0m"
		EMIT_STATUS "$ORIG_HEAD" "$REF" false
		exit 0
	fi

	# Build the new target commit: same tree + parents + author, new message
	local TREE=$(git rev-parse "$TARGET^{tree}")
	local PARENTS_ARGS=()
	local P
	for P in $(git log -1 --format='%P' "$TARGET"); do
		PARENTS_ARGS+=(-p "$P")
	done

	local -a TA=("${(@0)$(git log -1 --format='%an%x00%ae%x00%ad' --date=raw "$TARGET")}")
	local NEW_TARGET
	NEW_TARGET=$(_COMMIT_TREE_AS "$TARGET" "${TA[1]}" "${TA[2]}" "${TA[3]}" "$TREE" "${PARENTS_ARGS[@]}" -m "$NEW_MSG") || _REBUILD_FAILED "$TARGET"

	PRINT_CMD "git commit-tree ${TREE:0:7} ... -> ${NEW_TARGET:0:7}"

	_RECORD_REWRITE "$TARGET" "$NEW_TARGET"

	# Walk every descendant of `$TARGET` up to `HEAD`, rebuild with new parent
	PREV_OLD=$TARGET
	PREV_NEW=$NEW_TARGET
	_REBUILD_DESCENDANTS "$TARGET"

	# Atomic compare-and-swap on the ref – refuse where the branch moved under us, such as a
	# concurrent commit landing from another tool
	local CMD="git update-ref -m ${(q-)${:-git edit: reword ${TARGET:0:7}$_REFLOG_TAG}} ${(q-)REF} ${(q-)PREV_NEW} ${(q-)ORIG_HEAD}"
	PRINT_CMD "$CMD"
	if ! _MOVE_REF "$CMD"; then
		PRINT_ERR "Ref '$REF' moved during reword – refusing to overwrite"
		PRINT_TEXT "Reworded history is at %s (not applied)." 33 "$PREV_NEW"
		exit 1
	fi
	_RECORD_REF_MOVE "$REF" "$ORIG_HEAD" "$PREV_NEW" "reword ${TARGET:0:7}"
	# The walk reuses every commit's tree object verbatim, so this holds by construction, and a
	# replay's result was proven against the originals before it was taken – stated so callers
	# do not re-verify with a diff, and claiming nothing beyond the tree
	if [ "$_REBUILT_VIA_REPLAY" = "true" ]; then
		PRINT_TEXT "%s – proven commit for commit, rebuilt in one replay as new objects." 32 "Trees unchanged ✓"
	else
		PRINT_TEXT "%s – no file content changed, though the affected commits are rebuilt as new objects." 32 "Trees unchanged by construction ✓"
	fi
	# The message is the entire point of the mode, so show the one that landed, or the caller
	# reads it back with `git log` to be sure it took – `$NEW_TARGET` is the rebuilt commit
	# itself, since deriving it by offset walks first parents and a merge names the wrong one
	if [ -n "$NEW_TARGET" ]; then
		_PRINT_COMMIT_LINE "$NEW_TARGET" '  %h %s'
		local BODY_LINES=$(git log -1 --format='%b' "$NEW_TARGET" | grep -c .)
		if [ "$BODY_LINES" -gt 0 ]; then
			git log -1 --format='%b' "$NEW_TARGET" | LC_ALL=C grep -a . | _CARET_LINES | LC_ALL=C sed "s/^/${_DIM}    /;s/\$/${_OFF}/"
		fi
		# Name the subject that was replaced – a symbolic target resolves once at invocation, so a
		# commit landing between the caller's read and this call is silently reworded instead,
		# which the CAS cannot catch, and the old subject puts that in the output they read back
		local OLD_SUBJECT=$(git log -1 --format='%s' "$TARGET" 2>/dev/null)
		if [ -n "$OLD_SUBJECT" ]; then
			_PRINT_COMMIT_LINE "$TARGET" '  replaced: %s'
		fi
		# `--text` replaces the whole message, not just the subject, so a body
		# line the caller did not restate is gone – both lines above are
		# subjects, so a caller comparing those reads the reword as clean
		_PRINT_LOST_BODY "The replaced message" "$TARGET" "$(git log -1 --format='%B' "$NEW_TARGET")"
	fi
}


# Answers whether `--text` or stdin carries `--- <commit>` records rather than one message – a
# `--- ` line at column 0 with a token after it is the batch reword's record header, and
# its absence leaves the ordinary single-message form
_LOOKS_LIKE_RECORDS () {
	# A here-string, as every `grep -q` on a variable here takes – piped, a text past the pipe
	# buffer lost its writer to SIGPIPE at grep's early match, and `pipefail` made that a miss
	grep -q '^--- .' <<<"$1"
}

# Rewords many commits in one plumbing pass, reading `--- <commit>` records from `--text`
# in place of a positional target – each record is a header then that commit's new
# message, exactly what `git log --format='--- %h%n%B'` emits, all-or-nothing on a miss
GIT_REWORD_BATCH () {
	local ORIG_HEAD=$(git rev-parse HEAD)
	local REF=$(_CURRENT_REF)

	# Parse records – lines before the first header are ignored, a blank line inside a message
	# is kept, and only the header token's trailing whitespace is trimmed, since its body may
	# carry spaces itself, as `:/some subject` does
	local -a REC_LINES=("${(@f)RAW_TEXT_VALUE}")
	local -a REC_REFS=() REC_MSGS=()
	local L cur_ref="" cur_msg="" have=0
	for L in "${REC_LINES[@]}"; do
		if [[ "$L" == '--- '* ]]; then
			[ "$have" -eq 1 ] && { REC_REFS+=("$cur_ref"); REC_MSGS+=("$cur_msg"); }
			cur_ref=$(print -r -- "${L#--- }" | LC_ALL=C sed 's/[[:space:]]*$//')
			cur_msg=""
			have=1
		elif [ "$have" -eq 1 ]; then
			if [ -z "$cur_msg" ]; then
				cur_msg="$L"
			else
				cur_msg="$cur_msg"$'\n'"$L"
			fi
		fi
	done
	[ "$have" -eq 1 ] && { REC_REFS+=("$cur_ref"); REC_MSGS+=("$cur_msg"); }

	if [ ${#REC_REFS[@]} -eq 0 ]; then
		PRINT_ERR "No records on stdin – expected '--- <commit>' headers"
		exit 1
	fi

	# Resolve, guard and de-duplicate every target before writing anything – `_GUARD_REACHABLE`
	# maps a stale SHA to its current identity and exits on a miss, while the pushed and empty
	# checks reject the whole batch, and a record matching its commit is dropped unrebuilt
	local -A SEEN MSG_MAP
	local -a TARGETS=()
	local i n=${#REC_REFS[@]}
	local ref raw msg sha cur
	# Resolve pushed-ness once for the whole batch – commits reachable from `HEAD` but not from
	# any remote-tracking ref are exactly the unpushed run, so membership answers each target
	# locally, and a target that misses the set falls back to `_GUARD_UNPUSHED`
	local -A UNPUSHED
	local _check_pushed=false _u
	if [ ${#OPT_ALLOW_PUSHED} -eq 0 ] && [ -n "$(git for-each-ref --count=1 refs/remotes 2>/dev/null)" ]; then
		_check_pushed=true
		for _u in ${(f)"$(git rev-list HEAD --not --remotes 2>/dev/null)"}; do
			UNPUSHED[$_u]=1
		done
	fi
	for ((i = 1; i <= n; i++)); do
		raw="${REC_REFS[i]}"
		# Resolve to a commit object first, as the positional path does – a `:/subject` or short ref
		# becomes a full SHA, while a stale one is left for `_GUARD_REACHABLE` to map or refuse
		# A header resolving to nothing is refused outright rather than skipping its commit
		ref=$(git rev-parse --verify --quiet "$raw" 2>/dev/null)
		[ -z "$ref" ] && ref="$raw"
		_GUARD_REACHABLE "$ref"
		sha="$_RESOLVED_SHA"
		if ! git rev-parse --verify --quiet "${sha}^{commit}" >/dev/null 2>&1; then
			PRINT_ERR "Record header '${raw}' did not resolve to a commit"
			exit 1
		fi
		if [ "$_check_pushed" = true ] && [ -z "${UNPUSHED[$sha]+x}" ]; then
			_GUARD_UNPUSHED "$sha"
		fi
		msg=$(print -r -- "${REC_MSGS[i]}" | git stripspace)
		if [ -z "$msg" ]; then
			PRINT_ERR "Record for ${raw} has an empty message"
			exit 1
		fi
		if [ -n "${SEEN[$sha]+x}" ]; then
			PRINT_ERR "Commit ${sha:0:7} is named by two records"
			exit 1
		fi
		SEEN[$sha]=1
		cur=$(git log -1 --format='%B' "$sha" | git stripspace)
		# The `--- ` line is this format's record separator, so a commit whose own message carries
		# one cannot be represented – its dump would split mid-body and mis-attribute the
		# remainder, so refuse it here and name the single form, which has no separator
		if grep -q '^--- ' <<<"$cur"; then
			PRINT_ERR "Commit ${sha:0:7}'s message has a '--- ' line, which the record format reserves"
			ECHO_E "\e[0;31m  Reword it on its own instead: git edit -M ${sha:0:9}\e[0m" >&2
			exit 1
		fi
		if [ "$msg" = "$cur" ]; then
			continue
		fi
		MSG_MAP[$sha]="$msg"
		TARGETS+=("$sha")
	done

	if [ ${#TARGETS[@]} -eq 0 ]; then
		ECHO_E "${_PAD}\e[0;33mAll messages already match – nothing to do.\e[0m"
		EMIT_STATUS "$ORIG_HEAD" "$REF" false
		exit 0
	fi

	# Walk from just below the oldest target up to `HEAD`, rebuilding a commit where it is a
	# target or has a rewritten parent – carrying the old->new map across the walk is what
	# lets a merge topology rebuild, and the tree is always reused verbatim
	local OLDEST=$(git rev-list --reverse --topo-order HEAD 2>/dev/null \
		| grep -Fx -f <(printf '%s\n' "${TARGETS[@]}") | head -1)
	local WALK
	if git rev-parse -q --verify "${OLDEST}^" >/dev/null 2>&1; then
		WALK=$(git rev-list --reverse --topo-order "${OLDEST}^..HEAD")
	else
		WALK=$(git rev-list --reverse --topo-order HEAD)
	fi

	local -A REWRITTEN
	local DESC P D_MSG D_NEW touched
	local -a PARENTS_ARGS NF
	for DESC in ${(f)WALK}; do
		# One git-log per commit (see _REBUILD_DESCENDANTS): tree, parents,
		# author and body in a single NUL-separated capture, `(@0)`-split
		NF=("${(@0)$(git log -1 --format='%T%x00%P%x00%an%x00%ae%x00%ad%x00%B' --date=raw "$DESC")}")
		PARENTS_ARGS=()
		touched=false
		for P in ${=NF[2]}; do
			if [ -n "${REWRITTEN[$P]}" ]; then
				PARENTS_ARGS+=(-p "${REWRITTEN[$P]}")
				touched=true
			else
				PARENTS_ARGS+=(-p "$P")
			fi
		done
		if [ "$touched" = false ] && [ -z "${MSG_MAP[$DESC]+x}" ]; then
			continue
		fi
		if [ -n "${MSG_MAP[$DESC]+x}" ]; then
			D_MSG="${MSG_MAP[$DESC]}"
		else
			D_MSG="${NF[6]}"
		fi
		D_NEW=$(_COMMIT_TREE_AS "$DESC" "${NF[3]}" "${NF[4]}" "${NF[5]}" "${NF[1]}" "${PARENTS_ARGS[@]}" -m "$D_MSG") || _REBUILD_FAILED "$DESC"
		PRINT_CMD "git commit-tree ${NF[1]:0:7} ... -> ${D_NEW:0:7} # rebuilt ${DESC:0:7}"
		REWRITTEN[$DESC]=$D_NEW
		_RECORD_REWRITE "$DESC" "$D_NEW"
	done

	# Every target must have been reached by the walk – the range is seeded from the
	# topologically-earliest target, so this holds, but assert it before the CAS rather than
	# let an out-of-range target skip silently while the batch reports success
	local T
	for T in "${TARGETS[@]}"; do
		if [ -z "${REWRITTEN[$T]+x}" ]; then
			PRINT_ERR "Internal: target ${T:0:7} fell outside the rebuild range – no ref moved"
			exit 1
		fi
	done

	local NEW_HEAD="${REWRITTEN[$ORIG_HEAD]}"
	if [ -z "$NEW_HEAD" ]; then
		PRINT_ERR "Internal: HEAD was not rebuilt"
		exit 1
	fi

	# Single atomic compare-and-swap – refuse if the branch moved meanwhile
	# (a concurrent commit or rewrite), exactly as the single reword does
	local CMD="git update-ref -m ${(q-)${:-git edit: reword ${#TARGETS[@]} commits$_REFLOG_TAG}} ${(q-)REF} ${(q-)NEW_HEAD} ${(q-)ORIG_HEAD}"
	PRINT_CMD "$CMD"
	if ! _MOVE_REF "$CMD"; then
		PRINT_ERR "Ref '$REF' moved during batch reword – refusing to overwrite"
		PRINT_TEXT "Reworded history is at %s (not applied)." 33 "$NEW_HEAD"
		exit 1
	fi
	_RECORD_REF_MOVE "$REF" "$ORIG_HEAD" "$NEW_HEAD" "reword ${#TARGETS[@]} commits"
	PRINT_TEXT "%s – no file content changed, though the affected commits are rebuilt as new objects." 32 "Trees unchanged by construction ✓"
	PRINT_TEXT "Reworded %s commits:" 32 "${#TARGETS[@]}"
	for sha in "${TARGETS[@]}"; do
		_PRINT_COMMIT_LINE "${REWRITTEN[$sha]}" '  %h %s'
	done
	# A record replaces its commit's message whole, as the single form's `--text` does
	for sha in "${TARGETS[@]}"; do
		_PRINT_LOST_BODY "A replaced message" "$sha" "${MSG_MAP[$sha]}"
	done
}

# Names the body lines of <commit> that <new message> no longer carries, and prints them – every
# summary line is a subject, so a caller comparing those reads a replacing `--text` as clean
# whether it dropped the body whole or restated only part of it, and a count alone would not say
# which lines went. Lines compare trimmed, and one moved into the subject counts as kept
_PRINT_LOST_BODY () {
	# Args: <noun for the old message> <commit> <new message>
	local NOUN=$1 C=$2 NEW=$3
	local TRIM='s/^[[:space:]]*//;s/[[:space:]]*$//'
	local OLD_BODY=$(git log -1 --format='%b' "$C" 2>/dev/null | LC_ALL=C sed "$TRIM" | LC_ALL=C grep -a .)
	[ -n "$OLD_BODY" ] || return 0
	local LOST=$(print -r -- "$OLD_BODY" | LC_ALL=C grep -aFxv -f <(print -r -- "$NEW" | LC_ALL=C sed "$TRIM" | LC_ALL=C grep -a .))
	[ -n "$LOST" ] || return 0
	local OLD_LINES=$(print -r -- "$OLD_BODY" | grep -c .)
	local LOST_LINES=$(print -r -- "$LOST" | grep -c .)
	if [ "$LOST_LINES" -eq "$OLD_LINES" ]; then
		PRINT_TEXT "%s carried a %s-line body the new one drops – it is still readable at %s" 33 "$NOUN" "$OLD_LINES" "${C:0:12}"
	else
		PRINT_TEXT "%s carried a %s-line body – the new one lacks %s of its lines, still readable at %s" 33 "$NOUN" "$OLD_LINES" "$LOST_LINES" "${C:0:12}"
	fi
	print -r -- "$LOST" | head -8 | _CARET_LINES | LC_ALL=C sed "s/^/${_DIM}    /;s/\$/${_OFF}/"
	if [ "$LOST_LINES" -gt 8 ]; then
		print -r -- "${_DIM}    … and $((LOST_LINES - 8)) more${_OFF}"
	fi
}

# Names the bodies a squash's `--text` drops, as a reword names its own
_PRINT_DROPPED_BODIES () {
	# Args: <squashed commit>...
	[ ${#OPT_TEXT} -gt 0 ] || return 0
	local C
	local -aU SQUASHED
	for C in "$@"; do
		SQUASHED+=("$(git rev-parse "$C^{commit}" 2>/dev/null)")
	done
	for C in "${SQUASHED[@]}"; do
		[ -z "$C" ] && continue
		_PRINT_LOST_BODY "A squashed message" "$C" "$TEXT_VALUE"
	done
}

# Squashes a contiguous range into one commit, plumbing only – like `GIT_REWORD`, no
# checkout, no stash, no rebase, one atomic ref update, and it refuses non-contiguous
# selections and merge-holding ranges, which need real 3-way merges and can conflict
GIT_RESQUASH () {
	local OLDEST=${COMMITS[1]}
	local NEWEST=${COMMITS[-1]}

	# Capture the ref to update
	local ORIG_HEAD=$(git rev-parse HEAD)
	_REQUIRE_IN_TIP "$ORIG_HEAD" "${COMMITS[@]}"
	local BRANCH=${$(git symbolic-ref -q HEAD 2>/dev/null)#refs/heads/}
	local REF
	if [ -n "$BRANCH" ]; then
		REF="refs/heads/$BRANCH"
	else
		REF="HEAD"
	fi

	# Refuse if either endpoint isn't reachable from `HEAD`
	if ! git merge-base --is-ancestor "$NEWEST" HEAD 2>/dev/null; then
		PRINT_ERR "Commit ${NEWEST:0:7} is not reachable from HEAD"
		exit 1
	fi

	_GUARD_UNPUSHED "$OLDEST"

	# Verify contiguity: rev-list of the inclusive `OLDEST..NEWEST` range must
	# match the selected commits exactly (same count, same order)
	local EXPECTED
	if git rev-parse --verify "$OLDEST^" >/dev/null 2>&1; then
		EXPECTED=($(git rev-list --reverse "$OLDEST^..$NEWEST"))
	else
		# `OLDEST` is the root commit – range is just everything up to `NEWEST`
		EXPECTED=($(git rev-list --reverse "$NEWEST"))
	fi

	if [ ${#EXPECTED[@]} -ne ${#COMMITS[@]} ]; then
		PRINT_ERR "-S/--resquash requires contiguous commits"
		ECHO_E "\e[0;31m  Selected ${#COMMITS[@]}; range ${OLDEST:0:7}..${NEWEST:0:7} contains ${#EXPECTED[@]}.\e[0m" >&2
		ECHO_E "\e[0;31m  For non-contiguous squashes, use -s (combine with -C for safety).\e[0m" >&2
		exit 1
	fi
	local i
	for (( i=1; i<=${#COMMITS[@]}; i++ )); do
		if [ "${COMMITS[$i]}" != "${EXPECTED[$i]}" ]; then
			PRINT_ERR "-S/--resquash requires contiguous commits in order"
			exit 1
		fi
	done

	# Refuse merge commits in the range (they'd need a real 3-way merge)
	local C P_LIST
	for C in "${COMMITS[@]}"; do
		P_LIST=$(git log -1 --format='%P' "$C")
		if [[ "$P_LIST" == *" "* ]]; then
			PRINT_ERR "-S/--resquash cannot handle merge commit ${C:0:7}"
			ECHO_E "\e[0;31m  Use -s (combine with -C for safety) instead.\e[0m" >&2
			exit 1
		fi
	done
	if _SQUASH_LEAVES_REACHABLE "$NEWEST" "${(@)COMMITS[1,-2]}"; then
		PRINT_ERR "-S/--resquash cannot squash ${OLDEST:0:7}..${NEWEST:0:7} – a merge above it takes one of them as a parent, which would stay reachable"
		exit 1
	fi

	# Determine new parent (parent of `OLDEST`, or none for root)
	local NEW_PARENT_ARGS=()
	if git rev-parse --verify "$OLDEST^" >/dev/null 2>&1; then
		NEW_PARENT_ARGS=(-p "$(git rev-parse "$OLDEST^")")
	fi

	# Build the squashed commit's message
	local NEW_MSG
	if [ -n "$TEXT_VALUE" ]; then
		# --text supplied: use directly (auto-implies -m semantics)
		NEW_MSG="$TEXT_VALUE"
	elif [ ${#OPT_MESSAGE} -gt 0 ]; then
		_REQUIRE_TTY_FOR_EDITOR
		# With -m: combine all messages and open editor for review
		# File is named `COMMIT_EDITMSG` so editors apply commit-message syntax
		local TMP_DIR
		TMP_DIR=$(MKTEMP_DIR git-edit-resquash) || exit 1
		local MSG_FILE="$TMP_DIR/COMMIT_EDITMSG"
		_COMMENT_STRING
		local CC=$REPLY
		{
			print -r -- "$CC Combined message from ${#COMMITS[@]} squashed commits."
			print -r -- "$CC Edit as desired. Lines starting with '$CC' will be ignored."
			print -r -- "$CC An empty message aborts the operation."
			echo ""
			local FIRST=1
			for C in "${COMMITS[@]}"; do
				if [ $FIRST -eq 0 ]; then echo ""; fi
				FIRST=0
				git log -1 --format='%B' "$C"
			done
		} > "$MSG_FILE"

		NEW_MSG=$(_READ_MESSAGE_FROM_EDITOR "$MSG_FILE")
		rm -rf "$TMP_DIR"

		if [ -z "$NEW_MSG" ]; then
			PRINT_ERR "Empty message – aborting"
			exit 1
		fi
	else
		# Fixup style: keep `OLDEST`'s message, drop the rest
		NEW_MSG=$(git log -1 --format='%B' "$OLDEST" | git stripspace)
	fi

	# Build the new squashed commit (newest tree + `OLDEST`'s author + new parent + message)
	local NEW_TREE=$(git rev-parse "$NEWEST^{tree}")

	local -a OA=("${(@0)$(git log -1 --format='%an%x00%ae%x00%ad' --date=raw "$OLDEST")}")
	local NEW_SQUASHED
	NEW_SQUASHED=$(_COMMIT_TREE_AS "$OLDEST" "${OA[1]}" "${OA[2]}" "${OA[3]}" "$NEW_TREE" "${NEW_PARENT_ARGS[@]}" -m "$NEW_MSG") || _REBUILD_FAILED "$OLDEST"

	PRINT_CMD "git commit-tree ${NEW_TREE:0:7} ${NEW_PARENT_ARGS[*]} -> ${NEW_SQUASHED:0:7} # squashed ${#COMMITS[@]} commits"

	# Every member maps to the one commit that absorbed it – `notes copy` folds
	# their notes together or takes the first, per `notes.rewriteMode`
	local MEMBER
	for MEMBER in "${COMMITS[@]}"; do
		_RECORD_REWRITE "$MEMBER" "$NEW_SQUASHED"
	done

	# Rebuild any descendants of `NEWEST` up to `HEAD` with the new squashed commit as their parent
	PREV_OLD=$NEWEST
	PREV_NEW=$NEW_SQUASHED
	_REBUILD_DESCENDANTS "$NEWEST"

	# Atomic ref update
	local CMD="git update-ref -m ${(q-)${:-git edit: squash ${#COMMITS[@]} into ${OLDEST:0:7}$_REFLOG_TAG}} ${(q-)REF} ${(q-)PREV_NEW} ${(q-)ORIG_HEAD}"
	PRINT_CMD "$CMD"
	if ! _MOVE_REF "$CMD"; then
		PRINT_ERR "Ref '$REF' moved during resquash – refusing to overwrite"
		PRINT_TEXT "Resquashed history is at %s (not applied)." 33 "$PREV_NEW"
		exit 1
	fi
	_RECORD_REF_MOVE "$REF" "$ORIG_HEAD" "$PREV_NEW" "squash ${#COMMITS[@]} into ${OLDEST:0:7}"
	# The squashed commit takes the newest member's tree and descendants keep
	# theirs, so the tip tree is identical by construction – stated so callers
	# don't re-verify with a diff
	PRINT_TEXT "%s" 32 "Tip tree identical ✓ – unchanged by construction."
	git show --no-color --stat --format='' "$NEW_SQUASHED" | head -12 | _CARET_LINES | LC_ALL=C sed "/./!d;s/^/${_DIM}/;s/\$/${_OFF}/"
	_PRINT_DROPPED_BODIES "${COMMITS[@]}"
	# Identity below the stat block, for the same reason the fold's is
	_PRINT_COMMIT_LINE "$NEW_SQUASHED" '  squashed: %h %s'
}

# Writes the editor stand-in a rebase runs in place of a real editor, and echoes its path –
# a resume commits the conflicted step as well as the fold, so the fold is recognized by
# the last step logged as done and every other gets its own message written back
_FOLD_EDITOR_CMD () {
	# Args: <command taking the message path>, [worktree holding the rebase],
	# [strip: the fold's message comes from a template git seeded with comments], [tty]
	local RUN=$1
	local GITDIR=$(git -C "${2:-.}" rev-parse --absolute-git-dir 2>/dev/null)
	if [ -z "$GITDIR" ]; then
		# Unresolved, the guard matches nothing and the message goes silently –
		# the very loss it exists to prevent, so refuse instead
		PRINT_ERR "Cannot resolve the git dir for ${2:-the current directory} – 'rev-parse --absolute-git-dir' failed"
		ECHO_E "\e[0;31m  The fold's message can't be applied without it. Reword afterwards: git edit -M --text=\"…\" <sha>\e[0m" >&2
		exit 1
	fi
	local DONE=$GITDIR/rebase-merge/done
	local STRIP=":" TTY=""
	# An editor a person types into gets the terminal, as the rebase's own output is captured
	[ "$4" = tty ] && TTY=" </dev/tty >/dev/tty"
	if [ -n "$3" ]; then
		STRIP='git stripspace --strip-comments < "$1" > "$1.ge-msg" && mv -f "$1.ge-msg" "$1"'
	fi
	# Callers register the path for cleanup themselves – this runs inside a
	# command substitution, so anything appended to _TEMP_FILES here is a
	# subshell's copy and the file would outlive the run
	local SCRIPT=$(MKTEMP_FILE git-edit-fold-editor)
	# Paths go in single-quoted – a repo living under an apostrophe would
	# otherwise close the quote and leave a syntax error, which git reports
	# only as a failed editor and abandons the commit over
	cat > "$SCRIPT" <<-SH
		#!/bin/sh
		# Written by git-edit for one rebase – \$1 is the message file git opened
		STEP=\$(tail -1 ${(qq)DONE} 2>/dev/null)
		case "\$STEP" in
			squash*|fixup*)
				# An editor quit with an error abandons the commit, as git's own does
				$RUN "\$1"$TTY || exit \$?
				$STRIP
				;;
			*)
				SHA=\${STEP#* }
				SHA=\${SHA%% *}
				if git log -1 --format=%B "\$SHA" > "\$1.ge-msg" 2>/dev/null; then
					mv -f "\$1.ge-msg" "\$1"
				else
					rm -f "\$1.ge-msg"
					git stripspace --strip-comments < "\$1" > "\$1.ge-msg" && mv -f "\$1.ge-msg" "\$1"
				fi
				;;
		esac
		exit 0
	SH
	chmod +x "$SCRIPT"
	print -r -- "$SCRIPT"
}

# Puts into `REPLY` the editor a resumed rebase commits with, under `commit.cleanup=whitespace` – a
# stand-in writing a conflicted step's own message back, as git's default cleanup strips its `#`-led
# lines, while a fold keeps git's message, its comments stripped
_RESUME_EDITOR () {
	# Args: <worktree holding the rebase>
	REPLY=$(_FOLD_EDITOR_CMD true "$1" strip)
	[ -n "$REPLY" ] || exit 1
	_TEMP_FILES+=("$REPLY")
}

# Reads one key press from the terminal into `REPLY` – enter, space, quit, escape, interrupt, eof or
# other – taking the sequence an arrow or a function key sends as one other key, never as Escape
_READ_KEY () {
	local K N
	local -i I
	if ! IFS= read -rs -k1 K; then
		REPLY=eof
		return 0
	fi
	case $K in
		''|$'\r'|$'\n') REPLY=enter ;;
		' ')            REPLY=space ;;
		q|Q)            REPLY=quit ;;
		$'\003')        REPLY=interrupt ;;
		$'\004')        REPLY=eof ;;
		$'\e')
			REPLY=escape
			# A key's sequence arrives at once, so a byte within 50 ms belongs to it – CSI (`[`) runs
			# to a byte in @–~, SS3 (`O`) takes one more, and an Alt chord is the pair
			if IFS= read -rs -t 0.05 -k1 N; then
				REPLY=other
				if [[ "$N" == '[' ]]; then
					for (( I = 0; I < 16; I++ )); do
						IFS= read -rs -t 0.05 -k1 N || break
						[[ "$N" == [@-~] ]] && break
					done
				elif [[ "$N" == O ]]; then
					IFS= read -rs -t 0.05 -k1 N
				fi
			fi
			;;
		*) REPLY=other ;;
	esac
	return 0
}

# Finds a known GUI editor in git's editor sources, to open a worktree in at a pause – every source
# is read, as tooling often sets `GIT_EDITOR=true`, a no-op that would mask one below
_DETECT_GUI_EDITOR () {
	local CMD BASE
	OPEN_EDITOR_CMD=""
	OPEN_EDITOR_NAME=""
	for CMD in "$GIT_EDITOR" "$(git config core.editor 2>/dev/null)" "$VISUAL" "$EDITOR"; do
		[ -z "$CMD" ] && continue
		BASE=${${CMD%% *}##*/}
		case "$BASE" in
			subl|sublime_text|sublime) OPEN_EDITOR_NAME="Sublime Text" ;;
			code)                      OPEN_EDITOR_NAME="VS Code" ;;
			code-insiders)             OPEN_EDITOR_NAME="VS Code Insiders" ;;
			cursor)                    OPEN_EDITOR_NAME="Cursor" ;;
			zed)                       OPEN_EDITOR_NAME="Zed" ;;
			mate)                      OPEN_EDITOR_NAME="TextMate" ;;
			atom)                      OPEN_EDITOR_NAME="Atom" ;;
			nova)                      OPEN_EDITOR_NAME="Nova" ;;
			bbedit)                    OPEN_EDITOR_NAME="BBEdit" ;;
			idea*)                     OPEN_EDITOR_NAME="IntelliJ IDEA" ;;
			pycharm*)                  OPEN_EDITOR_NAME="PyCharm" ;;
			webstorm*)                 OPEN_EDITOR_NAME="WebStorm" ;;
			phpstorm*)                 OPEN_EDITOR_NAME="PhpStorm" ;;
			rubymine*)                 OPEN_EDITOR_NAME="RubyMine" ;;
			goland*)                   OPEN_EDITOR_NAME="GoLand" ;;
			clion*)                    OPEN_EDITOR_NAME="CLion" ;;
			rider*)                    OPEN_EDITOR_NAME="Rider" ;;
			datagrip*)                 OPEN_EDITOR_NAME="DataGrip" ;;
			fleet)                     OPEN_EDITOR_NAME="Fleet" ;;
			xed)                       OPEN_EDITOR_NAME="Xed" ;;
		esac
		if [ -n "$OPEN_EDITOR_NAME" ]; then
			OPEN_EDITOR_CMD=$CMD
			return 0
		fi
	done
	return 1
}

# Launches the detected GUI editor on a worktree in the background, so the run keeps waiting at
# its prompt – a no-op where none was detected
_OPEN_WORKTREE_IN_EDITOR () {
	# Args: <worktree>
	[ -z "$OPEN_EDITOR_CMD" ] && return 0
	local DIR=$1
	( _CALLER_ENV_FULL; eval "$OPEN_EDITOR_CMD \"\$DIR\" >/dev/null 2>&1 &"; disown 2>/dev/null )
}

# Resumes or cancels this run's pause as a caller's own `--continue` or `--abort` would – in a run of
# its own, as every pause resumes, back in the caller's directory and environment
_RESUME_EXEC () {
	# Args: --continue | --abort, <the pause's identity, which the resumed run must find>
	# What the exit trap would clear – an exec skips it, and the pause keeps the rest
	[ ${#_TEMP_FILES} -gt 0 ] && rm -f "${_TEMP_FILES[@]}" 2>/dev/null
	local W
	for W in "${_TEMP_WORKTREES[@]}"; do
		git worktree remove --force "$W" >/dev/null 2>&1
		rm -rf "$W"
	done
	cd "$_START_DIR" 2>/dev/null || cd "${$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null):h}"
	local -a ENV=(-u GIT_CONFIG_PARAMETERS "GIT_EDIT_EXPECT_PAUSE=$2") RUN=("$_SELF")
	[ -n "$_CALLER_GCP_SET" ] && ENV+=("GIT_CONFIG_PARAMETERS=$_CALLER_GCP")
	# A copy run as `zsh git-edit` need not be executable itself
	[ -x "$_SELF" ] || RUN=("${commands[zsh]:-zsh}" "$_SELF")
	trap - EXIT
	exec env "${ENV[@]}" "${_CALLER_ENV[@]}" "${RUN[@]}" "$1"
}

# Ends a run at the pause it recorded – a caller resumes with `--continue`, so the run exits with
# <code>, while a person at a terminal answers a prompt: Enter resumes it there and then, Escape
# cancels, q leaves the pause for later, and a hangup leaves it too
_PAUSE_EXIT () {
	# Args: <exit code> <conflict|edit|gate|retry> – what the pause waits for
	# A conflict's pre-stop tip, kept across the re-pauses of one stop, so a resume finds the commits
	# made by hand there, which the staged-marker guard never reads
	if [ "$2" = conflict ] && [ -n "$_STATE_OWNED" ] && [ -f "$_STATE_OWNED" ]; then
		local SWT=$(LC_ALL=C sed -n 's/^worktree=//p' "$_STATE_OWNED" | tail -1)
		local STOP=$(git -C "$SWT" rev-parse -q --verify REBASE_HEAD 2>/dev/null)
		if [ -n "$STOP" ] && [ "${STATE_STOP_HEAD#* }" != "$STOP" ]; then
			_STATE_NOTE "stop_head=$(git -C "$SWT" rev-parse -q --verify HEAD 2>/dev/null) $STOP"
			# And the picks still to come, which a rebase quit there never makes
			_STATE_NOTE "todo_left=$(_TODO_PICKS "$SWT")"
		fi
	fi
	_IS_NON_INTERACTIVE && exit $1
	{ [ -n "$_STATE_OWNED" ] && [ -f "$_STATE_OWNED" ]; } || exit $1
	local WT=$(LC_ALL=C sed -n 's/^worktree=//p' "$_STATE_OWNED" | tail -1)
	local PAUSE_ID=$(_PAUSE_IDENTITY "$_STATE_OWNED")
	local LEAD="" OPENED="" F PENDING=""
	local -a UNTOLD
	# What each conflicted file held as the prompt came up – markers git wrote tell a resolution by
	# their absence, while a file given none (a binary's, a side's deletion, a rerere prefill) only by
	# a change since, or a second Enter
	local -A PAUSE_MARKED PAUSE_HASH
	if [ "$2" = conflict ]; then
		for F in "${(@f)$(_UNMERGED_IN "$WT")}"; do
			[ -z "$F" ] && continue
			_HAS_NEW_MARKERS "$WT" "$F" && PAUSE_MARKED[$F]=1
			PAUSE_HASH[$F]=$(_WORKTREE_HASH "$WT" "$F" 2>/dev/null || print -r -- -)
		done
	fi
	case $2 in
		conflict) LEAD="Resolve the conflicts in %s" ;;
		edit)     LEAD="Make your changes in %s" ;;
	esac
	_DETECT_GUI_EDITOR
	if [ -n "$LEAD" ] && [ -n "$OPEN_EDITOR_CMD" ] && [ -z "$GIT_EDIT_NO_AUTO_OPEN" ]; then
		_OPEN_WORKTREE_IN_EDITOR "$WT"
		OPENED=" (opened in $OPEN_EDITOR_NAME)"
	fi
	local KEYS="press %s to continue, %s to cancel, or %s to leave it paused"
	local -a ARGS=(Enter Escape q)
	[ -n "$OPEN_EDITOR_CMD" ] && { KEYS+=" – %s opens it in $OPEN_EDITOR_NAME"; ARGS+=(Space); }
	# Keys typed before a prompt showed answer nothing – each prompt drops them first
	_DRAIN_KEYS
	if [ -n "$LEAD" ]; then
		PRINT_TEXT "$LEAD$OPENED – then $KEYS." 35 "$WT" "${ARGS[@]}"
	else
		PRINT_TEXT "${(C)KEYS[1]}${KEYS[2,-1]}." 35 "${ARGS[@]}"
	fi
	_AT_PROMPT=true
	while true; do
		_READ_KEY
		# The slot may hold another run's pause by now – one this run's prompt must not resume or cancel
		if [[ "$REPLY" == (enter|escape|space) ]] && [ "$(_PAUSE_IDENTITY "$_STATE_OWNED")" != "$PAUSE_ID" ]; then
			_AT_PROMPT=""
			PRINT_ERR "This pause is no longer pending – another run ended it or took the slot – so nothing was done"
			exit 1
		fi
		case $REPLY in
			enter)
				# A conflict's files staged as resolved where their markers are gone, as a person
				# resolving one expects of Enter – the resume refuses markers still staged
				if [ "$2" = conflict ]; then
					_STAGE_RESOLVED "$WT" "$PENDING"
					if (( ${#UNTOLD} )); then
						PENDING=${(pj:\0:)UNTOLD}
						_DRAIN_KEYS
						PRINT_TEXT "Nothing tells a resolution of %s – no markers, and unchanged since the pause. Press %s again to take it as it stands, or resolve it first." 33 "${(j:, :)UNTOLD}" Enter
						continue
					fi
				fi
				_RESUME_EXEC --continue "$PAUSE_ID" ;;
			escape)
				_DRAIN_KEYS
				PRINT_TEXT "Press %s again to cancel – what this run did in %s goes with it – or any other key to go back." 33 "Escape" "$WT"
				_READ_KEY
				if [ "$REPLY" = escape ]; then
					[ "$(_PAUSE_IDENTITY "$_STATE_OWNED")" = "$PAUSE_ID" ] && _RESUME_EXEC --abort "$PAUSE_ID"
					_AT_PROMPT=""
					PRINT_ERR "This pause is no longer pending – another run ended it or took the slot – so nothing was done"
					exit 1
				fi
				PRINT_TEXT "Not cancelled – ${KEYS}." 90 "${ARGS[@]}" ;;
			space)
				if [ -n "$OPEN_EDITOR_CMD" ]; then
					_OPEN_WORKTREE_IN_EDITOR "$WT"
				else
					PRINT_TEXT "${(C)KEYS[1]}${KEYS[2,-1]}." 90 "${ARGS[@]}"
				fi ;;
			quit|interrupt|eof)
				_AT_PROMPT=""
				_PRINT_LEFT_PAUSED
				exit $1 ;;
			*)
				PRINT_TEXT "${(C)KEYS[1]}${KEYS[2,-1]}." 90 "${ARGS[@]}" ;;
		esac
	done
}

# Prints the commits the todo of <worktree>'s rebase still picks, full SHAs on one line
_TODO_PICKS () {
	# Args: <worktree>
	local TODO=$(git -C "$1" rev-parse --path-format=absolute --git-path rebase-merge/git-rebase-todo 2>/dev/null) LINE C
	local -a W PICKS
	[ -f "$TODO" ] || return 0
	while IFS= read -r LINE; do
		W=(${=LINE})
		[[ "${W[1]}" == (p|pick|r|reword|e|edit) ]] || continue
		C=$(git -C "$1" rev-parse -q --verify "${W[2]}^{commit}" 2>/dev/null) && PICKS+=("$C")
	done < "$TODO"
	print -r -- "${PICKS[*]}"
}

# Refuses a resume landing a rebase that stopped short – quit by hand, files left unmerged – where
# none is in progress: of the picks left at the last stop, matched by author, date and subject as a
# replay keeps them, a missing one passes where a later one made it, a missing tail being a quit's
_REQUIRE_REPLAY_DONE () {
	# Args: <worktree>
	local WT=$1 C KEY FROM=${STATE_STOP_HEAD%% *}
	local -a MISSING
	local -A HAVE
	if [ -n "$(_UNMERGED_IN "$WT")" ]; then
		_CLEANUP_HOOK=""
		PRINT_ERR "The rebase in $WT ended with files still unmerged – quit by hand, say – so nothing was applied"
		ECHO_E "\e[0;31m  Cancel with 'git edit --abort', then run it again.\e[0m" >&2
		exit 1
	fi
	[ -n "$STATE_TODO_LEFT" ] || return 0
	for KEY in "${(@f)$(git -C "$WT" log --format='%an%x1f%ae%x1f%at%x1f%s' ${FROM:+"$FROM..HEAD"} 2>/dev/null)}"; do
		HAVE[$KEY]=1
	done
	for C in ${=STATE_TODO_LEFT}; do
		KEY=$(git -C "$WT" log -1 --format='%an%x1f%ae%x1f%at%x1f%s' "$C" 2>/dev/null)
		if (( ${+HAVE[$KEY]} )); then MISSING=(); else MISSING+=("$C"); fi
	done
	(( ${#MISSING} )) || return 0
	_CLEANUP_HOOK=""
	PRINT_ERR "The rebase in $WT stopped short of its last ${#MISSING} commit(s) – quit by hand, say – so nothing was applied"
	git -C "$WT" log --no-walk=unsorted --format='%h %s' "${MISSING[@]}" 2>/dev/null | _CARET_LINES | LC_ALL=C sed "s/^/${_RED}  /;s/\$/${_OFF}/" >&2
	ECHO_E "\e[0;31m  Cancel with 'git edit --abort', then run it again – or, where git dropped them as emptied, land what is there: 'git edit --exec --base=${STATE_ORIG_HEAD:0:12} -- git reset -q --hard $(git -C "$WT" rev-parse HEAD)'.\e[0m" >&2
	exit 1
}

# Refuses a resume where the rebase was aborted by hand, back on the tip it began from – a drop,
# squash, reorder or replant is never a no-op, so nothing was applied
_REFUSE_HAND_ABORT () {
	_CLEANUP_HOOK=""
	PRINT_ERR "The rebase in $STATE_WORKTREE was aborted by hand – nothing was applied"
	ECHO_E "\e[0;31m  Clear the pause with 'git edit --abort'.\e[0m" >&2
	exit 1
}

# Names the commands that take up a pause left for later
_PRINT_LEFT_PAUSED () {
	PRINT_TEXT "Left paused – resume with %s, or cancel with %s." 33 "git edit --continue" "git edit --abort"
}

# Names the pause a state file holds by what no note to it changes – asked again after each key, as
# another run may have ended it and taken the slot meanwhile
_PAUSE_IDENTITY () {
	# Args: <state file>
	LC_ALL=C grep -aE '^(operation|worktree|branch|orig_head|target)=' "$1" 2>/dev/null
}

# Drops whatever keys wait unread, so none typed ahead answers a prompt not yet shown
_DRAIN_KEYS () {
	local K
	while IFS= read -rs -t 0 -k1 K 2>/dev/null; do :; done
	return 0
}

# Tells whether <worktree>'s <file> holds conflict-marker lines no side brought, at the file's own
# `conflict-marker-size` – as `_MARKED_PATHS` reads a staged blob – a link never
_HAS_NEW_MARKERS () {
	# Args: <worktree> <file, from the top>
	local N RE HAVE OWN="" SIDE
	[ -L "$1/$2" ] && return 1
	N=$(git -C "$1" check-attr conflict-marker-size -- "$2" 2>/dev/null)
	N=${N##*: }
	[[ "$N" == <1-> ]] || N=7
	RE="^(<{$N}|={$N}|>{$N})( |\$)"
	HAVE=$(LC_ALL=C grep -aE "$RE" -- "$1/$2" 2>/dev/null)
	[ -n "$HAVE" ] || return 1
	for SIDE in HEAD REBASE_HEAD; do
		OWN+=$(git -C "$1" show "$SIDE:$2" 2>/dev/null | LC_ALL=C grep -aE "$RE")$'\n'
	done
	[ -n "$(LC_ALL=C comm -23 <(print -r -- "$HAVE" | LC_ALL=C sort -u) <(print -r -- "$OWN" | LC_ALL=C sort -u))" ]
}

# Stages each conflicted file of <worktree> its resolution shows in – the markers it was given gone,
# a deletion too, or one given none changed since the pause or confirmed – and names what it staged,
# leaving the rest named in `UNTOLD`
_STAGE_RESOLVED () {
	# Args: <worktree> <files confirmed as they stand, NUL-joined>
	# Reads the prompt's `PAUSE_MARKED` and `PAUSE_HASH`
	local F
	local -a DONE CONFIRMED
	local -x GIT_LITERAL_PATHSPECS=1
	CONFIRMED=("${(@0)2}")
	UNTOLD=()
	for F in "${(@f)$(_UNMERGED_IN "$1")}"; do
		[ -z "$F" ] && continue
		if (( ${+PAUSE_MARKED[$F]} )); then
			{ [ -e "$1/$F" ] || [ -L "$1/$F" ]; } && _HAS_NEW_MARKERS "$1" "$F" && continue
		elif (( ! ${CONFIRMED[(Ie)$F]} )) && [ "$(_WORKTREE_HASH "$1" "$F" 2>/dev/null || print -r -- -)" = "${PAUSE_HASH[$F]--}" ]; then
			UNTOLD+=("$F")
			continue
		fi
		git -C "$1" add -A -- "$F" 2>/dev/null && DONE+=("$F")
	done
	(( ${#DONE} )) && PRINT_TEXT "Staged as resolved: %s" 90 "${(j:, :)DONE}"
	return 0
}

# Confirms a drop or squash before anything is rewritten, on either squash route alike – `-y`
# answers it up front, and a run with no terminal has nobody to ask, so it proceeds
_CONFIRM_REWRITE () {
	_IS_NON_INTERACTIVE && return 0
	if [ ${#OPT_YES} -gt 0 ]; then
		ECHO_E "\e[0;90m(-y / --yes: auto-confirmed)\e[0m"
		return 0
	fi
	_DRAIN_KEYS
	PRINT_TEXT "Press %s to confirm, or cancel with %s." 35 "Enter" "Escape"
	while true; do
		_READ_KEY
		case $REPLY in
			enter) return 0 ;;
			escape|quit|interrupt|eof)
				PRINT_ERR "Cancelled – nothing was changed"
				exit 1 ;;
			*) PRINT_TEXT "Press %s to confirm, or cancel with %s." 90 "Enter" "Escape" ;;
		esac
	done
}

# Creates a detached worktree at <commit>, reclaiming a path a removed one left registered – this
# path alone, as a prune drops every vanished worktree's records, a parallel session's reflog with
# them – and keeping one a failing `post-checkout` hook failed the add of, complete as it is
_WORKTREE_ADD () {
	# Args: <dir> <commit> [quiet – git's own lines left out]
	local CMD="git worktree add --detach ${(q-)1} ${(q-)2}" OUT
	PRINT_CMD "$CMD"
	# C locale – the retry below matches git's English wording
	if OUT=$( export LC_ALL=C; eval "$CMD" 2>&1 ); then
		[ -n "$OUT" ] && [ -z "$3" ] && print -r -- "$OUT" | _CARET_LINES --crlf
		return 0
	fi
	if [[ "$OUT" == *"missing but already registered"* ]]; then
		ECHO_E "\e[0;90m(stale worktree registration – reclaiming its path and retrying)\e[0m"
		CMD="git worktree add -f --detach ${(q-)1} ${(q-)2}"
		PRINT_CMD "$CMD"
		if OUT=$( export LC_ALL=C; eval "$CMD" 2>&1 ); then
			[ -n "$OUT" ] && [ -z "$3" ] && print -r -- "$OUT" | _CARET_LINES --crlf
			return 0
		fi
	fi
	if [ "$(git -C "$1" rev-parse HEAD 2>/dev/null)" = "$(git rev-parse "$2^{commit}" 2>/dev/null)" ] && \
	   [ -z "$(git -C "$1" status --porcelain --untracked-files=no 2>/dev/null)" ]; then
		PRINT_TEXT "The post-checkout hook failed in the new worktree – carrying on, as the run needs only the commit: %s" 33 "${OUT##*$'\n'}"
		return 0
	fi
	print -r -- "$OUT" >&2
	PRINT_ERR "Could not create the worktree at $1"
	return 1
}

# Sets up the worktree a drop, edit or squash runs in, at <commit> – the `-C` path, checked and
# reused, else a temp one that goes with the run unless a pause keeps it – into `WORKTREE_DIR`,
# with `WT_OURS` set for the temp one
_PREPARE_RUN_WORKTREE () {
	# Args: <commit> <temp dir prefix>
	local AT=$1 TOP THEIRS ABS STRAY GD
	TOP=$(git rev-parse --show-toplevel 2>/dev/null)
	if [ ${#OPT_DIR} -eq 0 ]; then
		WORKTREE_DIR=$(MKTEMP_DIR "$2") || exit 1
		rmdir "$WORKTREE_DIR"  # `git worktree add` wants to create the dir itself
		WT_OURS=1
		_CLEANUP_HOOK="git worktree remove --force ${(q-)WORKTREE_DIR} 2>/dev/null; rm -rf ${(q-)WORKTREE_DIR}"
		_WORKTREE_ADD "$WORKTREE_DIR" "$AT" || exit 1
		_LINK_WORKTREE_EXTRAS "$WORKTREE_DIR"
		return 0
	fi
	WT_OURS=0
	# Default path: <repo-root>.git-edit, a sibling of the checkout
	if [ -z "$WORKTREE_DIR" ]; then
		WORKTREE_DIR="${TOP}.git-edit"
		WT_DEFAULT=1
	fi
	if [ ! -d "$WORKTREE_DIR" ]; then
		_WORKTREE_ADD "$WORKTREE_DIR" "$AT" || exit 1
		_LINK_WORKTREE_EXTRAS "$WORKTREE_DIR"
		return 0
	fi
	THEIRS=$(git -C "$WORKTREE_DIR" rev-parse --show-toplevel 2>/dev/null)
	if [ -z "$THEIRS" ]; then
		PRINT_ERR "Path '$WORKTREE_DIR' exists but is not a git working tree"
		exit 1
	fi
	THEIRS=$(cd "$THEIRS" && pwd -P)
	ABS=$(cd "$WORKTREE_DIR" && pwd -P)
	# The root of a worktree of this repository, not a directory inside one, nor the checkout itself
	if [ "$THEIRS" != "$ABS" ]; then
		PRINT_ERR "Path '$WORKTREE_DIR' is inside a working tree but is not its root"
		exit 1
	fi
	if [ "$THEIRS" = "$(cd "$TOP" && pwd -P)" ]; then
		PRINT_ERR "-C/--dir cannot point to the current working tree"
		exit 1
	fi
	# Nor one holding a branch or work – the reset below would move that branch and wipe the work
	if git -C "$WORKTREE_DIR" symbolic-ref -q HEAD >/dev/null 2>&1; then
		PRINT_ERR "-C/--dir path '$WORKTREE_DIR' has $(git -C "$WORKTREE_DIR" symbolic-ref --short -q HEAD) checked out – name a scratch path, or detach it there first"
		exit 1
	fi
	if [ -n "$(git -C "$WORKTREE_DIR" status --porcelain --untracked-files=no 2>/dev/null)" ]; then
		PRINT_ERR "-C/--dir path '$WORKTREE_DIR' holds uncommitted changes – name a scratch path instead"
		exit 1
	fi
	# Untracked files would feed the gate's run yet never land – an earlier check's own output in the
	# default path, which this tool manages, so removed there and refused in a named one
	if _VERIFY_CONFIGURED; then
		STRAY=$(git -C "$WORKTREE_DIR" -c core.quotePath=false ls-files -o --exclude-standard --directory --no-empty-directory 2>/dev/null)
		if [ -n "$STRAY" ] && [ -n "$WT_DEFAULT" ]; then
			git -C "$WORKTREE_DIR" clean -fdq 2>/dev/null
			PRINT_TEXT "Removed what an earlier run left untracked in %s: %s" 90 "$WORKTREE_DIR" "$(_JOIN_PATHS "$STRAY")"
		elif [ -n "$STRAY" ]; then
			PRINT_ERR "-C/--dir path '$WORKTREE_DIR' holds untracked files the verify check would run over – name a scratch path instead"
			exit 1
		fi
	fi
	# A previous killed run's rebase, cleared – removed outright where `rebase --abort` chokes on it
	git -C "$WORKTREE_DIR" rebase --abort 2>/dev/null
	GD=$(git -C "$WORKTREE_DIR" rev-parse --absolute-git-dir 2>/dev/null)
	[ -n "$GD" ] && rm -rf "$GD/rebase-merge" "$GD/rebase-apply"
	local CMD="git -C ${(q-)WORKTREE_DIR} reset --hard ${(q-)AT}"
	PRINT_CMD "$CMD"
	eval "$CMD" >/dev/null || { PRINT_ERR "Could not reset $WORKTREE_DIR to ${AT:0:7}"; exit 1; }
	_LINK_WORKTREE_EXTRAS "$WORKTREE_DIR"
}

# Picks the scenarios `--selftest=<pick>` names from the suite dir, a file `<id>-<name>.zsh` each,
# for runs during development – the full suite stays the gate
# Scenarios share one scratch repo, so one starting from an earlier one's state says so with
# `# needs <ids>` on its `_ST_SCENARIO` line, and those come along
_SELFTEST_PICK () {
	# Args: <suite dir> <pick> – sets `SELFTEST_FILES` to the files picked, in suite order, and
	# `SELFTEST_SCOPE` to what they hold, or refuses
	local -a IDS RUNS CONTENT BANNER
	local -A AT NEEDS WANT FILE_OF KEY_OF SIZE_OF
	local I F ID ITEM FROM TO N KEY RUN_FROM="" RUN_TO=""
	# Every other file there is a scenario, so a misnamed one refuses rather than drop out unrun
	for F in "$1"/*.zsh(N); do
		[ "${F:t}" = lib.zsh ] && continue
		if ! [[ "${F:t}" =~ '^0*([0-9]+)([a-z]?)-[a-z0-9-]+\.zsh$' ]]; then
			PRINT_ERR "Selftest scenario file ${F:t} is not named <id>-<name>.zsh"
			return 1
		fi
		ID=${match[1]}${match[2]}
		if (( ${+FILE_OF[$ID]} )); then
			PRINT_ERR "Selftest scenario $ID is declared twice"
			return 1
		fi
		FILE_OF[$ID]=$F
		# Number and letter apart, as a collation that skips the `-` sorts `60b-` before `60-`
		KEY_OF[$(printf '%06d%s' "${match[1]}" "${match[2]}")]=$ID
		# Its one banner names the id its file does, `# needs` riding on the same line
		CONTENT=("${(@f)$(<"$F")}")
		SIZE_OF[$ID]=${#CONTENT}
		BANNER=(${(M)CONTENT:#_ST_SCENARIO \"*})
		if [ ${#BANNER} -ne 1 ] || ! [[ "${BANNER[1]}" =~ '^_ST_SCENARIO "\\e\[1;96m\[([0-9]+[a-z]?)\]' ]] || [ "${match[1]}" != "$ID" ]; then
			PRINT_ERR "Selftest scenario file ${F:t} must open one _ST_SCENARIO line for [$ID]"
			return 1
		fi
		[[ "${BANNER[1]}" =~ '# needs ([0-9a-z, ]+)$' ]] && NEEDS[$ID]=${match[1]// /}
	done
	for KEY in ${(o)${(k)KEY_OF}}; do
		IDS+=("${KEY_OF[$KEY]}")
		AT[${KEY_OF[$KEY]}]=${#IDS}
	done
	if [ ${#IDS} -eq 0 ]; then
		PRINT_ERR "The selftest suite has no scenarios in $1"
		return 1
	fi
	# Needs point back, since files run in suite order – checked on every run, so a wrong one
	# refuses the next run instead of waiting for the scenario that carries it
	for ID in "${IDS[@]}"; do
		for N in ${(s:,:)NEEDS[$ID]}; do
			if (( ! ${+AT[$N]} )) || (( ${AT[$N]} >= ${AT[$ID]} )); then
				PRINT_ERR "Selftest scenario $ID needs $N, which is no scenario before it"
				return 1
			fi
		done
	done
	# An open end runs to the suite's own, as a commit range's empty side means HEAD
	for ITEM in ${(s:,:)2}; do
		FROM=${ITEM%%-*}
		TO=${ITEM#*-}
		[ -z "$FROM" ] && FROM=${IDS[1]}
		[ -z "$TO" ] && TO=${IDS[-1]}
		for N in "$FROM" "$TO"; do
			if (( ! ${+AT[$N]} )); then
				PRINT_ERR "--selftest names scenario '$N', which the suite does not have"
				return 1
			fi
		done
		if (( ${AT[$FROM]} > ${AT[$TO]} )); then
			PRINT_ERR "--selftest=$ITEM runs backwards – name the earlier scenario first"
			return 1
		fi
		for ID in "${IDS[@]}"; do
			(( ${AT[$ID]} >= ${AT[$FROM]} && ${AT[$ID]} <= ${AT[$TO]} )) && WANT[$ID]=1
		done
	done
	if [ ${#WANT} -eq 0 ]; then
		PRINT_ERR "--selftest= names no scenario – leave the value off for the full suite"
		return 1
	fi
	# One pass from the end closes over needs of needs, each pointing further back
	for (( I = ${#IDS}; I >= 1; I-- )); do
		(( ${+WANT[${IDS[I]}]} )) || continue
		for N in ${(s:,:)NEEDS[${IDS[I]}]}; do
			WANT[$N]=1
		done
	done
	# What `--jobs` splits the pick by – its scenarios in suite order, what each needs, its length
	typeset -ga SELFTEST_FILES SELFTEST_IDS
	typeset -gA SELFTEST_NEEDS SELFTEST_SIZE
	SELFTEST_FILES=() SELFTEST_IDS=() SELFTEST_NEEDS=() SELFTEST_SIZE=()
	for (( I = 1; I <= ${#IDS}; I++ )); do
		ID=${IDS[I]}
		if (( ${+WANT[$ID]} )); then
			SELFTEST_FILES+=("${FILE_OF[$ID]}")
			SELFTEST_IDS+=("$ID")
			SELFTEST_NEEDS[$ID]=${NEEDS[$ID]}
			SELFTEST_SIZE[$ID]=${SIZE_OF[$ID]}
			[ -z "$RUN_FROM" ] && RUN_FROM=$ID
			RUN_TO=$ID
		fi
		# A run of kept scenarios closes at the first one left out, or at the end
		if [ -n "$RUN_FROM" ] && { (( ! ${+WANT[$ID]} )) || (( I == ${#IDS} )) }; then
			RUNS+=("$RUN_FROM${${RUN_TO:#$RUN_FROM}:+-$RUN_TO}")
			RUN_FROM=""
		fi
	done
	SELFTEST_SCOPE="scenario${${${#WANT}:#1}:+s} ${(j:, :)RUNS} (${#WANT} of ${#IDS})"
}

# Runs a pick of the suite – all of it by default – <jobs> processes at once, each one a
# `--selftest=<ids>` of a scenario with the ones it needs, in a temp dir of its own, the longest
# first, then prints their output in suite order under one count and trailer, as a serial run would
_SELFTEST_JOBS () {
	# Args: <script> <suite dir> <the `--selftest` option as given> <jobs>
	local SELF=$1 DIR=$2 PICK=${${3#--selftest}#=} ID N A B R LINE JT
	local -i JOBS=$4 RUNNING=0 NEXT=1 DONE=0 TOTAL=0 FAILED=0 P T
	local -a ORDER QUEUE
	local -A ROOT MEMBERS WEIGHT PID_OF
	# A bare `--selftest` is the whole suite, an empty pick refused as a run alone refuses it
	[ "$3" = --selftest ] && PICK=-
	_SELFTEST_PICK "$DIR" "$PICK" || return 1
	# The whole suite says nothing of what ran, as a serial run of it doesn't
	[ "$3" = --selftest ] && SELFTEST_SCOPE=""
	# One unit per set of scenarios the needs tie together, so each runs once and its needs with it
	for ID in "${SELFTEST_IDS[@]}"; do ROOT[$ID]=$ID; done
	for ID in "${SELFTEST_IDS[@]}"; do
		for N in ${(s:,:)SELFTEST_NEEDS[$ID]}; do
			A=$ID; while [ "${ROOT[$A]}" != "$A" ]; do A=${ROOT[$A]}; done
			B=$N; while [ "${ROOT[$B]}" != "$B" ]; do B=${ROOT[$B]}; done
			[ "$A" != "$B" ] && ROOT[$A]=$B
		done
	done
	for ID in "${SELFTEST_IDS[@]}"; do
		R=$ID; while [ "${ROOT[$R]}" != "$R" ]; do R=${ROOT[$R]}; done
		(( ${+MEMBERS[$R]} )) || ORDER+=("$R")
		MEMBERS[$R]+="${MEMBERS[$R]:+,}$ID"
		WEIGHT[$R]=$(( ${WEIGHT[$R]:-0} + ${SELFTEST_SIZE[$ID]} ))
	done
	# The longest first, so the slowest never starts last – its line count standing in for its time
	QUEUE=(${(f)"$(for R in "${ORDER[@]}"; do print -r -- "${WEIGHT[$R]} $R"; done | sort -rn | awk '{print $2}')"})
	JT=$(MKTEMP_DIR git-edit-jobs) || return 1
	PRINT_TEXT "Running %s in %s units, %s at a time" 33 "${SELFTEST_SCOPE:-the suite}" "${#QUEUE}" "$JOBS"
	# An interrupt takes the units still running along, and their temp dirs with them – each unit
	# by the process id its subshell noted, as a kill of the subshell alone leaves it running
	# Exiting as any run stopped by a signal does, 128 plus its number and named in the trailer
	local SIG
	for SIG in INT TERM HUP; do
		trap "for R in \${(k)PID_OF}; do [ -s \"\$JT/\$R.pid\" ] && kill -TERM \"\$(<\"\$JT/\$R.pid\")\"; kill -TERM \"\${PID_OF[\$R]}\"; done 2>/dev/null; rm -rf -- \"\$JT\"; _LAST_ERROR='stopped by SIG$SIG'; exit $(( 128 + ${signals[(Ie)$SIG]} - 1 ))" $SIG
	done
	while (( DONE < ${#QUEUE} )); do
		while (( RUNNING < JOBS && NEXT <= ${#QUEUE} )); do
			R=${QUEUE[NEXT]}
			# At the depth this run started at, as a pick alone runs – the suite keeps its temp files apart
			( GIT_EDIT_SELFTEST_DEPTH=${GIT_EDIT_SELFTEST_DEPTH:-0} \
				"$SELF" --selftest="${MEMBERS[$R]}" </dev/null >"$JT/$R.out" 2>&1 &
				print -r -- $! > "$JT/$R.pid"
				wait $!
				print -r -- $? > "$JT/$R.rc.part" && mv "$JT/$R.rc.part" "$JT/$R.rc" ) &
			# Quoted, as zsh stores a bare `$!` in an element as those two characters
			PID_OF[$R]="$!"
			RUNNING+=1 NEXT+=1
		done
		for R in ${(k)PID_OF}; do
			[ -f "$JT/$R.rc" ] || continue
			unset "PID_OF[$R]"
			RUNNING+=-1 DONE+=1
		done
		(( DONE < ${#QUEUE} )) && sleep 0.2
	done
	wait 2>/dev/null
	# The script's own handlers back, so a signal during the report still runs its exit
	_TRAP_TERMINATION
	local -a DIED
	local -A TEXT_OF
	for R in "${ORDER[@]}"; do
		# A unit's lines filed under the scenario header opening them, as one unit can hold two the
		# suite runs apart – its banner, summary and trailer dropped, a failed one's hint at a need kept
		ID=${MEMBERS[$R]%%,*}
		for LINE in "${(@f)$(LC_ALL=C sed -E '/^(git edit – |Selftest scratch repo: |Running scenario|Selftest: |git-edit: |$)/d' "$JT/$R.out")}"; do
			[ -n "$LINE" ] || continue
			[[ "$LINE" =~ '^\[([0-9]+[a-z]?)\] ' && ",${MEMBERS[$R]}," == *",${match[1]},"* ]] && ID=${match[1]}
			TEXT_OF[$ID]+=$LINE$'\n'
		done
		LINE=$(LC_ALL=C grep -a '^git-edit: ' "$JT/$R.out" | tail -1)
		if [[ "$LINE" =~ ' selftest ([0-9]+)/([0-9]+) (passed|failed)' ]]; then
			P=${match[1]} T=${match[2]}
			TOTAL+=$T
			[ "${match[3]}" = failed ] && FAILED+=$P
		else
			# No trailer is no verdict – the unit died, and counts as a failure
			FAILED+=1 TOTAL+=1
			DIED+=("$R")
		fi
	done
	# A unit writes to a file, so a terminal gets its colors back here
	local -a TINT=(-e '')
	[ "$_COLOR" = true ] && TINT=(-e $'s/^\\[[0-9]+[a-z]?\\] .*/\e[1;96m&\e[0m/' \
		-e $'s/^  PASS /  \e[0;32mPASS\e[0m /' -e $'s/^  FAIL /  \e[1;31mFAIL\e[0m /')
	for ID in "${SELFTEST_IDS[@]}"; do print -rn -- "${TEXT_OF[$ID]}"; done | LC_ALL=C sed -E "${TINT[@]}"
	for R in "${DIED[@]}"; do
		PRINT_TEXT "Scenarios %s ended without a result – exit %s:" 31 "${MEMBERS[$R]}" "$(<"$JT/$R.rc")"
		tail -5 "$JT/$R.out" | _CARET_LINES | LC_ALL=C sed 's/^/  | /'
	done
	echo ""
	if (( FAILED == 0 )); then
		PRINT_TEXT "%s" 32 "Selftest: all $TOTAL checks passed."
		rm -rf "$JT"
		echo "git-edit: ok – selftest $TOTAL/$TOTAL passed – ${SELFTEST_SCOPE:+$SELFTEST_SCOPE, }$JOBS jobs"
		_STATUS_EMITTED=true
		return 0
	fi
	PRINT_TEXT "%s" 31 "Selftest: $FAILED of $TOTAL checks FAILED."
	PRINT_TEXT "Every unit's output kept in %s" 33 "$JT"
	echo "git-edit: error – selftest $FAILED/$TOTAL failed – ${SELFTEST_SCOPE:+$SELFTEST_SCOPE, }$JOBS jobs"
	_STATUS_EMITTED=true
	return 1
}


# ---------------------------------------- ARGUMENT PARSING ----------------------------------------

# Remember full original command line
COMMANDLINE="git edit"
# Only `--text=` and `--verify=` leave the `=` zparseopts keeps – a value given apart keeps its own,
# and neither a value nor a word past `--` (an `--exec` command's own `--verify`) is a flag
TEXT_APART=false
VERIFY_APART=false
ARG_SCAN=flags
for ARG in "$@"; do
	COMMANDLINE+=" $(printf '%q' "$ARG")"
	if [ "$ARG_SCAN" = value ]; then ARG_SCAN=flags; continue; fi
	[ "$ARG_SCAN" = flags ] || continue
	case "$ARG" in
		--)         ARG_SCAN=done ;;
		--text)     TEXT_APART=true ARG_SCAN=value ;;
		--text=*)   TEXT_APART=false ;;
		--verify)   VERIFY_APART=true ARG_SCAN=value ;;
		--verify=*) VERIFY_APART=false ;;
	esac
done

zmodload zsh/zutil
# Parses the flags with `zparseopts`:
# • `-D` pulls parsed flags out of `$@`
# • `-E` allows flags, args and positionals to be mixed
# • `-F` fails on a flag that was not defined
# The first dash is handled automatically, so long options are `-opt`, not `--opt`

# Its message names the argument it refused, which `-D` has already moved out of `$1` – lost
# where no temp file can be made, so a missing `TMPDIR` still lets `--version` and `--abort` answer
PARSE_ERR=$(MKTEMP_FILE git-edit-parse 2>/dev/null) && _TEMP_FILES+=("$PARSE_ERR")
if ! zparseopts -D -E -F -- {e,-edit}=OPT_EDIT {m,-message}=OPT_MESSAGE {M,-reword}=OPT_REWORD {d,-drop}=OPT_DROP {s,-squash}+::=OPT_SQUASH {S,-resquash}=OPT_RESQUASH {C,-dir}+::=OPT_DIR -exec=OPT_EXEC -commit=OPT_COMMIT -whole=OPT_WHOLE -base+:=OPT_BASE -dry-run=OPT_DRY_RUN -amend-into+:=OPT_AMEND_INTO -split+:=OPT_SPLIT -reorder=OPT_REORDER -onto+:=OPT_ONTO -skip=OPT_SKIP -move+:=OPT_MOVE -after+:=OPT_AFTER -before+:=OPT_BEFORE -continue=OPT_CONTINUE -abort=OPT_ABORT -undo=OPT_UNDO -status=OPT_STATUS -selftest+::=OPT_SELFTEST -jobs+::=OPT_JOBS -carry+::=OPT_CARRY -allow-pushed=OPT_ALLOW_PUSHED -allow-new-path=OPT_ALLOW_NEW_PATH -allow-mode-change=OPT_ALLOW_MODE_CHANGE -allow-other-actor=OPT_ALLOW_OTHER_ACTOR -tree+:=OPT_TREE -snapshot=OPT_SNAPSHOT -verify+:=OPT_VERIFY -no-verify=OPT_NO_VERIFY -verify-span=OPT_VERIFY_SPAN -no-verify-span=OPT_NO_VERIFY_SPAN -text+:=OPT_TEXT {y,-yes}=OPT_YES {h,-help}=OPT_HELP -version=OPT_VERSION 2>"${PARSE_ERR:-/dev/null}"; then
	USAGE
	PARSE_MSG=""
	[ -n "$PARSE_ERR" ] && PARSE_MSG=$(<"$PARSE_ERR")
	PARSE_MSG=${PARSE_MSG#*zparseopts:*: }
	case "$PARSE_MSG" in
		"bad option: "*)                   PRINT_ERR "Unknown option: ${PARSE_MSG#bad option: }" ;;
		"missing argument for option: "*)  PRINT_ERR "Option ${PARSE_MSG#missing argument for option: } needs a value" ;;
		*)                                 PRINT_ERR "Cannot parse the options: ${PARSE_MSG:-$*}" ;;
	esac
	exit 1
fi
[ -n "$PARSE_ERR" ] && rm -f "$PARSE_ERR"

# -h/--help/help
if [[ ${#OPT_HELP} -gt 0 || $1 == "help" ]]; then
	USAGE
	exit 0
fi

# --version – answers outside a repo too, since the banner is all that ran before it
if [ ${#OPT_VERSION} -gt 0 ]; then
	ECHO_E "\e[0;94mgit-edit ${GIT_EDIT_VERSION}\e[0m"
	exit 0
fi

# An option taking one value, given twice, kept one alone – a fold landing on the wrong
# commit or folding the wrong tree, a message or a check dropped with nothing said – so a repeat
# refuses. `-s`, `-C`, `--selftest` and `--carry` hold their value in the element they name, the
# others take it as a second one. `--move` alone may repeat, by design
for REPEAT_OPT REPEAT_ARR REPEAT_MAX REPEAT_WHAT in --amend-into OPT_AMEND_INTO 2 'names one commit' \
		--split OPT_SPLIT 2 'names one commit' --onto OPT_ONTO 2 'names one commit' \
		-s/--squash OPT_SQUASH 1 'names one commit' --after OPT_AFTER 2 'names one commit' \
		--before OPT_BEFORE 2 'names one commit' --base OPT_BASE 2 'names one commit' --tree OPT_TREE 2 'names one tree' \
		--text OPT_TEXT 2 'takes one message' --verify OPT_VERIFY 2 'runs one command' \
		-C/--dir OPT_DIR 1 'takes one directory' --selftest OPT_SELFTEST 1 'takes one list of scenarios' \
		--jobs OPT_JOBS 1 'takes one count' \
		--carry OPT_CARRY 1 'names one old tip'; do
	if (( ${#${(P)REPEAT_ARR}} > REPEAT_MAX )); then
		PRINT_ERR "$REPEAT_OPT given twice – it $REPEAT_WHAT, and only the last would count"
		exit 1
	fi
done

# Past the usage and version answers, which an outdated git should still get
_REQUIRE_GIT_VERSION
_REQUIRE_PLAIN_GIT_ENV

# Capture `HEAD` before any modification, for the status trailer's `old_head` field – stays
# empty outside a git repo or in an empty one, where the script fails later on commit
# resolution, so the trailer is never reached
SCRIPT_INITIAL_HEAD=$(git rev-parse HEAD 2>/dev/null)

# Resolves the `--text` value into `TEXT_VALUE` – `--text "msg"` as a separate arg or after
# an `=`, and `--text -` to read stdin, multi-line included
# `zparseopts` splits both into [--text, value], the `=value` form keeping its leading `=`
if [ ${#OPT_TEXT} -gt 0 ]; then
	if [[ ${#OPT_TEXT} -gt 1 ]]; then
		TEXT_VALUE=${OPT_TEXT[2]}
		[ "$TEXT_APART" = true ] || TEXT_VALUE=${TEXT_VALUE#=}
	fi
	if [ "$TEXT_VALUE" = "-" ]; then
		TEXT_VALUE=$(cat)
	fi
	# Keep the un-normalized text so a records batch can split on its own
	# `--- ` headers – the single-message stripspace below would still leave those
	# intact, but records parse from the raw form for clarity
	RAW_TEXT_VALUE=$TEXT_VALUE
	# Normalize whitespace the way the editor flow does, but not its comment stripping, which
	# exists to drop the instructions git seeds a template with – nothing seeds this one, so
	# a `#` line here is the caller's own content
	TEXT_VALUE=$(print -r -- "$TEXT_VALUE" | git stripspace)
	if [ -z "$TEXT_VALUE" ]; then
		PRINT_ERR "--text produced an empty message after stripping"
		exit 1
	fi
fi

# Resolve --verify's command – both `--verify=<cmd>` and `--verify <cmd>` forms
if [ ${#OPT_VERIFY} -gt 0 ]; then
	if [[ ${#OPT_VERIFY} -gt 1 ]]; then
		VERIFY_VALUE=${OPT_VERIFY[2]}
		[ "$VERIFY_APART" = true ] || VERIFY_VALUE=${VERIFY_VALUE#=}
	fi
	if [ -z "$VERIFY_VALUE" ]; then
		PRINT_ERR "--verify needs a command (--verify=<cmd>)"
		exit 1
	fi
	# Refused here rather than only where the gate runs: a pause persists the command as one
	# `key=value` line, and a conflict pause comes before any gate – a resume would then read
	# back the first line alone, a truncated check that can still exit 0
	if [ "$VERIFY_VALUE" != "${VERIFY_VALUE%%$'\n'*}" ]; then
		PRINT_ERR "The verify command spans multiple lines – a pause could only carry its first"
		ECHO_E "\e[0;31m  Put it in a script and name that instead.\e[0m" >&2
		exit 1
	fi
fi
# Resolve --tree's value – both `--tree=<tree-ish>` and `--tree <tree-ish>` forms
AMEND_TREE=""
if [ ${#OPT_TREE} -gt 0 ]; then
	if [[ ${#OPT_TREE} -gt 1 ]]; then
		AMEND_TREE=${OPT_TREE[2]#=}
	fi
	if [ -z "$AMEND_TREE" ]; then
		PRINT_ERR "--tree needs a tree-ish (--tree=<sha>)"
		exit 1
	fi
	if [ ${#OPT_AMEND_INTO} -eq 0 ]; then
		USAGE
		PRINT_ERR "--tree only applies to --amend-into"
		exit 1
	fi
fi
if [ ${#OPT_SNAPSHOT} -gt 0 ] && [ ${#OPT_AMEND_INTO} -eq 0 ]; then
	USAGE
	PRINT_ERR "--snapshot only applies to --amend-into"
	exit 1
fi
if [ ${#OPT_WHOLE} -gt 0 ]; then
	if [ ${#OPT_AMEND_INTO} -eq 0 ]; then
		USAGE
		PRINT_ERR "--whole only applies to --amend-into – a new commit of whole files takes --commit"
		exit 1
	fi
	if [ ${#OPT_TREE} -gt 0 ]; then
		PRINT_ERR "--whole and --tree cannot be combined – --whole composes the tree from the files itself"
		exit 1
	fi
fi
# Resolve --base's value – the tip an --exec result was built on, or the commit whole files rest
# on, both `--base=<sha>` and `--base <sha>` forms. Hex only: a name like HEAD resolves to
# wherever the branch is now, the very tip the flag exists to check the build against
EXEC_BASE=""
# Set by `--commit` alone – one in the caller's environment would rename every exec run
EXEC_LABEL=""
if [ ${#OPT_BASE} -gt 0 ]; then
	if [ ${#OPT_EXEC} -eq 0 ] && [ ${#OPT_COMMIT} -eq 0 ] && [ ${#OPT_AMEND_INTO} -eq 0 ]; then
		USAGE
		PRINT_ERR "--base only applies to --exec, --commit and --amend-into"
		exit 1
	fi
	if [[ ${#OPT_BASE} -gt 1 ]]; then
		EXEC_BASE=${OPT_BASE[2]#=}
	fi
	if [[ ! "$EXEC_BASE" =~ '^[0-9a-fA-F]{7,64}$' ]]; then
		PRINT_ERR "--base takes the SHA of the tip your history was built on (--base=<sha>)"
		ECHO_E "\e[0;31m  A name like HEAD resolves to wherever the branch is now – the tip the flag checks against.\e[0m" >&2
		exit 1
	fi
	if ! EXEC_BASE=$(git rev-parse --verify --quiet "$EXEC_BASE^{commit}" 2>/dev/null); then
		PRINT_ERR "--base ${OPT_BASE[2]#=} names no commit here"
		exit 1
	fi
fi
# A dry run builds and reports – it never verifies, the landing run does, so an explicit gate
# here would be a promise the run never keeps, and an opt-out one its landing line drops. Which
# checks to skip is also best settled once the result has been inspected
if [ ${#OPT_DRY_RUN} -gt 0 ]; then
	if [ ${#OPT_EXEC} -eq 0 ]; then
		USAGE
		PRINT_ERR "--dry-run only applies to --exec"
		exit 1
	fi
	if [ ${#OPT_VERIFY} -gt 0 -o ${#OPT_VERIFY_SPAN} -gt 0 -o ${#OPT_NO_VERIFY} -gt 0 -o ${#OPT_NO_VERIFY_SPAN} -gt 0 ]; then
		PRINT_ERR "--dry-run never verifies – the run that lands its result does, so pass verify flags there"
		exit 1
	fi
fi
# An explicit `--verify` on a mode with no gate would be silently ignored, a promise the run
# never keeps, so refuse it up front – `-M`/`-S` preserve every tree by construction
if [ ${#OPT_VERIFY} -gt 0 -o ${#OPT_VERIFY_SPAN} -gt 0 ] && [ ${#OPT_REWORD} -gt 0 -o ${#OPT_RESQUASH} -gt 0 ]; then
	PRINT_ERR "--verify cannot gate this mode"
	ECHO_E "\e[0;31m  A reword or -S preserves every tree by construction.\e[0m" >&2
	exit 1
fi
if [ ${#OPT_VERIFY_SPAN} -gt 0 ] && [ ${#OPT_NO_VERIFY_SPAN} -gt 0 ]; then
	PRINT_ERR "--verify-span and --no-verify-span cannot be combined"
	exit 1
fi

# Takes the pause's label for the resume – a labeled caller's run is its own to resume or cancel,
# so another label refuses, as `--undo` does, while a person at a terminal may finish an agent's
_ADOPT_PAUSE_ACTOR () {
	# Args: <continue|abort>
	# A terminal's prompt resumes the pause it showed – another run may have ended that one and taken
	# the slot in the moment between
	if [ -n "$_EXPECT_PAUSE" ] && [ "$(_PAUSE_IDENTITY "$_STATE_PATH")" != "$_EXPECT_PAUSE" ]; then
		_STATE_OWNED=""
		PRINT_ERR "The pause the prompt showed is no longer pending – another run ended it or took the slot – so nothing was done"
		exit 1
	fi
	if [ -n "$_ACTOR" ] && [ "$STATE_ACTOR" != "$_ACTOR" ] && [ ${#OPT_ALLOW_OTHER_ACTOR} -eq 0 ]; then
		_STATE_OWNED=""
		PRINT_ERR "The paused ${STATE_ACTION:-$STATE_OPERATION} is ${${STATE_ACTOR:+$STATE_ACTOR's}:-an unlabeled caller's} – refusing to $1 it as $_ACTOR"
		ECHO_E "\e[0;31m  Leave it to that caller – or pass --allow-other-actor to $1 it anyway.\e[0m" >&2
		exit 1
	fi
	if [ -n "$STATE_ACTOR" ]; then
		_ACTOR=$STATE_ACTOR
		_REFLOG_TAG=" [$_ACTOR]"
	fi
}

# `--continue` and `--abort` dispatch – resume or cancel an in-flight operation, mirroring
# `git rebase --continue` and `--abort`, and short-circuiting before any of the normal
# argument validation gets a chance to run
if [ ${#OPT_CONTINUE} -gt 0 ] && [ ${#OPT_ABORT} -gt 0 ]; then
	PRINT_ERR "--continue and --abort cannot be combined"
	exit 1
fi
# --skip resumes too, just past the current commit rather than through it
if [ ${#OPT_SKIP} -gt 0 ]; then
	if [ ${#OPT_ABORT} -gt 0 ]; then
		PRINT_ERR "--skip and --abort cannot be combined"
		exit 1
	fi
	OPT_CONTINUE=(--continue)
fi
if [ ${#OPT_CONTINUE} -gt 0 ]; then
	_LOAD_STATE
	_ADOPT_PAUSE_ACTOR continue
	_REANCHOR_INITIAL_HEAD
	if [ -n "$STATE_CAPTURE" ]; then
		_CAPTURE_BEGIN resume "$STATE_CAPTURE"
	fi
	# Only a replant has commits worth stepping over – elsewhere the paused
	# commit is the whole point, so skipping it would quietly discard the work
	if [ ${#OPT_SKIP} -gt 0 ] && [ "$STATE_OPERATION" != "onto" ]; then
		PRINT_ERR "--skip applies to --onto only; '$STATE_OPERATION' has no commit to step over"
		exit 1
	fi
	if [ -n "$STATE_WORKTREE" ] && [ -d "$STATE_WORKTREE" ]; then
		# Config added mid-pause reaches the existing worktree here – links are created only at
		# worktree setup and re-ensuring is idempotent, while a mode that saved no maindir falls
		# back to the worktree's own registration
		_LINK_WORKTREE_EXTRAS "$STATE_WORKTREE" "${STATE_MAINDIR:-$(git -C "$STATE_WORKTREE" worktree list --porcelain 2>/dev/null | LC_ALL=C sed -n '1s/^worktree //p')}"
		# A verify pause is not a content-edit pause – the result is already built, and both the
		# re-verify and the restore below check out with `-f`, so work authored here would vanish
		# Tracked files only, never a submodule pointer, or an unrelated dirty one refuses forever
		if { [ -n "$STATE_VERIFY_FAILED" ] || [ -n "$STATE_MODE_STRAY" ]; } && [ -n "$(git -C "$STATE_WORKTREE" status --porcelain --untracked-files=no --ignore-submodules=all 2>/dev/null)" ]; then
			PRINT_ERR "The pause worktree carries edits, but a gate pause has nothing to fold them into – the result is already built"
			ECHO_E "\e[0;31m  Save anything worth keeping, then discard them: $(_LIT "git -C $(_SHQ "$STATE_WORKTREE") checkout -- .")\e[0m" >&2
			if [ -n "$STATE_VERIFY_FAILED" ]; then
				ECHO_E "\e[0;31m  Repair the commit itself: 'git edit --no-verify --continue' applies the result, then 'git edit ${STATE_VERIFY_FAILED:0:7}'.\e[0m" >&2
			else
				ECHO_E "\e[0;31m  Repair the commit itself: 'git edit --allow-mode-change --continue' applies the result, then 'git edit ${STATE_MODE_STRAY:0:7}'.\e[0m" >&2
			fi
			exit 1
		fi
		# Untracked files feed the gate's run yet never land, so a resolution's new file left
		# unstaged passes a check its result fails – only an authoring stage absorbs them
		if _VERIFY_CONFIGURED; then
			RESUME_GD=$(git -C "$STATE_WORKTREE" rev-parse --absolute-git-dir 2>/dev/null)
			RESUME_ABSORBS=false
			if [ -z "$STATE_VERIFY_FAILED$STATE_MODE_STRAY" ] && [ ! -d "$RESUME_GD/rebase-merge" ] && [ ! -d "$RESUME_GD/rebase-apply" ]; then
				[ "$STATE_OPERATION" = split ] && RESUME_ABSORBS=true
				[ "$STATE_OPERATION" = edit ] && [ "$(git -C "$STATE_WORKTREE" rev-parse HEAD 2>/dev/null)" = "$STATE_TARGET" ] && RESUME_ABSORBS=true
			fi
			RESUME_STRAY=$(git -C "$STATE_WORKTREE" -c core.quotePath=false ls-files -o --exclude-standard --directory --no-empty-directory 2>/dev/null)
			if [ "$RESUME_ABSORBS" = false ] && [ -n "$RESUME_STRAY" ]; then
				PRINT_ERR "Untracked files in the pause worktree would feed the verify check but never land: $(_JOIN_PATHS "$RESUME_STRAY")"
				if [ -n "$STATE_VERIFY_FAILED$STATE_MODE_STRAY" ]; then
					ECHO_E "\e[0;31m  Remove them – the result is already built, so one it needs is a fix to the commit itself.\e[0m" >&2
				else
					ECHO_E "\e[0;31m  Stage the ones the resolution needs and remove the rest, then 'git edit --continue'.\e[0m" >&2
				fi
				exit 1
			fi
		fi
		RESUME_WT_GD=$(git -C "$STATE_WORKTREE" rev-parse --absolute-git-dir 2>/dev/null)
		# After a verify pause the built result is recorded – put the worktree back on it before any
		# handler reads its `HEAD` as the result to apply, since the inspect hint checks out the
		# failing commit and a continue from there would land it as the tip
		# A rebase in progress there is a later stop's, which the result predates
		if [ -n "$STATE_VERIFY_RESULT" ] && [ ! -d "$RESUME_WT_GD/rebase-merge" ] && [ ! -d "$RESUME_WT_GD/rebase-apply" ]; then
			if git -C "$STATE_WORKTREE" rev-parse -q --verify "$STATE_VERIFY_RESULT^{commit}" >/dev/null 2>&1; then
				RESUME_HEAD=$(git -C "$STATE_WORKTREE" rev-parse HEAD 2>/dev/null)
				if [ "$RESUME_HEAD" != "$STATE_VERIFY_RESULT" ]; then
					# Commits made on the result, or edits, would go with the restore – refused, never discarded
					if git -C "$STATE_WORKTREE" merge-base --is-ancestor "$STATE_VERIFY_RESULT" "$RESUME_HEAD" 2>/dev/null; then
						PRINT_ERR "Commits were made on the built result ${STATE_VERIFY_RESULT:0:7}, which a gate pause lands as it was built – nothing was applied"
						git -C "$STATE_WORKTREE" log --reverse --format='%h %s' "$STATE_VERIFY_RESULT..$RESUME_HEAD" 2>/dev/null | _CARET_LINES | LC_ALL=C sed "s/^/${_RED}  /;s/\$/${_OFF}/" >&2
						ECHO_E "\e[0;31m  Save them, then 'git -C $(_LIT "$(_SHQ "$STATE_WORKTREE")") reset --hard ${STATE_VERIFY_RESULT:0:12}' and 'git edit --continue' – fold them in after it lands.\e[0m" >&2
						exit 1
					fi
					if [ -n "$(git -C "$STATE_WORKTREE" status --porcelain --untracked-files=no --ignore-submodules=all 2>/dev/null)" ]; then
						PRINT_ERR "The pause worktree is off the built result ${STATE_VERIFY_RESULT:0:7}, with edits a restore would discard – nothing was applied"
						ECHO_E "\e[0;31m  Save anything worth keeping, then discard them: $(_LIT "git -C $(_SHQ "$STATE_WORKTREE") checkout -- .")\e[0m" >&2
						exit 1
					fi
					PRINT_TEXT "Worktree HEAD is off the built result (an inspect checkout, say) – restoring %s" 33 "${STATE_VERIFY_RESULT:0:7}"
					if ! git -C "$STATE_WORKTREE" checkout -q --detach "$STATE_VERIFY_RESULT" 2>/dev/null; then
						PRINT_ERR "Could not put the pause worktree back on the built result ${STATE_VERIFY_RESULT:0:7} – nothing was applied"
						ECHO_E "\e[0;31m  Check it out there by hand ('git -C $(_LIT "$(_SHQ "$STATE_WORKTREE")") checkout --detach ${STATE_VERIFY_RESULT:0:12}'), then 'git edit --continue'.\e[0m" >&2
						exit 1
					fi
				fi
			else
				# Falling back to worktree `HEAD` would reopen the truncation trap
				# this marker exists to close – refuse instead
				PRINT_ERR "Recorded result ${STATE_VERIFY_RESULT:0:7} no longer resolves – the pause likely outlived the reflog"
				ECHO_E "\e[0;31m  Nothing can apply it now – 'git edit --abort' cancels with nothing consumed.\e[0m" >&2
				exit 1
			fi
		fi
	fi
	# A drop or squash, reorder or replant has no message left to take – refused rather than dropped
	if [ -n "$TEXT_VALUE" ] && [[ "$STATE_OPERATION" == (rebase|reorder|onto) ]]; then
		PRINT_ERR "--text has no message to set on this ${STATE_ACTION:-$STATE_OPERATION}'s continue – finish it, then reword: git edit -M --text=\"…\" <sha>"
		exit 1
	fi
	case "$STATE_OPERATION" in
		amend-into) _CONTINUE_AMEND_INTO ;;
		snapshot)   _CONTINUE_SNAPSHOT ;;
		reorder)    _CONTINUE_REORDER ;;
		onto)       _CONTINUE_ONTO ;;
		rebase)     _CONTINUE_REBASE ;;
		edit)       _CONTINUE_EDIT ;;
		split)      _CONTINUE_SPLIT ;;
		*) PRINT_ERR "Unknown saved operation: '$STATE_OPERATION'"; exit 1 ;;
	esac
	exit 0
fi
if [ ${#OPT_ABORT} -gt 0 ]; then
	_LOAD_STATE
	_ADOPT_PAUSE_ACTOR abort
	_REANCHOR_INITIAL_HEAD
	case "$STATE_OPERATION" in
		amend-into) _ABORT_AMEND_INTO ;;
		snapshot)   _ABORT_SNAPSHOT ;;
		reorder)    _ABORT_REORDER ;;
		onto)       _ABORT_ONTO ;;
		rebase)     _ABORT_REBASE ;;
		edit)       _ABORT_EDIT ;;
		split)      _ABORT_SPLIT ;;
		*)
			# An unreadable pause, or one a newer version wrote – cleared, its
			# worktree removed only where this tool made it
			PRINT_TEXT "%s – clearing it." 33 "The pause records no operation this version knows${STATE_OPERATION:+ ('$STATE_OPERATION')}"
			if [ -n "$STATE_WORKTREE" ] && [ -d "$STATE_WORKTREE" ] && [[ "${STATE_WORKTREE:t}" == git-edit-* ]]; then
				git worktree remove --force "$STATE_WORKTREE" 2>/dev/null
				rm -rf "$STATE_WORKTREE"
			fi
			_CLEAR_STATE
			EMIT_STATUS "$(git rev-parse HEAD 2>/dev/null)" "$(_CURRENT_REF)" false
			;;
	esac
	exit 0
fi

# `--undo`, `--status`, `--carry` and `--selftest` are standalone commands – no positionals, no
# mode flags, dispatched before any commit parsing, and stray arguments are refused rather than
# ignored, since `--undo <sha>` would otherwise undo whatever happens to be last
if [ ${#OPT_JOBS} -gt 0 ] && [ ${#OPT_SELFTEST} -eq 0 ]; then
	PRINT_ERR "--jobs only applies to --selftest"
	exit 1
fi
if [ ${#OPT_UNDO} -gt 0 ] || [ ${#OPT_STATUS} -gt 0 ] || [ ${#OPT_CARRY} -gt 0 ] || [ ${#OPT_SELFTEST} -gt 0 ]; then
	if [ $# -gt 0 ]; then
		USAGE
		PRINT_ERR "--undo/--status/--carry/--selftest take no arguments (got: $*)"
		exit 1
	fi
fi
if [ ${#OPT_UNDO} -gt 0 ]; then
	GIT_UNDO
	exit 0
fi
if [ ${#OPT_STATUS} -gt 0 ]; then
	GIT_STATUS_REPORT
	exit 0
fi
if [ ${#OPT_CARRY} -gt 0 ]; then
	GIT_CARRY "${${OPT_CARRY[1]#--carry}#=}"
	exit 0
fi
if [ ${#OPT_SELFTEST} -gt 0 ]; then
	# The suite is a sibling dir, sourced only here: its scaffolding in the middle of the tool made
	# both harder to read, and every other run should not pay to parse it
	SELFTEST_DIR="${0:A:h}/selftest"
	if [ ! -f "$SELFTEST_DIR/lib.zsh" ]; then
		PRINT_ERR "Selftest suite not found: $SELFTEST_DIR"
		ECHO_E "\e[0;31m  It ships alongside this script – copy it from the repository.\e[0m" >&2
		exit 1
	fi
	# Scenario 88 runs picks of the suite from inside it, one level down – a pick reaching 88 itself
	# would nest without end, each level starting three more
	if (( ${GIT_EDIT_SELFTEST_DEPTH:-0} >= 2 )); then
		PRINT_ERR "A selftest two levels inside another – a pick reached the scenario that runs picks"
		exit 1
	fi
	# `--jobs` hands the suite to units run side by side, ahead of the depth count each of them
	# keeps for itself – `=<n>` at a time, else one a core
	if [ ${#OPT_JOBS} -gt 0 ]; then
		SELFTEST_JOBS=${${OPT_JOBS[1]#--jobs}#=}
		if [ -z "$SELFTEST_JOBS" ]; then
			SELFTEST_JOBS=$(getconf _NPROCESSORS_ONLN 2>/dev/null)
			[[ "$SELFTEST_JOBS" == <1-> ]] || SELFTEST_JOBS=4
		fi
		if [[ "$SELFTEST_JOBS" != <1-> ]]; then
			PRINT_ERR "--jobs takes a count of 1 or more (got: $SELFTEST_JOBS)"
			exit 1
		fi
		_SELFTEST_JOBS "${0:A}" "$SELFTEST_DIR" "${OPT_SELFTEST[1]}" "$SELFTEST_JOBS"
		exit $?
	fi
	export GIT_EDIT_SELFTEST_DEPTH=$(( ${GIT_EDIT_SELFTEST_DEPTH:-0} + 1 ))
	# `--selftest=<pick>` runs those scenarios alone, `--selftest 83` arriving glued as
	# `--selftest83` – the whole suite, a pick of every one, says nothing of what ran
	if [ "${OPT_SELFTEST[1]}" = "--selftest" ]; then
		_SELFTEST_PICK "$SELFTEST_DIR" - || exit 1
		SELFTEST_SCOPE=""
	else
		_SELFTEST_PICK "$SELFTEST_DIR" "${${OPT_SELFTEST[1]#--selftest}#=}" || exit 1
		PRINT_TEXT "Running %s – a commit or a release takes the full suite" 33 "$SELFTEST_SCOPE"
	fi
	source "$SELFTEST_DIR/lib.zsh"
	# ${0:A} resolves the running script's absolute path at top level (inside
	# functions zsh rebinds $0 to the function name)
	GIT_SELFTEST "${0:A}"
	exit $?
fi

# Past this point every path mutates history, and the standalone commands that
# resolve a pause (--continue/--abort/--undo/--status) have already exited –
# which also keeps the sweep off the read-only reporting paths
_GC_ORPHANED_WORKTREES
_REQUIRE_NO_INFLIGHT

# Extract the `-C`/`--dir` value – `zparseopts` with `::` greedily consumes the next word
# unless it starts with `-`, so `git edit -C HEAD~1` would take `HEAD~1` as the path, and
# without an `=` a value parsing as a git ref is re-injected as a positional instead
if [ ${#OPT_DIR} -gt 0 ]; then
	DIR_HAS_EQUALS=false
	if [[ "${OPT_DIR[1]}" == *"="* ]]; then
		DIR_HAS_EQUALS=true
		WORKTREE_DIR=${OPT_DIR[1]#*=}
	elif [[ "${OPT_DIR[1]}" == "-C"?* ]]; then
		WORKTREE_DIR=${OPT_DIR[1]#-C}
	elif [[ "${OPT_DIR[1]}" == "--dir"?* ]]; then
		WORKTREE_DIR=${OPT_DIR[1]#--dir}
	fi

	if [ "$DIR_HAS_EQUALS" = false ] && [ -n "$WORKTREE_DIR" ]; then
		IS_REF=false
		if [[ "$WORKTREE_DIR" == *".."* && "$WORKTREE_DIR" != *"..."* ]]; then
			git rev-list "$WORKTREE_DIR" >/dev/null 2>&1 && IS_REF=true
		elif git rev-parse --quiet --verify "$WORKTREE_DIR" >/dev/null 2>&1; then
			IS_REF=true
		fi
		if [ "$IS_REF" = true ]; then
			set -- "$WORKTREE_DIR" "$@"
			WORKTREE_DIR=""
		fi
	fi
	# Absolute – the run enters the worktree, where a relative path named something else, and the
	# gate given it found nothing to run in
	[ -n "$WORKTREE_DIR" ] && WORKTREE_DIR=${WORKTREE_DIR:a}
fi

# Extract the `-s`/`--squash` value, applying the same re-injection heuristic as `-C` – its
# argument was once required and greedily consumed the next word, so `-s HEAD~2..HEAD`
# read as a target and errored, where now `-s=<target>` is the only explicit form
if [ ${#OPT_SQUASH} -gt 0 ]; then
	SQUASH_HAS_EQUALS=false
	if [[ "${OPT_SQUASH[1]}" == *"="* ]]; then
		SQUASH_HAS_EQUALS=true
		TARGET=${OPT_SQUASH[1]#*=}
	elif [[ "${OPT_SQUASH[1]}" == "-s"?* ]]; then
		TARGET=${OPT_SQUASH[1]#-s}
	elif [[ "${OPT_SQUASH[1]}" == "--squash"?* ]]; then
		TARGET=${OPT_SQUASH[1]#--squash}
	fi

	if [ "$SQUASH_HAS_EQUALS" = false ] && [ -n "$TARGET" ]; then
		IS_REF=false
		if [[ "$TARGET" == *".."* && "$TARGET" != *"..."* ]]; then
			git rev-list "$TARGET" >/dev/null 2>&1 && IS_REF=true
		elif git rev-parse --quiet --verify "$TARGET" >/dev/null 2>&1; then
			IS_REF=true
		fi
		if [ "$IS_REF" = true ]; then
			set -- "$TARGET" "$@"
			TARGET=""
		fi
	fi
fi

# Conflict checks
if [ ${#OPT_MESSAGE} -gt 0 -a ${#OPT_DROP} -gt 0 ]; then
	USAGE
	PRINT_ERR "Options -m/--message and -d/--drop cannot be combined"
	exit 1
fi
if [ ${#OPT_DROP} -gt 0 -a ${#OPT_SQUASH} -gt 0 ]; then
	USAGE
	PRINT_ERR "Options -d/--drop and -s/--squash cannot be combined"
	exit 1
fi
if [ ${#OPT_REWORD} -gt 0 ] && [ ${#OPT_MESSAGE} -gt 0 -o ${#OPT_DROP} -gt 0 -o ${#OPT_SQUASH} -gt 0 -o ${#OPT_DIR} -gt 0 -o ${#OPT_RESQUASH} -gt 0 ]; then
	USAGE
	PRINT_ERR "Option -M/--reword cannot be combined with -m/-d/-s/-S/-C (reword is message-only and works without touching the working tree)"
	exit 1
fi
if [ ${#OPT_RESQUASH} -gt 0 ] && [ ${#OPT_DROP} -gt 0 -o ${#OPT_SQUASH} -gt 0 -o ${#OPT_DIR} -gt 0 ]; then
	USAGE
	PRINT_ERR "Option -S/--resquash cannot be combined with -d/-s/-C (resquash uses plumbing only; for non-contiguous squashes use -s with -C)"
	exit 1
fi
if [ ${#OPT_EXEC} -gt 0 ] && [ ${#OPT_MESSAGE} -gt 0 -o ${#OPT_REWORD} -gt 0 -o ${#OPT_DROP} -gt 0 -o ${#OPT_SQUASH} -gt 0 -o ${#OPT_RESQUASH} -gt 0 -o ${#OPT_DIR} -gt 0 -o ${#OPT_AMEND_INTO} -gt 0 -o ${#OPT_SPLIT} -gt 0 -o ${#OPT_REORDER} -gt 0 -o ${#OPT_MOVE} -gt 0 ]; then
	USAGE
	PRINT_ERR "Option --exec cannot be combined with other modes (--exec is its own mode and manages its own isolated worktree)"
	exit 1
fi
if [ ${#OPT_AMEND_INTO} -gt 0 ] && [ ${#OPT_MESSAGE} -gt 0 -o ${#OPT_REWORD} -gt 0 -o ${#OPT_DROP} -gt 0 -o ${#OPT_SQUASH} -gt 0 -o ${#OPT_RESQUASH} -gt 0 -o ${#OPT_DIR} -gt 0 -o ${#OPT_EXEC} -gt 0 -o ${#OPT_SPLIT} -gt 0 -o ${#OPT_MOVE} -gt 0 ]; then
	USAGE
	PRINT_ERR "Option --amend-into cannot be combined with -m, -M, -d, -s, -S, -C, --exec, --split or --move (it folds staged changes into <sha> on its own)"
	if [ ${#OPT_REWORD} -gt 0 ]; then
		ECHO_E "\e[0;31m  To fold and reword at once: git edit --amend-into=<sha> --text=\"…\"\e[0m" >&2
		ECHO_E "\e[0;31m  To reword only: git edit -M --text=\"…\" <sha>\e[0m" >&2
	fi
	exit 1
fi
if [ ${#OPT_REORDER} -gt 0 ] && [ ${#OPT_MESSAGE} -gt 0 -o ${#OPT_REWORD} -gt 0 -o ${#OPT_DROP} -gt 0 -o ${#OPT_SQUASH} -gt 0 -o ${#OPT_RESQUASH} -gt 0 -o ${#OPT_DIR} -gt 0 -o ${#OPT_EXEC} -gt 0 -o ${#OPT_AMEND_INTO} -gt 0 -o ${#OPT_SPLIT} -gt 0 -o ${#OPT_MOVE} -gt 0 ]; then
	USAGE
	PRINT_ERR "Option --reorder cannot be combined with other modes (it manages its own isolated worktree)"
	exit 1
fi
if [ ${#OPT_ONTO} -gt 0 ] && [ ${#OPT_MESSAGE} -gt 0 -o ${#OPT_REWORD} -gt 0 -o ${#OPT_DROP} -gt 0 -o ${#OPT_SQUASH} -gt 0 -o ${#OPT_RESQUASH} -gt 0 -o ${#OPT_DIR} -gt 0 -o ${#OPT_EXEC} -gt 0 -o ${#OPT_AMEND_INTO} -gt 0 -o ${#OPT_SPLIT} -gt 0 -o ${#OPT_REORDER} -gt 0 -o ${#OPT_MOVE} -gt 0 -o -n "$TEXT_VALUE" ]; then
	USAGE
	PRINT_ERR "Option --onto cannot be combined with other modes (it replays the whole branch, not a named commit)"
	exit 1
fi
if [ ${#OPT_MOVE} -eq 0 ] && [ ${#OPT_AFTER} -gt 0 -o ${#OPT_BEFORE} -gt 0 ]; then
	USAGE
	PRINT_ERR "--after/--before only apply to --move"
	exit 1
fi
# `-e` names the default mode rather than adding one, so it pairs with `-m` and `-C` as the
# bare form does – every other mode contradicts it
if [ ${#OPT_EDIT} -gt 0 ] && [ ${#OPT_REWORD} -gt 0 -o ${#OPT_DROP} -gt 0 -o ${#OPT_SQUASH} -gt 0 -o ${#OPT_RESQUASH} -gt 0 -o ${#OPT_EXEC} -gt 0 -o ${#OPT_AMEND_INTO} -gt 0 -o ${#OPT_SPLIT} -gt 0 -o ${#OPT_REORDER} -gt 0 -o ${#OPT_MOVE} -gt 0 -o ${#OPT_ONTO} -gt 0 ]; then
	USAGE
	PRINT_ERR "Option -e/--edit cannot be combined with another mode (it names the default one: edit a single commit's content)"
	exit 1
fi
# `--text` is incompatible with `-d` and `--exec` – the full check against the resolved
# action, implicit squash included, happens after action determination, so it also
# catches `--text` with edit mode
if [ ${#OPT_TEXT} -gt 0 ] && [ ${#OPT_DROP} -gt 0 ]; then
	USAGE
	PRINT_ERR "Option --text doesn't apply to -d/--drop"
	exit 1
fi
if [ ${#OPT_TEXT} -gt 0 ] && [ ${#OPT_EXEC} -gt 0 ]; then
	USAGE
	PRINT_ERR "Option --text doesn't apply to --exec"
	exit 1
fi

# `--commit` dispatches ahead of `--exec`, which lands what it composes – its positional args
# being the files to take whole rather than commits
if [ ${#OPT_COMMIT} -gt 0 ]; then
	# The `git commit` habit, where `-m` here asks to edit a past commit's message
	if [ ${#OPT_MESSAGE} -gt 0 ]; then
		PRINT_ERR "--commit takes its message as --text \"…\" – -m is git edit's --message, for a past commit"
		exit 1
	fi
	if [ ${#OPT_REWORD} -gt 0 -o ${#OPT_DROP} -gt 0 -o ${#OPT_SQUASH} -gt 0 -o ${#OPT_RESQUASH} -gt 0 -o ${#OPT_DIR} -gt 0 -o ${#OPT_EXEC} -gt 0 -o ${#OPT_AMEND_INTO} -gt 0 -o ${#OPT_SPLIT} -gt 0 -o ${#OPT_REORDER} -gt 0 -o ${#OPT_MOVE} -gt 0 -o ${#OPT_ONTO} -gt 0 -o ${#OPT_EDIT} -gt 0 ]; then
		USAGE
		PRINT_ERR "Option --commit cannot be combined with other modes – folding whole files into a past commit takes --amend-into=<sha> --whole"
		exit 1
	fi
	if [ "$1" = "--" ]; then
		shift
	fi
	if [ $# -eq 0 ]; then
		USAGE
		PRINT_ERR "--commit needs the files to take: git edit --commit --text \"…\" -- <path>..."
		exit 1
	fi
	if [ -z "$TEXT_VALUE" ]; then
		PRINT_ERR "--commit needs a message: --text \"…\", or --text - to read it from stdin"
		exit 1
	fi
	GIT_COMMIT_WHOLE "$@"
	PRINT_COMPLETED "$EXEC_NEW_HEAD" "$EXEC_REF" "$EXEC_CHANGED"
	exit 0
fi


# `--exec` short-circuits everything below, its positional args being the wrapped command
# rather than commits – set up an isolated temp worktree, run the command there, and
# update the original branch ref atomically where `HEAD` changed, the raw-git escape hatch
if [ ${#OPT_EXEC} -gt 0 ]; then
	# `zparseopts` does not consume the `--` separator, it just stops parsing at it – strip it
	# so `$@` holds only the wrapped command
	if [ "$1" = "--" ]; then
		shift
	fi
	if [ $# -eq 0 ]; then
		USAGE
		PRINT_ERR "--exec requires a command (use -- to separate it from flags)"
		exit 1
	fi
	# Two shapes seen in the wild that run something other than what was meant: one quoted
	# shell line, which `"$@"` runs as a program of that name, and a commit ahead of the
	# command, which runs the SHA – neither exists as a program, so name the shape rather
	# than leave a bare 127
	if ! command -v -- "$1" >/dev/null 2>&1; then
		if [ $# -eq 1 ] && [[ "$1" == *[[:space:]]* ]]; then
			PRINT_ERR "'$1' is one argument, run as a program of that name – a shell line goes through the shell: --exec -- sh -c '…'"
			exit 1
		fi
		if git rev-parse --verify --quiet "$1^{commit}" >/dev/null 2>&1; then
			PRINT_ERR "--exec takes no commit – it runs at the tip; to run at ${1:0:7}, add a worktree there (git worktree add --detach <dir> ${1:0:7})"
			exit 1
		fi
	fi
	GIT_EXEC "$@"
	if [ -n "$EXEC_DRY_BUILT" ]; then
		EMIT_DRY_RUN "$EXEC_DRY_BUILT" "$EXEC_DRY_BASE" "$EXEC_REF"
		exit 0
	fi
	PRINT_COMPLETED "$EXEC_NEW_HEAD" "$EXEC_REF" "$EXEC_CHANGED" "$EXEC_PEER_MOVE"
	exit 0
fi

# `--move` dispatches early – repositions commits directly after or before an anchor by computing
# the minimal span and desired order, then delegating to the reorder machinery, so span derivation,
# the error-prone part of hand-rolled calls, is owned here. Each `--move` names a commit or an
# inclusive run, and several move together as one block in their history order, whatever lies
# between them staying where it is – in one replay, where a commit at a time would replay the
# span, and verify it under a standing `edit.verifySpan`, once per commit
if [ ${#OPT_MOVE} -gt 0 ]; then
	MOVE_ARGS=()
	for (( MOVE_I = 2; MOVE_I <= ${#OPT_MOVE}; MOVE_I += 2 )); do
		MOVE_ARGS+=("${OPT_MOVE[$MOVE_I]#=}")
	done
	MOVE_EMPTY=$(( ${#MOVE_ARGS[@]} == 0 ))
	for MOVE_ARG in "${MOVE_ARGS[@]}"; do
		[ -z "$MOVE_ARG" ] && MOVE_EMPTY=1
	done
	if [ $MOVE_EMPTY -eq 1 ]; then
		USAGE
		PRINT_ERR "--move requires a <sha> value (e.g., --move=abc123)"
		exit 1
	fi
	if [ ${#OPT_MESSAGE} -gt 0 -o ${#OPT_REWORD} -gt 0 -o ${#OPT_DROP} -gt 0 -o ${#OPT_SQUASH} -gt 0 -o ${#OPT_RESQUASH} -gt 0 -o ${#OPT_DIR} -gt 0 -o ${#OPT_EXEC} -gt 0 -o ${#OPT_AMEND_INTO} -gt 0 -o ${#OPT_SPLIT} -gt 0 -o ${#OPT_REORDER} -gt 0 -o -n "$TEXT_VALUE" ]; then
		USAGE
		PRINT_ERR "Option --move cannot be combined with other modes"
		exit 1
	fi
	if [ ${#OPT_AFTER} -gt 0 ] && [ ${#OPT_BEFORE} -gt 0 ]; then
		PRINT_ERR "--move takes exactly one of --after=<sha> or --before=<sha>, not both"
		exit 1
	fi
	MOVE_ANCHOR=""
	MOVE_KIND=""
	if [ ${#OPT_AFTER} -gt 0 ]; then
		MOVE_ANCHOR="${OPT_AFTER[2]#=}"
		MOVE_KIND="after"
	elif [ ${#OPT_BEFORE} -gt 0 ]; then
		MOVE_ANCHOR="${OPT_BEFORE[2]#=}"
		MOVE_KIND="before"
	fi
	if [ -z "$MOVE_ANCHOR" ]; then
		USAGE
		PRINT_ERR "--move requires a destination: --after=<sha> or --before=<sha>"
		exit 1
	fi
	if [ $# -gt 0 ]; then
		USAGE
		PRINT_ERR "--move takes no positional arguments (commits and destination are flag values – several commits go as --move=<a> --move=<b>, a run of commits as --move=<oldest>..<newest>)"
		exit 1
	fi
	if ! git rev-parse --quiet --verify "$MOVE_ANCHOR^{commit}" >/dev/null 2>&1; then
		PRINT_ERR "Unknown <sha>: $MOVE_ANCHOR"
		exit 1
	fi
	# Each value a commit or a run, read inclusive as every range here is – either way round, an
	# open end being `HEAD` – and each end resolved like any other target where a rewrite staled it
	MOVE_SET=()
	for MOVE_ARG in "${MOVE_ARGS[@]}"; do
		if [[ "$MOVE_ARG" == *".."* && "$MOVE_ARG" != *"..."* ]]; then
			MOVE_FROM="${${MOVE_ARG%%..*}:-HEAD}"
			MOVE_TO="${${MOVE_ARG#*..}:-HEAD}"
		else
			MOVE_FROM=$MOVE_ARG
			MOVE_TO=$MOVE_ARG
		fi
		for MOVE_END in "$MOVE_FROM" "$MOVE_TO"; do
			if ! git rev-parse --quiet --verify "$MOVE_END^{commit}" >/dev/null 2>&1; then
				PRINT_ERR "Unknown <sha>: $MOVE_END"
				exit 1
			fi
		done
		_GUARD_REACHABLE "$MOVE_FROM"
		MOVE_FROM_RESOLVED=$(git rev-parse "$_RESOLVED_SHA^{commit}")
		if [ "$MOVE_TO" = "$MOVE_FROM" ]; then
			MOVE_TO=$MOVE_FROM_RESOLVED
		else
			_GUARD_REACHABLE "$MOVE_TO"
			MOVE_TO=$(git rev-parse "$_RESOLVED_SHA^{commit}")
		fi
		MOVE_FROM=$MOVE_FROM_RESOLVED
		if [ "$MOVE_FROM" != "$MOVE_TO" ] && git merge-base --is-ancestor "$MOVE_TO" "$MOVE_FROM" 2>/dev/null; then
			MOVE_END=$MOVE_FROM
			MOVE_FROM=$MOVE_TO
			MOVE_TO=$MOVE_END
		fi
		if [ "$MOVE_FROM" = "$MOVE_TO" ]; then
			MOVE_PART=("$MOVE_FROM")
		elif ! git merge-base --is-ancestor "$MOVE_FROM" "$MOVE_TO" 2>/dev/null; then
			PRINT_ERR "Commits ${MOVE_FROM:0:7} and ${MOVE_TO:0:7} are not on one line of history"
			exit 1
		elif git rev-parse --verify -q "$MOVE_FROM^" >/dev/null 2>&1; then
			MOVE_PART=($(git rev-list --reverse "$MOVE_FROM^..$MOVE_TO"))
		else
			MOVE_PART=($(git rev-list --reverse "$MOVE_TO"))
		fi
		for MOVE_STEP in "${MOVE_PART[@]}"; do
			(( ${MOVE_SET[(Ie)$MOVE_STEP]} )) || MOVE_SET+=("$MOVE_STEP")
		done
	done
	_GUARD_REACHABLE "$MOVE_ANCHOR"
	MOVE_ANCHOR=$(git rev-parse "$_RESOLVED_SHA^{commit}")
	# In history order, whatever order they were named in
	MOVE_SORTED=($(git rev-list --reverse HEAD 2>/dev/null | grep -Fx -f <(printf '%s\n' "${MOVE_SET[@]}") 2>/dev/null))
	if [ ${#MOVE_SORTED[@]} -ne ${#MOVE_SET[@]} ]; then
		PRINT_ERR "--move names a commit HEAD does not reach"
		exit 1
	fi
	MOVE_SET=("${MOVE_SORTED[@]}")
	MOVE_FIRST=${MOVE_SET[1]}
	MOVE_LAST=${MOVE_SET[-1]}
	if (( ${MOVE_SET[(Ie)$MOVE_ANCHOR]} )); then
		if [ ${#MOVE_SET[@]} -eq 1 ]; then
			PRINT_ERR "--move commit and its --$MOVE_KIND anchor are the same commit"
		elif [ ${#MOVE_ARGS[@]} -eq 1 ]; then
			PRINT_ERR "--$MOVE_KIND anchor ${MOVE_ANCHOR:0:7} lies inside the moved run ${MOVE_FIRST:0:7}..${MOVE_LAST:0:7}"
		else
			PRINT_ERR "--$MOVE_KIND anchor ${MOVE_ANCHOR:0:7} is one of the commits being moved"
		fi
		exit 1
	fi
	# Minimal span: the moved commits and the anchor inclusive, oldest-first – contiguous by
	# construction, so the reorder pre-flight checks pass or refuse cleanly (merge in span,
	# pushed base). The anchor may lie below them, above them, or between them
	if git merge-base --is-ancestor "$MOVE_LAST" "$MOVE_ANCHOR" 2>/dev/null; then
		MOVE_SPAN_OLD=$MOVE_FIRST
		MOVE_SPAN_NEW=$MOVE_ANCHOR
	elif git merge-base --is-ancestor "$MOVE_ANCHOR" "$MOVE_FIRST" 2>/dev/null; then
		MOVE_SPAN_OLD=$MOVE_ANCHOR
		MOVE_SPAN_NEW=$MOVE_LAST
	elif git merge-base --is-ancestor "$MOVE_FIRST" "$MOVE_ANCHOR" 2>/dev/null && \
	     git merge-base --is-ancestor "$MOVE_ANCHOR" "$MOVE_LAST" 2>/dev/null; then
		MOVE_SPAN_OLD=$MOVE_FIRST
		MOVE_SPAN_NEW=$MOVE_LAST
	else
		PRINT_ERR "Commits ${MOVE_FIRST:0:7} and ${MOVE_ANCHOR:0:7} are not on one line of history"
		exit 1
	fi
	if git rev-parse --verify -q "$MOVE_SPAN_OLD^" >/dev/null 2>&1; then
		MOVE_SPAN=($(git rev-list --reverse "$MOVE_SPAN_OLD^..$MOVE_SPAN_NEW"))
	else
		MOVE_SPAN=($(git rev-list --reverse "$MOVE_SPAN_NEW"))
	fi
	# Desired order: the span minus the moved commits, which go back in together, in their own
	# order, at the anchor
	COMMITS_DESIRED=()
	for MOVE_STEP in "${MOVE_SPAN[@]}"; do
		if (( ${MOVE_SET[(Ie)$MOVE_STEP]} )); then
			continue
		fi
		if [ "$MOVE_STEP" = "$MOVE_ANCHOR" ] && [ "$MOVE_KIND" = "before" ]; then
			COMMITS_DESIRED+=("${MOVE_SET[@]}")
		fi
		COMMITS_DESIRED+=("$MOVE_STEP")
		if [ "$MOVE_STEP" = "$MOVE_ANCHOR" ] && [ "$MOVE_KIND" = "after" ]; then
			COMMITS_DESIRED+=("${MOVE_SET[@]}")
		fi
	done
	# A commit the span does not hold – on a merge's side leg, say – would come back short or
	# doubled, so it refuses here rather than reorder something else
	if [ ${#COMMITS_DESIRED[@]} -ne ${#MOVE_SPAN[@]} ]; then
		PRINT_ERR "--move cannot place its commits as one block – not all of them lie on the line ${MOVE_SPAN_OLD:0:7}..${MOVE_SPAN_NEW:0:7}"
		exit 1
	fi
	# Named as a run where they are one, each by itself where something lies between them
	MOVE_RUN=$(( ${MOVE_SPAN[(Ie)$MOVE_LAST]} - ${MOVE_SPAN[(Ie)$MOVE_FIRST]} + 1 == ${#MOVE_SET[@]} ))
	# Already in position – an honest no-op instead of an empty rebase
	if [ "${(j: :)COMMITS_DESIRED}" = "${(j: :)MOVE_SPAN}" ]; then
		if [ ${#MOVE_SET[@]} -eq 1 ]; then
			PRINT_TEXT "Commit %s already sits directly $MOVE_KIND %s – nothing to move" 36 "${MOVE_FIRST:0:7}" "${MOVE_ANCHOR:0:7}"
		else
			PRINT_TEXT "Commits %s..%s already sit directly $MOVE_KIND %s – nothing to move" 36 "${MOVE_FIRST:0:7}" "${MOVE_LAST:0:7}" "${MOVE_ANCHOR:0:7}"
		fi
		PRINT_COMPLETED "$(git rev-parse HEAD)" "$(_CURRENT_REF)" false
		exit 0
	fi
	# Commits at the old end of the span that keep their place are never rebuilt – so they leave
	# the span, whose oldest commit the pushed guard reads. Kept in, a move to just above the last
	# pushed commit was refused as rewriting the anchor it lands after
	while [ ${#MOVE_SPAN[@]} -gt 0 ] && [ "${MOVE_SPAN[1]}" = "${COMMITS_DESIRED[1]}" ]; do
		MOVE_SPAN=("${(@)MOVE_SPAN[2,-1]}")
		COMMITS_DESIRED=("${(@)COMMITS_DESIRED[2,-1]}")
	done
	COMMITS=("${MOVE_SPAN[@]}")
	if [ ${#MOVE_SET[@]} -eq 1 ]; then
		PRINT_ACTION "Moving %s $MOVE_KIND %s..." "$MOVE_FIRST" "$MOVE_ANCHOR"
	elif [ $MOVE_RUN -eq 1 ]; then
		PRINT_ACTION "Moving ${#MOVE_SET[@]} commits, %s through %s, $MOVE_KIND %s..." "$MOVE_FIRST" "$MOVE_LAST" "$MOVE_ANCHOR"
	else
		PRINT_ACTION "Moving ${#MOVE_SET[@]} commits – ${(j:, :)${(@)MOVE_SET//*/%s}} – $MOVE_KIND %s..." "${MOVE_SET[@]}" "$MOVE_ANCHOR"
	fi
	GIT_REORDER
	PRINT_COMPLETED "$REORDER_NEW_HEAD" "$REORDER_REF" true
	exit 0
fi

# --onto dispatches immediately: it acts on the current branch as a whole, so
# positional commits would have nothing to name
if [ ${#OPT_ONTO} -gt 0 ]; then
	if [[ ${#OPT_ONTO} -gt 1 && -n "${OPT_ONTO[2]}" ]]; then
		ONTO_UPSTREAM="${OPT_ONTO[2]#=}"
	fi
	if [ -z "$ONTO_UPSTREAM" ]; then
		USAGE
		PRINT_ERR "--onto requires an upstream (e.g., --onto=main)"
		exit 1
	fi
	if [ $# -gt 0 ]; then
		USAGE
		PRINT_ERR "--onto takes no <commit> arguments – it replants the current branch"
		exit 1
	fi
	GIT_ONTO
	PRINT_COMPLETED "$ONTO_NEW_HEAD" "$ONTO_REF" true
	exit 0
fi

# `--amend-into` dispatches immediately too – the target SHA came from the flag's value
# rather than positional args, which this mode leaves unused since the content comes
# from the staged index in main
if [ ${#OPT_AMEND_INTO} -gt 0 ]; then
	if [[ ${#OPT_AMEND_INTO} -gt 1 && -n "${OPT_AMEND_INTO[2]}" ]]; then
		AMEND_INTO_TARGET="${OPT_AMEND_INTO[2]#=}"
	fi
	if [ -z "$AMEND_INTO_TARGET" ]; then
		USAGE
		PRINT_ERR "--amend-into requires a <sha> value (e.g., --amend-into=abc123)"
		exit 1
	fi
	# Positional args narrow which staged paths get folded, the rest staying staged – without
	# them the whole index folds, as before
	if [ "$1" = "--" ]; then
		shift
	fi
	AMEND_PATHSPECS=("$@")
	# Whole files compose the `--tree` themselves, from the checkout – pinned to the tip they read
	if [ ${#OPT_WHOLE} -gt 0 ]; then
		if [ ${#AMEND_PATHSPECS[@]} -eq 0 ]; then
			USAGE
			PRINT_ERR "--whole needs the files to take: git edit --amend-into=<sha> --whole -- <path>..."
			exit 1
		fi
		_COMPOSE_WHOLE "${AMEND_PATHSPECS[@]}"
		_WHOLE_WHAT="Folded whole"
		_GUARD_WHOLE_MARKERS
		_GUARD_WHOLE
		AMEND_TREE=$(git commit-tree "$WHOLE_TREE" -p "$WHOLE_HEAD" -m "git edit: whole files composed on ${WHOLE_HEAD:0:7}" </dev/null)
		AMEND_PATHSPECS=()
		for WHOLE_PATH in "${WHOLE_PATHS[@]}"; do
			AMEND_PATHSPECS+=(":(top,literal)$WHOLE_PATH")
		done
	fi
	# The fold's source, as `git diff` reads it – the staged index, or a `--tree` composed apart
	# from it against `HEAD`; a commit given there pins the tip it was composed on, so a tip
	# that moved since is refused rather than have the diff carry a newer commit's reversal
	AMEND_SOURCE=(--cached --ignore-submodules=none)
	if [ -n "$AMEND_TREE" ]; then
		# Messages name the value as given – a full SHA shortened, anything else verbatim – where
		# the plumbing takes the resolved tree, whose SHA the caller never typed
		AMEND_TREE_GIVEN=$AMEND_TREE
		[[ "$AMEND_TREE_GIVEN" =~ '^[0-9a-f]{40,64}$' ]] && AMEND_TREE_GIVEN=${AMEND_TREE_GIVEN:0:7}
		TREE_BASE=$(git rev-parse --quiet --verify "$AMEND_TREE^{commit}^" 2>/dev/null)
		TREE_SHA=$(git rev-parse --quiet --verify "$AMEND_TREE^{tree}" 2>/dev/null)
		if [ -z "$TREE_SHA" ]; then
			PRINT_ERR "Unknown <tree-ish>: $AMEND_TREE"
			exit 1
		fi
		if [ -n "$TREE_BASE" ] && [ "$TREE_BASE" != "$(git rev-parse HEAD)" ]; then
			_TREE_MOVED "$(git rev-parse HEAD)"
		fi
		AMEND_TREE=$TREE_SHA
		AMEND_SOURCE=(--ignore-submodules=none HEAD "$AMEND_TREE")
	fi
	# `auto` resolves to the newest unpushed commit touching the folded paths
	if [ "$AMEND_INTO_TARGET" = "auto" ]; then
		_RESOLVE_AMEND_TARGET
	fi
	# Verify target is a valid commit ref
	if ! git rev-parse --quiet --verify "$AMEND_INTO_TARGET^{commit}" >/dev/null 2>&1; then
		PRINT_ERR "Unknown <sha>: $AMEND_INTO_TARGET"
		exit 1
	fi
	if [ ${#OPT_WHOLE} -gt 0 ]; then
		PRINT_ACTION "Amending ${#WHOLE_PATHS} whole file(s) into %s..." "$AMEND_INTO_TARGET"
	elif [ -n "$AMEND_TREE" ]; then
		PRINT_ACTION "Amending --tree $AMEND_TREE_GIVEN into %s..." "$AMEND_INTO_TARGET"
	else
		PRINT_ACTION "Amending staged changes into %s..." "$AMEND_INTO_TARGET"
	fi
	GIT_AMEND_INTO
	PRINT_COMPLETED "$AMEND_NEW_HEAD" "$AMEND_REF" true
	exit 0
fi

# --split dispatches early as well: positional args are pathspecs, not commits
if [ ${#OPT_SPLIT} -gt 0 ]; then
	if [[ ${#OPT_SPLIT} -gt 1 && -n "${OPT_SPLIT[2]}" ]]; then
		SPLIT_TARGET="${OPT_SPLIT[2]#=}"
	fi
	if [ -z "$SPLIT_TARGET" ]; then
		USAGE
		PRINT_ERR "--split requires a <sha> value (e.g., --split=abc123)"
		exit 1
	fi
	if [ ${#OPT_MESSAGE} -gt 0 -o ${#OPT_REWORD} -gt 0 -o ${#OPT_DROP} -gt 0 -o ${#OPT_SQUASH} -gt 0 -o ${#OPT_RESQUASH} -gt 0 -o ${#OPT_DIR} -gt 0 -o ${#OPT_EXEC} -gt 0 -o ${#OPT_AMEND_INTO} -gt 0 -o ${#OPT_REORDER} -gt 0 ]; then
		USAGE
		PRINT_ERR "Option --split cannot be combined with other modes"
		exit 1
	fi
	if [ "$1" = "--" ]; then
		shift
	fi
	if ! git rev-parse --quiet --verify "$SPLIT_TARGET^{commit}" >/dev/null 2>&1; then
		PRINT_ERR "Unknown <sha>: $SPLIT_TARGET"
		exit 1
	fi
	SPLIT_TARGET=$(git rev-parse "$SPLIT_TARGET^{commit}")
	# No pathspec means the halves aren't separable by path – pause and let the
	# caller author the split point instead of demanding one that can't exist
	if [ $# -eq 0 ]; then
		GIT_SPLIT_PAUSE
	fi
	if [ -z "$TEXT_VALUE" ]; then
		PRINT_ERR "--split requires --text for the extracted commit's message"
		exit 1
	fi
	PRINT_ACTION "Splitting %s..." "$SPLIT_TARGET"
	GIT_SPLIT "$@"
	PRINT_COMPLETED "$SPLIT_NEW_HEAD" "$SPLIT_REF" true
	exit 0
fi

COMMITS=()

if [ $# -eq 0 ]; then
	# Records-mode reword – `--- <commit>` messages on stdin or `--text`, targets named inline
	# rather than positionally, detected before the missing-target error since this is the
	# one action carrying its commits in the text
	if [ ${#OPT_REWORD} -gt 0 ] && _LOOKS_LIKE_RECORDS "$RAW_TEXT_VALUE"; then
		PRINT_ACTION "Rewording commits from records..."
		GIT_REWORD_BATCH
		PRINT_COMPLETED "$(git rev-parse HEAD)" "$(_CURRENT_REF)" true
		exit 0
	fi

	# A bare `git edit` is a request for help, and the usage block already makes the required
	# `<commit>` obvious – but with a mode flag given the caller meant to do something and
	# only left the target off, so name that rather than printing a screen of usage
	if [ ${#OPT_REWORD} -gt 0 -o ${#OPT_DROP} -gt 0 -o ${#OPT_SQUASH} -gt 0 -o ${#OPT_RESQUASH} -gt 0 -o -n "$TEXT_VALUE" ]; then
		# The records form's one shape mistake seen in the wild: two-dash headers, which read
		# as records to their author and as nothing to the detector above
		if [ ${#OPT_REWORD} -gt 0 ] && grep -q -E '^-- [0-9a-f]{7,}' <<<"$RAW_TEXT_VALUE"; then
			PRINT_ERR "Records start with '--- <commit>' – three dashes, and these headers carry two"
			exit 1
		fi
		# The retry for this is always the tip, so name it by SHA – a parallel session's commit
		# landing in the gap is exactly how a reword reaches the wrong one, and the CAS covers
		# the ref moving mid-run, not the wrong commit being named
		local HEAD_LINE=$(git log -1 --format='%h %s' 2>/dev/null)
		PRINT_ERR "Missing <commit> – name the commit to act on (e.g. 'git edit -M --text=\"…\" ${${HEAD_LINE%% *}:-HEAD}')"
		if [ -n "$HEAD_LINE" ]; then
			ECHO_E "\e[0;31m  HEAD is currently ${HEAD_LINE//\\/$_LITB}\e[0m" >&2
		fi
		exit 1
	fi
	USAGE
	exit 1
fi

# Parse/expand arguments (commits or ranges)
for ARG in "$@"; do
	# A `--` ahead of the commits only marks where the flags end
	[ "$ARG" = "--" ] && continue
	# Check if the argument is a standard ".." range (excluding "..." symmetric diff)
	if [[ "$ARG" == *".."* && "$ARG" != *"..."* ]]; then
		local S="${${ARG%%..*}:-HEAD}"
		local E="${${ARG#*..}:-HEAD}"

		# Swap if reversed (newer..older)
		git merge-base --is-ancestor "$E" "$S" 2>/dev/null && { local T="$S"; S="$E"; E="$T"; }

		# Determine range string (inclusive)
		local RANGE="$E"
		git rev-parse -q --verify "$S^" >/dev/null && RANGE="$S^..$E"

		# Validate and append
		if ! git rev-list "$RANGE" >/dev/null 2>&1; then
			PRINT_ERR "Invalid commit range: $ARG"
			exit 1
		fi
		COMMITS+=($(git rev-list "$RANGE"))
	else
		# Handle single commits
		if ! git rev-parse --quiet --verify "$ARG" >/dev/null 2>&1; then
			PRINT_ERR "Unknown <commit>: $ARG"
			# A message passed where the commit goes – the mistake every mode
			# that takes both invites, and nothing about "unknown commit" hints
			# at the real fix
			if [[ "$ARG" == *" "* ]]; then
				ECHO_E "\e[0;31m  That looks like a message – pass it as --text \"…\" and give the commit separately.\e[0m" >&2
			fi
			exit 1
		fi
		COMMITS+=($(git rev-parse "$ARG"))
	fi
done

# Abort if no commits were found
if [ ${#COMMITS[@]} -eq 0 ]; then
	PRINT_ERR "No valid commits found."
	exit 1
fi

# Validate before sorting, while the SHAs are still as the caller gave them – the sort's
# fallback below drops anything git cannot resolve, and each commit comes back as its
# current identity, so a SHA staled by an earlier rewrite is carried forward
COMMITS_RESOLVED=()
for COMMIT in "${COMMITS[@]}"; do
	_GUARD_REACHABLE "$COMMIT"
	COMMITS_RESOLVED+=("$_RESOLVED_SHA")
done
COMMITS=("${COMMITS_RESOLVED[@]}")
# `--reorder`'s payload is the positional order – taken resolved, ahead of the sort below
if [ ${#OPT_REORDER} -gt 0 ]; then
	COMMITS_DESIRED=("${COMMITS[@]}")
fi

# Sort selected commits topologically, oldest first – `rev-list --no-walk` only sorts by
# timestamp, which ties and comes back input-reversed on rapid-fire same-second commits,
# silently inverting the selection, so derive the order from `HEAD`'s own history
COMMITS_TOPO=($(git rev-list --reverse HEAD 2>/dev/null | grep -Fx -f <(printf '%s\n' "${COMMITS[@]}") 2>/dev/null))
if [ ${#COMMITS_TOPO[@]} -eq ${#COMMITS[@]} ]; then
	COMMITS=("${COMMITS_TOPO[@]}")
else
	COMMITS=($(git rev-list --no-walk --reverse "${COMMITS[@]}"))
fi

# Determine Action
if [ ${#OPT_REORDER} -gt 0 ]; then
	# Reorder (`--reorder`) – contiguous span, args give the new order
	ACTION="reorder"
	if (( ${#${(M)@:#*..*}} )); then
		PRINT_ERR "--reorder takes single commits in the desired order (no ranges)"
		exit 1
	fi
	COMMIT=${COMMITS[-1]}

elif [ ${#OPT_REWORD} -gt 0 ]; then
	# Reword (`-M` / `--reword`) – message-only edit via plumbing, no working-tree touch
	ACTION="reword"
	if [ ${#COMMITS[@]} -gt 1 ]; then
		PRINT_ERR "-M/--reword takes exactly one <commit>"
		exit 1
	fi
	COMMIT=${COMMITS[1]}

elif [ ${#OPT_RESQUASH} -gt 0 ]; then
	# Resquash (`-S` / `--resquash`) – plumbing-only contiguous squash, no working-tree touch
	ACTION="resquash"
	# Single commit: squash into its parent (mirrors -s semantics)
	if [ ${#COMMITS[@]} -eq 1 ]; then
		if git cat-file -e "${COMMITS[1]}^" 2>/dev/null; then
			local PARENT=$(git rev-parse "${COMMITS[1]}^")
			COMMITS=($PARENT ${COMMITS[1]})
		else
			PRINT_ERR "Cannot squash <commit> as it has no parent"
			exit 1
		fi
	fi
	COMMIT=${COMMITS[-1]}

elif [ ${#OPT_DROP} -gt 0 ]; then
	# Drop/Delete (`-d` / `--drop`)
	ACTION="drop"
	COMMIT=${COMMITS[1]}

elif [ ${#OPT_SQUASH} -gt 0 ]; then
	# Explicit Squash (-s)
	ACTION="squash"

	# `TARGET` was extracted in the pre-processing block – set if the user
	# used `-s=<target>`, or if `-sX`/`-s X` was used and the value wasn't
	# re-injected by the heuristic (i.e., it's not a recognizable ref/range)

	# If an explicit target was found, verify it and add to `COMMITS` array
	if [ -n "$TARGET" ]; then
		# Resolved as every other commit is – a stale or foreign one gave its squashed commits'
		# fixups no `pick` to follow, which dropped them
		if ! git rev-parse --quiet --verify "$TARGET^{commit}" >/dev/null 2>&1; then
			PRINT_ERR "Unknown <target>: $TARGET"
			exit 1
		fi
		_GUARD_REACHABLE "$TARGET"
		TARGET=$_RESOLVED_SHA
		# Add explicit target to list, re-sorted from `HEAD`'s own history –
		# `--no-walk --reverse` timestamp-sorts, which ties (and inverts the
		# input) on same-second commits, scrambling the span
		COMMITS+=("$TARGET")
		COMMITS_TOPO=($(git rev-list --reverse HEAD 2>/dev/null | grep -Fx -f <(printf '%s\n' "${COMMITS[@]}") 2>/dev/null))
		if [ ${#COMMITS_TOPO[@]} -eq ${#COMMITS[@]} ]; then
			COMMITS=("${COMMITS_TOPO[@]}")
		else
			COMMITS=($(git rev-list --no-walk --reverse "${COMMITS[@]}"))
		fi
	fi

	# Default target to oldest if not set
	if [ -z "$TARGET" ]; then
		TARGET=${COMMITS[1]}

		# If squashing just 1 commit (e.g. `git edit -s HEAD`), target is parent
		if [ ${#COMMITS[@]} -eq 1 ]; then
			if git cat-file -e "${TARGET}^" 2>/dev/null; then
				local PARENT=$(git rev-parse "${TARGET}^")
				TARGET=$PARENT
				COMMITS=($TARGET ${COMMITS[1]})
			else
				PRINT_ERR "Cannot squash <commit> as it has no parent"
				exit 1
			fi
		fi
	fi
	# Use newest commit for logs if needed, but logic uses `COMMITS` array
	COMMIT=${COMMITS[-1]}

elif [ ${#OPT_EDIT} -gt 0 ]; then
	# Edit (`-e` / `--edit`) – the default mode named outright, so a second <commit> is refused
	# rather than read as the implicit squash below
	ACTION="edit"
	if [ ${#COMMITS[@]} -gt 1 ]; then
		PRINT_ERR "-e/--edit takes exactly one <commit> – to squash them, pass -s"
		exit 1
	fi
	COMMIT=${COMMITS[1]}

elif [ ${#COMMITS[@]} -gt 1 ]; then
	# Implicit Squash (no flags, but multiple commits provided)
	ACTION="squash"
	TARGET=${COMMITS[1]}
	COMMIT=${COMMITS[-1]}

else
	# Edit (single commit, no flags)
	ACTION="edit"
	COMMIT=${COMMITS[1]}
fi

# Pushed guard for the rebase-based modes, drop, squash and edit – the plumbing and isolated
# modes guard inside their own functions, and the oldest selected commit already covers
# the whole span a rewrite reaches
if [[ "$ACTION" == "drop" || "$ACTION" == "squash" || "$ACTION" == "edit" ]]; then
	_GUARD_UNPUSHED "${COMMITS[1]}"
fi

# Auto-route a plain squash to the plumbing path where eligible – contiguous range, target
# the oldest, no merge commits – for the same observable outcome with no working-tree
# touch, while `-S` and `-C` are unaffected and the rest falls through to the rebase
if [[ "$ACTION" == "squash" ]] && [ ${#OPT_DIR} -eq 0 ] && _RESQUASH_ELIGIBLE; then
	ACTION="resquash"
	# The refusal `-S` gets up front, once the route is known
	if [ ${#OPT_VERIFY} -gt 0 -o ${#OPT_VERIFY_SPAN} -gt 0 ]; then
		PRINT_ERR "--verify cannot gate this squash"
		ECHO_E "\e[0;31m  A contiguous squash into the oldest commit preserves every tree by construction.\e[0m" >&2
		exit 1
	fi
fi

# Merge-span guard for the modes still rebase-based after auto-routing – a
# squash re-routed to plumbing rebuilds merges above it faithfully and needs
# no refusal, so this must come after the route decision
if [[ "$ACTION" == "drop" || "$ACTION" == "squash" || "$ACTION" == "edit" ]]; then
	_GUARD_NO_MERGE_SPAN "${COMMITS[1]}"
fi

# Final `--text` validation, only valid for message-producing modes – deferred until after
# action determination so implicit squash and auto-routing are both accounted for
if [ -n "$TEXT_VALUE" ] && [[ "$ACTION" != "reword" && "$ACTION" != "resquash" && "$ACTION" != "squash" ]]; then
	if [ "$ACTION" = edit ]; then
		PRINT_ERR "Pass --text with 'git edit --continue' – the message is applied at the amend"
	else
		PRINT_ERR "Option --text only applies to message-producing modes (-M, -s, -S, or implicit squash); got action: $ACTION"
	fi
	exit 1
fi


# ------------------------------------------- CORE LOGIC -------------------------------------------

# Reword and resquash take a plumbing-only path that never touches the working tree, the
# index or any other worktree state – the affected commits and their descendants are
# rebuilt via `git commit-tree` and applied with a single atomic `git update-ref`
if [[ "$ACTION" == "reword" ]]; then
	PRINT_ACTION "Rewording %s..." "$COMMIT"
	GIT_REWORD
	PRINT_COMPLETED "$(git rev-parse HEAD)" "$(_CURRENT_REF)" true
	exit 0
fi
if [[ "$ACTION" == "resquash" ]]; then
	PRINT_ACTION "Resquashing %s into %t" "${COMMITS[1]}" "${COMMITS[@]:#${COMMITS[1]}}"
	_CONFIRM_REWRITE
	GIT_RESQUASH
	PRINT_COMPLETED "$(git rev-parse HEAD)" "$(_CURRENT_REF)" true
	exit 0
fi
if [[ "$ACTION" == "reorder" ]]; then
	PRINT_ACTION "Reordering to %s" "${COMMITS_DESIRED[@]}"
	GIT_REORDER
	PRINT_COMPLETED "$REORDER_NEW_HEAD" "$REORDER_REF" true
	exit 0
fi

# A drop, edit or squash runs in a worktree of its own, never in the checkout – so a session sharing
# it never finds files moving under it, nor a rebase halfway – and lands on the branch, which a
# detached `HEAD` has none of
ORIG_BRANCH=${$(git symbolic-ref -q HEAD 2>/dev/null)#refs/heads/}
if [ -z "$ORIG_BRANCH" ]; then
	PRINT_ERR "$ACTION requires being on a branch (got detached HEAD)"
	ECHO_E "\e[0;31m  Make one where you are first: git switch -c <name>\e[0m" >&2
	exit 1
fi
ORIG_HEAD=$(git rev-parse HEAD)
_REQUIRE_IN_TIP "$ORIG_HEAD" "${COMMITS[@]}" "$TARGET"

# An edit pauses with a worktree at the commit – the caller edits its content there, and `--continue`
# amends, replays and lands it, while a person at a terminal answers the pause's prompt instead
if [[ "$ACTION" == "edit" ]]; then
	# `-m` opens an editor on the message at the amend, which a run with no terminal has none for
	if [ ${#OPT_MESSAGE} -gt 0 ] && _IS_NON_INTERACTIVE; then
		PRINT_ERR "-m opens an editor on the message, which this run has no terminal for"
		ECHO_E "\e[0;31m  Leave out -m, then pass the message to the continue: git edit --continue --text \"…\"\e[0m" >&2
		exit 1
	fi
	EDIT_TARGET=$(git rev-parse "$COMMIT^{commit}")
	PRINT_ACTION "Editing %s..." "$EDIT_TARGET"
	_PREPARE_RUN_WORKTREE "$EDIT_TARGET" git-edit-edit
	# The cleanup hook holds the worktree until the pause is recorded, as a parallel run's may take
	# the slot first
	_SAVE_STATE "operation=edit" "worktree=$WORKTREE_DIR" "wt_ours=$WT_OURS" "branch=refs/heads/$ORIG_BRANCH" \
		"orig_head=$ORIG_HEAD" "target=$EDIT_TARGET" "maindir=$(git rev-parse --show-toplevel)" \
		"message=${OPT_MESSAGE:+editor}"
	_CLEANUP_HOOK=""
	PRINT_TEXT "Worktree at the commit: %s" 33 "$WORKTREE_DIR"
	_IS_NON_INTERACTIVE && PRINT_TEXT "Make your changes there, then %s (add %s to also reword) – or cancel via %s." 33 "git edit --continue" '--text "…"' "git edit --abort"
	EMIT_PAUSED edit "$EDIT_TARGET" "$WORKTREE_DIR"
	_PAUSE_EXIT 2 edit
fi

# Every commit dropped leaves nothing to land – git's rebase would put a placeholder there
if [[ "$ACTION" == "drop" ]] && (( $(print -rl -- "${COMMITS[@]}" | sort -u | wc -l) >= $(git rev-list --count "$ORIG_HEAD") )); then
	PRINT_ERR "Dropping every commit of $ORIG_BRANCH leaves it none – nothing was changed"
	ECHO_E "\e[0;31m  To start it over, check out another branch and delete this one.\e[0m" >&2
	exit 1
fi

if [[ "$ACTION" == "drop" ]]; then
	PRINT_ACTION "Dropping %s" "${COMMITS[@]}"
else
	PRINT_ACTION "Merging %s -> %t" "$TARGET" "${COMMITS[@]:#$TARGET}"
fi
_CONFIRM_REWRITE
_PREPARE_RUN_WORKTREE "$ORIG_HEAD" git-edit-auto-iso
cd "$WORKTREE_DIR" || { PRINT_ERR "Cannot enter $WORKTREE_DIR"; exit 1; }
if [[ "$ACTION" == "drop" ]]; then
	GIT_REBASE_DROP
else
	GIT_REBASE_SQUASH
fi
_LAND_REBASE "$WORKTREE_DIR" "refs/heads/$ORIG_BRANCH" "$ORIG_HEAD" "$ACTION" "$COMMIT" "$TARGET" "${COMMITS[@]}"
PRINT_COMPLETED "$(git rev-parse "refs/heads/$ORIG_BRANCH")" "refs/heads/$ORIG_BRANCH" true
